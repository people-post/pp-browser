include(GNUInstallDirs)
include(CPack)

set(CPACK_PACKAGE_NAME "pp-browser")
set(CPACK_PACKAGE_VENDOR "pp-browser")
set(CPACK_PACKAGE_VERSION "${PP_BROWSER_RELEASE_VERSION}")
set(CPACK_PACKAGE_CONTACT "https://github.com/people-post/pp-browser")

if(WIN32)
  set(CPACK_GENERATOR "NSIS")
  set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${PP_BROWSER_RELEASE_VERSION}-windows-x64")
  set(CPACK_NSIS_DISPLAY_NAME "pp-browser")
  set(CPACK_NSIS_PACKAGE_NAME "pp-browser")
  set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
elseif(APPLE)
  set(CPACK_GENERATOR "DragNDrop")
  set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${PP_BROWSER_RELEASE_VERSION}-macos")
  set(CPACK_DMG_VOLUME_NAME "pp-browser")
  set(CPACK_DMG_FORMAT "UDZO")
endif()
