[Unit]
Description=Brief mesh node (pp-node)
Documentation=https://github.com/pp-browser/pp-browser
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pp-node
Group=pp-node
Environment=PP_BROWSER_PIN=change-me
# Optional deploy overlays (CLI → env → /etc/pp-node/config.json):
# Environment=PP_NODE_LISTEN=/ip4/0.0.0.0/tcp/443
# Environment=PP_NODE_DATA_DIR=/var/lib/pp-node
# Environment=PP_NODE_CAP_MEDIA_RELAY=1
ExecStart=/usr/bin/pp-node --config /etc/pp-node/config.json
Restart=on-failure
RestartSec=5
# Bind TCP 443 without root when AmbientCapabilities is supported:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pp-node
WorkingDirectory=/var/lib/pp-node

[Install]
WantedBy=multi-user.target
