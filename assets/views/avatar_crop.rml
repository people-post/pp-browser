<div class="avatar-crop" data-model="avatar_crop">
  <div class="avatar-crop-bg"></div>
  <div class="avatar-crop-bar">
    <h2 class="avatar-crop-title">{{i18n:settings.profile.crop_title}}</h2>
  </div>
  <!-- The photo: one custom element drawing the picture under a fixed round viewport (ElementAvatarCrop). Fingers are
       taken before the UI library sees them (SdlAppEvents); the mouse drags and the wheel zooms on this element. -->
  <div class="avatar-crop-stage">
    <avatar-crop id="avatar-crop-surface" class="avatar-crop-surface"></avatar-crop>
    <p class="avatar-crop-loading" data-if="crop_loading">…</p>
  </div>
  <div class="avatar-crop-actions">
    <button class="avatar-crop-btn avatar-crop-btn--cancel" type="button" data-event-click="crop_cancel()"
            data-attrif-disabled="crop_locked">{{i18n:common.cancel}}</button>
    <button class="avatar-crop-btn avatar-crop-btn--rotate" type="button" data-event-click="crop_rotate()"
            data-attrif-disabled="crop_locked || crop_loading">{{i18n:settings.profile.crop_rotate}}</button>
    <button class="avatar-crop-btn avatar-crop-btn--done" type="button" data-event-click="crop_done()"
            data-attrif-disabled="crop_locked || crop_loading">{{i18n:settings.profile.crop_done}}</button>
  </div>
</div>
