      <div class="settings-section stack">
        <p class="text muted">{{i18n:settings.security.protection}} <span>{{pin_protection_status}}</span></p>
        <p class="text muted" data-if="pin_protection_is_default">
          {{i18n:settings.security.default_hint}}
        </p>
        <p class="text muted" data-if="pin_protection_not_setup">
          {{i18n:settings.security.not_setup_hint}}
        </p>
        <div data-if="security_can_change_pin" class="stack">
          <label class="settings-field">
            <span class="settings-label">{{i18n:settings.security.current_pin}}</span>
            <input class="field" type="password" data-value="pin_change_old" placeholder="{{i18n:settings.security.current_pin_placeholder}}"/>
          </label>
          <label class="settings-field">
            <span class="settings-label">{{i18n:settings.security.new_pin}}</span>
            <input class="field" type="password" data-value="pin_change_new" placeholder="{{i18n:settings.security.new_pin_placeholder}}"/>
          </label>
          <label class="settings-field">
            <span class="settings-label">{{i18n:settings.security.confirm_pin}}</span>
            <input class="field" type="password" data-value="pin_change_confirm" placeholder="{{i18n:settings.security.confirm_pin_placeholder}}"/>
          </label>
          <p class="text muted settings-help">{{i18n:pin.forget_warning}}</p>
          <div class="settings-actions row">
            <button class="btn btn-primary" type="button" data-event-click="change_pin()">{{i18n:settings.security.change_pin}}</button>
          </div>
        </div>
        <p class="text muted" data-if="!security_can_change_pin && !pin_protection_not_setup">
          {{i18n:settings.security.unlock_to_change}}
        </p>
        <div class="stack settings-actions">
          <p class="text">{{i18n:settings.security.link_device}}</p>
          <p class="text muted settings-help">{{i18n:settings.security.link_device.help}}</p>
          <p class="text muted settings-help">{{i18n:settings.security.link_device.send_hint}}</p>
          <p class="text muted settings-help">{{i18n:settings.security.link_device.reset_hint}}</p>
          <button class="btn" type="button" data-if="security_can_export_link && !own_devices_not_main"
                  data-event-click="export_link_device()">
            {{i18n:settings.security.link_device.export}}
          </button>
        </div>
        <div class="stack settings-actions" data-if="own_devices_shown">
          <p class="text">{{i18n:settings.security.devices}}</p>
          <p class="text muted settings-help">{{i18n:settings.security.devices.help}}</p>
          <p class="text error" data-if="own_devices_signed_out">{{i18n:settings.security.devices.signed_out}}</p>
          <div data-for="device, device_index : own_device_rows" class="settings-device-row stack">
            <div class="row settings-device-title">
              <p class="text">{{device.label}}</p>
              <span class="settings-device-badge" data-if="device.is_main">{{i18n:settings.security.devices.main}}</span>
            </div>
            <div class="settings-device-actions row" data-if="device.can_manage">
              <button class="btn btn-secondary" type="button"
                      data-event-click="make_main_device(device_index)">{{i18n:settings.security.devices.make_main}}</button>
              <button class="btn btn-secondary" type="button"
                      data-event-click="remove_own_device(device_index)">{{i18n:settings.security.devices.remove}}</button>
            </div>
          </div>
          <p class="text muted settings-help" data-if="own_devices_not_main && !own_devices_signed_out">
            {{i18n:settings.security.devices.not_main}}
          </p>
        </div>
        <div class="stack settings-actions" data-if="security_has_recovery_phrase">
          <p class="text">{{i18n:settings.security.recovery}}</p>
          <p class="text muted settings-help">{{i18n:settings.security.recovery.help}}</p>
          <div class="stack" data-if="recovery_phrase == ''">
            <label class="settings-field" data-if="!pin_protection_is_default">
              <span class="settings-label">{{i18n:settings.security.recovery.pin_label}}</span>
              <input class="field" type="password" data-value="recovery_phrase_pin" placeholder="{{i18n:settings.security.recovery.pin_placeholder}}"/>
            </label>
            <button class="btn" type="button" data-event-click="show_recovery_phrase()">
              {{i18n:settings.security.recovery.show}}
            </button>
          </div>
          <div class="stack" data-if="recovery_phrase != ''">
            <p class="text" selectable="text">{{recovery_phrase}}</p>
            <p class="text muted settings-help">{{i18n:settings.security.recovery.shown_hint}}</p>
            <button class="btn" type="button" data-event-click="hide_recovery_phrase()">
              {{i18n:settings.security.recovery.hide}}
            </button>
          </div>
          <p class="text muted settings-help">{{i18n:settings.security.copy.help}}</p>
          <button class="btn" type="button" data-event-click="save_account_copy()">
            {{i18n:settings.security.copy.save}}
          </button>
        </div>
        <button class="settings-toggle-row settings-choice-row row" type="button"
                data-event-click="on_choose_group_invite_policy()">
          <span class="settings-label settings-toggle-label">{{i18n:settings.security.group_invites}}</span>
          <span class="settings-choice-value row">
            <span class="settings-choice-value-text">{{group_invite_policy_label}}</span>
            <svg class="settings-row-chevron" src="../icons/chevron-right.svg" width="12" height="12"></svg>
          </span>
        </button>
        <p class="text muted settings-help">{{i18n:settings.security.group_invites.help}}</p>
        <button class="settings-toggle-row settings-choice-row row" type="button"
                data-event-click="on_choose_call_invite_policy()">
          <span class="settings-label settings-toggle-label">{{i18n:settings.security.calls}}</span>
          <span class="settings-choice-value row">
            <span class="settings-choice-value-text">{{call_invite_policy_label}}</span>
            <svg class="settings-row-chevron" src="../icons/chevron-right.svg" width="12" height="12"></svg>
          </span>
        </button>
        <p class="text muted settings-help">{{i18n:settings.security.calls.help}}</p>
        <div class="stack settings-actions" data-if="advanced">
          <p class="text">{{i18n:settings.security.tool_permissions}}: <span>{{tool_permissions_summary}}</span></p>
          <p class="text muted settings-help">{{i18n:settings.security.tool_permissions.help}}</p>
          <button class="btn" type="button" data-if="tool_permissions_has_saved"
                  data-event-click="reset_tool_permissions()">
            {{i18n:settings.security.tool_permissions.reset}}
          </button>
        </div>
        <div class="stack settings-actions" data-if="advanced">
          <p class="text muted settings-help">{{i18n:settings.security.clear_undelivered.help}}</p>
          <button class="btn" type="button" data-event-click="clear_undelivered_older_than()">
            {{i18n:settings.security.clear_undelivered}}
          </button>
        </div>
        <div class="settings-toggle-row row">
          <span class="settings-label settings-toggle-label">{{i18n:settings.security.crash_reports.label}}</span>
          <button class="settings-switch" type="button"
                  data-class-settings-switch--on="crash_reports_enabled == 'on'"
                  data-event-click="toggle_crash_reports()">
            <div class="settings-switch-knob"></div>
          </button>
        </div>
        <p class="text muted settings-help">{{i18n:settings.security.crash_reports.help}}</p>
      </div>

