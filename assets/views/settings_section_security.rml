      <div class="settings-section settings-section--grouped settings-mock stack">
        <!-- Phones: a short list; Change PIN is a page of its own (Kenneth 2026-11-04). One card with the PIN row and,
             on a device with the sensor and an own PIN, the face / fingerprint switch (A014; on asks for the PIN first). -->
        <div class="group-card">
          <button class="group-row settings-phone-only" type="button" data-if="show_change_pin"
                  data-event-click="open_security_page('change_pin')">
            <span class="group-row-body">
              <span class="group-row-label"><span class="group-row-text">{{i18n:settings.security.change_pin}}</span></span>
              <span class="group-row-value">{{pin_protection_status}}</span>
              <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
            </span>
          </button>
          <div class="group-row group-row--static settings-phone-only" data-if="!show_change_pin">
            <span class="group-row-body">
              <span class="group-row-label"><span class="group-row-text">{{i18n:settings.security.protection_title}}</span></span>
              <span class="group-row-value">{{pin_protection_status}}</span>
            </span>
          </div>
          <div class="settings-toggle-row row group-row" data-if="security_biometric_shown">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{security_biometric_label}}</span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="security_biometric_on"
                      data-event-click="toggle_biometric()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
        </div>
        <p class="text muted settings-help group-foot" data-if="security_biometric_shown">{{i18n:settings.security.biometric.help}}</p>
        <div class="group-card group-card--pad settings-desktop-only">
          <p class="text muted group-note">{{i18n:settings.security.protection}} <span>{{pin_protection_status}}</span></p>
        </div>
        <!-- PIN grace window (#21): under the PIN; only with an own PIN on a platform with a secure store. -->
        <div class="group-card" data-if="security_grace_shown">
          <button class="settings-toggle-row settings-choice-row row group-row" type="button"
                  data-event-click="on_choose_unlock_grace()">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.security.grace.title}}</span>
              <span class="settings-choice-value row">
                <span class="settings-choice-value-text">{{unlock_grace_label}}</span>
                <svg class="settings-row-chevron" src="../icons/chevron-right.svg" width="12" height="12"></svg>
              </span>
            </span>
          </button>
        </div>
        <p class="text muted settings-help group-foot" data-if="security_grace_shown">{{i18n:settings.security.grace.help}}</p>
        <p class="text muted group-foot" data-if="pin_protection_is_default">
          {{i18n:settings.security.default_hint}}
        </p>
        <p class="text muted group-foot" data-if="pin_protection_not_setup">
          {{i18n:settings.security.not_setup_hint}}
        </p>
        <div class="settings-desktop-only">
{{include:settings_security_pin}}
        </div>
        <p class="text group-head" data-if="!security_has_recovery_phrase">{{i18n:settings.security.recovery}}</p>
        <div class="settings-q-head row" data-if="security_has_recovery_phrase"><p class="text group-head">{{i18n:settings.security.recovery}}</p><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.security.recovery')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></div>
        <div class="stack settings-actions" data-if="!security_has_recovery_phrase && security_can_export_link">
          <p class="text muted settings-help group-foot">{{i18n:settings.security.recovery.none}}</p>
        </div>
        <div class="stack settings-actions" data-if="security_has_recovery_phrase">
          <div class="stack" data-if="recovery_phrase == ''">
            <!-- The PIN on the PIN gate first (its number pad for a digit PIN, B2). -->
            <div class="group-card settings-phone-only">
              <button class="group-row" type="button" data-event-click="show_recovery_phrase()">
                <span class="group-row-body">
                  <span class="group-row-label"><span class="group-row-text">{{i18n:settings.security.recovery.show}}</span></span>
                </span>
              </button>
            </div>
            <button class="btn settings-desktop-only" type="button" data-event-click="show_recovery_phrase()">
              {{i18n:settings.security.recovery.show}}
            </button>
          </div>
          <div class="stack" data-if="recovery_phrase != ''">
            <p class="text group-card group-card--pad" selectable="text">{{recovery_phrase}}</p>
            <p class="text muted settings-help group-foot">{{i18n:settings.security.recovery.shown_hint}}</p>
            <div class="group-card settings-phone-only">
              <button class="group-row" type="button" data-event-click="hide_recovery_phrase()">
                <span class="group-row-body">
                  <span class="group-row-label"><span class="group-row-text">{{i18n:settings.security.recovery.hide}}</span></span>
                </span>
              </button>
            </div>
            <button class="btn settings-desktop-only" type="button" data-event-click="hide_recovery_phrase()">
              {{i18n:settings.security.recovery.hide}}
            </button>
          </div>
          <p class="text muted settings-help group-foot">{{i18n:settings.security.recovery.help}}</p>
        </div>
      </div>
