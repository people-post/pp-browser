      <div class="settings-section settings-section--grouped settings-mock stack">
        <div class="group-card settings-phone-only">
          <button class="group-row" type="button" data-event-click="open_security_page('transfer')">
            <span class="group-row-body">
              <span class="group-row-label settings-q-label"><span class="group-row-text">{{i18n:settings.security.transfer_row}}</span><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.security.transfer_row')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
              <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
            </span>
          </button>
        </div>
        <p class="text muted settings-help group-foot settings-phone-only">{{i18n:settings.devices.transfer_help}}</p>
        <div class="settings-desktop-only">
{{include:settings_security_transfer}}
        </div>
        <div class="stack settings-actions" data-if="own_devices_shown">
          <p class="text group-head">{{i18n:settings.security.devices}}</p>
          <div data-for="device, device_index : own_device_rows" class="settings-device-row group-card">
            <div class="group-row group-row--static">
              <span class="group-row-body">
                <span class="group-row-label"><span class="group-row-text">{{device.label}}</span></span>
                <span class="group-row-value" data-if="device.is_main">{{i18n:settings.security.devices.main}}</span>
              </span>
            </div>
            <div data-if="device.can_manage">
              <button class="group-row" type="button"
                      data-event-click="make_main_device(device_index)">
                <span class="group-row-body">
                  <span class="group-row-label"><span class="group-row-text">{{i18n:settings.security.devices.make_main}}</span></span>
                </span>
              </button>
              <button class="group-row group-row--danger" type="button"
                      data-event-click="remove_own_device(device_index)">
                <span class="group-row-body">
                  <span class="group-row-label"><span class="group-row-text">{{i18n:settings.security.devices.remove}}</span></span>
                </span>
              </button>
            </div>
          </div>
          <p class="text muted settings-help group-foot">{{i18n:settings.security.devices.help}}</p>
          <p class="text error group-foot" data-if="own_devices_signed_out">{{i18n:settings.security.devices.signed_out}}</p>
          <p class="text muted settings-help group-foot" data-if="own_devices_not_main && !own_devices_signed_out">
            {{i18n:settings.security.devices.not_main}}
          </p>
        </div>
        <div class="stack settings-actions" data-if="security_has_recovery_phrase">
          <div class="group-card">
            <div class="group-row">
              <span class="group-row-body">
                <button class="group-row-tap" type="button" data-event-click="save_account_copy()">
                  <span class="group-row-text">{{i18n:settings.security.copy.save}}</span>
                </button>
                <button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.help.topic.account_copy')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button>
              </span>
            </div>
          </div>
          <p class="text muted settings-help group-foot">{{i18n:settings.security.copy.help}}</p>
        </div>
      </div>
