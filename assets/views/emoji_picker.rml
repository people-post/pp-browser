<div class="emoji-picker" data-model="emoji_picker">
  <!-- Phones: the sheet's top (the composer's emoji sheet: a grabber to drag it down and an X, both back to the
       keyboard; in a page sheet the sheet brings its own grabber and X, so only the title shows). -->
  <div class="emoji-sheet-top">
    <div class="emoji-sheet-grabber"></div>
    <div class="sheet-header emoji-sheet-header">
      <p class="sheet-title">{{title}}</p>
    </div>
    <button class="emoji-sheet-close" type="button" data-event-click="close_to_keyboard()">
      <span class="sheet-icon-disc"><svg src="../icons/v2/close.svg" width="12" height="12"></svg></span>
    </button>
  </div>
  <div class="emoji-picker-header row">
    <p class="emoji-picker-title">{{title}}</p>
  </div>

  <div class="emoji-picker-main row">
    <div class="emoji-picker-rail">
      <button data-for="tab : rail_tabs"
              class="emoji-picker-rail-tab"
              data-class-emoji-picker-rail-tab--active="tab.active"
              type="button"
              data-event-click="select_category(tab.id)">
        <span class="emoji-picker-rail-glyph">{{tab.glyph}}</span>
      </button>
    </div>

    <div id="emoji-picker-body" class="emoji-picker-body" data-event-scroll="on_scroll()">
      <div data-for="section : sections"
           class="emoji-picker-section"
           data-attr-id="section.element_id">
        <div class="emoji-picker-section-label">
          <p class="emoji-picker-section-label-text">{{section.label}}</p>
        </div>
        <div class="emoji-picker-cells">
          <button data-for="cell : section.cells"
                  class="emoji-picker-cell"
                  type="button"
                  data-event-click="select_emoji(cell.glyph)">
            <span class="emoji-picker-cell-glyph">{{cell.glyph}}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
