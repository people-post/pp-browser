<!-- Me > Security > Change PIN: the three fields and the button (inline on desktop, its own page on phones). -->
<div data-if="show_change_pin && security_can_change_pin" class="stack">
  <div class="group-card">
    <label class="settings-field group-row group-row--field">
      <span class="group-row-body group-row-body--field">
        <span class="settings-label group-row-text">{{i18n:settings.security.current_pin}}</span>
        <input class="field" type="password" data-value="pin_change_old" placeholder="{{i18n:settings.security.current_pin_placeholder}}"/>
        <span class="group-field-hint" data-if="pin_change_old == ''">{{i18n:settings.security.current_pin_placeholder}}</span>
      </span>
    </label>
    <label class="settings-field group-row group-row--field">
      <span class="group-row-body group-row-body--field">
        <span class="settings-label group-row-text">{{i18n:settings.security.new_pin}}</span>
        <input class="field" type="password" data-value="pin_change_new" placeholder="{{i18n:settings.security.new_pin_placeholder}}"/>
        <span class="group-field-hint" data-if="pin_change_new == ''">{{i18n:settings.security.new_pin_placeholder}}</span>
      </span>
    </label>
    <label class="settings-field group-row group-row--field">
      <span class="group-row-body group-row-body--field">
        <span class="settings-label group-row-text">{{i18n:settings.security.confirm_pin}}</span>
        <input class="field" type="password" data-value="pin_change_confirm" placeholder="{{i18n:settings.security.confirm_pin_placeholder}}"/>
        <span class="group-field-hint" data-if="pin_change_confirm == ''">{{i18n:settings.security.confirm_pin_placeholder}}</span>
      </span>
    </label>
  </div>
  <p class="text muted settings-help group-foot">{{i18n:pin.forget_warning}}</p>
  <div class="settings-actions row">
    <button class="btn btn-primary" type="button" data-event-click="change_pin()">{{i18n:settings.security.change_pin}}</button>
  </div>
</div>
<p class="text muted group-foot" data-if="show_change_pin && !security_can_change_pin && !pin_protection_not_setup">
  {{i18n:settings.security.unlock_to_change}}
</p>
