<!-- Me > Security > PIN. Desktop: inline under the status line. Phones: the page the PIN row opens (security_page 'pin').
     The "?" (asks PP Support) and its caption are on the Security page itself. Neither holds fields: every button starts the PIN gate's steps (current, new, again; B2). A default-PIN user can only
     set an own PIN; an own-PIN user can change it or go back to the default one. -->
<div data-if="show_change_pin && security_can_change_pin" class="stack settings-desktop-only">
  <p class="text muted settings-help group-foot">{{i18n:pin.forget_warning}}</p>
  <div class="settings-actions row">
    <button class="btn btn-primary" type="button" data-if="!pin_protection_is_default" data-event-click="change_pin()">{{i18n:settings.security.change_pin}}</button>
    <button class="btn btn-primary" type="button" data-if="pin_protection_is_default" data-event-click="change_pin()">{{i18n:settings.security.set_custom_pin}}</button>
    <button class="btn" type="button" data-if="!pin_protection_is_default" data-event-click="remove_pin()">{{i18n:settings.security.remove_pin}}</button>
  </div>
  <p class="text muted settings-help group-foot">{{pin_page_note}}</p>
</div>
<div data-if="show_change_pin && security_can_change_pin" class="stack settings-phone-only">
  <div class="group-card">
    <button class="group-row" type="button" data-if="!pin_protection_is_default" data-event-click="change_pin()">
      <span class="group-row-body">
        <span class="group-row-label"><span class="group-row-text">{{i18n:settings.security.change_pin}}</span></span>
        <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
      </span>
    </button>
    <button class="group-row" type="button" data-if="!pin_protection_is_default" data-event-click="remove_pin()">
      <span class="group-row-body">
        <span class="group-row-label"><span class="group-row-text">{{i18n:settings.security.remove_pin}}</span></span>
        <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
      </span>
    </button>
    <button class="group-row" type="button" data-if="pin_protection_is_default" data-event-click="change_pin()">
      <span class="group-row-body">
        <span class="group-row-label"><span class="group-row-text">{{i18n:settings.security.set_custom_pin}}</span></span>
        <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
      </span>
    </button>
  </div>
  <p class="text muted settings-help group-foot">{{pin_page_note}}</p>
  <p class="text muted settings-help group-foot">{{i18n:pin.forget_warning}}</p>
</div>
<p class="text muted group-foot" data-if="show_change_pin && !security_can_change_pin && !pin_protection_not_setup">
  {{i18n:settings.security.unlock_to_change}}
</p>
