<div class="contacts-panel" data-model="contacts">
  <div class="contacts-list-view">
    <div class="contacts-header row">
      <p class="contacts-header-title">Contacts</p>
      <div class="contacts-header-actions row">
        <button class="contacts-find-btn" type="button" data-event-click="on_add_contact_menu()">
          <svg src="../icons/plus.svg" width="14" height="14" crop-to-content="true"></svg>
        </button>
      </div>
    </div>

    <div class="contacts-search">
      <input class="field contacts-search-field" type="text" data-value="search_query"
             data-event-change="on_search_changed()" placeholder="Search contacts"/>
    </div>

    <div class="contacts-list">
      <div data-for="contact : contacts"
           class="contacts-row"
           data-class-contacts-row--active="contact.id == selected.id && selected.id != ''"
           data-event-click="select_contact(contact.id)">
        <div class="contacts-row-avatar-frame"
             data-class-avatar-tone-0="!contact.has_icon && contact.avatar_tone == 0"
             data-class-avatar-tone-1="!contact.has_icon && contact.avatar_tone == 1"
             data-class-avatar-tone-2="!contact.has_icon && contact.avatar_tone == 2"
             data-class-avatar-tone-3="!contact.has_icon && contact.avatar_tone == 3"
             data-class-avatar-tone-4="!contact.has_icon && contact.avatar_tone == 4"
             data-class-avatar-tone-5="!contact.has_icon && contact.avatar_tone == 5"
             data-class-avatar-tone-6="!contact.has_icon && contact.avatar_tone == 6"
             data-class-avatar-tone-7="!contact.has_icon && contact.avatar_tone == 7">
          <img class="contacts-row-avatar-image" data-if="contact.has_icon" data-attr-src="contact.icon_src"/>
          <p class="avatar-letter" data-if="!contact.has_icon" data-rml="contact.avatar_letter"></p>
        </div>
        <div class="contacts-row-body">
          <div class="contacts-row-title-line row">
            <p class="contacts-row-title" data-rml="contact.title"></p>
            <span class="contacts-trust-badge contacts-trust-badge--friendly"
                  data-if="contact.trust == 'friendly'">Friendly</span>
            <span class="contacts-trust-badge contacts-trust-badge--blocked"
                  data-if="contact.trust == 'blocked'">Blocked</span>
            <span class="badge-count contacts-unread"
                  data-if="contact.unread_count > 0"
                  data-rml="contact.unread_display"></span>
          </div>
          <p class="contacts-row-subtitle text muted" data-if="contact.subtitle != ''" data-rml="contact.subtitle"></p>
        </div>
      </div>

      <div class="contacts-empty stack" data-if="contacts.size == 0 && search_query == ''">
        <p class="text muted">No contacts yet. Tap + to add one, find people on the network, or ask the assistant.</p>
        <button class="chat-suggestion btn-icon" type="button" data-event-click="find_someone()">
          <svg src="../icons/sparkle.svg" width="14" height="14" crop-to-content="true"></svg>
          Find someone
        </button>
      </div>
      <p class="text muted" data-if="contacts.size == 0 && search_query != ''">No matching contacts.</p>
    </div>
  </div>
</div>
