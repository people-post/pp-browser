      <div class="settings-section settings-section--grouped settings-mock stack" data-if="advanced">
        <!-- Phones: a full-width banner strip at the very top; the desktop keeps the triangle and the small grey line. -->
        <div class="settings-banner settings-phone-only">
          <span class="settings-warn-icon"><svg src="../icons/v2/alert-triangle.svg" width="18" height="18"></svg></span>
          <p class="settings-banner-text">{{i18n:settings.advanced.intro}}</p>
        </div>
        <div class="settings-warn-row settings-desktop-only">
          <span class="settings-warn-icon"><svg src="../icons/v2/alert-triangle.svg" width="18" height="18"></svg></span>
          <p class="text muted settings-help group-foot">{{i18n:settings.advanced.intro}}</p>
        </div>
        <div class="group-card" data-if="show_backend_switch">
          <button class="settings-toggle-row settings-choice-row row group-row" type="button"
                  data-event-click="on_choose_backend()">
            <span class="group-row-body">
              <span class="settings-q-label"><span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.network.backend}}</span><button class="settings-q-btn settings-phone-only" type="button" data-event-click="show_setting_note('settings.network.backend','settings.network.backend.help')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
              <span class="settings-choice-value row">
                <span class="settings-choice-value-text">{{backend_label}}</span>
                <svg class="settings-row-chevron" src="../icons/chevron-right.svg" width="12" height="12"></svg>
              </span>
            </span>
          </button>
          <div class="settings-phone-only" data-if="backend_is_custom">
            <button class="group-row" type="button" data-event-click="open_security_page('backend_custom')">
              <span class="group-row-body">
                <span class="group-row-label"><span class="group-row-text">{{i18n:settings.network.backend.custom_addresses}}</span></span>
                <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
              </span>
            </button>
          </div>
        </div>
        <!-- Where the Service row is not shown (the UI demo build) the entry still has to be reachable: its own card, under the old fields' gate. -->
        <div class="group-card settings-phone-only" data-if="backend_is_custom && !show_backend_switch">
          <button class="group-row" type="button" data-event-click="open_security_page('backend_custom')">
            <span class="group-row-body">
              <span class="group-row-label"><span class="group-row-text">{{i18n:settings.network.backend.custom_addresses}}</span></span>
              <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
            </span>
          </button>
        </div>
        <p class="text muted settings-help group-foot settings-desktop-only" data-if="show_backend_switch">{{i18n:settings.network.backend.help}}</p>
        <p class="text settings-help group-foot" data-if="show_backend_switch && backend_restart_pending">{{i18n:settings.network.backend.restart}}</p>
        <div class="stack settings-desktop-only" data-if="advanced">
{{include:settings_section_advanced_backend}}
        </div>
        <p class="text group-head">{{i18n:settings.advanced.group.connection}}</p>
        <div class="group-card">
          <div class="settings-toggle-row row group-row" data-if="advanced && show_node_toggle">
            <span class="group-row-body">
              <span class="settings-q-label"><span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.network.help_network}}</span><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.network.help_network')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="node_enabled == 'on'"
                      data-event-click="toggle_node_enabled()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
          <p class="text muted settings-help group-foot settings-desktop-only" data-if="advanced && show_node_toggle">{{i18n:settings.network.help_network_hint}}</p>
          <div class="settings-toggle-row row group-row" data-if="advanced && show_circuit_relay_toggle">
            <span class="group-row-body">
              <span class="settings-q-label"><span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.network.circuit_relay}}</span><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.network.circuit_relay')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="circuit_relay_enabled == 'on'"
                      data-event-click="toggle_circuit_relay()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
          <p class="text muted settings-help group-foot settings-desktop-only" data-if="advanced && show_circuit_relay_toggle">{{i18n:settings.network.circuit_relay_hint}}</p>
          <div class="settings-toggle-row row group-row" data-if="advanced && show_media_relay_toggle">
            <span class="group-row-body">
              <span class="settings-q-label"><span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.network.media_relay}}</span><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.network.media_relay')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="media_relay_enabled == 'on'"
                      data-event-click="toggle_media_relay()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
          <p class="text muted settings-help group-foot settings-desktop-only" data-if="advanced && show_media_relay_toggle">{{i18n:settings.network.media_relay_hint}}</p>
          <div class="settings-toggle-row row group-row" data-if="advanced && show_dht_toggle">
            <span class="group-row-body">
              <span class="settings-q-label"><span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.network.dht}}</span><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.network.dht')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="dht_enabled == 'on'"
                      data-event-click="toggle_dht()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
          <p class="text muted settings-help group-foot settings-desktop-only" data-if="advanced && show_dht_toggle">{{i18n:settings.network.dht_hint}}</p>
          <div class="settings-toggle-row row group-row" data-if="advanced && show_prefer_contacts_toggle">
            <span class="group-row-body">
              <span class="settings-q-label"><span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.network.prefer_contacts}}</span><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.network.prefer_contacts')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="prefer_contacts_for_routing == 'on'"
                      data-event-click="toggle_prefer_contacts()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
          <p class="text muted settings-help group-foot settings-desktop-only" data-if="advanced && show_prefer_contacts_toggle">{{i18n:settings.network.prefer_contacts_hint}}</p>
          <div class="settings-toggle-row row group-row">
            <span class="group-row-body">
              <span class="settings-q-label"><span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.network.trusted_relays}}</span><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.network.trusted_relays')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="trusted_relays_only == 'on'"
                      data-event-click="toggle_trusted_relays()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
          <p class="text muted settings-help group-foot settings-desktop-only">{{i18n:settings.network.trusted_relays.help}}</p>
          <div class="settings-toggle-row row group-row" data-if="show_node_toggle">
            <span class="group-row-body">
              <span class="settings-q-label"><span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.network.reachable_without_relay}}</span><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.network.reachable_without_relay')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="reachable_without_relay == 'on'"
                      data-event-click="toggle_reachable_without_relay()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
          <p class="text muted settings-help group-foot settings-desktop-only" data-if="show_node_toggle">{{i18n:settings.network.reachable_without_relay.help}}</p>
          <button class="settings-toggle-row settings-choice-row row group-row" type="button"
                  data-event-click="on_choose_direct_connections()">
            <span class="group-row-body">
              <span class="settings-q-label"><span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.network.direct_connections}}</span><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.network.direct_connections')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
              <span class="settings-choice-value row">
                <span class="settings-choice-value-text">{{direct_connections_label}}</span>
                <svg class="settings-row-chevron" src="../icons/chevron-right.svg" width="12" height="12"></svg>
              </span>
            </span>
          </button>
        </div>
        <p class="text muted settings-help group-foot">{{i18n:settings.network.direct_connections.help}}</p>

        <div class="settings-subcard stack group-card group-card--pad" data-if="show_connection_card">
          <p class="settings-label group-card-title">{{i18n:settings.network.connection.title}}</p>
          <p class="text"><span class="settings-chip">{{reachability_status_label}}</span></p>
          <p class="text muted">{{reachability_summary}}</p>
          <div class="settings-actions row">
            <button class="btn btn-secondary" type="button" data-event-click="retest_reachability()">
              {{i18n:settings.network.connection.retest}}
            </button>
            <button class="btn btn-secondary" type="button" data-event-click="try_upnp_port()">
              {{i18n:settings.network.connection.try_upnp}}
            </button>
            <button class="btn btn-secondary" type="button" data-event-click="show_reachability_help()">
              {{i18n:settings.network.connection.learn}}
            </button>
          </div>
          <div class="stack" data-if="show_reachability_help && reachability_help_kind == 'outbound_only'">
            <p class="text muted">{{i18n:settings.network.help.outbound_only}}</p>
            <p class="text muted">{{i18n:settings.network.help.skip_relay}}</p>
            <button class="btn btn-secondary" type="button" data-event-click="dismiss_reachability_help()">
              {{i18n:settings.network.help.ack_relay}}
            </button>
          </div>
          <div class="stack" data-if="show_reachability_help && reachability_help_kind == 'blocked'">
            <p class="text muted">{{i18n:settings.network.help.blocked}}</p>
            <p class="text muted">{{i18n:settings.network.help.skip_relay}}</p>
            <button class="btn btn-secondary" type="button" data-event-click="dismiss_reachability_help()">
              {{i18n:settings.network.help.ack_relay}}
            </button>
          </div>
          <div class="stack" data-if="show_reachability_help && reachability_help_kind == 'reachable'">
            <p class="text muted">{{i18n:settings.network.help.reachable}}</p>
            <button class="btn btn-secondary" type="button" data-event-click="dismiss_reachability_help()">
              {{i18n:common.not_now}}
            </button>
          </div>
        </div>

        <div class="stack" data-if="advanced">
        <div class="group-card group-card--pad" data-if="show_node_toggle && node_enabled == 'on'">
        <label class="settings-field">
          <span class="settings-label">{{i18n:settings.network.listen}}</span>
          <p class="text muted">{{amp_listen_multiaddr}}</p>
        </label>
        </div>
        <p class="text muted settings-help group-foot" data-if="mesh_status_message != ''">{{mesh_status_message}}</p>
        </div>
        <p class="text group-head">{{i18n:settings.advanced.group.ai}}</p>
        <p class="text group-foot group-foot--lead" data-if="!advanced">{{i18n:settings.llm.summary}}</p>
        <div class="stack" data-if="advanced">
        <div class="group-card">
          <label class="settings-field group-row group-row--field">
            <span class="group-row-body group-row-body--field">
              <span class="settings-label group-row-text">{{i18n:settings.llm.preset}}</span>
              <select class="field" data-value="llm_preset" data-event-change="on_llm_preset_changed()">
                <option value="brief">{{i18n:settings.llm.preset_brief}}</option>
                <option value="cloud">{{i18n:settings.llm.preset_cloud}}</option>
                <option value="ollama">{{i18n:settings.llm.preset_ollama}}</option>
                <option value="custom">{{i18n:settings.llm.preset_custom}}</option>
              </select>
            </span>
          </label>
          <div class="group-row group-row--static">
            <span class="group-row-body">
              <span class="group-row-label">
                <span class="group-row-text">{{i18n:settings.security.tool_permissions}}</span>
                <span class="group-row-sub">{{i18n:settings.security.tool_permissions.help}}</span>
              </span>
              <span class="group-row-value">{{tool_permissions_summary}}</span>
            </span>
          </div>
        </div>
        <p class="text muted group-foot">{{i18n:settings.llm.preset_help}}</p>
        <div class="group-card settings-phone-only">
          <button class="group-row" type="button" data-event-click="open_security_page('ai_endpoint')">
            <span class="group-row-body">
              <span class="group-row-label"><span class="group-row-text">{{i18n:settings.llm.endpoint.title}}</span></span>
              <span class="group-row-value" data-if="llm_model != ''">{{llm_model}}</span>
              <span class="group-row-value" data-if="llm_model == ''">{{i18n:settings.advanced.not_set}}</span>
              <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
            </span>
          </button>
        </div>
        <div class="stack settings-desktop-only">
{{include:settings_section_advanced_endpoint}}
        </div>
        <div class="group-card">
          <button class="btn btn-secondary settings-action-bar settings-action-row" type="button" data-if="advanced && profile_show_rotate"
                  data-event-click="rotate_brief_llm_key()">{{i18n:settings.llm.rotate_brief_key}}</button>
          <button class="btn btn-secondary settings-action-bar settings-action-row" type="button" data-if="tool_permissions_has_saved"
                  data-event-click="reset_tool_permissions()">{{i18n:settings.security.tool_permissions.reset}}</button>
          <button class="btn btn-secondary settings-action-bar settings-action-row" type="button"
                  data-event-click="reset_section('llm')">{{i18n:common.reset_defaults}}</button>
        </div>
        </div>
        <div class="stack" data-if="advanced">
          <p class="text group-head">{{i18n:settings.integrations.title}}</p>
        <div class="group-card settings-phone-only">
          <button class="group-row" type="button" data-event-click="open_security_page('integrations')">
            <span class="group-row-body">
              <span class="group-row-label"><span class="group-row-text">{{i18n:settings.integrations.page.title}}</span></span>
              <span class="group-row-value" data-if="search_provider != ''">{{search_provider}}</span>
              <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
            </span>
          </button>
        </div>
        <div class="stack settings-desktop-only">
{{include:settings_section_advanced_integrations}}
        </div>
        <div class="group-card">
          <button class="btn btn-secondary settings-action-bar settings-action-row" type="button"
                  data-event-click="reset_section('integrations')">{{i18n:common.reset_defaults}}</button>
        </div>
        </div>
      </div>
