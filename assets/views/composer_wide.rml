<!-- The composer in the wide layout (mockup 50-desktop-main.html page 2): paperclip and emoji lead the row, then the one-line
     pill (a label over it is the "Enter to send" hint), then the microphone (Send once there is text). Same data model and events as composer.rml;
     the microphone is a click-to-record toggle here (no hold-to-talk bar, no voice mode). Mounted instead
     of composer.rml by ViewCatalog::KeyForLayout in the wide pane. Styles: assets/themes/wide.rcss. -->
<!-- The bar above the box: the message being replied to, or "Edit message" while one of ours is edited (a pencil before
     it; DEV/PLAN-message-edit.md). × ends either. -->
<div class="prompt-quote" data-model="chat" data-if="quote_reply || editing_message"
     data-class-prompt-quote--edit="editing_message" keep-focus="">
  <span class="prompt-edit-bar-icon"></span>
  <span class="prompt-quote-text">{{quote_reply_text}}</span>
  <button class="prompt-attachment-chip-remove" type="button" data-event-click="cancel_quote_reply()"
          title="{{i18n:common.cancel}}">
    <svg src="../icons/close.svg" width="10" height="10" crop-to-content="true"></svg>
  </button>
</div>
<div class="prompt-composer prompt-composer--wide" keep-focus="" data-model="chat"
     data-class-prompt-composer--e2e="thread_is_private"
     data-class-prompt-composer--disabled="composer_input_disabled &amp;&amp; !voice_recording">
  <!-- Status row above the input, only when something needs saying: an attachment uploading (the card below) /
       preparing / failed (Retry, Cancel), the AI picture, the AI answer's stop key. A picture being sent shows as a
       bubble in the transcript instead (attachment_in_transcript): then no card and no chip here. -->
  <div class="prompt-composer-status"
       data-if="!voice_recording && ((attachment_here && !attachment_in_transcript && !picking_busy) || image_chip || loading)">
    <div class="prompt-attachment-chip"
         data-if="attachment_here && !attachment_in_transcript && !attachment_uploading && !picking_busy">
      <span class="prompt-attachment-chip-name">{{attachment_draft_name}}</span>
      <span class="prompt-attachment-chip-status">{{attachment_status}}</span>
      <button class="prompt-attachment-chip-action" type="button" data-if="attachment_failed"
              data-event-click="retry_attachment_send()">{{i18n:chat.attachment.retry}}</button>
      <button class="prompt-attachment-chip-action" type="button" data-if="attachment_failed"
              data-event-click="discard_attachment_send()">{{i18n:common.cancel}}</button>
    </div>
    <!-- Sending: what goes (picture, or the type badge of the storage page), its name, the upload ring with the real
         progress (a turning ring while the amount is not known), and a red ✕ that cancels the send. -->
    <div class="prompt-upload-card" data-if="attachment_here && !attachment_in_transcript && attachment_uploading">
      <img class="prompt-upload-thumb" data-if="attachment_thumb != ''" data-attr-src="attachment_thumb"/>
      <div class="storage-file-type prompt-upload-type" data-if="attachment_thumb == ''">
        <span class="storage-file-type-text">{{attachment_type_label}}</span>
      </div>
      <div class="prompt-upload-body">
        <span class="prompt-attachment-chip-name prompt-upload-name">{{attachment_draft_name}}</span>
        <span class="prompt-attachment-chip-status prompt-upload-status">{{attachment_status}}</span>
      </div>
      <div class="prompt-upload-spinner" data-if="attachment_progress_width == '0%'">
        <div class="prompt-upload-spinner-arc"></div>
      </div>
      <div class="prompt-upload-ring" data-if="attachment_progress_width != '0%'">
        <div class="prompt-upload-ring-track" data-style-decorator="attachment_ring_decor"></div>
        <div class="prompt-upload-ring-core"></div>
      </div>
      <button class="prompt-upload-cancel" type="button" title="{{i18n:chat.attachment.cancel_send}}"
              data-class-prompt-upload-cancel--busy="attachment_cancelling"
              data-event-click="cancel_attachment_send()">
        <div class="prompt-upload-cancel-disc">
          <svg class="prompt-upload-cancel-icon" data-if="!attachment_cancelling" src="../icons/close.svg" width="12" height="12"></svg>
          <div class="prompt-upload-cancel-spin" data-if="attachment_cancelling"></div>
        </div>
      </button>
    </div>
    <div class="prompt-attachment-chip" data-if="image_chip">
      <!-- The remove button is a badge on the picture's corner: dark disc, white cross, white ring, so it shows on
           any picture (Kenneth 2026-10-28). -->
      <div class="prompt-image-thumb-wrap">
        <img class="prompt-image-thumb" data-if="image_thumb_ready" data-attr-src="image_thumb_src"/>
        <div class="prompt-image-thumb-placeholder" data-if="!image_thumb_ready"></div>
        <div class="prompt-image-remove-badge" data-event-click="remove_image()" title="{{i18n:chat.image.remove}}">
          <svg src="../icons/close.svg" width="8" height="8" crop-to-content="true"></svg>
        </div>
      </div>
      <span class="prompt-attachment-chip-name">{{image_draft_name}}</span>
      <span class="prompt-attachment-chip-status" data-if="image_preparing">{{i18n:chat.image.preparing}}</span>
    </div>
    <button class="prompt-stop-btn" type="button" data-if="loading" data-event-click="stop_turn()"
            title="{{i18n:chat.stop}}">
      <svg src="../icons/stop.svg" width="14" height="14" crop-to-content="true"></svg>
    </button>
  </div>
  <div class="prompt-composer-row">
    <button class="prompt-attach-btn" type="button" data-if="show_attach_button && !voice_recording && !voice_finishing"
            data-event-click="attach_file()" data-attrif-disabled="attach_disabled" data-class-prompt-entry-off="attach_disabled"
            title="{{i18n:chat.attach_file}}">
      <svg src="../icons/v2/plus-bold.svg" width="20" height="20"></svg>
    </button>
    <button class="prompt-emoji-btn" type="button" data-if="!voice_recording && !voice_finishing" data-event-click="open_emoji_insert()"
            data-attrif-disabled="composer_input_disabled" title="{{i18n:chat.insert_emoji}}">
      <svg src="../icons/v2/emoji.svg" width="20" height="20"></svg>
    </button>
    <div class="prompt-composer-pill" data-if="!voice_recording && !voice_finishing">
      <textarea id="draft-input" class="prompt-composer-input" rows="1" max-rows="5"
                maxlength="65536"
                data-value="draft" data-event-change="draft_changed()"
                data-attrif-disabled="composer_input_disabled"></textarea>
      <!-- The engine draws no placeholder (phone or desktop), so the "Enter to send" hint is a label over the empty field, as on the phone. -->
      <p class="prompt-composer-label prompt-composer-label--wide" data-if="draft == ''">{{i18n:chat.composer.hint_wide}}</p>
      <button class="prompt-capture-btn" type="button" data-if="show_capture && !voice_recording"
              data-event-click="attach_capture()" data-attrif-disabled="attach_disabled" data-class-prompt-entry-off="attach_disabled"
              title="{{i18n:chat.attach.capture}}">
        <svg src="../icons/v2/camera.svg" width="20" height="20"></svg>
      </button>
    </div>
    <!-- A recording (the wide layout: click the microphone to start, click it again to send): the pill is the live row, the
         red dot, the time, a bar that moves with the voice, and "Sending..." while the file is written. -->
    <div class="prompt-composer-pill prompt-voice-live-pill" data-if="voice_recording || voice_finishing">
      <div class="prompt-voice-dot" data-if="voice_recording && !voice_finishing"></div>
      <span class="prompt-voice-timer" data-if="!voice_finishing"
            data-class-prompt-voice-timer--countdown="voice_countdown">{{voice_timer}}</span>
      <div class="prompt-voice-level" data-if="!voice_finishing"><div class="prompt-voice-level-fill" data-style-width="voice_level_width"></div></div>
      <span class="prompt-voice-hint" data-if="!voice_finishing && voice_countdown">{{voice_hint}}</span>
      <span class="prompt-voice-bar-sending" data-if="voice_finishing">{{i18n:chat.attachment.sending}}</span>
    </div>
    <button class="prompt-voice-cancel-x" type="button" data-if="voice_recording && !voice_finishing"
            data-event-click="voice_cancel()" title="{{i18n:common.cancel}}">
      <svg src="../icons/close.svg" width="12" height="12" crop-to-content="true"></svg>
    </button>
    <button class="prompt-send-btn" type="button" data-if="draft != '' && !loading && !voice_recording"
            data-event-click="send_message()" data-attrif-disabled="composer_input_disabled">
      <span class="prompt-send-disc"><svg src="../icons/send.svg" width="14" height="14" crop-to-content="true"></svg></span>
    </button>
    <button class="prompt-send-btn prompt-send-btn--idle" type="button" disabled="disabled"
            data-if="!thread_is_private &amp;&amp; !thread_is_public &amp;&amp; !thread_is_group &amp;&amp; draft == '' &amp;&amp; !loading">
      <span class="prompt-send-disc"><svg src="../icons/send.svg" width="14" height="14" crop-to-content="true"></svg></span>
    </button>
    <!-- The microphone: one click records, the next click sends. Lit (accent) while it records. -->
    <button class="prompt-voice-toggle-btn prompt-voice-toggle-btn--end prompt-mic-btn" type="button"
            data-if="(show_voice || voice_entry_off) && (draft == '' || voice_recording)"
            data-class-prompt-voice-live="voice_recording" data-attrif-disabled="voice_finishing"
            data-event-click="voice_toggle()" data-class-prompt-entry-off="(attach_disabled || voice_blocked) &amp;&amp; !voice_recording"
            title="{{i18n:chat.voice.title}}">
      <svg src="../icons/mic.svg" width="18" height="18" crop-to-content="true"></svg>
    </button>
  </div>
</div>
