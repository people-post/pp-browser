<div class="prompt-quote" data-model="chat" data-if="quote_reply" keep-focus="">
  <span class="prompt-quote-text">{{quote_reply_text}}</span>
  <button class="prompt-attachment-chip-remove" type="button" data-event-click="cancel_quote_reply()"
          title="{{i18n:common.cancel}}">
    <svg src="../icons/close.svg" width="10" height="10" crop-to-content="true"></svg>
  </button>
</div>
<div class="prompt-composer" keep-focus="" data-model="chat"
     data-class-prompt-composer--e2e="thread_is_private"
     data-class-prompt-composer--disabled="composer_input_disabled">
  <!-- Status row above the input, only when something needs saying: an attachment uploading (the card below) /
       preparing / failed (Retry, Cancel), the AI picture, the AI answer's stop key. -->
  <div class="prompt-composer-status"
       data-if="!voice_recording && (attachment_here || image_chip || loading)">
    <div class="prompt-attachment-chip" data-if="attachment_here && !attachment_uploading">
      <span class="prompt-attachment-chip-name">{{attachment_draft_name}}</span>
      <span class="prompt-attachment-chip-status">{{attachment_status}}</span>
      <button class="prompt-attachment-chip-action" type="button" data-if="attachment_failed"
              data-event-click="retry_attachment_send()">{{i18n:chat.attachment.retry}}</button>
      <button class="prompt-attachment-chip-action" type="button" data-if="attachment_failed"
              data-event-click="discard_attachment_send()">{{i18n:common.cancel}}</button>
    </div>
    <!-- Sending: what goes (picture, or the type badge of the storage page), its name, a bar with the real progress
         (it breathes while the bytes move and stops once cancelled), and a red ✕ that cancels the send. -->
    <div class="prompt-upload-card" data-if="attachment_here && attachment_uploading">
      <img class="prompt-upload-thumb" data-if="attachment_thumb != ''" data-attr-src="attachment_thumb"/>
      <div class="storage-file-type prompt-upload-type" data-if="attachment_thumb == ''">
        <span class="storage-file-type-text">{{attachment_type_label}}</span>
      </div>
      <div class="prompt-upload-body">
        <span class="prompt-attachment-chip-name prompt-upload-name">{{attachment_draft_name}}</span>
        <div class="prompt-upload-bar">
          <div class="prompt-upload-fill" data-style-width="attachment_progress_width"
               data-class-prompt-upload-fill--moving="!attachment_cancelling && attachment_progress_width != '100%'"></div>
        </div>
        <span class="prompt-attachment-chip-status prompt-upload-status">{{attachment_status}}</span>
      </div>
      <button class="prompt-upload-cancel" type="button" title="{{i18n:chat.attachment.cancel_send}}"
              data-class-prompt-upload-cancel--busy="attachment_cancelling"
              data-event-click="cancel_attachment_send()">
        <div class="prompt-upload-cancel-disc">
          <svg class="prompt-upload-cancel-icon" data-if="!attachment_cancelling" src="../icons/close.svg" width="12" height="12"></svg>
          <div class="prompt-upload-cancel-spin" data-if="attachment_cancelling"></div>
        </div>
      </button>
    </div>
    <div class="prompt-attachment-chip" data-if="image_chip">
      <!-- The remove button is a badge on the picture's corner: dark disc, white cross, white ring, so it shows on
           any picture (Kenneth 2026-10-28). -->
      <div class="prompt-image-thumb-wrap">
        <img class="prompt-image-thumb" data-if="image_thumb_ready" data-attr-src="image_thumb_src"/>
        <div class="prompt-image-thumb-placeholder" data-if="!image_thumb_ready"></div>
        <div class="prompt-image-remove-badge" data-event-click="remove_image()" title="{{i18n:chat.image.remove}}">
          <svg src="../icons/close.svg" width="8" height="8" crop-to-content="true"></svg>
        </div>
      </div>
      <span class="prompt-attachment-chip-name">{{image_draft_name}}</span>
      <span class="prompt-attachment-chip-status" data-if="image_preparing">{{i18n:chat.image.preparing}}</span>
    </div>
    <button class="prompt-stop-btn" type="button" data-if="loading" data-event-click="stop_turn()"
            title="{{i18n:chat.stop}}">
      <svg src="../icons/stop.svg" width="14" height="14" crop-to-content="true"></svg>
    </button>
  </div>
  <!-- Desktop: the microphone / keyboard toggle leads the row (the --end copies are the phone's, components.rcss). -->
  <div class="prompt-composer-row">
    <button class="prompt-voice-toggle-btn prompt-voice-toggle-btn--start" type="button"
            data-if="show_voice && !voice_mode && !voice_recording"
            data-event-click="voice_mode_toggle()" data-attrif-disabled="composer_input_disabled"
            title="{{i18n:chat.voice.mode_voice}}">
      <svg class="prompt-icon-classic" src="../icons/mic.svg" width="18" height="18" crop-to-content="true"></svg>
    </button>
    <button class="prompt-voice-toggle-btn prompt-voice-toggle-btn--start" type="button"
            data-if="show_voice && voice_mode && !voice_recording"
            data-event-click="voice_mode_toggle()" title="{{i18n:chat.voice.mode_keyboard}}">
      <svg src="../icons/keyboard.svg" width="18" height="18" crop-to-content="true"></svg>
    </button>
    <button class="prompt-emoji-btn" type="button" data-if="!voice_mode" data-event-click="open_emoji_insert()"
            data-attrif-disabled="composer_input_disabled" title="{{i18n:chat.insert_emoji}}">
      <svg class="prompt-icon-classic" src="../icons/emoji.svg" width="18" height="18" crop-to-content="true"></svg>
        <svg class="prompt-icon-v2" src="../icons/v2/emoji.svg" width="20" height="20"></svg>
        <svg class="prompt-icon-home-emoji" src="../icons/v2/emoji-round.svg" width="24" height="24"></svg>
    </button>
    <!-- The input is one pill: the text grows from one line to five (then scrolls). Desktop: the paperclip and the
         camera sit inside its right end. Phones (Kenneth 2026-11-07): the bold plus and the emoji key sit inside its
         bottom left, the microphone (Send once there is text) inside its bottom right; no camera (the plus card has
         it). components.rcss places them. -->
    <div class="prompt-composer-pill" data-if="!voice_mode">
      <textarea id="draft-input" class="prompt-composer-input" placeholder="Ask anything…" rows="1" max-rows="5"
                maxlength="65536"
                data-value="draft" data-event-change="draft_changed()" data-attr-placeholder="draft_placeholder"
                data-attrif-disabled="composer_input_disabled"></textarea>
      <!-- Phones: the engine draws no placeholder, so a label sits over the empty input (hidden on the desktop). -->
      <p class="prompt-composer-label prompt-composer-label--thread" data-if="draft == '' && thread_is_ai">{{draft_placeholder}}</p>
      <!-- Only the Home-root field (inside #home-composer-mount) shows this one; inside a conversation the thread label above
           (draft_placeholder) stays (Kenneth 2026-11-07: 我能为你做点什么？). -->
      <p class="prompt-composer-label prompt-composer-label--home" data-if="draft == ''">{{i18n:home.composer.placeholder}}</p>
      <p class="prompt-composer-label" data-if="draft == '' && !thread_is_ai">{{i18n:chat.composer.placeholder}}</p>
      <!-- A phone shows the bold plus here (its floating Camera / Photos / File card: the chat's, or the AI's). -->
      <button class="prompt-attach-btn" type="button" data-if="show_attach_button"
              data-event-click="attach_file()" data-attrif-disabled="composer_input_disabled"
              title="{{i18n:chat.attach_file}}">
        <svg class="prompt-icon-classic" src="../icons/attach.svg" width="18" height="18" crop-to-content="true"></svg>
        <svg class="prompt-icon-v2" src="../icons/v2/paperclip.svg" width="20" height="20"></svg>
        <svg class="prompt-icon-plus" src="../icons/v2/plus-bold.svg" width="24" height="24"></svg>
      </button>
      <!-- The Home-root field only (hidden elsewhere by CSS): a bold plus inside the box that opens a floating menu with
           Camera and Photos. -->
      <button class="prompt-home-plus" type="button" data-if="show_attach_button"
              data-event-click="home_attach_menu()" data-attrif-disabled="composer_input_disabled"
              title="{{i18n:chat.attach_file}}">
        <svg class="prompt-icon-home" src="../icons/v2/plus-bold.svg" width="26" height="26"></svg>
      </button>
      <button class="prompt-capture-btn" type="button" data-if="show_capture && !voice_mode && !voice_recording"
              data-event-click="attach_capture()" data-attrif-disabled="composer_input_disabled"
              title="{{i18n:chat.attach.capture}}">
        <svg class="prompt-icon-classic" src="../icons/camera.svg" width="18" height="18" crop-to-content="true"></svg>
        <svg class="prompt-icon-v2" src="../icons/v2/camera.svg" width="20" height="20"></svg>
      </button>
    </div>
    <!-- Voice mode (WeChat style): one wide bar takes the pill's place. A phone presses and holds on it (mousedown
         starts, the document sees the release); the desktop clicks, then uses Cancel / Send beside it. While
         recording it shows the red dot, the timer and the hint. -->
    <button class="prompt-voice-bar" type="button" data-if="voice_mode && show_voice"
            data-class-prompt-voice-bar--blocked="voice_blocked"
            data-class-prompt-voice-bar--active="voice_recording" data-attr-title="voice_title"
            data-event-mousedown="voice_press()" data-event-click="voice_click()">
      <span class="prompt-voice-bar-hold" data-if="!voice_recording && !voice_finishing && !voice_click_mode">{{i18n:chat.voice.hold_to_talk}}</span>
      <span class="prompt-voice-bar-click" data-if="!voice_recording && !voice_finishing && voice_click_mode">{{i18n:chat.voice.click_to_talk}}</span>
      <span class="prompt-voice-bar-sending" data-if="voice_finishing">{{i18n:chat.attachment.sending}}</span>
      <div class="prompt-voice-status" data-if="voice_recording && !voice_finishing">
        <div class="prompt-voice-dot"></div>
        <span class="prompt-voice-timer" data-class-prompt-voice-timer--countdown="voice_countdown">{{voice_timer}}</span>
        <span class="prompt-voice-hint" data-class-prompt-voice-hint--cancel="voice_cancel_zone">{{voice_hint}}</span>
      </div>
    </button>
    <!-- Desktop recording (started by a click on the voice bar): Cancel / Send. -->
    <button class="prompt-voice-cancel-btn" type="button" data-if="voice_recording && voice_click_mode"
            data-event-click="voice_cancel()">{{i18n:common.cancel}}</button>
    <button class="prompt-send-btn" type="button" data-if="voice_recording && voice_click_mode"
            data-event-click="voice_send()" title="{{i18n:chat.voice.send}}">
      <svg src="../icons/send.svg" width="14" height="14" crop-to-content="true"></svg>
    </button>
    <!-- Send appears only when there is something to send. -->
    <button class="prompt-send-btn" type="button" data-if="!voice_mode && draft != '' && !loading"
            data-event-click="send_message()" data-attrif-disabled="composer_input_disabled">
      <span class="prompt-send-disc"><svg src="../icons/send.svg" width="14" height="14" crop-to-content="true"></svg></span>
    </button>
    <!-- Phones (WhatsApp, Kenneth 2026-11-04): the microphone ends the row and gives its place to Send once there is
         text; in voice mode the keyboard key takes it. Same buttons and handlers as the desktop's leading pair. -->
    <button class="prompt-voice-toggle-btn prompt-voice-toggle-btn--end" type="button"
            data-if="show_voice && !voice_mode && !voice_recording && draft == ''"
            data-event-click="voice_mode_toggle()" data-attrif-disabled="composer_input_disabled"
            title="{{i18n:chat.voice.mode_voice}}">
      <svg class="prompt-icon-v2" src="../icons/v2/mic.svg" width="20" height="20"></svg>
    </button>
    <button class="prompt-voice-toggle-btn prompt-voice-toggle-btn--end" type="button"
            data-if="show_voice && voice_mode && !voice_recording"
            data-event-click="voice_mode_toggle()" title="{{i18n:chat.voice.mode_keyboard}}">
      <svg src="../icons/keyboard.svg" width="18" height="18" crop-to-content="true"></svg>
    </button>
  </div>
</div>
