<div class="people-picker stack" data-model="people_picker" data-class-people-picker--choose="choose_mode">
  <div data-if="step == 'select'" class="people-picker-select stack">
    <div class="people-picker-header sheet-header row">
      <p class="people-picker-title sheet-title">{{title}}</p>
    </div>

    <div class="people-picker-search">
      <input class="field people-picker-search-field" type="text" data-value="search_query"
             data-event-change="on_search_changed()" placeholder="{{i18n:people_picker.search_placeholder}}"/>
      <span class="people-picker-search-hint" data-if="search_query == ''">{{i18n:people_picker.search_placeholder}}</span>
    </div>

    <div class="people-picker-list">
      <button class="btn btn-secondary" type="button" data-if="show_add_members"
              data-event-click="add_members()">{{i18n:people_picker.add_members}}</button>
      <div data-for="row : rows"
           class="people-picker-row"
           data-class-people-picker-row--selected="row.selected"
           data-class-people-picker-row--locked="row.locked || row.disabled"
           data-event-click="toggle_contact(row.id)">
        <div class="people-picker-check" data-if="show_checks">
          <p class="people-picker-check-mark" data-if="row.selected">✓</p>
        </div>
        <div class="people-picker-row-body">
          <p class="people-picker-row-title">{{row.title}}</p>
          <p class="people-picker-row-subtitle text muted" data-if="row.subtitle != ''">{{row.subtitle}}</p>
        </div>
        <p class="text muted people-picker-locked-label" data-if="row.locked">{{i18n:people_picker.in_chat}}</p>
      </div>

      <p class="text muted" data-if="rows.size == 0 && search_query == ''">{{empty_hint}}</p>
      <p class="text muted" data-if="rows.size == 0 && search_query != ''">{{i18n:people_picker.no_matches}}</p>
      <p class="text muted" data-if="full_hint != ''">{{full_hint}}</p>
      <p class="text muted" data-if="invite_hint != ''">{{invite_hint}}</p>
    </div>

    <div class="people-picker-footer stack">
      <!-- Choose and return (Forward to): what is about to be sent, two lines at most. -->
      <!-- Why Send is off (too many files, too big, a call is on): the specific line, above the strip. -->
      <p class="people-picker-refusal" data-if="choose_refusal != ''">{{choose_refusal}}</p>
      <div class="people-picker-preview" data-if="show_preview">
        <p class="people-picker-preview-text" data-if="preview_text != ''">{{preview_text}}</p>
        <!-- Attachments: a picture's thumbnail, a video's poster, or a type icon; grey when this device has no bytes. -->
        <div class="people-picker-preview-items row" data-if="preview_items.size > 0">
          <div data-for="item : preview_items" class="people-picker-preview-item"
               data-class-people-picker-preview-item--grey="item.grey">
            <div class="people-picker-preview-tile">
              <img class="people-picker-preview-thumb" data-if="item.thumb != ''" data-attr-src="item.thumb"/>
              <div class="people-picker-preview-icon" data-if="item.thumb == ''">
                <svg data-if="item.icon == 'photo'" src="../icons/v2/photo.svg" width="24" height="24"></svg>
                <svg data-if="item.icon == 'video'" src="../icons/v2/video.svg" width="24" height="24"></svg>
                <svg data-if="item.icon == 'mic'" src="../icons/v2/mic.svg" width="24" height="24"></svg>
                <svg data-if="item.icon == 'file'" src="../icons/v2/file.svg" width="24" height="24"></svg>
                <svg data-if="item.icon == 'card'" src="../icons/v2/user.svg" width="24" height="24"></svg>
                <svg data-if="item.icon == 'text'" src="../icons/v2/compose.svg" width="24" height="24"></svg>
              </div>
            </div>
            <p class="people-picker-preview-label" data-if="item.label != ''">{{item.label}}</p>
          </div>
        </div>
        <p class="people-picker-preview-note" data-if="preview_note != ''">{{preview_note}}</p>
      </div>
      <label class="people-picker-video-option row" data-if="show_call_video_option">
        <input type="checkbox" data-value="call_video_allowed"/>
        <span>{{i18n:people_picker.allow_video}}</span>
      </label>
      <div class="row people-picker-footer-actions">
      <button class="btn btn-secondary" type="button" data-if="show_cta"
              data-event-click="cancel_picker()">{{i18n:common.cancel}}</button>
      <button class="btn btn-secondary" type="button" data-if="!show_cta"
              data-event-click="cancel_picker()">{{i18n:common.close}}</button>
      <button class="btn btn-primary" type="button" data-if="show_cta" data-event-click="confirm_picker()"
              data-attrif-disabled="!cta_enabled">
        <span>{{cta_label}}</span>
      </button>
      </div>
    </div>
  </div>

  <div data-if="step == 'name'" class="people-picker-name stack">
    <div class="people-picker-header sheet-header row">
      <p class="people-picker-title sheet-title">{{title}}</p>
    </div>

    <p class="text muted people-picker-name-help">{{group_title_help}}</p>

    <label class="settings-field people-picker-name-field">
      <span class="text muted">{{i18n:people_picker.group_title_prompt}}</span>
      <input class="field" type="text" data-value="group_title"
             placeholder="{{i18n:people_picker.default_group_title}}"/>
    </label>

    <div class="people-picker-members stack">
      <p class="text muted people-picker-members-label">{{i18n:people_picker.members_label}}</p>
      <div class="people-picker-member-chips row">
        <div data-for="member : member_summary" class="people-picker-member-chip">
          <span>{{member.title}}</span>
        </div>
      </div>
    </div>

    <div class="people-picker-footer row">
      <button class="btn btn-secondary people-picker-back-text" type="button" data-event-click="back_picker()">{{i18n:common.back}}</button>
      <!-- Phones: the round back (DEV/PLAN-minimal-nav.md G); the desktop keeps the word. -->
      <button class="shell-circle-btn people-picker-back-circle" type="button" data-event-click="back_picker()">
        <span class="shell-circle-btn-face"><svg src="../icons/v2/back.svg" width="24" height="24"></svg></span>
      </button>
      <button class="btn btn-primary" type="button" data-event-click="create_group()">
        {{i18n:people_picker.cta_create_group}}
      </button>
    </div>
  </div>
</div>
