<div class="settings-panel stack" data-model="settings">
  <div class="settings-list-view" data-if="!show_detail">
    <div class="settings-header row" data-if="!in_account_sheet">
      <h2 class="heading-2">Me</h2>
    </div>

    <div class="me-profile-card stack">
      <label class="settings-field">
        <span class="settings-label">{{i18n:settings.nickname}}</span>
        <input class="field" type="text" data-value="profile_nickname" lang=""
               data-event-blur="on_profile_nickname_commit()"
               placeholder="Your display name"/>
      </label>
      <p class="text muted me-profile-meta">
        Registration: <span data-rml="profile_registration_status"></span>
      </p>
      <div class="me-profile-actions row">
        <button class="btn btn-secondary btn-icon" type="button" data-event-click="copy_profile_id()">
          <svg src="../icons/copy.svg" width="14" height="14" crop-to-content="true"></svg>
          Copy ID
        </button>
        <button class="btn btn-secondary btn-icon" type="button" data-event-click="share_profile()">
          <svg src="../icons/share.svg" width="14" height="14" crop-to-content="true"></svg>
          Share
        </button>
        <button class="btn btn-primary" type="button"
                data-if="profile_show_register && profile_registration_status != 'active'"
                data-event-click="register_profile()"><span data-rml="profile_register_label"></span></button>
      </div>
      <p class="text muted" data-if="status != ''" data-rml="status"></p>
    </div>

    <p class="settings-section-title me-preferences-label">{{i18n:settings.preferences}}</p>
    <div class="settings-list">
      <button data-for="section : sections"
              class="settings-row" type="button"
              data-class-settings-row--active="section.id == selected_id && selected_id != ''"
              data-event-click="select_section(section.id)">
        <div class="settings-row-text stack">
          <p class="settings-row-title" data-rml="section.title"></p>
          <p class="settings-row-subtitle text muted" data-if="section.subtitle != ''" data-rml="section.subtitle"></p>
        </div>
        <svg class="settings-row-chevron" src="../icons/chevron-right.svg" width="14" height="14"></svg>
      </button>
    </div>
  </div>

  <div data-if="show_detail" class="settings-detail-view stack">
    <div class="settings-detail-header row">
      <button class="settings-back-btn" type="button" data-event-click="back_to_list()">
        <svg src="../icons/back.svg" width="18" height="18"></svg>
      </button>
      <p class="settings-header-title" data-rml="selected_title"></p>
    </div>

    <div class="settings-detail-body stack">
      {{include:settings_sections}}
    </div>
  </div>
</div>
