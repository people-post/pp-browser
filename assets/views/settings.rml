<div class="settings-panel stack" data-model="settings">
  <div class="settings-header row">
    <h2 class="heading-2">Settings</h2>
  </div>

  <div class="settings-section stack">
    <p class="settings-section-title">LLM</p>
    <label class="settings-field">
      <span class="settings-label">Preset</span>
      <select class="field" data-attr-value="llm_preset" data-event-change="draft_llm_preset_changed()">
        <option value="cloud">Cloud (OpenAI-compatible)</option>
        <option value="ollama">Ollama (localhost)</option>
        <option value="custom">Custom</option>
      </select>
    </label>
    <p class="text muted">Preset defaults apply when you save.</p>
    <label class="settings-field">
      <span class="settings-label">Base URL</span>
      <input class="field" type="text" data-value="llm_base_url" data-event-change="draft_llm_base_url_changed()"/>
    </label>
    <label class="settings-field">
      <span class="settings-label">Model</span>
      <input class="field" type="text" data-value="llm_model" data-event-change="draft_llm_model_changed()"/>
    </label>
    <label class="settings-field">
      <span class="settings-label">API key</span>
      <input class="field" type="password" data-value="llm_api_key" placeholder="Optional for local / Ollama endpoints"/>
    </label>
    <label class="settings-field">
      <span class="settings-label">API key env var (advanced)</span>
      <input class="field" type="text" data-value="llm_api_key_env" data-event-change="draft_llm_api_key_env_changed()" placeholder="Optional (e.g. OPENAI_API_KEY)"/>
    </label>
  </div>

  <div class="settings-section stack">
    <p class="settings-section-title">Appearance</p>
    <label class="settings-field">
      <span class="settings-label">Theme</span>
      <input class="field" type="text" data-value="theme" data-event-change="draft_theme_changed()"/>
    </label>
  </div>

  <div class="settings-section stack">
    <p class="settings-section-title">Storage</p>
    <p class="text muted">Profile: <span data-rml="profile_label"></span></p>
    <p class="text muted settings-path">Config: <span data-rml="config_dir"></span></p>
    <p class="text muted settings-path">Data: <span data-rml="data_dir"></span></p>
    <p class="text muted settings-path">Profile data: <span data-rml="profile_dir"></span></p>
  </div>

  <p class="text muted" data-if="status != ''" data-rml="status"></p>

  <div class="settings-actions row">
    <button class="btn btn-secondary" type="button" data-event-click="reset_to_defaults()">Reset to defaults</button>
    <button class="btn btn-primary" type="button" data-event-click="save_settings()">Save</button>
  </div>
</div>
