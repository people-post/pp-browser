<div class="preview-panel stack" data-model="shell">
  <h2 class="heading-2 preview-title">Preview</h2>
  <p class="text muted">Latest assistant reply</p>
  <div class="preview-content" data-if="preview_rml != ''" data-rml="preview_rml"></div>
  <p class="text muted" data-if="preview_rml == ''">No assistant reply yet.</p>
</div>
