      <div class="stack" data-if="advanced">
      <div class="settings-section settings-section--grouped stack">
        <p class="text muted settings-help group-foot">{{i18n:settings.tester.banner}}</p>
        <div class="group-card" data-if="show_backend_switch">
          <button class="settings-toggle-row settings-choice-row row group-row" type="button"
                  data-event-click="on_choose_backend()">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.network.backend}}</span>
              <span class="settings-choice-value row">
                <span class="settings-choice-value-text">{{backend_label}}</span>
                <svg class="settings-row-chevron" src="../icons/chevron-right.svg" width="12" height="12"></svg>
              </span>
            </span>
          </button>
        </div>
        <p class="text muted settings-help group-foot" data-if="show_backend_switch">{{i18n:settings.network.backend.help}}</p>
        <p class="text settings-help group-foot" data-if="show_backend_switch && backend_restart_pending">{{i18n:settings.network.backend.restart}}</p>
        <div class="stack" data-if="advanced">
        <div class="group-card" data-if="backend_is_custom">
          <label class="settings-field group-row group-row--field">
            <span class="group-row-body group-row-body--field">
              <span class="settings-label group-row-text">{{i18n:settings.network.relay}}</span>
              <input class="field" type="text" data-value="relay_base_url" data-event-change="on_network_field_changed()"/>
            </span>
          </label>
        </div>
        <div class="group-card" data-if="backend_is_custom">
          <label class="settings-field group-row group-row--field">
            <span class="group-row-body group-row-body--field">
              <span class="settings-label group-row-text">{{i18n:settings.network.directory}}</span>
              <input class="field" type="text" data-value="directory_base_url" data-event-change="on_network_field_changed()"/>
            </span>
          </label>
        </div>
        <div class="group-card" data-if="backend_is_custom">
          <label class="settings-field group-row group-row--field">
            <span class="group-row-body group-row-body--field">
              <span class="settings-label group-row-text">{{i18n:settings.network.registration}}</span>
              <input class="field" type="text" data-value="registration_base_url" data-event-change="on_network_field_changed()"/>
            </span>
          </label>
        </div>
        <div class="settings-actions stack">
          <button class="btn btn-secondary settings-action-bar" type="button"
                  data-event-click="reset_section('network')">{{i18n:common.reset_defaults}}</button>
        </div>
        </div>
        <div class="group-card">
          <div class="settings-toggle-row row group-row">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.call_diagnostics.label}}</span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="call_diagnostics == 'on'"
                      data-event-click="toggle_call_diagnostics()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
        </div>
        <p class="text muted settings-help group-foot">{{i18n:settings.call_diagnostics.help}}</p>
        <p class="text group-head" data-if="advanced">{{i18n:settings.security.group.diagnostics}}</p>
        <div class="stack settings-actions" data-if="advanced">
          <p class="text muted settings-help group-foot">{{i18n:settings.security.clear_undelivered.help}}</p>
          <button class="btn" type="button" data-event-click="clear_undelivered_older_than()">
            {{i18n:settings.security.clear_undelivered}}
          </button>
        </div>
        <button class="btn btn-secondary settings-action-bar" type="button"
                data-event-click="show_ask_ai_intro_again()">{{i18n:settings.tester.show_ask_ai_intro}}</button>
        <button class="btn btn-secondary settings-action-bar" type="button" data-if="dev_tools_available"
                data-event-click="open_ui_perf_test()">{{i18n:dev.perf.row}}</button>
        <button class="btn btn-secondary settings-action-bar" type="button" data-if="dev_tools_available"
                data-event-click="simulate_chats_link_offline()">{{i18n:dev.link.sim_offline}}</button>
        <button class="btn btn-secondary settings-action-bar" type="button" data-if="dev_tools_available"
                data-event-click="simulate_chats_link_connecting()">{{i18n:dev.link.sim_connecting}}</button>
        <button class="btn btn-secondary settings-action-bar" type="button" data-if="dev_tools_available"
                data-event-click="simulate_chats_link_online()">{{i18n:dev.link.sim_online}}</button>
      </div>
      <div class="settings-section stack storage-section" data-if="advanced">
            <p class="text muted">{{i18n:settings.storage.profile_label}} <span>{{profile_label}}</span></p>
            <p class="text">{{i18n:settings.storage.library.title}}</p>
            <p class="text muted">{{i18n:settings.storage.library.help}}</p>
            <div class="settings-actions row">
              <button class="btn btn-secondary" type="button"
                      data-event-click="set_cas_library_filter('all')">{{i18n:settings.storage.library.filter_all}}</button>
              <button class="btn btn-secondary" type="button"
                      data-event-click="set_cas_library_filter('private')">{{i18n:settings.storage.library.filter_private}}</button>
              <button class="btn btn-secondary" type="button"
                      data-event-click="set_cas_library_filter('public')">{{i18n:settings.storage.library.filter_public}}</button>
              <button class="btn btn-secondary" type="button"
                      data-event-click="set_cas_library_filter('cache')">{{i18n:settings.storage.library.filter_cache}}</button>
            </div>
            <p class="text muted" data-if="cas_library_rows.size == 0">{{cas_library_empty_label}}</p>
            <div data-for="item, item_index : cas_library_rows" class="settings-subsection stack">
              <div class="row">
                <p class="text">{{item.title}}</p>
                <p class="text muted"> · </p>
                <p class="text muted">{{item.realm_label}}</p>
                <p class="text muted"> · </p>
                <p class="text muted">{{item.pin_label}}</p>
              </div>
              <p class="text muted">{{item.detail}}</p>
              <div class="settings-actions row">
                <button class="btn btn-secondary" type="button" data-if="item.can_share_publicly"
                        data-event-click="share_cas_publicly(item_index)">{{i18n:settings.storage.library.share_publicly}}</button>
                <button class="btn btn-secondary" type="button" data-if="item.can_unpublish"
                        data-event-click="unpublish_cas(item_index)">{{i18n:settings.storage.library.unpublish}}</button>
                <button class="btn btn-secondary" type="button" data-if="item.can_copy_tip"
                        data-event-click="copy_cas_tip(item_index)">{{i18n:settings.storage.library.copy_tip}}</button>
              </div>
            </div>
            <div class="settings-actions row">
              <button class="btn btn-secondary" type="button"
                      data-event-click="fetch_cas_tip()">{{i18n:settings.storage.library.fetch_tip}}</button>
            </div>
            <p class="text muted settings-path">{{i18n:settings.storage.config_label}} <span>{{config_dir}}</span></p>
            <p class="text muted settings-path">{{i18n:settings.storage.data_label}} <span>{{data_dir}}</span></p>
            <p class="text muted settings-path">{{i18n:settings.storage.profile_data_label}} <span>{{profile_dir}}</span></p>
      </div>
      </div>
