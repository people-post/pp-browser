<div class="contact-detail-panel stack" data-model="contacts">
  <div class="contacts-detail-header stack">
    <div class="contact-detail-avatar-row row">
      <div class="contact-detail-avatar-frame"
           data-class-avatar-tone-0="!selected.has_icon && selected.avatar_tone == 0"
           data-class-avatar-tone-1="!selected.has_icon && selected.avatar_tone == 1"
           data-class-avatar-tone-2="!selected.has_icon && selected.avatar_tone == 2"
           data-class-avatar-tone-3="!selected.has_icon && selected.avatar_tone == 3"
           data-class-avatar-tone-4="!selected.has_icon && selected.avatar_tone == 4"
           data-class-avatar-tone-5="!selected.has_icon && selected.avatar_tone == 5"
           data-class-avatar-tone-6="!selected.has_icon && selected.avatar_tone == 6"
           data-class-avatar-tone-7="!selected.has_icon && selected.avatar_tone == 7">
        <img class="contact-detail-avatar-image" data-if="selected.has_icon" data-attr-src="selected.icon_src"/>
        <p class="avatar-letter" data-if="!selected.has_icon">{{selected.avatar_letter}}</p>
      </div>
      <div class="contact-detail-title-block stack">
        <div class="contacts-row-title-line row">
          <p class="contacts-header-title">{{selected.title}}</p>
          <span class="contacts-trust-badge contacts-trust-badge--friendly"
                data-if="selected.trust_key == 'friendly'">{{i18n:contacts.trust.friendly}}</span>
          <span class="contacts-trust-badge contacts-trust-badge--blocked"
                data-if="selected.trust_key == 'blocked'">{{i18n:contacts.trust.blocked}}</span>
        </div>
        <p class="contacts-row-subtitle contacts-row-subtitle--desktop text muted" data-if="selected.subtitle != ''">{{selected.subtitle}}</p>
        <p class="cd-account" data-if="selected.short_id != ''">{{i18n:contacts.account_short}} {{selected.short_id}}</p>
      </div>
    </div>
  </div>

  <div class="cd-phone">
    <!-- A group member who is not a contact (opened from a group chat): only Add contact. -->
    <div data-if="selected.member_preview">
      <div class="cd-acts row">
        <button class="cd-act" type="button" data-event-click="add_member_contact()">
          <svg class="cd-act-icon" src="../icons/v2/user-plus.svg" width="24" height="24"></svg>
          <p class="cd-act-label">{{i18n:contacts.add}}</p>
        </button>
      </div>
      <p class="cd-footnote cd-footnote--center">{{i18n:contacts.member_not_contact}}</p>
    </div>
    <div data-if="!selected.member_preview">
      <div class="cd-acts row">
        <button class="cd-act" type="button" data-if="selected.can_message" data-event-click="secure_message()">
          <svg class="cd-act-icon" src="../icons/v2/tab-chats.svg" width="24" height="24"></svg>
          <p class="cd-act-label">{{i18n:contacts.message}}</p>
        </button>
      </div>
      <p class="cd-footnote" data-if="!selected.can_message">{{selected.message_hint}}</p>

      <div class="cd-card">
        <label class="cd-row cd-row--field">
          <span class="cd-row-body">
            <span class="cd-row-text">{{i18n:contacts.display_name}}</span>
            <input class="cd-field" type="text" data-value="selected.display_name"
                   data-event-change="on_contact_field_changed()" data-attr-placeholder="selected.name_placeholder"/>
            <span class="group-field-hint" data-if="selected.display_name == ''">{{selected.name_placeholder}}</span>
          </span>
        </label>
        <div class="cd-row" data-if="selected.trust_key != 'blocked'">
          <span class="cd-row-body">
            <span class="cd-row-text">{{i18n:contacts.trust_toggle}}</span>
            <button class="settings-switch cd-switch" type="button"
                    data-class-settings-switch--on="selected.trust_key == 'friendly'"
                    data-event-click="toggle_trust_friendly()">
              <div class="settings-switch-knob"></div>
            </button>
          </span>
        </div>
      </div>
      <p class="cd-footnote" data-if="selected.their_nickname != ''">{{selected.their_nickname}}</p>
      <p class="cd-footnote" data-if="selected.trust_key != 'blocked'">{{i18n:contacts.trust_toggle.help}}</p>
      <p class="cd-footnote" data-if="selected.trust_key == 'blocked'">{{i18n:contacts.blocked_hint}}</p>

      <div class="cd-card">
        <button class="cd-row" type="button" data-if="advanced && selected.has_relay_id" data-event-click="sync_contact_remote()">
          <span class="cd-row-body">
            <span class="cd-row-text">{{i18n:contacts.sync_directory}}</span>
            <svg class="cd-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
          </span>
        </button>
        <div class="cd-row">
          <span class="cd-row-body">
            <span class="cd-row-text">{{i18n:contacts.account_short}}</span>
            <span class="cd-row-value">{{selected.short_id}}</span>
            <button class="cd-icon-btn" type="button" title="{{i18n:contacts.copy_id}}" data-event-click="copy_contact_id()">
              <svg class="cd-icon" src="../icons/v2/copy.svg" width="20" height="20"></svg>
            </button>
          </span>
        </div>
        <button class="cd-row" type="button" data-event-click="share_contact()">
          <span class="cd-row-body">
            <span class="cd-row-text">{{i18n:common.share}}</span>
            <svg class="cd-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
          </span>
        </button>
      </div>

      <div class="cd-card" data-if="selected.can_message || selected.threads.size > 0">
        <button class="cd-row" type="button" data-if="selected.can_message" data-event-click="start_chat()">
          <span class="cd-row-body">
            <span class="cd-row-text">{{i18n:contacts.public_chat}}</span>
            <svg class="cd-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
          </span>
        </button>
        <button class="cd-row" type="button" data-for="thread : selected.threads" data-event-click="open_thread(thread.id)">
          <span class="cd-row-body">
            <span class="cd-row-text">{{thread.title}}</span>
            <span class="cd-row-value">{{thread.channel_label}}</span>
            <svg class="cd-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
          </span>
        </button>
      </div>

      <div class="cd-card" data-if="selected.nickname != '' || advanced">
        <div class="cd-row" data-if="selected.nickname != ''">
          <span class="cd-row-body">
            <span class="cd-row-text">{{i18n:contacts.nickname_label}}</span>
            <span class="cd-row-value">{{selected.nickname}}</span>
          </span>
        </div>
        <div class="cd-row" data-if="advanced && selected.relay_id != ''">
          <span class="cd-row-body">
            <span class="cd-row-text">{{i18n:contacts.relay_id_label}}</span>
            <span class="cd-row-value">{{selected.relay_id}}</span>
          </span>
        </div>
        <div class="cd-row" data-if="advanced && selected.peer_id != ''">
          <span class="cd-row-body">
            <span class="cd-row-text">{{i18n:contacts.peer_id_label}}</span>
            <span class="cd-row-value">{{selected.peer_id}}</span>
          </span>
        </div>
        <div class="cd-row" data-if="advanced && selected.multiaddrs_summary != ''">
          <span class="cd-row-body">
            <span class="cd-row-text">{{i18n:contacts.multiaddrs_label}}</span>
            <span class="cd-row-value">{{selected.multiaddrs_summary}}</span>
          </span>
        </div>
        <div class="cd-row" data-if="advanced && selected.signing_fingerprint != ''">
          <span class="cd-row-body">
            <span class="cd-row-text">{{i18n:contacts.signing_fingerprint_label}}</span>
            <span class="cd-row-value">{{selected.signing_fingerprint}}</span>
          </span>
        </div>
      </div>

      <div class="cd-card">
        <button class="cd-row cd-row--danger" type="button" data-if="selected.trust_key != 'blocked'"
                data-event-click="block_contact()">
          <span class="cd-row-body"><span class="cd-row-text">{{i18n:contacts.block}}</span></span>
        </button>
        <button class="cd-row" type="button" data-if="selected.trust_key == 'blocked'"
                data-event-click="unblock_contact()">
          <span class="cd-row-body"><span class="cd-row-text cd-row-text--accent">{{i18n:contacts.unblock}}</span></span>
        </button>
        <button class="cd-row cd-row--danger" type="button" data-event-click="remove_contact()">
          <span class="cd-row-body"><span class="cd-row-text">{{i18n:contacts.remove_button}}</span></span>
        </button>
      </div>
    </div>
  </div>

  <div class="contacts-detail-body stack">
    <div class="contact-detail-section stack">
      <p class="settings-section-title">{{i18n:contacts.you}}</p>
      <label class="settings-field contacts-edit-field">
        <span class="text muted">{{i18n:contacts.display_name}}</span>
        <input class="field" type="text" data-value="selected.display_name"
               data-event-change="on_contact_field_changed()" data-attr-placeholder="selected.name_placeholder"/>
        <span class="text muted settings-help" data-if="selected.their_nickname != ''">{{selected.their_nickname}}</span>
      </label>
      <div class="settings-toggle-row row" data-if="selected.trust_key != 'blocked'">
        <span class="settings-label settings-toggle-label">{{i18n:contacts.trust_toggle}}</span>
        <button class="settings-switch" type="button"
                data-class-settings-switch--on="selected.trust_key == 'friendly'"
                data-event-click="toggle_trust_friendly()">
          <div class="settings-switch-knob"></div>
        </button>
      </div>
      <p class="text muted settings-help" data-if="selected.trust_key != 'blocked'">{{i18n:contacts.trust_toggle.help}}</p>
      <p class="text muted settings-help" data-if="selected.trust_key == 'blocked'">{{i18n:contacts.blocked_hint}}</p>
    </div>

    <div class="contact-detail-section stack">
      <p class="settings-section-title">{{i18n:contacts.directory}}</p>
      <p class="text muted me-profile-meta" data-if="selected.nickname != ''">
        {{i18n:contacts.nickname_label}} <span>{{selected.nickname}}</span>
      </p>
      <p class="text muted me-profile-meta" data-if="selected.relay_id != ''">
        {{i18n:contacts.relay_id_label}} <span>{{selected.relay_id}}</span>
      </p>
      <p class="text muted me-profile-meta" data-if="selected.relay_id == ''">
        {{i18n:contacts.relay_id_unlinked}}
      </p>
      <p class="text muted me-profile-meta" data-if="advanced && selected.peer_id != ''">
        {{i18n:contacts.peer_id_label}} <span>{{selected.peer_id}}</span>
      </p>
      <p class="text muted me-profile-meta" data-if="advanced && selected.multiaddrs_summary != ''">
        {{i18n:contacts.multiaddrs_label}} <span>{{selected.multiaddrs_summary}}</span>
      </p>
      <p class="text muted me-profile-meta" data-if="advanced && selected.signing_fingerprint != ''">
        {{i18n:contacts.signing_fingerprint_label}} <span>{{selected.signing_fingerprint}}</span>
      </p>
      <p class="text muted me-profile-meta" data-if="advanced">{{selected.remote_updated}}</p>
      <div class="me-profile-actions row">
        <div data-if="advanced && selected.has_relay_id">
          <button class="btn btn-secondary btn-icon" type="button" data-event-click="sync_contact_remote()">
            <svg src="../icons/sync.svg" width="14" height="14" crop-to-content="true"></svg>
            {{i18n:contacts.sync_directory}}
          </button>
        </div>
        <button class="btn btn-secondary btn-icon" type="button" data-event-click="copy_contact_id()">
          <svg src="../icons/copy.svg" width="14" height="14" crop-to-content="true"></svg>
          {{i18n:contacts.copy_id}}
        </button>
        <button class="btn btn-secondary btn-icon" type="button" data-event-click="share_contact()">
          <svg src="../icons/share.svg" width="14" height="14" crop-to-content="true"></svg>
          {{i18n:common.share}}
        </button>
      </div>
    </div>

    <div class="contacts-threads stack" data-if="selected.threads.size > 0">
      <p class="settings-section-title">{{i18n:contacts.conversations}}</p>
      <div data-for="thread : selected.threads" class="contacts-thread-row"
           data-event-click="open_thread(thread.id)">
        <div class="contacts-row-icon" data-if="thread.kind == 'private'">
          <svg src="../icons/lock.svg" width="14" height="14" crop-to-content="true"></svg>
        </div>
        <div class="contacts-row-icon" data-if="thread.kind == 'public'">
          <svg src="../icons/message.svg" width="14" height="14" crop-to-content="true"></svg>
        </div>
        <div class="contacts-row-body">
          <p class="contacts-row-title">{{thread.title}}</p>
          <p class="contacts-row-subtitle text muted">{{thread.channel_label}}</p>
        </div>
      </div>
    </div>

    <div class="contact-detail-danger me-profile-actions row">
      <button class="btn btn-danger-soft" type="button" data-if="selected.trust_key != 'blocked'"
              data-event-click="block_contact()">{{i18n:contacts.block}}</button>
      <button class="btn btn-secondary" type="button" data-if="selected.trust_key == 'blocked'"
              data-event-click="unblock_contact()">{{i18n:contacts.unblock}}</button>
      <button class="btn btn-danger-soft btn-icon" type="button" data-event-click="remove_contact()">
        <svg src="../icons/trash.svg" width="14" height="14" crop-to-content="true"></svg>
        {{i18n:contacts.remove_button}}
      </button>
    </div>
  </div>

  <div class="contacts-actions stack">
    <p class="text muted contacts-actions-hint" data-if="selected.can_message">
      {{i18n:contacts.actions_hint}}
    </p>
    <p class="text muted contacts-actions-hint" data-if="!selected.can_message">{{selected.message_hint}}</p>
    <div class="contacts-action-buttons row" data-if="selected.can_message">
      <button class="btn btn-primary btn-icon contacts-action-secure" type="button"
              data-event-click="secure_message()">
        <svg src="../icons/lock.svg" width="14" height="14" crop-to-content="true"></svg>
        {{i18n:contacts.secure_message}}
      </button>
      <button class="btn btn-secondary btn-icon" type="button" data-event-click="start_chat()">
        <svg src="../icons/message.svg" width="14" height="14" crop-to-content="true"></svg>
        {{i18n:contacts.public_chat}}
      </button>
    </div>
  </div>
</div>
