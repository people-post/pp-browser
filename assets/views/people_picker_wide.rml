<!-- Forward to, for the desktop window (people_picker.rml's choose-and-return step as a centred card: the shell's modal
     frame, its x closes it): the title, the search, what is about to be sent (two lines), the chats (recent chats, then
     people, then groups), and one row with Cancel and Send. Same data model and events as people_picker.rml
     (PeoplePickerController::OpenForResult mounts it on a computer); no logic here. Styles: assets/themes/wide.rcss. -->
<div class="people-picker people-picker--wide stack" data-model="people_picker"
     data-class-people-picker--choose="choose_mode">
  <div class="people-picker-wide-head">
    <p class="people-picker-title">{{title}}</p>
  </div>
  <div class="people-picker-wide-search">
    <input class="field people-picker-search-field" type="text" data-value="search_query"
           data-event-change="on_search_changed()" placeholder="{{i18n:people_picker.search_placeholder}}"/>
  </div>
  <!-- Why Send is off (too many files, too big, another file is being sent, a call is on): above the strip. -->
  <p class="people-picker-refusal people-picker-wide-refusal" data-if="choose_refusal != ''">{{choose_refusal}}</p>
  <div class="people-picker-preview people-picker-wide-preview" data-if="show_preview">
    <p class="people-picker-preview-text" data-if="preview_text != ''">{{preview_text}}</p>
    <!-- Attachments: a picture's thumbnail, a video's poster, or a type icon; grey when this device has no bytes. -->
    <div class="people-picker-preview-items row" data-if="preview_items.size > 0">
      <div data-for="item : preview_items" class="people-picker-preview-item"
           data-class-people-picker-preview-item--grey="item.grey">
        <div class="people-picker-preview-tile">
          <img class="people-picker-preview-thumb" data-if="item.thumb != ''" data-attr-src="item.thumb"/>
          <div class="people-picker-preview-icon" data-if="item.thumb == ''">
            <svg data-if="item.icon == 'photo'" src="../icons/v2/photo.svg" width="24" height="24"></svg>
            <svg data-if="item.icon == 'video'" src="../icons/v2/video.svg" width="24" height="24"></svg>
            <svg data-if="item.icon == 'mic'" src="../icons/v2/mic.svg" width="24" height="24"></svg>
            <svg data-if="item.icon == 'file'" src="../icons/v2/file.svg" width="24" height="24"></svg>
            <svg data-if="item.icon == 'card'" src="../icons/v2/user.svg" width="24" height="24"></svg>
            <svg data-if="item.icon == 'text'" src="../icons/v2/compose.svg" width="24" height="24"></svg>
          </div>
        </div>
        <p class="people-picker-preview-label" data-if="item.label != ''">{{item.label}}</p>
      </div>
    </div>
    <p class="people-picker-preview-note" data-if="preview_note != ''">{{preview_note}}</p>
  </div>
  <div class="people-picker-list people-picker-wide-list">
    <div data-for="row : rows"
         class="people-picker-row"
         data-class-people-picker-row--selected="row.selected"
         data-class-people-picker-row--locked="row.locked || row.disabled"
         data-event-click="toggle_contact(row.id)">
      <div class="people-picker-check" data-if="show_checks">
        <p class="people-picker-check-mark" data-if="row.selected">✓</p>
      </div>
      <div class="people-picker-row-body">
        <p class="people-picker-row-title">{{row.title}}</p>
        <p class="people-picker-row-subtitle text muted" data-if="row.subtitle != ''">{{row.subtitle}}</p>
      </div>
      <p class="text muted people-picker-locked-label" data-if="row.locked">{{i18n:people_picker.in_chat}}</p>
    </div>
    <p class="text muted" data-if="rows.size == 0 && search_query == ''">{{empty_hint}}</p>
    <p class="text muted" data-if="rows.size == 0 && search_query != ''">{{i18n:people_picker.no_matches}}</p>
    <p class="text muted" data-if="full_hint != ''">{{full_hint}}</p>
  </div>
  <div class="people-picker-wide-foot">
    <button class="btn btn-secondary people-picker-wide-cancel" type="button"
            data-event-click="cancel_picker()">{{i18n:common.cancel}}</button>
    <button class="btn btn-primary people-picker-wide-send" type="button" data-if="show_cta"
            data-event-click="confirm_picker()" data-attrif-disabled="!cta_enabled">
      <span>{{cta_label}}</span>
    </button>
  </div>
</div>
