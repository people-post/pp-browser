<div class="shell-nav-rail-inner">
  <div class="shell-nav-pill shell-nav-pill--primary">
    <button class="shell-nav-tab" type="button"
            data-class-shell-nav-tab--active="nav_tab == 'home'"
            data-event-click="select_nav_tab('home')">
      <div class="shell-nav-tab-icon-wrap">
        <svg src="../icons/sparkle.svg" width="22" height="22" crop-to-content="true"></svg>
      </div>
      <p class="shell-nav-tab-label">{{i18n:nav.home}}</p>
    </button>
  </div>
  <div class="shell-nav-pill shell-nav-pill--secondary">
    <button class="shell-nav-tab" type="button"
            data-class-shell-nav-tab--active="nav_tab == 'sessions'"
            data-event-click="select_nav_tab('sessions')">
      <div class="shell-nav-tab-icon-wrap">
        <svg src="../icons/sessions.svg" width="22" height="22" crop-to-content="true"></svg>
        <span class="badge-count badge-count--nav"
              data-if="nav_sessions_unread > 0"
              data-rml="nav_sessions_unread_display"></span>
      </div>
      <p class="shell-nav-tab-label">{{i18n:nav.sessions}}</p>
    </button>
    <button class="shell-nav-tab" type="button"
            data-class-shell-nav-tab--active="nav_tab == 'contacts'"
            data-event-click="select_nav_tab('contacts')">
      <div class="shell-nav-tab-icon-wrap">
        <svg src="../icons/contacts.svg" width="22" height="22" crop-to-content="true"></svg>
        <span class="badge-count badge-count--nav"
              data-if="nav_contacts_unread > 0"
              data-rml="nav_contacts_unread_display"></span>
      </div>
      <p class="shell-nav-tab-label">{{i18n:nav.contacts}}</p>
    </button>
  </div>
</div>
