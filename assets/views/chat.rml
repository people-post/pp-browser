<div class="chat-panel stack" data-model="chat"
     data-class-chat-shell--ai="thread_is_ai"
     data-class-chat-shell--private="thread_is_private"
     data-class-chat-shell--public="thread_is_public"
     data-class-chat-shell--group="thread_is_group"
     data-class-chat-shell--e2e="thread_is_private">
  <div class="chat-header">
    <div class="chat-header-main">
      <div class="chat-header-type-row">
        <div class="chat-header-type-icon" data-if="thread_is_ai">
          <svg src="../icons/sparkle.svg" width="16" height="16" crop-to-content="true"></svg>
        </div>
        <div class="chat-header-type-icon" data-if="thread_is_private">
          <svg src="../icons/lock.svg" width="16" height="16" crop-to-content="true"></svg>
        </div>
        <div class="chat-header-type-icon" data-if="thread_is_public">
          <svg src="../icons/message.svg" width="16" height="16" crop-to-content="true"></svg>
        </div>
        <div class="chat-header-type-icon" data-if="thread_is_group">
          <svg src="../icons/group.svg" width="16" height="16" crop-to-content="true"></svg>
        </div>
        <span class="text-xs chat-type-badge" data-if="thread_is_ai">Assistant</span>
        <span class="text-xs chat-type-badge" data-if="thread_is_private">Private</span>
        <span class="text-xs chat-type-badge" data-if="thread_is_public">Chat</span>
        <span class="text-xs chat-type-badge" data-if="thread_is_group">Group</span>
      </div>
      <button class="heading-1 chat-header-title chat-header-title-btn" type="button"
              data-if="show_peer_sheet" data-rml="thread_title"
              data-event-click="open_peer_sheet()"></button>
      <h1 class="heading-1 chat-header-title" data-if="!show_peer_sheet" data-rml="thread_title"></h1>
      <p class="text muted" data-rml="thread_subtitle"></p>
      <p class="text-xs chat-peer-link" data-if="show_peer_link" data-rml="peer_link_status"></p>
    </div>
    <div class="chat-header-actions row">
      <button class="btn btn-secondary btn-icon chat-header-call-btn" type="button" data-if="show_call_actions"
              data-event-click="start_voice_call()">
        <svg src="../icons/phone.svg" width="18" height="18" crop-to-content="true"></svg>
        <span class="chat-header-call-label">Voice</span>
      </button>
      <button class="btn btn-secondary btn-icon chat-header-call-btn" type="button" data-if="show_call_actions"
              data-event-click="start_video_call()">
        <svg src="../icons/video.svg" width="18" height="18" crop-to-content="true"></svg>
        <span class="chat-header-call-label">Video</span>
      </button>
      <button class="chat-header-more-btn" type="button" data-if="show_thread_menu"
              data-event-click="open_thread_actions_menu()">
        <svg src="../icons/more.svg"></svg>
      </button>
      <button class="shell-toolbar-btn shell-toolbar-btn-preview chat-preview-btn" data-model="window"
              data-if="auxiliary_available && (layout_mode == 'expanded' || compact_chat_open)"
              data-event-click="toggle_auxiliary()">Details</button>
    </div>
  </div>
  <div class="chat-gap-banner stack" data-if="show_peer_link_banner && !sync_in_progress">
    <p class="text muted" data-rml="peer_link_banner"></p>
    <button class="chat-suggestion" data-if="show_retry_peer_dial" data-event-click="retry_peer_dial()">Retry connection</button>
  </div>
  <div class="chat-gap-banner stack" data-if="show_gap_banner && !sync_in_progress">
    <p class="text muted">Some messages from your peer may be missing. Peer sync does not resend your unsent messages.</p>
    <button class="chat-suggestion" data-event-click="retry_gap_sync()">Retry sync</button>
  </div>
  <div class="chat-gap-banner stack" data-if="show_compromised_banner && !sync_in_progress">
    <p class="text muted">Message integrity issue detected. Sending and sync are paused. Rotate the encryption key and share the bundle with your contact, or pause only.</p>
    <button class="chat-suggestion" data-event-click="rotate_psk_export()">Rotate key &amp; export bundle</button>
    <button class="chat-suggestion" data-event-click="start_new_secure_chat()">New epoch (same key)</button>
    <button class="chat-suggestion" data-event-click="pause_integrity_only()">Pause only</button>
  </div>
  <div class="chat-gap-banner stack" data-if="show_psk_setup_banner && !sync_in_progress">
    <p class="text muted" data-if="!psk_has_key">Share your encryption key with this contact out of band, then verify the fingerprint before sending.</p>
    <p class="text muted" data-if="psk_has_key && !psk_verified">Compare this fingerprint with your contact, then confirm verification before sending.</p>
    <p class="text muted" data-if="psk_fingerprint != ''">Fingerprint: <span data-rml="psk_fingerprint"></span></p>
    <p class="text muted" data-if="psk_export_b64 != ''">Key: <span data-rml="psk_export_b64"></span></p>
    <button class="chat-suggestion" data-if="psk_has_key" data-event-click="copy_psk_key()">Copy key</button>
    <button class="chat-suggestion" data-if="psk_has_key && !psk_verified" data-event-click="verify_psk()">I've verified this fingerprint</button>
    <button class="chat-suggestion" data-event-click="toggle_psk_import()">Import key or bundle</button>
    <textarea class="prompt-composer-input" data-if="show_psk_import" rows="4" data-value="psk_import_text"
              placeholder="Paste raw base64 key or pp-browser-psk-bundle-v1 JSON"></textarea>
    <button class="chat-suggestion" data-if="show_psk_import" data-event-click="import_psk()">Install imported key</button>
  </div>
  <div class="chat-gap-banner stack" data-if="show_older_history_hint && !sync_in_progress">
    <p class="text muted">Older messages may be available from your peer.</p>
    <button class="chat-suggestion" data-event-click="load_older_history()">Load older messages</button>
  </div>
  <div class="chat-messages-wrap">
  <div id="chat-messages" class="messages" data-mount-id="messages"
       data-event-scroll="messages_scroll()">
    <div class="chat-empty stack" data-if="!has_turns && !loading">
      <p class="text muted">{{i18n:chat.empty_body}}</p>
    </div>
    <div data-if="use_messages_layout">
      <div data-for="row : messages" data-class="row.row_class">
        <p class="sender-label muted" data-if="row.sender_label != ''" data-rml="row.sender_label"></p>
        <p class="text-xs muted chat-transport-line" data-if="row.transport_badge != ''">
          <span data-rml="row.transport_badge"></span>
        </p>
        <div selectable="text" data-model="chat" data-rml="row.content_rml"></div>
      </div>
    </div>
    <div data-if="!use_messages_layout">
      <div data-for="turn : turns" class="message-group">
        <div class="message-row message-row-user" data-rml="turn.user_content_rml"></div>
        <div class="message-row message-row-assistant" data-if="turn.has_assistant">
          <div class="assistant-message">
            <div class="bubble bubble-assistant" selectable="text" data-rml="turn.assistant_content_rml"></div>
          </div>
        </div>
      </div>
    </div>
    <p class="text muted thinking" data-if="loading && status == ''">Thinking...</p>
    <p class="text muted thinking" data-if="loading && status != ''" data-rml="status"></p>
  </div>
  <button class="chat-jump-latest" type="button" data-if="show_jump_to_latest"
          data-event-click="jump_to_latest()" data-rml="jump_to_latest_label"></button>
  </div>
</div>
