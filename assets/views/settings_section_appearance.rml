      <div class="settings-section settings-section--grouped stack">
        <div class="group-card">
          <button class="settings-toggle-row settings-choice-row row group-row" type="button"
                  data-event-click="on_choose_theme()">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.theme.label}}</span>
              <span class="settings-choice-value row">
                <span class="settings-choice-value-text">{{appearance_label}}</span>
                <svg class="settings-row-chevron" src="../icons/chevron-right.svg" width="12" height="12"></svg>
              </span>
            </span>
          </button>
        </div>
        <p class="text muted settings-help group-foot">{{i18n:settings.theme.help}}</p>
        <div class="group-card">
          <button class="settings-toggle-row settings-choice-row row group-row" type="button"
                  data-event-click="on_choose_language()">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.language.label}}</span>
              <span class="settings-choice-value row">
                <span class="settings-choice-value-text">{{language_label}}</span>
                <svg class="settings-row-chevron" src="../icons/chevron-right.svg" width="12" height="12"></svg>
              </span>
            </span>
          </button>
        </div>
        <p class="text muted settings-help group-foot">{{i18n:settings.language.help}}</p>
        <!-- Phones: the Edit Home sheet Home's "Edit" opens (the desktop's Home has no widgets). -->
        <div class="group-card settings-phone-only">
          <button class="settings-toggle-row settings-choice-row row group-row" type="button"
                  data-event-click="open_home_edit()">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.home_widgets.label}}</span>
              <span class="settings-choice-value row">
                <svg class="settings-row-chevron" src="../icons/chevron-right.svg" width="12" height="12"></svg>
              </span>
            </span>
          </button>
        </div>
        <!-- Show Activity on Home (Kenneth 2026-11-05): phones only. Off (default) is the minimal AI-first Home; on
             brings back the 动态 widgets section (calls, mentions, new people…). -->
        <div class="group-card settings-phone-only">
          <div class="settings-toggle-row row group-row">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.home_dynamic.label}}</span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="home_show_dynamic == 'on'"
                      data-event-click="toggle_home_show_dynamic()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
        </div>
        <p class="text muted settings-help group-foot settings-phone-only">{{i18n:settings.home_dynamic.help}}</p>
        <!-- Animated home logo (Kenneth 2026-11-09): phones only. On (default) the AI Home's logo is the mascot in the
             look of Me → AI assistant, and a tap makes it move; off keeps the static app icon. -->
        <div class="group-card settings-phone-only">
          <div class="settings-toggle-row row group-row">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.home_logo.label}}</span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="home_animated_logo == 'on'"
                      data-event-click="toggle_home_animated_logo()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
        </div>
        <p class="text muted settings-help group-foot settings-phone-only">{{i18n:settings.home_logo.help}}</p>
        <!-- Transparency (Kenneth 2026-11-04): on, the phone's bars are frosted and the page shows through them; off,
             they are solid (the reduce_transparency pref, which the AI assistant's set_reduce_transparency also sets). -->
        <div class="group-card">
          <div class="settings-toggle-row row group-row">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.transparency.label}}</span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="reduce_transparency != 'on'"
                      data-event-click="toggle_transparency()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
        </div>
        <p class="text muted settings-help group-foot">{{i18n:settings.transparency.help}}</p>
        <div class="group-card">
          <div class="settings-toggle-row row group-row">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.call_diagnostics.label}}</span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="call_diagnostics == 'on'"
                      data-event-click="toggle_call_diagnostics()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
        </div>
        <p class="text muted settings-help group-foot">{{i18n:settings.call_diagnostics.help}}</p>
        <div class="settings-actions stack">
          <button class="btn btn-secondary settings-action-bar" type="button"
                  data-event-click="reset_section('appearance')">{{i18n:common.reset_defaults}}</button>
        </div>
      </div>
