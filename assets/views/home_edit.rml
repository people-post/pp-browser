<!-- Edit Home (DESIGN-pp-ui 8.16, mockup 10-home-widgets B), like iPhone "edit widgets": the widgets on Home, each
     with a red minus that removes it and its size, and the ones that can be added, each with a green plus. The
     choices are kept on this device only (profile preferences); a removed widget is not drawn, computed or fetched. -->
<div class="ac-page" data-model="shell">
  <div class="sheet-header">
    <p class="sheet-title">{{i18n:home_edit.title}}</p>
  </div>
  <div class="ac-scroll">
    <p class="text group-head" data-if="home_edit_on.size > 0">{{i18n:home_edit.on_home}}</p>
    <div class="group-card home-edit-card" data-if="home_edit_on.size > 0">
      <div class="group-row home-edit-row" data-for="row : home_edit_on">
        <button class="home-edit-toggle" type="button" data-event-click="home_widget_remove(row.id)">
          <span class="home-edit-sign home-edit-sign--remove"><svg src="../icons/v2/minus.svg" width="14" height="14"></svg></span>
        </button>
        <span class="group-row-body">
          <span class="group-row-text">{{row.name}}</span>
          <span class="home-edit-size">{{row.size}}</span>
        </span>
      </div>
    </div>
    <p class="text group-head" data-if="home_edit_off.size > 0">{{i18n:home_edit.can_add}}</p>
    <div class="group-card home-edit-card" data-if="home_edit_off.size > 0">
      <div class="group-row home-edit-row" data-for="row : home_edit_off">
        <button class="home-edit-toggle" type="button" data-event-click="home_widget_add(row.id)">
          <span class="home-edit-sign home-edit-sign--add"><svg src="../icons/v2/plus.svg" width="14" height="14"></svg></span>
        </button>
        <span class="group-row-body">
          <span class="group-row-text">{{row.name}}</span>
          <span class="home-edit-size">{{row.size}}</span>
        </span>
      </div>
    </div>
    <p class="text muted group-foot">{{i18n:home_edit.footer}}</p>
  </div>
</div>
