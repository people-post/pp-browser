      <div class="settings-section settings-section--grouped stack">
        <div class="group-card group-card--pad">
        <div class="me-profile-avatar-row row">
          <div class="me-profile-avatar-wrap">
          <div class="me-profile-avatar-frame" data-event-click="tap_profile_avatar()"
               data-class-me-profile-avatar-frame--disabled="profile_icon_uploading"
               data-class-avatar-tone-0="!profile_has_icon && profile_avatar_tone == 0"
               data-class-avatar-tone-1="!profile_has_icon && profile_avatar_tone == 1"
               data-class-avatar-tone-2="!profile_has_icon && profile_avatar_tone == 2"
               data-class-avatar-tone-3="!profile_has_icon && profile_avatar_tone == 3"
               data-class-avatar-tone-4="!profile_has_icon && profile_avatar_tone == 4"
               data-class-avatar-tone-5="!profile_has_icon && profile_avatar_tone == 5"
               data-class-avatar-tone-6="!profile_has_icon && profile_avatar_tone == 6"
               data-class-avatar-tone-7="!profile_has_icon && profile_avatar_tone == 7">
            <img class="me-profile-avatar-image" data-if="profile_has_icon" data-attr-src="profile_icon_src"/>
            <p class="avatar-letter" data-if="!profile_has_icon">{{profile_avatar_letter}}</p>
          </div>
          <div class="me-profile-avatar-uploading" data-if="profile_icon_uploading">
            <p class="me-profile-avatar-uploading-text">{{i18n:settings.profile.photo_uploading}}</p>
          </div>
          <!-- The camera badge opens the source menu (camera, library, remove); the only visible way to change the photo. -->
          <button class="me-profile-avatar-badge" type="button" data-event-click="pick_profile_icon()"
                  data-attrif-disabled="profile_icon_uploading">
            <svg src="../icons/v2/camera.svg" width="16" height="16"></svg>
          </button>
          </div>
        </div>
        </div>
        <div class="group-card">
          <label class="settings-field group-row group-row--field">
            <span class="group-row-body group-row-body--field">
              <span class="settings-label group-row-text">{{i18n:settings.nickname}}</span>
              <input class="field" type="text" data-value="profile_nickname" lang=""
                     data-event-blur="on_profile_nickname_commit()"
                     placeholder="{{i18n:settings.profile.nickname_placeholder}}"/>
              <span class="group-field-hint" data-if="profile_nickname == ''">{{i18n:settings.profile.nickname_placeholder}}</span>
            </span>
          </label>
        </div>
        <div class="group-card settings-phone-only">
          <div class="group-row group-id-row">
            <span class="group-row-body">
              <span class="group-id-text" data-if="profile_relay_id != ''">
                <span class="group-id-label">{{i18n:settings.profile.relay_id_label}}</span>
                <span class="group-id-value">{{profile_relay_id}}</span>
              </span>
              <span class="group-id-text" data-if="profile_relay_id == ''">
                <span class="group-id-value">{{i18n:settings.profile.relay_id_none}}</span>
              </span>
              <button class="group-id-btn" type="button" data-event-click="copy_profile_id()">
                <svg class="cd-icon" src="../icons/v2/copy.svg" width="22" height="22"></svg>
              </button>
              <button class="group-id-btn" type="button" data-event-click="share_profile()">
                <svg class="cd-icon" src="../icons/v2/share.svg" width="22" height="22"></svg>
              </button>
              <button class="group-id-btn" type="button" data-if="profile_qr_svg_rml != ''"
                      data-event-click="toggle_profile_qr()">
                <svg class="cd-icon" src="../icons/v2/qr-code.svg" width="22" height="22"></svg>
              </button>
            </span>
          </div>
        </div>
        <div class="group-card group-card--pad">
        <p class="text muted me-profile-meta group-note" data-if="advanced && profile_peer_id != ''">
          {{i18n:settings.profile.peer_id_label}} <span>{{profile_peer_id}}</span>
        </p>
        <p class="text muted me-profile-meta group-note settings-desktop-only" data-if="profile_relay_id != ''">
          {{i18n:settings.profile.relay_id_label}} <span>{{profile_relay_id}}</span>
        </p>
        <p class="text muted me-profile-meta group-note settings-desktop-only" data-if="profile_relay_id == ''">
          {{i18n:settings.profile.relay_id_none}}
        </p>
        <p class="text muted me-profile-meta group-note">
          {{i18n:settings.registration.label}} <span>{{profile_registration_status}}</span>
        </p>
        <p class="text muted me-profile-meta group-note" data-if="advanced && profile_registration_expires != ''">
          {{i18n:settings.registration.expires}} <span>{{profile_registration_expires}}</span>
        </p>
        </div>
        <div class="group-card" data-if="advanced">
          <div class="settings-toggle-row row group-row">
            <span class="group-row-body">
              <span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.auto_renew}}</span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="auto_renew_registration == 'auto'"
                      data-event-click="toggle_auto_renew_registration()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
        </div>
        <div class="me-profile-actions row">
          <button class="btn btn-secondary btn-icon settings-desktop-only" type="button" data-event-click="copy_profile_id()">
            <svg src="../icons/copy.svg" width="14" height="14" crop-to-content="true"></svg>
            {{i18n:contacts.copy_id}}
          </button>
          <button class="btn btn-secondary btn-icon settings-desktop-only" type="button" data-event-click="share_profile()">
            <svg src="../icons/share.svg" width="14" height="14" crop-to-content="true"></svg>
            {{i18n:common.share}}
          </button>
          <button class="btn btn-secondary settings-desktop-only" type="button" data-if="profile_qr_svg_rml != ''"
                  data-class-btn-active="profile_show_qr"
                  data-event-click="toggle_profile_qr()">{{i18n:settings.profile.show_qr}}</button>
          <button class="btn btn-primary" type="button" data-if="profile_show_register"
                  data-event-click="register_profile()"><span>{{profile_register_label}}</span></button>
          <button class="btn btn-secondary" type="button" data-if="advanced && profile_show_rotate"
                  data-event-click="rotate_brief_llm_key()">{{i18n:settings.llm.rotate_brief_key}}</button>
        </div>
        <div class="me-invite-qr" data-if="profile_show_qr && profile_qr_svg_rml != ''">
          <svg class="me-invite-qr-code" viewBox="0 0 100 100" width="200" height="200"
               data-rml="profile_qr_svg_rml"></svg>
          <p class="text muted settings-help group-foot">{{i18n:settings.profile.qr_help}}</p>
        </div>
      </div>
