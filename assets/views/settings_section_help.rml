      <div class="settings-section settings-section--grouped stack">
        <div class="group-card" data-if="support_visible">
          <button class="group-row" type="button" data-event-click="open_support_chat()">
            <span class="group-row-body">
              <span class="group-row-label">
                <span class="group-row-text">{{support_display_name}}</span>
                <span class="group-row-sub">{{support_subtitle}}</span>
              </span>
              <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
            </span>
          </button>
        </div>
        <!-- Phones: the crash-report switch in a card of its own. "Send diagnostics" is gone: run logs are sent from
             Settings > Advanced (DEV/PLAN-send-run-logs.md). -->
        <p class="text group-head settings-phone-only">{{i18n:settings.about.improve.title}}</p>
        <div class="group-card settings-phone-only">
          <div class="settings-toggle-row row group-row">
            <span class="group-row-body">
              <span class="group-row-label">
                <span class="settings-q-label"><span class="group-row-text">{{i18n:settings.security.crash_reports.label}}</span><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.security.crash_reports.label')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
                <span class="group-row-sub">{{i18n:settings.security.crash_reports.help}}</span>
              </span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="crash_reports_enabled == 'on'"
                      data-event-click="toggle_crash_reports()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
        </div>
        <p class="text group-head settings-desktop-only">{{i18n:settings.security.group.diagnostics}}</p>
        <div class="group-card settings-desktop-only">
          <div class="settings-toggle-row row group-row">
            <span class="group-row-body">
              <span class="settings-q-label"><span class="settings-label settings-toggle-label group-row-text">{{i18n:settings.security.crash_reports.label}}</span><button class="settings-q-btn" type="button" data-event-click="ask_setting_help('settings.security.crash_reports.label')"><svg class="settings-q-icon" src="../icons/v2/help-circle.svg" width="20" height="20"></svg></button></span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="crash_reports_enabled == 'on'"
                      data-event-click="toggle_crash_reports()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
        </div>
        <p class="text muted settings-help group-foot settings-desktop-only">{{i18n:settings.security.crash_reports.help}}</p>
        <div class="group-card">
          <div class="settings-toggle-row row group-row">
            <span class="group-row-body">
              <span class="group-row-label">
                <span class="group-row-text">{{i18n:settings.help.show_advanced}}</span>
                <span class="group-row-sub">{{i18n:settings.help.show_advanced.hint}}</span>
              </span>
              <button class="settings-switch" type="button"
                      data-class-settings-switch--on="show_advanced_settings == 'on'"
                      data-event-click="toggle_advanced_settings()">
                <div class="settings-switch-knob"></div>
              </button>
            </span>
          </div>
        </div>
        <div class="group-card">
          <button class="group-row" type="button" data-event-click="open_terms()">
            <span class="group-row-body">
              <span class="group-row-label"><span class="group-row-text">{{i18n:settings.help.terms}}</span></span>
              <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
            </span>
          </button>
          <button class="group-row" type="button" data-event-click="open_privacy_policy()">
            <span class="group-row-body">
              <span class="group-row-label"><span class="group-row-text">{{i18n:settings.help.privacy_policy}}</span></span>
              <svg class="group-chevron" src="../icons/v2/chevron-right.svg" width="16" height="16"></svg>
            </span>
          </button>
        </div>
        <div class="group-card settings-phone-only">
          <div class="group-row" data-event-click="tap_version()">
            <span class="group-row-body">
              <span class="group-row-text">{{i18n:settings.about.version}}</span>
              <span class="group-row-value">{{app_version}}</span>
            </span>
          </div>
        </div>
        <p class="text muted group-foot settings-desktop-only" data-event-click="tap_version()">{{i18n:settings.about.version}}: <span>{{app_version}}</span></p>
      </div>
