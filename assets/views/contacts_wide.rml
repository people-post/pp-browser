<!-- The Contacts list column of the wide layout (desktop, wide iPad). The phone's contacts page (contacts.rml): the same
     rows (avatar, name, star), the same A-Z sections and index, the same search, the same plus menu. From the phone's
     New chat page it takes the two entries (New group, Add contact) and, from the Chats bar, the scan button. The
     phone's bar (round back, title) and its large title are the list header here. What a left swipe does on a phone
     contact row (Info, Voice, Video, More) is the row's hover buttons and its right-click menu here (Info is the
     click itself). -->
<div class="contacts-panel contacts-panel--wide" data-model="contacts">
  <div class="sidebar-header contacts-wide-header row">
    <p class="sidebar-header-title">{{i18n:nav.contacts}}</p>
    <div class="sidebar-header-actions row">
      <div class="contacts-wide-scan-wrap" data-model="window">
        <button class="contacts-wide-scan" type="button" data-event-click="open_scan_qr()">
          <svg src="../icons/v2/scan.svg" width="20" height="20"></svg>
        </button>
      </div>
      <button class="sidebar-new-chat" type="button" data-event-click="on_add_contact_menu()">
        <svg src="../icons/plus.svg" width="14" height="14" crop-to-content="true"></svg>
      </button>
    </div>
  </div>
  <div class="chat-search contacts-wide-search">
    <svg class="chat-search-icon" src="../icons/v2/search.svg" width="16" height="16"></svg>
    <input class="chat-search-input" type="text" data-value="search_query"
           data-event-change="on_search_changed()"/>
    <p class="chat-search-label" data-if="search_query == ''">{{i18n:contacts.search_placeholder}}</p>
  </div>
  <div class="contacts-list-view contacts-wide-scroll root-scroll">
    <div class="nc-actions" data-if="search_query == ''">
      <div class="nc-action" data-event-click="new_chat_action('group')">
        <div class="nc-action-icon nc-action-icon--group">
          <svg src="../icons/v2/group.svg" width="20" height="20"></svg>
        </div>
        <p class="nc-action-label">{{i18n:new_chat.group}}</p>
      </div>
      <div class="nc-action" data-event-click="new_chat_action('add')">
        <div class="nc-action-icon nc-action-icon--add">
          <svg src="../icons/v2/user-plus.svg" width="20" height="20"></svg>
        </div>
        <p class="nc-action-label">{{i18n:new_chat.add}}</p>
      </div>
    </div>
    <div class="contacts-list">
      <div data-for="section : contact_sections" class="contacts-section">
        <p class="nc-section-header contacts-section-header">{{section.letter}}</p>
        <div data-for="contact : section.rows"
             class="contacts-row"
             data-attr-contact-id="contact.id"
             data-class-contacts-row--active="contact.id == selected.id && selected.id != ''"
             data-event-click="select_contact(contact.id)">
          <div class="contacts-row-avatar-frame"
               data-class-avatar-tone-0="!contact.has_icon && contact.avatar_tone == 0"
               data-class-avatar-tone-1="!contact.has_icon && contact.avatar_tone == 1"
               data-class-avatar-tone-2="!contact.has_icon && contact.avatar_tone == 2"
               data-class-avatar-tone-3="!contact.has_icon && contact.avatar_tone == 3"
               data-class-avatar-tone-4="!contact.has_icon && contact.avatar_tone == 4"
               data-class-avatar-tone-5="!contact.has_icon && contact.avatar_tone == 5"
               data-class-avatar-tone-6="!contact.has_icon && contact.avatar_tone == 6"
               data-class-avatar-tone-7="!contact.has_icon && contact.avatar_tone == 7">
            <img class="contacts-row-avatar-image" data-if="contact.has_icon" data-attr-src="contact.icon_src"/>
            <p class="avatar-letter" data-if="!contact.has_icon">{{contact.avatar_letter}}</p>
          </div>
          <div class="contacts-row-body">
            <div class="contacts-row-title-line row">
              <p class="contacts-row-title" data-class-contacts-row-title--starred="contact.starred">{{contact.title}}</p>
              <svg class="contacts-row-star" src="../icons/v2/star-fill.svg" width="14" height="14"
                   data-if="contact.starred"></svg>
            </div>
          </div>
          <div class="contacts-row-actions">
            <button class="contacts-row-action" type="button" data-event-click="contact_row_action('voice', contact.id)">
              <svg src="../icons/v2/phone.svg" width="20" height="20"></svg>
            </button>
            <button class="contacts-row-action" type="button" data-event-click="contact_row_action('video', contact.id)">
              <svg src="../icons/v2/video.svg" width="20" height="20"></svg>
            </button>
            <button class="contacts-row-action" type="button" data-event-click="contact_row_action('more', contact.id)">
              <svg src="../icons/v2/more.svg" width="20" height="20"></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="sync-pending" data-if="contacts.size == 0 && search_query == '' && (account_sync_syncing || account_sync_delayed)">
        <div class="sync-pending-spinner" data-if="account_sync_syncing"></div>
        <p class="text muted" data-if="account_sync_syncing">{{i18n:account_sync.pending}}</p>
        <p class="text muted" data-if="!account_sync_syncing && account_sync_delayed">{{i18n:account_sync.delayed}}</p>
      </div>
      <div class="contacts-empty stack" data-if="contacts.size == 0 && search_query == '' && !account_sync_syncing && !account_sync_delayed">
        <p class="text muted">{{i18n:contacts.empty_hint}}</p>
        <button class="chat-suggestion btn-icon" type="button" data-event-click="find_someone()">
          <svg src="../icons/sparkle.svg" width="14" height="14" crop-to-content="true"></svg>
          {{i18n:contacts.find_someone}}
        </button>
      </div>
      <p class="text muted" data-if="contacts.size == 0 && search_query != ''">{{i18n:people_picker.no_matches}}</p>
    </div>
  </div>
  <div class="contacts-index" data-if="contacts.size > 0 && search_query == ''"
       data-event-mousedown="contacts_index_at()" data-event-drag="contacts_index_at()"
       data-event-mouseup="contacts_index_end()" data-event-dragend="contacts_index_end()">
    <p data-for="item : contact_index" class="contacts-index-letter"
       data-class-contacts-index-letter--present="item.present">{{item.letter}}</p>
  </div>
  <div class="contacts-index-bubble" data-if="contact_index_bubble != ''">
    <p class="contacts-index-bubble-letter">{{contact_index_bubble}}</p>
  </div>
</div>
