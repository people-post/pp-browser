<!-- `settings-detail--profile`: the wide stylesheet shows My profile as the phone does (its phone-only rows), where the
     desktop's own blocks differ (wide.rcss). -->
<div class="settings-detail-panel stack" data-model="settings"
     data-class-settings-detail--profile="selected_id == 'profile'">
  <div class="settings-detail-header row">
    <p class="settings-header-title">{{selected_title}}</p>
  </div>

  <div class="settings-detail-body stack">
    <div id="settings-section-mount-pane"></div>
    <p class="text muted" data-if="status != ''">{{status}}</p>
  </div>
</div>
