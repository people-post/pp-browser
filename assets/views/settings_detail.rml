<div class="settings-detail-panel stack" data-model="settings">
  <div class="settings-detail-header row">
    <p class="settings-header-title" data-rml="selected_title"></p>
  </div>

  <div class="settings-detail-body stack">
    <div class="settings-section stack" data-if="selected_id == 'llm'">
      <label class="settings-field">
        <span class="settings-label">Preset</span>
        <select class="field" data-value="llm_preset" data-event-change="on_llm_preset_changed()">
          <option value="cloud">Cloud (OpenAI-compatible)</option>
          <option value="ollama">Ollama (localhost)</option>
          <option value="custom">Custom</option>
        </select>
      </label>
      <p class="text muted">Preset defaults apply when saved. Leave API key blank to keep the existing key.</p>
      <label class="settings-field">
        <span class="settings-label">Base URL</span>
        <input class="field" type="text" data-value="llm_base_url" data-event-change="on_llm_field_changed()"/>
      </label>
      <label class="settings-field">
        <span class="settings-label">Model</span>
        <input class="field" type="text" data-value="llm_model" data-event-change="on_llm_field_changed()"/>
      </label>
      <label class="settings-field">
        <span class="settings-label">API key</span>
        <input class="field" type="password" data-value="llm_api_key" data-event-change="on_llm_field_changed()" placeholder="Optional for local / Ollama endpoints"/>
      </label>
      <label class="settings-field">
        <span class="settings-label">API key env var (advanced)</span>
        <input class="field" type="text" data-value="llm_api_key_env" data-event-change="on_llm_field_changed()" placeholder="Optional (e.g. OPENAI_API_KEY)"/>
      </label>
      <div class="settings-actions row">
        <button class="btn btn-secondary" type="button" data-event-click="reset_section('llm')">Reset to defaults</button>
      </div>
    </div>

    <div class="settings-section stack" data-if="selected_id == 'integrations'">
      <label class="settings-field">
        <span class="settings-label">Promoted MCP URL</span>
        <input class="field" type="text" data-value="promoted_mcp_url" data-event-change="on_integrations_field_changed()" placeholder="Blank uses platform default"/>
      </label>
      <label class="settings-field">
        <span class="settings-label">Search provider</span>
        <input class="field" type="text" data-value="search_provider" data-event-change="on_integrations_field_changed()"/>
      </label>
      <p class="text muted">Custom MCP servers (stdio on desktop; URL on mobile).</p>
      <div data-for="server, server_index : mcp_servers" class="settings-subsection stack">
        <label class="settings-field">
          <span class="settings-label">ID</span>
          <input class="field" type="text" data-value="server.id" data-event-change="on_integrations_field_changed()"/>
        </label>
        <label class="settings-field">
          <span class="settings-label">URL</span>
          <input class="field" type="text" data-value="server.url" data-event-change="on_integrations_field_changed()"/>
        </label>
        <label class="settings-field">
          <span class="settings-label">Command</span>
          <input class="field" type="text" data-value="server.command" data-event-change="on_integrations_field_changed()"/>
        </label>
        <label class="settings-field">
          <span class="settings-label">Args</span>
          <input class="field" type="text" data-value="server.args_text" data-event-change="on_integrations_field_changed()" placeholder="space-separated"/>
        </label>
        <div class="settings-actions row">
          <button class="btn btn-secondary" type="button" data-event-click="remove_mcp_server(server_index)">Remove</button>
        </div>
      </div>
      <div class="settings-actions row">
        <button class="btn btn-secondary" type="button" data-event-click="add_mcp_server()">Add MCP server</button>
        <button class="btn btn-secondary" type="button" data-event-click="reset_section('integrations')">Reset to defaults</button>
      </div>
    </div>

    <div class="settings-section stack" data-if="selected_id == 'network'">
      <p class="text muted">Leave blank to use promoted MCP infra tools; mocks apply when promoted MCP is unavailable.</p>
      <label class="settings-field">
        <span class="settings-label">Relay base URL</span>
        <input class="field" type="text" data-value="relay_base_url" data-event-change="on_network_field_changed()"/>
      </label>
      <label class="settings-field">
        <span class="settings-label">Directory base URL</span>
        <input class="field" type="text" data-value="directory_base_url" data-event-change="on_network_field_changed()"/>
      </label>
      <label class="settings-field">
        <span class="settings-label">Registration base URL</span>
        <input class="field" type="text" data-value="registration_base_url" data-event-change="on_network_field_changed()"/>
      </label>
      <div class="settings-actions row">
        <button class="btn btn-secondary" type="button" data-event-click="reset_section('network')">Reset to defaults</button>
      </div>
    </div>

    <div class="settings-section stack" data-if="selected_id == 'appearance'">
      <label class="settings-field">
        <span class="settings-label">Theme</span>
        <select class="field" data-value="appearance" data-event-change="on_appearance_changed()">
          <option value="system">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>
      <p class="text muted">Follows your OS light/dark setting when set to System.</p>
      <div class="settings-actions row">
        <button class="btn btn-secondary" type="button" data-event-click="reset_section('appearance')">Reset to defaults</button>
      </div>
    </div>

    <div class="settings-section stack" data-if="selected_id == 'security'">
      <p class="text muted">Protection: <span data-rml="pin_protection_status"></span></p>
      <p class="text muted" data-if="pin_protection_status == 'App default'">
        Your keys use the app default. Change it below for stronger protection.
      </p>
      <p class="text muted" data-if="pin_protection_status == 'Not set up'">
        Key protection is created when you first use secure messaging or register on the network.
      </p>
      <div data-if="security_can_change_pin" class="stack">
        <label class="settings-field">
          <span class="settings-label">Current PIN</span>
          <input class="field" type="password" data-value="pin_change_old" placeholder="Current PIN"/>
        </label>
        <label class="settings-field">
          <span class="settings-label">New PIN</span>
          <input class="field" type="password" data-value="pin_change_new" placeholder="At least 4 characters"/>
        </label>
        <label class="settings-field">
          <span class="settings-label">Confirm new PIN</span>
          <input class="field" type="password" data-value="pin_change_confirm" placeholder="Confirm new PIN"/>
        </label>
        <div class="settings-actions row">
          <button class="btn btn-primary" type="button" data-event-click="change_pin()">Change PIN</button>
        </div>
      </div>
      <p class="text muted" data-if="!security_can_change_pin && pin_protection_status != 'Not set up'">
        Unlock your profile to change the PIN.
      </p>
    </div>

    <div class="settings-section stack" data-if="selected_id == 'storage'">
      <p class="text muted">Profile: <span data-rml="profile_label"></span></p>
      <p class="text" data-rml="profile_size_label"></p>
      <p class="text muted settings-path">Config: <span data-rml="config_dir"></span></p>
      <p class="text muted settings-path">Data: <span data-rml="data_dir"></span></p>
      <p class="text muted settings-path">Profile data: <span data-rml="profile_dir"></span></p>
      <div class="settings-danger-zone stack">
        <p class="text muted">
          Reset deletes chats, contacts, keys, and PIN for this profile. Machine settings are kept.
        </p>
        <div class="settings-actions row">
          <button class="btn btn-danger" type="button" data-event-click="reset_profile()">
            Reset this profile
          </button>
        </div>
      </div>
    </div>

    <p class="text muted" data-if="status != ''" data-rml="status"></p>
  </div>
</div>
