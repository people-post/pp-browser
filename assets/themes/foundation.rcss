body {
  font-family: LatoLatin;
  font-size: 16dp;
  padding: 24dp;
}

.text {
  display: block;
  margin-top: 0;
  margin-bottom: 8dp;
}

.heading-1 {
  display: block;
  font-size: 28dp;
  margin-top: 0;
  margin-bottom: 12dp;
}

.heading-2 {
  display: block;
  font-size: 20dp;
  margin-top: 0;
  margin-bottom: 8dp;
}

.heading-3 {
  display: block;
  font-size: 16dp;
  margin-top: 0;
  margin-bottom: 8dp;
}

.stack {
  display: block;
}

.row {
  display: flex;
  flex-direction: row;
  gap: 8dp;
}

.gap-sm {
  margin-bottom: 8dp;
}

.error {
  display: block;
  margin-top: 0;
  margin-bottom: 8dp;
}

/* Typography utilities */
.text-xs {
  display: block;
  font-size: 12dp;
  margin-top: 0;
  margin-bottom: 4dp;
}
