.btn {
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  border: 0;
  cursor: pointer;
  margin-bottom: 0;
  width: auto;
  display: inline-block;
}

.field {
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  width: 100%;
  margin-bottom: 8dp;
  box-sizing: border-box;
  display: block;
}

/* RmlUi <select> internals: selectvalue, selectarrow, selectbox (see WidgetDropDown). */
select:focus {
  position: relative;
  z-index: 10;
}

select selectbox {
  border-radius: 6dp;
  padding: 4dp 0;
  box-sizing: border-box;
}

select selectbox option {
  padding: 8dp 12dp;
}

.card {
  padding: 16dp;
  border-radius: 8dp;
  margin-bottom: 12dp;
}

/* Floating Chrome — compact shell materials; theme colors in colors-*.rcss.
   Default: opaque elevated surfaces. At most one bar uses backdrop frost per frame
   (see ShellInterruption::ResolveFrostSurface). */
.surface-chrome {
  backdrop-filter: none;
}

.surface-chrome--frost {
  backdrop-filter: blur(12px);
}

.shell-bottom-chrome--frost .shell-nav-rail--compact .shell-nav-pill {
  backdrop-filter: blur(12px);
}

.shell-bottom-chrome--solid .shell-nav-rail--compact .shell-nav-pill {
  backdrop-filter: none;
}

.surface-chrome--solid,
.shell-bottom-chrome--frost.surface-chrome--solid .shell-nav-rail--compact .shell-nav-pill,
.surface-chrome--solid.surface-chrome--frost,
.shell-nav-rail--compact .shell-nav-pill.surface-chrome--solid,
.shell-chat-overlay-chrome.surface-chrome--solid,
.shell-transient-chrome.surface-chrome--solid,
.shell-sheet-compact-chrome.surface-chrome--solid,
.shell-account-sheet-header.surface-chrome--solid,
.shell-composer-mount.surface-chrome--solid {
  backdrop-filter: none;
}

.chat-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
}

.chat-shell {
  position: absolute;
  top: 16dp;
  left: 16dp;
  right: 16dp;
  bottom: 16dp;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  max-width: 800dp;
  margin-left: auto;
  margin-right: auto;
}

.chat-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12dp;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-bottom: 12dp;
  padding: 8dp 12dp;
  border-radius: 8dp;
}

.chat-header-secure-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  margin-bottom: 4dp;
}

.chat-header-type-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  margin-bottom: 4dp;
}

.chat-header-type-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18dp;
  height: 18dp;
}

.chat-header-type-icon svg {
  flex-shrink: 0;
}

.chat-type-badge {
  flex-shrink: 0;
}

.chat-header-main {
  flex: 1;
  min-width: 0;
}

.chat-header-title {
  margin: 0;
}

.chat-peer-link {
  margin: 2dp 0 0 0;
  opacity: 0.85;
}

.chat-gap-banner {
  flex-shrink: 0;
  margin-bottom: 8dp;
  padding: 8dp 12dp;
  border-radius: 8dp;
  background-color: var(--color-surface-elevated);
  gap: 8dp;
}

.chat-header-title {
  font-size: 22dp;
  margin-bottom: 4dp;
}

.chat-header-title-btn {
  decorator: none;
  border-width: 0;
  background-color: transparent;
  padding: 0;
  text-align: left;
  cursor: pointer;
}

.chat-preview-btn {
  flex-shrink: 0;
  margin-top: 2dp;
}

.chat-header-actions {
  flex-shrink: 0;
  align-items: flex-start;
  gap: 8dp;
  margin-top: 2dp;
}

.chat-header-call-btn,
.chat-header-more-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 18dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.chat-header-call-btn svg,
.chat-header-more-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

.shell-profile-btn {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  padding: 0;
  border: 0;
  border-radius: 18dp;
  cursor: pointer;
}

.shell-profile-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

.badge-dot--profile {
  position: absolute;
  top: 0;
  right: 0;
}

.messages {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  overflow-y: auto;
  overflow-x: hidden;
  margin-bottom: 12dp;
  padding-left: 8dp;
  padding-right: 8dp;
}

.chat-messages-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 0;
  /* Fill remaining chat-panel height; do not nest another flex column — that
     lets .messages grow with content and lose overflow scrolling. */
}

.chat-messages-wrap .messages {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  flex: none;
  margin-bottom: 0;
}

.chat-jump-latest {
  position: absolute;
  right: 16dp;
  bottom: 16dp;
  z-index: 5;
  width: auto;
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 8dp 14dp;
  border: 0;
  border-radius: 16dp;
  cursor: pointer;
  focus: none;
}

.message-group {
  display: block;
}

.message-row {
  display: block;
  margin-bottom: 12dp;
}

.message-row-user {
  text-align: right;
}

.message-row-assistant {
  text-align: left;
}

.bubble {
  padding: 10dp 14dp;
  border-radius: 12dp;
  text-align: left;
  box-sizing: border-box;
}

.bubble-user {
  display: inline-block;
  max-width: 680dp;
  focus: none;
}

.bubble-text {
  margin-top: 0;
  margin-bottom: 0;
  white-space: pre-wrap;
  word-break: break-word;
}

.assistant-message {
  display: block;
}

.bubble-assistant {
  display: inline-block;
  max-width: 680dp;
  focus: none;
}

.suggestion-row {
  display: block;
  margin-top: 8dp;
}

.bubble-assistant ul,
.bubble-assistant ol {
  box-sizing: border-box;
}

.bubble-assistant p,
.bubble-assistant li,
.bubble-assistant .code-block {
  word-break: break-word;
}

.bubble-assistant p:last-child,
.bubble-assistant .stack p:last-child {
  margin-bottom: 0;
}

.bubble-assistant h1,
.bubble-assistant h2,
.bubble-assistant h3 {
  margin-top: 0;
}

.bubble-assistant p,
.bubble-assistant li {
}

.thinking {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

.prompt-composer {
  flex-shrink: 0;
  box-sizing: border-box;
  margin: 0 12dp 12dp 12dp;
  padding: 12dp;
  border-radius: 12dp;
}

.prompt-composer-input {
  width: 100%;
  min-height: 40dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: text;
}

.prompt-composer-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8dp;
  gap: 8dp;
}

.prompt-composer-leading {
  flex: 1;
  min-width: 0;
}

.prompt-send-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.prompt-send-btn svg {
  flex-shrink: 0;
  width: 14dp;
  height: 14dp;
}

.code-block {
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  margin-top: 4dp;
  margin-bottom: 8dp;
  white-space: pre-wrap;
}

.chat-suggestion {
  display: inline-block;
  width: auto;
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 6dp 12dp;
  margin-right: 8dp;
  margin-bottom: 4dp;
  border: 0;
  border-radius: 16dp;
  cursor: pointer;
  focus: none;
}

.suggestion-row .chat-suggestion {
  margin-top: 0;
}

.bubble-assistant .chat-suggestion {
  margin-top: 8dp;
}

.chat-form {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.chat-form-label {
  display: block;
  margin-bottom: 8dp;
}

.chat-form-field {
  display: block;
  width: 100%;
  margin-top: 4dp;
  margin-bottom: 0;
  box-sizing: border-box;
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
}

.chat-form-submit {
  display: inline-block;
  width: auto;
  margin-top: 8dp;
  padding: 8dp 16dp;
  border-radius: 8dp;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.chat-form-expired {
  opacity: 0.85;
}

.chat-form-expired .chat-form-field,
.chat-form-expired .chat-form-submit {
  pointer-events: none;
  opacity: 0.6;
}

.chat-form-expired .chat-form-submit {
  display: none;
}

.chat-form-expired-label {
  margin-top: 0;
  margin-bottom: 8dp;
}

.chat-card {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.chat-table {
  width: 100%;
  margin-top: 12dp;
}

.chat-table th,
.chat-table td {
  padding: 6dp 8dp;
  text-align: left;
}

.chat-key-value {
  display: block;
  margin-top: 12dp;
}

.chat-key-value-row {
  display: flex;
  justify-content: space-between;
  gap: 12dp;
  padding: 4dp 0;
}

.chat-callout {
  display: block;
  margin-top: 12dp;
  padding: 10dp 12dp;
  border-radius: 8dp;
}

.chat-quote {
  display: block;
  margin-top: 12dp;
  padding-left: 12dp;
}

.chat-action-list,
.chat-long-list,
.chat-choice,
.chat-poll {
  display: block;
  margin-top: 12dp;
}

.chat-long-list-scroll {
  max-height: 240dp;
  overflow-y: auto;
  padding: 8dp;
  margin-top: 8dp;
  border-radius: 6dp;
  box-sizing: border-box;
}

.chat-long-list-item {
  display: block;
  margin-bottom: 12dp;
  padding-bottom: 10dp;
}

.chat-long-list-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
}

.chat-long-list-title {
  margin-bottom: 4dp;
}

.chat-long-list-subtitle,
.chat-long-list-meta {
  margin-bottom: 4dp;
  font-size: 13dp;
}

.chat-long-list-actions,
.chat-long-list-footer {
  gap: 8dp;
  flex-wrap: wrap;
  margin-top: 6dp;
}

.chat-action-list-item {
  display: block;
  margin-bottom: 10dp;
}

.chat-action-list-actions,
.chat-choice-options,
.chat-poll-options {
  gap: 8dp;
  flex-wrap: wrap;
}

.chat-calendar {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.calendar-header {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8dp;
}

.calendar-nav {
  display: inline-block;
  padding: 6dp 12dp;
  border: 0;
  border-radius: 6dp;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.calendar-weekdays {
  justify-content: space-between;
  margin-bottom: 4dp;
}

.calendar-weekdays span {
  width: 14%;
  text-align: center;
}

.calendar-grid {
  width: 100%;
}

.calendar-cell {
  width: 14%;
  text-align: center;
  padding: 2dp;
  vertical-align: middle;
}

.calendar-day {
  display: inline-block;
  width: 100%;
  min-height: 28dp;
  padding: 4dp 0;
  border-radius: 6dp;
  border: 0;
  text-align: center;
  box-sizing: border-box;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.calendar-day-muted {
  display: inline-block;
  width: 100%;
  min-height: 28dp;
  padding: 4dp 0;
  border-radius: 6dp;
  text-align: center;
  box-sizing: border-box;
  background-color: transparent;
  cursor: default;
}

.shell-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
  margin: 0;
  /* Corner rounding is macOS-native (CALayer), not RCSS — see WINDOW_SHELL.md. */
}

.shell-titlebar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 120;
  height: 36dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  border-bottom-width: 1dp;
}

.shell-titlebar-drag {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-left: 12dp;
  padding-right: 8dp;
  box-sizing: border-box;
}

.shell-titlebar-title {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  font-family: LatoLatin;
  font-size: 13dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
}

.shell-titlebar-controls {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  height: 100%;
}

.shell-titlebar-controls--traffic {
  align-items: center;
  padding-left: 8dp;
  padding-right: 8dp;
  gap: 8dp;
  box-sizing: border-box;
}

.shell-titlebar-btn {
  width: 40dp;
  min-width: 40dp;
  height: 100%;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.shell-titlebar-btn svg {
  flex-shrink: 0;
  width: 12dp;
  height: 12dp;
}

.shell-titlebar-btn--traffic {
  width: 12dp;
  min-width: 12dp;
  height: 12dp;
  min-height: 12dp;
  border-radius: 0;
  padding: 0;
}

.shell-titlebar-traffic-dot {
  width: 12dp;
  height: 12dp;
  min-width: 12dp;
  min-height: 12dp;
  border-radius: 6dp;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.shell-titlebar-btn--traffic svg {
  width: 6dp;
  height: 6dp;
  opacity: 0;
}

.shell-titlebar-btn--traffic:hover svg {
  opacity: 1;
}

.shell-chrome {
  position: relative;
  z-index: 100;
  /* Banner/toasts sit above content; the chrome box itself must not steal taps. */
  pointer-events: none;
}

.shell-chrome .shell-banner,
.shell-chrome .shell-toast,
.shell-chrome .shell-banner-dismiss {
  pointer-events: auto;
}

.shell-root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  padding: 8dp 12dp;
}

.shell-banner-text {
  flex: 1;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

.shell-banner-dismiss {
  width: auto;
  min-width: 32dp;
  padding: 4dp 10dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-toast-stack {
  position: absolute;
  top: 8dp;
  right: 12dp;
  z-index: 110;
}

.shell-toast {
  padding: 10dp 14dp;
  margin-bottom: 8dp;
  border-radius: 8dp;
}

.shell-toast-text {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

.shell-activity-strip {
  height: 3dp;
  opacity: 0.85;
}

.shell-statusbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 24dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12dp;
  padding: 0 12dp;
  box-sizing: border-box;
  border-top-width: 1dp;
  border-top-style: solid;
  z-index: 50;
}

.shell-statusbar-connection,
.shell-statusbar-activity {
  margin-top: 0;
  margin-bottom: 0;
  white-space: nowrap;
  overflow: hidden;
}

.shell-statusbar-activity {
  text-align: right;
}

.shell-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-pane-row {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.shell-nav-rail {
  flex: 0 0 72dp;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.shell-nav-rail--compact {
  flex: 0 0 auto;
  flex-direction: row;
  width: 100%;
  height: 56dp;
  box-sizing: border-box;
  background-color: transparent;
}

.shell-nav-rail-inner {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: flex-start;
  gap: 4dp;
  padding: 8dp 4dp;
  box-sizing: border-box;
}

.shell-nav-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.shell-nav-pill--secondary {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
  justify-content: flex-start;
}

.shell-nav-rail--compact .shell-nav-rail-inner {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 12dp;
  height: 56dp;
  padding: 0;
}

.shell-nav-rail--compact .shell-nav-pill {
  flex-direction: row;
  align-items: center;
  height: 56dp;
  padding: 4dp 6dp;
  border-radius: 24dp;
  overflow: hidden;
  width: auto;
  flex: 0 0 auto;
}

.shell-nav-rail--compact .shell-nav-pill--secondary {
  flex: 0 0 auto;
  width: auto;
  min-height: 0;
}

.shell-nav-spacer {
  flex: 0 0 auto;
  width: 100%;
  min-height: 0;
}

.shell-nav-pill--secondary > .shell-nav-spacer {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
}

.shell-nav-rail--compact .shell-nav-spacer {
  display: none;
}

.shell-nav-tab {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2dp;
  width: 52dp;
  height: 56dp;
  min-width: 52dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 10dp;
  cursor: pointer;
  focus: none;
}

.shell-nav-rail--compact .shell-nav-tab {
  height: 48dp;
  border-radius: 20dp;
}

.shell-nav-tab svg {
  flex-shrink: 0;
}

.shell-nav-tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.shell-nav-tab-label {
  margin: 0;
  padding: 0;
  font-size: 10dp;
  text-align: center;
  line-height: 1.1;
}

.shell-nav-page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: 56dp;
}

.shell-nav-page .shell-pane-body {
  height: 100%;
}

.shell-nav-page--home .shell-pane-body {
  flex: 1;
  min-height: 0;
  height: auto;
}

.shell-pane-home {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.shell-pane-home .shell-pane-body {
  flex: 1;
  min-height: 0;
  height: auto;
}

.shell-chat-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateX(0);
  transition: transform 250ms;
}

.shell-chat-overlay.shell-swipe-dragging,
.shell-chat-overlay--dragging {
  transition: none;
}

.shell-account-sheet-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* Above auxiliary sheet (26/27); below dialog/overlay layers. */
  z-index: 28;
  focus: none;
}

.shell-account-sheet {
  position: absolute;
  left: 0;
  right: 0;
  /* Nearly full-height sheet: small top peek; bottom is shell floor (covers nav). */
  top: 48dp;
  bottom: 0;
  z-index: 29;
  display: flex;
  flex-direction: column;
  border-radius: 16dp 16dp 0 0;
  overflow: hidden;
  box-sizing: border-box;
  transform: translateY(0);
  transition: transform 250ms;
}

.shell-account-sheet--dragging {
  transition: none;
}

.shell-account-sheet-grabber {
  flex-shrink: 0;
  width: 36dp;
  height: 5dp;
  margin: 8dp auto 4dp;
  border-radius: 3dp;
}

.shell-account-sheet-header {
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  padding: 0 16dp 8dp;
  box-sizing: border-box;
}

.shell-account-sheet-header .heading-2 {
  margin: 0;
}

/* Circular close with cross icon (overrides absolute overlay .shell-close-btn). */
.shell-account-sheet-header .shell-close-btn {
  position: relative;
  top: auto;
  right: auto;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  padding: 0;
  border-radius: 16dp;
}

.shell-account-sheet-header .shell-close-btn svg {
  flex-shrink: 0;
}

.shell-account-sheet-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

.shell-chat-overlay-chrome {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  flex-shrink: 0;
  align-items: center;
  min-height: 48dp;
  padding: 4dp 4dp;
  box-sizing: border-box;
}

.shell-chat-overlay .shell-pane-body {
  flex: 1;
  min-height: 0;
  padding-top: 48dp;
  box-sizing: border-box;
}

.shell-chat-overlay .shell-composer-mount {
  flex-shrink: 0;
}

.shell-pane {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.shell-pane-secondary {
  flex: 0 0 240dp;
}

.shell-pane-primary {
  flex: 1;
}

.shell-pane-auxiliary {
  flex: 0 0 320dp;
}

.shell-layer-compact {
  display: flex;
  flex-direction: column;
}

.shell-pane-primary-compact {
  flex: 1;
  min-height: 0;
}

.shell-pane-composer {
  flex-shrink: 0;
}

.shell-bottom-chrome {
  position: absolute;
  bottom: 0;
  left: 12dp;
  right: 12dp;
  display: flex;
  flex-direction: column;
  z-index: 15;
  box-sizing: border-box;
}

.shell-composer-mount {
  flex-shrink: 0;
}

.shell-composer-mount .prompt-composer {
  margin-bottom: 8dp;
}

.shell-composer-mount.surface-chrome {
  padding-top: 8dp;
  box-sizing: border-box;
}

.shell-composer-mount.surface-chrome .prompt-composer {
  margin-bottom: 8dp;
}

.shell-drawer .shell-pane,
.shell-sheet .shell-pane {
  height: 100%;
}

.shell-sheet-compact {
  border-radius: 16dp 0 0 16dp;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.shell-sheet-compact-chrome {
  flex-shrink: 0;
  height: 8dp;
  box-sizing: border-box;
}

.shell-sheet-compact .shell-pane {
  flex: 1;
  min-height: 0;
}

.shell-pane-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.shell-drawer-scrim,
.shell-sheet-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* Must sit above .shell-chat-overlay (25) so compact working-set / Details sheet
     is visible while chat is open (WINDOW_SHELL interruption: aux > chat). */
  z-index: 26;
  focus: none;
}

.shell-drawer {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 280dp;
  max-width: 85%;
  z-index: 27;
}

.shell-sheet {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 320dp;
  max-width: 90%;
  z-index: 27;
}

.shell-toolbar {
  flex-shrink: 0;
  height: 48dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 8dp;
  box-sizing: border-box;
}

.shell-toolbar-flex {
  flex: 1;
}

.shell-toolbar-title {
  font-size: 14dp;
  text-align: center;
}

.shell-toolbar-btn {
  width: auto;
  min-width: 72dp;
  min-height: 44dp;
  padding: 6dp 12dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 13dp;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-transient-chrome {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  flex-shrink: 0;
  min-height: 48dp;
  padding: 4dp 4dp;
  box-sizing: border-box;
}

.shell-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  padding: 0;
  margin-bottom: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-back-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

.shell-layer-transient {
  display: flex;
  flex-direction: column;
  /* Above account sheet (29) / chat overlay (25); below context menu (40) and call chrome (45).
     Matches WINDOW_SHELL interruption: transient > account > aux > chat. */
  z-index: 30;
  transform: translateX(0);
  transition: transform 250ms;
}

.shell-layer-transient.shell-swipe-dragging {
  transition: none;
}

.shell-layer-transient .shell-pane-transient {
  flex: 1;
  min-height: 0;
  padding-top: 48dp;
  box-sizing: border-box;
}

.shell-layer-overlay,
.shell-layer-dialog {
  z-index: 50;
}

.shell-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  focus: none;
}

.shell-frame {
  position: absolute;
  top: 24dp;
  left: 24dp;
  right: 24dp;
  bottom: 24dp;
  padding: 16dp;
  border-radius: 8dp;
  box-sizing: border-box;
}

.shell-close-btn {
  position: absolute;
  top: 8dp;
  right: 8dp;
  width: auto;
  min-width: 32dp;
  padding: 4dp 10dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-overlay-body {
  margin-top: 32dp;
  height: 100%;
  overflow: auto;
}

.shell-dialog {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 360dp;
  max-width: 90%;
  margin-left: -180dp;
  margin-top: -120dp;
  padding: 20dp;
  border-radius: 8dp;
  box-sizing: border-box;
  z-index: 51;
}

.shell-call-in-progress {
  margin-top: -170dp;
}

.shell-dialog-title {
  margin-top: 0;
  font-size: 18dp;
}

.shell-dialog-message {
  display: block;
  margin-top: 0;
  margin-bottom: 8dp;
}

.shell-call-meters {
  display: block;
  margin-top: 12dp;
  margin-bottom: 16dp;
}

.shell-call-meter {
  display: block;
  margin-bottom: 10dp;
}

.shell-call-meter--compact {
  margin-bottom: 0;
  margin-right: 12dp;
  min-width: 88dp;
}

.shell-call-meter-head {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4dp;
}

.shell-call-meter-label {
  font-size: 12dp;
  display: block;
  margin-bottom: 2dp;
}

.shell-call-meter-hint {
  font-size: 11dp;
  display: block;
  margin-top: 2dp;
}

.shell-call-meter-track {
  align-items: stretch;
  gap: 3dp;
  height: 8dp;
}

.shell-call-meter-seg {
  flex-grow: 1;
  height: 8dp;
  border-radius: 2dp;
}

.shell-layer-call-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 45;
  /* Capture hits over the messaging title / chat chrome underneath; children that
     should pass through (none today) can opt out with pointer-events: none. */
  pointer-events: auto;
  display: flex;
  flex-direction: column;
}

.shell-call-bar {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8dp;
  margin: 8dp 12dp;
  padding: 10dp 12dp;
  border-radius: 10dp;
  box-sizing: border-box;
}

.shell-call-bar-row {
  align-items: center;
  justify-content: space-between;
  gap: 8dp;
  width: 100%;
}

.shell-call-bar-main {
  flex-grow: 1;
  min-width: 0;
}

.shell-call-bar-title {
  margin: 0;
  font-size: 14dp;
  font-weight: bold;
}

.shell-call-bar-subtitle {
  margin: 2dp 0 0 0;
  font-size: 12dp;
}

.shell-call-bar-hint {
  margin: 4dp 0 0 0;
  max-width: 280dp;
}

.shell-call-bar-meters {
  align-items: flex-start;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 8dp 12dp;
  width: 100%;
}

.shell-call-bar-actions {
  align-items: center;
  gap: 8dp;
  flex-shrink: 0;
}

.shell-call-mute,
.shell-call-camera,
.shell-call-leave,
.shell-call-invite,
.shell-call-retry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 22dp;
  cursor: pointer;
}

.shell-call-mute svg,
.shell-call-camera svg,
.shell-call-leave svg,
.shell-call-invite svg,
.shell-call-retry svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

.shell-call-roster {
  flex-wrap: wrap;
  gap: 6dp;
  padding: 0 12dp 8dp 12dp;
  max-height: 72dp;
  overflow-y: auto;
}

.shell-call-roster-chip {
  align-items: center;
  gap: 4dp;
  padding: 4dp 8dp;
  border-radius: 999dp;
  background-color: var(--surface-2);
}

.shell-call-roster-name {
  margin: 0;
  max-width: 120dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shell-call-stage {
  margin: 8dp 12dp 0 12dp;
  height: 180dp;
  border-radius: 10dp;
  position: relative;
  overflow: hidden;
}

call-video-tile {
  display: block;
  box-sizing: border-box;
}

.shell-call-remote {
  width: 100%;
  height: 100%;
  border-radius: 10dp;
}

.shell-call-remote-placeholder {
  margin: 0;
  padding: 16dp;
  text-align: center;
}

.shell-call-pip {
  position: absolute;
  width: 72dp;
  height: 128dp;
  right: 10dp;
  bottom: 10dp;
  border-radius: 8dp;
  overflow: hidden;
}

.shell-call-leave {
  min-width: 44dp;
}

.shell-call-ring-eyebrow {
  margin: 0 0 4dp 0;
  font-size: 12dp;
}

.shell-call-ring--pulse {
  border-width: 2dp;
}

.shell-call-accept--pulse {
  opacity: 1;
}

.shell-dialog-checkbox {
  align-items: center;
  gap: 8dp;
  margin-top: 8dp;
  font-size: 14dp;
}

.shell-dialog-actions {
  justify-content: flex-end;
  gap: 8dp;
  margin-top: 16dp;
}

.shell-dialog-cancel {
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-dialog-ok {
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-pin-gate-chooser {
  display: flex;
  flex-direction: column;
  gap: 8dp;
  margin-top: 16dp;
}

.shell-pin-gate-chooser .shell-dialog-ok,
.shell-pin-gate-chooser .shell-dialog-cancel,
.shell-pin-gate-chooser .btn {
  display: block;
  width: 100%;
  text-align: center;
  box-sizing: border-box;
}

.shell-pin-gate-input {
  width: 100%;
  margin-bottom: 10dp;
}

.shell-pin-gate-error {
  min-height: 1.2em;
  margin-bottom: 8dp;
  color: #b42318;
}

.chat-empty {
  padding: 24dp;
  margin-bottom: 16dp;
  border-radius: 8dp;
}

.chat-empty-title {
  margin-top: 0;
  font-size: 20dp;
}

.home-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
}

.home-header {
  flex-shrink: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12dp;
  margin-bottom: 12dp;
  padding: 8dp 4dp;
}

.home-brand {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2dp;
}

.home-brand-name {
  margin: 0;
  font-family: LatoLatin;
  font-size: 22dp;
  font-weight: bold;
}

.home-brand-tagline {
  margin: 0;
}

.home-landing {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-bottom: 24dp;
  box-sizing: border-box;
}

.home-landing-inner {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 640dp;
  gap: 12dp;
  box-sizing: border-box;
}

.home-composer-mount {
  width: 100%;
  box-sizing: border-box;
}

.home-composer-mount .prompt-composer {
  margin: 0;
}

.home-suggestions {
  display: block;
  text-align: center;
  padding: 0 4dp;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
}

.chat-panel .chat-header-title {
  font-size: 22dp;
}

.chat-panel .chat-messages-wrap {
  flex: 1;
  min-height: 0;
}

.chat-transport-line {
  margin: 0 0 4dp 0;
}

.chat-transport-badge,
.chat-shared-badge,
.chat-annotation-badge {
  display: inline-block;
  margin-right: 6dp;
  padding: 1dp 6dp;
  border-radius: 4dp;
  background-color: rgba(128, 128, 128, 0.15);
  font-size: 11dp;
}

.chat-system-line {
  text-align: center;
  margin: 8dp 0;
}

.chat-card {
  border-radius: 8dp;
  padding: 10dp 12dp;
  margin: 4dp 0;
  background-color: rgba(128, 128, 128, 0.08);
}

.chat-orphan-annotation {
  margin: 6dp 0;
}

.message-row-annotation-orphan {
  opacity: 0.85;
}

.sidebar-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.sidebar-header {
  flex-shrink: 0;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8dp;
}

.sidebar-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.sidebar-header-actions {
  flex-shrink: 0;
  gap: 6dp;
  align-items: center;
  margin-left: auto;
}

.sidebar-new-chat {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.sidebar-new-chat svg {
  flex-shrink: 0;
}

.sidebar-sessions {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.sidebar-session {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 44dp;
  margin-bottom: 4dp;
  padding: 0 4dp 0 8dp;
  border-radius: 6dp;
  box-sizing: border-box;
  cursor: pointer;
}

.sidebar-session-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
}

.sidebar-session-title {
  flex: 1;
  min-width: 0;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar-session-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18dp;
  height: 18dp;
}

.sidebar-session-icon svg {
  flex-shrink: 0;
}

.sidebar-unread {
  flex-shrink: 0;
}

.badge-count {
  flex-shrink: 0;
  min-width: 20dp;
  padding: 2dp 6dp;
  border-radius: 10dp;
  font-size: 11dp;
  text-align: center;
}

.badge-count--nav {
  position: absolute;
  top: -4dp;
  right: -8dp;
  min-width: 16dp;
  padding: 1dp 4dp;
  font-size: 10dp;
  line-height: 1.1;
}

.badge-dot {
  flex-shrink: 0;
  width: 8dp;
  height: 8dp;
  border-radius: 4dp;
}

.badge-dot--nav {
  position: absolute;
  top: -2dp;
  right: -4dp;
}

.sidebar-session-close {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28dp;
  height: 28dp;
  min-width: 28dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.sidebar-session-close svg {
  flex-shrink: 0;
}

.message-row-peer {
  margin: 8dp 0;
  padding-right: 48dp;
}

.message-row-ai {
  margin: 8dp 0;
  padding-right: 24dp;
}

.message-row-user {
  margin: 8dp 0;
  padding-left: 48dp;
}

.sender-label {
  display: block;
  font-size: 11dp;
  margin-top: 0;
  margin-bottom: 4dp;
}

.preview-panel,
.working-set-panel {
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow-y: auto;
}

.preview-title,
.working-set-title {
  margin-top: 0;
  font-size: 18dp;
}

.preview-content,
.working-set-body {
  margin-top: 8dp;
}

.working-set-long-list-body {
  display: block;
}

.working-set-long-list .chat-long-list-item {
  display: block;
  margin-bottom: 12dp;
  padding-bottom: 10dp;
}

.working-set-form {
  display: block;
  margin-top: 8dp;
}

.working-set-table {
  width: 100%;
}

.working-set-code {
  white-space: pre-wrap;
}

.chat-working-set-chip {
  display: inline-block;
  margin-top: 8dp;
  margin-right: 8dp;
  padding: 6dp 12dp;
  border-radius: 16dp;
  font-size: 13dp;
  focus: none;
}

.empty-panel {
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  justify-content: center;
}

/* Settings panel */
.settings-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.settings-list-view,
.settings-detail-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.settings-detail-view {
  transform: translateX(0);
  transition: transform 250ms;
}

.settings-detail-view.shell-swipe-dragging {
  transition: none;
}

.settings-header,
.settings-detail-header {
  flex-shrink: 0;
  align-items: center;
  margin-bottom: 8dp;
}

.settings-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.me-profile-card {
  flex-shrink: 0;
  margin-bottom: 12dp;
  padding: 10dp;
  border-radius: 8dp;
  box-sizing: border-box;
  gap: 6dp;
}

.me-profile-meta {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
  word-break: break-all;
}

.me-profile-actions {
  margin-top: 4dp;
  gap: 8dp;
  flex-wrap: wrap;
}

.me-preferences-label {
  flex-shrink: 0;
  margin-top: 4dp;
  margin-bottom: 6dp;
}

.settings-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.settings-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 44dp;
  margin-bottom: 6dp;
  padding: 12dp 10dp;
  border-width: 1dp;
  border-radius: 10dp;
  box-sizing: border-box;
  cursor: pointer;
  text-align: left;
}

.settings-row-text {
  flex: 1;
  min-width: 0;
  gap: 2dp;
}

.settings-row-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 15dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.settings-row-subtitle {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.settings-row-chevron {
  flex-shrink: 0;
  margin-left: 8dp;
}

.settings-back-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin-right: 4dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.settings-back-btn svg {
  flex-shrink: 0;
}

.settings-detail-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  gap: 8dp;
}

.settings-detail-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  overflow: hidden;
}

.settings-section {
  margin-top: 16dp;
  gap: 8dp;
}

.settings-section-title {
  font-size: 14dp;
  font-weight: bold;
  margin-bottom: 4dp;
}

.settings-field {
  display: block;
}

.settings-label {
  display: block;
  font-size: 12dp;
  margin-bottom: 4dp;
}

.settings-toggle-row {
  align-items: center;
  justify-content: space-between;
  gap: 12dp;
  min-height: 44dp;
  width: 100%;
  box-sizing: border-box;
}

.settings-toggle-label {
  display: block;
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
  font-size: 15dp;
}

.settings-switch {
  position: relative;
  flex-shrink: 0;
  width: 42dp;
  height: 26dp;
  min-width: 42dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999dp;
  box-sizing: border-box;
  cursor: pointer;
}

.settings-switch-knob {
  position: absolute;
  top: 2dp;
  left: 2dp;
  width: 22dp;
  height: 22dp;
  border-radius: 999dp;
  box-sizing: border-box;
  transform: translateX(0);
  transition: transform 200ms;
  pointer-events: none;
}

.settings-switch--on .settings-switch-knob {
  transform: translateX(16dp);
}

.settings-choice-row {
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
  text-align: left;
}

.settings-choice-value {
  flex-shrink: 0;
  align-items: center;
  gap: 4dp;
}

.settings-choice-value-text {
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 160dp;
}

.settings-help {
  font-size: 12dp;
  margin-top: 0;
  margin-bottom: 4dp;
}

.settings-path {
  font-size: 12dp;
  word-break: break-all;
}

.settings-actions {
  margin-top: 24dp;
  gap: 12dp;
  justify-content: flex-end;
}

.settings-action-bar {
  display: block;
  width: 100%;
  text-align: center;
  box-sizing: border-box;
  padding-top: 12dp;
  padding-bottom: 12dp;
}

/* Pre-confirm destructive action: soft tint, not solid fill. */
.btn-danger-soft {
  border-width: 1dp;
}

.settings-danger-zone {
  margin-top: 24dp;
  padding-top: 16dp;
  gap: 8dp;
}

.settings-danger-zone .settings-actions {
  margin-top: 4dp;
}

.sidebar-footer {
  margin-top: auto;
  padding: 12dp 16dp;
}

.sidebar-settings-btn {
  display: flex;
  align-items: center;
  gap: 8dp;
  width: 100%;
  text-align: left;
}

.sidebar-settings-btn svg {
  flex-shrink: 0;
}

/* Contacts panel */
.contacts-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.contacts-list-view,
.contacts-detail-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.contacts-header,
.contacts-detail-header {
  flex-shrink: 0;
  margin-bottom: 8dp;
}

.contacts-header {
  align-items: center;
  justify-content: space-between;
}

.contacts-detail-header {
  gap: 2dp;
}

.contacts-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.contacts-header-actions {
  flex-shrink: 0;
  align-items: center;
  gap: 4dp;
}

.contacts-find-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.contacts-find-btn svg {
  flex-shrink: 0;
}

.contacts-search {
  flex-shrink: 0;
  margin-bottom: 8dp;
}

.contacts-search-field {
  margin-bottom: 0;
}

.contacts-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.contacts-row,
.contacts-thread-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 44dp;
  margin-bottom: 4dp;
  padding: 6dp 8dp;
  border-radius: 6dp;
  box-sizing: border-box;
  cursor: pointer;
  gap: 8dp;
}

.contacts-row-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18dp;
  height: 18dp;
}

.contacts-row-icon svg {
  flex-shrink: 0;
}

.contacts-row-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.contacts-row-title-line {
  align-items: center;
  gap: 6dp;
  min-width: 0;
}

.contacts-row-title {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  margin-bottom: 2dp;
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.contacts-row-subtitle {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 11dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.contacts-trust-badge {
  flex-shrink: 0;
  padding: 1dp 6dp;
  border-radius: 8dp;
  font-size: 10dp;
}

.contacts-empty {
  margin-top: 12dp;
  gap: 8dp;
}

.contacts-back-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin-right: 4dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.contacts-back-btn svg {
  flex-shrink: 0;
}

.contacts-detail-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  gap: 12dp;
}

.contact-profile-card {
  flex-shrink: 0;
  padding: 10dp;
  border-radius: 8dp;
  box-sizing: border-box;
  gap: 6dp;
}

.contact-detail-section {
  flex-shrink: 0;
  gap: 6dp;
}

.contact-detail-danger {
  margin-top: 8dp;
  margin-bottom: 4dp;
}

.contacts-edit-field {
  width: 100%;
  gap: 4dp;
}

.contacts-multiaddrs-field {
  min-height: 72dp;
  resize: none;
}

.contacts-trust-actions {
  margin-top: 4dp;
  gap: 8dp;
  flex-wrap: wrap;
}

.contacts-trust-btn {
  font-size: 12dp;
  padding: 6dp 10dp;
}

.btn-icon {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6dp;
}

.btn-icon svg {
  flex-shrink: 0;
}

.contacts-threads {
  gap: 4dp;
}

.contacts-actions {
  flex-shrink: 0;
  margin-top: 16dp;
  gap: 8dp;
}

.contacts-action-buttons {
  gap: 8dp;
  flex-wrap: wrap;
}

.contacts-actions-hint {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
}

.people-picker {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  gap: 12dp;
}

.people-picker-header {
  align-items: center;
  justify-content: space-between;
  padding-right: 28dp;
}

.people-picker-title {
  margin: 0;
  font-family: LatoLatin;
  font-size: 18dp;
  font-weight: bold;
}

.people-picker-search {
  flex-shrink: 0;
}

.people-picker-search-field {
  width: 100%;
  box-sizing: border-box;
}

.people-picker-list {
  flex: 1;
  min-height: 0;
  overflow: auto;
}

.people-picker-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10dp;
  padding: 10dp 8dp;
  margin-bottom: 4dp;
  border-radius: 8dp;
  cursor: pointer;
}

.people-picker-check {
  width: 22dp;
  height: 22dp;
  border-radius: 11dp;
  border-width: 1dp;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.people-picker-check-mark {
  margin: 0;
  font-size: 12dp;
  font-weight: bold;
}

.people-picker-row-body {
  flex: 1;
  min-width: 0;
}

.people-picker-row-title {
  margin: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
}

.people-picker-row-subtitle {
  margin: 2dp 0 0 0;
  font-size: 12dp;
  white-space: nowrap;
  overflow: hidden;
}

.people-picker-locked-label {
  margin: 0;
  font-size: 11dp;
  flex-shrink: 0;
}

.people-picker-footer {
  flex-shrink: 0;
  justify-content: flex-end;
  gap: 8dp;
  padding-top: 8dp;
}

.people-picker-name,
.people-picker-select {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  gap: 12dp;
}

.people-picker-name-help {
  margin: 0;
}

.people-picker-name-field {
  flex-shrink: 0;
}

.people-picker-members {
  flex: 1;
  min-height: 0;
  overflow: auto;
}

.people-picker-members-label {
  margin: 0 0 4dp 0;
}

.people-picker-member-chips {
  flex-wrap: wrap;
  gap: 6dp;
}

.people-picker-member-chip {
  padding: 4dp 10dp;
  border-radius: 999dp;
  font-size: 13dp;
}

.contact-detail-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  overflow: hidden;
}

.shell-nav-page--under-overlay {
  opacity: 1;
}

.context-menu-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
}

.context-menu-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.context-menu-panel {
  position: absolute;
  min-width: 180dp;
  max-width: 100%;
  padding: 4dp;
  border-radius: 8dp;
  box-shadow: 0 4dp 16dp rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

/* Compact ShowActions: iOS-style bottom action sheet.
   Sheet frame (left / width / bottom) comes from ContextMenuHost::LayoutActionSheet.
   Block stack (not flex) avoids min-content overflow past the viewport frame. */
.context-menu-layer--sheet {
  box-sizing: border-box;
}

.context-menu-sheet {
  position: absolute;
  z-index: 1;
  display: block;
  overflow: hidden;
  box-sizing: border-box;
}

.context-menu-sheet-list {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0;
  margin-bottom: 8dp;
  padding: 4dp;
  border-radius: 12dp;
  overflow: auto;
  max-height: 320dp;
  box-sizing: border-box;
  /* No box-shadow: blur extend (~1.5*radius) exceeds the 12dp sheet inset and
     RmlUi clips the shadow texture to the window, which clips the painted panel. */
}

.context-menu-sheet-cancel {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 48dp;
  margin: 0;
  padding: 12dp 16dp;
  border: 0;
  border-radius: 12dp;
  font-family: LatoLatin;
  font-size: 16dp;
  font-weight: bold;
  text-align: center;
  cursor: pointer;
  box-sizing: border-box;
}

.context-menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10dp;
  width: 100%;
  min-width: 0;
  min-height: 40dp;
  margin: 0;
  padding: 8dp 12dp;
  border: 0;
  border-radius: 6dp;
  background-color: transparent;
  text-align: left;
  cursor: pointer;
  box-sizing: border-box;
}

.context-menu-layer--sheet .context-menu-item {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 48dp;
  padding: 12dp 16dp;
  border-radius: 8dp;
  box-sizing: border-box;
}

.context-menu-layer--sheet .context-menu-item-label {
  font-size: 16dp;
}

.context-menu-item-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18dp;
  height: 18dp;
}

.context-menu-item-icon svg {
  flex-shrink: 0;
}

.context-menu-item-label {
  flex: 1;
  min-width: 0;
  font-family: LatoLatin;
  font-size: 14dp;
}

.context-menu-item-check {
  flex-shrink: 0;
  margin-left: 8dp;
  font-family: LatoLatin;
  font-size: 14dp;
  color: #2563eb;
}

.context-menu-item--selected .context-menu-item-label {
  font-weight: bold;
}
