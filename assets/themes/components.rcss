.btn {
  font-family: LatoLatin;
  font-size: 14dp;
  min-height: 44dp;
  padding: 0 16dp;
  line-height: 44dp;
  border-radius: 999dp;
  border: 0;
  cursor: pointer;
  margin-bottom: 0;
  width: auto;
  display: inline-block;
  box-sizing: border-box;
  text-align: center;
}

/* Low-emphasis text action (PIN “Not now”, optional dismissals). */
.btn-ghost {
  background-color: transparent;
}

/* Icon + label modifier — layout only; size/color come from .btn + .btn-*. */
.btn-icon {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6dp;
}

.btn-icon svg {
  flex-shrink: 0;
}

.field {
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  width: 100%;
  margin-bottom: 8dp;
  box-sizing: border-box;
  display: block;
}

/* RmlUi <select> internals: selectvalue, selectarrow, selectbox (see WidgetDropDown). */
select:focus {
  position: relative;
  z-index: 10;
}

select selectbox {
  border-radius: 6dp;
  padding: 4dp 0;
  box-sizing: border-box;
}

select selectbox option {
  padding: 8dp 12dp;
}

.card {
  padding: 16dp;
  border-radius: 8dp;
  margin-bottom: 12dp;
}

/* Floating Chrome — compact shell materials; theme colors in colors-*.rcss.
   Default: opaque elevated surfaces. At most one bar uses backdrop frost per frame
   (see ShellInterruption::ResolveFrostSurface). */
.surface-chrome {
  backdrop-filter: none;
}

.surface-chrome--frost {
  backdrop-filter: blur(12px);
}

.shell-bottom-chrome--frost {
  backdrop-filter: blur(12px);
}

.shell-bottom-chrome--solid {
  backdrop-filter: none;
}

.surface-chrome--solid,
.shell-bottom-chrome--frost.shell-bottom-chrome--solid,
.surface-chrome--solid.surface-chrome--frost,
.shell-chat-overlay-chrome.surface-chrome--solid,
.shell-transient-chrome.surface-chrome--solid,
.shell-sheet-compact-chrome.surface-chrome--solid,
.shell-composer-mount.surface-chrome--solid {
  backdrop-filter: none;
}

.chat-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
}

.chat-shell {
  position: absolute;
  top: 16dp;
  left: 16dp;
  right: 16dp;
  bottom: 16dp;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  max-width: 800dp;
  margin-left: auto;
  margin-right: auto;
}

.chat-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 8dp;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-bottom: 8dp;
  padding: 6dp 10dp;
  border-radius: 6dp;
}

.chat-header-secure-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  margin-bottom: 2dp;
}

.chat-header-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  min-width: 0;
}

.chat-header-type-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 16dp;
  height: 16dp;
}

.chat-header-type-icon svg {
  flex-shrink: 0;
}

.chat-header-main {
  flex: 1;
  min-width: 0;
}

/* Search inside the chat: one row in the title row's place — box, count, older / newer, Cancel. On a narrow
   screen the box gives way first (down to its minimum), then the count is cut with an ellipsis. */
.chat-search-bar {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
}

.chat-search-input {
  flex: 1 1 0;
  min-width: 72dp;
  width: auto;
  margin-bottom: 0;
}

.chat-search-count {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* A thin chevron, no background of its own. */
.chat-search-step {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28dp;
  height: 28dp;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
}

.chat-search-step:disabled {
  opacity: 0.35;
  cursor: auto;
}

.chat-search-cancel {
  flex-shrink: 0;
  padding: 6dp 8dp;
  border: 0;
  border-radius: 16dp;
  font-size: 14dp;
  white-space: nowrap;
  background-color: transparent;
  cursor: pointer;
}

/* A search match in a message (colours in colors-*.rcss); like the mention chip, it stays inline. */
.search-mark {
  padding: 0 1dp;
  border-radius: 3dp;
}

.chat-header-meta-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 6dp;
  margin-top: 1dp;
  min-width: 0;
}

.chat-peer-path {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4dp;
  flex-shrink: 0;
}

.chat-peer-path-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 12dp;
  height: 12dp;
}

.chat-peer-path-icon svg {
  flex-shrink: 0;
}

.chat-peer-link {
  margin: 0;
  opacity: 0.85;
}

.chat-gap-banner {
  flex-shrink: 0;
  margin-bottom: 8dp;
  padding: 8dp 12dp;
  border-radius: 8dp;
  gap: 8dp;
}

.chat-header-title {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 18dp;
  font-weight: normal;
}

.chat-header-subtitle {
  margin: 0;
  flex: 1;
  min-width: 0;
}

.chat-header-title-btn {
  decorator: none;
  border-width: 0;
  background-color: transparent;
  padding: 0;
  text-align: left;
  cursor: pointer;
}

.chat-header-actions {
  flex-shrink: 0;
  align-items: center;
  gap: 6dp;
}

.chat-header-call-btn,
.chat-header-more-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 18dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.chat-header-call-btn svg,
.chat-header-more-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

/* V053: a group call goes on in this chat — the call button joins it. */
.chat-header-call-btn--join {
  width: auto;
  padding: 0 14dp;
  gap: 6dp;
  font-weight: bold;
}

.messages {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  overflow-y: auto;
  overflow-x: hidden;
  margin-bottom: 12dp;
  padding-left: 8dp;
  padding-right: 8dp;
}

.chat-messages-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 0;
  /* Fill remaining chat-panel height; do not nest another flex column — that
     lets .messages grow with content and lose overflow scrolling. */
}

.chat-messages-wrap .messages {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  flex: none;
  margin-bottom: 0;
}

.chat-jump-latest {
  position: absolute;
  right: 16dp;
  bottom: 16dp;
  z-index: 5;
  width: auto;
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 8dp 14dp;
  border: 0;
  border-radius: 16dp;
  cursor: pointer;
  focus: none;
}

.message-group {
  display: block;
}

.message-row {
  display: block;
  margin-bottom: 12dp;
}

.message-row-user {
  text-align: right;
}

.message-row-assistant {
  text-align: left;
}

.bubble {
  /* Horizontal padding is mirrored by kBubbleHorizontalPaddingDp (src/gui/chat/AiImageAttach.h); change both. */
  padding: 10dp 14dp;
  border-radius: 12dp;
  text-align: left;
  box-sizing: border-box;
}

.bubble-user {
  display: inline-block;
  max-width: 680dp;
  focus: none;
}

/* An AI question waiting for another chat's answer (B112): dimmed until it is sent. */
.bubble-queued {
  opacity: 0.55;
  white-space: pre-wrap;
}

.queued-note {
  margin-top: 4dp;
  font-size: 12dp;
}

.queued-cancel {
  text-decoration: underline;
  cursor: pointer;
}

.bubble-text {
  margin-top: 0;
  margin-bottom: 0;
  white-space: pre-wrap;
  word-break: break-word;
}

/* The quoted message on top of a reply, and the question on top of an @ai answer (domain/messaging/QuoteReply.h). */
.chat-quote {
  display: block;
  margin-bottom: 6dp;
  padding: 4dp 8dp;
  border-left: 3dp #818cf8;
  border-radius: 6dp;
  background-color: rgba(128, 128, 128, 0.16);
}

/* Dimmed and at most two lines; the whole message is one tap away (jump_to_quote). */
.chat-quote-text {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  max-height: 36dp;
  overflow: hidden;
  word-break: break-word;
  font-size: 13dp;
  line-height: 18dp;
  opacity: 0.6;
}

.chat-quote--jump {
  cursor: pointer;
}

/* A peer's plain-text message: keeps its line breaks, like our own (.bubble-text also sets our colour). */
/* "This message was deleted": no bubble, a small grey note on the sender's side (InboxController). */
.bubble.bubble-deleted {
  background-color: transparent;
  border-width: 0;
  padding: 2dp 4dp;
}

/* No italic: only regular font faces are loaded, and RmlUi draws nothing for a face it does not have. */
.bubble-deleted-text {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
}

.bubble-text-peer {
  margin-top: 0;
  margin-bottom: 0;
  white-space: pre-wrap;
  word-break: break-word;
}

.assistant-message {
  display: block;
}

.bubble-assistant {
  display: inline-block;
  max-width: 680dp;
  focus: none;
}

.suggestion-row {
  display: block;
  margin-top: 8dp;
}

.bubble-assistant ul,
.bubble-assistant ol {
  box-sizing: border-box;
  /* The engine's defaults (40dp left padding, 1em margins) pushed lists far from the bubble's edge. */
  margin-top: 4dp;
  margin-bottom: 4dp;
  padding-left: 0;
}

/* List items draw their own marker (MarkdownToRml): the number or bullet sits in the item's left padding,
   so wrapped lines align under the text. */
.bubble-assistant li {
  display: block;
  position: relative;
  padding-left: 26dp;
}

.bubble-assistant .md-marker {
  position: absolute;
  left: 0;
  top: 0;
  opacity: 0.7;
}

.bubble-assistant .md-item {
  display: block;
}

.bubble-assistant p,
.bubble-assistant li,
.bubble-assistant .code-block {
  word-break: break-word;
}

.bubble-assistant p:last-child,
.bubble-assistant .stack p:last-child {
  margin-bottom: 0;
}

/* B81: the engine gives <p> a top margin; the first paragraph must sit on the bubble padding, not a blank line below it. */
.bubble-assistant p:first-child,
.bubble-assistant .stack p:first-child {
  margin-top: 0;
}

.bubble-assistant h1,
.bubble-assistant h2,
.bubble-assistant h3 {
  margin-top: 0;
}

.bubble-assistant p,
.bubble-assistant li {
}

.thinking {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

/* The composer is a transparent holder: an optional status row, then one row of
   [mic/keyboard] [emoji] [pill: text | clip | camera] [send]. The pill carries the card look (colors-*.rcss). */
.prompt-composer {
  flex-shrink: 0;
  box-sizing: border-box;
  margin: 0 8dp 8dp 8dp;
  padding: 0;
}

.prompt-composer-status {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  margin: 0 4dp 6dp 4dp;
}

.prompt-composer-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 4dp;
}

/* Half of one line's height (40dp) for the radius; the buttons stay at the bottom while the text grows to 5 lines. */
.prompt-composer-pill {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  min-height: 40dp;
  padding: 0 4dp 0 14dp;
  border-radius: 20dp;
}

.prompt-composer-input {
  flex: 1;
  min-width: 0;
  width: auto;
  min-height: 24dp;
  margin: 0;
  padding: 8dp 0;
  border: 0;
  background-color: transparent;
  cursor: text;
}

/* Without a sized scrollbar, text past the visible rows scrolls away with no hint. */
.prompt-composer-input scrollbarvertical {
  width: 6dp;
}

.prompt-composer-input scrollbarvertical sliderbar {
  width: 6dp;
  min-height: 16dp;
  border-radius: 3dp;
}

.prompt-emoji-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  background-color: transparent;
  cursor: pointer;
}

.prompt-emoji-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

.prompt-voice-toggle-btn,
.prompt-attach-btn,
.prompt-capture-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  background-color: transparent;
  cursor: pointer;
}

.prompt-voice-toggle-btn svg,
.prompt-attach-btn svg,
.prompt-capture-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

/* The phone's microphone at the row's end and Home's camera (the phone rules below show them); hidden elsewhere. */
.prompt-voice-toggle-btn--end,
.prompt-capture-btn--home {
  display: none;
}

/* Reply / Ask AI in progress: the quoted message, one line, above the composer box. */
.prompt-quote {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8dp;
  margin: 0 12dp 6dp 12dp;
  padding: 6dp 10dp;
  border-left: 3dp #818cf8;
  border-radius: 6dp;
  background-color: rgba(128, 128, 128, 0.14);
}

.prompt-quote-text {
  flex: 1;
  min-width: 0;
  display: block;
  max-height: 36dp; /* two lines */
  overflow: hidden;
  word-break: break-word;
  font-size: 13dp;
  line-height: 18dp;
  opacity: 0.8;
}

.prompt-attachment-chip {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8dp;
  padding: 4dp 10dp;
  border-radius: 12dp;
  background-color: rgba(255, 255, 255, 0.08);
}

.prompt-attachment-chip-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  font-size: 12dp;
}

.prompt-attachment-chip-action {
  flex-shrink: 0;
  font-size: 11dp;
  padding: 2dp 8dp;
  border-radius: 8dp;
  background-color: rgba(255, 255, 255, 0.12);
}

.prompt-attachment-chip-status {
  flex-shrink: 0;
  font-size: 11dp;
  opacity: 0.72;
}

/* The AI picture in the composer: a small thumbnail with a remove badge overlapping its top-right corner
   (a dark disc with a white ring and a white cross: visible on any picture and on both themes). */
.prompt-image-thumb-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  padding-top: 8dp;
}

.prompt-image-thumb {
  display: block;
  height: 32dp;
  width: auto;
  max-width: 56dp;
  border-radius: 6dp;
}

.prompt-image-thumb-placeholder {
  width: 32dp;
  height: 32dp;
  border-radius: 6dp;
  background-color: rgba(128, 128, 128, 0.35);
}

.prompt-image-remove-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20dp;
  height: 20dp;
  margin-left: -10dp;
  margin-top: -8dp;
  border-width: 2dp;
  border-color: #ffffff;
  border-radius: 12dp; /* 20dp box + 2dp border each side: a round badge */
  background-color: #111827;
  cursor: pointer;
}

.prompt-image-remove-badge svg {
  flex-shrink: 0;
  width: 8dp;
  height: 8dp;
  image-color: #ffffff;
}

.prompt-attachment-chip-remove {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20dp;
  height: 20dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 10dp;
  background-color: transparent;
  cursor: pointer;
}

.prompt-attachment-chip-remove svg {
  flex-shrink: 0;
  width: 10dp;
  height: 10dp;
}

.prompt-send-btn,
.prompt-stop-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.prompt-send-btn svg,
.prompt-stop-btn svg {
  flex-shrink: 0;
  width: 14dp;
  height: 14dp;
}

/* A 32dp button beside the 40dp one-line pill: 4dp under it centres it on the first line, and it stays there while
   the text grows. */
.prompt-composer-row .prompt-voice-toggle-btn,
.prompt-composer-row .prompt-emoji-btn,
.prompt-composer-row .prompt-send-btn,
.prompt-composer-pill .prompt-attach-btn,
.prompt-composer-pill .prompt-capture-btn {
  margin-bottom: 4dp;
}

/* Voice mode: the "hold to talk" bar takes the text input's place; grey while a call has the microphone, red while recording. */
.prompt-voice-bar {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40dp;
  margin: 0;
  padding: 0 14dp;
  border: 0;
  border-radius: 20dp;
  font-family: LatoLatin;
  font-size: 15dp;
  cursor: pointer;
}

.prompt-voice-bar--blocked {
  opacity: 0.5;
}

.prompt-voice-cancel-btn {
  flex-shrink: 0;
  margin-right: 4dp;
  margin-bottom: 4dp;
  padding: 6dp 12dp;
  border: 0;
  border-radius: 16dp;
  font-size: 13dp;
  background-color: rgba(128, 128, 128, 0.2);
  cursor: pointer;
}

/* Inside the voice bar while recording (red bar): everything reads white on it. */
.prompt-voice-status {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8dp;
  padding: 0 6dp;
}

.prompt-voice-bar .prompt-voice-dot {
  background-color: #ffffff;
}

.prompt-voice-bar .prompt-voice-timer--countdown,
.prompt-voice-bar .prompt-voice-hint--cancel {
  color: #ffffff;
}

.prompt-voice-dot {
  flex-shrink: 0;
  width: 10dp;
  height: 10dp;
  border-radius: 5dp;
  background-color: #ef4444;
}

.prompt-voice-timer {
  flex-shrink: 0;
  font-size: 14dp;
}

.prompt-voice-timer--countdown {
  color: #ef4444;
}

.prompt-voice-hint {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  font-size: 12dp;
  opacity: 0.72;
}

.prompt-voice-hint--cancel {
  color: #ef4444;
  opacity: 1;
}

.chat-link {
  text-decoration: underline;
  cursor: pointer;
}

/* A mention / @everyone in a group message (group-chat G015): a tinted chip, bold; a member's opens them. */
.chat-mention {
  font-weight: bold;
  cursor: pointer;
  padding: 0 3dp;
  border-radius: 4dp;
}

.chat-mention--everyone {
  cursor: auto;
}

.inline-code {
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 1dp 4dp;
  border-radius: 4dp;
}

.bubble-assistant strong {
  font-weight: bold;
}

.code-block {
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  margin-top: 4dp;
  margin-bottom: 8dp;
  white-space: pre-wrap;
}

/* A link-style action at the end of a list item's text (article feed "view details").
   The text is 12dp; the vertical padding makes the tap target 44dp without changing the line (inline
   padding does not add line height). focus: none keeps the draft textarea focused, like chat buttons. */
.chat-inline-link {
  display: inline;
  width: auto;
  height: auto;
  min-height: 0;
  margin: 0 0 0 4dp;
  padding: 16dp 8dp;
  border: 0;
  background-color: transparent;
  font-family: LatoLatin;
  font-size: 12dp;
  cursor: pointer;
  focus: none;
}

.chat-suggestion {
  display: inline-block;
  width: auto;
  font-family: LatoLatin;
  font-size: 13dp;
  height: 44dp;
  min-height: 44dp;
  padding: 0 16dp;
  line-height: 44dp;
  margin-right: 8dp;
  margin-bottom: 4dp;
  border: 0;
  border-radius: 999dp;
  cursor: pointer;
  box-sizing: border-box;
  text-align: center;
  focus: none;
}

.suggestion-row .chat-suggestion {
  margin-top: 0;
}

.bubble-assistant .chat-suggestion {
  margin-top: 8dp;
}

.chat-form {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.chat-form-label {
  display: block;
  margin-bottom: 8dp;
}

.chat-form-field {
  display: block;
  width: 100%;
  margin-top: 4dp;
  margin-bottom: 0;
  box-sizing: border-box;
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
}

.chat-form-submit {
  display: inline-block;
  width: auto;
  margin-top: 8dp;
  padding: 8dp 16dp;
  border-radius: 8dp;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.chat-form-expired {
  opacity: 0.85;
}

.chat-form-expired .chat-form-field,
.chat-form-expired .chat-form-submit {
  pointer-events: none;
  opacity: 0.6;
}

.chat-form-expired .chat-form-submit {
  display: none;
}

.chat-form-expired-label {
  margin-top: 0;
  margin-bottom: 8dp;
}

.chat-card {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.chat-table {
  width: 100%;
  margin-top: 12dp;
}

.chat-table th,
.chat-table td {
  padding: 6dp 8dp;
  text-align: left;
}

.chat-key-value {
  display: block;
  margin-top: 12dp;
}

.chat-key-value-row {
  display: flex;
  justify-content: space-between;
  gap: 12dp;
  padding: 4dp 0;
}

.chat-callout {
  display: block;
  margin-top: 12dp;
  padding: 10dp 12dp;
  border-radius: 8dp;
}

.chat-quote {
  display: block;
  margin-top: 12dp;
  padding-left: 12dp;
}

.chat-action-list,
.chat-long-list,
.chat-choice,
.chat-poll {
  display: block;
  margin-top: 12dp;
}

.chat-long-list-scroll {
  max-height: 240dp;
  overflow-y: auto;
  padding: 8dp;
  margin-top: 8dp;
  border-radius: 6dp;
  box-sizing: border-box;
}

.chat-long-list-item {
  display: block;
  margin-bottom: 12dp;
  padding-bottom: 10dp;
}

.chat-long-list-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
}

.chat-long-list-item-row {
  align-items: flex-start;
  gap: 10dp;
}

.chat-long-list-avatar {
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-long-list-avatar .avatar-letter {
  font-size: 14dp;
  color: #ffffff;
}

.chat-long-list-item-body {
  display: block;
  flex-grow: 1;
  min-width: 0;
}

.chat-long-list-title {
  margin-bottom: 4dp;
}

.chat-long-list-subtitle,
.chat-long-list-meta {
  margin-bottom: 4dp;
  font-size: 13dp;
}

/* Meta row: host (one line, cut with an ellipsis when the row is narrow) · time (never cut), and the
   item's text link pinned to the right so it never moves with the text above. */
.chat-long-list-meta-row {
  align-items: baseline;
  margin-bottom: 4dp;
}

.chat-long-list-meta-row .chat-long-list-meta {
  flex: 1 1 auto;
  min-width: 0;
  margin-bottom: 0;
  font-size: 12dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-long-list-meta-row .chat-long-list-meta-end {
  flex: 0 0 auto;
  margin-bottom: 0;
  font-size: 12dp;
  white-space: nowrap;
}

.chat-long-list-meta-row .chat-inline-link {
  flex: 0 0 auto;
  margin-left: auto;
  white-space: nowrap;
}

.chat-long-list-actions,
.chat-long-list-footer {
  gap: 8dp;
  flex-wrap: wrap;
  margin-top: 6dp;
}

.chat-suggestion-secondary {
  opacity: 0.92;
}

.chat-action-list-item {
  display: block;
  margin-bottom: 10dp;
}

.chat-action-list-actions,
.chat-choice-options,
.chat-poll-options {
  gap: 8dp;
  flex-wrap: wrap;
}

.chat-calendar {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.calendar-header {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8dp;
}

.calendar-nav {
  display: inline-block;
  padding: 6dp 12dp;
  border: 0;
  border-radius: 6dp;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.calendar-weekdays {
  justify-content: space-between;
  margin-bottom: 4dp;
}

.calendar-weekdays span {
  width: 14%;
  text-align: center;
}

.calendar-grid {
  width: 100%;
}

.calendar-cell {
  width: 14%;
  text-align: center;
  padding: 2dp;
  vertical-align: middle;
}

.calendar-day {
  display: inline-block;
  width: 100%;
  min-height: 28dp;
  padding: 4dp 0;
  border-radius: 6dp;
  border: 0;
  text-align: center;
  box-sizing: border-box;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.calendar-day-muted {
  display: inline-block;
  width: 100%;
  min-height: 28dp;
  padding: 4dp 0;
  border-radius: 6dp;
  text-align: center;
  box-sizing: border-box;
  background-color: transparent;
  cursor: default;
}

.shell-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  /* Corner rounding is macOS-native (CALayer), not RCSS — see WINDOW_SHELL.md. */
}

/* Desktop borderless window: draw a 1dp frame so the OS chrome is not missed.
   Hidden while maximized (edge-to-edge). */
.shell-body--framed {
  border-width: 1dp;
}

.shell-titlebar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 120;
  height: 36dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  border-bottom-width: 1dp;
}

.shell-titlebar-drag {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-left: 12dp;
  padding-right: 8dp;
  box-sizing: border-box;
}

.shell-titlebar-title {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  font-family: LatoLatin;
  font-size: 13dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
}

.shell-titlebar-controls {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  height: 100%;
}

.shell-titlebar-controls--traffic {
  align-items: center;
  padding-left: 8dp;
  padding-right: 8dp;
  gap: 8dp;
  box-sizing: border-box;
}

.shell-titlebar-btn {
  width: 40dp;
  min-width: 40dp;
  height: 100%;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.shell-titlebar-btn svg {
  flex-shrink: 0;
  width: 12dp;
  height: 12dp;
}

.shell-titlebar-btn--traffic {
  width: 12dp;
  min-width: 12dp;
  height: 12dp;
  min-height: 12dp;
  border-radius: 0;
  padding: 0;
}

.shell-titlebar-traffic-dot {
  width: 12dp;
  height: 12dp;
  min-width: 12dp;
  min-height: 12dp;
  border-radius: 6dp;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.shell-titlebar-btn--traffic svg {
  width: 6dp;
  height: 6dp;
  opacity: 0;
}

.shell-titlebar-btn--traffic:hover svg {
  opacity: 1;
}

.shell-chrome {
  position: relative;
  z-index: 100;
  /* Banner/toasts sit above content; the chrome box itself must not steal taps. */
  pointer-events: none;
}

.shell-chrome .shell-banner,
.shell-chrome .shell-toast,
.shell-chrome .shell-banner-dismiss {
  pointer-events: auto;
}

.shell-root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

/* Sibling of #shell-root — holds the mobile/compact emoji keyboard panel. */
.shell-emoji-keyboard-mount {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  pointer-events: none;
}

/* Phone AI dot (DESIGN-pp-ui §8.14; ShellAiDot places it with left / top). Sibling of #shell-root so a shell
   remount keeps it. The mount lets every tap through; the dot takes its own. z-index 40: over the pages (chat page 25,
   pushed page 30), under the call bar (45), the startup cover (48), sheets, panels and dialogs (50), menus (52), the
   call ring (53), the PIN gate (55) and the toasts (110, in #shell-chrome). It also hides itself for most of those. */
.shell-ai-dot-mount {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  pointer-events: none;
}

.ai-dot {
  display: none;
  position: absolute;
  left: 0dp;
  top: 0dp;
  width: 56dp;
  height: 56dp;
  pointer-events: auto;
}

.ai-dot--shown {
  display: block;
}

/* Sways from near its feet. The layers (body with its baked-in shadow, back eyes, front eyes) share one square
   viewBox with 4dp of room round the 56dp mascot for the shadow, so they are drawn 64dp wide at -4dp. The shadow is in
   the SVG (rasterized once), not an RCSS filter: a filter renders an extra layer every frame the dot is drawn. */
.ai-dot-figure {
  position: absolute;
  top: 0;
  left: 0;
  width: 56dp;
  height: 56dp;
  transform-origin: 50% 85%;
}

.ai-dot-layer {
  position: absolute;
  top: -4dp;
  left: -4dp;
  width: 64dp;
  height: 64dp;
}

/* Each pair of eyes blinks about its own row (front y 540, back y 296 of the -24–1004 viewBox). */
.ai-dot-eyes-front {
  transform-origin: 50% 55%;
}

.ai-dot-eyes-back {
  transform-origin: 50% 31%;
}

/* Idle moves (AiDotModel::kSwayMs / kBlinkMs): one run each, started and ended by a class; between them nothing
   animates, so the app draws nothing for the dot. C and D move about a third as much (DESIGN-pp-ui §8.14). */
@keyframes ai-dot-sway {
  0% { transform: rotate(0deg); }
  20% { transform: rotate(-9deg); }
  45% { transform: rotate(7deg); }
  70% { transform: rotate(-4deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-sway-calm {
  0% { transform: rotate(0deg); }
  25% { transform: rotate(-3deg); }
  60% { transform: rotate(2deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-blink {
  0% { transform: scaleY(1); }
  35% { transform: scaleY(0.1); }
  70% { transform: scaleY(1); }
  100% { transform: scaleY(1); }
}

.ai-dot--sway .ai-dot-figure {
  animation: 1.2s sine-in-out ai-dot-sway;
}

.ai-dot--calm.ai-dot--sway .ai-dot-figure {
  animation: 1.2s sine-in-out ai-dot-sway-calm;
}

.ai-dot--blink .ai-dot-eyes-front,
.ai-dot--blink .ai-dot-eyes-back {
  animation: 0.5s quadratic-in-out ai-dot-blink;
}

.shell-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  padding: 8dp 12dp;
}

.shell-banner-text {
  flex: 1;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

.shell-banner-dismiss {
  width: auto;
  min-width: 32dp;
  padding: 4dp 10dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-toast-stack {
  position: absolute;
  top: 8dp;
  right: 12dp;
  z-index: 110;
}

.shell-toast {
  padding: 10dp 14dp;
  margin-bottom: 8dp;
  border-radius: 8dp;
}

.shell-toast-text {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

/* Phone toast (Kenneth 2026-11-04: the dark slab top right looked stuck on): a centred pill near the bottom,
   above the tab bar / composer. The chrome box fills the body (it lets taps through) so ShellHost can set the
   stack's `bottom` (CompactChromeLayout::toast_bottom_dp); the pills let taps through too. */
.shell-body--compact .shell-chrome {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-body--compact .shell-toast-stack {
  left: 0;
  right: 0;
  display: block;
  text-align: center;
  pointer-events: none;
}

.shell-body--compact .shell-chrome .shell-toast {
  display: inline-block;
  max-width: 80%;
  border-width: 1dp;
  padding: 10dp 18dp;
  margin: 6dp 0 0 0;
  border-radius: 20dp;
  box-sizing: border-box;
  pointer-events: none;
}

.shell-body--compact .shell-toast-text {
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

.shell-activity-strip {
  height: 3dp;
  opacity: 0.85;
}

.shell-statusbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 24dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12dp;
  padding: 0 12dp;
  box-sizing: border-box;
  border-top-width: 1dp;
  border-top-style: solid;
  z-index: 50;
}

.shell-statusbar-cluster {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  min-width: 0;
  overflow: hidden;
  padding: 2dp 6dp;
  margin-left: -6dp;
  border-radius: 4dp;
  cursor: pointer;
}

.shell-statusbar-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  flex-shrink: 0;
  min-width: 0;
}

.shell-statusbar-divider {
  width: 1dp;
  height: 12dp;
  flex-shrink: 0;
}

.shell-statusbar-slot {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.shell-statusbar-brief svg,
.shell-statusbar-direct svg,
.shell-statusbar-help svg,
.shell-statusbar-inbound svg {
  width: 12dp;
  height: 12dp;
}

.shell-statusbar-label,
.shell-statusbar-load {
  margin-top: 0;
  margin-bottom: 0;
  white-space: nowrap;
  overflow: hidden;
}

.shell-statusbar-label {
  margin-left: 0;
}

.shell-statusbar-load {
  flex-shrink: 0;
}

.shell-statusbar-popover-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 54;
}

.shell-statusbar-popover {
  position: absolute;
  left: 8dp;
  bottom: 32dp;
  width: 320dp;
  max-width: 90%;
  padding: 12dp;
  gap: 8dp;
  box-sizing: border-box;
  border-width: 1dp;
  border-radius: 8dp;
  z-index: 55;
}

.shell-statusbar-popover-title {
  margin-top: 0;
  margin-bottom: 4dp;
  font-weight: bold;
}

.shell-statusbar-popover-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12dp;
}

.shell-statusbar-popover-key {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  min-width: 0;
  flex-shrink: 1;
}

.shell-statusbar-popover-row p {
  margin-top: 0;
  margin-bottom: 0;
}

.shell-statusbar-popover-actions {
  margin-top: 4dp;
  gap: 8dp;
  flex-wrap: wrap;
}

.shell-statusbar-popover-actions .btn {
  flex-grow: 1;
  min-height: 36dp;
}

.shell-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-pane-row {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.shell-nav-rail {
  flex: 0 0 72dp;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.shell-nav-rail--compact {
  flex: 0 0 auto;
  flex-direction: row;
  width: 100%;
  height: 49dp;
  box-sizing: border-box;
  background-color: transparent;
}

.shell-nav-rail-inner {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: flex-start;
  gap: 0;
  padding: 8dp 4dp;
  box-sizing: border-box;
}

/* Phone tab bar: four equal-width tabs, no pills. */
.shell-nav-rail--compact .shell-nav-rail-inner {
  flex-direction: row;
  justify-content: space-between;
  align-items: stretch;
  height: 49dp;
  padding: 0;
}

.shell-nav-spacer {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
}

.shell-nav-rail--compact .shell-nav-spacer {
  display: none;
}

.shell-nav-tab {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2dp;
  width: 52dp;
  height: 56dp;
  min-width: 52dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 10dp;
  cursor: pointer;
  focus: none;
}

.shell-nav-rail--compact .shell-nav-tab {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  height: 49dp;
  border-radius: 0;
  gap: 2dp;
}

.shell-nav-tab svg {
  flex-shrink: 0;
}

/* 24dp tab icons (§8.2): size in dp so the layout box matches the drawn icon on every density. */
.shell-nav-rail--compact .shell-nav-tab svg {
  width: 24dp;
  height: 24dp;
}

/* Collapse / expand the list pane; sits at the bottom of the expanded rail. */
.shell-nav-collapse {
  height: 28dp;
}

.shell-nav-tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.shell-nav-tab-label {
  margin: 0;
  padding: 0;
  font-size: 10dp;
  text-align: center;
  line-height: 1.1;
}

/* caption-2 */
.shell-nav-rail--compact .shell-nav-tab-label {
  font-size: 11dp;
  line-height: 13dp;
}

.shell-nav-page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: 49dp;
}

.shell-nav-page .shell-pane-body {
  height: 100%;
}

.shell-nav-page--home .shell-pane-body {
  flex: 1;
  min-height: 0;
  height: auto;
}

/* Root-page nav bar + large title (DESIGN-pp-ui 4.1 / 8.1). Phone layout only: on desktop the panes keep their own
   headers and these parts stay hidden. The nav bar floats over the scroller (padding-top clears it), its background
   and bottom separator fade in once the large title has scrolled away (.large-title-collapsed on the nav page). */
.pane-nav,
.large-title {
  display: none;
}

.shell-layer-compact .sidebar-header,
.shell-layer-compact .settings-header,
.shell-layer-compact .contacts-header {
  display: none;
}

.shell-layer-compact .sidebar-panel,
.shell-layer-compact .contacts-panel,
.shell-layer-compact .settings-panel,
.shell-layer-compact .home-panel {
  position: relative;
  padding-top: 0;
}

.shell-layer-compact .pane-nav {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 44dp;
  z-index: 3;
}

.pane-nav-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 44dp;
  box-sizing: border-box;
  opacity: 0;
  transition: opacity 0.2s cubic-out;
}

.shell-nav-page.large-title-collapsed .pane-nav-bg {
  opacity: 1;
}

.pane-nav-title {
  position: absolute;
  top: 0;
  left: 96dp;
  right: 96dp;
  height: 44dp;
  margin: 0;
  font-size: 17dp;
  line-height: 44dp;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  opacity: 0;
  transition: opacity 0.2s cubic-out;
}

.shell-nav-page.large-title-collapsed .pane-nav-title {
  opacity: 1;
}

.pane-nav-actions {
  position: absolute;
  top: 0;
  right: 0;
  height: 44dp;
  align-items: center;
}

/* Wraps a button whose event lives in the window model (e.g. Scan QR on Contacts). */
.pane-nav-btn-wrap {
  display: flex;
}

.pane-nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
}

.pane-nav-btn svg {
  width: 24dp;
  height: 24dp;
}

.shell-layer-compact .large-title {
  display: block;
  flex-shrink: 0;
  height: 52dp;
  margin: 0;
  padding: 0 4dp;
  font-size: 34dp;
  line-height: 41dp;
  font-weight: bold;
}

/* The whole page scrolls (large title, search, rows), not just its list. */
.shell-layer-compact .sidebar-sessions,
.shell-layer-compact .contacts-list-view,
.shell-layer-compact .settings-list-view {
  overflow-y: auto;
  padding-top: 44dp;
  box-sizing: border-box;
}

.shell-layer-compact .contacts-list-view,
.shell-layer-compact .settings-list-view {
  display: block;
}

.shell-layer-compact .contacts-list,
.shell-layer-compact .settings-list {
  flex: none;
  overflow-y: visible;
}

.shell-pane-home {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.shell-pane-home .shell-pane-body {
  flex: 1;
  min-height: 0;
  height: auto;
}

/* Page push / back (DESIGN-pp-ui §7): 0.3s ease-out slide from / to the right. ShellHost adds
   .shell-page-enter once after the page is built; the swipe gesture and BeginAnimatedDismiss set an inline
   transform and the transition below runs it. Dragging turns the transition off so the page follows the finger. */
@keyframes shell-page-in {
  from { transform: translateX(100%); }
  to { transform: translateX(0%); }
}

.shell-page-enter {
  animation: 0.3s cubic-out shell-page-in;
}

.shell-chat-overlay,
.shell-layer-transient,
.settings-detail-view {
  transition: transform 0.3s cubic-out;
}

.shell-chat-overlay.shell-swipe-dragging,
.shell-layer-transient.shell-swipe-dragging,
.settings-detail-view.shell-swipe-dragging {
  transition: none;
}

.shell-chat-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateX(0);
}

.shell-chat-overlay.shell-swipe-dragging,
.shell-chat-overlay--dragging {
}

/* Phone chat: ONE 44dp nav bar (DESIGN-pp-ui 8.1). This row is the bar's material and the back button;
   the chat pane's own header row is lifted onto it, right of the button (see .chat-header below). */
.shell-chat-overlay-chrome {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  flex-shrink: 0;
  align-items: center;
  height: 44dp;
  padding: 0;
  box-sizing: border-box;
}

.shell-chat-overlay-chrome .shell-back-btn,
.shell-layer-compact .shell-transient-chrome .shell-back-btn {
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  border-radius: 0;
}

.shell-chat-overlay .shell-pane-body {
  flex: 1;
  min-height: 0;
  padding-top: 44dp;
  box-sizing: border-box;
}

.shell-chat-overlay .chat-panel {
  padding-top: 0;
}

.shell-chat-overlay .chat-header {
  position: relative;
  z-index: 3;
  height: 43dp;
  margin: -44dp -12dp 8dp 32dp;
  padding: 0 8dp 0 0;
  border-radius: 0;
  border-left-width: 0;
  overflow: hidden;
}

.shell-chat-overlay .chat-header-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
}

.shell-chat-overlay .chat-header-text {
  flex: 1;
  min-width: 0;
}

.shell-chat-overlay .chat-header-type-icon {
  display: none;
}

.shell-chat-overlay .chat-header-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
  overflow: hidden;
}

.shell-chat-overlay .chat-header-avatar .avatar-photo {
  width: 36dp;
  height: 36dp;
}

.shell-chat-overlay .chat-header-avatar .chat-row-avatar-letter {
  font-size: 16dp;
  line-height: 20dp;
}

.shell-chat-overlay .chat-header-avatar .chat-row-avatar-icon {
  width: 20dp;
  height: 20dp;
}

.shell-chat-overlay .chat-header-title {
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Phones: no encryption / link-path line; a group shows only its member count. */
.shell-chat-overlay .chat-header-meta-row {
  display: none;
}

.shell-chat-overlay .chat-header-phone-subtitle {
  display: block;
  margin: 0;
  font-size: 12dp;
  line-height: 15dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-chat-overlay .chat-header-subtitle {
  font-size: 13dp;
  line-height: 16dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-chat-overlay .chat-header-actions {
  gap: 0;
}

.shell-chat-overlay .chat-header-call-btn,
.shell-chat-overlay .chat-header-more-btn {
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  border-radius: 0;
}

.shell-chat-overlay .chat-header-call-btn--join {
  width: auto;
  height: 32dp;
  min-width: 0;
  border-radius: 16dp;
}

.chat-header-avatar,
.chat-header-phone-subtitle {
  display: none;
}

/* Phones: a group call goes on here (DEV/PLAN-ui-batch8-group-pages.md 4). A 44dp bar under the header: a dot, what
   call it is, and the header's own green "Join" pill inside a 44dp target. */
.chat-call-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  height: 44dp;
  padding: 0 8dp 0 16dp;
  box-sizing: border-box;
}

.chat-call-bar-dot {
  flex-shrink: 0;
  width: 8dp;
  height: 8dp;
  border-radius: 4dp;
}

.chat-call-bar-text {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-call-bar-join {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  cursor: pointer;
}

.shell-chat-overlay .shell-composer-mount {
  flex-shrink: 0;
}

.shell-pane {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

/* May shrink (down to its minimum) so a wide list never squeezes the primary pane to nothing. */
.shell-pane-secondary {
  flex: 0 1 240dp;
  min-width: 200dp;
}

/* Width is overridden by the inline style from ShellHost (user-resizable); collapsed hides the pane. */
.shell-pane-secondary--collapsed {
  display: none;
}

/* Drag handle between secondary and primary: 6dp hit area straddling the pane border, zero layout width. */
.shell-splitter {
  position: relative;
  z-index: 3;
  flex: 0 0 6dp;
  width: 6dp;
  height: 100%;
  margin: 0 -3dp;
  cursor: ew-resize;
}

/* The floor makes the shrinkable list / auxiliary panes absorb a narrow window instead of the chat pane. */
.shell-pane-primary {
  flex: 1;
  min-width: 240dp;
}

.shell-pane-auxiliary {
  flex: 0 1 320dp;
  min-width: 280dp;
}

.shell-layer-compact {
  display: flex;
  flex-direction: column;
}

.shell-pane-primary-compact {
  flex: 1;
  min-height: 0;
}

.shell-pane-composer {
  flex-shrink: 0;
}

.shell-bottom-chrome {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  z-index: 15;
  box-sizing: border-box;
}

.shell-composer-mount {
  flex-shrink: 0;
}

.shell-composer-mount .prompt-composer {
  margin-bottom: 8dp;
}

.shell-composer-mount.surface-chrome {
  padding-top: 8dp;
  box-sizing: border-box;
}

.shell-composer-mount.surface-chrome .prompt-composer {
  margin-bottom: 8dp;
}

.shell-drawer .shell-pane,
.shell-sheet .shell-pane {
  height: 100%;
}

.shell-sheet-compact {
  border-radius: 16dp 0 0 16dp;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.shell-sheet-compact-chrome {
  flex-shrink: 0;
  height: 8dp;
  box-sizing: border-box;
}

.shell-sheet-compact .shell-pane {
  flex: 1;
  min-height: 0;
}

.shell-pane-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.shell-drawer-scrim,
.shell-sheet-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* Must sit above .shell-chat-overlay (25) so compact working-set / Details sheet
     is visible while chat is open (WINDOW_SHELL interruption: aux > chat). */
  z-index: 26;
  focus: none;
}

.shell-drawer {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 280dp;
  max-width: 85%;
  z-index: 27;
}

.shell-sheet {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 320dp;
  max-width: 90%;
  z-index: 27;
}

.shell-toolbar {
  flex-shrink: 0;
  height: 48dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 8dp;
  box-sizing: border-box;
}

.shell-toolbar-flex {
  flex: 1;
}

.shell-toolbar-title {
  font-size: 14dp;
  text-align: center;
}

.shell-transient-chrome {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  flex-shrink: 0;
  min-height: 48dp;
  padding: 4dp 4dp;
  box-sizing: border-box;
}

.shell-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  padding: 0;
  margin-bottom: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-back-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

/* Phone contact page: a 48dp title bar (the pane starts 48dp down), back arrow left, centred title. */
.shell-layer-compact .shell-transient-chrome--titled {
  min-height: 48dp;
  height: 48dp;
  padding: 2dp 0;
}

.shell-transient-title {
  position: absolute;
  margin: 0;
  top: 0;
  left: 52dp;
  right: 52dp;
  height: 48dp;
  line-height: 48dp;
  font-size: 17dp;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  pointer-events: none;
}

.shell-layer-transient {
  display: flex;
  flex-direction: column;
  /* Above account sheet (29) / chat overlay (25); below context menu (40) and call chrome (45).
     Matches WINDOW_SHELL interruption: transient > account > aux > chat. */
  z-index: 30;
  transform: translateX(0);
}

.shell-layer-transient.shell-swipe-dragging {
}

.shell-layer-transient .shell-pane-transient {
  flex: 1;
  min-height: 0;
  padding-top: 48dp;
  box-sizing: border-box;
}

.shell-layer-overlay,
.shell-layer-dialog {
  z-index: 50;
}

/* Dialog / PIN: empty mounts must not steal hits; children re-enable pointer-events. */
.shell-overlay-chrome-mount {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.shell-overlay-chrome-mount--dialog {
  z-index: 50;
}

.shell-overlay-chrome-mount--photo {
  z-index: 56;
}

/* Picture preview (tap on a picture): the bubble's picture fitted to the screen, a spinner over it. */
.photo-preview {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: auto;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-preview-image {
  display: block;
  max-width: 100%;
  max-height: 100%;
}

@keyframes photo-preview-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.photo-preview-spinner {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 28dp;
  height: 28dp;
  margin-top: -17dp;
  margin-left: -17dp;
  border-width: 3dp;
  border-style: solid;
  border-radius: 17dp;
  animation: 0.9s linear infinite photo-preview-spin;
}

.shell-overlay-chrome-mount--pin {
  z-index: 55;
}

/* Full-bleed brand cover while vault/messaging prepare (below PIN / titlebar). */
.shell-startup-cover {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 48;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  focus: none;
}

.shell-startup-cover-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12dp;
  padding: 24dp;
}

.shell-startup-cover-icon {
  width: 96dp;
  height: 96dp;
  flex-shrink: 0;
}

.shell-startup-cover-name {
  margin: 0;
  font-family: LatoLatin;
  font-size: 28dp;
  font-weight: bold;
  text-align: center;
}

.shell-startup-cover-status {
  margin: 0;
  text-align: center;
}

.shell-overlay-chrome-mount .shell-layer {
  pointer-events: auto;
}

/* Call chrome: empty mounts must not steal hits; children re-enable pointer-events. */
.shell-call-chrome-mount {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.shell-call-chrome-mount--bar {
  z-index: 45;
}

.shell-call-chrome-mount--ring {
  z-index: 53;  /* above context menus (52) so a menu scrim never eats the Accept tap; below the PIN gate (55) */
}

.shell-call-chrome-mount .shell-layer {
  pointer-events: auto;
}

.shell-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  focus: none;
}

.shell-frame {
  position: absolute;
  top: 24dp;
  left: 24dp;
  right: 24dp;
  bottom: 24dp;
  display: flex;
  flex-direction: column;
  padding: 16dp;
  /* Close button is 40dp at top: 8dp; keep content below it so overflow clip
     does not crop overlay footers (people picker Cancel / Message). */
  padding-top: 48dp;
  border-radius: 8dp;
  box-sizing: border-box;
  overflow: hidden;
  clip: always;
}

.shell-close-btn {
  position: absolute;
  top: 8dp;
  right: 8dp;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40dp;
  height: 40dp;
  min-width: 40dp;
  padding: 0;
  margin-bottom: 0;
  border: 0;
  border-radius: 20dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.shell-close-btn svg {
  flex-shrink: 0;
  width: 16dp;
  height: 16dp;
}

.shell-overlay-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: auto;
  clip: always;
}

/* Phone page sheet (iOS, Kenneth 2026-11-04: the centred new-group panel looked odd; then every sheet alike). It
   rises from the bottom to about 4/5 of the screen (--large), the page behind dimmed by the scrim, rounded top
   corners and a grab handle; it is dragged to full height (no class), down to half (--half) and a third (--small),
   and let go low it closes (ShellPageSheetGesture, PageSheetModel: keep the tops here and its constants the same). ShellHost pads the bottom
   by the home-indicator inset. */
@keyframes shell-page-sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0%); }
}

.shell-page-sheet {
  position: absolute;
  top: 10dp;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  padding: 16dp 16dp 0 16dp;
  border-radius: 12dp 12dp 0 0;
  box-sizing: border-box;
  overflow: hidden;
  clip: always;
  transform: translateY(0);
  transition: transform 0.3s cubic-out, top 0.3s cubic-out;
}

.shell-page-sheet.shell-swipe-dragging {
  transition: none;
}

/* Where every sheet opens: a fifth of the page behind stays in sight above it. */
.shell-page-sheet.shell-page-sheet--large {
  top: 20%;
}

/* At half: its top at 45% of the screen, the page behind it dimmed less, so what the user was doing stays in sight. */
.shell-page-sheet.shell-page-sheet--half {
  top: 45%;
}

.shell-layer-sheet--half .shell-scrim {
  opacity: 0.5;
}

/* At small: about a third of the screen (the title row and the top of the content), the page behind dimmed least. */
.shell-page-sheet.shell-page-sheet--small {
  top: 66%;
}

.shell-layer-sheet--small .shell-scrim {
  opacity: 0.25;
}

.shell-page-sheet-enter {
  animation: 0.3s cubic-out shell-page-sheet-in;
}

.shell-page-sheet-grabber {
  position: absolute;
  top: 6dp;
  left: 0;
  right: 0;
  width: 36dp;
  height: 5dp;
  margin: 0 auto;
  border-radius: 2.5dp;
}

/* One title row for every sheet (Kenneth 2026-11-04): 44dp under the grab handle, the title centred (17dp bold), the
   sheet's X at its right end. Each view marks its row .sheet-header and its title .sheet-title; the row keeps clear
   of the X on both sides so the title stays centred (the people picker's sheet keeps its 16dp side padding, so its row
   needs 16dp less). */
.shell-page-sheet .sheet-header {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 44dp;
  margin: 0;
  padding: 0 52dp;
  box-sizing: border-box;
}

.shell-page-sheet--people_picker .sheet-header {
  padding: 0 36dp;
}

/* A second button left of the X (ask-AI's "Open in AI chat"): the row keeps clear of both. */
.shell-page-sheet .sheet-header.sheet-header--two-buttons {
  padding: 0 96dp;
}

.shell-page-sheet .sheet-header .sheet-title {
  display: block;
  flex: 1;
  min-width: 0;
  height: 44dp;
  margin: 0;
  padding: 0;
  font-size: 17dp;
  line-height: 44dp;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
}

/* The header's buttons (iOS): a 44dp target around a quiet 30dp grey disc holding a small secondary-colour icon. The
   X is the sheet's own (ShellLayoutRml), top right on the title row. */
.shell-page-sheet .shell-page-sheet-close {
  top: 16dp;
  right: 4dp;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  border-radius: 22dp;
}

.shell-page-sheet .sheet-icon-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30dp;
  height: 30dp;
  border-radius: 15dp;
}

.shell-page-sheet .shell-page-sheet-close svg {
  width: 12dp;
  height: 12dp;
}

.shell-page-sheet .people-picker-row {
  min-height: 50dp;
  box-sizing: border-box;
}

.shell-page-sheet .people-picker-row-title {
  font-size: 17dp;
  font-weight: normal;
}

.shell-page-sheet .people-picker-check {
  width: 24dp;
  height: 24dp;
  border-radius: 12dp;
  border-width: 2dp;
  box-sizing: border-box;
}

.shell-page-sheet .people-picker-check-mark {
  display: none;
}

.shell-page-sheet .people-picker-row--selected .people-picker-check {
  decorator: svg(../icons/v2/check.svg);
}

/* The page behind is dimmed up through the status bar, as iOS does. */
.shell-layer-sheet .shell-scrim {
  top: -100dp;
}

/* The engine draws no placeholder: a hint sits over the empty search field (sheet only; desktop unchanged). */
.people-picker-search-hint {
  display: none;
}

.shell-page-sheet .people-picker-search {
  position: relative;
}

.shell-page-sheet .people-picker-search-field {
  height: 36dp;
  min-height: 36dp;
  padding: 7dp 12dp;
  border-width: 0;
  border-radius: 10dp;
  font-size: 17dp;
  /* A 22dp line between 7dp paddings: text and a line-tall caret sit in the middle (a 36dp line drew a full-height caret). */
  line-height: 22dp;
}

.shell-page-sheet .people-picker-search-hint {
  display: block;
  position: absolute;
  left: 12dp;
  top: 0;
  height: 36dp;
  font-size: 17dp;
  line-height: 36dp;
  white-space: nowrap;
  pointer-events: none;
}

.shell-page-sheet .people-picker-footer-actions {
  gap: 12dp;
}

.shell-page-sheet .people-picker-footer .btn {
  flex: 1;
  height: 50dp;
  min-height: 50dp;
  line-height: 50dp;
  padding: 0 20dp;
  font-size: 17dp;
}

/* The ask-AI panel (DEV/PLAN-ui-batch5-ask-ai.md 5a, design §8.14) in its sheet: the sheet's title row (an "Open in AI
   chat" icon left of the X), one line on what goes to the AI, the bubbles, the input row and the reminder under it. */
.shell-page-sheet.shell-page-sheet--ask_ai {
  padding-left: 0;
  padding-right: 0;
}

.ask-ai {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* Left of the sheet's X (right 4dp, 44dp wide): the same 44dp target and grey disc. */
.ask-ai-open-chat {
  position: absolute;
  top: 0;
  right: 48dp;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
}

.ask-ai-open-chat svg {
  width: 14dp;
  height: 14dp;
}

.ask-ai-privacy {
  flex-shrink: 0;
  margin: 0 16dp 6dp 16dp;
  font-size: 13dp;
  line-height: 18dp;
}

.ask-ai-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 8dp 16dp 8dp 16dp;
}

.ask-ai-intro {
  margin: 0 0 16dp 0;
  padding: 14dp 16dp 4dp 16dp;
  border-radius: 12dp;
}

.ask-ai-intro-body {
  margin: 0;
  font-size: 15dp;
  line-height: 21dp;
}

.ask-ai-intro-ok {
  display: block;
  width: 100%;
  height: 44dp;
  margin-top: 6dp;
  border: 0;
  font-size: 17dp;
  line-height: 44dp;
  font-weight: bold;
  text-align: center;
}

.ask-ai-section {
  margin: 0 0 10dp 0;
  font-size: 13dp;
  line-height: 18dp;
}

.ask-ai-empty {
  margin: 24dp 0;
  font-size: 15dp;
  line-height: 21dp;
  text-align: center;
}

.ask-ai .bubble-user,
.ask-ai .bubble-assistant {
  max-width: 88%;
}

/* The chat page's bubble tails are drawn for its own rows only. */
.ask-ai .bubble-tail {
  display: none;
}

.ask-ai-error {
  margin: 4dp 0 0 0;
  font-size: 15dp;
  line-height: 21dp;
}

.ask-ai-support {
  display: inline-block;
  height: 44dp;
  margin-top: 10dp;
  padding: 0 18dp;
  border: 0;
  border-radius: 22dp;
  font-size: 15dp;
  line-height: 44dp;
}

.ask-ai-input-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  flex-shrink: 0;
  padding: 8dp 16dp 0 16dp;
}

/* The picture waiting to be sent: a thumbnail and an X. */
.ask-ai-picture {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8dp 16dp 0 16dp;
}

.ask-ai-picture-box {
  width: 56dp;
  height: 56dp;
  border-radius: 10dp;
  overflow: hidden;
}

.ask-ai-picture-img {
  display: block;
  width: 56dp;
  height: 56dp;
  border-radius: 10dp;
}

.ask-ai-picture-note {
  margin: 0 0 0 12dp;
  font-size: 13dp;
}

.ask-ai-picture-remove {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0 0 0 4dp;
  padding: 0;
  border: 0;
  border-radius: 22dp;
}

.ask-ai-picture-remove svg {
  width: 14dp;
  height: 14dp;
}

.ask-ai-reminder {
  flex-shrink: 0;
  margin: 6dp 16dp 6dp 16dp;
  font-size: 12dp;
  line-height: 16dp;
  text-align: center;
}

/* Phones, Home: the ask-AI field opens the panel; a clear button over the pill takes the tap (hidden elsewhere). */
.prompt-ask-ai-catcher {
  display: none;
}

.shell-layer-compact .home-composer-mount .prompt-ask-ai-catcher {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 18dp;
}

/* New chat in a sheet (Kenneth 2026-11-04): the sheets' title row, the rows edge to edge (the rows pad themselves, so
   the sheet drops its side padding). */
.shell-page-sheet.shell-page-sheet--new_chat,
.shell-page-sheet.shell-page-sheet--group_info,
.shell-page-sheet.shell-page-sheet--group_leave,
.shell-page-sheet.shell-page-sheet--contact_detail {
  padding-left: 0;
  padding-right: 0;
}

.shell-dialog {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 90%;
  max-width: 360dp;
  margin-left: 0;
  margin-top: 0;
  transform: translate(-50%, -50%);
  padding: 20dp;
  border-radius: 8dp;
  box-sizing: border-box;
  z-index: 51;
}

.shell-dialog-title {
  margin-top: 0;
  font-size: 18dp;
}

.shell-dialog-message {
  display: block;
  margin-top: 0;
  margin-bottom: 8dp;
}

/* The prompt dialog's text field: a visible box (it was invisible against the dialog, Kenneth 2026-10-23). */
.shell-dialog-prompt {
  display: block;
  width: 100%;
  min-height: 40dp;
  margin: 4dp 0 12dp 0;
  padding: 8dp 12dp;
  border-width: 1dp;
  border-radius: 8dp;
  box-sizing: border-box;
  cursor: text;
}

.shell-call-meters {
  display: block;
  margin-top: 12dp;
  margin-bottom: 16dp;
}

.shell-call-meter {
  display: block;
  margin-bottom: 10dp;
}

.shell-call-meter--compact {
  margin-bottom: 0;
  margin-right: 12dp;
  min-width: 88dp;
}

.shell-call-meter-head {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4dp;
}

.shell-call-meter-label {
  font-size: 12dp;
  display: block;
  margin-bottom: 2dp;
}

.shell-call-meter-hint {
  font-size: 11dp;
  display: block;
  margin-top: 2dp;
}

.shell-call-meter-track {
  align-items: stretch;
  gap: 3dp;
  height: 8dp;
}

.shell-call-meter-seg {
  flex-grow: 1;
  height: 8dp;
  border-radius: 2dp;
}

/* Expanded bar: shrink-wrap chrome; pass through outside the visible bar/stage. */
.shell-call-chrome-mount .shell-layer-call-bar {
  bottom: auto;
  z-index: 45;
  pointer-events: none;
  display: flex;
  flex-direction: column;
}

.shell-layer-call-bar .shell-call-stage,
.shell-layer-call-bar .shell-call-bar {
  pointer-events: auto;
  cursor: pointer;
}

.shell-call-bar {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8dp;
  margin: 8dp 12dp;
  padding: 10dp 12dp;
  border-radius: 10dp;
  box-sizing: border-box;
}

.shell-call-bar-row {
  align-items: center;
  justify-content: space-between;
  gap: 8dp;
  width: 100%;
}

.shell-call-bar-main {
  flex-grow: 1;
  min-width: 0;
}

.shell-call-bar-title {
  margin: 0;
  font-size: 14dp;
  font-weight: bold;
}

.shell-call-bar-subtitle {
  margin: 2dp 0 0 0;
  font-size: 12dp;
}

.shell-call-bar-hint {
  margin: 4dp 0 0 0;
  max-width: 280dp;
}

.shell-call-debug-subtitle,
.shell-call-quality-hint {
  margin: 2dp 0 0 0;
  max-width: 280dp;
}

.shell-call-quality {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  height: 32dp;
  min-width: 0;
  padding: 0 8dp;
  border-width: 0;
  background-color: transparent;
  flex-shrink: 0;
}

.shell-call-quality--compact {
  height: 28dp;
  padding: 0 4dp;
}

.shell-call-quality-bars {
  align-items: flex-end;
  gap: 2dp;
  height: 12dp;
}

.shell-call-quality-bar {
  width: 3dp;
  border-radius: 1dp;
}

.shell-call-quality-bar--1 {
  height: 4dp;
}

.shell-call-quality-bar--2 {
  height: 7dp;
}

.shell-call-quality-bar--3 {
  height: 10dp;
}

.shell-call-quality-bar--4 {
  height: 12dp;
}

.shell-call-quality-label {
  margin: 0;
  white-space: nowrap;
}

.shell-call-bar-meters {
  align-items: flex-start;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 8dp 12dp;
  width: 100%;
}

.shell-call-bar-actions {
  align-items: center;
  gap: 8dp;
  flex-shrink: 0;
}

.shell-call-mute,
.shell-call-camera,
.shell-call-flip,
.shell-call-speaker,
.shell-call-leave,
.shell-call-invite,
.shell-call-retry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 22dp;
  cursor: pointer;
}

.shell-call-mute svg,
.shell-call-camera svg,
.shell-call-flip svg,
.shell-call-speaker svg,
.shell-call-leave svg,
.shell-call-invite svg,
.shell-call-retry svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

.shell-call-roster {
  flex-wrap: wrap;
  gap: 6dp;
  padding: 0 12dp 8dp 12dp;
  max-height: 72dp;
  overflow-y: auto;
}

.shell-call-roster-chip {
  align-items: center;
  gap: 4dp;
  padding: 4dp 8dp;
  border-radius: 999dp;
}

.shell-call-roster-name {
  margin: 0;
  max-width: 120dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shell-call-stage {
  margin: 8dp 12dp 0 12dp;
  height: 180dp;
  border-radius: 10dp;
  position: relative;
  overflow: hidden;
}

call-video-tile {
  display: block;
  box-sizing: border-box;
}

.shell-call-remote {
  width: 100%;
  height: 100%;
  border-radius: 10dp;
}

.shell-call-remote-placeholder {
  margin: 0;
  padding: 16dp;
  text-align: center;
}

.shell-call-pip {
  position: absolute;
  width: 72dp;
  height: 128dp;
  right: 10dp;
  bottom: 10dp;
  border-radius: 8dp;
  overflow: hidden;
}

.shell-call-leave {
  min-width: 44dp;
}

.shell-call-expand {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 22dp;
  cursor: pointer;
}

.shell-call-expand svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

.shell-call-chrome--dragging {
}

/* Minimized chip: mount layer must not steal hits; only the chip is interactive.
   More specific than `.shell-call-chrome-mount .shell-layer { pointer-events: auto }`. */
.shell-call-chrome-mount .shell-layer-call-minimized {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 45;
  pointer-events: none;
}

.shell-call-minimized-chip {
  position: absolute;
  pointer-events: auto;
  align-items: center;
  gap: 8dp;
  min-width: 160dp;
  max-width: 240dp;
  padding: 10dp 12dp;
  border-radius: 14dp;
  box-sizing: border-box;
  cursor: pointer;
}

.shell-call-minimized-chip--tr {
  top: 12dp;
  right: 12dp;
}

.shell-call-minimized-chip--tl {
  top: 12dp;
  left: 12dp;
}

.shell-call-minimized-chip--br {
  bottom: 72dp;
  right: 12dp;
}

.shell-call-minimized-chip--bl {
  bottom: 72dp;
  left: 12dp;
}

.shell-call-minimized-main {
  flex-grow: 1;
  min-width: 0;
}

.shell-call-minimized-title {
  margin: 0;
  font-size: 13dp;
  font-weight: bold;
}

.shell-call-minimized-subtitle {
  margin: 2dp 0 0 0;
  font-size: 11dp;
}

.shell-call-mute--compact,
.shell-call-leave--compact {
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  border-radius: 18dp;
}

/* Immersive: call is the primary surface (V031). */
.shell-layer-call-immersive {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 45;
  pointer-events: auto;
}

.shell-call-immersive {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 12dp 12dp 16dp 12dp;
}

.shell-call-immersive-header {
  flex-shrink: 0;
  padding-bottom: 8dp;
}

.shell-call-immersive-grabber {
  width: 36dp;
  height: 4dp;
  border-radius: 2dp;
  margin: 4dp auto 10dp auto;
}

.shell-call-immersive-roster {
  flex-grow: 1;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: 10dp;
  padding: 4dp 0 12dp 0;
}

.shell-call-peer-card {
  width: 46%;
  min-width: 140dp;
  flex-grow: 1;
  padding: 16dp 12dp;
  border-radius: 12dp;
  box-sizing: border-box;
  align-items: center;
}

.shell-call-peer-avatar {
  width: 56dp;
  height: 56dp;
  border-radius: 28dp;
  margin: 0 auto 10dp auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shell-call-peer-avatar .avatar-letter {
  font-size: 22dp;
}

.shell-call-peer-avatar-image {
  width: 56dp;
  height: 56dp;
  border-radius: 28dp;
  margin: 0 auto 10dp auto;
  display: block;
}

.shell-call-peer-tile {
  width: 100%;
  height: 120dp;
  border-radius: 10dp;
  margin: 0 auto 10dp auto;
}

.shell-call-peer-stall {
  margin: 0 0 6dp 0;
  text-align: center;
}

.shell-call-peer-name {
  margin: 0;
  text-align: center;
  font-size: 14dp;
  font-weight: bold;
}

.shell-call-peer-badges {
  justify-content: center;
  gap: 6dp;
  margin-top: 8dp;
  min-height: 16dp;
}

.shell-call-immersive-controls {
  flex-shrink: 0;
  padding-top: 8dp;
}

.shell-call-immersive-controls .shell-call-bar-actions {
  justify-content: center;
  flex-wrap: wrap;
}

/* An outgoing call still ringing: a wide labelled Cancel on phones (Kenneth 2026-11-04); desktop keeps its End. */
.shell-call-cancel-row {
  display: none;
}

/* Phones, ringing: the wide Cancel is the one way to hang up, so the small round End goes. */
.shell-body--compact .shell-call-leave--ringing {
  display: none;
}

.shell-body--compact .shell-call-cancel-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding: 12dp 16dp;
}

.shell-body--compact .shell-call-cancel {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8dp;
  width: 100%;
  max-width: 320dp;
  height: 50dp;
  padding: 0 20dp;
  border: 0;
  border-radius: 25dp;
  box-sizing: border-box;
  cursor: pointer;
}

.shell-body--compact .shell-call-cancel svg {
  flex-shrink: 0;
  width: 22dp;
  height: 22dp;
}

.shell-body--compact .shell-call-cancel-label {
  font-size: 17dp;
  font-weight: bold;
  line-height: 50dp;
}

.shell-call-ring-eyebrow {
  margin: 0 0 4dp 0;
  font-size: 12dp;
}

/* Stable geometry: pulse only paints (border-color / Accept glow), never size. */
.shell-call-ring {
  border-width: 2dp;
}

.shell-call-ring .shell-dialog-actions {
  gap: 10dp;
}

.shell-call-ring .btn {
  flex-grow: 1;
}

.shell-call-ring-actions {
  justify-content: center;
  gap: 28dp;
  margin-top: 18dp;
}

.shell-call-ring-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6dp;
  flex: 1 1 0;
  min-width: 0;
}

.shell-call-ring-action-circle {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 60dp;
  height: 60dp;
  min-width: 60dp;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 30dp;
  cursor: pointer;
}

.shell-call-ring-action-circle svg {
  flex-shrink: 0;
  width: 26dp;
  height: 26dp;
}

.shell-call-ring-action-label {
  margin: 0;
  text-align: center;
  max-width: 76dp;
}

.shell-call-accept {
  box-shadow: 0 0 0 0 #00000000;
}

.shell-dialog-checkbox {
  align-items: center;
  gap: 8dp;
  margin-top: 8dp;
  font-size: 14dp;
}

/* Unstyled <input type="checkbox"> renders at zero size (B38): give it a box. */
input.checkbox {
  width: 18dp;
  height: 18dp;
  border-width: 2dp;
  border-radius: 4dp;
  vertical-align: -4dp;
  cursor: pointer;
}

/* Phone checkboxes (DESIGN-pp-ui §8): an iOS circle, outlined when off, accent-filled with a white tick when on.
   The row around it (a label) is at least 44dp tall so the whole row is the tap target. */
.shell-body--compact input.checkbox {
  width: 24dp;
  height: 24dp;
  border-width: 2dp;
  border-radius: 12dp;
  box-sizing: border-box;
  vertical-align: middle;
  flex-shrink: 0;
}

.shell-body--compact input.checkbox:checked {
  decorator: svg(../icons/v2/check.svg);
}

.shell-body--compact .shell-dialog-checkbox,
.shell-body--compact .people-picker-video-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
  min-height: 44dp;
  margin-top: 8dp;
  font-size: 15dp;
  cursor: pointer;
}

.shell-dialog-actions {
  justify-content: flex-end;
  gap: 8dp;
  margin-top: 16dp;
}

/* Phone alerts look like a UIAlertController (DESIGN-pp-ui §9): a 270dp rounded card, centred 17dp title and 13dp
   message, a prompt field, then a flush button area under a hairline: two buttons side by side split by a vertical
   hairline, a longer pair stacked (the confirm on top). Text-only buttons, 44dp tall; the confirm is bold. */
.shell-body--compact .shell-dialog--alert {
  width: 270dp;
  max-width: 270dp;
  padding: 0;
  border-radius: 14dp;
  overflow: hidden;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-body {
  display: block;
  padding: 20dp 16dp;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-title {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
  text-align: center;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-message {
  margin: 4dp 0 0 0;
  font-size: 13dp;
  line-height: 18dp;
  text-align: center;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-prompt {
  height: 38dp;
  min-height: 38dp;
  margin: 14dp 0 0 0;
  padding: 0 10dp;
  border-width: 0;
  border-radius: 8dp;
  font-size: 15dp;
  line-height: 38dp;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-checkbox {
  gap: 10dp;
  min-height: 44dp;
  margin: 10dp 0 -10dp 0;
  font-size: 13dp;
  text-align: left;
}

.shell-body--compact .shell-dialog--alert input.checkbox {
  width: 20dp;
  height: 20dp;
  border-radius: 10dp;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions {
  display: flex;
  flex-direction: row;
  gap: 0;
  margin: 0;
  border-top-width: 1dp;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions--stack {
  flex-direction: column-reverse;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions .btn {
  display: block;
  flex: 1 1 0;
  width: auto;
  height: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0 4dp;
  border-width: 0;
  border-radius: 0;
  font-size: 17dp;
  line-height: 44dp;
  font-weight: normal;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-ok {
  font-weight: bold;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-ok--split {
  border-left-width: 1dp;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions--stack .shell-dialog-ok--split {
  border-left-width: 0;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions--stack .shell-dialog-cancel {
  border-top-width: 1dp;
}

.shell-pin-gate-chooser {
  display: flex;
  flex-direction: column;
  gap: 8dp;
  margin-top: 16dp;
}

.shell-pin-gate-chooser .btn {
  display: block;
  width: 100%;
  text-align: center;
}

.shell-pin-gate-input {
  width: 100%;
  margin-bottom: 10dp;
}

.shell-pin-gate-note {
  margin-top: 12dp;
}

.shell-pin-gate-error {
  min-height: 1.2em;
  margin-bottom: 8dp;
  color: #b42318;
}

.chat-empty {
  padding: 24dp;
  margin-bottom: 16dp;
  border-radius: 8dp;
}

.chat-empty-title {
  margin-top: 0;
  font-size: 20dp;
}

.home-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
}

.home-header {
  flex-shrink: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12dp;
  margin-bottom: 12dp;
  padding: 8dp 4dp;
}

.home-brand {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2dp;
}

.home-brand-name {
  margin: 0;
  font-family: LatoLatin;
  font-size: 22dp;
  font-weight: bold;
}

.home-brand-tagline {
  margin: 0;
}

.home-landing {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-bottom: 24dp;
  box-sizing: border-box;
}

.home-landing-inner {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 640dp;
  gap: 12dp;
  box-sizing: border-box;
}

.home-composer-mount {
  width: 100%;
  box-sizing: border-box;
}

.home-composer-mount .prompt-composer {
  margin: 0;
}

.home-suggestions {
  display: block;
  text-align: center;
  padding: 0 4dp;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
}

.chat-panel .chat-header-title {
  font-size: 18dp;
}

.chat-panel .chat-messages-wrap {
  flex: 1;
  min-height: 0;
}

.chat-time-inline {
  font-size: 11dp;
  opacity: 0.85;
}

.chat-shared-badge,
.chat-annotation-badge {
  display: inline-block;
  margin-right: 6dp;
  padding: 1dp 6dp;
  border-radius: 4dp;
  background-color: rgba(128, 128, 128, 0.15);
  font-size: 11dp;
}

.chat-reaction-row {
  display: block;
  margin-top: 4dp;
}

.chat-reaction-chip {
  display: inline-block;
  min-height: 30dp;
  margin-right: 4dp;
  margin-top: 2dp;
  padding: 2dp 6dp;
  border-radius: 15dp;
  background-color: rgba(128, 128, 128, 0.12);
  font-size: 18dp;
  text-align: center;
}

.chat-reaction-chip--mine {
  background-color: rgba(64, 128, 255, 0.18);
}

/* Reactions hung on a bubble or card (WhatsApp style): small pills over its bottom edge, inset from its start side.
   Absolute, so the row's height stays the bubble's (avatar, tail and bubble bottom line up); the row keeps the room
   below (message-row-has-reactions). Each chip is a 32dp hit box; the 24dp pill is drawn inside it. Tint: colors-*. */
.chat-reaction-host {
  position: relative;
}

.chat-reaction-row--overlay {
  position: absolute;
  left: 10dp;
  bottom: -16dp;
  z-index: 1;
  margin: 0;
  white-space: nowrap;
  text-align: left;
}

.chat-reaction-row--overlay .chat-reaction-chip {
  height: 32dp;
  min-height: 32dp;
  margin: 0 2dp 0 0;
  padding: 4dp 0;
  border-radius: 0;
  box-sizing: border-box;
  background-color: transparent;
  font-size: 14dp;
  line-height: 18dp;
}

.chat-reaction-row--overlay .chat-reaction-pill {
  display: inline-block;
  height: 24dp;
  padding: 1dp 7dp;
  border-width: 2dp;
  border-radius: 12dp;
  box-sizing: border-box;
  font-size: 14dp;
  line-height: 18dp;
}

.chat-reaction-count {
  margin-left: 3dp;
  font-size: 12dp;
}

.message-row-has-reactions {
  padding-bottom: 14dp;
}

.chat-system-line {
  text-align: center;
  margin: 8dp 0;
}

/* A call in the transcript: icon + duration (or outcome), a pill on the starter's side. */
.chat-call-row {
  display: inline-block;
  padding: 7dp 12dp;
  border-radius: 12dp;
  font-size: 13dp;
}

.chat-call-row-icon {
  display: inline-block;
  width: 16dp;
  height: 16dp;
  margin-right: 6dp;
  vertical-align: middle;
}

.chat-call-row-text {
  vertical-align: middle;
}

.chat-card {
  border-radius: 8dp;
  padding: 10dp 12dp;
  margin: 4dp 0;
  background-color: rgba(128, 128, 128, 0.08);
}

.chat-orphan-annotation {
  margin: 6dp 0;
}

.message-row-annotation-orphan {
  opacity: 0.85;
}

.sidebar-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.sidebar-header {
  flex-shrink: 0;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8dp;
}

.sidebar-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.sidebar-header-actions {
  flex-shrink: 0;
  gap: 6dp;
  align-items: center;
  margin-left: auto;
}

.sidebar-new-chat {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.sidebar-new-chat svg {
  flex-shrink: 0;
}

.sidebar-sessions {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.sidebar-session {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10dp;
  min-height: 60dp;
  margin-bottom: 4dp;
  padding: 8dp 10dp;
  border-radius: 6dp;
  box-sizing: border-box;
  cursor: pointer;
}

/* Two lines: title + date, then the last message + unread badge. */
.sidebar-session-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3dp;
}

.sidebar-session-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  min-height: 18dp;
}

.sidebar-session-title {
  flex: 1;
  min-width: 0;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar-session--unread .sidebar-session-title {
  font-weight: bold;
}

.sidebar-session-preview {
  flex: 1;
  min-width: 0;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar-session-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
}

.sidebar-session-icon svg {
  flex-shrink: 0;
}

.sidebar-session-date {
  flex-shrink: 0;
  font-size: 11dp;
}

.sidebar-session-flag {
  flex-shrink: 0;
}

/* "You were mentioned" ahead of the preview (group-chat G015): accent, bold, never cut. */
.sidebar-session-mention {
  flex-shrink: 0;
  display: block;
  margin-right: 4dp;
  font-size: 12dp;
  font-weight: bold;
  white-space: nowrap;
}

/* "Marked as unread": a dot in the badge colour, since there is no message count to show. */
.sidebar-unread-dot {
  flex-shrink: 0;
  display: block;
  width: 8dp;
  height: 8dp;
  border-radius: 4dp;
}

/* Opens the archived threads, or returns to the list; shown only when something is archived. */
.sidebar-archived-entry {
  align-items: center;
  gap: 8dp;
  min-height: 36dp;
  margin-bottom: 4dp;
  padding: 6dp 12dp;
  border-radius: 6dp;
  box-sizing: border-box;
  cursor: pointer;
}

.sidebar-archived-label {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  margin-bottom: 0;
  font-size: 13dp;
}

.sidebar-unread {
  flex-shrink: 0;
}

.badge-count {
  flex-shrink: 0;
  min-width: 20dp;
  padding: 2dp 6dp;
  border-radius: 10dp;
  font-size: 11dp;
  text-align: center;
}

/* tab-badge pill: 18dp high, caption-1 600, at the icon's top-right. */
.badge-count--nav {
  position: absolute;
  top: -6dp;
  right: -12dp;
  min-width: 18dp;
  height: 18dp;
  padding: 0 5dp;
  box-sizing: border-box;
  border-radius: 9dp;
  font-size: 12dp;
  font-weight: bold;
  line-height: 18dp;
}

.badge-dot {
  flex-shrink: 0;
  width: 8dp;
  height: 8dp;
  border-radius: 4dp;
}

.badge-dot--nav {
  position: absolute;
  top: -2dp;
  right: -4dp;
}

.badge-dot--settings {
  flex-shrink: 0;
  margin-left: 6dp;
  margin-right: 2dp;
}

.sidebar-session-close {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28dp;
  height: 28dp;
  min-width: 28dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.sidebar-session-close svg {
  flex-shrink: 0;
}

/* Phone chat list (DESIGN-pp-ui 8.3 / 8.8): full-width 76dp rows, a 52dp round avatar, a hairline inset from 80dp.
   The avatar, type icon, muted bell and search box only exist on the phone; desktop keeps the card rows. */
.chat-search,
.chat-row-avatar,
.chat-row-type,
.chat-row-mute,
.chat-row-blocked {
  display: none;
}

.shell-layer-compact .sidebar-panel {
  padding: 0;
}

.shell-layer-compact .sidebar-sessions .large-title {
  padding: 0 16dp;
}

.shell-layer-compact .chat-search {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  height: 36dp;
  margin: 0 16dp 8dp 16dp;
  padding: 0 8dp;
  box-sizing: border-box;
  border-radius: 10dp;
}

.chat-search-icon {
  flex-shrink: 0;
  width: 16dp;
  height: 16dp;
}

.chat-search-input {
  flex: 1;
  min-width: 0;
  height: 36dp;
  margin: 0;
  padding: 0 0 0 6dp;
  border: 0;
  box-sizing: border-box;
  font-size: 17dp;
  background-color: transparent;
}

/* Text and caret centred in the 36dp pill: the engine draws them one line tall at the top of the content box, so
   the box is a 22dp line with 7dp above and below (Kenneth 2026-11-04: the caret was not in the middle). Phones only. */
.shell-layer-compact .chat-search-input {
  padding-top: 7dp;
  padding-bottom: 7dp;
  line-height: 22dp;
}

/* The input renders no placeholder: this label sits over it while it is empty and lets clicks through. */
.chat-search-label {
  position: absolute;
  top: 0;
  left: 30dp;
  height: 36dp;
  margin: 0;
  font-size: 17dp;
  line-height: 36dp;
  pointer-events: none;
}

.shell-layer-compact .sidebar-archived-entry {
  margin: 0 16dp 4dp 16dp;
}

.shell-layer-compact .sidebar-sessions .text {
  padding: 8dp 16dp;
}

.shell-layer-compact .sidebar-session {
  gap: 12dp;
  height: 76dp;
  min-height: 76dp;
  margin: 0;
  padding: 0 0 0 16dp;
  border: 0;
  border-radius: 0;
}

/* Swipe actions (phone Chats list): the buttons sit just outside the row and ride along as it slides. */
.session-swipe {
  display: none;
}

.shell-layer-compact .sidebar-sessions {
  overflow-x: hidden;
}

/* Moved with `left` (SessionSwipeGesture), so its buttons are hit where they are drawn. */
.shell-layer-compact .sidebar-session {
  position: relative;
  transition: left 0.2s cubic-out;
}

.shell-layer-compact .sidebar-session.session-swipe-dragging {
  transition: none;
}

.shell-layer-compact .session-swipe {
  display: none;
}

.shell-layer-compact .sidebar-session.session-swipe-shown .session-swipe {
  display: flex;
  flex-direction: row;
  position: absolute;
  top: 0;
  bottom: 0;
}

.shell-layer-compact .session-swipe--end {
  left: 100%;
}

.shell-layer-compact .session-swipe--start {
  right: 100%;
}

.shell-layer-compact .session-swipe-btn {
  width: 74dp;
  min-height: 44dp;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.shell-layer-compact .session-swipe-label {
  margin: 2dp 0 0 0;
  font-size: 11dp;
  text-align: center;
}

.shell-layer-compact .sidebar-session-icon,
.shell-layer-compact .sidebar-session-flag--pin,
.shell-layer-compact .sidebar-session-flag--muted {
  display: none;
}

.shell-layer-compact .chat-row-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 48dp;
  height: 48dp;
  border-radius: 24dp;
  overflow: hidden;
}

/* A cached profile photo replaces the letter: the round frame clips it. */
.shell-layer-compact .chat-row-avatar .avatar-photo {
  width: 48dp;
  height: 48dp;
}

.chat-row-avatar-letter {
  margin: 0;
  font-size: 19dp;
  line-height: 24dp;
  font-weight: bold;
}

.chat-row-avatar-icon {
  width: 28dp;
  height: 28dp;
}

.shell-layer-compact .sidebar-session-body {
  height: 76dp;
  padding-right: 16dp;
  box-sizing: border-box;
  justify-content: center;
  gap: 5dp;
}

.shell-layer-compact .sidebar-session-line {
  min-height: 22dp;
}

.shell-layer-compact .sidebar-session-line + .sidebar-session-line {
  min-height: 20dp;
}

.shell-layer-compact .sidebar-session-title {
  font-size: 16dp;
  line-height: 21dp;
  font-weight: bold;
}

/* Kenneth 2026-11-03: one size smaller than the spec's subhead, more air ("不要塞的太满"). */
.shell-layer-compact .sidebar-session-preview,
.shell-layer-compact .sidebar-session-mention {
  font-size: 14dp;
  line-height: 19dp;
}

.shell-layer-compact .sidebar-session-date {
  font-size: 12dp;
  line-height: 16dp;
}

.shell-layer-compact .chat-row-type,
.shell-layer-compact .chat-row-mute {
  display: block;
  flex-shrink: 0;
}

.shell-layer-compact .chat-row-type {
  width: 14dp;
  height: 14dp;
}

.shell-layer-compact .chat-row-mute {
  width: 16dp;
  height: 16dp;
}

/* A chat with someone blocked (Kenneth 2026-11-04): a small block mark before "Blocked", kept quiet. */
.shell-layer-compact .chat-row-blocked {
  display: block;
  flex-shrink: 0;
  width: 14dp;
  height: 14dp;
}

.shell-layer-compact .sidebar-unread {
  min-width: 20dp;
  height: 20dp;
  padding: 0 6dp;
  box-sizing: border-box;
  border-radius: 10dp;
  font-size: 12dp;
  font-weight: bold;
  line-height: 20dp;
}

.message-row-peer {
  margin: 8dp 0;
  padding-right: 48dp;
}

.message-row-ai {
  margin: 8dp 0;
  padding-right: 24dp;
}

.message-row-user {
  margin: 8dp 0;
  padding-left: 48dp;
}

/* The row a jump landed on (a tapped quote's original, a search hit, a mention): tinted for a moment. Two classes,
   so it wins over a row's own tint (.message-row-mentions-me in colors-*.rcss); see-through, so it reads on
   either theme. */
.message-row.message-row-jump-target {
  border-radius: 8dp;
}

/* A peer's message that mentions this account (group-chat G015): the row is tinted (colors-*.rcss). */
.message-row-mentions-me {
  padding: 4dp 8dp;
  border-radius: 4dp;
}

.sender-label {
  display: block;
  font-size: 11dp;
  margin-top: 0;
  margin-bottom: 4dp;
}

.preview-panel,
.working-set-panel {
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow-y: auto;
}

.working-set-header {
  display: flex;
  align-items: flex-start;
  gap: 8dp;
}

.working-set-header-text {
  flex: 1;
  min-width: 0;
}

.preview-title,
.working-set-title {
  margin-top: 0;
  font-size: 18dp;
}

.preview-content,
.working-set-body {
  margin-top: 8dp;
}

.working-set-long-list-body {
  display: block;
}

.working-set-long-list .chat-long-list-item {
  display: block;
  margin-bottom: 12dp;
  padding-bottom: 10dp;
}

.working-set-form {
  display: block;
  margin-top: 8dp;
}

.working-set-table {
  width: 100%;
}

.working-set-code {
  white-space: pre-wrap;
}

.chat-working-set-chip {
  display: inline-block;
  margin-top: 8dp;
  margin-right: 8dp;
  height: 44dp;
  min-height: 44dp;
  padding: 0 16dp;
  line-height: 44dp;
  border-radius: 999dp;
  font-size: 13dp;
  box-sizing: border-box;
  text-align: center;
  focus: none;
}

.empty-panel {
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  justify-content: center;
}

/* Settings panel */
.settings-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.settings-list-view,
.settings-detail-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.settings-detail-view {
  transform: translateX(0);
}

.settings-detail-view.shell-swipe-dragging {
}

/* The transfer page's explanation starts below the bar with the room a card would have. */
.shell-layer-compact .settings-subpage-view .settings-transfer {
  padding-top: 14dp;
}

/* Phones: a page pushed over a settings section (Security > Change PIN): it covers the section, which stays
   underneath so a swipe back shows it. */
.settings-subpage-view {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
}

.settings-header,
.settings-detail-header {
  flex-shrink: 0;
  align-items: center;
  margin-bottom: 8dp;
}

.settings-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.me-profile-card {
  flex-shrink: 0;
  margin-bottom: 12dp;
  padding: 10dp;
  border-radius: 8dp;
  box-sizing: border-box;
  gap: 6dp;
}

/* Expanded/compact Me index: single-row identity (avatar | name | actions). */
.me-identity-header {
  align-items: center;
  gap: 10dp;
  padding: 8dp 10dp;
  margin-bottom: 8dp;
}

.me-identity-main {
  flex: 1;
  min-width: 0;
  gap: 2dp;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  text-align: left;
  cursor: pointer;
}

.me-identity-name {
  margin: 0;
  font-size: 15dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.me-identity-actions {
  flex-shrink: 0;
  gap: 6dp;
  align-items: center;
}

.me-identity-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  min-height: 36dp;
  padding: 0;
  border-radius: 8dp;
}

.me-identity-status {
  flex-shrink: 0;
  margin: 0 0 8dp 0;
  font-size: 12dp;
}

.me-profile-meta {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
  word-break: break-all;
}

.me-profile-actions {
  margin-top: 4dp;
  gap: 8dp;
  flex-wrap: wrap;
}

.me-invite-qr {
  flex-direction: column;
  align-items: flex-start;
  gap: 8dp;
  margin-top: 12dp;
}

.me-invite-qr-code {
  width: 200dp;
  height: 200dp;
  /* The theme tints ordinary svg icons; preserve the QR's white quiet zone. */
  image-color: #ffffff;
}

.me-profile-avatar-row {
  align-items: center;
  flex-wrap: wrap;
  gap: 12dp;
  margin-bottom: 8dp;
}

.me-profile-avatar-frame {
  width: 64dp;
  height: 64dp;
  border-radius: 32dp;
  overflow: hidden;
  flex-grow: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.me-profile-avatar-frame--compact {
  width: 48dp;
  height: 48dp;
  border-radius: 24dp;
}

.me-profile-avatar-frame--disabled {
  cursor: auto;
  opacity: 0.6;
  pointer-events: none;
}

.me-profile-avatar-image {
  width: 64dp;
  height: 64dp;
}

.me-profile-avatar-image--compact {
  width: 48dp;
  height: 48dp;
}

.me-profile-avatar-frame .avatar-letter {
  font-size: 24dp;
}

.me-profile-avatar-frame--compact .avatar-letter {
  font-size: 18dp;
}

.me-profile-avatar-btn {
  flex-grow: 0;
  flex-shrink: 0;
  width: auto;
  white-space: nowrap;
}

.contacts-row-avatar-frame {
  width: 32dp;
  height: 32dp;
  border-radius: 16dp;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contacts-row-avatar-image {
  width: 32dp;
  height: 32dp;
}

.contacts-row-avatar-frame .avatar-letter {
  font-size: 13dp;
}

.contact-detail-avatar-row {
  align-items: center;
  gap: 12dp;
}

.contact-detail-avatar-frame {
  width: 64dp;
  height: 64dp;
  border-radius: 32dp;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-detail-avatar-image {
  width: 64dp;
  height: 64dp;
}

.contact-detail-avatar-frame .avatar-letter {
  font-size: 24dp;
}

.avatar-letter {
  margin: 0;
  padding: 0;
  font-family: LatoLatin;
  font-weight: bold;
  line-height: 1;
  text-align: center;
  color: #ffffff;
}

.contact-detail-title-block {
  flex: 1;
  min-width: 0;
}

.chat-attachment-card {
  max-width: 320dp;
}

/* Own pictures, files and voice notes sit on the right like own text bubbles: the cards are blocks, which
   the row's text-align does not move. */
.message-row-user .chat-attachment-card,
.message-row-user .chat-voice-card {
  margin-left: auto;
}

/* A voice message: play / pause, a progress line, the length. */
.chat-voice-card {
  display: flex;
  align-items: center;
  gap: 10dp;
  min-width: 200dp;
  max-width: 280dp;
}

.chat-voice-play {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  padding: 0;
  border: 0;
  border-radius: 18dp;
  background-color: #6366f1;
  cursor: pointer;
}

.chat-voice-play svg {
  width: 16dp;
  height: 16dp;
}

.chat-voice-icon-pause {
  display: none;
}

.chat-voice-play--playing .chat-voice-icon-pause {
  display: block;
}

.chat-voice-play--playing .chat-voice-icon-play {
  display: none;
}

.chat-voice-track {
  flex: 1;
  min-width: 60dp;
  height: 4dp;
  border-radius: 2dp;
  background-color: rgba(128, 128, 128, 0.35);
  overflow: hidden;
}

.chat-voice-fill {
  height: 4dp;
  background-color: #6366f1;
}

.chat-voice-time {
  flex-shrink: 0;
  font-size: 12dp;
  opacity: 0.8;
}

.chat-attachment-image {
  display: block;
  cursor: pointer;
  max-width: 100%;
  max-height: 240dp;
  border-radius: 8dp;
  margin-bottom: 8dp;
}

.chat-ai-image {
  display: block;
  border-radius: 8dp;
  margin-bottom: 8dp;
}

.chat-attachment-video-poster {
  display: block;
  max-width: 100%;
  max-height: 240dp;
  border-radius: 8dp;
  margin-bottom: 8dp;
}

.chat-attachment-video {
  display: flex;
  flex-direction: column;
  gap: 8dp;
}

.chat-attachment-video-badge {
  display: inline-block;
  padding: 2dp 8dp;
  border-radius: 999dp;
  font-size: 11dp;
  opacity: 0.8;
}

.me-preferences-label {
  flex-shrink: 0;
  margin-top: 4dp;
  margin-bottom: 6dp;
}

.settings-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

/* Support (and similar): content-sized; do not share flex growth with Preferences. */
.settings-list--pinned {
  flex: 0 0 auto;
  min-height: 0;
  overflow: visible;
  margin-bottom: 4dp;
}

.settings-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 44dp;
  margin-bottom: 6dp;
  padding: 12dp 10dp;
  border-width: 1dp;
  border-radius: 10dp;
  box-sizing: border-box;
  cursor: pointer;
  text-align: left;
}

.settings-row-text {
  flex: 1;
  min-width: 0;
  gap: 2dp;
}

.settings-row-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 15dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.settings-row-subtitle {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.settings-row-chevron {
  flex-shrink: 0;
  margin-left: 8dp;
}

.settings-back-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin-right: 4dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.settings-back-btn svg {
  flex-shrink: 0;
}

.settings-detail-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  gap: 8dp;
}

.settings-detail-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  overflow: hidden;
}

.settings-section {
  margin-top: 16dp;
  gap: 8dp;
}

.settings-section-title {
  font-size: 14dp;
  font-weight: bold;
  margin-bottom: 4dp;
}

.settings-field {
  display: block;
}

.settings-label {
  display: block;
  font-size: 12dp;
  margin-bottom: 4dp;
}

.settings-toggle-row {
  align-items: center;
  justify-content: space-between;
  gap: 12dp;
  min-height: 44dp;
  width: 100%;
  box-sizing: border-box;
}

.settings-toggle-label {
  display: block;
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
  font-size: 15dp;
}

.settings-switch {
  position: relative;
  flex-shrink: 0;
  width: 42dp;
  height: 26dp;
  min-width: 42dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999dp;
  box-sizing: border-box;
  cursor: pointer;
}

.settings-switch-knob {
  position: absolute;
  top: 2dp;
  left: 2dp;
  width: 22dp;
  height: 22dp;
  border-radius: 999dp;
  box-sizing: border-box;
  transform: translateX(0);
  pointer-events: none;
}

.settings-switch--on .settings-switch-knob {
  transform: translateX(16dp);
}

/* The switch animating is the only feedback a toggle gives (no "saved" toast). */
.settings-switch {
  transition: background-color 0.15s ease-in-out;
}

.settings-switch-knob {
  transition: transform 0.15s ease-in-out;
}

.settings-choice-row {
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
  text-align: left;
}

.settings-choice-value {
  flex-shrink: 0;
  align-items: center;
  gap: 4dp;
}

.settings-choice-value-text {
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 160dp;
}

/* A value that names a whole rule ("4 MB 以下自动（默认）") instead of one word. */
.settings-choice-value-text--wide {
  max-width: 240dp;
}

.settings-help {
  font-size: 12dp;
  margin-top: 0;
  margin-bottom: 4dp;
}

.settings-path {
  font-size: 12dp;
  word-break: break-all;
}

.settings-actions {
  margin-top: 24dp;
  gap: 12dp;
  justify-content: flex-end;
}

/* Me → Security → Your devices: one row per device, its actions under it. */
.settings-device-row {
  padding: 8dp 0;
  gap: 8dp;
}

.settings-device-title {
  align-items: center;
}

.settings-device-actions {
  flex-wrap: wrap;
  gap: 12dp;
}

/* A label badge (not a notification badge): "Main device". */
.settings-device-badge {
  flex-shrink: 0;
  padding: 1dp 8dp;
  border-radius: 8dp;
  font-size: 11dp;
}

.settings-action-bar {
  display: block;
  width: 100%;
  text-align: center;
  box-sizing: border-box;
}

/* Pre-confirm destructive action: soft tint, not solid fill. */
.btn-danger-soft {
  border-width: 1dp;
}

.settings-danger-zone {
  margin-top: 24dp;
  padding-top: 16dp;
  gap: 8dp;
}

.settings-danger-zone .settings-actions {
  margin-top: 4dp;
}

.sidebar-footer {
  margin-top: auto;
  padding: 12dp 16dp;
}

.sidebar-settings-btn {
  display: flex;
  align-items: center;
  gap: 8dp;
  width: 100%;
  text-align: left;
}

.sidebar-settings-btn svg {
  flex-shrink: 0;
}

/* Contacts panel */
.contacts-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.contacts-list-view,
.contacts-detail-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.contacts-header,
.contacts-detail-header {
  flex-shrink: 0;
  margin-bottom: 8dp;
}

.contacts-header {
  align-items: center;
  justify-content: space-between;
}

.contacts-detail-header {
  gap: 2dp;
}

.contacts-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.contacts-header-actions {
  flex-shrink: 0;
  align-items: center;
  gap: 4dp;
}

.contacts-find-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.contacts-find-btn svg {
  flex-shrink: 0;
}

.contacts-search {
  flex-shrink: 0;
  margin-bottom: 8dp;
}

.contacts-search-field {
  margin-bottom: 0;
}

.contacts-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.contacts-row,
.contacts-thread-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 56dp;
  margin-bottom: 4dp;
  padding: 10dp 8dp;
  border-radius: 6dp;
  box-sizing: border-box;
  cursor: pointer;
  gap: 8dp;
}

.contacts-row-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18dp;
  height: 18dp;
}

.contacts-row-icon svg {
  flex-shrink: 0;
}

.contacts-row-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.contacts-row-title-line {
  align-items: center;
  gap: 6dp;
  min-width: 0;
}

.contacts-row-title {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  margin-bottom: 2dp;
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.contacts-row-subtitle {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 11dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.contacts-trust-badge {
  flex-shrink: 0;
  padding: 1dp 6dp;
  border-radius: 8dp;
  font-size: 10dp;
}

.contacts-empty {
  margin-top: 12dp;
  gap: 8dp;
}

.contacts-back-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin-right: 4dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.contacts-back-btn svg {
  flex-shrink: 0;
}

.contacts-detail-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  gap: 12dp;
}

.contact-profile-card {
  flex-shrink: 0;
  padding: 10dp;
  border-radius: 8dp;
  box-sizing: border-box;
  gap: 6dp;
}

.contact-detail-section {
  flex-shrink: 0;
  gap: 6dp;
}

.contact-detail-danger {
  margin-top: 8dp;
  margin-bottom: 4dp;
}

.contacts-edit-field {
  width: 100%;
  gap: 4dp;
}

.contacts-multiaddrs-field {
  min-height: 72dp;
}

.contacts-trust-actions {
  margin-top: 4dp;
  gap: 8dp;
  flex-wrap: wrap;
}

.contacts-threads {
  gap: 4dp;
}

.contacts-actions {
  flex-shrink: 0;
  margin-top: 16dp;
  gap: 8dp;
}

.contacts-action-buttons {
  gap: 8dp;
  flex-wrap: wrap;
}

.contacts-actions-hint {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
}

.people-picker {
  display: flex;
  flex-direction: column;
  flex: 1;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  gap: 12dp;
}

.people-picker-header {
  align-items: center;
  justify-content: space-between;
}

.people-picker-title {
  margin: 0;
  font-family: LatoLatin;
  font-size: 18dp;
  font-weight: bold;
}

.people-picker-search {
  flex-shrink: 0;
}

.people-picker-search-field {
  width: 100%;
  box-sizing: border-box;
}

.people-picker-list {
  flex: 1;
  min-height: 0;
  overflow: auto;
}

.people-picker-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10dp;
  padding: 10dp 8dp;
  margin-bottom: 4dp;
  border-radius: 8dp;
  cursor: pointer;
}

.people-picker-check {
  width: 22dp;
  height: 22dp;
  border-radius: 11dp;
  border-width: 1dp;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.people-picker-check-mark {
  margin: 0;
  font-size: 12dp;
  font-weight: bold;
}

.people-picker-row-body {
  flex: 1;
  min-width: 0;
}

.people-picker-row-title {
  margin: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
}

.people-picker-row-subtitle {
  margin: 2dp 0 0 0;
  font-size: 12dp;
  white-space: nowrap;
  overflow: hidden;
}

.people-picker-locked-label {
  margin: 0;
  font-size: 11dp;
  flex-shrink: 0;
}

.people-picker-footer {
  flex-shrink: 0;
  justify-content: flex-end;
  gap: 8dp;
  padding-top: 8dp;
}

.people-picker-name,
.people-picker-select {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  gap: 12dp;
}

.people-picker-name-help {
  margin: 0;
}

.people-picker-name-field {
  flex-shrink: 0;
}

.people-picker-members {
  flex: 1;
  min-height: 0;
  overflow: auto;
}

.people-picker-members-label {
  margin: 0 0 4dp 0;
}

.people-picker-member-chips {
  flex-wrap: wrap;
  gap: 6dp;
}

.people-picker-member-chip {
  padding: 4dp 10dp;
  border-radius: 999dp;
  font-size: 13dp;
}

.contact-detail-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  overflow: hidden;
}

.shell-nav-page--under-overlay {
  opacity: 1;
}

.context-menu-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 52;  /* above dialogs (50–51: a menu opened from a full-screen list), below the PIN gate and popovers (55) */
}

.context-menu-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.context-menu-panel {
  position: absolute;
  min-width: 180dp;
  max-width: 100%;
  padding: 4dp;
  border-radius: 8dp;
  box-shadow: 0 4dp 16dp rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

/* Touch text menu of an input field: one horizontal row, placed by ContextMenuHost::LayoutBar. */
.context-menu-layer--bar .context-menu-panel {
  display: flex;
  flex-direction: row;
  min-width: 0;
}

.context-menu-layer--bar .context-menu-item {
  width: auto;
  min-height: 36dp;
  padding: 6dp 12dp;
}

.context-menu-layer--bar .context-menu-item-label {
  flex: 0 0 auto;
  white-space: nowrap;
}

/* Reaction row above a chat message (ContextMenuHost::LayoutAnchored). */
.context-menu-quick {
  display: flex;
  flex-direction: row;
  min-width: 0;
  border-radius: 22dp;
}

.context-menu-quick .context-menu-item {
  width: auto;
  min-height: 40dp;
  padding: 4dp 8dp;
  border-radius: 18dp;
}

.context-menu-quick .context-menu-item-label {
  flex: 0 0 auto;
  font-size: 22dp;
  white-space: nowrap;
}

/* Phone pull-down from a header button (ContextMenuHost::ShowActionsPopover): a rounded card right-aligned under
   the button, 50dp rows, label on the left and icon on the right (iOS pull-down menu). */
.context-menu-layer--popover .context-menu-panel {
  min-width: 230dp;
  max-width: 300dp;
  padding: 0;
  border: 0;
  border-radius: 14dp;
  overflow: hidden;
}

.context-menu-layer--popover .context-menu-item {
  flex-direction: row-reverse;
  gap: 12dp;
  min-height: 50dp;
  padding: 0 16dp;
  border-radius: 0;
}

.context-menu-layer--popover .context-menu-item-label {
  font-size: 17dp;
  white-space: nowrap;
}

.context-menu-layer--popover .context-menu-item-icon {
  width: 20dp;
  height: 20dp;
}

/* Phone menus (ContextMenuHost, Presentation::ActionSheet): the small sheet, the page sheets' family (Kenneth
   2026-11-04, ui-mockups/09-sheets-unify): edge to edge at the bottom, 12dp top corners, the grab handle, a 44dp row
   with the centred title and the grey close disc, then one card of 50dp rows. Its height follows the rows, up to about
   a third of the screen (LayoutActionSheet sets the list's max-height and the home-indicator padding); a drag down,
   the disc or the scrim closes it. */
.context-menu-layer--sheet {
  box-sizing: border-box;
}

.context-menu-sheet {
  position: absolute;
  z-index: 1;
  display: block;
  padding: 16dp 16dp 8dp 16dp;
  border-radius: 12dp 12dp 0 0;
  box-sizing: border-box;
  transform: translateY(0px);
  transition: transform 0.25s cubic-out;
  animation: 0.3s cubic-out shell-page-sheet-in;
}

.context-menu-sheet.context-menu-sheet--dragging {
  transition: none;
}

.context-menu-sheet-grabber {
  position: absolute;
  top: 6dp;
  left: 0;
  right: 0;
  width: 36dp;
  height: 5dp;
  margin: 0 auto;
  border-radius: 2.5dp;
}

/* The title row keeps clear of the disc on both sides so the title stays centred (the sheet has 16dp side padding). */
.context-menu-sheet-header {
  display: block;
  height: 44dp;
  margin: 0;
  padding: 0 36dp;
  box-sizing: border-box;
}

.context-menu-sheet-title {
  display: block;
  height: 44dp;
  margin: 0;
  font-family: LatoLatin;
  font-size: 17dp;
  line-height: 44dp;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* A 44dp target round a 30dp grey disc, where the page sheets have theirs. */
.context-menu-sheet-close {
  position: absolute;
  top: 16dp;
  right: 4dp;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  background-color: transparent;
  cursor: pointer;
}

.context-menu-sheet-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30dp;
  height: 30dp;
  border-radius: 15dp;
}

/* Reactions over a chat message: one card row of emoji above the actions. */
.context-menu-sheet-quick {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  margin: 4dp 0 8dp 0;
  padding: 4dp;
  border-radius: 12dp;
  box-sizing: border-box;
}

.context-menu-sheet-quick .context-menu-item {
  width: 44dp;
  min-width: 44dp;
  height: 44dp;
  min-height: 44dp;
  padding: 0;
  justify-content: center;
  border-radius: 22dp;
}

.context-menu-sheet-quick .context-menu-item-label {
  flex: 0 0 auto;
  font-size: 24dp;
  text-align: center;
  white-space: nowrap;
}

.context-menu-sheet-list {
  display: block;
  width: 100%;
  margin: 4dp 0 0 0;
  padding: 0;
  border-radius: 12dp;
  overflow: auto;
  box-sizing: border-box;
}

.context-menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10dp;
  width: 100%;
  min-width: 0;
  min-height: 40dp;
  margin: 0;
  padding: 8dp 12dp;
  border: 0;
  border-radius: 6dp;
  background-color: transparent;
  text-align: left;
  cursor: pointer;
  box-sizing: border-box;
}

/* A sheet row: 50dp, the icon 16dp in, the label filling the rest; the hairline is the label's top edge, so it
   starts after the icon (or at the text without one) and runs to the card's right edge. */
.context-menu-sheet-list .context-menu-item {
  align-items: stretch;
  gap: 12dp;
  min-height: 50dp;
  padding: 0 0 0 16dp;
  border-radius: 0;
}

.context-menu-sheet-list .context-menu-item-body {
  display: flex;
  flex: 1;
  flex-direction: row;
  align-items: center;
  min-width: 0;
  min-height: 50dp;
  padding: 0 16dp 0 0;
  box-sizing: border-box;
}

.context-menu-sheet-list .context-menu-item:first-child .context-menu-item-body {
  border-top-width: 0;
}

.context-menu-sheet-list .context-menu-item-label {
  font-size: 17dp;
}

.context-menu-item-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18dp;
  height: 18dp;
}

.context-menu-item-icon svg {
  flex-shrink: 0;
}

/* Phone sheet: 22dp leading icon (the svg itself is emitted at 22dp). */
.context-menu-sheet-list .context-menu-item-icon {
  align-self: center;
  width: 22dp;
  height: 22dp;
}

.context-menu-item-label {
  flex: 1;
  min-width: 0;
  font-family: LatoLatin;
  font-size: 14dp;
}

.context-menu-item-check {
  flex-shrink: 0;
  margin-left: 8dp;
  font-family: LatoLatin;
  font-size: 14dp;
  color: #2563eb;
}

.context-menu-item--selected .context-menu-item-label {
  font-weight: bold;
}

/* Emoji / bottom-chrome IME panel (mobile / compact). No scrim — chat stays interactive. */
.shell-layer-emoji-keyboard {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  pointer-events: none;
}

.shell-layer-emoji-keyboard .shell-emoji-keyboard-panel {
  pointer-events: auto;
}

.shell-emoji-keyboard-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 280dp;
  display: flex;
  flex-direction: column;
  border-radius: 12dp 12dp 0 0;
  padding: 8dp 8dp 4dp 8dp;
  box-sizing: border-box;
  overflow: hidden;
  /* Force scissor even when flex children absorb overflow (scroll lives on .emoji-picker-body). */
  clip: always;
  z-index: 51;
}

.shell-emoji-keyboard-body {
  flex: 1;
  min-height: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  clip: always;
}

.shell-emoji-keyboard-body .emoji-picker {
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

/* Emoji picker overlay (expanded desktop modal) */
.emoji-picker {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  gap: 8dp;
  overflow: hidden;
}

.emoji-picker-header {
  align-items: center;
  flex-shrink: 0;
}

.emoji-picker-title {
  margin: 0;
  font-family: LatoLatin;
  font-size: 18dp;
  font-weight: bold;
}

.emoji-picker-main {
  flex: 1;
  min-height: 0;
  align-items: stretch;
  gap: 0;
  overflow: hidden;
}

.emoji-picker-rail {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  width: 48dp;
  overflow: auto;
  padding: 4dp 0;
  gap: 2dp;
}

.emoji-picker-rail-tab {
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0;
  border-width: 0;
  border-radius: 8dp;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
}

.emoji-picker-rail-glyph {
  font-size: 20dp;
  line-height: 1.2;
}

.emoji-picker-body {
  flex: 1;
  min-width: 0;
  min-height: 0;
  overflow: auto;
  clip: always;
  padding: 0 8dp 12dp 8dp;
}

.emoji-picker-section {
  display: block;
  margin-bottom: 8dp;
}

.emoji-picker-section-label {
  position: sticky;
  top: 0dp;
  z-index: 1;
  padding: 6dp 4dp;
}

.emoji-picker-section-label-text {
  margin: 0;
  font-family: LatoLatin;
  font-size: 12dp;
  font-weight: bold;
}

.emoji-picker-cells {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 2dp;
}

.emoji-picker-cell {
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0;
  border-width: 0;
  border-radius: 8dp;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
}

.emoji-picker-cell-glyph {
  font-size: 24dp;
  line-height: 1.2;
}

/* In-app QR camera surface. The decoder runs independently of this preview. */
.qr-scan {
  display: flex;
  flex-direction: column;
  gap: 12dp;
  height: 100%;
  min-height: 0;
}

.qr-scan-camera {
  flex: 1;
  min-height: 200dp;
  background-color: #000000;
  overflow: hidden;
}

.qr-scan-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.qr-scan-actions {
  justify-content: flex-end;
  gap: 8dp;
  flex-shrink: 0;
}

/* Phone scanner (Kenneth 2026-11-04, WeChat style; ShellLayoutRml's full-screen layer): the camera and the finder
   fill the whole screen behind the back button and the bottom button, which stay inside the safe areas the shell
   pads the body by. The finder is a 250dp square in the middle with corner marks and a line sweeping it, dimmed
   round it, the hint under it. Colours: colors.rcss.tmpl. */
.qr-scan-finder,
.qr-scan-back,
.qr-scan-tools {
  display: none;
}

.shell-layer-full-screen {
  display: flex;
  flex-direction: column;
}

/* The camera fills the layer (the absolute parts' box), not this padded body, so the body neither clips nor scrolls. */
.shell-layer-full-screen .shell-overlay-body {
  flex: 1;
  overflow: visible;
  clip: auto;
  box-sizing: border-box;
}

.shell-layer-compact .qr-scan {
  justify-content: space-between;
  gap: 0;
}

.shell-layer-compact .qr-scan-title,
.shell-layer-compact .qr-scan-status,
.shell-layer-compact .qr-scan-actions {
  display: none;
}

.shell-layer-compact .qr-scan-camera,
.shell-layer-compact .qr-scan-finder {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 0;
}

.shell-layer-compact .qr-scan-finder {
  display: flex;
  flex-direction: column;
}

.shell-layer-compact .qr-scan-dim {
  flex: 1;
}

.shell-layer-compact .qr-scan-finder-row {
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  height: 250dp;
}

.shell-layer-compact .qr-scan-frame {
  position: relative;
  flex-shrink: 0;
  width: 250dp;
  height: 250dp;
}

.shell-layer-compact .qr-scan-corner {
  position: absolute;
  width: 24dp;
  height: 24dp;
  box-sizing: border-box;
}

.shell-layer-compact .qr-scan-corner--tl {
  top: 0;
  left: 0;
  border-width: 3dp 0 0 3dp;
}

.shell-layer-compact .qr-scan-corner--tr {
  top: 0;
  right: 0;
  border-width: 3dp 3dp 0 0;
}

.shell-layer-compact .qr-scan-corner--bl {
  bottom: 0;
  left: 0;
  border-width: 0 0 3dp 3dp;
}

.shell-layer-compact .qr-scan-corner--br {
  right: 0;
  bottom: 0;
  border-width: 0 3dp 3dp 0;
}

@keyframes qr-scan-sweep {
  from { transform: translateY(0dp); }
  to { transform: translateY(234dp); }
}

/* Only while scanning: it goes with the failure line. */
.shell-layer-compact .qr-scan-line {
  position: absolute;
  top: 7dp;
  left: 10dp;
  right: 10dp;
  height: 2dp;
  border-radius: 1dp;
  animation: 1.2s cubic-in-out infinite alternate qr-scan-sweep;
}

/* Out of the flow, so the dimmed bands above and below the frame stay equal and the frame stays in the middle. */
.shell-layer-compact .qr-scan-below {
  position: relative;
}

.shell-layer-compact .qr-scan-below-text {
  position: absolute;
  top: 24dp;
  left: 32dp;
  right: 32dp;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.shell-layer-compact .qr-scan-hint {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

.shell-layer-compact .qr-scan-retry {
  height: 44dp;
  margin: 16dp 0 0 0;
  padding: 0 24dp;
  border: 0;
  border-radius: 22dp;
  font-size: 17dp;
  line-height: 44dp;
  cursor: pointer;
}

.shell-layer-compact .qr-scan-back {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  width: 44dp;
  height: 44dp;
  margin: 0 0 0 8dp;
  padding: 0;
  border: 0;
  cursor: pointer;
}

.shell-layer-compact .qr-scan-back svg {
  width: 24dp;
  height: 24dp;
}

.shell-layer-compact .qr-scan-tools {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding: 0 0 24dp 0;
}

.shell-layer-compact .qr-scan-tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 88dp;
  padding: 0;
  border: 0;
  cursor: pointer;
}

.shell-layer-compact .qr-scan-tool-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56dp;
  height: 56dp;
  border-radius: 28dp;
}

.shell-layer-compact .qr-scan-tool-disc svg {
  width: 26dp;
  height: 26dp;
}

.shell-layer-compact .qr-scan-tool-label {
  margin-top: 8dp;
  font-size: 13dp;
  line-height: 18dp;
}

/* Phone Contacts (DESIGN-pp-ui 8.6 / 8.7 / 8.8): full-width 60dp rows with a 40dp avatar and the last 6 characters of the
   account id; the detail page is a centred 96dp avatar, round action button and grouped cards. Desktop keeps its layout;
   the phone-only elements are hidden until the compact layer. */
.contacts-phone-search,
.contacts-row-subtitle--phone,
.cd-phone,
.cd-account {
  display: none;
}

.shell-layer-compact .contacts-panel {
  padding: 0;
}

.shell-layer-compact .contacts-list-view .large-title {
  padding: 0 16dp;
}

.shell-layer-compact .contacts-search,
.shell-layer-compact .contacts-row-subtitle--desktop,
.shell-layer-compact .contacts-trust-badge,
.shell-layer-compact .contacts-unread {
  display: none;
}

.shell-layer-compact .contacts-empty {
  padding: 0 16dp;
}

.shell-layer-compact .contacts-list > .text {
  padding: 8dp 16dp;
}

.shell-layer-compact .contacts-row {
  gap: 12dp;
  height: 60dp;
  min-height: 60dp;
  margin: 0;
  padding: 0 0 0 16dp;
  border: 0;
  border-radius: 0;
}

.shell-layer-compact .contacts-row-avatar-frame {
  width: 40dp;
  height: 40dp;
  border-radius: 20dp;
}

.shell-layer-compact .contacts-row-avatar-image {
  width: 40dp;
  height: 40dp;
}

.shell-layer-compact .contacts-row-avatar-frame .avatar-letter {
  font-size: 17dp;
}

.shell-layer-compact .contacts-row-body {
  justify-content: center;
  height: 60dp;
  padding-right: 16dp;
  box-sizing: border-box;
}

.shell-layer-compact .contacts-row-title {
  margin-bottom: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
}

.shell-layer-compact .contacts-row-subtitle--phone {
  display: block;
  font-size: 15dp;
  line-height: 20dp;
}

/* Phone Contacts A-Z: a small letter header over each section, and an index strip on the right edge (letters 11dp,
   touch width 28dp, the list's height) that jumps the list while pressed or dragged, with the letter in a centred
   bubble. The desktop list is sorted the same way but shows neither. Colours: colors.rcss.tmpl. */
.contacts-section-header,
.contacts-index,
.contacts-index-bubble {
  display: none;
}

.shell-layer-compact .contacts-section-header {
  display: block;
}

.shell-layer-compact .contacts-index {
  position: absolute;
  top: 44dp;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  width: 28dp;
  padding-right: 3dp;
  box-sizing: border-box;
  drag: drag;
  z-index: 2;
}

.shell-layer-compact .contacts-index-letter {
  display: block;
  width: 16dp;
  height: 14dp;
  margin: 0;
  font-size: 11dp;
  line-height: 14dp;
  font-weight: bold;
  text-align: center;
}

.shell-layer-compact .contacts-index-bubble {
  position: absolute;
  top: 50%;
  left: 50%;
  display: block;
  width: 72dp;
  height: 72dp;
  margin: -36dp 0 0 -36dp;
  border-radius: 14dp;
  pointer-events: none;
  z-index: 3;
}

.shell-layer-compact .contacts-index-bubble-letter {
  margin: 0;
  font-size: 34dp;
  line-height: 72dp;
  font-weight: bold;
  text-align: center;
}

/* Phone "New chat" page (pushed from the Chats compose button): title, search, three 56dp action rows with a 36dp
   coloured round icon, then Frequent and A-Z groups of the Contacts tab's 60dp rows. Colours: colors.rcss.tmpl. */
/* The title row above the list (it does not scroll), the list taking the rest. */
.nc-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.nc-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding-bottom: 32dp;
  box-sizing: border-box;
}

.shell-layer-compact .nc-title {
  padding: 12dp 16dp 0 16dp;
}

/* A name-only row: centre the name in the 60dp row. */
/* A name-only row: the body keeps the full 60dp (its separator runs along the bottom), the one line fills it. */
.shell-layer-compact .nc-page .contacts-row-title {
  margin: 0;
  line-height: 59dp;
}

.nc-actions {
  padding-bottom: 8dp;
}

.nc-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 56dp;
  padding: 0 16dp;
  gap: 12dp;
  box-sizing: border-box;
  cursor: pointer;
}

.nc-action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
}

.nc-action-icon svg {
  flex-shrink: 0;
  width: 20dp;
  height: 20dp;
}

.nc-action-label {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
}

.nc-section-header {
  height: 28dp;
  margin: 0;
  padding: 0 16dp;
  font-size: 13dp;
  line-height: 28dp;
  font-weight: bold;
}

/* Phone Add contact sheet (Kenneth 2026-11-04): a search field, my account card (avatar, name, account id, quiet copy and
   share buttons of 44dp), then four big tiles. Colours: colors.rcss.tmpl. */
.shell-layer-compact .ac-page,
.shell-layer-compact .qr-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.shell-layer-compact .ac-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding-bottom: 32dp;
  box-sizing: border-box;
}

.shell-layer-compact .ac-search {
  margin-top: 8dp;
}

.shell-layer-compact .ac-card {
  margin: 12dp 16dp 0 16dp;
  border-radius: 12dp;
  overflow: hidden;
}

.shell-layer-compact .ac-account {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
  min-height: 76dp;
  padding: 12dp 4dp 12dp 16dp;
  box-sizing: border-box;
}

.shell-layer-compact .ac-avatar,
.shell-layer-compact .ac-avatar-image {
  width: 52dp;
  height: 52dp;
  border-radius: 26dp;
}

.shell-layer-compact .ac-avatar .avatar-letter {
  font-size: 22dp;
}

.shell-layer-compact .ac-account-body {
  flex: 1;
  min-width: 0;
}

.shell-layer-compact .ac-account-name {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
}

.shell-layer-compact .ac-account-id {
  margin: 2dp 0 0 0;
  font-size: 13dp;
  line-height: 18dp;
  overflow: hidden;
  white-space: nowrap;
}

.shell-layer-compact .ac-icon-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  cursor: pointer;
}

/* Scan, My QR code, Invite and New group as four big tiles, two to a row with an even 12dp gap, the rows lined up
   with the account card (Kenneth 2026-11-04: "直接用大图标大按钮"). The whole tile is the button. */
.shell-layer-compact .ac-tiles {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12dp;
  margin: 12dp 16dp 0 16dp;
}

.shell-layer-compact .ac-tile {
  flex: 1 1 40%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 104dp;
  padding: 12dp 8dp;
  border-radius: 14dp;
  box-sizing: border-box;
  cursor: pointer;
}

.shell-layer-compact .ac-tile:active {
  opacity: 0.6;
}

.shell-layer-compact .ac-tile-disc {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52dp;
  height: 52dp;
  border-radius: 26dp;
}

.shell-layer-compact .ac-tile-icon {
  flex-shrink: 0;
  width: 28dp;
  height: 28dp;
}

.shell-layer-compact .ac-tile-label {
  margin: 8dp 0 0 0;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

.shell-layer-compact .ac-results {
  margin-top: 4dp;
}

.shell-layer-compact .ac-note {
  margin: 0;
  padding: 32dp 16dp;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

/* My QR code sheet: the code on a white card, my name under it, one line of help. */
.shell-layer-compact .qr-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24dp 16dp 32dp 16dp;
  box-sizing: border-box;
}

.shell-layer-compact .qr-card {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260dp;
  height: 260dp;
  border-radius: 16dp;
}

.shell-layer-compact .qr-code {
  width: 240dp;
  height: 240dp;
}

.shell-layer-compact .qr-name {
  margin: 20dp 0 0 0;
  font-size: 20dp;
  line-height: 26dp;
  font-weight: bold;
  text-align: center;
}

.shell-layer-compact .qr-hint {
  margin: 6dp 0 0 0;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

/* Phone "Blocked" list (Settings > Security; Kenneth 2026-11-04): a short note, a card of 60dp rows (avatar, name,
   a 44dp Unblock on the right); a tap on the avatar or name opens the person's page. The result line goes under it. */
.blocked-page {
  height: 100%;
  overflow-y: auto;
  padding-bottom: 32dp;
  box-sizing: border-box;
}

.blocked-page .blocked-help {
  margin-top: 16dp;
}

.blocked-page .blocked-list {
  margin-top: 12dp;
}

.blocked-page .blocked-empty {
  margin-top: 48dp;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

.blocked-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
  height: 60dp;
  padding-left: 16dp;
}

.blocked-row-avatar {
  flex-shrink: 0;
  cursor: pointer;
}

.blocked-row-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 60dp;
  box-sizing: border-box;
}

.blocked-row-name {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 17dp;
  line-height: 60dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  cursor: pointer;
}

.blocked-unblock {
  flex-shrink: 0;
  height: 44dp;
  min-width: 44dp;
  margin: 0;
  padding: 0 16dp;
  border: 0;
  font-size: 15dp;
  line-height: 44dp;
  cursor: pointer;
}

/* Contact detail, phone. */
.shell-layer-compact .contact-detail-panel {
  display: block;
  padding: 0 0 32dp 0;
  overflow-y: auto;
}

.shell-layer-compact .contacts-detail-body,
.shell-layer-compact .contacts-actions,
.shell-layer-compact .contact-detail-panel .contacts-trust-badge,
.shell-layer-compact .contact-detail-panel .contacts-row-subtitle--desktop {
  display: none;
}

.shell-layer-compact .contacts-detail-header {
  margin: 0;
  padding: 16dp 16dp 0 16dp;
}

.shell-layer-compact .contact-detail-avatar-row {
  flex-direction: column;
  align-items: center;
  gap: 8dp;
}

.shell-layer-compact .contact-detail-avatar-frame {
  width: 96dp;
  height: 96dp;
  border-radius: 48dp;
}

.shell-layer-compact .contact-detail-avatar-image {
  width: 96dp;
  height: 96dp;
}

.shell-layer-compact .contact-detail-avatar-frame .avatar-letter {
  font-size: 40dp;
}

.shell-layer-compact .contact-detail-title-block {
  flex: none;
  align-items: center;
}

.shell-layer-compact .contact-detail-panel .contacts-header-title {
  font-size: 22dp;
  line-height: 28dp;
}

.shell-layer-compact .contact-detail-panel .contacts-row-title-line {
  justify-content: center;
}

.shell-layer-compact .cd-account {
  display: block;
  width: 100%;
  margin: 0;
  text-align: center;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-layer-compact .cd-phone {
  display: block;
}

.cd-acts {
  justify-content: center;
  gap: 16dp;
  margin-top: 16dp;
}

.cd-act {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 76dp;
  height: 64dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 13dp;
  box-sizing: border-box;
  cursor: pointer;
}

.cd-act-icon {
  width: 24dp;
  height: 24dp;
}

.cd-act-label {
  margin: 3dp 0 0 0;
  font-size: 11dp;
  line-height: 13dp;
}

.cd-card {
  margin: 20dp 16dp 0 16dp;
  border-radius: 10dp;
  overflow: hidden;
}

.cd-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 44dp;
  margin: 0;
  padding: 0 0 0 16dp;
  border: 0;
  box-sizing: border-box;
  text-align: left;
  cursor: pointer;
  font-family: LatoLatin;
}

.cd-row-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  height: 44dp;
  padding-right: 12dp;
  box-sizing: border-box;
}

/* Each row sits 1dp up so its top separator overlaps the row above; the card clips the first one, whichever
   rows data-if has hidden. */
.cd-card .cd-row {
  margin-top: -1dp;
}

.cd-row-text {
  flex: 1;
  min-width: 0;
  font-size: 17dp;
  line-height: 22dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cd-row-value {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 60%;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Same pattern as the settings inputs: label above, field full width, text and caret from the left. */
.cd-row--field {
  height: auto;
  min-height: 44dp;
}

.cd-row--field .cd-row-body {
  display: block;
  height: auto;
  padding: 10dp 12dp 4dp 0;
}

.cd-row--field .cd-row-text {
  display: block;
  flex: none;
  width: auto;
  font-size: 13dp;
  line-height: 18dp;
}

.cd-field {
  display: block;
  flex: none;
  width: 100%;
  min-width: 0;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  box-sizing: border-box;
  font-size: 17dp;
  text-align: left;
  background-color: transparent;
}

.shell-layer-compact .cd-row--field .cd-row-body {
  position: relative;
  padding-bottom: 0;
}

/* Text and caret centred in the 44dp box (Kenneth 2026-11-04: the note sat at the top): the engine draws them one
   line tall at the top of the content box, so the box is a 22dp line with 11dp above and below, as the search fields. */
.shell-layer-compact .cd-field {
  margin: 0 0 10dp 0;
  padding: 11dp 12dp;
  border-radius: 10dp;
  line-height: 22dp;
}

.shell-layer-compact .cd-row--field .group-field-hint {
  bottom: 10dp;
}

.cd-switch {
  width: 51dp;
  height: 31dp;
  min-width: 51dp;
}

.cd-switch .settings-switch-knob {
  width: 27dp;
  height: 27dp;
}

.cd-switch.settings-switch--on .settings-switch-knob {
  transform: translateX(20dp);
}

.cd-icon-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  margin: 0;
  padding: 0;
  border: 0;
  cursor: pointer;
  background-color: transparent;
}

.cd-icon {
  width: 20dp;
  height: 20dp;
}

.cd-chevron {
  flex-shrink: 0;
  width: 16dp;
  height: 16dp;
}

.cd-footnote {
  margin: 6dp 0 0 0;
  padding: 0 32dp;
  font-size: 13dp;
  line-height: 18dp;
}

/* The contact page's sheet title row: only in a page sheet (the pushed page and the desktop pane have a title bar). The
   page under it scrolls on its own, so the row stays put. */
.cd-sheet-header {
  display: none;
}

.shell-page-sheet .cd-sheet-header {
  display: flex;
}

.shell-page-sheet .contact-detail-panel {
  flex: 1;
  min-height: 0;
}

/* A card's header line above it (the group info's "5 members"): the card then sits right under it. */
.cd-header {
  margin: 20dp 0 6dp 0;
  padding: 0 32dp;
  font-size: 13dp;
  line-height: 18dp;
}

.cd-card.cd-card--headed {
  margin-top: 0;
}

/* A person in a card (the group info's members): a 52dp row with a 36dp round avatar before the name. */
.cd-row.cd-row--member {
  height: 52dp;
  gap: 12dp;
}

.cd-row--member .cd-row-body {
  height: 52dp;
}

.cd-row--static {
  cursor: default;
}

.cd-row-avatar,
.cd-row-plus {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
}

.cd-row-avatar .avatar-letter {
  font-size: 15dp;
}

/* A small label after a name in a row ("Owner", "Can't reach"). */
.cd-tag {
  flex-shrink: 0;
  height: 20dp;
  padding: 0 6dp;
  border-radius: 6dp;
  box-sizing: border-box;
  font-size: 12dp;
  line-height: 20dp;
  font-weight: bold;
}

/* Group member page: help line sits centred under the Add contact button. */
.cd-footnote--center {
  margin-top: 16dp;
  text-align: center;
}

/* ---- Phone chat window (UI refresh batch 3, DESIGN-pp-ui.md 8.4 / 8.5): the desktop keeps the rules above. ---- */

.chat-date-strip,
.chat-group-name,
.chat-row-avatar-col,
.bubble-time,
.prompt-composer-label,
.prompt-icon-v2 {
  display: none;
}

.prompt-composer-pill {
  position: relative;
}

.shell-chat-overlay .messages {
  padding-left: 8dp;
  padding-right: 8dp;
}

/* The transcript runs close to the screen edges (avatars 8dp, own bubbles 10dp so their tail ends 2dp short of the
   edge): the panel's 12dp side padding is cancelled under it (offsets on the absolute scroller; a negative right
   margin on the flex item is not applied by the engine). */
.shell-chat-overlay .chat-messages-wrap .messages {
  left: -12dp;
  right: -12dp;
  padding-right: 10dp;
}

/* The engine reserves 16dp for an (undrawn) scrollbar; on the phone the transcript scrolls by touch, so own bubbles
   keep only the 8dp margin on the right. */
.shell-chat-overlay .messages scrollbarvertical {
  width: 0dp;
}

/* A video card is a plain block on phones (a flex column would take the card's full 240dp). */
.shell-chat-overlay .chat-attachment-video {
  display: block;
}

.shell-chat-overlay .chat-attachment-video-badge {
  padding: 0;
}

/* Rows: 2dp inside a run, 8dp between runs; bubbles take at most 72% of the width (a clear gap on the opposite side), so the desktop's side gutters go. */
.shell-chat-overlay .message-row {
  margin: 2dp 0 0 0;
}

.shell-chat-overlay .message-row-run-start {
  margin-top: 8dp;
}

.shell-chat-overlay .message-row-peer,
.shell-chat-overlay .message-row-ai {
  padding-right: 0;
}

.shell-chat-overlay .message-row-user {
  padding-left: 0;
}

/* The per-message "name · time" line is replaced by date strips, the in-bubble time and the group name. */
.shell-chat-overlay .sender-label {
  display: none;
}

.shell-chat-overlay .chat-date-strip {
  display: block;
  margin: 8dp 0;
  text-align: center;
}

.shell-chat-overlay .chat-date-pill,
.shell-chat-overlay .chat-system-line p {
  display: inline-block;
  margin: 0;
  padding: 4dp 10dp;
  max-width: 80%;
  border-radius: 999dp;
  font-size: 13dp;
  line-height: 18dp;
}

.shell-chat-overlay .chat-group-name {
  display: block;
  margin: 0 0 2dp 12dp;
  max-width: 72%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 13dp;
  font-weight: bold;
  text-align: left;
}

/* Group chats: the sender's name sits at the top of the bubble (first bubble of a run). A tap opens their page: the
   name's hit box is 44dp tall and spans the bubble (padding out into the bubble's own, cancelled by margins). */
.shell-chat-overlay .bubble .chat-group-name {
  margin: -14dp -12dp -11dp -12dp;
  padding: 14dp 12dp 13dp 12dp;
  max-width: none;
}

/* Group chats: a 32dp avatar column + 8dp gap on every received row, so all received bubbles share one left edge. */
.shell-chat-overlay .chat-row-body--group {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.shell-chat-overlay .chat-row-avatar-col {
  display: block;
  flex-shrink: 0;
  width: 32dp;
  margin-right: 6dp;
  align-self: flex-end;
}

/* The avatar's 44dp hit box: 6dp out on each side and 12dp above, cancelled by margins (the column stays 32dp). */
.shell-chat-overlay .chat-row-avatar-hit {
  display: block;
  margin: -12dp -6dp 0 -6dp;
  padding: 12dp 6dp 0 6dp;
}

.shell-chat-overlay .chat-row-avatar-col-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  border-radius: 16dp;
  overflow: hidden;
}

.shell-chat-overlay .chat-row-avatar-col-avatar .avatar-photo {
  width: 32dp;
  height: 32dp;
}

.shell-chat-overlay .chat-row-avatar-col-avatar .chat-row-avatar-letter {
  font-size: 15dp;
  line-height: 20dp;
}

.shell-chat-overlay .chat-row-body--group .chat-row-content {
  flex: 1;
  min-width: 0;
}


.shell-chat-overlay .bubble {
  padding: 8dp 12dp;
  border-radius: 18dp;
}

.shell-chat-overlay .bubble-user,
.shell-chat-overlay .bubble-assistant {
  max-width: 72%;
}

.shell-chat-overlay .bubble-assistant {
  border-width: 0;
}

.shell-chat-overlay .bubble-time {
  display: block;
  margin-top: 2dp;
  font-size: 11dp;
  line-height: 13dp;
  text-align: right;
}

.shell-chat-overlay .bubble-deleted .bubble-time {
  display: none;
}

.shell-chat-overlay .chat-quote {
  margin-top: 0;
  padding: 5dp 8dp;
  border-radius: 6dp;
}

/* Pictures, files and voice notes take the bubble colours and corners. Files and videos are compact cards (at most
   240dp, small display text, a 44dp-tall plain "Open" row); a picture card is a 3dp frame around the picture, which
   keeps its own shape inside a 220 x 260dp box (the engine keeps the ratio under max-width / max-height). */
.shell-chat-overlay .chat-attachment-card {
  display: inline-block;
  min-width: 160dp;
  max-width: 240dp;
  padding: 8dp 12dp 0 12dp;
  border-width: 0;
  border-radius: 18dp;
  box-sizing: border-box;
  text-align: left;
}

.shell-chat-overlay .chat-attachment-card .heading-3,
.shell-chat-overlay .chat-attachment-card .text {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-chat-overlay .chat-attachment-card .muted {
  margin: 2dp 0 0 0;
  font-size: 12dp;
  line-height: 16dp;
}

.shell-chat-overlay .chat-attachment-video-poster {
  max-width: 216dp;
}

.shell-chat-overlay .chat-attachment-card .chat-suggestion {
  display: block;
  width: 100%;
  height: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0;
  border-radius: 0;
  font-size: 15dp;
  line-height: 44dp;
  text-align: left;
}

/* 12dp corners: the engine does not round the picture itself, so a tighter frame corner keeps its square corner inside. */
.shell-chat-overlay .chat-attachment-card--image {
  min-width: 0;
  max-width: none;
  padding: 3dp;
  border-radius: 12dp;
}

/* Inline, so the card's shrink-to-fit width counts it (a block picture counted as 0 and spilled out of its frame);
   the engine keeps its ratio under max-width / max-height. */
.shell-chat-overlay .chat-attachment-card--image .chat-attachment-image {
  display: inline-block;
  vertical-align: top;
  max-width: 220dp;
  max-height: 260dp;
  margin: 0;
  border-radius: 9dp;
}

/* On a picture card the tail goes behind the card, so its inner half does not cover the picture's corner; the hook
   outside the card still shows. */
.shell-chat-overlay .chat-attachment-card--image .bubble-tail {
  z-index: -1;
}

/* Speech-bubble tail on the last bubble of a run: a 10x12dp shape half outside the bubble's bottom corner (received:
   left, sent: right); that corner is squared off so the tail grows out of it. Tint: colors-*.rcss. */
.shell-chat-overlay .bubble-tail-host {
  position: relative;
}

.shell-chat-overlay .bubble-tail-host--in {
  border-bottom-left-radius: 4dp;
}

.shell-chat-overlay .bubble-tail-host--out {
  border-bottom-right-radius: 4dp;
}

/* 16x20dp: the inner half overlaps the bubble's squared corner, the outer 8dp is the visible hook. */
.shell-chat-overlay .bubble-tail {
  position: absolute;
  bottom: 0;
  width: 16dp;
  height: 20dp;
}

.shell-chat-overlay .bubble-tail-in {
  left: -8dp;
}

.shell-chat-overlay .bubble-tail-out {
  right: -8dp;
}

/* Composer: a 36dp pill on a 52dp bar; the engine draws no placeholder, so the label sits over the empty input. The
   ask-AI panel's input row is the same row (Kenneth 2026-11-04: "风格不统一…能不能统一一下"). */
.shell-chat-overlay .prompt-composer-pill,
.shell-layer-compact .home-composer-mount .prompt-composer-pill,
.ask-ai .prompt-composer-pill {
  min-height: 36dp;
  padding: 0 4dp 0 12dp;
  border-radius: 18dp;
}

.shell-chat-overlay .prompt-composer-input,
.shell-layer-compact .home-composer-mount .prompt-composer-input,
.ask-ai .prompt-composer-input {
  padding: 7dp 0;
}

.shell-chat-overlay .prompt-composer-label,
.shell-layer-compact .home-composer-mount .prompt-composer-label,
.ask-ai .prompt-composer-label {
  display: block;
  position: absolute;
  top: 2dp;
  left: 12dp;
  height: 34dp;
  margin: 0;
  font-size: 17dp;
  line-height: 34dp;
  pointer-events: none;
}

/* Every button is a 44dp target round its 20dp icon; -4dp above and below keeps the one-line row at the pill's 36dp
   (the buttons stay on the last line while the text grows). */
.shell-chat-overlay .prompt-composer-row .prompt-voice-toggle-btn,
.shell-chat-overlay .prompt-composer-row .prompt-emoji-btn,
.shell-chat-overlay .prompt-composer-row .prompt-send-btn,
.shell-chat-overlay .prompt-composer-pill .prompt-attach-btn,
.shell-chat-overlay .prompt-composer-pill .prompt-capture-btn,
.shell-layer-compact .home-composer-mount .prompt-composer-row .prompt-voice-toggle-btn,
.shell-layer-compact .home-composer-mount .prompt-composer-row .prompt-emoji-btn,
.shell-layer-compact .home-composer-mount .prompt-composer-row .prompt-send-btn,
.shell-layer-compact .home-composer-mount .prompt-composer-pill .prompt-attach-btn,
.shell-layer-compact .home-composer-mount .prompt-composer-pill .prompt-capture-btn,
.ask-ai .prompt-composer-row .prompt-send-btn,
.ask-ai .prompt-composer-pill .prompt-attach-btn,
.ask-ai .prompt-composer-pill .prompt-capture-btn {
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin: -4dp 0;
  border-radius: 22dp;
}

/* Send: a clear 44dp target round a 32dp accent disc (colors-*.rcss); the desktop's button is the disc itself. */
.shell-chat-overlay .prompt-send-disc,
.shell-layer-compact .home-composer-mount .prompt-send-disc,
.ask-ai .prompt-send-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  border-radius: 16dp;
}

/* WhatsApp's row on phones: emoji, the pill, then the microphone where Send shows once there is text. */
.shell-chat-overlay .prompt-voice-toggle-btn--start {
  display: none;
}

.shell-chat-overlay .prompt-voice-toggle-btn--end {
  display: flex;
}

/* Home is an entry to the ask-AI panel: its row looks like the panel's (the pill with the paperclip and the camera),
   no emoji, no microphone; a tap anywhere opens the panel. */
.shell-layer-compact .home-composer-mount .prompt-emoji-btn,
.shell-layer-compact .home-composer-mount .prompt-voice-toggle-btn {
  display: none;
}

.shell-layer-compact .home-composer-mount .prompt-capture-btn--home {
  display: flex;
}

.shell-chat-overlay .prompt-icon-classic,
.shell-layer-compact .home-composer-mount .prompt-icon-classic,
.ask-ai .prompt-icon-classic {
  display: none;
}

.shell-chat-overlay .prompt-icon-v2,
.shell-layer-compact .home-composer-mount .prompt-icon-v2,
.ask-ai .prompt-icon-v2 {
  display: block;
  flex-shrink: 0;
  width: 20dp;
  height: 20dp;
}

/* Grouped lists on phones: the Me tab and the settings pages (DESIGN-pp-ui 8.7, 8.10). Same geometry as the .cd-*
   contact-detail cards above. The plain group-* classes are inert on desktop; everything visual is scoped to
   .shell-layer-compact. */
.group-row-body {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 12dp;
}

.group-row-body--field {
  display: block;
}

/* "?" beside a hard setting (Kenneth 2026-11-04): a 44dp target round a 20dp icon right after the label; a tap
   asks PP 客服 about it (SettingsController::OnAskSettingHelp). */
.settings-q-label {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.group-row-body .settings-q-label .group-row-text,
.group-row-label.settings-q-label .group-row-text {
  flex: 0 1 auto;
}

.settings-q-head {
  align-items: center;
}

.settings-q-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin: -10dp 0 -10dp -6dp;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  cursor: pointer;
}

.settings-q-icon {
  flex-shrink: 0;
  width: 20dp;
  height: 20dp;
}

.settings-phone-only,
.settings-back-v2 {
  display: none;
}

.shell-layer-compact .settings-phone-only {
  display: block;
}

/* Me → AI assistant → Assistant look: the four looks side by side in one card, the chosen one ringed. */
.shell-layer-compact .ai-look-picker.settings-phone-only {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 12dp 4dp;
  box-sizing: border-box;
}

.ai-look {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  gap: 6dp;
  cursor: pointer;
}

.ai-look-art {
  display: block;
  width: 68dp;
  height: 68dp;
  padding: 4dp;
  border-width: 2dp;
  border-radius: 13dp;
  box-sizing: border-box;
}

.ai-look-art svg {
  display: block;
  width: 56dp;
  height: 56dp;
}

.ai-look-name {
  display: block;
  font-size: 13dp;
  line-height: 18dp;
  text-align: center;
}

.shell-layer-compact .settings-desktop-only,
.shell-layer-compact .settings-back-old {
  display: none;
}

.shell-layer-compact .settings-back-v2 {
  display: block;
}

.shell-layer-compact .settings-panel {
  padding: 0;
}

.shell-layer-compact .settings-list-view {
  padding-bottom: 32dp;
}

.shell-layer-compact .settings-list-view .large-title {
  padding: 0 16dp;
}

/* Pushed detail page: 44dp bar, plain accent back arrow, centred title. */
.shell-layer-compact .settings-detail-header {
  position: relative;
  display: block;
  height: 44dp;
  margin: 0;
}

.shell-layer-compact .settings-back-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin: 0;
  border-radius: 0;
  z-index: 1;
}

.shell-layer-compact .settings-header-title {
  position: absolute;
  top: 0;
  left: 96dp;
  right: 96dp;
  height: 44dp;
  font-size: 17dp;
  line-height: 44dp;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .settings-detail-body {
  gap: 0;
  padding-bottom: 32dp;
  box-sizing: border-box;
}

.shell-layer-compact .settings-section {
  margin-top: 0;
  padding: 0 16dp;
}

.shell-layer-compact .settings-section--grouped {
  padding: 0;
}

.shell-layer-compact .group-card {
  margin: 20dp 16dp 0 16dp;
  border-radius: 10dp;
  overflow: hidden;
}

.shell-layer-compact .group-card--top {
  margin-top: 8dp;
}

.shell-layer-compact .group-head + .group-card {
  margin-top: 0;
}

.shell-layer-compact .group-card--pad {
  padding: 12dp 16dp;
  box-sizing: border-box;
}

.shell-layer-compact .group-card-title {
  margin: 0 0 4dp 0;
  font-size: 17dp;
  line-height: 22dp;
}

.shell-layer-compact .group-note {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-layer-compact .group-head {
  margin: 20dp 32dp 6dp 32dp;
  font-size: 13dp;
  line-height: 18dp;
}

/* A "?" right after the heading: the heading gives up its right margin (the button's own -6dp pulls it in). */
.shell-layer-compact .settings-q-head .group-head {
  margin-right: 0;
}

.shell-layer-compact .group-foot {
  margin: 6dp 32dp 0 32dp;
  font-size: 13dp;
  line-height: 18dp;
}

.shell-layer-compact .group-title {
  margin: 20dp 16dp 0 16dp;
  font-size: 22dp;
  line-height: 28dp;
  text-align: center;
}

.shell-layer-compact .group-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 50dp;
  margin: 0;
  padding: 0 0 0 16dp;
  border: 0;
  border-radius: 0;
  gap: 0;
  box-sizing: border-box;
  text-align: left;
  cursor: pointer;
  font-family: LatoLatin;
}

/* Each row sits 1dp up so its top separator overlaps the row above; the card clips the first one. */
.shell-layer-compact .group-card .group-row {
  margin-top: -1dp;
}

.shell-layer-compact .group-row-body {
  gap: 8dp;
  min-height: 50dp;
  padding: 0 12dp 0 0;
  box-sizing: border-box;
}

.shell-layer-compact .group-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 29dp;
  height: 29dp;
  margin-right: 12dp;
  border-radius: 6dp;
}

.shell-layer-compact .group-icon svg {
  width: 18dp;
  height: 18dp;
}

.shell-layer-compact .group-row-label {
  flex: 1;
  min-width: 0;
  padding: 10dp 0 10dp 0;
}

.shell-layer-compact .group-row-text {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .group-row-label .group-row-text {
  display: block;
}

.shell-layer-compact .group-row-sub {
  display: block;
  font-size: 13dp;
  line-height: 18dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .group-row-value {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 60%;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .group-chevron,
.shell-layer-compact .group-row .settings-row-chevron {
  flex-shrink: 0;
  width: 16dp;
  height: 16dp;
  margin-left: 0;
}

/* Current value on the right of a row that opens a choice: one size below the 17dp title. */
.shell-layer-compact .group-row .settings-choice-value-text {
  font-size: 14dp;
  line-height: 20dp;
}

/* Text inputs on settings and profile pages: label above the field, both starting at the left edge. The field fills
   the row and its text and caret start at the left (a right-aligned field put the caret mid-row or at the far end). */
.shell-layer-compact .group-row--field .group-row-body {
  position: relative;
  display: block;
  min-height: 0;
  padding: 10dp 16dp 0 0;
}

.shell-layer-compact .group-row--field .group-row-text {
  display: block;
  flex: none;
  width: auto;
  margin: 0 0 2dp 0;
  font-size: 13dp;
  line-height: 18dp;
  text-align: left;
}

/* The field is a filled rounded box (like the search field) so it reads as something to type into. */
.shell-layer-compact .group-card .field {
  display: block;
  flex: none;
  width: 100%;
  min-width: 0;
  height: 44dp;
  min-height: 44dp;
  max-height: 44dp;
  margin: 0 0 10dp 0;
  /* A 22dp line between 11dp paddings: text and a line-tall caret in the middle (a 44dp line drew a full-height caret). */
  padding: 11dp 12dp;
  border: 0;
  border-radius: 10dp;
  box-sizing: border-box;
  font-size: 17dp;
  line-height: 22dp;
  text-align: left;
}

/* The engine draws no placeholder: this hint sits over the empty field and lets taps through to it. */
.group-field-hint {
  display: none;
}

.shell-layer-compact .group-field-hint {
  position: absolute;
  left: 12dp;
  bottom: 10dp;
  display: block;
  height: 44dp;
  margin: 0;
  font-size: 17dp;
  line-height: 44dp;
  white-space: nowrap;
  pointer-events: none;
}

/* While an IME composes (pinyin), the bound value is still empty but the field already shows the composition: the
   engine marks the field :composing, and the placeholder label after it hides (Kenneth 2026-11-04: "消息" stayed under
   the pinyin). The prefixed forms outrank the phone rules that show the labels. */
input:composing ~ .group-field-hint,
input:composing ~ .chat-search-label,
input:composing ~ .people-picker-search-hint,
textarea:composing ~ .prompt-composer-label,
.shell-layer-compact input:composing ~ .group-field-hint,
.shell-layer-compact input:composing ~ .chat-search-label,
.shell-layer-compact .shell-page-sheet input:composing ~ .people-picker-search-hint,
.shell-layer-compact textarea:composing ~ .prompt-composer-label {
  display: none;
}

/* A row that only shows a value (nothing to tap). */
.shell-layer-compact .group-row--static {
  cursor: default;
}

/* Account ID row on the profile page: label over value on the left, Copy / Share / QR icon buttons on the right. */
.shell-layer-compact .group-id-row {
  cursor: default;
}

.shell-layer-compact .group-id-text {
  flex: 1;
  min-width: 0;
  display: block;
  padding: 8dp 0;
}

.shell-layer-compact .group-id-label {
  display: block;
  font-size: 13dp;
  line-height: 18dp;
}

.shell-layer-compact .group-id-value {
  display: block;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .group-id-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  background-color: transparent;
  cursor: pointer;
}

.shell-layer-compact .group-row .settings-switch {
  width: 51dp;
  height: 31dp;
  min-width: 51dp;
}

.shell-layer-compact .group-row .settings-switch-knob {
  width: 27dp;
  height: 27dp;
}

.shell-layer-compact .group-row .settings-switch--on .settings-switch-knob {
  transform: translateX(20dp);
}

/* Me profile card. */
.shell-layer-compact .me-card-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-right: 8dp;
}

.shell-layer-compact .me-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
  margin: 0;
  padding: 12dp;
  border: 0;
  box-sizing: border-box;
  text-align: left;
  cursor: pointer;
}

.shell-layer-compact .me-card-avatar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60dp;
  height: 60dp;
  border-radius: 30dp;
  overflow: hidden;
}

.shell-layer-compact .me-card-avatar .avatar-letter {
  font-size: 24dp;
}

.shell-layer-compact .me-card-avatar-image {
  width: 60dp;
  height: 60dp;
}

.shell-layer-compact .me-card-text {
  flex: 1;
  min-width: 0;
}

.shell-layer-compact .me-card-name {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .me-card-meta {
  margin: 1dp 0 0 0;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Buttons on settings pages (DESIGN-pp-ui 8.10): 50dp pill, full width. Inside a card they shrink to 36dp pills. */
.shell-layer-compact .settings-section--grouped .btn {
  display: block;
  width: auto;
  height: 50dp;
  min-height: 50dp;
  margin: 16dp 16dp 0 16dp;
  padding: 0 16dp;
  font-size: 17dp;
  line-height: 50dp;
  font-weight: bold;
  text-align: center;
}

.shell-layer-compact .settings-section--grouped .btn-icon {
  display: flex;
}

/* Desktop-only buttons (the profile page's Copy / Share / QR live in the Account ID row on phones; Send problem logs
   lives in About on phones). */
.shell-layer-compact .settings-section--grouped .btn.settings-desktop-only,
.shell-layer-compact .settings-section--grouped .group-actions.settings-desktop-only {
  display: none;
}

/* The disabled Send problem logs row (while it sends) reads as waiting. */
.shell-layer-compact .settings-improve-send:disabled {
  opacity: 0.5;
}

.shell-layer-compact .settings-section--grouped .settings-action-bar {
  width: auto;
}

.shell-layer-compact .settings-section--grouped .settings-actions {
  display: block;
  margin-top: 0;
}

.shell-layer-compact .settings-section--grouped .me-profile-actions {
  display: block;
  margin-top: 0;
}

.shell-layer-compact .settings-section--grouped .group-actions {
  display: flex;
  flex-direction: row;
  margin: 16dp 16dp 0 16dp;
  gap: 8dp;
}

.shell-layer-compact .settings-section--grouped .group-card .btn,
.shell-layer-compact .settings-section--grouped .group-actions .btn {
  flex: 1;
  height: 36dp;
  min-height: 36dp;
  margin: 8dp 8dp 0 0;
  font-size: 15dp;
  line-height: 36dp;
}

.shell-layer-compact .settings-section--grouped .group-actions .btn {
  margin: 0;
}

.shell-layer-compact .me-profile-avatar-row {
  margin-bottom: 0;
}

.shell-layer-compact .settings-device-actions {
  gap: 0;
}

.shell-layer-compact .settings-device-title {
  gap: 8dp;
}

/* ---- Phone Today page (UI refresh batch 4, DESIGN-pp-ui.md 8.16). The desktop keeps the brand header and the centred
   composer above; the scroller below only exists on the phone. ---- */

.home-scroll {
  display: none;
}

.shell-layer-compact .home-panel {
  padding: 0;
}

.shell-layer-compact .home-header {
  display: none;
}

.shell-layer-compact .home-scroll {
  display: block;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 44dp 0 16dp 0;
  box-sizing: border-box;
}

.shell-layer-compact .home-date {
  margin: 0;
  padding: 0 16dp;
  font-size: 13dp;
  line-height: 18dp;
}

.shell-layer-compact .home-scroll .large-title {
  padding: 0 16dp;
}

.shell-layer-compact .home-widget-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 20dp 16dp 6dp 16dp;
}

.shell-layer-compact .home-widget-title {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
}

.shell-layer-compact .home-widget-more,
.shell-layer-compact .home-friend-view {
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  font-size: 15dp;
  line-height: 22dp;
  cursor: pointer;
}

.shell-layer-compact .home-card {
  margin: 0 16dp;
  border-radius: 10dp;
  overflow: hidden;
}

/* The card clips the last row's separator: each row hangs 1dp below the card (rows are transparent on the card). */
.shell-layer-compact .home-card .sidebar-session {
  margin-bottom: -1dp;
}

.shell-layer-compact .home-friend-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 8dp;
  min-height: 60dp;
  padding: 0 16dp;
  box-sizing: border-box;
}

.shell-layer-compact .home-friend-text {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
}

.shell-layer-compact .home-friend-view {
  flex-shrink: 0;
  height: 44dp;
  font-size: 17dp;
}

/* The ask-AI block is pinned above the tab bar and does not scroll with the widgets. */
.shell-layer-compact .home-landing {
  position: relative;
  flex: none;
  display: block;
  padding: 8dp 0 12dp 0;
  box-sizing: border-box;
}

/* The widgets fade into the dock over 28dp (no divider line); touches pass through. Gradient: colors-*.rcss. */
.home-dock-fade,
.home-dock-seam {
  display: none;
}

.shell-layer-compact .home-dock-fade {
  display: block;
  position: absolute;
  top: -28dp;
  left: 0;
  right: 0;
  height: 28dp;
  pointer-events: none;
}

/* The dock's bottom 10dp melt into the tab bar's shade. */
.shell-layer-compact .home-dock-seam {
  display: block;
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 10dp;
  pointer-events: none;
}

/* Home: dock and tab bar are one opaque area (colors-*.rcss), so the bar's blur has nothing to do. */
.shell-bottom-chrome--home,
.shell-bottom-chrome--home.shell-bottom-chrome--frost {
  backdrop-filter: none;
}

.shell-layer-compact .home-landing-inner {
  max-width: none;
  gap: 8dp;
}

.shell-layer-compact .home-composer-mount .prompt-composer {
  margin: 0 16dp;
}

.shell-layer-compact .home-suggestions {
  display: flex;
  flex-direction: row;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 0 16dp;
  text-align: left;
  white-space: nowrap;
}

.shell-layer-compact .home-suggestions .chat-suggestion {
  flex: none;
  height: 32dp;
  min-height: 32dp;
  margin: 0 8dp 0 0;
  padding: 0 12dp;
  font-size: 15dp;
  line-height: 32dp;
}
