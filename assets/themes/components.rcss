.ai-dot--talk .ai-dot-mouth {
  display: block;
  opacity: 0;
  animation: 2.184s sine-in-out ai-dot-talk-mouth;
}

.ai-dot--talk .ai-dot-eyes-front {
  animation: 2.184s sine-in-out ai-dot-talk-eyes;
}

.ai-dot--talk .ai-dot-back {
  animation: 1.092s sine-in-out 2 ai-dot-nod;
}

.ai-dot--talk .ai-dot-eq,
.ai-dot--talk .ai-dot-line {
  display: block;
  opacity: 0;
}

.ai-dot--talk .ai-dot-eq-1 {
  animation: 2.184s linear-in-out ai-dot-eq-1;
}

.ai-dot--talk .ai-dot-eq-2 {
  animation: 2.184s linear-in-out ai-dot-eq-2;
}

.ai-dot--talk .ai-dot-eq-3 {
  animation: 2.184s linear-in-out ai-dot-eq-3;
}

.ai-dot--talk .ai-dot-line-1 {
  animation: 1.3s cubic-out ai-dot-line;
}

.ai-dot--talk .ai-dot-line-2 {
  animation: 1.3s 0.442s cubic-out ai-dot-line;
}

.ai-dot--talk .ai-dot-line-3 {
  animation: 1.3s 0.884s cubic-out ai-dot-line;
}

/* Shy: the front bubble leans away and peeks aside with its eyes half shut and pink cheeks, the partner ducks down
   behind it (the mockup's edge peek, played in place). C leans half as far and has no cheeks. */
@keyframes ai-dot-shy-front {
  0% { transform: rotate(0deg); }
  30% { transform: rotate(-12deg); }
  75% { transform: rotate(-12deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-shy-front-calm {
  0% { transform: rotate(0deg); }
  30% { transform: rotate(-6deg); }
  75% { transform: rotate(-6deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-shy-back {
  0% { transform: translate(0%, 0%) rotate(0deg); }
  30% { transform: translate(6.81%, 5.84%) rotate(6deg); }
  75% { transform: translate(6.81%, 5.84%) rotate(6deg); }
  100% { transform: translate(0%, 0%) rotate(0deg); }
}

@keyframes ai-dot-shy-eyes-front {
  0% { transform: translate(0%, 0%) scale(1, 1); }
  30% { transform: translate(-2.92%, 0.58%) scale(1, 0.5); }
  75% { transform: translate(-2.92%, 0.58%) scale(1, 0.5); }
  100% { transform: translate(0%, 0%) scale(1, 1); }
}

@keyframes ai-dot-shy-eyes-back {
  0% { transform: translate(0%, 0%); }
  30% { transform: translate(-1.17%, 0.58%); }
  75% { transform: translate(-1.17%, 0.58%); }
  100% { transform: translate(0%, 0%); }
}

@keyframes ai-dot-shy-blush {
  0% { opacity: 0; }
  30% { opacity: 1; }
  75% { opacity: 1; }
  100% { opacity: 0; }
}

.ai-dot--shy .ai-dot-front {
  animation: 2.08s sine-in-out ai-dot-shy-front;
}

.ai-dot--calm.ai-dot--shy .ai-dot-front {
  animation: 2.08s sine-in-out ai-dot-shy-front-calm;
}

.ai-dot--shy .ai-dot-back {
  animation: 2.08s sine-in-out ai-dot-shy-back;
}

.ai-dot--shy .ai-dot-eyes-front {
  animation: 2.08s sine-in-out ai-dot-shy-eyes-front;
}

.ai-dot--shy .ai-dot-eyes-back {
  animation: 2.08s sine-in-out ai-dot-shy-eyes-back;
}

.ai-dot--shy .ai-dot-blush {
  display: block;
  opacity: 0;
  animation: 2.08s sine-in-out ai-dot-shy-blush;
}

/* Wave: the front bubble waves its whole body with happy eyes and cheeks, the partner hops twice (34 and 22 units).
   Calm: a small tilt and one low hop over 2.2 s, eyes open, no cheeks. */
@keyframes ai-dot-wave {
  0% { transform: rotate(0deg); }
  15% { transform: rotate(-9deg); }
  35% { transform: rotate(7deg); }
  55% { transform: rotate(-9deg); }
  75% { transform: rotate(5deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-hop {
  0% { transform: translateY(0%); }
  20% { transform: translateY(-3.31%); }
  40% { transform: translateY(0%); }
  60% { transform: translateY(0%); }
  70% { transform: translateY(-2.14%); }
  80% { transform: translateY(0%); }
  100% { transform: translateY(0%); }
}

@keyframes ai-dot-tilt-calm {
  0% { transform: rotate(0deg); }
  20% { transform: rotate(-5deg); }
  40% { transform: rotate(2deg); }
  60% { transform: rotate(0deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-hop-calm {
  0% { transform: translateY(0%); }
  25% { transform: translateY(-1.17%); }
  50% { transform: translateY(0%); }
  100% { transform: translateY(0%); }
}

@keyframes ai-dot-glow-in {
  0% { opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { opacity: 0; }
}

.ai-dot--wave .ai-dot-front {
  animation: 2.08s sine-in-out ai-dot-wave;
}

.ai-dot--wave .ai-dot-back {
  animation: 2.08s sine-in-out ai-dot-hop;
}

.ai-dot--wave .ai-dot-blush {
  display: block;
  opacity: 0;
  animation: 2.08s linear-in-out ai-dot-glow-in;
}

.ai-dot--calm.ai-dot--wave .ai-dot-front {
  animation: 2.86s sine-in-out ai-dot-tilt-calm;
}

.ai-dot--calm.ai-dot--wave .ai-dot-back {
  animation: 2.86s sine-in-out ai-dot-hop-calm;
}

/* Listen: it leans in a little bigger with big eyes, both bubbles nod out of step, and three signal arcs pulse one
   after another beside the partner. C's eyes grow less and pulse; D shows five equalizer bars in its bubble. */
@keyframes ai-dot-lean {
  0% { transform: translateX(0%) scale(1); }
  15% { transform: translateX(-1.11%) scale(1.04); }
  85% { transform: translateX(-1.11%) scale(1.04); }
  100% { transform: translateX(0%) scale(1); }
}

@keyframes ai-dot-big-eyes {
  0% { transform: scale(1); }
  15% { transform: scale(1.18); }
  85% { transform: scale(1.18); }
  100% { transform: scale(1); }
}

@keyframes ai-dot-big-eyes-calm {
  0% { opacity: 1; transform: scale(1); }
  15% { opacity: 0.8; transform: scale(1.08); }
  23% { opacity: 0.6; transform: scale(1.08); }
  46% { opacity: 1; transform: scale(1.08); }
  69% { opacity: 0.6; transform: scale(1.08); }
  85% { opacity: 0.9; transform: scale(1.08); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes ai-dot-arc {
  0% { opacity: 0; }
  30% { opacity: 1; }
  100% { opacity: 0; }
}

.ai-dot--listen .ai-dot-figure {
  animation: 3.12s sine-in-out ai-dot-lean;
}

.ai-dot--listen .ai-dot-front {
  animation: 1.43s sine-in-out 2 ai-dot-nod;
}

.ai-dot--listen .ai-dot-back {
  animation: 1.43s 0.26s sine-in-out 2 ai-dot-nod;
}

.ai-dot--listen .ai-dot-eyes-front,
.ai-dot--listen .ai-dot-eyes-back {
  animation: 3.12s sine-in-out ai-dot-big-eyes;
}

.ai-dot--calm.ai-dot--listen .ai-dot-eyes-front,
.ai-dot--calm.ai-dot--listen .ai-dot-eyes-back {
  animation: 3.12s sine-in-out ai-dot-big-eyes-calm;
}

.ai-dot--listen .ai-dot-arc,
.ai-dot--listen .ai-dot-bar {
  display: block;
  opacity: 0;
}

.ai-dot--listen .ai-dot-arc-1 {
  animation: 1.3s cubic-out 2 ai-dot-arc;
}

.ai-dot--listen .ai-dot-arc-2 {
  animation: 1.3s 0.234s cubic-out 2 ai-dot-arc;
}

.ai-dot--listen .ai-dot-arc-3 {
  animation: 1.3s 0.468s cubic-out 2 ai-dot-arc;
}

.ai-dot--listen .ai-dot-bar-1 {
  animation: 3.12s linear-in-out ai-dot-bar-1;
}

.ai-dot--listen .ai-dot-bar-2 {
  animation: 3.12s linear-in-out ai-dot-bar-2;
}

.ai-dot--listen .ai-dot-bar-3 {
  animation: 3.12s linear-in-out ai-dot-bar-3;
}

.ai-dot--listen .ai-dot-bar-4 {
  animation: 3.12s linear-in-out ai-dot-bar-4;
}

.ai-dot--listen .ai-dot-bar-5 {
  animation: 3.12s linear-in-out ai-dot-bar-5;
}

/* Think: the eyes go up and right (front 22, -24; back 8, -12), the front bubble tips back a little, and a "typing"
   bubble with three bouncing dots pops up at the top right (C: a dark one with glowing dots; D: the dots in its own
   bubble). */
@keyframes ai-dot-think-front {
  0% { transform: rotate(0deg); }
  50% { transform: rotate(-3deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-think-eyes-front {
  0% { transform: translate(0%, 0%); }
  15% { transform: translate(2.14%, -2.33%); }
  85% { transform: translate(2.14%, -2.33%); }
  100% { transform: translate(0%, 0%); }
}

@keyframes ai-dot-think-eyes-back {
  0% { transform: translate(0%, 0%); }
  15% { transform: translate(0.78%, -1.17%); }
  85% { transform: translate(0.78%, -1.17%); }
  100% { transform: translate(0%, 0%); }
}

@keyframes ai-dot-bubble {
  0% { opacity: 0; }
  8% { opacity: 1; }
  92% { opacity: 1; }
  100% { opacity: 0; }
}

.ai-dot--think .ai-dot-front {
  animation: 3.12s sine-in-out ai-dot-think-front;
}

.ai-dot--think .ai-dot-eyes-front {
  animation: 3.12s sine-in-out ai-dot-think-eyes-front;
}

.ai-dot--think .ai-dot-eyes-back {
  animation: 3.12s sine-in-out ai-dot-think-eyes-back;
}

.ai-dot--think .ai-dot-bubble,
.ai-dot--think .ai-dot-tdot,
.ai-dot--think .ai-dot-ddot {
  display: block;
  opacity: 0;
}

.ai-dot--think .ai-dot-bubble {
  animation: 3.12s linear-in-out ai-dot-bubble;
}

.ai-dot--think .ai-dot-tdot-1,
.ai-dot--think .ai-dot-ddot-1 {
  animation: 3.12s linear-in-out ai-dot-tdot-1;
}

.ai-dot--think .ai-dot-tdot-2,
.ai-dot--think .ai-dot-ddot-2 {
  animation: 3.12s linear-in-out ai-dot-tdot-2;
}

.ai-dot--think .ai-dot-tdot-3,
.ai-dot--think .ai-dot-ddot-3 {
  animation: 3.12s linear-in-out ai-dot-tdot-3;
}

/* Five (high five): the two pull apart and bump together, with happy eyes, and a star bursts where they meet. C keeps
   its eyes open; C and D burst sparkle lines instead of a star. */
@keyframes ai-dot-five-front {
  0% { transform: translate(0%, 0%) rotate(0deg); }
  30% { transform: translate(-2.53%, 2.53%) rotate(-7deg); }
  48% { transform: translate(0.97%, -0.97%) rotate(3deg); }
  62% { transform: translate(0%, 0%) rotate(0deg); }
  100% { transform: translate(0%, 0%) rotate(0deg); }
}

@keyframes ai-dot-five-back {
  0% { transform: translate(0%, 0%) rotate(0deg); }
  30% { transform: translate(4.47%, -4.47%) rotate(9deg); }
  48% { transform: translate(-1.36%, 1.36%) rotate(-4deg); }
  62% { transform: translate(0%, 0%) rotate(0deg); }
  100% { transform: translate(0%, 0%) rotate(0deg); }
}

@keyframes ai-dot-star {
  0% { opacity: 0; transform: scale(0) rotate(0deg); }
  44% { opacity: 0; transform: scale(0) rotate(0deg); }
  52% { opacity: 1; transform: scale(1.25) rotate(20deg); }
  80% { opacity: 0; transform: scale(0.6) rotate(50deg); }
  100% { opacity: 0; transform: scale(0.6) rotate(50deg); }
}

@keyframes ai-dot-spark {
  0% { opacity: 0; transform: scale(0.4); }
  44% { opacity: 0; transform: scale(0.4); }
  52% { opacity: 1; transform: scale(1); }
  80% { opacity: 0; transform: scale(1.15); }
  100% { opacity: 0; transform: scale(1.15); }
}

.ai-dot--five .ai-dot-front {
  animation: 1.95s cubic-in-out ai-dot-five-front;
}

.ai-dot--five .ai-dot-back {
  animation: 1.95s cubic-in-out ai-dot-five-back;
}

.ai-dot--five .ai-dot-star,
.ai-dot--five .ai-dot-spark {
  display: block;
  opacity: 0;
}

.ai-dot--five .ai-dot-star {
  animation: 1.95s cubic-out ai-dot-star;
}

.ai-dot--five .ai-dot-spark {
  animation: 1.95s cubic-out ai-dot-spark;
}

/* Happy: the two jump one after the other (110 units, squash and stretch) with happy eyes and pink cheeks, and two
   hearts float up. Calm: both nod up 18 units one after the other; C keeps the happy eyes, D draws a check in its
   bubble. */
@keyframes ai-dot-jump {
  0% { transform: translateY(0%) scale(1, 1); }
  14% { transform: translateY(0%) scale(1.08, 0.88); }
  38% { transform: translateY(-10.7%) scale(0.94, 1.07); }
  60% { transform: translateY(0%) scale(1.1, 0.86); }
  74% { transform: translateY(0%) scale(0.98, 1.03); }
  86% { transform: translateY(0%) scale(1, 1); }
  100% { transform: translateY(0%) scale(1, 1); }
}

@keyframes ai-dot-nod-calm {
  0% { transform: translateY(0%); }
  30% { transform: translateY(-1.75%); }
  55% { transform: translateY(0%); }
  100% { transform: translateY(0%); }
}

@keyframes ai-dot-heart {
  0% { opacity: 0; transform: translateY(0%) scale(0.4); }
  25% { opacity: 1; transform: translateY(-2.19%) scale(0.55); }
  100% { opacity: 0; transform: translateY(-8.76%) scale(1); }
}

@keyframes ai-dot-check {
  0% { opacity: 1; transform: scaleX(0); }
  40% { opacity: 1; transform: scaleX(1); }
  85% { opacity: 1; transform: scaleX(1); }
  100% { opacity: 0; transform: scaleX(1); }
}

.ai-dot--happy .ai-dot-front {
  animation: 1.69s quadratic-in-out ai-dot-jump;
}

.ai-dot--happy .ai-dot-back {
  animation: 1.69s 0.208s quadratic-in-out ai-dot-jump;
}

.ai-dot--calm.ai-dot--happy .ai-dot-front {
  animation: 2.08s sine-in-out ai-dot-nod-calm;
}

.ai-dot--calm.ai-dot--happy .ai-dot-back {
  animation: 2.08s 0.26s sine-in-out ai-dot-nod-calm;
}

.ai-dot--happy .ai-dot-blush,
.ai-dot--happy .ai-dot-heart,
.ai-dot--happy .ai-dot-check {
  display: block;
  opacity: 0;
}

.ai-dot--happy .ai-dot-blush {
  animation: 2.34s linear-in-out ai-dot-glow-in;
}

.ai-dot--happy .ai-dot-heart-1 {
  animation: 1.69s cubic-out ai-dot-heart;
}

.ai-dot--happy .ai-dot-heart-2 {
  animation: 1.69s 0.65s cubic-out ai-dot-heart;
}

.ai-dot--happy .ai-dot-check {
  animation: 2.08s cubic-out ai-dot-check;
}

/* Private ("I don't read your chats"): it shuts its eyes, the front bubble turns away, the partner steps aside, and a
   lock pops up (D: the lock fills its bubble). */
@keyframes ai-dot-private-front {
  0% { transform: rotate(0deg); }
  30% { transform: rotate(-6deg); }
  80% { transform: rotate(-6deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-private-back {
  0% { transform: translate(0%, 0%) rotate(0deg); }
  30% { transform: translate(1.56%, -0.97%) rotate(6deg); }
  80% { transform: translate(1.56%, -0.97%) rotate(6deg); }
  100% { transform: translate(0%, 0%) rotate(0deg); }
}

@keyframes ai-dot-private-eyes {
  0% { transform: translate(0%, 0%); }
  30% { transform: translate(-1.36%, -0.78%); }
  80% { transform: translate(-1.36%, -0.78%); }
  100% { transform: translate(0%, 0%); }
}

@keyframes ai-dot-lock-in {
  0% { opacity: 1; transform: scale(0); }
  20% { opacity: 1; transform: scale(1.15); }
  28% { opacity: 1; transform: scale(1); }
  82% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(0.6); }
}

.ai-dot--private .ai-dot-front {
  animation: 2.6s sine-in-out ai-dot-private-front;
}

.ai-dot--private .ai-dot-back {
  animation: 2.6s sine-in-out ai-dot-private-back;
}

.ai-dot--private .ai-dot-eyes-front {
  animation: 2.6s sine-in-out ai-dot-private-eyes;
}

.ai-dot--private .ai-dot-lock,
.ai-dot--private .ai-dot-dlock {
  display: block;
  opacity: 0;
  animation: 2.6s cubic-out ai-dot-lock-in;
}

/* Sleep (AiDotModel: only after two minutes without a touch, then it stays asleep): eyes shut, the front bubble nods
   off to one side, one slow breath, and three z's drift up one after another. C's shut eyes glow up and dim, D fades
   to half. Asleep afterwards it holds the end pose without animating (one redraw), until a touch wakes it. */
@keyframes ai-dot-doze {
  0% { transform: rotate(0deg); }
  20% { transform: rotate(-4deg); }
  100% { transform: rotate(-4deg); }
}

@keyframes ai-dot-breathe {
  0% { transform: scale(1, 1); }
  50% { transform: scale(1.03, 0.97); }
  100% { transform: scale(1, 1); }
}

@keyframes ai-dot-breathe-calm {
  0% { transform: translateY(0%); }
  50% { transform: translateY(-0.56%); }
  100% { transform: translateY(0%); }
}

@keyframes ai-dot-fade-plain {
  0% { opacity: 1; transform: translateY(0%); }
  20% { opacity: 0.55; transform: translateY(-0.28%); }
  50% { opacity: 0.55; transform: translateY(-0.56%); }
  100% { opacity: 0.55; transform: translateY(0%); }
}

@keyframes ai-dot-dim-calm {
  0% { opacity: 1; }
  50% { opacity: 0.9; }
  100% { opacity: 0.35; }
}

@keyframes ai-dot-z {
  0% { opacity: 0; transform: translate(0%, 0%); }
  20% { opacity: 1; transform: translate(0.78%, -2.14%); }
  100% { opacity: 0; transform: translate(3.89%, -10.7%); }
}

.ai-dot--sleep .ai-dot-open,
.ai-dot--asleep .ai-dot-open,
.ai-dot--private .ai-dot-open {
  display: none;
}

.ai-dot--sleep .ai-dot-shut,
.ai-dot--asleep .ai-dot-shut,
.ai-dot--private .ai-dot-shut {
  display: block;
}

.ai-dot--asleep .ai-dot-front {
  transform: rotate(-4deg);
}

.ai-dot--calm.ai-dot--asleep .ai-dot-shut {
  opacity: 0.35;
}

.ai-dot--plain.ai-dot--asleep .ai-dot-figure {
  opacity: 0.55;
}

.ai-dot--sleep .ai-dot-front {
  animation: 5.2s sine-in-out ai-dot-doze;
}

.ai-dot--sleep .ai-dot-figure {
  animation: 5.2s sine-in-out ai-dot-breathe;
}

.ai-dot--calm.ai-dot--sleep .ai-dot-figure {
  animation: 5.2s sine-in-out ai-dot-breathe-calm;
}

.ai-dot--plain.ai-dot--sleep .ai-dot-figure {
  animation: 5.2s sine-in-out ai-dot-fade-plain;
}

.ai-dot--calm.ai-dot--sleep .ai-dot-shut {
  animation: 5.2s sine-in-out ai-dot-dim-calm;
}

.ai-dot--sleep .ai-dot-z {
  display: block;
  opacity: 0;
}

.ai-dot--sleep .ai-dot-z-1 {
  animation: 3.12s cubic-out ai-dot-z;
}

.ai-dot--sleep .ai-dot-z-2 {
  animation: 3.12s 1.04s cubic-out ai-dot-z;
}

.ai-dot--sleep .ai-dot-z-3 {
  animation: 3.12s 2.08s cubic-out ai-dot-z;
}

/* Poke (a tap, before the panel opens): the front bubble squashes and wobbles, the eyes go wide. Calm: a small
   squash. */
@keyframes ai-dot-poke {
  0% { transform: scale(1, 1) rotate(0deg); }
  20% { transform: scale(1.1, 0.84) rotate(0deg); }
  40% { transform: scale(0.94, 1.08) rotate(-4deg); }
  60% { transform: scale(1, 1) rotate(4deg); }
  80% { transform: scale(1, 1) rotate(-2deg); }
  100% { transform: scale(1, 1) rotate(0deg); }
}

@keyframes ai-dot-poke-calm {
  0% { transform: scale(1, 1); }
  30% { transform: scale(1.04, 0.95); }
  100% { transform: scale(1, 1); }
}

@keyframes ai-dot-wide-eyes {
  0% { transform: scale(1); }
  40% { transform: scale(1.3); }
  75% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

@keyframes ai-dot-wide-eyes-calm {
  0% { transform: scale(1); }
  40% { transform: scale(1.12); }
  75% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

.ai-dot--poke .ai-dot-front {
  animation: 0.78s cubic-out ai-dot-poke;
}

.ai-dot--poke .ai-dot-eyes-front,
.ai-dot--poke .ai-dot-eyes-back {
  animation: 0.78s cubic-out ai-dot-wide-eyes;
}

.ai-dot--calm.ai-dot--poke .ai-dot-front {
  animation: 0.585s cubic-out ai-dot-poke-calm;
}

.ai-dot--calm.ai-dot--poke .ai-dot-eyes-front,
.ai-dot--calm.ai-dot--poke .ai-dot-eyes-back {
  animation: 0.585s cubic-out ai-dot-wide-eyes-calm;
}

/* Pop (a tap on it tucked): while it slides out of the tuck it jumps once, the mockups' squash-and-stretch jump
   (calm: a small hop); the panel opens when it has landed. */
@keyframes ai-dot-pop {
  0% { transform: translateY(0%) scale(1, 1); }
  15% { transform: translateY(0%) scale(1.08, 0.88); }
  45% { transform: translateY(-12%) scale(0.94, 1.07); }
  72% { transform: translateY(0%) scale(1.1, 0.86); }
  88% { transform: translateY(0%) scale(0.98, 1.03); }
  100% { transform: translateY(0%) scale(1, 1); }
}

@keyframes ai-dot-pop-calm {
  0% { transform: translateY(0%); }
  40% { transform: translateY(-4%); }
  75% { transform: translateY(0%); }
  100% { transform: translateY(0%); }
}

.ai-dot--pop .ai-dot-figure {
  animation: 0.91s quadratic-in-out ai-dot-pop;
}

.ai-dot--calm.ai-dot--pop .ai-dot-figure {
  animation: 0.91s sine-in-out ai-dot-pop-calm;
}

/* Happy eyes: the front ones while waving, all while giving five or happy; the calm looks keep theirs open for wave and
   five (C's happy eyes show for happy). */
.ai-dot--wave .ai-dot-front .ai-dot-open,
.ai-dot--five .ai-dot-open,
.ai-dot--happy .ai-dot-open {
  display: none;
}

.ai-dot--wave .ai-dot-front .ai-dot-hap,
.ai-dot--five .ai-dot-hap,
.ai-dot--happy .ai-dot-hap {
  display: block;
}

.ai-dot--calm.ai-dot--wave .ai-dot-front .ai-dot-open,
.ai-dot--calm.ai-dot--five .ai-dot-open {
  display: block;
}

.ai-dot--calm.ai-dot--wave .ai-dot-front .ai-dot-hap,
.ai-dot--calm.ai-dot--five .ai-dot-hap,
.ai-dot--calm.ai-dot--wave .ai-dot-blush {
  display: none;
}

/* The weekend looks (DEV/ui-mockups/mascot-weekend.html; classes `ai-dot--look-e/f/g` from the shell dot's binding and
   ShellHomeMascot). They are the face looks (not calm) with their own motions where the mockup has them, and the same
   lengths as AiDotModel, except G (Sunday), whose slower actions are AiDotModel::kTalkSlowMs, kWaveSlowMs, kFiveSlowMs,
   kHappySlowMs, kPokeSlowMs and kFloatSlowMs. The mockup's endless loops (E's sway, G's breathing, the pompom, the steam)
   are one timed action here: E's sway is its Float, G's breathing its Float and Sleep, the pompom swings and the steam
   rises during G's Float and Sleep. Accessories are layers: E's glasses are in the eye groups (they follow the eyes'
   keyframes, not the blink), F's cap and G's nightcap and pompom ride the front bubble, G's mug is part of the figure.
   Mockup units: in a part or layer 1 unit is 0.0973%, in the figure 0.1111%. */
.ai-dot-steam {
  display: none;
}

.ai-dot-pom {
  transform-origin: 18.3% 41%;
}

.ai-dot-steam-1 {
  transform-origin: 68.7% 73.5%;
}

.ai-dot-steam-2 {
  transform-origin: 71.8% 73.5%;
}

.ai-dot--blink .ai-dot-glasses {
  animation: none;
}

/* E (Friday): a lazy sway, a gentle wave, a nod instead of the jump. */
@keyframes ai-dot-lazy-e {
  0% { transform: translate(0%, 0%) rotate(0deg); }
  30% { transform: translate(-0.56%, 0%) rotate(-4deg); }
  70% { transform: translate(0.67%, -0.33%) rotate(2deg); }
  100% { transform: translate(0%, 0%) rotate(0deg); }
}

@keyframes ai-dot-wave-e {
  0% { transform: rotate(0deg); }
  22% { transform: rotate(-5deg); }
  48% { transform: rotate(4deg); }
  74% { transform: rotate(-4deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-hop-e {
  0% { transform: translateY(0%); }
  25% { transform: translateY(-1.36%); }
  50% { transform: translateY(0%); }
  100% { transform: translateY(0%); }
}

@keyframes ai-dot-nod-e {
  0% { transform: translateY(0%) rotate(0deg); }
  35% { transform: translateY(1.17%) rotate(5deg); }
  65% { transform: translateY(0.19%) rotate(-1deg); }
  100% { transform: translateY(0%) rotate(0deg); }
}

.ai-dot--look-e.ai-dot--float .ai-dot-figure {
  animation: 3.25s sine-in-out ai-dot-lazy-e;
}

.ai-dot--look-e.ai-dot--wave .ai-dot-front {
  animation: 2.08s sine-in-out ai-dot-wave-e;
}

.ai-dot--look-e.ai-dot--wave .ai-dot-back {
  animation: 2.08s sine-in-out ai-dot-hop-e;
}

.ai-dot--look-e.ai-dot--happy .ai-dot-front {
  animation: 2.08s sine-in-out ai-dot-nod-e;
}

.ai-dot--look-e.ai-dot--happy .ai-dot-back {
  animation: 2.08s 0.26s sine-in-out ai-dot-nod-e;
}

/* F (Saturday): the liveliest: a big wave and higher hops, a bigger high five, a jump of 190 units, a flatter poke. */
@keyframes ai-dot-wave-f {
  0% { transform: rotate(0deg); }
  15% { transform: rotate(-15deg); }
  35% { transform: rotate(12deg); }
  55% { transform: rotate(-15deg); }
  75% { transform: rotate(9deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-hop-f {
  0% { transform: translateY(0%); }
  20% { transform: translateY(-6.03%); }
  40% { transform: translateY(0%); }
  60% { transform: translateY(0%); }
  70% { transform: translateY(-3.7%); }
  80% { transform: translateY(0%); }
  100% { transform: translateY(0%); }
}

@keyframes ai-dot-five-front-f {
  0% { transform: translate(0%, 0%) rotate(0deg); }
  30% { transform: translate(-3.5%, 3.31%) rotate(-10deg); }
  48% { transform: translate(1.36%, -1.75%) rotate(4deg); }
  62% { transform: translate(0%, 0%) rotate(0deg); }
  100% { transform: translate(0%, 0%) rotate(0deg); }
}

@keyframes ai-dot-five-back-f {
  0% { transform: translate(0%, 0%) rotate(0deg); }
  30% { transform: translate(6.03%, -6.03%) rotate(12deg); }
  48% { transform: translate(-1.75%, 1.75%) rotate(-5deg); }
  62% { transform: translate(0%, 0%) rotate(0deg); }
  100% { transform: translate(0%, 0%) rotate(0deg); }
}

@keyframes ai-dot-jump-f {
  0% { transform: translateY(0%) scale(1, 1); }
  14% { transform: translateY(0%) scale(1.14, 0.8); }
  38% { transform: translateY(-18.49%) scale(0.92, 1.1); }
  60% { transform: translateY(0%) scale(1.16, 0.8); }
  74% { transform: translateY(0%) scale(0.97, 1.05); }
  86% { transform: translateY(0%) scale(1, 1); }
  100% { transform: translateY(0%) scale(1, 1); }
}

@keyframes ai-dot-poke-f {
  0% { transform: scale(1, 1) rotate(0deg); }
  18% { transform: scale(1.24, 0.68) rotate(0deg); }
  38% { transform: scale(0.88, 1.16) rotate(-6deg); }
  58% { transform: scale(1, 1) rotate(6deg); }
  80% { transform: scale(1, 1) rotate(-3deg); }
  100% { transform: scale(1, 1) rotate(0deg); }
}

@keyframes ai-dot-wide-eyes-f {
  0% { transform: scale(1); }
  40% { transform: scale(1.4); }
  75% { transform: scale(1.4); }
  100% { transform: scale(1); }
}

.ai-dot--look-f.ai-dot--wave .ai-dot-front {
  animation: 2.08s sine-in-out ai-dot-wave-f;
}

.ai-dot--look-f.ai-dot--wave .ai-dot-back {
  animation: 2.08s sine-in-out ai-dot-hop-f;
}

.ai-dot--look-f.ai-dot--five .ai-dot-front {
  animation: 1.95s cubic-in-out ai-dot-five-front-f;
}

.ai-dot--look-f.ai-dot--five .ai-dot-back {
  animation: 1.95s cubic-in-out ai-dot-five-back-f;
}

.ai-dot--look-f.ai-dot--happy .ai-dot-front {
  animation: 1.56s quadratic-in-out ai-dot-jump-f;
}

.ai-dot--look-f.ai-dot--happy .ai-dot-back {
  animation: 1.56s 0.18s quadratic-in-out ai-dot-jump-f;
}

.ai-dot--look-f.ai-dot--poke .ai-dot-front {
  animation: 0.78s cubic-out ai-dot-poke-f;
}

.ai-dot--look-f.ai-dot--poke .ai-dot-eyes-front,
.ai-dot--look-f.ai-dot--poke .ai-dot-eyes-back {
  animation: 0.78s cubic-out ai-dot-wide-eyes-f;
}

/* G (Sunday): slow. One slow breath is its Float and its Sleep; the talk is a yawn with shut eyes; waving and giving five
   keep the eyes (half) open; the pompom swings and the mug steams during the breath. */
@keyframes ai-dot-breathe-g {
  0% { transform: scale(1, 1); }
  50% { transform: scale(1.035, 0.965); }
  100% { transform: scale(1, 1); }
}

@keyframes ai-dot-wave-g {
  0% { transform: rotate(0deg); }
  25% { transform: rotate(-4deg); }
  55% { transform: rotate(3deg); }
  80% { transform: rotate(-2deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-hop-g {
  0% { transform: translateY(0%); }
  25% { transform: translateY(-0.97%); }
  50% { transform: translateY(0%); }
  100% { transform: translateY(0%); }
}

@keyframes ai-dot-yawn-g {
  0% { opacity: 0; transform: scale(0.5, 0.2); }
  10% { opacity: 1; transform: scale(0.6, 0.5); }
  35% { opacity: 1; transform: scale(1.5, 2.7); }
  62% { opacity: 1; transform: scale(1.5, 2.7); }
  90% { opacity: 1; transform: scale(0.5, 0.2); }
  100% { opacity: 0; transform: scale(0.5, 0.2); }
}

@keyframes ai-dot-rise-g {
  0% { transform: translateY(0%) scale(1, 1); }
  45% { transform: translateY(-3.5%) scale(0.98, 1.03); }
  100% { transform: translateY(0%) scale(1, 1); }
}

@keyframes ai-dot-pom-g {
  0% { transform: translate(0%, 0%); }
  50% { transform: translate(-0.58%, 0.49%); }
  100% { transform: translate(0%, 0%); }
}

@keyframes ai-dot-steam-g {
  0% { opacity: 0; transform: translateY(0.78%); }
  35% { opacity: 0.9; transform: translateY(-0.5%); }
  100% { opacity: 0; transform: translateY(-2.14%); }
}

.ai-dot--look-g.ai-dot--float .ai-dot-figure,
.ai-dot--look-g.ai-dot--sleep .ai-dot-figure {
  animation: 5.2s sine-in-out ai-dot-breathe-g;
}

.ai-dot--look-g.ai-dot--float .ai-dot-pom,
.ai-dot--look-g.ai-dot--sleep .ai-dot-pom {
  animation: 1.3s sine-in-out 4 ai-dot-pom-g;
}

.ai-dot--look-g.ai-dot--float .ai-dot-steam,
.ai-dot--look-g.ai-dot--sleep .ai-dot-steam {
  display: block;
  opacity: 0;
}

.ai-dot--look-g.ai-dot--float .ai-dot-steam-1,
.ai-dot--look-g.ai-dot--sleep .ai-dot-steam-1 {
  animation: 2.6s cubic-out 2 ai-dot-steam-g;
}

.ai-dot--look-g.ai-dot--float .ai-dot-steam-2,
.ai-dot--look-g.ai-dot--sleep .ai-dot-steam-2 {
  animation: 2.6s 1.3s cubic-out ai-dot-steam-g;
}

.ai-dot--look-g.ai-dot--wave .ai-dot-front {
  animation: 2.6s sine-in-out ai-dot-wave-g;
}

.ai-dot--look-g.ai-dot--wave .ai-dot-back {
  animation: 2.6s sine-in-out ai-dot-hop-g;
}

.ai-dot--look-g.ai-dot--wave .ai-dot-pom {
  animation: 1.3s sine-in-out 2 ai-dot-pom-g;
}

.ai-dot--look-g.ai-dot--five .ai-dot-front {
  animation: 2.86s cubic-in-out ai-dot-five-front;
}

.ai-dot--look-g.ai-dot--five .ai-dot-back {
  animation: 2.86s cubic-in-out ai-dot-five-back;
}

.ai-dot--look-g.ai-dot--five .ai-dot-star {
  animation: 2.86s cubic-out ai-dot-star;
}

.ai-dot--look-g.ai-dot--talk .ai-dot-mouth {
  animation: 3.12s sine-in-out ai-dot-yawn-g;
}

.ai-dot--look-g.ai-dot--talk .ai-dot-eyes-front {
  animation: 3.12s sine-in-out ai-dot-talk-eyes;
}

.ai-dot--look-g.ai-dot--talk .ai-dot-back {
  animation: 1.56s sine-in-out 2 ai-dot-nod;
}

.ai-dot--look-g.ai-dot--talk .ai-dot-pom {
  animation: 1.04s sine-in-out 3 ai-dot-pom-g;
}

.ai-dot--look-g.ai-dot--happy .ai-dot-front {
  animation: 2.86s sine-in-out ai-dot-rise-g;
}

.ai-dot--look-g.ai-dot--happy .ai-dot-back {
  animation: 2.86s 0.26s sine-in-out ai-dot-rise-g;
}

.ai-dot--look-g.ai-dot--happy .ai-dot-blush {
  animation: 3.12s linear-in-out ai-dot-glow-in;
}

.ai-dot--look-g.ai-dot--happy .ai-dot-heart-1 {
  animation: 2.08s cubic-out ai-dot-heart;
}

.ai-dot--look-g.ai-dot--happy .ai-dot-heart-2 {
  animation: 2.08s 1.04s cubic-out ai-dot-heart;
}

.ai-dot--look-g.ai-dot--happy .ai-dot-pom {
  animation: 1.04s sine-in-out 3 ai-dot-pom-g;
}

.ai-dot--look-g.ai-dot--poke .ai-dot-front {
  animation: 1.04s cubic-out ai-dot-poke;
}

.ai-dot--look-g.ai-dot--poke .ai-dot-eyes-front,
.ai-dot--look-g.ai-dot--poke .ai-dot-eyes-back {
  animation: 1.04s cubic-out ai-dot-wide-eyes;
}

/* G waves and gives five with its (half) open eyes, and yawns with them shut. */
.ai-dot--look-g.ai-dot--wave .ai-dot-front .ai-dot-open,
.ai-dot--look-g.ai-dot--five .ai-dot-open {
  display: block;
}

.ai-dot--look-g.ai-dot--wave .ai-dot-front .ai-dot-hap,
.ai-dot--look-g.ai-dot--five .ai-dot-hap {
  display: none;
}

.ai-dot--look-g.ai-dot--talk .ai-dot-open {
  display: none;
}

.ai-dot--look-g.ai-dot--talk .ai-dot-shut {
  display: block;
}

.shell-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  padding: 8dp 12dp;
}

.shell-banner-text {
  flex: 1;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

.shell-banner-dismiss {
  width: auto;
  min-width: 32dp;
  padding: 4dp 10dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-toast-stack {
  position: absolute;
  top: 8dp;
  right: 12dp;
  z-index: 110;
}

.shell-toast {
  padding: 10dp 14dp;
  margin-bottom: 8dp;
  border-radius: 8dp;
}

.shell-toast-text {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

/* Phone toast (Kenneth 2026-11-04: the dark slab top right looked stuck on): a centred pill near the bottom,
   above the tab bar / composer. The chrome box fills the body (it lets taps through) so ShellHost can set the
   stack's `bottom` (CompactChromeLayout::toast_bottom_dp); the pills let taps through too. */
.shell-body--compact .shell-chrome {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-body--compact .shell-toast-stack {
  left: 0;
  right: 0;
  display: block;
  text-align: center;
  pointer-events: none;
}

.shell-body--compact .shell-chrome .shell-toast {
  display: inline-block;
  max-width: 80%;
  border-width: 1dp;
  padding: 10dp 18dp;
  margin: 6dp 0 0 0;
  border-radius: 20dp;
  box-sizing: border-box;
  pointer-events: none;
}

.shell-body--compact .shell-toast-text {
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

.shell-activity-strip {
  height: 3dp;
  opacity: 0.85;
}

.shell-statusbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 24dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12dp;
  padding: 0 12dp;
  box-sizing: border-box;
  border-top-width: 1dp;
  border-top-style: solid;
  z-index: 50;
}

.shell-statusbar-cluster {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  min-width: 0;
  overflow: hidden;
  padding: 2dp 6dp;
  margin-left: -6dp;
  border-radius: 4dp;
  cursor: pointer;
}

.shell-statusbar-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  flex-shrink: 0;
  min-width: 0;
}

.shell-statusbar-divider {
  width: 1dp;
  height: 12dp;
  flex-shrink: 0;
}

.shell-statusbar-slot {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.shell-statusbar-brief svg,
.shell-statusbar-direct svg,
.shell-statusbar-help svg,
.shell-statusbar-inbound svg {
  width: 12dp;
  height: 12dp;
}

.shell-statusbar-label,
.shell-statusbar-load {
  margin-top: 0;
  margin-bottom: 0;
  white-space: nowrap;
  overflow: hidden;
}

.shell-statusbar-label {
  margin-left: 0;
}

.shell-statusbar-load {
  flex-shrink: 0;
}

.shell-statusbar-popover-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 54;
}

.shell-statusbar-popover {
  position: absolute;
  left: 8dp;
  bottom: 32dp;
  width: 320dp;
  max-width: 90%;
  padding: 12dp;
  gap: 8dp;
  box-sizing: border-box;
  border-width: 1dp;
  border-radius: 8dp;
  z-index: 55;
}

.shell-statusbar-popover-title {
  margin-top: 0;
  margin-bottom: 4dp;
  font-weight: bold;
}

.shell-statusbar-popover-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12dp;
}

.shell-statusbar-popover-key {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  min-width: 0;
  flex-shrink: 1;
}

.shell-statusbar-popover-row p {
  margin-top: 0;
  margin-bottom: 0;
}

.shell-statusbar-popover-actions {
  margin-top: 4dp;
  gap: 8dp;
  flex-wrap: wrap;
}

.shell-statusbar-popover-actions .btn {
  flex-grow: 1;
  min-height: 36dp;
}

.shell-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-pane-row {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.shell-nav-rail {
  flex: 0 0 72dp;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.shell-nav-rail--compact {
  flex: 0 0 auto;
  flex-direction: row;
  width: 100%;
  height: 49dp;
  box-sizing: border-box;
  background-color: transparent;
}

.shell-nav-rail-inner {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: flex-start;
  gap: 0;
  padding: 8dp 4dp;
  box-sizing: border-box;
}

/* Phone tab bar: four equal-width tabs, no pills. */
.shell-nav-rail--compact .shell-nav-rail-inner {
  flex-direction: row;
  justify-content: space-between;
  align-items: stretch;
  height: 49dp;
  padding: 0;
}

.shell-nav-spacer {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
}

.shell-nav-rail--compact .shell-nav-spacer {
  display: none;
}

.shell-nav-tab {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2dp;
  width: 52dp;
  height: 56dp;
  min-width: 52dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 10dp;
  cursor: pointer;
  focus: none;
}

.shell-nav-rail--compact .shell-nav-tab {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  height: 49dp;
  border-radius: 0;
  gap: 2dp;
}

.shell-nav-tab svg {
  flex-shrink: 0;
}

/* Collapse / expand the list pane; sits at the bottom of the expanded rail. */
.shell-nav-collapse {
  height: 28dp;
}

.shell-nav-tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.shell-nav-tab-label {
  margin: 0;
  padding: 0;
  font-size: 10dp;
  text-align: center;
  line-height: 1.1;
}

/* Phone tab bar (DEV/PLAN-minimal-nav.md A, Kenneth 2026-11-07): two words, no icons, 48dp; the chosen one bold. The
   Chats unread count sits at the word's top right. */
.shell-nav-rail--text,
.shell-nav-rail--text .shell-nav-rail-inner,
.shell-nav-rail--text .shell-nav-tab {
  height: 48dp;
}

.shell-nav-tab-text-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shell-nav-rail--text .shell-nav-tab-label {
  font-size: 16dp;
  line-height: 20dp;
}

.shell-nav-rail--text .shell-nav-tab--active .shell-nav-tab-label {
  font-weight: bold;
}

.shell-nav-rail--text .badge-count--text {
  top: -8dp;
  right: -20dp;
}

.shell-nav-page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: 49dp;
}

.shell-nav-page .shell-pane-body {
  height: 100%;
}

.shell-nav-page--home .shell-pane-body {
  flex: 1;
  min-height: 0;
  height: auto;
}

/* Root-page nav bar + large title (DESIGN-pp-ui 4.1 / 8.1). Phone layout only: on desktop the panes keep their own
   headers and these parts stay hidden. The nav bar floats over the scroller (padding-top clears it), its background
   and bottom separator fade in once the large title has scrolled away (.large-title-collapsed on the nav page). */
.pane-nav,
.large-title {
  display: none;
}

.shell-layer-compact .sidebar-header,
.shell-layer-compact .settings-header,
.shell-layer-compact .contacts-header {
  display: none;
}

.shell-layer-compact .sidebar-panel,
.shell-layer-compact .contacts-panel,
.shell-layer-compact .settings-panel,
.shell-layer-compact .home-panel {
  position: relative;
  padding-top: 0;
}

.shell-layer-compact .pane-nav {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 44dp;
  z-index: 3;
}

.pane-nav-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 44dp;
  box-sizing: border-box;
  opacity: 0;
  transition: opacity 0.2s cubic-out;
}

.shell-nav-page.large-title-collapsed .pane-nav-bg {
  opacity: 1;
}

.pane-nav-title {
  position: absolute;
  top: 0;
  left: 96dp;
  right: 96dp;
  height: 44dp;
  margin: 0;
  font-size: 17dp;
  line-height: 52dp;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  opacity: 0;
  transition: opacity 0.2s cubic-out;
}

.shell-nav-page.large-title-collapsed .pane-nav-title {
  opacity: 1;
}

/* Phone hidden tab's root page (Settings, Contacts; DEV/PLAN-minimal-nav.md A): its bar holds the round back on the
   left and the title in the middle at all times, so the page has no large title; no tab bar under it, so the spacer
   at the end of its list only keeps the last row off the screen edge. */
.shell-nav-page--hidden-tab .pane-nav-title {
  opacity: 1;
}

.shell-nav-page--hidden-tab .large-title {
  display: none;
}

.shell-nav-page--hidden-tab .tab-bar-clear {
  height: 16dp;
}

/* Settings keeps the tab bar (TODO #200): its list clears the bar again like a tab's page. */
.shell-nav-page--hidden-tab.shell-nav-page--tab-bar .tab-bar-clear {
  height: 65dp;
}

/* Over a page pushed from Settings (above the transient layer, z-index 30) so the bar stays put while the page slides. */
.shell-bottom-chrome--over-page {
  z-index: 35;
}

.shell-layer-compact .pane-nav-back {
  position: absolute;
  top: 2dp;
  left: 12dp;
  z-index: 1;
}

/* Phone bars (Kenneth 2026-11-04, PLAN-ui-refresh-impl 65-67): no hairline under a top bar or over the tab bar; a
   16dp fade from the bar colour to clear takes its place (colors-*.rcss), on every top bar, the tab bar and the
   composer alike. With Transparency on, the bar that is on top is frosted (a see-through bar colour plus blur, only
   on the bar itself) and the page scrolls under it; off, or under a dialog, the bars are solid. */
.bar-fade {
  display: none;
}

.shell-layer-compact .bar-fade {
  display: block;
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  height: 16dp;
  pointer-events: none;
}

/* Above a bottom bar (the tab bar), fading down into it. */
.shell-layer-compact .bar-fade--up {
  top: auto;
  bottom: 100%;
}

/* A tab page's fade shows with its bar, once the large title has scrolled away. */
.pane-nav .bar-fade {
  opacity: 0;
  transition: opacity 0.2s cubic-out;
}

.shell-nav-page.large-title-collapsed .pane-nav .bar-fade {
  opacity: 1;
}

/* Frosted only while the bar shows (at rest it is clear). */
.shell-nav-page--frost.large-title-collapsed .pane-nav-bg {
  backdrop-filter: blur(20px);
}

/* Home's tab bar sits under its opaque dock, which has its own fade. */
.shell-bottom-chrome--home .bar-fade {
  display: none;
}

.pane-nav-actions {
  position: absolute;
  top: 2dp;
  right: 12dp;
  height: 52dp;
  align-items: center;
}

/* Wraps a button whose event lives in the window model (e.g. Scan QR on Contacts). */
.pane-nav-btn-wrap {
  display: flex;
}

.pane-nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
}

.pane-nav-btn svg {
  width: 24dp;
  height: 24dp;
}

.shell-layer-compact .large-title {
  display: block;
  flex-shrink: 0;
  height: 52dp;
  margin: 0;
  padding: 0 4dp;
  font-size: 34dp;
  line-height: 41dp;
  font-weight: bold;
}

/* The whole page scrolls (large title, search, rows), not just its list. It runs under the nav bar and the 49dp tab
   bar (ShellHost pads the nav page by the home-indicator strip only): its top padding keeps the first row clear of
   the bar; the engine leaves a scroller's own bottom padding out of its scroll height, so the last row is kept clear
   of the tab bar by a spacer at the end of the page (.tab-bar-clear: 49dp + 16dp; Kenneth 2026-11-05 原话 94). */
.shell-layer-compact .sidebar-sessions,
.shell-layer-compact .contacts-list-view,
.shell-layer-compact .settings-list-view {
  overflow-y: auto;
  padding-top: 44dp;
  padding-bottom: 0;
  box-sizing: border-box;
}

.tab-bar-clear {
  display: none;
}

.shell-layer-compact .tab-bar-clear {
  display: block;
  flex: none;
  height: 65dp;
}

.shell-layer-compact .contacts-list-view,
.shell-layer-compact .settings-list-view {
  display: block;
}

.shell-layer-compact .contacts-list,
.shell-layer-compact .settings-list {
  flex: none;
  overflow-y: visible;
}

.shell-pane-home {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.shell-pane-home .shell-pane-body {
  flex: 1;
  min-height: 0;
  height: auto;
}

/* Page push / back (DESIGN-pp-ui §7): 0.3s ease-out slide from / to the right. ShellHost adds
   .shell-page-enter once after the page is built; the swipe gesture and BeginAnimatedDismiss set an inline
   transform and the transition below runs it. Dragging turns the transition off so the page follows the finger. */
@keyframes shell-page-in {
  from { transform: translateX(100%); }
  to { transform: translateX(0%); }
}

.shell-page-enter {
  animation: 0.3s cubic-out shell-page-in;
}

.shell-chat-overlay,
.shell-layer-transient,
.settings-detail-view {
  transition: transform 0.3s cubic-out;
}

.shell-chat-overlay.shell-swipe-dragging,
.shell-layer-transient.shell-swipe-dragging,
.settings-detail-view.shell-swipe-dragging {
  transition: none;
}

.shell-chat-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateX(0);
}

.shell-chat-overlay.shell-swipe-dragging,
.shell-chat-overlay--dragging {
}

/* Phone chat: ONE nav bar (DESIGN-pp-ui 8.1), 56dp at rest. This row is the bar's material and the back button;
   the chat pane's own header row is lifted onto it, right of the button (see .chat-header below). */
.shell-chat-overlay-chrome {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  flex-shrink: 0;
  align-items: center;
  height: 56dp;
  padding: 0;
  box-sizing: border-box;
}

.shell-layer-compact .shell-chat-overlay-chrome {
  padding-left: 12dp;
}

.shell-chat-overlay-chrome .shell-back-btn {
  position: relative;
}

.shell-chat-overlay-chrome .shell-back-btn,
.shell-layer-compact .shell-transient-chrome .shell-back-btn {
  width: 52dp;
  height: 52dp;
  min-width: 52dp;
  border-radius: 0;
}

.shell-chat-overlay .shell-pane-body {
  flex: 1;
  min-height: 0;
  padding-top: 56dp;
  box-sizing: border-box;
}

.shell-chat-overlay .chat-panel {
  padding-top: 0;
  padding-bottom: 0;
}

.shell-chat-overlay .chat-header {
  position: relative;
  z-index: 3;
  height: 55dp;
  margin: -56dp -12dp 8dp 52dp;
  padding: 0 8dp 0 0;
  border-radius: 0;
  border-left-width: 0;
  overflow: hidden;
}

.shell-chat-overlay .chat-header-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
}

.shell-chat-overlay .chat-header-text {
  flex: 1;
  min-width: 0;
}

.shell-chat-overlay .chat-header-type-icon {
  display: none;
}

.shell-chat-overlay .chat-header-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 40dp;
  height: 40dp;
  border-radius: 20dp;
  overflow: hidden;
}

.shell-chat-overlay .chat-header-avatar .avatar-photo {
  width: 40dp;
  height: 40dp;
}

.shell-chat-overlay .chat-header-avatar .chat-row-avatar-letter {
  font-size: 17dp;
  line-height: 22dp;
}

.shell-chat-overlay .chat-header-avatar .chat-row-avatar-icon {
  width: 22dp;
  height: 22dp;
}

.shell-chat-overlay .chat-header-title {
  font-size: 18dp;
  line-height: 23dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Phones: no encryption / link-path line; a group shows only its member count. */
.shell-chat-overlay .chat-header-meta-row {
  display: none;
}

.shell-chat-overlay .chat-header-phone-subtitle {
  display: block;
  margin: 0;
  font-size: 12dp;
  line-height: 15dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-chat-overlay .chat-header-subtitle {
  font-size: 13dp;
  line-height: 16dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-chat-overlay .chat-header-actions {
  gap: 0;
}

.shell-chat-overlay .chat-header-call-btn,
.shell-chat-overlay .chat-header-more-btn {
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  border-radius: 0;
}

.shell-chat-overlay .chat-header-call-btn svg,
.shell-chat-overlay .chat-header-more-btn svg {
  width: 26dp;
  height: 26dp;
}

.shell-chat-overlay .chat-header-call-btn--join {
  width: auto;
  height: 32dp;
  min-width: 0;
  border-radius: 16dp;
}

.chat-header-avatar,
.chat-header-phone-subtitle {
  display: none;
}

/* Phone chat header hides on scroll (Kenneth 2026-11-05, PLAN-ui-refresh-impl 原话 78, 80; NavBarCollapseModel): read
   away from the newest messages and the whole bar (material, back arrow, header row) slides up out of view; scroll back
   towards the newest, or reach them, and it slides back. The overlay clips at the screen's top inset, so nothing runs
   under the clock. Nothing is laid out again: transforms only, the transcript runs under the bar either way and keeps
   its scroll position. A call bar or a banner moves up into the bar's place. ShellNavBarScroll sets .chat-bar-hidden
   (never while searching in the chat: the search field is in the bar). */
.shell-chat-overlay-chrome,
.shell-chat-overlay .chat-header,
.shell-chat-overlay .chat-call-bar,
.shell-chat-overlay .chat-gap-banner {
  transition: transform 0.25s cubic-out;
}

/* Up by the 56dp bar and its 16dp fade. Hidden, it takes no taps. */
.shell-chat-overlay.chat-bar-hidden .shell-chat-overlay-chrome,
.shell-chat-overlay.chat-bar-hidden .chat-header {
  transform: translateY(-72dp);
  pointer-events: none;
}

.shell-chat-overlay.chat-bar-hidden .chat-call-bar,
.shell-chat-overlay.chat-bar-hidden .chat-gap-banner {
  transform: translateY(-63dp);
}

/* Phones: a group call goes on here (DEV/PLAN-ui-batch8-group-pages.md 4). A 44dp bar under the header: a dot, what
   call it is, and the header's own green "Join" pill inside a 44dp target. */
.chat-call-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  height: 44dp;
  padding: 0 8dp 0 16dp;
  box-sizing: border-box;
}

.chat-call-bar-dot {
  flex-shrink: 0;
  width: 8dp;
  height: 8dp;
  border-radius: 4dp;
}

.chat-call-bar-text {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-call-bar-join {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  cursor: pointer;
}

/* The composer bar is clear (TODO #202, Kenneth 2026-11-09): only the floating pill and the two round buttons are
   drawn, the transcript runs down under it; ChatController::SyncComposerOverlay keeps its end spacer and the "new
   messages" pill above the bar. */
.shell-chat-overlay .shell-composer-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
}

/* Above the bar's material child (a static box would paint under it). */
.shell-chat-overlay .shell-composer-mount {
  position: relative;
}

.shell-pane {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

/* May shrink (down to its minimum) so a wide list never squeezes the primary pane to nothing. */
.shell-pane-secondary {
  flex: 0 1 240dp;
  min-width: 200dp;
}

/* Width is overridden by the inline style from ShellHost (user-resizable); collapsed hides the pane. */
.shell-pane-secondary--collapsed {
  display: none;
}

/* Drag handle between secondary and primary: 6dp hit area straddling the pane border, zero layout width. */
.shell-splitter {
  position: relative;
  z-index: 3;
  flex: 0 0 6dp;
  width: 6dp;
  height: 100%;
  margin: 0 -3dp;
  cursor: ew-resize;
}

/* The floor makes the shrinkable list / auxiliary panes absorb a narrow window instead of the chat pane. */
.shell-pane-primary {
  flex: 1;
  min-width: 240dp;
}

.shell-pane-auxiliary {
  flex: 0 1 320dp;
  min-width: 280dp;
}

.shell-layer-compact {
  display: flex;
  flex-direction: column;
}

.shell-pane-primary-compact {
  flex: 1;
  min-height: 0;
}

.shell-pane-composer {
  flex-shrink: 0;
}

.shell-bottom-chrome {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  z-index: 15;
  box-sizing: border-box;
}

.shell-composer-mount {
  flex-shrink: 0;
}

.shell-composer-mount .prompt-composer {
  margin-bottom: 8dp;
}

.shell-composer-mount.surface-chrome {
  padding-top: 8dp;
  box-sizing: border-box;
}

.shell-composer-mount.surface-chrome .prompt-composer {
  margin-bottom: 8dp;
}

/* The phone chat's bar: 8dp above the pill, the home-indicator inset below
   (ShellHost pads the mount), 6dp past the pill. */
.shell-chat-overlay .shell-composer-mount.surface-chrome .prompt-composer {
  margin-bottom: 6dp;
}

.shell-drawer .shell-pane,
.shell-sheet .shell-pane {
  height: 100%;
}

.shell-sheet-compact {
  border-radius: 16dp 0 0 16dp;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.shell-sheet-compact-chrome {
  flex-shrink: 0;
  height: 8dp;
  box-sizing: border-box;
}

.shell-sheet-compact .shell-pane {
  flex: 1;
  min-height: 0;
}

.shell-pane-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.shell-drawer-scrim,
.shell-sheet-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* Must sit above .shell-chat-overlay (25) so compact working-set / Details sheet
     is visible while chat is open (WINDOW_SHELL interruption: aux > chat). */
  z-index: 26;
  focus: none;
}

.shell-drawer {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 280dp;
  max-width: 85%;
  z-index: 27;
}

.shell-sheet {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 320dp;
  max-width: 90%;
  z-index: 27;
}

.shell-toolbar {
  flex-shrink: 0;
  height: 48dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 8dp;
  box-sizing: border-box;
}

.shell-toolbar-flex {
  flex: 1;
}

.shell-toolbar-title {
  font-size: 14dp;
  text-align: center;
}

.shell-layer-compact .shell-transient-chrome {
  padding: 0 0 0 12dp;
}

.shell-transient-chrome {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  flex-shrink: 0;
  min-height: 48dp;
  padding: 4dp 4dp;
  box-sizing: border-box;
}

.shell-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  padding: 0;
  margin-bottom: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-back-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

/* Phone round button (DEV/PLAN-minimal-nav.md G, Kenneth 2026-11-07 "像苹果一样"): a 52dp target around a 44dp raised disc
   (a soft top-to-bottom gradient and a faint shadow) holding a 24dp icon, the disc 16dp from the screen edge; darker while pressed (colors-*.rcss). Back, menu, avatar, plus, new, close alike. The desktop
   keeps its own buttons. */
.shell-circle-btn-face {
  display: flex;
  align-items: center;
  justify-content: center;
}

.shell-layer-compact .shell-circle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52dp;
  height: 52dp;
  min-width: 52dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  cursor: pointer;
}

.shell-layer-compact .shell-circle-btn-face {
  width: 44dp;
  height: 44dp;
  border-radius: 22dp;
}

.shell-layer-compact .shell-circle-btn-face svg {
  flex-shrink: 0;
  width: 24dp;
  height: 24dp;
}

/* Phone AI drawer (DEV/PLAN-minimal-nav.md C): the AI conversation list slides in from the left over the AI page,
   86% wide and full height, the rest of the page (and the tab bar under it) dimmed by the scrim; a soft shadow on its
   right edge (colors-*.rcss). Above the tab bar (15) and the chat overlay (25), under pushed pages (30), the call bar
   (45) and dialogs (50). The empty host takes no taps. */
.shell-drawer-host {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 28;
  pointer-events: none;
}

.shell-drawer-host .shell-layer {
  pointer-events: auto;
}

@keyframes shell-drawer-in {
  from { transform: translateX(-100%); }
  to { transform: translateX(0%); }
}

@keyframes shell-drawer-scrim-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.shell-drawer {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 86%;
  transform: translateX(0%);
  transition: transform 0.25s cubic-out;
}

.shell-drawer-layer--enter .shell-drawer {
  animation: 0.25s cubic-out shell-drawer-in;
}

.shell-drawer-layer--enter .shell-scrim {
  animation: 0.25s cubic-out shell-drawer-scrim-in;
}

.shell-drawer-edge {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 100%;
  width: 12dp;
  pointer-events: none;
}

.shell-drawer-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
}

.ai-drawer {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}

/* The frosted top bar (title 44dp + search 44dp) and "you" row (56dp) float over the list (colors.rcss.tmpl). */
.ai-drawer-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
}

.ai-drawer-search {
  margin: 6dp 16dp 12dp 16dp; /* Kenneth 2026-11-09: air between the title row and the search box */
  padding: 0 0 0 8dp;
}

.ai-drawer-search .chat-search-label {
  left: 14dp;
}

.ai-drawer-search-go {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 36dp;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
}

.ai-drawer-head {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 52dp;
  padding: 0 8dp; /* the close button off the edge (Kenneth 2026-11-09) */
}

.ai-drawer-title {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 17dp;
  line-height: 52dp;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}

.ai-drawer-head-gap {
  display: block;
  flex: 0 0 44dp;
}

/* The swipe buttons sit outside the row (SessionSwipeGesture), so the list clips sideways. It runs the drawer's full
   height under the two bars; its top padding keeps the first row clear of the top bar at rest, its end spacer
   (.ai-drawer-list-end) the last row clear of the "you" bar. */
.ai-drawer-list {
  display: block;
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding-top: 106dp; /* head 52 + search 6/36/12 */
  padding-bottom: 0;
  box-sizing: border-box;
}

/* Height set by ShellHost::ApplySafeAreaLayout (the "you" row + the home indicator). */
.ai-drawer-list-end {
  display: block;
  height: 76dp;
}

.ai-drawer-me {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  box-sizing: border-box;
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
  min-height: 76dp;
  margin: 0;
  padding: 10dp 16dp;
  border: 0;
  border-radius: 0;
  text-align: left;
  cursor: pointer;
}

.ai-drawer-me-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56dp;
  height: 56dp;
  border-radius: 28dp;
  overflow: hidden;
}

.ai-drawer-me-image {
  width: 56dp;
  height: 56dp;
}

.ai-drawer-me-avatar .avatar-letter {
  font-size: 22dp;
}

/* The name and, under it, the device's link to our service (ShellHost::SetChatsLink). */
.ai-drawer-me-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.ai-drawer-me-name {
  margin: 0;
  font-size: 24dp;
  line-height: 30dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* A 14dp cloud (tick when online, slash when offline) and the word. */
.ai-drawer-me-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 6dp 0 0 0;
  height: 16dp;
  font-size: 12dp;
  line-height: 16dp;
}

.ai-drawer-me-link-icon {
  flex: none;
  width: 14dp;
  height: 14dp;
  margin-right: 5dp;
}

.ai-drawer-me-link-text {
  display: block;
  white-space: nowrap;
}

.ai-drawer-me-chevron {
  flex: none;
  width: 16dp;
  height: 16dp;
}

/* An AI conversation's bar: the new-conversation button on the right; the chat's own header row, lifted onto the bar,
   leaves it room. */
.shell-chat-new-slot {
  display: none;
}

.shell-layer-compact .shell-chat-new-slot {
  display: flex;
  position: absolute;
  top: 2dp;
  right: 12dp;
  z-index: 4;
}

.shell-chat-overlay .chat-shell--ai .chat-header {
  margin-right: 36dp;
}

/* Phone contact page and blocked list: a 48dp bar over the page (which scrolls under it) with the back arrow. */
.shell-layer-compact .shell-transient-chrome--titled {
  min-height: 48dp;
  height: 48dp;
  padding: 0 0 0 12dp;
}

.shell-layer-transient {
  display: flex;
  flex-direction: column;
  /* Above account sheet (29) / chat overlay (25); below context menu (40) and call chrome (45).
     Matches WINDOW_SHELL interruption: transient > account > aux > chat. */
  z-index: 30;
  transform: translateX(0);
}

.shell-layer-transient.shell-swipe-dragging {
}

.shell-layer-transient .shell-pane-transient {
  flex: 1;
  min-height: 0;
  padding-top: 48dp;
  box-sizing: border-box;
}

/* Phones: the pushed pages start under their bar and keep their first row clear of it at rest. */
.shell-layer-transient.shell-layer-compact .shell-pane-transient {
  padding-top: 0;
}

.shell-pane-transient .contact-detail-panel,
.shell-pane-transient .blocked-page {
  padding-top: 48dp;
  box-sizing: border-box;
}

.shell-layer-overlay,
.shell-layer-dialog {
  z-index: 50;
}

/* Dialog / PIN: empty mounts must not steal hits; children re-enable pointer-events. */
.shell-overlay-chrome-mount {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.shell-overlay-chrome-mount--dialog {
  z-index: 50;
}

.shell-overlay-chrome-mount--photo {
  z-index: 56;
}

/* Picture preview (tap on a picture): the bubble's picture fitted to the screen, a spinner over it. */
.photo-preview {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: auto;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-preview-image {
  display: block;
  max-width: 100%;
  max-height: 100%;
}

@keyframes photo-preview-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.photo-preview-spinner {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 28dp;
  height: 28dp;
  margin-top: -17dp;
  margin-left: -17dp;
  border-width: 3dp;
  border-style: solid;
  border-radius: 17dp;
  animation: 0.9s linear infinite photo-preview-spin;
}

.shell-overlay-chrome-mount--pin {
  z-index: 55;
}

/* Full-bleed brand cover while vault/messaging prepare (below PIN / titlebar). */
.shell-startup-cover {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 48;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  focus: none;
}

.shell-startup-cover-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12dp;
  padding: 24dp;
}

.shell-startup-cover-icon {
  width: 96dp;
  height: 96dp;
  flex-shrink: 0;
}

.shell-startup-cover-name {
  margin: 0;
  font-family: LatoLatin;
  font-size: 28dp;
  font-weight: bold;
  text-align: center;
}

.shell-startup-cover-status {
  margin: 0;
  text-align: center;
}

.shell-overlay-chrome-mount .shell-layer {
  pointer-events: auto;
}

/* Call chrome: empty mounts must not steal hits; children re-enable pointer-events. */
.shell-call-chrome-mount {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.shell-call-chrome-mount--bar {
  z-index: 45;
}

.shell-call-chrome-mount--ring {
  z-index: 53;  /* above context menus (52) so a menu scrim never eats the Accept tap; below the PIN gate (55) */
}

.shell-call-chrome-mount .shell-layer {
  pointer-events: auto;
}

.shell-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  focus: none;
}

.shell-frame {
  position: absolute;
  top: 24dp;
  left: 24dp;
  right: 24dp;
  bottom: 24dp;
  display: flex;
  flex-direction: column;
  padding: 16dp;
  /* Close button is 40dp at top: 8dp; keep content below it so overflow clip
     does not crop overlay footers (people picker Cancel / Message). */
  padding-top: 48dp;
  border-radius: 8dp;
  box-sizing: border-box;
  overflow: hidden;
  clip: always;
}

.shell-close-btn {
  position: absolute;
  top: 8dp;
  right: 8dp;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40dp;
  height: 40dp;
  min-width: 40dp;
  padding: 0;
  margin-bottom: 0;
  border: 0;
  border-radius: 20dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.shell-close-btn svg {
  flex-shrink: 0;
  width: 16dp;
  height: 16dp;
}

.shell-overlay-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: auto;
  clip: always;
}

/* Phone page sheet (iOS, Kenneth 2026-11-04: the centred new-group panel looked odd; then every sheet alike). It
   rises from the bottom to about 4/5 of the screen (--large), the page behind dimmed by the scrim, rounded top
   corners and a grab handle; it is dragged to full height (no class), down to half (--half) and a third (--small),
   and let go low it closes (ShellPageSheetGesture, PageSheetModel: keep the tops here and its constants the same). ShellHost pads the bottom
   by the home-indicator inset. */
@keyframes shell-page-sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0%); }
}

.shell-page-sheet {
  position: absolute;
  top: 10dp;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  padding: 16dp 16dp 0 16dp;
  border-radius: 12dp 12dp 0 0;
  box-sizing: border-box;
  overflow: hidden;
  clip: always;
  transform: translateY(0);
  transition: transform 0.3s cubic-out, top 0.3s cubic-out;
}

.shell-page-sheet.shell-swipe-dragging {
  transition: none;
}

/* Where every sheet opens: a fifth of the page behind stays in sight above it. */
.shell-page-sheet.shell-page-sheet--large {
  top: 20%;
}

/* At half: its top at 45% of the screen, the page behind it dimmed less, so what the user was doing stays in sight. */
.shell-page-sheet.shell-page-sheet--half {
  top: 45%;
}

.shell-layer-sheet--half .shell-scrim {
  opacity: 0.5;
}

/* At small: about a third of the screen (the title row and the top of the content), the page behind dimmed least. */
.shell-page-sheet.shell-page-sheet--small {
  top: 66%;
}

.shell-layer-sheet--small .shell-scrim {
  opacity: 0.25;
}

.shell-page-sheet-enter {
  animation: 0.3s cubic-out shell-page-sheet-in;
}

.shell-page-sheet-grabber {
  position: absolute;
  top: 6dp;
  left: 0;
  right: 0;
  width: 36dp;
  height: 5dp;
  margin: 0 auto;
  border-radius: 2.5dp;
}

/* One title row for every sheet (Kenneth 2026-11-04): 44dp under the grab handle, the title centred (17dp bold), the
   sheet's X at its right end. Each view marks its row .sheet-header and its title .sheet-title; the row keeps clear
   of the X on both sides so the title stays centred (the people picker's sheet keeps its 16dp side padding, so its row
   needs 16dp less). */
.shell-page-sheet .sheet-header {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 44dp;
  margin: 0;
  padding: 0 52dp;
  box-sizing: border-box;
}

.shell-page-sheet--people_picker .sheet-header {
  padding: 0 36dp;
}

/* A second button left of the X (ask-AI's "Open in AI chat"): the row keeps clear of both. */
.shell-page-sheet .sheet-header.sheet-header--two-buttons {
  padding: 0 96dp;
}

.shell-page-sheet .sheet-header .sheet-title {
  display: block;
  flex: 1;
  min-width: 0;
  height: 44dp;
  margin: 0;
  padding: 0;
  font-size: 17dp;
  line-height: 52dp;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
}

/* The header's buttons (iOS): a 44dp target around a quiet 30dp grey disc holding a small secondary-colour icon. The
   X is the sheet's own (ShellLayoutRml), top right on the title row. */
.shell-page-sheet .shell-page-sheet-close {
  top: 16dp;
  right: 4dp;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  border-radius: 22dp;
}

.shell-page-sheet .sheet-icon-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30dp;
  height: 30dp;
  border-radius: 15dp;
}

.shell-page-sheet .shell-page-sheet-close svg {
  width: 12dp;
  height: 12dp;
}

.shell-page-sheet .people-picker-row {
  min-height: 50dp;
  box-sizing: border-box;
}

.shell-page-sheet .people-picker-row-title {
  font-size: 17dp;
  font-weight: normal;
}

.shell-page-sheet .people-picker-check {
  width: 24dp;
  height: 24dp;
  border-radius: 12dp;
  border-width: 2dp;
  box-sizing: border-box;
}

.shell-page-sheet .people-picker-check-mark {
  display: none;
}

.shell-page-sheet .people-picker-row--selected .people-picker-check {
  decorator: svg(../icons/v2/check.svg);
}

/* The page behind is dimmed up through the status bar, as iOS does. */
.shell-layer-sheet .shell-scrim {
  top: -100dp;
}

/* The engine draws no placeholder: a hint sits over the empty search field (sheet only; desktop unchanged). */
.people-picker-search-hint {
  display: none;
}

.shell-page-sheet .people-picker-search {
  position: relative;
}

.shell-page-sheet .people-picker-search-field {
  height: 36dp;
  min-height: 36dp;
  padding: 7dp 12dp;
  border-width: 0;
  border-radius: 10dp;
  font-size: 17dp;
  /* A 22dp line between 7dp paddings: text and a line-tall caret sit in the middle (a 36dp line drew a full-height caret). */
  line-height: 22dp;
}

.shell-page-sheet .people-picker-search-hint {
  display: block;
  position: absolute;
  left: 12dp;
  top: 0;
  height: 36dp;
  font-size: 17dp;
  line-height: 36dp;
  white-space: nowrap;
  pointer-events: none;
}

.shell-page-sheet .people-picker-footer-actions {
  gap: 12dp;
}

.shell-page-sheet .people-picker-footer .btn {
  flex: 1;
  height: 50dp;
  min-height: 50dp;
  line-height: 50dp;
  padding: 0 20dp;
  font-size: 17dp;
}

/* The ask-AI panel (DEV/PLAN-ui-batch5-ask-ai.md 5a, design §8.14) in its sheet: the sheet's title row (an "Open in AI
   chat" icon left of the X), one line on what goes to the AI, the bubbles, the input row and the reminder under it. */
.shell-page-sheet.shell-page-sheet--ask_ai {
  padding-left: 0;
  padding-right: 0;
}

.ask-ai {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* The input bar (picture, input row, reminder) floats over the bubbles, frosted (colors.rcss.tmpl); the scroll runs
   down under it and its end spacer (AskAiPanel::SyncComposerClear) keeps the last bubble above it. ShellHost pads its
   bottom by the home indicator, so the bar reaches the sheet's bottom edge. */
.ask-ai-composer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
}

.ask-ai-scroll-end {
  display: block;
  height: 96dp;
}

/* Left of the sheet's X (right 4dp, 44dp wide): the same 44dp target and grey disc. */
.ask-ai-open-chat {
  position: absolute;
  top: 0;
  right: 48dp;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
}

.ask-ai-open-chat svg {
  width: 14dp;
  height: 14dp;
}

.ask-ai-privacy {
  flex-shrink: 0;
  margin: 0 16dp 6dp 16dp;
  font-size: 13dp;
  line-height: 18dp;
}

.ask-ai-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 8dp 16dp 8dp 16dp;
}

.ask-ai-intro {
  margin: 0 0 16dp 0;
  padding: 14dp 16dp 4dp 16dp;
  border-radius: 12dp;
}

.ask-ai-intro-body {
  margin: 0;
  font-size: 15dp;
  line-height: 21dp;
}

.ask-ai-intro-ok {
  display: block;
  width: 100%;
  height: 44dp;
  margin-top: 6dp;
  border: 0;
  font-size: 17dp;
  line-height: 44dp;
  font-weight: bold;
  text-align: center;
}

.ask-ai-section {
  margin: 0 0 10dp 0;
  font-size: 13dp;
  line-height: 18dp;
}

.ask-ai-empty {
  margin: 24dp 0;
  font-size: 15dp;
  line-height: 21dp;
  text-align: center;
}

.ask-ai .bubble-user,
.ask-ai .bubble-assistant {
  max-width: 88%;
}

/* The chat page's bubble tails are drawn for its own rows only. */
.ask-ai .bubble-tail {
  display: none;
}

.ask-ai-error {
  margin: 4dp 0 0 0;
  font-size: 15dp;
  line-height: 21dp;
}

.ask-ai-support {
  display: inline-block;
  height: 44dp;
  margin-top: 10dp;
  padding: 0 18dp;
  border: 0;
  border-radius: 22dp;
  font-size: 15dp;
  line-height: 44dp;
}

/* Margin, not padding: the row is the keys' positioning box, so it must be exactly the pill. */
.ask-ai-input-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  flex-shrink: 0;
  margin: 8dp 14dp 0 14dp;
}

/* The picture waiting to be sent: a thumbnail and an X. */
.ask-ai-picture {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8dp 16dp 0 16dp;
}

.ask-ai-picture-box {
  width: 56dp;
  height: 56dp;
  border-radius: 10dp;
  overflow: hidden;
}

.ask-ai-picture-img {
  display: block;
  width: 56dp;
  height: 56dp;
  border-radius: 10dp;
}

.ask-ai-picture-note {
  margin: 0 0 0 12dp;
  font-size: 13dp;
}

.ask-ai-picture-remove {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0 0 0 4dp;
  padding: 0;
  border: 0;
  border-radius: 22dp;
}

.ask-ai-picture-remove svg {
  width: 14dp;
  height: 14dp;
}

.ask-ai-reminder {
  flex-shrink: 0;
  margin: 6dp 16dp 6dp 16dp;
  font-size: 12dp;
  line-height: 16dp;
  text-align: center;
}

/* New chat in a sheet (Kenneth 2026-11-04): the sheets' title row, the rows edge to edge (the rows pad themselves, so
   the sheet drops its side padding). */
.shell-page-sheet.shell-page-sheet--new_chat,
.shell-page-sheet.shell-page-sheet--group_info,
.shell-page-sheet.shell-page-sheet--group_leave,
.shell-page-sheet.shell-page-sheet--contact_detail {
  padding-left: 0;
  padding-right: 0;
}

.shell-dialog {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 90%;
  max-width: 360dp;
  margin-left: 0;
  margin-top: 0;
  transform: translate(-50%, -50%);
  padding: 20dp;
  border-radius: 8dp;
  box-sizing: border-box;
  z-index: 51;
}

.shell-dialog-title {
  margin-top: 0;
  font-size: 18dp;
}

.shell-dialog-message {
  display: block;
  margin-top: 0;
  margin-bottom: 8dp;
}

/* The prompt dialog's text field: a visible box (it was invisible against the dialog, Kenneth 2026-10-23). */
.shell-dialog-prompt {
  display: block;
  width: 100%;
  min-height: 40dp;
  margin: 4dp 0 12dp 0;
  padding: 8dp 12dp;
  border-width: 1dp;
  border-radius: 8dp;
  box-sizing: border-box;
  cursor: text;
}

.shell-call-meters {
  display: block;
  margin-top: 12dp;
  margin-bottom: 16dp;
}

.shell-call-meter {
  display: block;
  margin-bottom: 10dp;
}

.shell-call-meter--compact {
  margin-bottom: 0;
  margin-right: 12dp;
  min-width: 88dp;
}

.shell-call-meter-head {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4dp;
}

.shell-call-meter-label {
  font-size: 12dp;
  display: block;
  margin-bottom: 2dp;
}

.shell-call-meter-hint {
  font-size: 11dp;
  display: block;
  margin-top: 2dp;
}

.shell-call-meter-track {
  align-items: stretch;
  gap: 3dp;
  height: 8dp;
}

.shell-call-meter-seg {
  flex-grow: 1;
  height: 8dp;
  border-radius: 2dp;
}

/* Expanded bar: shrink-wrap chrome; pass through outside the visible bar/stage. */
.shell-call-chrome-mount .shell-layer-call-bar {
  bottom: auto;
  z-index: 45;
  pointer-events: none;
  display: flex;
  flex-direction: column;
}

.shell-layer-call-bar .shell-call-stage,
.shell-layer-call-bar .shell-call-bar {
  pointer-events: auto;
  cursor: pointer;
}

.shell-call-bar {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8dp;
  margin: 8dp 12dp;
  padding: 10dp 12dp;
  border-radius: 10dp;
  box-sizing: border-box;
}

.shell-call-bar-row {
  align-items: center;
  justify-content: space-between;
  gap: 8dp;
  width: 100%;
}

.shell-call-bar-main {
  flex-grow: 1;
  min-width: 0;
}

.shell-call-bar-title {
  margin: 0;
  font-size: 14dp;
  font-weight: bold;
}

.shell-call-bar-subtitle {
  margin: 2dp 0 0 0;
  font-size: 12dp;
}

.shell-call-bar-hint {
  margin: 4dp 0 0 0;
  max-width: 280dp;
}

.shell-call-debug-subtitle,
.shell-call-quality-hint {
  margin: 2dp 0 0 0;
  max-width: 280dp;
}

.shell-call-quality {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  height: 32dp;
  min-width: 0;
  padding: 0 8dp;
  border-width: 0;
  background-color: transparent;
  flex-shrink: 0;
}

.shell-call-quality--compact {
  height: 28dp;
  padding: 0 4dp;
}

.shell-call-quality-bars {
  align-items: flex-end;
  gap: 2dp;
  height: 12dp;
}

.shell-call-quality-bar {
  width: 3dp;
  border-radius: 1dp;
}

.shell-call-quality-bar--1 {
  height: 4dp;
}

.shell-call-quality-bar--2 {
  height: 7dp;
}

.shell-call-quality-bar--3 {
  height: 10dp;
}

.shell-call-quality-bar--4 {
  height: 12dp;
}

.shell-call-quality-label {
  margin: 0;
  white-space: nowrap;
}

.shell-call-bar-meters {
  align-items: flex-start;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 8dp 12dp;
  width: 100%;
}

.shell-call-bar-actions {
  align-items: center;
  gap: 8dp;
  flex-shrink: 0;
}

.shell-call-mute,
.shell-call-camera,
.shell-call-flip,
.shell-call-speaker,
.shell-call-leave,
.shell-call-invite,
.shell-call-retry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 22dp;
  cursor: pointer;
}

.shell-call-mute svg,
.shell-call-camera svg,
.shell-call-flip svg,
.shell-call-speaker svg,
.shell-call-leave svg,
.shell-call-invite svg,
.shell-call-retry svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

.shell-call-roster {
  flex-wrap: wrap;
  gap: 6dp;
  padding: 0 12dp 8dp 12dp;
  max-height: 72dp;
  overflow-y: auto;
}

.shell-call-roster-chip {
  align-items: center;
  gap: 4dp;
  padding: 4dp 8dp;
  border-radius: 999dp;
}

.shell-call-roster-name {
  margin: 0;
  max-width: 120dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shell-call-stage {
  margin: 8dp 12dp 0 12dp;
  height: 180dp;
  border-radius: 10dp;
  position: relative;
  overflow: hidden;
}

call-video-tile {
  display: block;
  box-sizing: border-box;
}

.shell-call-remote {
  width: 100%;
  height: 100%;
  border-radius: 10dp;
}

.shell-call-remote-placeholder {
  margin: 0;
  padding: 16dp;
  text-align: center;
}

.shell-call-pip {
  position: absolute;
  width: 72dp;
  height: 128dp;
  right: 10dp;
  bottom: 10dp;
  border-radius: 8dp;
  overflow: hidden;
}

.shell-call-leave {
  min-width: 44dp;
}

.shell-call-expand,
.shell-call-grid {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 22dp;
  cursor: pointer;
}

.shell-call-expand svg,
.shell-call-grid svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

.shell-call-grid {
  margin-right: 8dp;
}

.shell-call-chrome--dragging {
}

/* Minimized chip: mount layer must not steal hits; only the chip is interactive.
   More specific than `.shell-call-chrome-mount .shell-layer { pointer-events: auto }`.
   #166: the chip can be dropped anywhere, also over the phone AI dot (shown while the call is minimised): its mount
   (.shell-call-chrome-mount--bar, 45) is over the dot's (.shell-ai-dot-mount, 40), so the chip and its buttons win.
   Never dragged, it keeps the --tr corner below; dropped, ShellCallChromeGesture / ShellCallChromeRml place it inline. */
.shell-call-chrome-mount .shell-layer-call-minimized {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 45;
  pointer-events: none;
}

.shell-call-minimized-chip {
  position: absolute;
  pointer-events: auto;
  align-items: center;
  gap: 8dp;
  min-width: 160dp;
  max-width: 240dp;
  padding: 10dp 12dp;
  border-radius: 14dp;
  box-sizing: border-box;
  cursor: pointer;
}

/* #189: the handle: the full bar thrown to a side edge shrinks to this circle, 12dp of it beyond the edge (placed by
   ShellCallChromeRml / ShellCallChromeGesture with a negative left / right). The padding on the hidden side keeps the
   phone in the 32dp that shows. */
.shell-call-minimized-chip--handle {
  justify-content: center;
  width: 44dp;
  min-width: 0;
  max-width: 44dp;
  height: 44dp;
  padding: 0;
  border-radius: 22dp;
}

.shell-call-minimized-chip--handle-l {
  padding-left: 12dp;
}

.shell-call-minimized-chip--handle-r {
  padding-right: 12dp;
}

.shell-call-minimized-icon {
  width: 22dp;
  height: 22dp;
}

.shell-call-minimized-chip--tr {
  top: 12dp;
  right: 12dp;
}

.shell-call-minimized-main {
  flex-grow: 1;
  min-width: 0;
}

.shell-call-minimized-title {
  margin: 0;
  font-size: 13dp;
  font-weight: bold;
}

.shell-call-minimized-subtitle {
  margin: 2dp 0 0 0;
  font-size: 11dp;
}

.shell-call-mute--compact,
.shell-call-leave--compact {
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  border-radius: 18dp;
}

/* Immersive: call is the primary surface (V031). */
.shell-layer-call-immersive {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 45;
  pointer-events: auto;
}

.shell-call-immersive {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 12dp 12dp 16dp 12dp;
}

.shell-call-immersive-header {
  flex-shrink: 0;
  padding-bottom: 8dp;
}

.shell-call-immersive-grabber {
  width: 36dp;
  height: 4dp;
  border-radius: 2dp;
  margin: 4dp auto 10dp auto;
}

.shell-call-immersive-roster {
  flex-grow: 1;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: 10dp;
  padding: 4dp 0 12dp 0;
}

.shell-call-peer-card {
  width: 46%;
  min-width: 140dp;
  flex-grow: 1;
  padding: 16dp 12dp;
  border-radius: 12dp;
  box-sizing: border-box;
  align-items: center;
}

.shell-call-peer-avatar {
  width: 56dp;
  height: 56dp;
  border-radius: 28dp;
  margin: 0 auto 10dp auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shell-call-peer-avatar .avatar-letter {
  font-size: 22dp;
}

.shell-call-peer-avatar-image {
  width: 56dp;
  height: 56dp;
  border-radius: 28dp;
  margin: 0 auto 10dp auto;
  display: block;
}

.shell-call-peer-tile {
  width: 100%;
  height: 120dp;
  border-radius: 10dp;
  margin: 0 auto 10dp auto;
}

.shell-call-peer-stall {
  margin: 0 0 6dp 0;
  text-align: center;
}

.shell-call-peer-name {
  margin: 0;
  text-align: center;
  font-size: 14dp;
  font-weight: bold;
}

.shell-call-peer-badges {
  justify-content: center;
  gap: 6dp;
  margin-top: 8dp;
  min-height: 16dp;
}

/* V059 spotlight: one card fills the call area, the others line up in a strip below (a tap spotlights them). */
.shell-call-immersive-spotlight {
  flex-grow: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 4dp 0 8dp 0;
}

.shell-call-peer-card--spotlit {
  flex-grow: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 8dp;
}

.shell-call-peer-card--spotlit .shell-call-peer-tile {
  flex-grow: 1;
  height: auto;
  min-height: 160dp;
  margin: 0 0 8dp 0;
}

.shell-call-peer-card--spotlit .shell-call-peer-avatar,
.shell-call-peer-card--spotlit .shell-call-peer-avatar-image {
  width: 96dp;
  height: 96dp;
  border-radius: 48dp;
  margin: auto auto 12dp auto;
}

.shell-call-immersive-strip {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  gap: 8dp;
  overflow-x: auto;
  padding: 0 0 8dp 0;
}

.shell-call-peer-card--strip {
  flex-grow: 0;
  flex-shrink: 0;
  width: 112dp;
  min-width: 112dp;
  padding: 6dp;
}

.shell-call-peer-card--strip .shell-call-peer-tile {
  height: 72dp;
  margin: 0 0 4dp 0;
}

.shell-call-peer-card--strip .shell-call-peer-avatar,
.shell-call-peer-card--strip .shell-call-peer-avatar-image {
  width: 40dp;
  height: 40dp;
  border-radius: 20dp;
  margin: 0 auto 4dp auto;
}

.shell-call-peer-card--strip .shell-call-peer-name {
  font-size: 12dp;
}

.shell-call-peer-card--strip .shell-call-peer-badges {
  margin-top: 2dp;
}

.shell-call-immersive-controls {
  flex-shrink: 0;
  padding-top: 8dp;
}

.shell-call-immersive-controls .shell-call-bar-actions {
  justify-content: center;
  flex-wrap: wrap;
}

/* An outgoing call still ringing: a wide labelled Cancel on phones (Kenneth 2026-11-04); desktop keeps its End. */
.shell-call-cancel-row {
  display: none;
}

/* Phones, ringing: the wide Cancel is the one way to hang up, so the small round End goes. */
.shell-body--compact .shell-call-leave--ringing {
  display: none;
}

.shell-body--compact .shell-call-cancel-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding: 12dp 16dp;
}

.shell-body--compact .shell-call-cancel {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8dp;
  width: 100%;
  max-width: 320dp;
  height: 50dp;
  padding: 0 20dp;
  border: 0;
  border-radius: 25dp;
  box-sizing: border-box;
  cursor: pointer;
}

.shell-body--compact .shell-call-cancel svg {
  flex-shrink: 0;
  width: 22dp;
  height: 22dp;
}

.shell-body--compact .shell-call-cancel-label {
  font-size: 17dp;
  font-weight: bold;
  line-height: 50dp;
}

/* G022: "Make a group…" in a call with no group and 3+ people, and the banner of a group made there (Join / Not now). */
.call-make-group-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding: 8dp 12dp 0 12dp;
}

.call-make-group-row--phone {
  padding: 0 24dp 12dp 24dp;
}

.call-make-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6dp;
  height: 32dp;
  padding: 0 14dp;
  border: 0;
  border-radius: 16dp;
  box-sizing: border-box;
  cursor: pointer;
}

.call-make-group svg {
  flex-shrink: 0;
  width: 16dp;
  height: 16dp;
}

.call-make-group-label {
  font-size: 14dp;
  line-height: 32dp;
}

.call-make-group--phone {
  height: 44dp;  /* tappable ≥44dp on phones (Kenneth 2026-11-03) */
  padding: 0 18dp;
  border-radius: 22dp;
}

/* The group offer's "Join / Not now / Add to group / Remove from call" buttons: 44dp tall on phones. */
.shell-layer-compact .call-group-offer-btn {
  height: 44dp;
  line-height: 44dp;
  border-radius: 22dp;
}

.call-make-group--phone .call-make-group-label {
  font-size: 15dp;
  line-height: 40dp;
  font-weight: bold;
}

.call-group-offer {
  display: flex;
  flex-direction: column;
  gap: 8dp;
  margin: 8dp 12dp 0 12dp;
  padding: 12dp;
  border-radius: 12dp;
  box-sizing: border-box;
}

.call-group-offer--phone {
  margin: 0 24dp 12dp 24dp;
  border-radius: 16dp;
}

.call-group-offer-text {
  font-size: 14dp;
  line-height: 20dp;
}

.call-group-offer-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 8dp;
}

.call-group-offer-btn {
  height: 32dp;
  padding: 0 16dp;
  border: 0;
  border-radius: 16dp;
  font-size: 14dp;
  line-height: 32dp;
  font-weight: bold;
  text-align: center;
  cursor: pointer;
}

/* ---- Phone call pages (DESIGN-pp-ui 8.12 + its 2026-11-04 connection story; mockups 06-Call*, 08-call-connect-story).
   Full screen and always dark; ShellHost lifts the page under the status bar and pads it by the safe areas
   (ApplySafeAreaLayout). The only animations are the connecting line's spark, the current step's ring and the tips,
   and they exist only in the markup written before connect (B146: after connect the page idles). */
.shell-layer-call-phone {
  z-index: 45;
}

.call-phone {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.call-phone-remote {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.call-phone-remote-note {
  margin: 0;
  padding-top: 45%;
  font-size: 15dp;
  text-align: center;
}

.call-phone-video-dim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.call-phone-video-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 160dp;
}

.call-phone-top {
  position: relative;
  z-index: 4;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 44dp;
  padding: 0 8dp;
}

/* With a spotlight: the chevron's side and the grid + add-people side, equally wide so the middle stays centred. */
.call-phone-top-side {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 88dp;
}

.call-phone-top-side--end {
  justify-content: flex-end;
}

.call-phone-top-btn,
.call-phone-top-spacer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  padding: 0;
  margin: 0;
  border: 0;
  background-color: transparent;
}

.call-phone-sealed {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4dp;
}

.call-phone-sealed-text {
  font-size: 13dp;
  line-height: 18dp;
}

/* The top pill (DESIGN-pp-ui 8.11), under the top row. */
.call-phone-notice {
  position: absolute;
  top: 50dp;
  left: 8dp;
  right: 8dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10dp;
  padding: 10dp 14dp;
  border-radius: 16dp;
  opacity: 1;
  transition: opacity 0.3s cubic-out;
}

/* The reconnect capsule (#171): fixed just above the button bar, centred; the slot lets taps through. */
.call-phone-reconnect-slot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 140dp;
  z-index: 6;
  display: flex;
  flex-direction: row;
  justify-content: center;
  pointer-events: none;
}

.call-phone-reconnect {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  padding: 8dp 16dp 8dp 10dp;
  border-radius: 20dp;
  opacity: 1;
  transition: opacity 0.3s cubic-out;
}

.call-phone-reconnect--fading {
  opacity: 0;
}

.call-phone-reconnect-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 22dp;
  height: 22dp;
  border-radius: 11dp;
}

.call-phone-reconnect-text {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
}

.call-phone-notice--fading {
  opacity: 0;
}

.call-phone-notice-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 24dp;
  height: 24dp;
  border-radius: 12dp;
}

.call-phone-notice-text {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
}

/* 1:1 voice and the failure page: the person big in the middle. */
.call-phone-hero {
  position: relative;
  z-index: 3;
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 79dp 24dp 0 24dp;
}

.call-phone-hero--ring {
  padding-top: 123dp;
}

.call-phone-avatar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.call-phone-avatar--big {
  width: 120dp;
  height: 120dp;
  border-radius: 60dp;
}

.call-phone-avatar--unknown {
  overflow: hidden;
}

.call-phone-avatar--big .avatar-letter {
  font-size: 48dp;
}

.call-phone-avatar--pair {
  width: 76dp;
  height: 76dp;
  border-radius: 38dp;
}

.call-phone-avatar--pair .avatar-letter {
  font-size: 30dp;
}

.call-phone-avatar--tile {
  width: 72dp;
  height: 72dp;
  border-radius: 36dp;
}

.call-phone-avatar--tile .avatar-letter {
  font-size: 28dp;
}

.call-phone-name {
  margin: 20dp 0 4dp 0;
  font-size: 28dp;
  line-height: 34dp;
  font-weight: bold;
  text-align: center;
}

.call-phone-status {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  text-align: center;
}

.call-phone-debug {
  margin: 6dp 0 0 0;
  font-size: 12dp;
  line-height: 16dp;
  text-align: center;
}

.call-phone-hint {
  margin: 8dp 0 0 0;
  max-width: 300dp;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

/* PP's own signal: two dots joined by a line, then four bars. */
.call-phone-signal-slot {
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.call-phone-signal {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  height: 28dp;
  margin: 10dp 0 0 0;
  padding: 0 10dp 0 8dp;
  border: 0;
  border-radius: 14dp;
  box-sizing: border-box;
}

.call-phone-signal--compact {
  height: 24dp;
  margin: 0;
  padding: 0 8dp 0 6dp;
  border-radius: 12dp;
}

.call-phone-signal--sheet {
  margin: 0;
}

.call-phone-signal-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 20dp;
  height: 12dp;
}

.call-phone-signal-dot {
  flex-shrink: 0;
  width: 6dp;
  height: 6dp;
  border-radius: 3dp;
}

.call-phone-signal-line {
  flex: 1;
  height: 2dp;
}

.call-phone-signal-bars {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 2dp;
  height: 14dp;
}

.call-phone-signal-bar {
  width: 4dp;
  border-radius: 2dp;
}

.call-phone-signal-bar--1 {
  height: 5dp;
}

.call-phone-signal-bar--2 {
  height: 8dp;
}

.call-phone-signal-bar--3 {
  height: 11dp;
}

.call-phone-signal-bar--4 {
  height: 14dp;
}

.call-phone-signal-word {
  font-size: 13dp;
  line-height: 18dp;
  font-weight: bold;
}

/* "Connected directly, 0.9 s": 4 s under the name, then it fades (C++ sets --fading, this transition runs). */
.call-phone-result {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  margin-top: 14dp;
  padding: 8dp 14dp;
  border-radius: 18dp;
  opacity: 1;
  transition: opacity 0.4s cubic-out;
}

.call-phone-result--fading {
  opacity: 0;
}

.call-phone-result-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 20dp;
  height: 20dp;
  border-radius: 10dp;
}

.call-phone-result-text {
  font-size: 15dp;
  line-height: 20dp;
}

/* Before connect: you and them with the moving line, then the steps. */
.call-phone-story {
  position: relative;
  z-index: 3;
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 59dp 24dp 0 24dp;
}

.call-phone-story--card {
  justify-content: center;
  padding-top: 0;
}

/*
 * The incoming-call page has no 44dp top bar (.call-phone-top) but must put the pair, the names and the steps where the
 * answering page does, so answering moves nothing above the buttons: this padding is that bar (44dp) plus the answering
 * page's own .call-phone-story padding-top (59dp, above). Change the two together (a gui test asserts the sum).
 */
.call-phone-story--ring {
  padding-top: 103dp;
}

.call-phone-story--group {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.call-phone-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18dp 18dp 20dp 18dp;
  border-radius: 22dp;
}

.call-phone-pair {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 300dp;
  height: 120dp;
}

.call-phone-pair-path {
  position: relative;
  flex: 1;
  height: 12dp;
}

.call-phone-pair-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 12dp;
  padding: 0 10dp;
}

.call-phone-pair-dot {
  width: 3dp;
  height: 3dp;
  border-radius: 1.5dp;
}

@keyframes call-phone-spark {
  from { transform: translateX(0dp); opacity: 0; }
  15% { opacity: 1; }
  85% { opacity: 1; }
  to { transform: translateX(126dp); opacity: 0; }
}

/* Being called: the spark runs from them (right) towards us (left): the same keyframes mirrored. */
@keyframes call-phone-spark-in {
  from { transform: translateX(126dp); opacity: 0; }
  15% { opacity: 1; }
  85% { opacity: 1; }
  to { transform: translateX(0dp); opacity: 0; }
}

.call-phone-pair-spark {
  position: absolute;
  top: 1dp;
  left: 6dp;
  width: 10dp;
  height: 10dp;
  border-radius: 5dp;
  animation: 1.4s linear-in-out infinite call-phone-spark;
}

.call-phone-pair-path--inbound .call-phone-pair-spark {
  animation: 1.4s linear-in-out infinite call-phone-spark-in;
}

.call-phone-pair-names {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  width: 300dp;
  margin-top: 6dp;
}

.call-phone-pair-name {
  width: 92dp;
  margin: 0 -8dp;
  font-size: 13dp;
  line-height: 18dp;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* The other party's name: larger and bold, the line grows to 22dp (both pages use this rule, so they stay level). */
.call-phone-pair-name--peer {
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
}

/* The answering page's list in a clip of its own height (inline style); the list moves up inside it. */
.call-phone-steps-clip {
  flex-shrink: 0;
  width: 300dp;
  margin-top: 22dp;
  overflow: hidden;
}

.call-phone-steps-clip .call-phone-steps {
  margin-top: 0;
}

.call-phone-steps {
  display: flex;
  flex-direction: column;
  gap: 12dp;
  width: 300dp;
  margin-top: 22dp;
}

.call-phone-story--group .call-phone-card {
  width: 300dp;
  box-sizing: border-box;
}

.call-phone-story--group .call-phone-steps {
  width: 270dp;
  margin-top: 0;
}

.call-phone-step {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
}

.call-phone-step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 22dp;
  height: 22dp;
  border-width: 2dp;
  border-radius: 11dp;
  box-sizing: border-box;
}

.call-phone-step--done .call-phone-step-dot {
  border-width: 0;
}

@keyframes call-phone-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.call-phone-step--current .call-phone-step-dot {
  animation: 1s linear-in-out infinite call-phone-spin;
}

.call-phone-step-text {
  margin: 0;
  min-width: 0;
  font-size: 16dp;
  line-height: 22dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.call-phone-step--current .call-phone-step-text {
  font-weight: bold;
}

/* A passed step stays as a short ✓ line above the current one (#11). */
.call-phone-step--done .call-phone-step-text {
  font-size: 14dp;
  line-height: 18dp;
}

/* The tips: one every 3 s, a 12 s cycle with the four staggered (RCSS only). */
.call-phone-video-body {
  position: relative;
  z-index: 3;
  flex: 1 1 auto;
  min-height: 0;
}

.call-phone-who {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4dp;
  padding: 8dp 140dp 0 16dp;
}

.call-phone-who .call-phone-result {
  margin-top: 4dp;
}

.call-phone-who-name {
  margin: 0;
  font-size: 22dp;
  line-height: 28dp;
  font-weight: bold;
}

.call-phone-who-status {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
}

.call-phone-pip {
  position: absolute;
  top: 8dp;
  right: 12dp;
  width: 110dp;
  height: 160dp;
  border-radius: 10dp;
  overflow: hidden;
}

/* Group: the name, "4 people · 12:04" with the signal, then the people's tiles two by two. */
.call-phone-head {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6dp;
  padding: 4dp 16dp 0 16dp;
}

.call-phone-group-name {
  margin: 0;
  font-size: 22dp;
  line-height: 28dp;
  font-weight: bold;
  text-align: center;
}

.call-phone-sub-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
}

.call-phone-sub {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
}

.call-phone-group-body {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  margin: 16dp 12dp 16dp 12dp;
}

.call-phone-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: flex-start;
  overflow-y: auto;
}

.call-phone-grid--dim {
  opacity: 0.35;
}

.call-phone-tile {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10dp;
  width: 49%;
  height: 49%;
  margin-bottom: 2%;
  border-radius: 18dp;
  border: 3dp transparent;
  overflow: hidden;
  box-sizing: border-box;
}

.call-phone-tile-video {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.call-phone-tile-note {
  margin: 0;
  font-size: 13dp;
  line-height: 18dp;
}

.call-phone-tile-label {
  position: absolute;
  left: 8dp;
  bottom: 8dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4dp;
  max-width: 80%;
  padding: 2dp 8dp;
  border-radius: 6dp;
}

.call-phone-tile-name {
  font-size: 13dp;
  line-height: 18dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* V060: "On hold" (the OS has their call audio: a phone call, Siri). On a person's tile or card the pill sits on
   top and the picture / avatar dims; on the 1:1 page it sits under the name. */
.call-hold-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  padding: 4dp 12dp;
  border-radius: 14dp;
}

.call-hold-pill-text {
  font-size: 13dp;
  line-height: 18dp;
  font-weight: bold;
}

.call-hold-pill--hero {
  margin: 8dp 0 4dp 0;
}

.call-hold-pill--tile {
  position: absolute;
  top: 8dp;
  left: 8dp;
}

.call-hold-pill--who {
  margin: 4dp 0 2dp 0;
}

/* The 1:1 page's status line already says it ("对方暂时离开，请稍等"), and a strip tile is too narrow for the words:
   the pill there is the pause icon alone. */
.call-hold-pill--hero,
.call-hold-pill--who,
.call-phone-tile--strip .call-hold-pill {
  padding: 4dp 8dp;
}

.call-hold-pill--hero .call-hold-pill-text,
.call-hold-pill--who .call-hold-pill-text,
.call-phone-tile--strip .call-hold-pill-text {
  display: none;
}

.call-phone-tile--on-hold .call-phone-avatar,
.call-phone-tile--on-hold call-video-tile,
.shell-call-peer-card--on-hold .shell-call-peer-avatar,
.shell-call-peer-card--on-hold .shell-call-peer-avatar-image,
.shell-call-peer-card--on-hold call-video-tile {
  opacity: 0.45;
}

/* V059 on the phone: the spotlit person (the one speaking, or the one tapped) fills the group's area, everyone else
   in a strip above the buttons. Whoever speaks has a ring: only the border's colour changes (colors.rcss.tmpl), no
   layout and no animation (B146). */
.call-phone-spotlight {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
}

.call-phone-tile--spotlit {
  width: 100%;
  height: 100%;
  margin-bottom: 0;
}

.call-phone-tile--spotlit .call-phone-avatar--tile {
  width: 120dp;
  height: 120dp;
  border-radius: 60dp;
}

.call-phone-tile--spotlit .call-phone-avatar--tile .avatar-letter {
  font-size: 48dp;
}

.call-phone-strip {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 8dp;
  height: 120dp;
  margin: 0 12dp 16dp 12dp;
  overflow: hidden;
}

.call-phone-tile--strip {
  flex: 0 1 104dp;
  min-width: 60dp;
  width: auto;
  height: 100%;
  margin-bottom: 0;
  gap: 6dp;
  border-radius: 14dp;
}

.call-phone-tile--strip .call-phone-avatar--tile {
  width: 44dp;
  height: 44dp;
  border-radius: 22dp;
}

.call-phone-tile--strip .call-phone-avatar--tile .avatar-letter {
  font-size: 18dp;
}

.call-phone-tile--strip .call-phone-tile-label {
  left: 4dp;
  bottom: 4dp;
  max-width: 90%;
  padding: 1dp 6dp;
}

.call-phone-tile--strip .call-phone-tile-name {
  font-size: 11dp;
  line-height: 15dp;
}

.call-phone-tile--strip .call-phone-tile-note {
  display: none;
}

/* The bar of round buttons with their words. */
.call-phone-controls {
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  margin: 0 12dp 22dp 12dp;
  padding: 12dp 4dp 8dp 4dp;
  border-radius: 18dp;
}

.call-phone-control {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4dp;
  width: 64dp;
  padding: 0;
  margin: 0;
  border: 0;
  background-color: transparent;
}

.call-phone-control-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52dp;
  height: 52dp;
  border-radius: 26dp;
}

.call-phone-control-label {
  font-size: 11dp;
  line-height: 13dp;
  white-space: nowrap;
}

/* Ring: decline / voice / video, 72dp. */
.call-phone-answer {
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 0 32dp;
  margin-bottom: 48dp;
}

.call-phone-answer-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8dp;
  width: 96dp;
}

.call-phone-round {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72dp;
  height: 72dp;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 36dp;
}

.call-phone-answer-label {
  margin: 0;
  font-size: 13dp;
  line-height: 18dp;
  text-align: center;
}

/* "Incoming call, connecting...": the answers are in place but dimmed and dead until the invite arrives. */
.call-phone-answer--waiting {
  opacity: 0.4;
}

.call-phone-charge,
.call-phone-failed-actions {
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 8dp;
  padding: 0 24dp 40dp 24dp;
}

.call-phone-pill-btn {
  display: block;
  width: 100%;
  height: 50dp;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 25dp;
  font-size: 17dp;
  line-height: 50dp;
  font-weight: bold;
  text-align: center;
}

/* "How this call got through" (DESIGN-pp-ui 8.14 sheet). */
.call-phone-sheet-layer {
  z-index: 8;
}

.call-phone-sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  padding: 4dp 4dp 16dp 4dp;
}

.call-phone-sheet-lead {
  margin: 0 0 16dp 0;
  font-size: 14dp;
  line-height: 20dp;
}

.call-phone-timeline {
  position: relative;
  margin: 0 0 18dp 0;
  padding-left: 26dp;
}

.call-phone-event {
  position: relative;
  margin-bottom: 14dp;
}

.call-phone-event-dot {
  position: absolute;
  left: -23dp;
  top: 4dp;
  width: 12dp;
  height: 12dp;
  border-radius: 6dp;
}

.call-phone-event-time {
  margin: 0;
  font-size: 12dp;
  line-height: 16dp;
}

.call-phone-event-text {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
}

.call-phone-sheet-group {
  border-radius: 12dp;
  overflow: hidden;
}

.call-phone-kv {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 44dp;
  padding: 0 14dp;
  border-bottom-width: 1dp;
}

.call-phone-kv--last {
  border-bottom-width: 0;
}

.call-phone-kv-key,
.call-phone-kv-value {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-call-ring-eyebrow {
  margin: 0 0 4dp 0;
  font-size: 12dp;
}

/* Stable geometry: pulse only paints (border-color / Accept glow), never size. */
.shell-call-ring {
  border-width: 2dp;
}

.shell-call-ring .shell-dialog-actions {
  gap: 10dp;
}

.shell-call-ring .btn {
  flex-grow: 1;
}

.shell-call-ring-actions {
  justify-content: center;
  gap: 28dp;
  margin-top: 18dp;
}

.shell-call-ring-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6dp;
  flex: 1 1 0;
  min-width: 0;
}

.shell-call-ring-action-circle {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 60dp;
  height: 60dp;
  min-width: 60dp;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 30dp;
  cursor: pointer;
}

.shell-call-ring-action-circle svg {
  flex-shrink: 0;
  width: 26dp;
  height: 26dp;
}

.shell-call-ring-action-label {
  margin: 0;
  text-align: center;
  max-width: 76dp;
}

.shell-call-accept {
  box-shadow: 0 0 0 0 #00000000;
}

.shell-dialog-checkbox {
  align-items: center;
  gap: 8dp;
  margin-top: 8dp;
  font-size: 14dp;
}

/* Unstyled <input type="checkbox"> renders at zero size (B38): give it a box. */
input.checkbox {
  width: 18dp;
  height: 18dp;
  border-width: 2dp;
  border-radius: 4dp;
  vertical-align: -4dp;
  cursor: pointer;
}

/* Phone checkboxes (DESIGN-pp-ui §8): an iOS circle, outlined when off, accent-filled with a white tick when on.
   The row around it (a label) is at least 44dp tall so the whole row is the tap target. */
.shell-body--compact input.checkbox {
  width: 24dp;
  height: 24dp;
  border-width: 2dp;
  border-radius: 12dp;
  box-sizing: border-box;
  vertical-align: middle;
  flex-shrink: 0;
}

.shell-body--compact input.checkbox:checked {
  decorator: svg(../icons/v2/check.svg);
}

.shell-body--compact .shell-dialog-checkbox,
.shell-body--compact .people-picker-video-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
  min-height: 44dp;
  margin-top: 8dp;
  font-size: 15dp;
  cursor: pointer;
}

.shell-dialog-actions {
  justify-content: flex-end;
  gap: 8dp;
  margin-top: 16dp;
}

/* Phone alerts look like a UIAlertController (DESIGN-pp-ui §9): a 270dp rounded card, centred 17dp title and 13dp
   message, a prompt field, then a flush button area under a hairline: two buttons side by side split by a vertical
   hairline, a longer pair stacked (the confirm on top). Text-only buttons, 44dp tall; the confirm is bold. */
.shell-body--compact .shell-dialog--alert {
  width: 270dp;
  max-width: 270dp;
  padding: 0;
  border-radius: 14dp;
  overflow: hidden;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-body {
  display: block;
  padding: 20dp 16dp;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-title {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
  text-align: center;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-message {
  margin: 4dp 0 0 0;
  font-size: 13dp;
  line-height: 18dp;
  text-align: center;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-prompt {
  height: 38dp;
  min-height: 38dp;
  margin: 14dp 0 0 0;
  padding: 0 10dp;
  border-width: 0;
  border-radius: 8dp;
  font-size: 15dp;
  line-height: 38dp;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-checkbox {
  gap: 10dp;
  min-height: 44dp;
  margin: 10dp 0 -10dp 0;
  font-size: 13dp;
  text-align: left;
}

.shell-body--compact .shell-dialog--alert input.checkbox {
  width: 20dp;
  height: 20dp;
  border-radius: 10dp;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions {
  display: flex;
  flex-direction: row;
  gap: 0;
  margin: 0;
  border-top-width: 1dp;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions--stack {
  flex-direction: column-reverse;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions .btn {
  display: block;
  flex: 1 1 0;
  width: auto;
  height: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0 4dp;
  border-width: 0;
  border-radius: 0;
  font-size: 17dp;
  line-height: 44dp;
  font-weight: normal;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-ok {
  font-weight: bold;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-ok--split {
  border-left-width: 1dp;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions--stack .shell-dialog-ok--split {
  border-left-width: 0;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions--stack .shell-dialog-cancel {
  border-top-width: 1dp;
}

/* Frosted unlock card (Transparency on): the card itself is clear and its first child, .bar-material--frost, carries the
   bar colour and the blur (the engine draws none on an element with a z-index and children). The card's own children
   are positioned so they paint above it. */
.shell-pin-gate--frost > * {
  position: relative;
}

.shell-pin-gate--frost > .shell-pin-gate-material {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 8dp;
}

/* Over the incoming-call placeholder page (phones only: it exists in the compact layout): no dimming behind the card
   (the scrim stays, it still takes the taps) and the card sits on the bottom edge instead of the middle, so as little
   as possible of the "Incoming call, connecting..." title is covered. The keypad is never shrunk. */
.shell-pin-gate--over-call .shell-scrim {
  background-color: transparent;
}

.shell-pin-gate--over-call .shell-dialog.shell-pin-gate {
  top: auto;
  bottom: 12dp;
  transform: translate(-50%, 0);
}

.shell-pin-gate-chooser {
  display: flex;
  flex-direction: column;
  gap: 8dp;
  margin-top: 16dp;
}

.shell-pin-gate-chooser .btn {
  display: block;
  width: 100%;
  text-align: center;
}

.shell-pin-gate-input {
  width: 100%;
  margin-bottom: 10dp;
}

.shell-pin-gate-note {
  margin-top: 12dp;
}

.shell-pin-gate-error {
  min-height: 1.2em;
  margin-bottom: 8dp;
  color: #b42318;
}

/* Face / fingerprint first (at-rest A014): one big sensor key, then "Enter PIN"; the pad comes after that. */
.shell-pin-bio {
  display: block;
  margin-top: 16dp;
}

.shell-pin-bio-key {
  display: block;
  width: 112dp;
  height: 112dp;
  margin: 8dp auto 24dp auto;
  padding: 0;
  border-width: 0;
  border-radius: 56dp;
  background-color: #7878802e;
  text-align: center;
  box-sizing: border-box;
}

.shell-pin-bio-key:active {
  background-color: #78788066;
}

.shell-pin-bio-icon {
  margin-top: 24dp;
}

.shell-pin-bio-pin {
  display: block;
  width: 100%;
  min-height: 48dp;
}

/* The number pad (phones, a digit PIN; DEV/PLAN-pin-gate-redesign.md B): dots, then 3 x 4 round keys >= 64dp. */
.shell-pin-pad {
  display: block;
  margin-top: 8dp;
}

.shell-pin-dots {
  display: flex;
  flex-direction: row;
  justify-content: center;
  height: 16dp;
  margin-bottom: 24dp;
}

.shell-pin-dot {
  display: block;
  width: 14dp;
  height: 14dp;
  margin: 0 8dp;
  border-width: 1.5dp;
  border-color: #8e8e93;
  border-radius: 7dp;
  box-sizing: border-box;
}

.shell-pin-dot--filled {
  background-color: #8e8e93;
}

@keyframes shell-pin-dots-busy {
  0% { opacity: 1; }
  50% { opacity: 0.4; }
  100% { opacity: 1; }
}

.shell-pin-dots--busy {
  animation: 1.0s sine-in-out infinite shell-pin-dots-busy;
}

.shell-pin-keys {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  width: 264dp;
  margin: 0 auto;
}

.shell-pin-key {
  display: block;
  width: 72dp;
  height: 72dp;
  margin: 6dp 8dp;
  padding: 0;
  border-width: 0;
  border-radius: 36dp;
  background-color: #7878802e;
  font-size: 28dp;
  line-height: 72dp;
  text-align: center;
  box-sizing: border-box;
}

.shell-pin-key:active {
  background-color: #78788066;
}

.shell-pin-key--plain {
  background-color: transparent;
}

.shell-pin-key--blank {
  background-color: transparent;
}

.shell-pin-key--word {
  font-size: 17dp;
}

.shell-pin-key-icon {
  margin-top: 22dp;
}

.shell-pin-gate-link {
  display: block;
  width: 100%;
  min-height: 44dp;
  margin-top: 12dp;
  text-align: center;
}

.chat-empty {
  padding: 24dp;
  margin-bottom: 16dp;
  border-radius: 8dp;
}

.chat-empty-title {
  margin-top: 0;
  font-size: 20dp;
}

.home-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
}

.home-header {
  flex-shrink: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12dp;
  margin-bottom: 12dp;
  padding: 8dp 4dp;
}

.home-brand {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2dp;
}

.home-brand-name {
  margin: 0;
  font-family: LatoLatin;
  font-size: 22dp;
  font-weight: bold;
}

.home-brand-tagline {
  margin: 0;
}

.home-landing {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-bottom: 24dp;
  box-sizing: border-box;
}

.home-landing-inner {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 640dp;
  gap: 12dp;
  box-sizing: border-box;
}

.home-composer-mount {
  width: 100%;
  box-sizing: border-box;
}

.home-composer-mount .prompt-composer {
  margin: 0;
}

.home-suggestions {
  display: block;
  text-align: center;
  padding: 0 4dp;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
}

.chat-panel .chat-header-title {
  font-size: 18dp;
}

.chat-panel .chat-messages-wrap {
  flex: 1;
  min-height: 0;
}

.chat-time-inline {
  font-size: 11dp;
  opacity: 0.85;
}

.chat-shared-badge,
.chat-annotation-badge {
  display: inline-block;
  margin-right: 6dp;
  padding: 1dp 6dp;
  border-radius: 4dp;
  background-color: rgba(128, 128, 128, 0.15);
  font-size: 11dp;
}

.chat-reaction-row {
  display: block;
  margin-top: 4dp;
}

.chat-reaction-chip {
  display: inline-block;
  min-height: 30dp;
  margin-right: 4dp;
  margin-top: 2dp;
  padding: 2dp 6dp;
  border-radius: 15dp;
  background-color: rgba(128, 128, 128, 0.12);
  font-size: 18dp;
  text-align: center;
}

.chat-reaction-chip--mine {
  background-color: rgba(64, 128, 255, 0.18);
}

/* Reactions hung on a bubble or card (WhatsApp style): small pills over its bottom edge, inset from its start side.
   Absolute, so the row's height stays the bubble's (avatar, tail and bubble bottom line up); the row keeps the room
   below (message-row-has-reactions). Each chip is a 40dp hit box; the 30dp pill is drawn inside it. Tint: colors-*. */
.chat-reaction-host {
  position: relative;
}

.chat-reaction-row--overlay {
  position: absolute;
  left: 10dp;
  bottom: -20dp;
  z-index: 1;
  margin: 0;
  white-space: nowrap;
  text-align: left;
}

.chat-reaction-row--overlay .chat-reaction-chip {
  height: 40dp;
  min-height: 40dp;
  margin: 0 2dp 0 0;
  padding: 5dp 0;
  border-radius: 0;
  box-sizing: border-box;
  background-color: transparent;
  font-size: 18dp;
  line-height: 22dp;
}

.chat-reaction-row--overlay .chat-reaction-pill {
  display: inline-block;
  height: 30dp;
  padding: 2dp 9dp;
  border-width: 2dp;
  border-radius: 15dp;
  box-sizing: border-box;
  font-size: 18dp;
  line-height: 22dp;
}

.chat-reaction-count {
  margin-left: 3dp;
  font-size: 14dp;
}

.message-row-has-reactions {
  padding-bottom: 18dp;
}

.chat-system-line {
  text-align: center;
  margin: 8dp 0;
}

/* A call in the transcript: icon + duration (or outcome), a pill on the starter's side. */
.chat-call-row {
  display: inline-block;
  padding: 7dp 12dp;
  border-radius: 12dp;
  font-size: 13dp;
}

.shell-chat-overlay .chat-call-row {
  padding: 9dp 14dp;
  font-size: 17dp;
  line-height: 22dp;
}

.shell-chat-overlay .chat-call-row-icon {
  width: 20dp;
  height: 20dp;
  margin-right: 8dp;
}

/* A call record in a 1:1 chat: tap = call back. Group records do not get this class. */
.chat-call-row--tappable {
  cursor: pointer;
}

.chat-call-row--tappable:active {
  opacity: 0.6;
}

.chat-call-row-icon {
  display: inline-block;
  width: 16dp;
  height: 16dp;
  margin-right: 6dp;
  vertical-align: middle;
}

.chat-call-row-text {
  vertical-align: middle;
}

.chat-card {
  border-radius: 8dp;
  padding: 10dp 12dp;
  margin: 4dp 0;
  background-color: rgba(128, 128, 128, 0.08);
}

.chat-orphan-annotation {
  margin: 6dp 0;
}

.message-row-annotation-orphan {
  opacity: 0.85;
}

.sidebar-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.sidebar-header {
  flex-shrink: 0;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8dp;
}

.sidebar-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.sidebar-header-actions {
  flex-shrink: 0;
  gap: 6dp;
  align-items: center;
  margin-left: auto;
}

.sidebar-new-chat {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.sidebar-new-chat svg {
  flex-shrink: 0;
}

.sidebar-sessions {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.sidebar-session {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10dp;
  min-height: 60dp;
  margin-bottom: 4dp;
  padding: 8dp 10dp;
  border-radius: 6dp;
  box-sizing: border-box;
  cursor: pointer;
}

/* Two lines: title + date, then the last message + unread badge. */
.sidebar-session-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3dp;
}

.sidebar-session-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  min-height: 18dp;
}

.sidebar-session-title {
  flex: 1;
  min-width: 0;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar-session--unread .sidebar-session-title {
  font-weight: bold;
}

.sidebar-session-preview {
  flex: 1;
  min-width: 0;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar-session-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
}

.sidebar-session-icon svg {
  flex-shrink: 0;
}

.sidebar-session-date {
  flex-shrink: 0;
  font-size: 11dp;
}

.sidebar-session-flag {
  flex-shrink: 0;
}

/* "You were mentioned" ahead of the preview (group-chat G015): accent, bold, never cut. */
.sidebar-session-mention {
  flex-shrink: 0;
  display: block;
  margin-right: 4dp;
  font-size: 12dp;
  font-weight: bold;
  white-space: nowrap;
}

/* "Marked as unread": a dot in the badge colour, since there is no message count to show. */
.sidebar-unread-dot {
  flex-shrink: 0;
  display: block;
  width: 8dp;
  height: 8dp;
  border-radius: 4dp;
}

/* Opens the archived threads, or returns to the list; shown only when something is archived. */
.sidebar-archived-entry {
  align-items: center;
  gap: 8dp;
  min-height: 36dp;
  margin-bottom: 4dp;
  padding: 6dp 12dp;
  border-radius: 6dp;
  box-sizing: border-box;
  cursor: pointer;
}

.sidebar-archived-label {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  margin-bottom: 0;
  font-size: 13dp;
}

.sidebar-unread {
  flex-shrink: 0;
}

.badge-count {
  flex-shrink: 0;
  min-width: 20dp;
  padding: 2dp 6dp;
  border-radius: 10dp;
  font-size: 11dp;
  text-align: center;
}

/* tab-badge pill: 18dp high, caption-1 600, at the icon's top-right. */
.badge-count--nav {
  position: absolute;
  top: -6dp;
  right: -12dp;
  min-width: 18dp;
  height: 18dp;
  padding: 0 5dp;
  box-sizing: border-box;
  border-radius: 9dp;
  font-size: 12dp;
  font-weight: bold;
  line-height: 18dp;
}

.badge-dot {
  flex-shrink: 0;
  width: 8dp;
  height: 8dp;
  border-radius: 4dp;
}

.badge-dot--nav {
  position: absolute;
  top: -2dp;
  right: -4dp;
}

.badge-dot--settings {
  flex-shrink: 0;
  margin-left: 6dp;
  margin-right: 2dp;
}

.sidebar-session-close {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28dp;
  height: 28dp;
  min-width: 28dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.sidebar-session-close svg {
  flex-shrink: 0;
}

/* Phone chat list (DESIGN-pp-ui 8.3 / 8.8): full-width 64dp rows, a 52dp round avatar, a hairline inset from 80dp.
   The avatar, type icon, muted bell and search box only exist on the phone; desktop keeps the card rows. */
.chat-search,
.chat-row-avatar,
.chat-row-type,
.chat-row-mute,
.chat-row-blocked {
  display: none;
}

.shell-layer-compact .sidebar-panel {
  padding: 0;
}

.shell-layer-compact .sidebar-sessions .large-title {
  padding: 0 16dp;
}

.shell-layer-compact .chat-search {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  height: 36dp;
  margin: 0 20dp 12dp 20dp;
  padding: 0 8dp;
  box-sizing: border-box;
  border-radius: 10dp;
}

.chat-search-icon {
  flex-shrink: 0;
  width: 16dp;
  height: 16dp;
}

.chat-search-input {
  flex: 1;
  min-width: 0;
  height: 36dp;
  margin: 0;
  padding: 0 0 0 6dp;
  border: 0;
  box-sizing: border-box;
  font-size: 17dp;
  background-color: transparent;
}

/* Text and caret centred in the 36dp pill: the engine draws them one line tall at the top of the content box, so
   the box is a 22dp line with 7dp above and below (Kenneth 2026-11-04: the caret was not in the middle). Phones only. */
.shell-layer-compact .chat-search-input {
  padding-top: 7dp;
  padding-bottom: 7dp;
  line-height: 22dp;
}

/* The input renders no placeholder: this label sits over it while it is empty and lets clicks through. */
.chat-search-label {
  position: absolute;
  top: 0;
  left: 30dp;
  height: 36dp;
  margin: 0;
  font-size: 17dp;
  line-height: 36dp;
  pointer-events: none;
}

.shell-layer-compact .sidebar-archived-entry {
  margin: 0 16dp 4dp 16dp;
}

.shell-layer-compact .sidebar-sessions .text {
  padding: 8dp 16dp;
}

.shell-layer-compact .sidebar-session {
  gap: 12dp;
  height: 64dp;
  min-height: 64dp;
  margin: 0;
  padding: 0 0 0 16dp;
  border: 0;
  border-radius: 0;
}

/* Swipe actions (phone Chats list): the buttons sit just outside the row and ride along as it slides. */
.session-swipe {
  display: none;
}

.shell-layer-compact .sidebar-sessions {
  overflow-x: hidden;
}

/* Moved with `left` (SessionSwipeGesture), so its buttons are hit where they are drawn. */
.shell-layer-compact .sidebar-session {
  position: relative;
  transition: left 0.2s cubic-out;
}

.shell-layer-compact .sidebar-session.session-swipe-dragging {
  transition: none;
}

.shell-layer-compact .session-swipe {
  display: none;
}

.shell-layer-compact .sidebar-session.session-swipe-shown .session-swipe {
  display: flex;
  flex-direction: row;
  position: absolute;
  top: 0;
  bottom: 0;
}

.shell-layer-compact .session-swipe--end {
  left: 100%;
}

.shell-layer-compact .session-swipe--start {
  right: 100%;
}

.shell-layer-compact .session-swipe-btn {
  width: 74dp;
  min-height: 44dp;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.shell-layer-compact .session-swipe-label {
  margin: 2dp 0 0 0;
  font-size: 11dp;
  text-align: center;
}

.shell-layer-compact .sidebar-session-icon,
.shell-layer-compact .sidebar-session-flag--pin,
.shell-layer-compact .sidebar-session-flag--muted {
  display: none;
}

/* One leading column on every phone list (Kenneth 2026-11-04, PLAN-ui-refresh-impl 68): 16dp in, a 44dp avatar (or a
   36dp icon tile centred in 44dp), 12dp to the text, so text starts 72dp into the row on Chats, Contacts, Me and the
   member lists alike. */
.shell-layer-compact .chat-row-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  border-radius: 22dp;
  overflow: hidden;
}

/* A cached profile photo replaces the letter: the round frame clips it. */
.shell-layer-compact .chat-row-avatar .avatar-photo {
  width: 44dp;
  height: 44dp;
}

.chat-row-avatar-letter {
  margin: 0;
  font-size: 19dp;
  line-height: 24dp;
  font-weight: bold;
}

.chat-row-avatar-icon {
  width: 28dp;
  height: 28dp;
}

.shell-layer-compact .sidebar-session-body {
  height: 64dp;
  padding-right: 16dp;
  box-sizing: border-box;
  justify-content: center;
  gap: 2dp;
}

.shell-layer-compact .sidebar-session-line {
  min-height: 22dp;
}

.shell-layer-compact .sidebar-session-line + .sidebar-session-line {
  min-height: 20dp;
}

.shell-layer-compact .sidebar-session-title {
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
}

/* Kenneth 2026-11-03: one size smaller than the spec's subhead, more air ("不要塞的太满"). */
.shell-layer-compact .sidebar-session-preview,
.shell-layer-compact .sidebar-session-mention {
  font-size: 15dp;
  line-height: 20dp;
}

/* The time shares the title's line and its baseline (22dp line, 13dp text). */
.shell-layer-compact .sidebar-session-date {
  font-size: 13dp;
  line-height: 22dp;
}

.shell-layer-compact .chat-row-type,
.shell-layer-compact .chat-row-mute {
  display: block;
  flex-shrink: 0;
}

.shell-layer-compact .chat-row-type {
  width: 14dp;
  height: 14dp;
}

.shell-layer-compact .chat-row-mute {
  width: 16dp;
  height: 16dp;
}

/* A chat with someone blocked (Kenneth 2026-11-04): a small block mark before "Blocked", kept quiet. */
.shell-layer-compact .chat-row-blocked {
  display: block;
  flex-shrink: 0;
  width: 14dp;
  height: 14dp;
}

.shell-layer-compact .sidebar-unread {
  min-width: 20dp;
  height: 20dp;
  padding: 0 6dp;
  box-sizing: border-box;
  border-radius: 10dp;
  font-size: 12dp;
  font-weight: bold;
  line-height: 20dp;
}

.message-row-peer {
  margin: 8dp 0;
  padding-right: 48dp;
}

.message-row-ai {
  margin: 8dp 0;
  padding-right: 24dp;
}

.message-row-user {
  margin: 8dp 0;
  padding-left: 48dp;
}

/* The row a jump landed on (a tapped quote's original, a search hit, a mention): tinted for a moment. Two classes,
   so it wins over a row's own tint (.message-row-mentions-me in colors-*.rcss); see-through, so it reads on
   either theme. */
.message-row.message-row-jump-target {
  border-radius: 8dp;
}

/* A peer's message that mentions this account (group-chat G015): the row is tinted (colors-*.rcss). */
.message-row-mentions-me {
  padding: 4dp 8dp;
  border-radius: 4dp;
}

.sender-label {
  display: block;
  font-size: 11dp;
  margin-top: 0;
  margin-bottom: 4dp;
}

.preview-panel,
.working-set-panel {
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow-y: auto;
}

.working-set-header {
  display: flex;
  align-items: flex-start;
  gap: 8dp;
}

.working-set-header-text {
  flex: 1;
  min-width: 0;
}

.preview-title,
.working-set-title {
  margin-top: 0;
  font-size: 18dp;
}

.preview-content,
.working-set-body {
  margin-top: 8dp;
}

.working-set-long-list-body {
  display: block;
}

.working-set-long-list .chat-long-list-item {
  display: block;
  margin-bottom: 12dp;
  padding-bottom: 10dp;
}

.working-set-form {
  display: block;
  margin-top: 8dp;
}

.working-set-table {
  width: 100%;
}

.working-set-code {
  white-space: pre-wrap;
}

.chat-working-set-chip {
  display: inline-block;
  margin-top: 8dp;
  margin-right: 8dp;
  height: 44dp;
  min-height: 44dp;
  padding: 0 16dp;
  line-height: 44dp;
  border-radius: 999dp;
  font-size: 13dp;
  box-sizing: border-box;
  text-align: center;
  focus: none;
}

.empty-panel {
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  justify-content: center;
}

/* Settings panel */
.settings-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.settings-list-view,
.settings-detail-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.settings-detail-view {
  transform: translateX(0);
}

.settings-detail-view.shell-swipe-dragging {
}

/* The transfer page's explanation starts below the bar with the room a card would have. */
.shell-layer-compact .settings-subpage-view .settings-transfer {
  padding-top: 14dp;
}

/* Phones: a page pushed over a settings section (Security > Change PIN): it covers the section, which stays
   underneath so a swipe back shows it. */
.settings-subpage-view {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
}

.settings-header,
.settings-detail-header {
  flex-shrink: 0;
  align-items: center;
  margin-bottom: 8dp;
}

.settings-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.me-profile-card {
  flex-shrink: 0;
  margin-bottom: 12dp;
  padding: 10dp;
  border-radius: 8dp;
  box-sizing: border-box;
  gap: 6dp;
}

/* Expanded/compact Me index: single-row identity (avatar | name | actions). */
.me-identity-header {
  align-items: center;
  gap: 10dp;
  padding: 8dp 10dp;
  margin-bottom: 8dp;
}

.me-identity-main {
  flex: 1;
  min-width: 0;
  gap: 2dp;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  text-align: left;
  cursor: pointer;
}

.me-identity-name {
  margin: 0;
  font-size: 15dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.me-identity-actions {
  flex-shrink: 0;
  gap: 6dp;
  align-items: center;
}

.me-identity-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  min-height: 36dp;
  padding: 0;
  border-radius: 8dp;
}

.me-identity-status {
  flex-shrink: 0;
  margin: 0 0 8dp 0;
  font-size: 12dp;
}

.me-profile-meta {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
  word-break: break-all;
}

.me-profile-actions {
  margin-top: 4dp;
  gap: 8dp;
  flex-wrap: wrap;
}

.me-invite-qr {
  flex-direction: column;
  align-items: flex-start;
  gap: 8dp;
  margin-top: 12dp;
}

.me-invite-qr-code {
  width: 200dp;
  height: 200dp;
  /* The theme tints ordinary svg icons; preserve the QR's white quiet zone. */
  image-color: #ffffff;
}

.me-profile-avatar-row {
  align-items: center;
  flex-wrap: wrap;
  gap: 12dp;
  margin-bottom: 8dp;
}

.me-profile-avatar-wrap {
  position: relative;
  width: 64dp;
  height: 64dp;
  flex-grow: 0;
  flex-shrink: 0;
}

/* "Uploading…" over the photo while it goes up (the frame below is dimmed and inert meanwhile). */
.me-profile-avatar-uploading {
  position: absolute;
  top: 0;
  left: 0;
  width: 64dp;
  height: 64dp;
  border-radius: 32dp;
  background-color: rgba(0, 0, 0, 140);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.me-profile-avatar-uploading-text {
  margin: 0;
  font-size: 10dp;
  color: #ffffff;
  text-align: center;
  white-space: nowrap;
}

.me-profile-avatar-frame {
  width: 64dp;
  height: 64dp;
  border-radius: 32dp;
  overflow: hidden;
  flex-grow: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.me-profile-avatar-frame--compact {
  width: 48dp;
  height: 48dp;
  border-radius: 24dp;
}

.me-profile-avatar-frame--disabled {
  cursor: auto;
  opacity: 0.6;
  pointer-events: none;
}

.me-profile-avatar-image {
  width: 64dp;
  height: 64dp;
}

.me-profile-avatar-image--compact {
  width: 48dp;
  height: 48dp;
}

.me-profile-avatar-frame .avatar-letter {
  font-size: 24dp;
}

.me-profile-avatar-frame--compact .avatar-letter {
  font-size: 18dp;
}

/* The camera badge: the visible way to change the photo. 24dp on the desktop's 64dp photo, 36dp on the phone's 112dp one. */
.me-profile-avatar-badge {
  display: flex;
  position: absolute;
  right: -2dp;
  bottom: -2dp;
  width: 24dp;
  height: 24dp;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-width: 2dp;
  border-radius: 12dp;
  cursor: pointer;
}

.me-profile-avatar-badge svg {
  width: 12dp;
  height: 12dp;
}

.me-profile-avatar-badge:disabled {
  opacity: 0.4;
}

/* Phone profile page (Kenneth 2026-11-10): the photo is big enough to see, 112dp, centred at the top; a 32dp camera badge sits on its lower right with a 2dp ring in the card's colour.
   The uploading cover follows the circle. Colours: colors.rcss.tmpl. */
.shell-layer-compact .me-profile-avatar-row {
  flex-direction: column;
  align-items: center;
  gap: 12dp;
}

.shell-layer-compact .me-profile-avatar-wrap {
  width: 112dp;
  height: 112dp;
}

.shell-layer-compact .me-profile-avatar-wrap .me-profile-avatar-frame {
  width: 112dp;
  height: 112dp;
  border-radius: 56dp;
}

.shell-layer-compact .me-profile-avatar-wrap .me-profile-avatar-image {
  width: 112dp;
  height: 112dp;
}

.shell-layer-compact .me-profile-avatar-wrap .avatar-letter {
  font-size: 44dp;
}

.shell-layer-compact .me-profile-avatar-uploading {
  width: 112dp;
  height: 112dp;
  border-radius: 56dp;
}

.shell-layer-compact .me-profile-avatar-uploading-text {
  font-size: 15dp;
}

.shell-layer-compact .me-profile-avatar-badge {
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
}

.shell-layer-compact .me-profile-avatar-badge svg {
  width: 16dp;
  height: 16dp;
}
.contacts-row-avatar-frame {
  width: 32dp;
  height: 32dp;
  border-radius: 16dp;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contacts-row-avatar-image {
  width: 32dp;
  height: 32dp;
}

.contacts-row-avatar-frame .avatar-letter {
  font-size: 13dp;
}

.contact-detail-avatar-row {
  align-items: center;
  gap: 12dp;
}

.contact-detail-avatar-frame {
  width: 64dp;
  height: 64dp;
  border-radius: 32dp;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-detail-avatar-image {
  width: 64dp;
  height: 64dp;
}

.contact-detail-avatar-frame .avatar-letter {
  font-size: 24dp;
}

.avatar-letter {
  margin: 0;
  padding: 0;
  font-family: LatoLatin;
  font-weight: bold;
  line-height: 1;
  text-align: center;
  color: #ffffff;
}

.contact-detail-title-block {
  flex: 1;
  min-width: 0;
}

.chat-attachment-card {
  max-width: 320dp;
}

/* Own pictures, files and voice notes sit on the right like own text bubbles: the cards are blocks, which
   the row's text-align does not move. */
.message-row-user .chat-attachment-card,
.message-row-user .chat-voice-card {
  margin-left: auto;
}

/* A sound file (an MP3) played in place: a small music card. The cover on the left, title and artist / size on the
   right, one line each; under them play / pause, a bar that takes the room left and the time in a fixed width, so a
   long time ("12:34 / 59:59") never runs past the card (Kenneth 2026-11-06). */
.chat-audio-card {
  width: 280dp;
  box-sizing: border-box;
}

.chat-audio-head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.chat-audio-cover {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48dp;
  height: 48dp;
  margin-right: 10dp;
  border-radius: 8dp;
  overflow: hidden;
}

.chat-audio-cover-image {
  display: block;
  width: 48dp;
  height: 48dp;
}

.chat-audio-cover-note {
  width: 24dp;
  height: 24dp;
}

.chat-audio-meta {
  flex: 1;
  min-width: 0;
}

.chat-audio-title,
.chat-audio-sub {
  display: block;
  margin: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chat-audio-controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8dp;
}

/* The voice message's 36dp play / pause button. */
.chat-audio-controls .chat-voice-play {
  margin-right: 10dp;
}

/* The thin bar sits in a 32dp-tall touch area (4dp bar + 14dp above and below): a tap or a drag there seeks. */
.chat-audio-seek {
  flex: 1;
  min-width: 0;
  padding: 14dp 0;
  cursor: pointer;
  position: relative;
}

/* The drag knob: 14dp round (12dp + the 1dp ring), centred on the end of the filled part (left is set with the fill width). Dark on a
   received bubble; the own-bubble white is in the colour files. */
.chat-audio-knob {
  position: absolute;
  top: 9dp;
  width: 12dp;
  height: 12dp;
  margin-left: -7dp;
  border-radius: 7dp;
  background-color: #1f2937;
  border: 1dp rgba(255, 255, 255, 0.55);
  pointer-events: none;
}

.chat-audio-seek .chat-voice-track {
  min-width: 0;
}

.chat-audio-time {
  flex-shrink: 0;
  width: 80dp;
  margin-left: 8dp;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
}

/* A voice message, WhatsApp-like (Kenneth 2026-11-09, #201: the old bar ran the width of the row): one row of
   avatar 44dp (mic badge 16dp at its bottom right) + play 28dp + waveform 147dp x 28dp, under it the length at the
   waveform's left and the clock at the right. The card is an inline-block of fixed width (263dp = 14 + 44 + 8 + 28 +
   8 + 147 + 14), so it is only as wide as its content and never fills the row. Colours: colors-*.rcss. */
.chat-voice-card {
  display: inline-block;
  box-sizing: border-box;
  width: 263dp;
  margin: 4dp 0;
  padding: 10dp 14dp 6dp 14dp;
  border-radius: 18dp;
  text-align: left;
}

.chat-voice-main {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 44dp;
}

.chat-voice-avatar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  border-radius: 22dp;
  overflow: hidden;
}

.chat-voice-avatar-photo {
  width: 44dp;
  height: 44dp;
}

.chat-voice-avatar-letter {
  margin: 0;
  font-size: 19dp;
  line-height: 24dp;
  font-weight: bold;
  color: #ffffff;
}

/* The mic badge sits on the avatar's bottom right corner; the ring is the bubble colour (colors-*.rcss). */
.chat-voice-badge {
  position: absolute;
  left: 30dp;
  top: 28dp;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 16dp;
  height: 16dp;
  border-radius: 8dp;
}

.chat-voice-badge-mic {
  width: 10dp;
  height: 10dp;
}

.chat-voice-card .chat-voice-play {
  width: 28dp;
  height: 28dp;
  margin-left: 8dp;
  border-radius: 14dp;
  background-color: transparent;
}

.chat-voice-card .chat-voice-play svg {
  width: 22dp;
  height: 22dp;
}

.chat-voice-wave {
  position: relative;
  flex-shrink: 0;
  width: 147dp;
  height: 28dp;
  margin-left: 8dp;
}

.chat-voice-bars {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 147dp;
  height: 28dp;
}

.chat-voice-bar {
  flex-shrink: 0;
  width: 2dp;
  margin-right: 1.5dp;
  border-radius: 1dp;
}

/* The played part: a clip as wide as the progress holding the same bars, so the bars left of the knob change colour. */
.chat-voice-played {
  position: absolute;
  left: 0;
  top: 0;
  height: 28dp;
  overflow: hidden;
}

.chat-voice-knob {
  position: absolute;
  top: 9dp;
  width: 10dp;
  height: 10dp;
  margin-left: -5dp;
  border-radius: 5dp;
  pointer-events: none;
}

.chat-voice-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 2dp;
  padding-left: 88dp;
}

.chat-voice-card .chat-voice-time {
  font-size: 13dp;
  line-height: 16dp;
}

.chat-voice-clock {
  flex-shrink: 0;
  font-size: 12dp;
  line-height: 16dp;
  opacity: 0.8;
}

.chat-voice-play {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  padding: 0;
  border: 0;
  border-radius: 18dp;
  background-color: #6366f1;
  cursor: pointer;
}

.chat-voice-play svg {
  width: 16dp;
  height: 16dp;
}

.chat-voice-icon-pause {
  display: none;
}

.chat-voice-play--playing .chat-voice-icon-pause {
  display: block;
}

.chat-voice-play--playing .chat-voice-icon-play {
  display: none;
}

.chat-voice-track {
  flex: 1;
  min-width: 60dp;
  height: 4dp;
  border-radius: 2dp;
  background-color: rgba(128, 128, 128, 0.35);
  overflow: hidden;
}

.chat-voice-fill {
  height: 4dp;
  background-color: #6366f1;
}

.chat-voice-time {
  flex-shrink: 0;
  font-size: 12dp;
  opacity: 0.8;
}

.chat-attachment-image {
  display: block;
  cursor: pointer;
  max-width: 100%;
  max-height: 240dp;
  border-radius: 8dp;
  margin-bottom: 8dp;
}

/* An AI question with a picture (DecorateAiImageBubble): the chat's picture bubble (B181), a 3dp frame round the
   picture (kAiPictureFrameDp) and the question under it. The bubble's width is set inline (picture + frame), so the
   question wraps inside it; the picture sits in a clip box with rounded corners (the engine does not round an <img>). */
.bubble.bubble-user--picture,
.shell-chat-overlay .bubble.bubble-user--picture {
  max-width: none;
  padding: 3dp;
  box-sizing: border-box;
  text-align: left;
}

.chat-ai-image-clip {
  display: block;
  overflow: hidden;
  border-radius: 15dp;
}

.chat-ai-image {
  display: block;
  max-width: 292dp;
  max-height: 360dp;
  margin: 0;
}

.bubble-user--picture .bubble-text {
  margin: 0;
  padding: 5dp 9dp 0 9dp;
}

.bubble-user--picture .bubble-time {
  padding: 0 9dp 3dp 9dp;
}

.chat-attachment-video-poster {
  display: block;
  border-radius: 8dp;
}

/* The frame holds the poster (explicit dp size from the poster's own proportions) and the play disc; it clips both
   (clip: always: overflow:hidden alone clips only scrolling content) and is the tap target for the system player. */
.chat-attachment-video-frame {
  position: relative;
  display: block;
  overflow: hidden;
  clip: always;
  border-radius: 8dp;
  max-width: 200dp;
  cursor: pointer;
}

.chat-attachment-video-frame--bare {
  width: 200dp;
  height: 112dp;
  padding: 10dp;
  background-color: #1a1a1a;
  color: #ffffff;
}

.chat-attachment-video-play {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 48dp;
  height: 48dp;
  margin-top: -24dp;
  margin-left: -24dp;
  border-radius: 24dp;
  background-color: rgba(0, 0, 0, 140);
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-attachment-video-play-icon {
  image-color: #ffffff; /* the theme tints svg icons with the text colour: black on the dark disc */
  /* In flow, not absolute: the engine gives an absolutely placed <svg> no size (the disc showed empty). */
  margin-left: 3dp;
  pointer-events: none;
}

.chat-attachment-video {
  display: flex;
  flex-direction: column;
  gap: 8dp;
}

.chat-attachment-video-badge {
  display: inline-block;
  padding: 2dp 8dp;
  border-radius: 999dp;
  font-size: 11dp;
  opacity: 0.8;
}

.me-preferences-label {
  flex-shrink: 0;
  margin-top: 4dp;
  margin-bottom: 6dp;
}

.settings-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

/* Support (and similar): content-sized; do not share flex growth with Preferences. */
.settings-list--pinned {
  flex: 0 0 auto;
  min-height: 0;
  overflow: visible;
  margin-bottom: 4dp;
}

.settings-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 44dp;
  margin-bottom: 6dp;
  padding: 12dp 10dp;
  border-width: 1dp;
  border-radius: 10dp;
  box-sizing: border-box;
  cursor: pointer;
  text-align: left;
}

.settings-row-text {
  flex: 1;
  min-width: 0;
  gap: 2dp;
}

.settings-row-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 15dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.settings-row-subtitle {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.settings-row-chevron {
  flex-shrink: 0;
  margin-left: 8dp;
}

.settings-back-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin-right: 4dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.settings-back-btn svg {
  flex-shrink: 0;
}

.settings-detail-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  gap: 8dp;
}

.settings-detail-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  overflow: hidden;
}

.settings-section {
  margin-top: 16dp;
  gap: 8dp;
}

.settings-section-title {
  font-size: 14dp;
  font-weight: bold;
  margin-bottom: 4dp;
}

.settings-field {
  display: block;
}

.settings-label {
  display: block;
  font-size: 12dp;
  margin-bottom: 4dp;
}

.settings-toggle-row {
  align-items: center;
  justify-content: space-between;
  gap: 12dp;
  min-height: 44dp;
  width: 100%;
  box-sizing: border-box;
}

.settings-toggle-label {
  display: block;
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
  font-size: 15dp;
}

.settings-switch {
  position: relative;
  flex-shrink: 0;
  width: 42dp;
  height: 26dp;
  min-width: 42dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999dp;
  box-sizing: border-box;
  cursor: pointer;
}

.settings-switch-knob {
  position: absolute;
  top: 2dp;
  left: 2dp;
  width: 22dp;
  height: 22dp;
  border-radius: 999dp;
  box-sizing: border-box;
  transform: translateX(0);
  pointer-events: none;
}

.settings-switch--on .settings-switch-knob {
  transform: translateX(16dp);
}

/* The switch animating is the only feedback a toggle gives (no "saved" toast). */
.settings-switch {
  transition: background-color 0.15s ease-in-out;
}

.settings-switch-knob {
  transition: transform 0.15s ease-in-out;
}

.settings-choice-row {
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
  text-align: left;
}

.settings-choice-value {
  flex-shrink: 0;
  align-items: center;
  gap: 4dp;
}

.settings-choice-value-text {
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 160dp;
}

/* A value that names a whole rule ("4 MB 以下自动（默认）") instead of one word. */
.settings-choice-value-text--wide {
  max-width: 240dp;
}

.settings-help {
  font-size: 12dp;
  margin-top: 0;
  margin-bottom: 4dp;
}

.settings-path {
  font-size: 12dp;
  word-break: break-all;
}

.settings-actions {
  margin-top: 24dp;
  gap: 12dp;
  justify-content: flex-end;
}

/* Me → Security → Your devices: one row per device, its actions under it. */
.settings-device-row {
  padding: 8dp 0;
  gap: 8dp;
}

.settings-device-title {
  align-items: center;
}

.settings-device-actions {
  flex-wrap: wrap;
  gap: 12dp;
}

/* A label badge (not a notification badge): "Main device". */
.settings-device-badge {
  flex-shrink: 0;
  padding: 1dp 8dp;
  border-radius: 8dp;
  font-size: 11dp;
}

.settings-action-bar {
  display: block;
  width: 100%;
  text-align: center;
  box-sizing: border-box;
}

/* Pre-confirm destructive action: soft tint, not solid fill. */
.btn-danger-soft {
  border-width: 1dp;
}

.settings-danger-zone {
  margin-top: 24dp;
  padding-top: 16dp;
  gap: 8dp;
}

.settings-danger-zone .settings-actions {
  margin-top: 4dp;
}

.sidebar-footer {
  margin-top: auto;
  padding: 12dp 16dp;
}

.sidebar-settings-btn {
  display: flex;
  align-items: center;
  gap: 8dp;
  width: 100%;
  text-align: left;
}

.sidebar-settings-btn svg {
  flex-shrink: 0;
}

/* Contacts panel */
.contacts-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.contacts-list-view,
.contacts-detail-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.contacts-header,
.contacts-detail-header {
  flex-shrink: 0;
  margin-bottom: 8dp;
}

.contacts-header {
  align-items: center;
  justify-content: space-between;
}

.contacts-detail-header {
  gap: 2dp;
}

.contacts-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.contacts-header-actions {
  flex-shrink: 0;
  align-items: center;
  gap: 4dp;
}

.contacts-find-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.contacts-find-btn svg {
  flex-shrink: 0;
}

.contacts-search {
  flex-shrink: 0;
  margin-bottom: 8dp;
}

.contacts-search-field {
  margin-bottom: 0;
}

.contacts-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.contacts-row,
.contacts-thread-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 56dp;
  margin-bottom: 4dp;
  padding: 10dp 8dp;
  border-radius: 6dp;
  box-sizing: border-box;
  cursor: pointer;
  gap: 8dp;
}

.contacts-row-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18dp;
  height: 18dp;
}

.contacts-row-icon svg {
  flex-shrink: 0;
}

.contacts-row-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.contacts-row-title-line {
  align-items: center;
  gap: 6dp;
  min-width: 0;
}

.contacts-row-title {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  margin-bottom: 2dp;
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.contacts-row-subtitle {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 11dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.contacts-trust-badge {
  flex-shrink: 0;
  padding: 1dp 6dp;
  border-radius: 8dp;
  font-size: 10dp;
}

.contacts-empty {
  margin-top: 12dp;
  gap: 8dp;
}

.contacts-back-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin-right: 4dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.contacts-back-btn svg {
  flex-shrink: 0;
}

.contacts-detail-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  gap: 12dp;
}

.contact-profile-card {
  flex-shrink: 0;
  padding: 10dp;
  border-radius: 8dp;
  box-sizing: border-box;
  gap: 6dp;
}

.contact-detail-section {
  flex-shrink: 0;
  gap: 6dp;
}

.contact-detail-danger {
  margin-top: 8dp;
  margin-bottom: 4dp;
}

.contacts-edit-field {
  width: 100%;
  gap: 4dp;
}

.contacts-multiaddrs-field {
  min-height: 72dp;
}

.contacts-trust-actions {
  margin-top: 4dp;
  gap: 8dp;
  flex-wrap: wrap;
}

.contacts-threads {
  gap: 4dp;
}

.contacts-actions {
  flex-shrink: 0;
  margin-top: 16dp;
  gap: 8dp;
}

.contacts-action-buttons {
  gap: 8dp;
  flex-wrap: wrap;
}

.contacts-actions-hint {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
}

.people-picker {
  display: flex;
  flex-direction: column;
  flex: 1;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  gap: 12dp;
}

.people-picker-header {
  align-items: center;
  justify-content: space-between;
}

.people-picker-title {
  margin: 0;
  font-family: LatoLatin;
  font-size: 18dp;
  font-weight: bold;
}

.people-picker-search {
  flex-shrink: 0;
}

.people-picker-search-field {
  width: 100%;
  box-sizing: border-box;
}

.people-picker-list {
  flex: 1;
  min-height: 0;
  overflow: auto;
}

.people-picker-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10dp;
  padding: 10dp 8dp;
  margin-bottom: 4dp;
  border-radius: 8dp;
  cursor: pointer;
}

.people-picker-check {
  width: 22dp;
  height: 22dp;
  border-radius: 11dp;
  border-width: 1dp;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.people-picker-check-mark {
  margin: 0;
  font-size: 12dp;
  font-weight: bold;
}

.people-picker-row-body {
  flex: 1;
  min-width: 0;
}

.people-picker-row-title {
  margin: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
}

.people-picker-row-subtitle {
  margin: 2dp 0 0 0;
  font-size: 12dp;
  white-space: nowrap;
  overflow: hidden;
}

.people-picker-locked-label {
  margin: 0;
  font-size: 11dp;
  flex-shrink: 0;
}

.people-picker-footer {
  flex-shrink: 0;
  justify-content: flex-end;
  gap: 8dp;
  padding-top: 8dp;
}

/* The back: a word on the desktop, the round back on phones. */
.people-picker-back-circle,
.shell-layer-compact .people-picker-back-text {
  display: none;
}

.shell-layer-compact .people-picker-back-circle {
  display: flex;
  flex: 0 0 52dp;
  align-self: center;
}

.people-picker-name,
.people-picker-select {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  gap: 12dp;
}

.people-picker-name-help {
  margin: 0;
}

.people-picker-name-field {
  flex-shrink: 0;
}

.people-picker-members {
  flex: 1;
  min-height: 0;
  overflow: auto;
}

.people-picker-members-label {
  margin: 0 0 4dp 0;
}

.people-picker-member-chips {
  flex-wrap: wrap;
  gap: 6dp;
}

.people-picker-member-chip {
  padding: 4dp 10dp;
  border-radius: 999dp;
  font-size: 13dp;
}

.contact-detail-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  overflow: hidden;
}

.shell-nav-page--under-overlay {
  opacity: 1;
}

.context-menu-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 52;  /* above dialogs (50–51: a menu opened from a full-screen list), below the PIN gate and popovers (55) */
}

.context-menu-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.context-menu-panel {
  position: absolute;
  min-width: 180dp;
  max-width: 100%;
  padding: 4dp;
  border-radius: 8dp;
  box-shadow: 0 4dp 16dp rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

/* Touch text menu of an input field: one horizontal row, placed by ContextMenuHost::LayoutBar. */
.context-menu-layer--bar .context-menu-panel {
  display: flex;
  flex-direction: row;
  min-width: 0;
}

.context-menu-layer--bar .context-menu-item {
  width: auto;
  min-height: 36dp;
  padding: 6dp 12dp;
}

.context-menu-layer--bar .context-menu-item-label {
  flex: 0 0 auto;
  white-space: nowrap;
}

/* Reaction row above a chat message (ContextMenuHost::LayoutAnchored). */
.context-menu-quick {
  display: flex;
  flex-direction: row;
  min-width: 0;
  border-radius: 22dp;
}

.context-menu-quick .context-menu-item {
  width: auto;
  min-height: 40dp;
  padding: 4dp 8dp;
  border-radius: 18dp;
}

.context-menu-quick .context-menu-item-label {
  flex: 0 0 auto;
  font-size: 22dp;
  white-space: nowrap;
}

/* Phone pull-down from a header button (ContextMenuHost::ShowActionsPopover): a rounded card right-aligned under
   the button, 50dp rows, label on the left and icon on the right (iOS pull-down menu). */
.context-menu-layer--popover .context-menu-panel {
  min-width: 230dp;
  max-width: 300dp;
  padding: 0;
  border: 0;
  border-radius: 14dp;
  overflow: hidden;
}

.context-menu-layer--popover .context-menu-item {
  flex-direction: row-reverse;
  gap: 12dp;
  min-height: 50dp;
  padding: 0 16dp;
  border-radius: 0;
}

.context-menu-layer--popover .context-menu-item-label {
  font-size: 17dp;
  white-space: nowrap;
}

.context-menu-layer--popover .context-menu-item-icon {
  width: 20dp;
  height: 20dp;
}

/* Phone menus (ContextMenuHost, Presentation::ActionSheet): the small sheet, the page sheets' family (Kenneth
   2026-11-04, ui-mockups/09-sheets-unify): edge to edge at the bottom, 12dp top corners, the grab handle, a 44dp row
   with the centred title and the grey close disc, then one card of 50dp rows. Its height follows the rows, up to about
   a third of the screen (LayoutActionSheet sets the list's max-height and the home-indicator padding); a drag down,
   the disc or the scrim closes it. */
.context-menu-layer--sheet {
  box-sizing: border-box;
}

.context-menu-sheet {
  position: absolute;
  z-index: 1;
  display: block;
  padding: 16dp 16dp 8dp 16dp;
  border-radius: 12dp 12dp 0 0;
  box-sizing: border-box;
  transform: translateY(0px);
  transition: transform 0.25s cubic-out;
  animation: 0.3s cubic-out shell-page-sheet-in;
}

.context-menu-sheet.context-menu-sheet--dragging {
  transition: none;
}

.context-menu-sheet-grabber {
  position: absolute;
  top: 6dp;
  left: 0;
  right: 0;
  width: 36dp;
  height: 5dp;
  margin: 0 auto;
  border-radius: 2.5dp;
}

/* The title row keeps clear of the disc on both sides so the title stays centred (the sheet has 16dp side padding). */
.context-menu-sheet-header {
  display: block;
  height: 44dp;
  margin: 0;
  padding: 0 36dp;
  box-sizing: border-box;
}

.context-menu-sheet-title {
  display: block;
  height: 44dp;
  margin: 0;
  font-family: LatoLatin;
  font-size: 17dp;
  line-height: 52dp;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* A 44dp target round a 30dp grey disc, where the page sheets have theirs. */
.context-menu-sheet-close {
  position: absolute;
  top: 16dp;
  right: 4dp;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  background-color: transparent;
  cursor: pointer;
}

.context-menu-sheet-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30dp;
  height: 30dp;
  border-radius: 15dp;
}

/* Reactions over a chat message: one card row of emoji above the actions, the user's last-used first; it scrolls
   sideways when they do not all fit, the "+" stays at the right end. */
.context-menu-sheet-quick {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 4dp 0 8dp 0;
  padding: 4dp;
  border-radius: 12dp;
  box-sizing: border-box;
}

.context-menu-sheet-quick-scroll {
  display: flex;
  flex: 1 1 0;
  flex-direction: row;
  gap: 4dp;
  min-width: 0;
  overflow-x: auto;
  overflow-y: hidden;
}

.context-menu-sheet-quick .context-menu-item {
  flex-shrink: 0;
}

/* Scrolled by touch: no room kept for the engine's 16dp scrollbars (the row would grow and the emoji ride high). */
.context-menu-sheet-quick-scroll scrollbarhorizontal {
  height: 0dp;
}

/* A menu action with an expander grew the sheet (ContextMenuHost::ExpandSheet sets its height, the large stop): the
   quick row and the rows give way to what it mounts. */
.context-menu-sheet--expanded {
  display: flex;
  flex-direction: column;
}

.context-menu-sheet-header {
  flex-shrink: 0;
}

.context-menu-sheet-expand,
.context-menu-sheet--expanded .context-menu-sheet-quick,
.context-menu-sheet--expanded .context-menu-sheet-list {
  display: none;
}

.context-menu-sheet--expanded .context-menu-sheet-expand {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
  margin: 4dp 0 0 0;
  border-radius: 12dp;
  overflow: hidden;
  clip: always;
}

.context-menu-sheet-quick .context-menu-item {
  width: 44dp;
  min-width: 44dp;
  height: 44dp;
  min-height: 44dp;
  padding: 0;
  justify-content: center;
  border-radius: 22dp;
}

.context-menu-sheet-quick .context-menu-item-label {
  flex: 0 0 auto;
  font-size: 24dp;
  text-align: center;
  white-space: nowrap;
}

.context-menu-sheet-list {
  display: block;
  width: 100%;
  margin: 4dp 0 0 0;
  padding: 0;
  border-radius: 12dp;
  overflow: auto;
  box-sizing: border-box;
}

.context-menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10dp;
  width: 100%;
  min-width: 0;
  min-height: 40dp;
  margin: 0;
  padding: 8dp 12dp;
  border: 0;
  border-radius: 6dp;
  background-color: transparent;
  text-align: left;
  cursor: pointer;
  box-sizing: border-box;
}

/* A sheet row, like iOS's context menu: 50dp, the label from 16dp in, a small icon at the right end 16dp from the
   edge; the hairline is the body's top edge, so it is inset 16dp on both sides. */
.context-menu-sheet-list .context-menu-item {
  align-items: stretch;
  gap: 0;
  min-height: 50dp;
  padding: 0 16dp;
  border-radius: 0;
}

.context-menu-sheet-list .context-menu-item-body {
  display: flex;
  flex: 1;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
  min-width: 0;
  min-height: 50dp;
  padding: 0;
  box-sizing: border-box;
}

.context-menu-sheet-list .context-menu-item:first-child .context-menu-item-body {
  border-top-width: 0;
}

.context-menu-sheet-list .context-menu-item-label {
  font-size: 17dp;
}

.context-menu-item-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18dp;
  height: 18dp;
}

.context-menu-item-icon svg {
  flex-shrink: 0;
}

/* Phone sheet: an 18dp trailing icon (the svg itself is emitted at 18dp). */
.context-menu-sheet-list .context-menu-item-icon {
  align-self: center;
  width: 18dp;
  height: 18dp;
}

.context-menu-item-label {
  flex: 1;
  min-width: 0;
  font-family: LatoLatin;
  font-size: 14dp;
}

.context-menu-item-text {
  display: block;
  flex: 1;
  min-width: 0;
  padding: 8dp 0;
}

.context-menu-item-text .context-menu-item-label {
  display: block;
  flex: none;
  white-space: normal;
}

.context-menu-item-detail {
  display: block;
  margin-top: 2dp;
  white-space: normal;
  font-family: LatoLatin;
  font-size: 13dp;
  color: #6b7280;
}

.context-menu-item-check {
  flex-shrink: 0;
  margin-left: 8dp;
  font-family: LatoLatin;
  font-size: 14dp;
  color: #2563eb;
}

.context-menu-item--selected .context-menu-item-label {
  font-weight: bold;
}

/* Emoji / bottom-chrome IME panel (mobile / compact). No scrim — chat stays interactive. */
.shell-layer-emoji-keyboard {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  pointer-events: none;
}

.shell-layer-emoji-keyboard .shell-emoji-keyboard-panel {
  pointer-events: auto;
}

/* Phones: the composer's emoji sheet (Kenneth 2026-11-05 原话 79, 82): about a third of the screen (ShellHost sets the
   height), right under the message field. The panel is square and the composer's colour; the rounded sheet on it
   (.shell-emoji-keyboard-sheet) is a page sheet's colour, so the bar above runs on behind its corners. */
.shell-emoji-keyboard-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 280dp;
  display: flex;
  flex-direction: column;
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
  /* Force scissor even when flex children absorb overflow (scroll lives on .emoji-picker-body). */
  clip: always;
  z-index: 51;
}

.shell-emoji-keyboard-sheet {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 8dp;
  border-radius: 12dp 12dp 0 0;
  box-sizing: border-box;
  overflow: hidden;
  clip: always;
}

.shell-emoji-keyboard-body {
  flex: 1;
  min-height: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  clip: always;
}

.shell-emoji-keyboard-body .emoji-picker {
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

/* The phone sheets' top (emoji_picker.rml): the composer's sheet shows its grabber, title and X; a page sheet (the
   reaction picker) brings its own grabber and X, so only the title row shows. The desktop keeps its header. */
.emoji-sheet-top {
  display: none;
}

.shell-emoji-keyboard-body .emoji-sheet-top,
.shell-page-sheet .emoji-sheet-top {
  display: block;
  position: relative;
  flex-shrink: 0;
}

.shell-emoji-keyboard-body .emoji-picker-header,
.shell-page-sheet .emoji-picker-header,
.shell-page-sheet .emoji-sheet-grabber,
.shell-page-sheet .emoji-sheet-close {
  display: none;
}

.shell-emoji-keyboard-body .emoji-picker,
.shell-page-sheet .emoji-picker {
  gap: 0;
}

.emoji-sheet-grabber {
  width: 36dp;
  height: 5dp;
  margin: 6dp auto 0 auto;
  border-radius: 2.5dp;
}

.shell-emoji-keyboard-body .emoji-sheet-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 44dp;
  margin: 0 48dp;
}

.shell-emoji-keyboard-body .emoji-sheet-header .sheet-title {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 17dp;
  line-height: 52dp;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}

/* A 44dp target around the small grey disc, at the right end of the title row (as on the page sheets). */
.emoji-sheet-close {
  position: absolute;
  top: 8dp;
  right: -4dp;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
}

.emoji-sheet-close .sheet-icon-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30dp;
  height: 30dp;
  border-radius: 15dp;
}

.emoji-sheet-close svg {
  width: 12dp;
  height: 12dp;
}

/* Section names scroll with their emoji (a sticky name sat on the first row on the phone). */
.shell-emoji-keyboard-body .emoji-picker-section-label,
.shell-page-sheet .emoji-picker-section-label {
  position: static;
}

.shell-emoji-keyboard-body .emoji-picker-body scrollbarvertical,
.shell-page-sheet .emoji-picker-body scrollbarvertical {
  width: 0dp;
}

/* Emoji picker overlay (expanded desktop modal) */
.emoji-picker {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  gap: 8dp;
  overflow: hidden;
}

.emoji-picker-header {
  align-items: center;
  flex-shrink: 0;
}

.emoji-picker-title {
  margin: 0;
  font-family: LatoLatin;
  font-size: 18dp;
  font-weight: bold;
}

.emoji-picker-main {
  flex: 1;
  min-height: 0;
  align-items: stretch;
  gap: 0;
  overflow: hidden;
}

.emoji-picker-rail {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  width: 48dp;
  overflow: auto;
  padding: 4dp 0;
  gap: 2dp;
}

.emoji-picker-rail-tab {
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0;
  border-width: 0;
  border-radius: 8dp;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
}

.emoji-picker-rail-glyph {
  font-size: 20dp;
  line-height: 1.2;
}

.emoji-picker-body {
  flex: 1;
  min-width: 0;
  min-height: 0;
  overflow: auto;
  clip: always;
  padding: 0 8dp 12dp 8dp;
}

.emoji-picker-section {
  display: block;
  margin-bottom: 8dp;
}

.emoji-picker-section-label {
  position: sticky;
  top: 0dp;
  z-index: 1;
  padding: 6dp 4dp;
}

.emoji-picker-section-label-text {
  margin: 0;
  font-family: LatoLatin;
  font-size: 12dp;
  font-weight: bold;
}

.emoji-picker-cells {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 2dp;
}

.emoji-picker-cell {
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0;
  border-width: 0;
  border-radius: 8dp;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
}

.emoji-picker-cell-glyph {
  font-size: 24dp;
  line-height: 1.2;
}

/* In-app QR camera surface. The decoder runs independently of this preview. */
.qr-scan {
  display: flex;
  flex-direction: column;
  gap: 12dp;
  height: 100%;
  min-height: 0;
}

.qr-scan-camera {
  flex: 1;
  min-height: 200dp;
  background-color: #000000;
  overflow: hidden;
}

.qr-scan-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.qr-scan-actions {
  justify-content: flex-end;
  gap: 8dp;
  flex-shrink: 0;
}

/* Phone scanner (Kenneth 2026-11-04, WeChat style; ShellLayoutRml's full-screen layer): the camera and the finder
   fill the whole screen behind the back button and the bottom button, which stay inside the safe areas the shell
   pads the body by. The finder is a 250dp square in the middle with corner marks and a line sweeping it, dimmed
   round it, the hint under it. Colours: colors.rcss.tmpl. */
.qr-scan-finder,
.qr-scan-back,
.qr-scan-tools {
  display: none;
}

.shell-layer-full-screen {
  display: flex;
  flex-direction: column;
}

/* The camera fills the layer (the absolute parts' box), not this padded body, so the body neither clips nor scrolls. */
.shell-layer-full-screen .shell-overlay-body {
  flex: 1;
  overflow: visible;
  clip: auto;
  box-sizing: border-box;
}

.shell-layer-compact .qr-scan {
  justify-content: space-between;
  gap: 0;
}

.shell-layer-compact .qr-scan-title,
.shell-layer-compact .qr-scan-status,
.shell-layer-compact .qr-scan-actions {
  display: none;
}

.shell-layer-compact .qr-scan-camera,
.shell-layer-compact .qr-scan-finder {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 0;
}

.shell-layer-compact .qr-scan-finder {
  display: flex;
  flex-direction: column;
}

.shell-layer-compact .qr-scan-dim {
  flex: 1;
}

.shell-layer-compact .qr-scan-finder-row {
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  height: 250dp;
}

.shell-layer-compact .qr-scan-frame {
  position: relative;
  flex-shrink: 0;
  width: 250dp;
  height: 250dp;
}

.shell-layer-compact .qr-scan-corner {
  position: absolute;
  width: 24dp;
  height: 24dp;
  box-sizing: border-box;
}

.shell-layer-compact .qr-scan-corner--tl {
  top: 0;
  left: 0;
  border-width: 3dp 0 0 3dp;
}

.shell-layer-compact .qr-scan-corner--tr {
  top: 0;
  right: 0;
  border-width: 3dp 3dp 0 0;
}

.shell-layer-compact .qr-scan-corner--bl {
  bottom: 0;
  left: 0;
  border-width: 0 0 3dp 3dp;
}

.shell-layer-compact .qr-scan-corner--br {
  right: 0;
  bottom: 0;
  border-width: 0 3dp 3dp 0;
}

@keyframes qr-scan-sweep {
  from { transform: translateY(0dp); }
  to { transform: translateY(234dp); }
}

/* Only while scanning: it goes with the failure line. */
.shell-layer-compact .qr-scan-line {
  position: absolute;
  top: 7dp;
  left: 10dp;
  right: 10dp;
  height: 2dp;
  border-radius: 1dp;
  animation: 1.2s cubic-in-out infinite alternate qr-scan-sweep;
}

/* Out of the flow, so the dimmed bands above and below the frame stay equal and the frame stays in the middle. */
.shell-layer-compact .qr-scan-below {
  position: relative;
}

.shell-layer-compact .qr-scan-below-text {
  position: absolute;
  top: 24dp;
  left: 32dp;
  right: 32dp;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.shell-layer-compact .qr-scan-hint {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

.shell-layer-compact .qr-scan-retry {
  height: 44dp;
  margin: 16dp 0 0 0;
  padding: 0 24dp;
  border: 0;
  border-radius: 22dp;
  font-size: 17dp;
  line-height: 44dp;
  cursor: pointer;
}

.shell-layer-compact .qr-scan-back {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  width: 52dp;
  height: 52dp;
  margin: 0 0 0 12dp;
  padding: 0;
  border: 0;
  cursor: pointer;
}

.shell-layer-compact .qr-scan-back svg {
  width: 24dp;
  height: 24dp;
}

.shell-layer-compact .qr-scan-tools {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding: 0 0 24dp 0;
}

.shell-layer-compact .qr-scan-tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 88dp;
  padding: 0;
  border: 0;
  cursor: pointer;
}

.shell-layer-compact .qr-scan-tool-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56dp;
  height: 56dp;
  border-radius: 28dp;
}

.shell-layer-compact .qr-scan-tool-disc svg {
  width: 26dp;
  height: 26dp;
}

.shell-layer-compact .qr-scan-tool-label {
  margin-top: 8dp;
  font-size: 13dp;
  line-height: 18dp;
}

/* Phone Contacts (DESIGN-pp-ui 8.6 / 8.7 / 8.8): full-width 60dp rows with a 40dp avatar and the last 6 characters of the
   account id; the detail page is a centred 96dp avatar, round action button and grouped cards. Desktop keeps its layout;
   the phone-only elements are hidden until the compact layer. */
.contacts-phone-search,
.contacts-row-subtitle--phone,
.cd-phone,
.cd-account {
  display: none;
}

.shell-layer-compact .contacts-panel {
  padding: 0;
}

.shell-layer-compact .contacts-list-view .large-title {
  padding: 0 16dp;
}

.shell-layer-compact .contacts-search,
.shell-layer-compact .contacts-row-subtitle--desktop,
.shell-layer-compact .contacts-trust-badge,
.shell-layer-compact .contacts-unread {
  display: none;
}

.shell-layer-compact .contacts-empty {
  padding: 0 16dp;
}

.shell-layer-compact .contacts-list > .text {
  padding: 8dp 16dp;
}

.shell-layer-compact .contacts-row {
  gap: 12dp;
  height: 60dp;
  min-height: 60dp;
  margin: 0;
  padding: 0 0 0 16dp;
  border: 0;
  border-radius: 0;
}

.shell-layer-compact .contacts-row-avatar-frame {
  width: 44dp;
  height: 44dp;
  border-radius: 22dp;
}

.shell-layer-compact .contacts-row-avatar-image {
  width: 44dp;
  height: 44dp;
}

.shell-layer-compact .contacts-row-avatar-frame .avatar-letter {
  font-size: 18dp;
}

.shell-layer-compact .contacts-row-body {
  justify-content: center;
  height: 60dp;
  padding-right: 16dp;
  box-sizing: border-box;
}

.shell-layer-compact .contacts-row-title {
  margin-bottom: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
}

/* A starred contact (常用联系人): a small star right after the name; the badges still go to the row's end. */
.contacts-row-star {
  display: none;
}

.shell-layer-compact .contacts-row-title--starred {
  flex: 0 1 auto;
}

.shell-layer-compact .contacts-row-star {
  display: block;
  flex: none;
  width: 14dp;
  height: 14dp;
  margin-right: auto;
}

.shell-layer-compact .contacts-row-subtitle--phone {
  display: block;
  font-size: 15dp;
  line-height: 20dp;
}

/* Phone Contacts A-Z: a small letter header over each section, and an index strip on the right edge (letters 11dp,
   touch width 28dp, the list's height) that jumps the list while pressed or dragged, with the letter in a centred
   bubble. The desktop list is sorted the same way but shows neither. Colours: colors.rcss.tmpl. */
.contacts-section-header,
.contacts-index,
.contacts-index-bubble {
  display: none;
}

.shell-layer-compact .contacts-section-header {
  display: block;
}

.shell-layer-compact .contacts-index {
  position: absolute;
  top: 44dp;
  right: 0;
  bottom: 49dp;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  width: 28dp;
  padding-right: 3dp;
  box-sizing: border-box;
  drag: drag;
  z-index: 2;
}

.shell-layer-compact .contacts-index-letter {
  display: block;
  width: 16dp;
  height: 14dp;
  margin: 0;
  font-size: 11dp;
  line-height: 14dp;
  font-weight: bold;
  text-align: center;
}

.shell-layer-compact .contacts-index-bubble {
  position: absolute;
  top: 50%;
  left: 50%;
  display: block;
  width: 72dp;
  height: 72dp;
  margin: -36dp 0 0 -36dp;
  border-radius: 14dp;
  pointer-events: none;
  z-index: 3;
}

.shell-layer-compact .contacts-index-bubble-letter {
  margin: 0;
  font-size: 34dp;
  line-height: 72dp;
  font-weight: bold;
  text-align: center;
}

/* Phone "New chat" page (pushed from the Chats compose button): title, search, three 56dp action rows with a 36dp
   coloured round icon, then Frequent and A-Z groups of the Contacts tab's 60dp rows. Colours: colors.rcss.tmpl. */
/* The title row above the list (it does not scroll), the list taking the rest. */
.nc-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.nc-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding-bottom: 32dp;
  box-sizing: border-box;
}

/* The full-screen page's bar (DEV/PLAN-minimal-nav.md E): 48dp, the shell's round back at its left (transient chrome),
   the title centred on the back's centre line; the A-Z strip sits right of the list under it. */
.nc-page {
  position: relative;
}

.shell-layer-compact .nc-page .nc-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 48dp;
}

.shell-layer-compact .nc-page .nc-bar-title {
  top: 2dp;
  opacity: 1;
}

.shell-layer-compact .nc-page .contacts-index {
  top: 48dp;
  bottom: 16dp;
}

.nc-empty-hint {
  margin: 48dp 24dp 0 24dp;
  text-align: center;
}

/* A name-only row: centre the name in the 60dp row. */
/* A name-only row: the body keeps the full 60dp (its separator runs along the bottom), the one line fills it. */
.shell-layer-compact .nc-page .contacts-row-title {
  margin: 0;
  line-height: 59dp;
}

.nc-actions {
  padding-bottom: 8dp;
}

.nc-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 56dp;
  padding: 0 16dp;
  gap: 12dp;
  box-sizing: border-box;
  cursor: pointer;
}

.nc-action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
}

.nc-action-icon svg {
  flex-shrink: 0;
  width: 20dp;
  height: 20dp;
}

.nc-action-label {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
}

.nc-section-header {
  height: 28dp;
  margin: 0;
  padding: 0 16dp;
  font-size: 13dp;
  line-height: 28dp;
  font-weight: bold;
}

/* Phone Add contact sheet (Kenneth 2026-11-04): a search field, my account card (avatar, name, account id, quiet copy and
   share buttons of 44dp), then four big tiles. Colours: colors.rcss.tmpl. */
.shell-layer-compact .ac-page,
.shell-layer-compact .qr-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.shell-layer-compact .ac-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding-bottom: 32dp;
  box-sizing: border-box;
}

.shell-layer-compact .ac-search {
  margin-top: 8dp;
}

.shell-layer-compact .ac-card {
  margin: 12dp 16dp 0 16dp;
  border-radius: 12dp;
  overflow: hidden;
}

.shell-layer-compact .ac-account {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
  min-height: 76dp;
  padding: 12dp 4dp 12dp 16dp;
  box-sizing: border-box;
}

.shell-layer-compact .ac-avatar,
.shell-layer-compact .ac-avatar-image {
  width: 52dp;
  height: 52dp;
  border-radius: 26dp;
}

.shell-layer-compact .ac-avatar .avatar-letter {
  font-size: 22dp;
}

.shell-layer-compact .ac-account-body {
  flex: 1;
  min-width: 0;
}

.shell-layer-compact .ac-account-name {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
}

.shell-layer-compact .ac-account-id {
  margin: 2dp 0 0 0;
  font-size: 13dp;
  line-height: 18dp;
  overflow: hidden;
  white-space: nowrap;
}

.shell-layer-compact .ac-icon-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  cursor: pointer;
}

/* Scan, My QR code, Invite and New group as four big tiles, two to a row with an even 12dp gap, the rows lined up
   with the account card (Kenneth 2026-11-04: "直接用大图标大按钮"). The whole tile is the button. */
.shell-layer-compact .ac-tiles {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12dp;
  margin: 12dp 16dp 0 16dp;
}

/* The two cards at the top of the sheet, scan and my QR code, side by side like the New chat page's action rows:
   a round icon and a label, 60dp tall. */
.shell-layer-compact .ac-top-cards {
  display: flex;
  flex-direction: row;
  gap: 12dp;
  margin: 4dp 16dp 12dp 16dp;
}

.shell-layer-compact .ac-top-card {
  flex: 1 1 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10dp;
  height: 60dp;
  padding: 0 8dp;
  border-radius: 14dp;
  box-sizing: border-box;
  cursor: pointer;
}

.shell-layer-compact .ac-top-card:active {
  opacity: 0.6;
}

.shell-layer-compact .ac-top-card-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
}

.shell-layer-compact .ac-top-card-icon svg {
  flex-shrink: 0;
  width: 20dp;
  height: 20dp;
}

.shell-layer-compact .ac-top-card-label {
  margin: 0;
  font-size: 16dp;
  line-height: 22dp;
  font-weight: bold;
}

.shell-layer-compact .ac-tile {
  flex: 1 1 40%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 104dp;
  padding: 12dp 8dp;
  border-radius: 14dp;
  box-sizing: border-box;
  cursor: pointer;
}

.shell-layer-compact .ac-tile:active {
  opacity: 0.6;
}

.shell-layer-compact .ac-tile-disc {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52dp;
  height: 52dp;
  border-radius: 26dp;
}

.shell-layer-compact .ac-tile-icon {
  flex-shrink: 0;
  width: 28dp;
  height: 28dp;
}

.shell-layer-compact .ac-tile-label {
  margin: 8dp 0 0 0;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

.shell-layer-compact .ac-results {
  margin-top: 4dp;
}

.shell-layer-compact .ac-note {
  margin: 0;
  padding: 32dp 16dp;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

/* My QR code sheet: the code on a white card, my name under it, one line of help. */
.shell-layer-compact .qr-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24dp 16dp 32dp 16dp;
  box-sizing: border-box;
}

.shell-layer-compact .qr-card {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260dp;
  height: 260dp;
  border-radius: 16dp;
}

.shell-layer-compact .qr-code {
  width: 240dp;
  height: 240dp;
}

.shell-layer-compact .qr-name {
  margin: 20dp 0 0 0;
  font-size: 20dp;
  line-height: 26dp;
  font-weight: bold;
  text-align: center;
}

.shell-layer-compact .qr-hint {
  margin: 6dp 0 0 0;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

/* Phone "Blocked" list (Settings > Security; Kenneth 2026-11-04): a short note, a card of 60dp rows (avatar, name,
   a 44dp Unblock on the right); a tap on the avatar or name opens the person's page. The result line goes under it. */
.blocked-page {
  height: 100%;
  overflow-y: auto;
  padding-bottom: 32dp;
  box-sizing: border-box;
}

.blocked-page .blocked-help {
  margin-top: 16dp;
}

.blocked-page .blocked-list {
  margin-top: 12dp;
}

.blocked-page .blocked-empty {
  margin-top: 48dp;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

.blocked-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
  height: 60dp;
  padding-left: 16dp;
}

.blocked-row-avatar {
  flex-shrink: 0;
  cursor: pointer;
}

.blocked-row-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 60dp;
  box-sizing: border-box;
}

.blocked-row-name {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 17dp;
  line-height: 60dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  cursor: pointer;
}

.blocked-unblock {
  flex-shrink: 0;
  height: 44dp;
  min-width: 44dp;
  margin: 0;
  padding: 0 16dp;
  border: 0;
  font-size: 15dp;
  line-height: 44dp;
  cursor: pointer;
}

/* Contact detail, phone. */
.shell-layer-compact .contact-detail-panel {
  display: block;
  padding: 0 0 32dp 0;
  overflow-y: auto;
}

.shell-layer-compact .contacts-detail-body,
.shell-layer-compact .contacts-actions,
.shell-layer-compact .contact-detail-panel .contacts-trust-badge,
.shell-layer-compact .contact-detail-panel .contacts-row-subtitle--desktop {
  display: none;
}

.shell-layer-compact .contacts-detail-header {
  margin: 0;
  padding: 16dp 16dp 0 16dp;
}

.shell-layer-compact .contact-detail-avatar-row {
  flex-direction: column;
  align-items: center;
  gap: 8dp;
}

.shell-layer-compact .contact-detail-avatar-frame {
  width: 96dp;
  height: 96dp;
  border-radius: 48dp;
}

.shell-layer-compact .contact-detail-avatar-image {
  width: 96dp;
  height: 96dp;
}

.shell-layer-compact .contact-detail-avatar-frame .avatar-letter {
  font-size: 40dp;
}

.shell-layer-compact .contact-detail-title-block {
  flex: none;
  align-items: center;
}

.shell-layer-compact .contact-detail-panel .contacts-header-title {
  font-size: 22dp;
  line-height: 28dp;
}

.shell-layer-compact .contact-detail-panel .contacts-row-title-line {
  justify-content: center;
}

.shell-layer-compact .cd-account {
  display: block;
  width: 100%;
  margin: 0;
  text-align: center;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-layer-compact .cd-phone {
  display: block;
}

.cd-acts {
  justify-content: center;
  gap: 16dp;
  margin-top: 16dp;
}

.cd-act {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 76dp;
  height: 64dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 13dp;
  box-sizing: border-box;
  cursor: pointer;
}

.cd-act-icon {
  width: 24dp;
  height: 24dp;
}

.cd-act-label {
  margin: 3dp 0 0 0;
  font-size: 11dp;
  line-height: 13dp;
}

.cd-card {
  margin: 20dp 16dp 0 16dp;
  border-radius: 10dp;
  overflow: hidden;
}

.cd-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 44dp;
  margin: 0;
  padding: 0 0 0 16dp;
  border: 0;
  box-sizing: border-box;
  text-align: left;
  cursor: pointer;
  font-family: LatoLatin;
}

.cd-row-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  height: 44dp;
  padding-right: 12dp;
  box-sizing: border-box;
}

/* Each row sits 1dp up so its top separator overlaps the row above; the card clips the first one, whichever
   rows data-if has hidden. */
.cd-card .cd-row {
  margin-top: -1dp;
}

.cd-row-text {
  flex: 1;
  min-width: 0;
  font-size: 17dp;
  line-height: 22dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cd-row-value {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 60%;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Same pattern as the settings inputs: label above, field full width, text and caret from the left. */
.cd-row--field {
  height: auto;
  min-height: 44dp;
}

.cd-row--field .cd-row-body {
  display: block;
  height: auto;
  padding: 10dp 12dp 4dp 0;
}

.cd-row--field .cd-row-text {
  display: block;
  flex: none;
  width: auto;
  font-size: 13dp;
  line-height: 18dp;
}

.cd-field {
  display: block;
  flex: none;
  width: 100%;
  min-width: 0;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  box-sizing: border-box;
  font-size: 17dp;
  text-align: left;
  background-color: transparent;
}

.shell-layer-compact .cd-row--field .cd-row-body {
  position: relative;
  padding-bottom: 0;
}

/* Text and caret centred in the 44dp box (Kenneth 2026-11-04: the note sat at the top): the engine draws them one
   line tall at the top of the content box, so the box is a 22dp line with 11dp above and below, as the search fields. */
.shell-layer-compact .cd-field {
  margin: 0 0 10dp 0;
  padding: 11dp 12dp;
  border-radius: 10dp;
  line-height: 22dp;
}

.shell-layer-compact .cd-row--field .group-field-hint {
  bottom: 10dp;
}

.cd-switch {
  width: 51dp;
  height: 31dp;
  min-width: 51dp;
}

.cd-switch .settings-switch-knob {
  width: 27dp;
  height: 27dp;
}

.cd-switch.settings-switch--on .settings-switch-knob {
  transform: translateX(20dp);
}

.cd-icon-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  margin: 0;
  padding: 0;
  border: 0;
  cursor: pointer;
  background-color: transparent;
}

.cd-icon {
  width: 20dp;
  height: 20dp;
}

.cd-chevron {
  flex-shrink: 0;
  width: 16dp;
  height: 16dp;
}

.cd-footnote {
  margin: 6dp 0 0 0;
  padding: 0 32dp;
  font-size: 13dp;
  line-height: 18dp;
}

/* The contact page's sheet title row: only in a page sheet (the pushed page and the desktop pane have a title bar). The
   page under it scrolls on its own, so the row stays put. */
.cd-sheet-header {
  display: none;
}

.shell-page-sheet .cd-sheet-header {
  display: flex;
}

.shell-page-sheet .contact-detail-panel {
  flex: 1;
  min-height: 0;
}

/* A card's header line above it (the group info's "5 members"): the card then sits right under it. */
.cd-header {
  margin: 20dp 0 6dp 0;
  padding: 0 32dp;
  font-size: 13dp;
  line-height: 18dp;
}

.cd-card.cd-card--headed {
  margin-top: 0;
}

/* Inside the centred qr-body column the card would shrink to its content (one character per line, B179). */
.shell-layer-compact .qr-page .cd-card {
  align-self: stretch;
  margin-left: 0;
  margin-right: 0;
}

/* A person in a card (the group info's members): a 60dp row with a 44dp round avatar before the name (the lists'
   leading column, text at 72dp). */
.cd-row.cd-row--member {
  height: 60dp;
  gap: 12dp;
}

.cd-row--member .cd-row-body {
  height: 60dp;
}

.cd-row--static {
  cursor: default;
}

.cd-row-avatar,
.cd-row-plus {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  border-radius: 22dp;
}

/* The add row's plus: a 36dp disc centred in the 44dp column, its text at 72dp like the members'. */
.cd-row-plus {
  width: 36dp;
  height: 36dp;
  margin: 0 16dp 0 4dp;
  border-radius: 18dp;
}

.cd-row-avatar .avatar-letter {
  font-size: 18dp;
}

/* A small label after a name in a row ("Owner", "Can't reach"). */
.cd-tag {
  flex-shrink: 0;
  height: 20dp;
  padding: 0 6dp;
  border-radius: 6dp;
  box-sizing: border-box;
  font-size: 12dp;
  line-height: 20dp;
  font-weight: bold;
}

/* The owner's "Group admin" card (a person's page opened from their group): 50dp rows with a 22dp icon before the
   label (accent for Re-invite, red for Remove), the hairline from the label; a grey note at the right end. */
.cd-row.cd-row--admin {
  height: 50dp;
  gap: 12dp;
}

.cd-row--admin .cd-row-body {
  height: 50dp;
}

.cd-admin-icon {
  flex-shrink: 0;
  width: 22dp;
  height: 22dp;
}

.cd-admin {
  padding-bottom: 24dp;
}

/* Group member page: help line sits centred under the Add contact button. */
.cd-footnote--center {
  margin-top: 16dp;
  text-align: center;
}

/* ---- Phone chat window (UI refresh batch 3, DESIGN-pp-ui.md 8.4 / 8.5): the desktop keeps the rules above. ---- */

.chat-date-strip,
.chat-group-name,
.chat-row-avatar-col,
.bubble-time,
.prompt-composer-label,
.prompt-icon-v2 {
  display: none;
}

.prompt-composer-pill {
  position: relative;
}

.shell-chat-overlay .messages {
  padding-left: 8dp;
  padding-right: 8dp;
}

/* The transcript runs close to the screen edges (avatars 8dp, own bubbles 10dp so their tail ends 2dp short of the
   edge): the panel's 12dp side padding is cancelled under it (offsets on the absolute scroller; a negative right
   margin on the flex item is not applied by the engine). */
.shell-chat-overlay .chat-messages-wrap .messages {
  left: -12dp;
  right: -12dp;
  padding-right: 10dp;
}

/* The transcript runs up under the header bar (the wrap starts 63dp down: the 56dp bar, the header row's 8dp margin
   less the 1dp it overlaps) and ends at the composer, fading into it; its top padding keeps the first bubble clear at
   rest. It does not change when the bar collapses (no jump; the shorter bar just shows more). A banner between header
   and transcript covers what runs under it. The engine leaves a scroller's own bottom padding out of its scroll
   height, so the last bubble is kept clear of the composer's 16dp fade by a spacer at the end (.composer-clear:
   16dp + 12dp; #89). */
.shell-chat-overlay .chat-messages-wrap .messages {
  top: -63dp;
  padding-top: 63dp;
  padding-bottom: 0;
}

.composer-clear {
  display: none;
}

.shell-chat-overlay .composer-clear {
  display: block;
  height: 28dp;
}

.shell-chat-overlay .chat-gap-banner,
.shell-chat-overlay .chat-call-bar {
  position: relative;
  z-index: 1;
}

/* Edge to edge like the transcript and the composer under it (the panel's 12dp side padding cancelled, #89). */
.shell-chat-overlay .chat-composer-fade {
  display: none;
  top: auto;
  bottom: 0;
  left: -12dp;
  right: -12dp;
  z-index: 1;
}

/* The engine reserves 16dp for an (undrawn) scrollbar; on the phone the transcript scrolls by touch, so own bubbles
   keep only the 8dp margin on the right. */
.shell-chat-overlay .messages scrollbarvertical {
  width: 0dp;
}

/* A video card is a plain block on phones (a flex column would take the card's full 240dp). */
.shell-chat-overlay .chat-attachment-video {
  display: block;
}

.shell-chat-overlay .chat-attachment-video-badge {
  padding: 0;
}

/* Rows: 2dp inside a run, 8dp between runs; bubbles take at most 72% of the width (a clear gap on the opposite side), so the desktop's side gutters go. */
.shell-chat-overlay .message-row {
  margin: 2dp 0 0 0;
}

.shell-chat-overlay .message-row-run-start {
  margin-top: 8dp;
}

.shell-chat-overlay .message-row-peer,
.shell-chat-overlay .message-row-ai {
  padding-right: 0;
}

.shell-chat-overlay .message-row-user {
  padding-left: 0;
}

/* The per-message "name · time" line is replaced by date strips, the in-bubble time and the group name. */
.shell-chat-overlay .sender-label {
  display: none;
}

.shell-chat-overlay .chat-date-strip {
  display: block;
  margin: 8dp 0;
  text-align: center;
}

.shell-chat-overlay .chat-date-pill,
.shell-chat-overlay .chat-system-line p {
  display: inline-block;
  margin: 0;
  padding: 4dp 10dp;
  max-width: 80%;
  border-radius: 999dp;
  font-size: 13dp;
  line-height: 18dp;
}

/* A group invitation (and the owner-unreachable notice) waiting for an answer: a received bubble's width (72%, at most
   280dp) with the group name, one line of text and its buttons as plain accent text rows; once answered it is a
   system line (TranscriptRml). Kenneth 2026-11-04: the card spread over the whole width. */
.shell-chat-overlay .chat-group-invite {
  display: inline-block;
  width: 72%;
  max-width: 280dp;
  margin: 0;
  padding: 10dp 12dp 0 12dp;
  border-width: 0;
  border-radius: 18dp;
  box-sizing: border-box;
  text-align: left;
}

.shell-chat-overlay .chat-group-invite .heading-3 {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
}

.shell-chat-overlay .chat-group-invite .text {
  margin: 2dp 0 4dp 0;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-chat-overlay .chat-group-invite .chat-suggestion {
  display: block;
  width: 100%;
  height: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0;
  border-radius: 0;
  font-size: 17dp;
  line-height: 44dp;
  text-align: left;
}

.shell-chat-overlay .chat-group-name {
  display: block;
  margin: 0 0 2dp 12dp;
  max-width: 72%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 13dp;
  font-weight: bold;
  text-align: left;
}

/* Group chats: the sender's name sits at the top of the bubble (first bubble of a run). A tap opens their page: the
   name's hit box is 44dp tall and spans the bubble (padding out into the bubble's own, cancelled by margins). */
.shell-chat-overlay .bubble .chat-group-name {
  margin: -16dp -14dp -13dp -14dp;
  padding: 16dp 14dp 15dp 14dp;
  max-width: none;
}

/* Group chats: a 32dp avatar column + 8dp gap on every received row, so all received bubbles share one left edge. */
.shell-chat-overlay .chat-row-body--group {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.shell-chat-overlay .chat-row-avatar-col {
  display: block;
  flex-shrink: 0;
  width: 32dp;
  margin-right: 6dp;
  align-self: flex-end;
}

/* The avatar's 44dp hit box: 6dp out on each side and 12dp above, cancelled by margins (the column stays 32dp). */
.shell-chat-overlay .chat-row-avatar-hit {
  display: block;
  margin: -12dp -6dp 0 -6dp;
  padding: 12dp 6dp 0 6dp;
}

.shell-chat-overlay .chat-row-avatar-col-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  border-radius: 16dp;
  overflow: hidden;
}

.shell-chat-overlay .chat-row-avatar-col-avatar .avatar-photo {
  width: 32dp;
  height: 32dp;
}

.shell-chat-overlay .chat-row-avatar-col-avatar .chat-row-avatar-letter {
  font-size: 15dp;
  line-height: 20dp;
}

.shell-chat-overlay .chat-row-body--group .chat-row-content {
  flex: 1;
  min-width: 0;
}


.shell-chat-overlay .bubble {
  padding: 10dp 14dp;
  border-radius: 18dp;
}

/* Message text 17 / 22dp (Kenneth 2026-11-09: everything in the chat was too small). */
.shell-chat-overlay .bubble-text,
.shell-chat-overlay .bubble-text-peer {
  font-size: 17dp;
  line-height: 22dp;
}

/* Emoji-only messages (EmojiOnlyScale): no bubble, the emoji large, like iMessage. 1-3 emoji 36dp (44dp line), 4-6 28dp (36dp line). */
.shell-chat-overlay .bubble.bubble-emoji {
  padding: 0 2dp;
  border-width: 0;
  background-color: transparent;
}

.shell-chat-overlay .bubble-emoji .bubble-text,
.shell-chat-overlay .bubble-emoji .bubble-text-peer {
  font-size: 28dp;
  line-height: 36dp;
}

.shell-chat-overlay .bubble-emoji--xl .bubble-text,
.shell-chat-overlay .bubble-emoji--xl .bubble-text-peer {
  font-size: 36dp;
  line-height: 44dp;
}

.shell-chat-overlay .bubble-emoji .bubble-time,
.shell-chat-overlay .bubble-emoji .bubble-tail {
  display: none;
}

.shell-chat-overlay .bubble-user,
.shell-chat-overlay .bubble-assistant {
  max-width: 72%;
}

.shell-chat-overlay .bubble-assistant {
  border-width: 0;
}

.shell-chat-overlay .bubble-time {
  display: block;
  margin-top: 2dp;
  font-size: 12dp;
  line-height: 14dp;
  text-align: right;
}

.shell-chat-overlay .bubble-deleted .bubble-time {
  display: none;
}

.shell-chat-overlay .chat-quote {
  margin-top: 0;
  padding: 5dp 8dp;
  border-radius: 6dp;
}

/* Pictures, files and voice notes take the bubble colours and corners. Files and videos are compact cards (at most
   240dp, small display text, a 44dp-tall plain "Open" row); a picture card is a 3dp frame around the picture, which
   keeps its own shape inside a 200 x 240dp box: TranscriptRml gives the picture its fitted size (width / height), so
   the frame is laid out for it on every shape (left to max-width / max-height, a very tall one spilled out). */
.shell-chat-overlay .chat-attachment-card {
  display: inline-block;
  min-width: 160dp;
  max-width: 240dp;
  padding: 8dp 12dp 0 12dp;
  border-width: 0;
  border-radius: 18dp;
  box-sizing: border-box;
  text-align: left;
}

.shell-chat-overlay .chat-attachment-card .heading-3,
.shell-chat-overlay .chat-attachment-card .text {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-chat-overlay .chat-attachment-card .muted {
  margin: 2dp 0 0 0;
  font-size: 12dp;
  line-height: 16dp;
}

/* A status line last on a file card ("Downloading 40%", "Couldn't download") keeps 8dp under it, like the top; only
   when reactions hang on that card does it grow by the pills' overlap, so they sit under the line, not on it. A card
   ending in its 44dp action row needs nothing: the pills land in the row's empty lower part (Kenneth 2026-11-05). */
.shell-chat-overlay .chat-attachment-card .muted:last-child {
  margin-bottom: 8dp;
}

.shell-chat-overlay .chat-attachment-card.chat-reaction-host .muted:last-child {
  margin-bottom: 24dp;
}

.shell-chat-overlay .chat-attachment-video-frame {
  max-width: 292dp;
  margin-bottom: 6dp;
}

/* The music card is one width on the phone, inside the 240dp card limit, with room under its controls. */
.shell-chat-overlay .chat-audio-card {
  width: 240dp;
  min-width: 0;
  padding-bottom: 10dp;
}

/* Its subtitle is not a card's status line: no room under it (the card's own padding ends it); reactions hang under
   the controls instead. */
.shell-chat-overlay .chat-audio-card .chat-audio-meta .chat-audio-sub,
.shell-chat-overlay .chat-audio-card.chat-reaction-host .chat-audio-meta .chat-audio-sub {
  margin-bottom: 0;
}

.shell-chat-overlay .chat-audio-card.chat-reaction-host {
  padding-bottom: 24dp;
}

.shell-chat-overlay .chat-attachment-card .chat-suggestion {
  display: block;
  width: 100%;
  height: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0;
  border-radius: 0;
  font-size: 15dp;
  line-height: 44dp;
  text-align: left;
}

/* 12dp corners: the engine does not round the picture itself, so a tighter frame corner keeps its square corner inside. */
.shell-chat-overlay .chat-attachment-card--image {
  min-width: 0;
  max-width: none;
  padding: 3dp;
  border-radius: 12dp;
}

/* The engine does not round an <img> itself, so the picture sits in a clip box (size set inline from the fitted size)
   whose rounded corners and overflow:hidden cut it: 12dp frame minus the 3dp padding = 9dp. The box is inline, so the
   card's shrink-to-fit width counts it (a block one counted as 0 and spilled out of its frame). */
.shell-chat-overlay .chat-attachment-card--image .chat-attachment-clip {
  display: inline-block;
  vertical-align: top;
  max-width: 292dp;
  max-height: 360dp;
  overflow: hidden;
  border-radius: 9dp;
}

/* No max-height on the picture: when it is taller than the clip (cropped) a height cap would shrink the whole picture
   by its ratio and leave it narrower than the clip. The clip crops. */
.shell-chat-overlay .chat-attachment-card--image .chat-attachment-image {
  display: block;
  max-width: 292dp;
  max-height: none;  /* the base .chat-attachment-image caps at 240dp */
  margin: 0;
  border-radius: 9dp;
}

/* The file's size could not be read (no inline size): the picture is the box wide, its height follows its ratio, and
   the clip (box wide too) shows at most 360dp of it from the top. */
.shell-chat-overlay .chat-attachment-card--image .chat-attachment-clip--auto {
  width: 292dp;
}

.shell-chat-overlay .chat-attachment-card--image .chat-attachment-clip--auto .chat-attachment-image {
  width: 292dp;
}

/* On a picture card the tail goes behind the card, so its inner half does not cover the picture's corner; the hook
   outside the card still shows. */
.shell-chat-overlay .chat-attachment-card--image .bubble-tail {
  z-index: -1;
}

/* Speech-bubble tail on the last bubble of a run: a 10x12dp shape half outside the bubble's bottom corner (received:
   left, sent: right); that corner is squared off so the tail grows out of it. Tint: colors-*.rcss. */
.shell-chat-overlay .bubble-tail-host {
  position: relative;
}

.shell-chat-overlay .bubble-tail-host--in {
  border-bottom-left-radius: 4dp;
}

.shell-chat-overlay .bubble-tail-host--out {
  border-bottom-right-radius: 4dp;
}

/* 16x20dp: the inner half overlaps the bubble's squared corner, the outer 8dp is the visible hook. */
.shell-chat-overlay .bubble-tail {
  position: absolute;
  bottom: 0;
  width: 16dp;
  height: 20dp;
}

.shell-chat-overlay .bubble-tail-in {
  left: -8dp;
}

.shell-chat-overlay .bubble-tail-out {
  right: -8dp;
}

/* Phone composer (TODO #202, Kenneth 2026-11-09; chat, AI thread and the ask-AI panel, one component): a floating pill for
   the text (46dp high, the accent emoji circle at its right end, no camera: the plus card has it), a round 44dp plus outside it on
   the left and a round 44dp accent button outside it on the right (the microphone, Send once there is text). 14dp
   from the screen edge to each button, 10dp between a button and the pill; the bar behind is clear, so the transcript scrolls under the floating parts. The
   row is the positioning box and is exactly the pill (which grows upward, up to five lines): the keys sit on its
   last line. The engine draws no placeholder, so the label sits over the empty input. */
.shell-chat-overlay .prompt-composer-row,
.ask-ai .prompt-composer-row {
  position: relative;
}

.shell-chat-overlay .prompt-composer-pill,
.ask-ai .prompt-composer-pill {
  min-height: 46dp;
  margin: 0 54dp;
  padding: 0 46dp 0 16dp;
  border-radius: 23dp;
}

/* The composer's side margin: 14dp from the screen edge to each round button. */
.shell-chat-overlay .prompt-composer {
  margin-left: 14dp;
  margin-right: 14dp;
}

/* 1dp border + 22dp line + 11dp above and below + 1dp border = 46dp. */
.shell-chat-overlay .prompt-composer-input,
.ask-ai .prompt-composer-input {
  padding: 11dp 0;
  font-size: 17dp;
  line-height: 22dp;
}

.shell-chat-overlay .prompt-composer-label,
.ask-ai .prompt-composer-label {
  display: block;
  position: absolute;
  top: 0;
  left: 17dp;
  height: 44dp;
  margin: 0;
  font-size: 17dp;
  line-height: 44dp;
  pointer-events: none;
}

.shell-chat-overlay .prompt-icon-classic,
.ask-ai .prompt-icon-classic {
  display: none;
}

.shell-chat-overlay .prompt-icon-v2,
.ask-ai .prompt-icon-v2 {
  display: block;
  flex-shrink: 0;
  width: 24dp;
  height: 24dp;
}

/* Phones: the bold plus (ChatController::OnAttachFile opens the chat's or the AI's floating card). */
.prompt-icon-plus {
  display: none;
}

.shell-chat-overlay .prompt-attach-btn .prompt-icon-v2 {
  display: none;
}

.shell-chat-overlay .prompt-attach-btn .prompt-icon-plus,
.ask-ai .prompt-attach-btn .prompt-icon-plus {
  display: block;
  flex-shrink: 0;
  width: 24dp;
  height: 24dp;
}

/* The plus: a 44dp filled circle left of the pill (the button sits in the pill's markup; -54dp = the 10dp gap and its
   44dp, from the pill's border box). Its bottom is 1dp above the pill's, which centres it on the one-line pill. */
.shell-chat-overlay .prompt-composer-pill .prompt-attach-btn,
.ask-ai .prompt-composer-pill .prompt-attach-btn {
  position: absolute;
  left: -54dp;
  bottom: 1dp;
  box-sizing: border-box;
  width: 44dp;
  min-width: 44dp;
  height: 44dp;
  margin: 0;
  border-radius: 22dp;
}

/* The emoji key: the home card's accent-tinted 32dp circle, 7dp inside the pill's right end (Kenneth 2026-11-10; the pill's
   right padding keeps the text clear of it), centred on the one-line pill and on its last line when the text grows. */
.shell-chat-overlay .prompt-composer-row .prompt-emoji-btn,
.ask-ai .prompt-composer-row .prompt-emoji-btn {
  position: absolute;
  right: 61dp;
  bottom: 7dp;
  z-index: 1;
  width: 32dp;
  min-width: 32dp;
  height: 32dp;
  margin: 0;
  border-radius: 16dp;
}

.shell-chat-overlay .prompt-emoji-btn .prompt-icon-v2,
.ask-ai .prompt-emoji-btn .prompt-icon-v2 {
  display: none;
}

.shell-chat-overlay .prompt-emoji-btn .prompt-icon-home-emoji,
.ask-ai .prompt-emoji-btn .prompt-icon-home-emoji {
  display: block;
  width: 32dp;
  height: 32dp;
  padding: 4dp;
  box-sizing: border-box;
  border-radius: 16dp;
}

.shell-chat-overlay .prompt-composer-pill .prompt-capture-btn,
.ask-ai .prompt-composer-pill .prompt-capture-btn {
  display: none;
}

/* The disabled Send of an empty AI field (TODO #205) exists only in the phone chat and the ask-AI panel. */
.prompt-send-btn--idle {
  display: none;
  pointer-events: none;
}

/* The microphone and Send share one place: a round 44dp button right of the pill, filled with the accent
   (colors-*.rcss). Only one of them is in the markup at a time. */
.shell-chat-overlay .prompt-composer-row .prompt-send-btn,
.shell-chat-overlay .prompt-composer-row .prompt-voice-toggle-btn--end,
.ask-ai .prompt-composer-row .prompt-send-btn {
  display: flex;
  position: absolute;
  right: 0;
  bottom: 1dp;
  z-index: 1;
  width: 44dp;
  min-width: 44dp;
  height: 44dp;
  margin: 0;
  border-radius: 22dp;
}

.shell-chat-overlay .prompt-send-disc,
.ask-ai .prompt-send-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
}

.shell-chat-overlay .prompt-send-btn svg,
.ask-ai .prompt-send-btn svg {
  width: 22dp;
  height: 22dp;
}

/* Voice mode (a people chat): the hold-to-talk bar takes the pill's place; the keyboard key sits inside its right end. */
.shell-chat-overlay .prompt-voice-bar {
  padding-right: 44dp;
}

.shell-chat-overlay .prompt-voice-toggle-btn--start {
  display: none;
}

.shell-chat-overlay .prompt-voice-toggle-btn--end {
  display: flex;
}

/* The ask-AI panel's settings "?" (text only): no plus, so the pill starts at the left margin. */
.ask-ai .ask-ai-input-row--text-only .prompt-composer-pill {
  margin-left: 0;
}

/* Grouped lists on phones: the Me tab and the settings pages (DESIGN-pp-ui 8.7, 8.10). Same geometry as the .cd-*
   contact-detail cards above. The plain group-* classes are inert on desktop; everything visual is scoped to
   .shell-layer-compact. */
.group-row-body {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 12dp;
}

.group-row-body--field {
  display: block;
}

/* "?" beside a hard setting (Kenneth 2026-11-04): a 44dp target round a 20dp icon right after the label; a tap
   asks PP 客服 about it (SettingsController::OnAskSettingHelp). */
.settings-q-label {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.group-row-body .settings-q-label .group-row-text,
.group-row-label.settings-q-label .group-row-text {
  flex: 0 1 auto;
}

.settings-q-head {
  align-items: center;
}

.settings-q-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin: -10dp 0 -10dp -6dp;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  cursor: pointer;
}

.settings-q-icon {
  flex-shrink: 0;
  width: 20dp;
  height: 20dp;
}

.settings-phone-only,
.settings-back-v2 {
  display: none;
}

.shell-layer-compact .settings-phone-only {
  display: block;
}

/* Me → AI assistant → Assistant look: "Daily" and the seven looks, four to a row (two rows), the chosen one ringed. */
.shell-layer-compact .ai-look-picker.settings-phone-only {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 12dp 4dp;
  box-sizing: border-box;
}

.ai-look {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 25%;
  width: 25%;
  min-width: 0;
  margin: 0 0 8dp 0;
  padding: 0;
  border: 0;
  gap: 6dp;
  cursor: pointer;
}

.ai-look-art {
  display: block;
  width: 60dp;
  height: 60dp;
  padding: 4dp;
  border-width: 2dp;
  border-radius: 13dp;
  box-sizing: border-box;
}

.ai-look-art svg {
  display: block;
  width: 48dp;
  height: 48dp;
}

.ai-look-name {
  display: block;
  font-size: 13dp;
  line-height: 18dp;
  text-align: center;
}

.shell-layer-compact .settings-desktop-only,
.shell-layer-compact .settings-back-old {
  display: none;
}

.shell-layer-compact .settings-back-v2 {
  display: block;
}

.shell-layer-compact .settings-panel {
  padding: 0;
}

.shell-layer-compact .settings-list-view {
  padding-bottom: 81dp;
}

.shell-layer-compact .settings-list-view .large-title {
  padding: 0 16dp;
}

/* Pushed detail page: 44dp bar, plain accent back arrow, centred title. The bar floats over the body, which scrolls
   under it (and under the tab bar) from 44dp down. */
.shell-layer-compact .settings-detail-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 3;
  display: block;
  height: 44dp;
  margin: 0;
}

.shell-nav-page--frost .settings-detail-header {
  backdrop-filter: blur(20px);
}

.shell-layer-compact .settings-back-btn {
  position: absolute;
  top: 2dp;
  left: 12dp;
  width: 52dp;
  height: 52dp;
  min-width: 52dp;
  margin: 0;
  border-radius: 0;
  z-index: 1;
}

.shell-layer-compact .settings-header-title {
  position: absolute;
  top: 0;
  left: 96dp;
  right: 96dp;
  height: 44dp;
  font-size: 17dp;
  line-height: 44dp;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .settings-detail-body {
  gap: 0;
  padding-top: 44dp;
  padding-bottom: 81dp;
  box-sizing: border-box;
}

/* The engine leaves a scroller's own bottom padding out of its scroll height, so the clearance above the tab bar
   goes on the section inside it: with the large title on top, the end of a longer page (Security) would otherwise
   stay under the tab bar where it cannot be scrolled to. */
.shell-layer-compact #settings-section-mount-sheet {
  padding-bottom: 81dp;
}

/* Pushed pages (Kenneth 2026-11-04/05, PLAN-ui-refresh-impl 原话 71, 78, 80; NavBarCollapseModel): a settings page,
   a pushed page over it (Change PIN, a choice page) and the blocked list open with a 28dp title at the top of their
   content, under a slim, clear bar (back arrow, "?"); the title scrolls with the content (no small title in the bar).
   The contact / member page has no title at all (原话 80): its bar holds only the back arrow.
   Scrolled away from the top the bar slides up out of view, back towards the top it slides back
   (.nav-bar-hidden on the page, .nav-bar-host); shown over content (.nav-bar-scrolled) it has its material and fade.
   Page sheets keep their centred title row (the large title shows only on the pushed page). */
.page-large-title {
  display: none;
}

.shell-layer-compact .settings-detail-view .page-large-title,
.shell-layer-transient.shell-layer-compact .page-large-title {
  display: block;
  flex-shrink: 0;
  height: 41dp;
  margin: 0;
  padding: 0 16dp;
  font-size: 28dp;
  line-height: 34dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* The engine keeps 16dp for an (undrawn) scrollbar once a page overflows; pushed pages scroll by touch, so their cards
   keep their 16dp margins on both sides (the large title makes more pages long enough to scroll). */
.shell-layer-compact .nav-bar-scroll scrollbarvertical {
  width: 0dp;
}

/* A page pushed over a settings page has a clear bar at rest too: the page under it hides its own bar meanwhile. */
.shell-layer-compact .settings-panel--subpage #settings-detail-view .settings-detail-header {
  visibility: hidden;
}

/* The pushed contact page starts under its 48dp bar like the blocked list (the phone rule above zeroed its top). */
.shell-layer-transient.shell-layer-compact .contact-detail-panel {
  padding-top: 48dp;
}

.shell-layer-compact .nav-bar-host .settings-detail-header .bar-fade,
.shell-layer-transient.nav-bar-host .shell-transient-chrome .bar-fade {
  opacity: 0;
  transition: opacity 0.2s cubic-out;
}

.shell-layer-compact .nav-bar-host.nav-bar-scrolled .settings-detail-header .bar-fade,
.shell-layer-transient.nav-bar-host.nav-bar-scrolled .shell-transient-chrome .bar-fade {
  opacity: 1;
}

/* The bar's material is its own first child (.nav-bar-bg), like the tab pages' .pane-nav-bg: it shows once content is
   under the bar and is frosted only then. The engine draws no backdrop blur for a bar that carries a z-index and
   children itself, so the bar stays clear and the child carries colour and blur. */
.nav-bar-bg {
  display: none;
}

.shell-nav-page--frost .nav-bar-host .settings-detail-header,
.shell-layer-transient.nav-bar-host .shell-transient-chrome.surface-chrome--frost {
  backdrop-filter: none;
}

.shell-layer-compact .nav-bar-host .nav-bar-bg,
.shell-layer-compact.nav-bar-host .nav-bar-bg {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0;
  transition: opacity 0.2s cubic-out;
}

.shell-layer-compact .nav-bar-host.nav-bar-scrolled .nav-bar-bg,
.shell-layer-compact.nav-bar-host.nav-bar-scrolled .nav-bar-bg {
  opacity: 1;
}

.shell-nav-page--frost .nav-bar-host.nav-bar-scrolled .nav-bar-bg,
.shell-layer-transient.nav-bar-host.nav-bar-scrolled .surface-chrome--frost .nav-bar-bg {
  backdrop-filter: blur(20px);
}

/* Hiding: the bar and its 16dp fade slide up out of view, under the page's top edge (the tab page and the pushed layer
   clip there, under the status bar); hidden, it takes no taps. */
.shell-layer-compact .nav-bar-host .settings-detail-header,
.shell-layer-transient.nav-bar-host .shell-transient-chrome {
  transition: transform 0.25s cubic-out;
}

.shell-layer-compact .nav-bar-host.nav-bar-hidden .settings-detail-header {
  transform: translateY(-60dp);
  pointer-events: none;
}

.shell-layer-transient.nav-bar-host.nav-bar-hidden .shell-transient-chrome {
  transform: translateY(-64dp);
  pointer-events: none;
}

.shell-layer-transient.shell-layer-compact.nav-bar-host {
  overflow: hidden;
}

/* Above the material (a static button would paint under the positioned child). */
.shell-layer-transient.nav-bar-host .shell-transient-chrome .shell-back-btn {
  position: relative;
}

.shell-layer-compact .settings-section {
  margin-top: 0;
  padding: 0 16dp;
}

.shell-layer-compact .settings-section--grouped {
  padding: 0;
}

.shell-layer-compact .group-card {
  margin: 20dp 16dp 0 16dp;
  border-radius: 10dp;
  overflow: hidden;
}

.shell-layer-compact .group-card--top {
  margin-top: 8dp;
}

.shell-layer-compact .group-head + .group-card {
  margin-top: 0;
}

.shell-layer-compact .group-card--pad {
  padding: 12dp 16dp;
  box-sizing: border-box;
}

.shell-layer-compact .group-card-title {
  margin: 0 0 4dp 0;
  font-size: 17dp;
  line-height: 22dp;
}

.shell-layer-compact .group-note {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-layer-compact .group-head {
  margin: 20dp 32dp 6dp 32dp;
  font-size: 13dp;
  line-height: 18dp;
}

/* A "?" right after the heading: the heading gives up its right margin (the button's own -6dp pulls it in). */
.shell-layer-compact .settings-q-head .group-head {
  margin-right: 0;
}

.shell-layer-compact .group-foot {
  margin: 6dp 32dp 0 32dp;
  font-size: 13dp;
  line-height: 18dp;
}

.shell-layer-compact .group-title {
  margin: 20dp 16dp 0 16dp;
  font-size: 22dp;
  line-height: 28dp;
  text-align: center;
}

.shell-layer-compact .group-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 50dp;
  margin: 0;
  padding: 0 0 0 16dp;
  border: 0;
  border-radius: 0;
  gap: 0;
  box-sizing: border-box;
  text-align: left;
  cursor: pointer;
  font-family: LatoLatin;
}

/* Each row sits 1dp up so its top separator overlaps the row above; the card clips the first one. */
.shell-layer-compact .group-card .group-row {
  margin-top: -1dp;
}

.shell-layer-compact .group-row-body {
  gap: 8dp;
  min-height: 50dp;
  padding: 0 12dp 0 0;
  box-sizing: border-box;
}

/* A 36dp tile centred in the lists' 44dp leading column (4dp each side, then the 12dp gap): text at 72dp like Chats. */
.shell-layer-compact .group-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  margin: 0 16dp 0 4dp;
  border-radius: 8dp;
}

.shell-layer-compact .group-icon svg {
  width: 22dp;
  height: 22dp;
}

.shell-layer-compact .group-row-label {
  flex: 1;
  min-width: 0;
  padding: 10dp 0 10dp 0;
}

.shell-layer-compact .group-row-text {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* A sentence in a row (the banner-style tip): wraps instead of being cut off. */
.shell-layer-compact .group-row-text.settings-row-sentence {
  white-space: normal;
  overflow: visible;
  padding: 10dp 0;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-layer-compact .group-row-label .group-row-text {
  display: block;
}

.shell-layer-compact .group-row-sub {
  display: block;
  font-size: 13dp;
  line-height: 18dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .group-row-value {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 60%;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .group-chevron,
.shell-layer-compact .group-row .settings-row-chevron {
  flex-shrink: 0;
  width: 16dp;
  height: 16dp;
  margin-left: 0;
}

/* A pick-one-value page (SettingsChoicePage, Kenneth 2026-11-04): one 50dp row per value, the current one with an
   accent check at the right end (iOS Settings). */
.shell-layer-compact .settings-choice-option .group-row-body {
  padding-right: 16dp;
}

.shell-layer-compact .settings-choice-check {
  flex-shrink: 0;
  width: 20dp;
  height: 20dp;
}

/* The pushed page's "?" sits at the right end of its bar, a 44dp target like the back arrow. */
.shell-layer-compact .settings-detail-header .settings-subpage-help {
  position: absolute;
  top: 0;
  right: 4dp;
  margin: 0;
}

/* Current value on the right of a row that opens a choice: one size below the 17dp title. */
.shell-layer-compact .group-row .settings-choice-value-text {
  font-size: 14dp;
  line-height: 20dp;
}

/* Text inputs on settings and profile pages: label above the field, both starting at the left edge. The field fills
   the row and its text and caret start at the left (a right-aligned field put the caret mid-row or at the far end). */
.shell-layer-compact .group-row--field .group-row-body {
  position: relative;
  display: block;
  min-height: 0;
  padding: 10dp 16dp 0 0;
}

.shell-layer-compact .group-row--field .group-row-text {
  display: block;
  flex: none;
  width: auto;
  margin: 0 0 2dp 0;
  font-size: 13dp;
  line-height: 18dp;
  text-align: left;
}

/* The field is a filled rounded box (like the search field) so it reads as something to type into. */
.shell-layer-compact .group-card .field {
  display: block;
  flex: none;
  width: 100%;
  min-width: 0;
  height: 44dp;
  min-height: 44dp;
  max-height: 44dp;
  margin: 0 0 10dp 0;
  /* A 22dp line between 11dp paddings: text and a line-tall caret in the middle (a 44dp line drew a full-height caret). */
  padding: 11dp 12dp;
  border: 0;
  border-radius: 10dp;
  box-sizing: border-box;
  font-size: 17dp;
  line-height: 22dp;
  text-align: left;
}

/* The engine draws no placeholder: this hint sits over the empty field and lets taps through to it. */
.group-field-hint {
  display: none;
}

.shell-layer-compact .group-field-hint {
  position: absolute;
  left: 12dp;
  bottom: 10dp;
  display: block;
  height: 44dp;
  margin: 0;
  font-size: 17dp;
  line-height: 44dp;
  white-space: nowrap;
  pointer-events: none;
}

/* While an IME composes (pinyin), the bound value is still empty but the field already shows the composition: the
   engine marks the field :composing, and the placeholder label after it hides (Kenneth 2026-11-04: "消息" stayed under
   the pinyin). The prefixed forms outrank the phone rules that show the labels. */
input:composing ~ .group-field-hint,
input:composing ~ .chat-search-label,
input:composing ~ .people-picker-search-hint,
textarea:composing ~ .prompt-composer-label,
.shell-layer-compact input:composing ~ .group-field-hint,
.shell-layer-compact input:composing ~ .chat-search-label,
.shell-layer-compact .shell-page-sheet input:composing ~ .people-picker-search-hint,
.shell-layer-compact textarea:composing ~ .prompt-composer-label {
  display: none;
}

/* A row that only shows a value (nothing to tap). */
.shell-layer-compact .group-row--static {
  cursor: default;
}

/* Account ID row on the profile page: label over value on the left, Copy / Share / QR icon buttons on the right. */
.shell-layer-compact .group-id-row {
  cursor: default;
}

.shell-layer-compact .group-id-text {
  flex: 1;
  min-width: 0;
  display: block;
  padding: 8dp 0;
}

.shell-layer-compact .group-id-label {
  display: block;
  font-size: 13dp;
  line-height: 18dp;
}

.shell-layer-compact .group-id-value {
  display: block;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .group-id-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  background-color: transparent;
  cursor: pointer;
}

.shell-layer-compact .group-row .settings-switch {
  width: 51dp;
  height: 31dp;
  min-width: 51dp;
}

.shell-layer-compact .group-row .settings-switch-knob {
  width: 27dp;
  height: 27dp;
}

.shell-layer-compact .group-row .settings-switch--on .settings-switch-knob {
  transform: translateX(20dp);
}

/* Me profile card. */
.shell-layer-compact .me-card-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-right: 8dp;
}

.shell-layer-compact .me-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
  margin: 0;
  padding: 12dp;
  border: 0;
  box-sizing: border-box;
  text-align: left;
  cursor: pointer;
}

.shell-layer-compact .me-card-avatar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60dp;
  height: 60dp;
  border-radius: 30dp;
  overflow: hidden;
}

.shell-layer-compact .me-card-avatar .avatar-letter {
  font-size: 24dp;
}

.shell-layer-compact .me-card-avatar-image {
  width: 60dp;
  height: 60dp;
}

.shell-layer-compact .me-card-text {
  flex: 1;
  min-width: 0;
}

.shell-layer-compact .me-card-name {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .me-card-meta {
  margin: 1dp 0 0 0;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Buttons on settings pages (DESIGN-pp-ui 8.10): 50dp pill, full width. Inside a card they shrink to 36dp pills. */
.shell-layer-compact .settings-section--grouped .btn {
  display: block;
  width: auto;
  height: 50dp;
  min-height: 50dp;
  margin: 16dp 16dp 0 16dp;
  padding: 0 16dp;
  font-size: 17dp;
  line-height: 50dp;
  font-weight: bold;
  text-align: center;
}

.shell-layer-compact .settings-section--grouped .btn-icon {
  display: flex;
}

/* Desktop-only buttons (the profile page's Copy / Share / QR live in the Account ID row on phones; Send problem logs
   lives in About on phones). */
.shell-layer-compact .settings-section--grouped .btn.settings-desktop-only,
.shell-layer-compact .settings-section--grouped .group-actions.settings-desktop-only {
  display: none;
}

/* The disabled Send problem logs row (while it sends) reads as waiting. */
.shell-layer-compact .settings-improve-send:disabled {
  opacity: 0.5;
}

.shell-layer-compact .settings-section--grouped .settings-action-bar {
  width: auto;
}

.shell-layer-compact .settings-section--grouped .settings-actions {
  display: block;
  margin-top: 0;
}

.shell-layer-compact .settings-section--grouped .me-profile-actions {
  display: block;
  margin-top: 0;
}

.shell-layer-compact .settings-section--grouped .group-actions {
  display: flex;
  flex-direction: row;
  /* Not .settings-toggle-row's 100%: with the 16dp margins the row ran 32dp past the screen and cut off its "?". */
  width: auto;
  margin: 16dp 16dp 0 16dp;
  gap: 8dp;
}

.shell-layer-compact .settings-section--grouped .group-card .btn,
.shell-layer-compact .settings-section--grouped .group-actions .btn {
  flex: 1;
  height: 36dp;
  min-height: 36dp;
  margin: 8dp 8dp 0 0;
  font-size: 15dp;
  line-height: 36dp;
}

.shell-layer-compact .settings-section--grouped .group-actions .btn {
  margin: 0;
}

.shell-layer-compact .me-profile-avatar-row {
  margin-bottom: 0;
}

.shell-layer-compact .settings-device-actions {
  gap: 0;
}

.shell-layer-compact .settings-device-title {
  gap: 8dp;
}

/* ---- Phone Today page (UI refresh batch 4, DESIGN-pp-ui.md 8.16). The desktop keeps the brand header and the centred
   composer above; the scroller below only exists on the phone. ---- */

.home-scroll {
  display: none;
}

.shell-layer-compact .home-panel {
  padding: 0;
}

.shell-layer-compact .home-header {
  display: none;
}

.shell-layer-compact .home-scroll {
  display: block;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 44dp 0 16dp 0;
  box-sizing: border-box;
}

.shell-layer-compact .home-date {
  margin: 0;
  padding: 0 16dp;
  font-size: 13dp;
  line-height: 18dp;
}

.shell-layer-compact .home-scroll .large-title {
  padding: 0 16dp;
}

/* The engine keeps 16dp for an (undrawn) scrollbar once the widgets overflow; Home scrolls by touch, so the cards
   keep their 16dp margins on both sides. */
.shell-layer-compact .home-scroll scrollbarvertical {
  width: 0dp;
}

/* The widgets, iPhone style (mockup 10-home-widgets): 20dp corners, 12dp apart; a wide card takes a row, two small
   ones share it. Each slot pads 6dp, so the grid's -6dp edge keeps the cards on the 16dp margins. */
.shell-layer-compact .home-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: stretch;
  margin: 6dp 10dp 0 10dp;
}

.shell-layer-compact .home-slot {
  display: flex;
  flex-direction: column;
  width: 50%;
  padding: 6dp;
  box-sizing: border-box;
}

.shell-layer-compact .home-slot--wide {
  width: 100%;
}

.shell-layer-compact .home-w {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  margin: 0;
  padding: 12dp 14dp;
  border: 0;
  border-radius: 20dp;
  box-sizing: border-box;
  text-align: left;
  font-family: LatoLatin;
}

/* A small card is one target: at least 140dp tall, like the mockup. */
.shell-layer-compact .home-w--tap {
  min-height: 140dp;
  cursor: pointer;
}

.shell-layer-compact .home-wh {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 22dp;
  margin: 0 0 8dp 0;
}

.shell-layer-compact .home-wh-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 20dp;
  height: 20dp;
  margin-right: 6dp;
  border-radius: 6dp;
}

.shell-layer-compact .home-wh-icon svg {
  width: 13dp;
  height: 13dp;
}

.shell-layer-compact .home-wh-title {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 13dp;
  line-height: 18dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* "See all": a 44dp-tall target that does not push the header apart. */
.shell-layer-compact .home-wh-more {
  flex: none;
  margin: -11dp -14dp -11dp 0;
  padding: 11dp 14dp 11dp 12dp;
  border: 0;
  background-color: transparent;
  font-size: 15dp;
  line-height: 22dp;
  cursor: pointer;
}

.shell-layer-compact .home-w-hint {
  margin: 4dp 0 2dp 0;
  font-size: 15dp;
  line-height: 20dp;
}

/* Favorites (关注联系人, Kenneth 2026-11-05 原话 75-77): exactly four people across the card, each a quarter of the
   row, on every screen width; the avatar's size comes from the window width (FavoritesRowModel, bound as
   home_fav_avatar: about 64dp on a 393dp phone, 56-72dp). More than four scroll sideways with momentum (the engine locks
   a touch to one axis, so Home still scrolls up and down) and settle on a whole person (ShellFavoritesSnap). */
.shell-layer-compact .home-avs {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  overflow-x: auto;
  overflow-y: hidden;
}

/* Touch-scrolled: no room kept for an (undrawn) scrollbar under the names. */
.shell-layer-compact .home-avs scrollbarhorizontal {
  height: 0dp;
}

.shell-layer-compact .home-av {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 25%;
  margin: 0;
  padding: 2dp 4dp;
  border: 0;
  box-sizing: border-box;
  background-color: transparent;
  cursor: pointer;
}

.shell-layer-compact .home-av-frame {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 64dp;
  height: 64dp;
  border-radius: 32dp;
  overflow: hidden;
}

.shell-layer-compact .home-av-frame .avatar-photo {
  width: 64dp;
  height: 64dp;
}

.shell-layer-compact .home-av-letter {
  font-size: 24dp;
  line-height: 28dp;
  font-weight: bold;
}

/* Mentions / New people with nothing to show (mockup 12, option C): a faint 40dp icon centred over one grey line,
   in the space the number and its lines take otherwise. Tints: colors-*. */
.shell-layer-compact .home-empty {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.shell-layer-compact .home-empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40dp;
  height: 40dp;
  margin-bottom: 8dp;
  border-radius: 12dp;
}

.shell-layer-compact .home-av-suggest {
  margin-right: 2dp;
  vertical-align: -1dp;
}

.shell-layer-compact .home-av-name {
  display: block;
  width: 100%;
  margin-top: 6dp;
  font-size: 13dp;
  line-height: 18dp;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Recent chats: 52dp rows (36dp avatar, name over a one-line preview, the unread count at the end). */
.shell-layer-compact .home-chat {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 52dp;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  text-align: left;
  cursor: pointer;
}

.shell-layer-compact .home-chat-av {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin-right: 12dp;
  border-radius: 22dp;
  overflow: hidden;
}

.shell-layer-compact .home-chat-av .avatar-photo {
  width: 44dp;
  height: 44dp;
}

.shell-layer-compact .home-chat-letter {
  font-size: 15dp;
  line-height: 20dp;
  font-weight: bold;
}

.shell-layer-compact .home-chat-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.shell-layer-compact .home-chat-title,
.shell-layer-compact .home-chat-preview {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .home-chat-title {
  font-size: 15dp;
  line-height: 20dp;
  font-weight: bold;
}

.shell-layer-compact .home-chat-preview {
  font-size: 13dp;
  line-height: 18dp;
}

.shell-layer-compact .home-chat-badge {
  margin-left: 8dp;
}

/* Small cards: a large count, then what it counts and one more line (two at most). */
.shell-layer-compact .home-num {
  display: block;
  font-size: 34dp;
  line-height: 41dp;
  font-weight: bold;
}

.shell-layer-compact .home-num--word {
  font-size: 17dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .home-small {
  display: block;
  font-size: 13dp;
  line-height: 18dp;
}

.shell-layer-compact .home-small--two {
  max-height: 36dp;
  margin-top: 2dp;
  overflow: hidden;
}

/* Today's briefs: the first headline larger over two lines at most, two smaller ones under a hairline. */
.shell-layer-compact .home-brief {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 44dp;
  margin: 0;
  padding: 6dp 0;
  border: 0;
  background-color: transparent;
  box-sizing: border-box;
  text-align: left;
  cursor: pointer;
}

.shell-layer-compact .home-brief-title {
  display: block;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .home-brief--head {
  padding-top: 0;
}

.shell-layer-compact .home-brief--head .home-brief-title {
  max-height: 44dp;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
  white-space: normal;
}

.shell-layer-compact .home-brief-meta {
  display: block;
  margin-top: 2dp;
  font-size: 12dp;
  line-height: 16dp;
}

/* Edit Home (mockup 10-home-widgets B): a red minus / green plus at the start of each row, the size at its end. */
.shell-layer-compact .home-edit-row {
  position: relative;
  padding-left: 0;
}

/* The held row (ChatController moves it on transform): above the others with a soft shadow (colors-*.rcss), a moving
   element being the one exception to "no shadows". The card lets it out while a row is held. */
.shell-layer-compact .home-edit-row--lifted {
  z-index: 2;
}

.shell-layer-compact .home-edit-card--dragging {
  overflow: visible;
}

.shell-layer-compact .home-edit-toggle {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 52dp;
  height: 50dp;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
}

.shell-layer-compact .home-edit-sign {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22dp;
  height: 22dp;
  border-radius: 11dp;
}

.shell-layer-compact .home-edit-sign svg {
  width: 14dp;
  height: 14dp;
}

.shell-layer-compact .home-edit-size {
  flex: none;
  font-size: 15dp;
  line-height: 20dp;
}

/* The drag handle: a 44 x 50dp target at the row's end; holding it drags the row (the list does not scroll). */
.shell-layer-compact .group-row-body .home-edit-handle {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 50dp;
  margin: 0 -12dp 0 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  drag: drag;
  cursor: pointer;
}

.shell-layer-compact .home-edit-handle svg {
  width: 22dp;
  height: 22dp;
}

/* "More widgets" rows have no handle: the same room, so the sizes line up with the rows above. */
.shell-layer-compact .home-edit-handle-gap {
  display: block;
  flex: none;
  width: 32dp;
}

/* The chips row is pinned above the tab bar and does not scroll with the widgets. */
.shell-layer-compact .home-landing {
  position: relative;
  flex: none;
  display: block;
  padding: 8dp 0 12dp 0;
  box-sizing: border-box;
}

/* Minimal AI-first Home (Kenneth 2026-11-05): with the 动态 widgets hidden (the default), the landing is the whole
   page — it grows and centres the ask-AI heading and the chips. */
.shell-layer-compact .home-landing--minimal {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 8dp 0 12dp 0;
}

/* The "PP 助手" page header, like the Chats page's large title; no search box. */
.home-ai-header {
  display: none;
}
.shell-layer-compact .home-ai-header {
  display: block;
  flex: none;
  width: 100%;
  box-sizing: border-box;
  font-family: LatoLatin;
  font-size: 30dp;
  line-height: 36dp;
  font-weight: bold;
  text-align: left;
  padding: 4dp 16dp 10dp 16dp;
}

/* Empty AI Home: the composer + chips dock at the bottom (the middle is left open under the header). */
.shell-layer-compact .home-landing--minimal .home-landing-inner {
  margin-top: auto;
}

/* No widgets above, so the fade into the dock has nothing to fade from. */
.shell-layer-compact .home-landing--minimal .home-dock-fade {
  display: none;
}

/* Off on phones: the AI conversation list moved to the drawer (2026-11-07), so nothing scrolls into the composer and
   this fade, drawn above the centred block, sat at the top of the page as a grey line under the status bar. */
.shell-layer-compact .home-composer-fade {
  display: none;
}

/* The AI conversation list fills the page and scrolls (its "PP 助手" title scrolls with it); the ask-AI field + chips
   sink to the bottom (Kenneth 2026-11-05). */
.home-ai-list {
  display: none;
}
.shell-layer-compact .home-landing--minimal .home-ai-list {
  display: block;
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden; /* the swipe buttons sit outside the row (SessionSwipeGesture) */
  width: 100%;
}
.shell-layer-compact .home-landing--minimal .home-landing-inner {
  flex: none;
  /* Anchors the composer frost fade (.home-composer-fade sits just above this dock's top edge). */
  position: relative;
}

/* The ask-AI heading above the chips; phone-only, so hidden on the desktop Home. */
.home-ai-intro {
  display: none;
}

.shell-layer-compact .home-ai-intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6dp;
  margin: 0;
  padding: 0 24dp 16dp 24dp;
  text-align: center;
}

.shell-layer-compact .home-ai-title {
  margin: 0;
  font-family: LatoLatin;
  font-size: 26dp;
  line-height: 32dp;
  font-weight: bold;
  text-align: center;
}

.shell-layer-compact .home-ai-subtitle {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

/* The widgets fade into the dock over 28dp (no divider line); touches pass through. Gradient: colors-*.rcss. */
.home-dock-fade,
.home-dock-seam {
  display: none;
}

.shell-layer-compact .home-dock-fade {
  display: block;
  position: absolute;
  top: -28dp;
  left: 0;
  right: 0;
  height: 28dp;
  pointer-events: none;
}

/* The dock's bottom 10dp melt into the tab bar's shade. */
.shell-layer-compact .home-dock-seam {
  display: block;
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 10dp;
  pointer-events: none;
}

/* Home: dock and tab bar are one opaque area (colors-*.rcss), so the bar's blur has nothing to do. */
.shell-bottom-chrome--home,
.shell-bottom-chrome--home.shell-bottom-chrome--frost {
  backdrop-filter: none;
}

.shell-layer-compact .home-landing-inner {
  max-width: none;
  gap: 8dp;
}

/* Phones show the ask-AI field above the chips on the minimal Home (Kenneth 2026-11-05). */
.shell-layer-compact .home-composer-mount {
  display: block;
  padding: 0 40dp;
}

/* The chips wrap onto a second row when they do not fit, centred (Kenneth 2026-11-07). When the keyboard leaves too
   little height they shrink away before the field does (min-height 0 + clip). */
.shell-layer-compact .home-suggestions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  flex: 0 1 auto;
  min-height: 0;
  overflow: hidden;
  padding: 0 36dp;
  text-align: center;
}

.shell-layer-compact .home-suggestions .chat-suggestion {
  flex: none;
  height: 32dp;
  min-height: 32dp;
  margin: 0 4dp 8dp 4dp;
  padding: 0 12dp;
  font-size: 15dp;
  line-height: 32dp;
}

/* Phone minimal AI Home (Kenneth 2026-11-07): one centred block, logo, two-line field, wrapping chips, with open
   space under it. The sessions list moved to the drawer (home.rml keeps the inline one in an expanded-only data-if);
   there is no page heading. The block sits in the middle of the page; both spacers give way first, then the chips and
   the logo shrink and clip, so with the keyboard up the field stays on its top edge (the tab bar hides then,
   ShellHost). */
.home-logo {
  display: none;
}

.shell-layer-compact .home-landing--minimal .home-landing-inner {
  flex: 1 1 0;
  min-height: 0;
  margin-top: 0;
  justify-content: center;
  padding-bottom: 72dp;
}

.shell-layer-compact .home-landing--minimal .home-logo {
  display: block;
  flex: 0 1 auto;
  min-height: 0;
  overflow: hidden;
  height: 100dp;
  margin: 0 0 4dp 0;
  text-align: center;
}

.shell-layer-compact .home-landing--minimal .home-logo img {
  width: 100dp;
  height: 100dp;
  border-radius: 22dp;
}

/* Animated home logo (Kenneth 2026-11-09; ShellHomeMascot): the AI dot's figure drawn at 120dp inside the logo box, which
   keeps room for the shadow the figure's SVGs draw round it. It sits still until tapped (the dot's keyframes). */
.shell-layer-compact .home-landing--minimal .home-logo--mascot {
  height: 140dp;
}

.shell-layer-compact .home-landing--minimal .home-logo--mascot .home-mascot.ai-dot {
  position: relative;
  display: block;
  width: 120dp;
  height: 120dp;
  margin: 10dp auto 0 auto;
}

/* iPhone SE class screens (under 600dp tall): a smaller logo so logo, field and two chip rows fit. */
@media (max-height: 599dp) {
  .shell-layer-compact .home-landing--minimal .home-logo {
    height: 72dp;
    margin-bottom: 10dp;
  }
  .shell-layer-compact .home-landing--minimal .home-logo--mascot {
    height: 96dp;
  }
  .shell-layer-compact .home-landing--minimal .home-logo--mascot .home-mascot.ai-dot {
    width: 80dp;
    height: 80dp;
    margin-top: 8dp;
  }
  .shell-layer-compact .home-landing--minimal .home-logo img {
    width: 72dp;
    height: 72dp;
    border-radius: 16dp;
  }
  .shell-layer-compact .home-landing--minimal .home-landing-inner {
    padding-bottom: 24dp;
  }
}

/* The field on the Home root is two lines tall; its placeholder label is the "what can I do for you" line (the draft
   label for a conversation stays with the conversation's own composer). */
.shell-layer-compact .home-composer-mount .prompt-composer {
  flex: none;
  margin: 0 0 8dp 0;
  border-radius: 20dp;
}

/* The box is the composer, not the pill (Kenneth 2026-11-07): a picture chip (status row) sits inside it, above the
   text; the pill inside is clear (colors.rcss.tmpl). */
.shell-layer-compact .home-composer-mount .prompt-composer-status {
  margin: 12dp 16dp 0 16dp;
}

.shell-layer-compact .home-composer-mount .prompt-composer-pill {
  min-height: 106dp; /* + the box's 1dp border each side = the 108dp card */
  padding: 0 16dp 48dp 16dp;
  border-radius: 20dp;
}

.shell-layer-compact .home-composer-mount .prompt-composer-input {
  align-self: stretch;
  min-height: 36dp;
  padding: 12dp 0 0 0;
}

/* The tools sit inside the box (Kenneth 2026-11-07): a plus circle (the attach flow: Photo / File) and the emoji key at
   the bottom left, Send at the bottom right once there is text; no microphone or camera here. The row and the pill
   are the positioning boxes, so the buttons leave the flow. */
.prompt-icon-home {
  display: none;
}

.shell-layer-compact .home-composer-mount .prompt-composer-row {
  position: relative;
}

.shell-layer-compact .home-composer-mount .prompt-icon-classic,
.shell-layer-compact .home-composer-mount .prompt-icon-v2,
.shell-layer-compact .home-composer-mount .prompt-capture-btn,
.shell-layer-compact .home-composer-mount .prompt-voice-toggle-btn {
  display: none;
}

.shell-layer-compact .home-composer-mount .prompt-icon-home {
  display: block;
  flex-shrink: 0;
  width: 24dp;
  height: 24dp;
}

.shell-layer-compact .home-composer-mount .prompt-attach-btn {
  display: none;
}

.prompt-home-plus {
  display: none;
}

/* Home card B3 (Kenneth 2026-11-09; emoji moved 2026-11-10): the plus (a 44dp target) at the bottom left, the emoji key (a 32dp
   tinted circle in a 44dp target) right before Send (10dp gap), and Send (a 36dp disc) always at the right end: grey and not tappable
   while the field is empty (.prompt-send-btn--idle), accent with text. Nothing swaps places. */
.shell-layer-compact .home-composer-mount .prompt-composer-pill .prompt-home-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  left: 4dp;
  bottom: 6dp;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
}

/* B3 (Kenneth 2026-11-09): the 32dp tinted circle is drawn on the icon; the button around it keeps the 44dp touch
   target (the circle's centre stays 32dp from the right edge and 28dp from the bottom). */
.shell-layer-compact .home-composer-mount .prompt-composer-row .prompt-emoji-btn {
  position: absolute;
  right: 50dp; /* the tinted circle 10dp before the Send disc (Kenneth 2026-11-10: emoji moved right, next to Send) */
  bottom: 6dp;
  z-index: 1;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin: 0;
  padding: 6dp;
  box-sizing: border-box;
  border-radius: 22dp;
  background-color: transparent;
}

.prompt-icon-home-emoji {
  display: none;
}

.shell-layer-compact .home-composer-mount .prompt-emoji-btn .prompt-icon-home-emoji {
  display: block;
  width: 32dp;
  height: 32dp;
  padding: 4dp;
  box-sizing: border-box;
  border-radius: 16dp;
}

.shell-layer-compact .home-composer-mount .prompt-composer-row .prompt-send-btn {
  display: flex;
  position: absolute;
  right: 10dp;
  bottom: 10dp;
  z-index: 1;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin: 0;
  border-radius: 18dp;
}

.shell-layer-compact .home-composer-mount .prompt-send-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
}

.prompt-composer-label--home,
.shell-chat-overlay .prompt-composer-label--home,
.ask-ai .prompt-composer-label--home {
  display: none;
}

.shell-layer-compact .home-composer-mount .prompt-composer-label--thread {
  display: none;
}

.shell-layer-compact .home-composer-mount .prompt-composer-label--home {
  display: block;
  position: absolute;
  top: 12dp;
  left: 16dp;
  margin: 0;
  font-size: 17dp;
  line-height: 24dp;
  pointer-events: none;
}

/* Me → Storage and its "Manage storage" pages (DEV/PLAN-storage-manager.md): iOS-style grouped lists, in-place
 * choice rows with a check, a usage bar, segmented tabs, a 3-column grid and select mode. Surfaces borrow the
 * themed `.settings-row` / `.settings-choice-row` / `.settings-toggle-label` / `.settings-choice-value-text`
 * colours; the fixed colours below read on light and dark alike. */
.storage-section .storage-card,
.storage-section .storage-group {
  display: block;
  margin: 0;
  min-height: 0;
  padding: 0;
  border-radius: 12dp;
  overflow: hidden;
  cursor: default;
}

/* Me -> Storage reset buttons (phone): inset like the other settings buttons instead of edge-to-edge,
   with clear space between the two (Kenneth 2026-11-05). */
.shell-layer-compact .storage-section .settings-danger-zone .settings-action-bar {
  width: auto;
  margin: 12dp 16dp 0 16dp;
}

.storage-section .storage-card {
  padding: 14dp 16dp;
  margin-bottom: 16dp;
}

.storage-usage-line {
  margin: 0 0 10dp 0;
  font-size: 14dp;
}

.storage-usage-big {
  font-size: 22dp;
  font-weight: bold;
}

.storage-bar {
  gap: 0;
  height: 10dp;
  border-radius: 5dp;
  overflow: hidden;
}

.storage-bar-seg {
  flex-shrink: 0;
  height: 10dp;
}

.storage-legend {
  flex-wrap: wrap;
  gap: 6dp 14dp;
  margin-top: 10dp;
}

.storage-legend-item {
  align-items: center;
  gap: 5dp;
}

.storage-dot {
  width: 8dp;
  height: 8dp;
  border-radius: 4dp;
  flex-shrink: 0;
}

.storage-legend-text {
  font-size: 12dp;
  max-width: none;
}


.storage-group-head {
  display: block;
  margin: 4dp 14dp 6dp 14dp;
  font-size: 12dp;
  max-width: none;
}

.storage-group-foot {
  display: block;
  margin: 6dp 14dp 18dp 14dp;
  font-size: 12dp;
  line-height: 1.45;
  max-width: none;
  white-space: normal;
  overflow: visible;
}

.storage-row {
  width: 100%;
  min-height: 46dp;
  padding: 10dp 14dp;
  margin: 0;
  gap: 12dp;
  align-items: center;
  box-sizing: border-box;
}

.storage-row + .storage-row {
  border-top-width: 1dp;
}

.storage-row--indent {
  padding-left: 32dp;
}

.storage-row-label {
  flex: 1;
  min-width: 0;
}

.storage-row-title {
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.storage-row-sub {
  display: block;
  margin-top: 2dp;
  font-size: 12dp;
  max-width: none;
}

/* A choice shown in place (no menu): the chosen row carries a check. */
.settings-radio-row {
  justify-content: space-between;
}

.settings-radio-check {
  flex-shrink: 0;
}

.storage-avatar {
  width: 34dp;
  height: 34dp;
  border-radius: 17dp;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.storage-avatar-letter {
  font-size: 14dp;
}

/* Page header of the deeper pages: back (desktop), title, Select / Cancel. */
.storage-nav {
  align-items: center;
  min-height: 40dp;
  margin-bottom: 10dp;
}

.storage-nav-back,
.storage-nav-action {
  flex-shrink: 0;
  align-items: center;
  gap: 4dp;
  margin: 0;
  padding: 4dp 6dp;
  border: 0;
  background-color: transparent;
  font-size: 15dp;
  cursor: pointer;
}

.storage-nav-back-icon {
}

.storage-nav-title {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Segmented tabs: Photos / Videos / Files. The chosen one takes the themed row surface. */
.storage-seg {
  display: flex;
  flex-direction: row;
  gap: 2dp;
  min-height: 44dp;
  padding: 2dp;
  box-sizing: border-box;
  margin-bottom: 12dp;
  border-radius: 9dp;
}

.storage-seg .storage-seg-tab {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 40dp;
  margin: 0;
  padding: 6dp 0;
  border-width: 0;
  border-radius: 7dp;
  background-color: transparent;
  font-size: 13dp;
  cursor: pointer;
}

.storage-seg .storage-seg-tab--on {
  font-weight: bold;
}

/* Photos and videos: three cells a row, each a fixed 118dp tall (a % padding-top is not resolved against the width
   here, so the cell would collapse and a tall picture would run out of it); the frame clips the picture. */
.storage-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  width: 100%;
  overflow: hidden;
}

.storage-tile {
  position: relative;
  display: block;
  width: 33.333%;
  min-width: 0;
  max-width: 33.333%;
  height: 118dp;
  padding: 0;
  margin: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
}

.storage-tile-frame {
  position: absolute;
  top: 1dp;
  left: 1dp;
  right: 1dp;
  bottom: 1dp;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  clip: always;
}

.storage-tile--video .storage-tile-frame {
}

.storage-tile--picked .storage-tile-frame {
  opacity: 0.7;
}

.storage-tile-image {
  display: block;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: auto;
}

.storage-tile-size {
  position: absolute;
  left: 6dp;
  bottom: 5dp;
  font-size: 11dp;
}

/* A file in the All tab: same cell as a picture, icon on top, one-line name under it. */
.storage-file-frame {
  flex-direction: column;
  padding: 0 4dp 14dp 4dp;
}

.storage-file-icon {
  flex-shrink: 0;
}

.storage-file-ext {
  flex-shrink: 0;
  font-size: 9dp;
  font-weight: bold;
}

.storage-file-name {
  display: block;
  flex-shrink: 0;
  width: 100%;
  margin-top: 4dp;
  font-size: 11dp;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}

.storage-tile-play {
  position: absolute;
  right: 6dp;
  bottom: 6dp;
}

.storage-check {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22dp;
  height: 22dp;
  border-width: 2dp;
  border-radius: 11dp;
  box-sizing: border-box;
}

.storage-tile-check {
  position: absolute;
  top: 6dp;
  right: 6dp;
}

.storage-check--on,
.storage-tile-check.storage-check--on {
}

.storage-check-icon {
}

.storage-file-type {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34dp;
  height: 40dp;
  border-radius: 6dp;
}

.storage-file-type-text {
  font-size: 10dp;
  font-weight: bold;
}

.storage-audio-icon {
  width: 14dp;
  height: 14dp;
  image-color: #ffffff;
}

/* A sound file with a cover: the badge is the cover, play / pause on a dark round mark over it. */
.storage-file-type--cover {
  position: relative;
  width: 40dp;
  overflow: hidden;
}

.storage-audio-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 40dp;
  height: 40dp;
}

.storage-file-type--cover .storage-audio-icon {
  padding: 4dp;
  border-radius: 11dp;
}

.storage-file-cover {
  flex-shrink: 0;
  width: 44dp;
  height: 44dp;
  border-radius: 6dp;
}

.storage-audio-bar {
  height: 3dp;
  margin-top: 4dp;
  border-radius: 2dp;
  background-color: rgba(127, 127, 127, 0.28);
}

.storage-audio-fill {
  height: 3dp;
  border-radius: 2dp;
  background-color: #0a84ff;
}

.storage-more {
  margin-top: 12dp;
}

/* While a delete runs the page is locked. */
.storage-busy {
  opacity: 0.45;
  pointer-events: none;
}

.storage-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.storage-section .storage-select-bar {
  align-items: center;
  justify-content: space-between;
  min-height: 0;
  margin: 0 0 10dp 0;
  padding: 8dp 12dp;
  cursor: default;
}

/* Phone: pinned to the bottom of the screen, the list ends above it. */
.storage-section .storage-select-bar--pinned {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  margin: 0;
  padding: 12dp 16dp 22dp 16dp;
  border-radius: 0;
  z-index: 10;
}

.storage-select-spacer {
  height: 72dp;
}

.storage-select-delete {
  flex-shrink: 0;
}

/* Phone top bars are 56dp (Kenneth 2026-11-07, round 3): the 40dp circles sit centred with 8dp clear above and below
   (the status-bar inset is already outside #shell-root), and the pages' scrollers start under the bar, not behind it.
   Compact only; the desktop's 44dp panes and constants are untouched. */
.shell-layer-compact .pane-nav,
.shell-layer-compact .pane-nav-bg,
.shell-layer-compact .pane-nav-title {
  height: 56dp;
}

.shell-layer-compact .pane-nav-title {
  line-height: 56dp;
}

.shell-layer-compact .pane-nav-actions {
  top: 2dp;
  right: 12dp;
  height: 52dp;
}

.shell-layer-compact .pane-nav-back,
.shell-layer-compact .settings-back-btn {
  top: 2dp;
}

.shell-layer-compact .sidebar-sessions,
.shell-layer-compact .contacts-list-view,
.shell-layer-compact .settings-list-view {
  padding-top: 56dp;
}

.shell-layer-compact .home-scroll {
  padding-top: 56dp;
}

.shell-layer-compact .settings-detail-header {
  height: 56dp;
}

.shell-layer-compact .settings-detail-body {
  padding-top: 64dp;
}

/* A settings page's one title is centred in its bar (phase 1 of the settings reorganisation); the bar is 56dp. */
.shell-layer-compact .settings-header-title {
  height: 56dp;
  line-height: 56dp;
}

/* Bold bar titles: LatoLatin (the app's default family) is loaded in one weight, so font-weight: bold changes nothing
   in it, and Chinese follows the weight of the face its primary family resolves to. Inter is loaded in four weights
   (Application.cpp), so with it the bold reaches Latin (Inter Bold) and Chinese (Noto Sans SC Bold) alike. */
.shell-layer-compact .settings-header-title,
.shell-layer-compact .settings-panel .pane-nav-title {
  font-family: Inter;
  font-weight: bold;
}

.shell-layer-compact .contacts-index {
  top: 56dp;
}

.shell-layer-compact .nav-bar-host.nav-bar-hidden .settings-detail-header,
.shell-layer-transient.nav-bar-host.nav-bar-hidden .shell-transient-chrome {
  transform: translateY(-72dp);
}

.shell-layer-compact .shell-transient-chrome,
.shell-layer-compact .shell-transient-chrome--titled {
  min-height: 56dp;
  padding: 2dp 0 0 12dp;
}

.shell-layer-compact .shell-transient-chrome--titled {
  height: 56dp;
}

.shell-layer-transient.shell-layer-compact .contact-detail-panel,
.shell-layer-transient.shell-layer-compact .blocked-page {
  padding-top: 56dp;
}

.shell-layer-compact .nc-page .nc-bar {
  height: 56dp;
}

.shell-layer-compact .nc-page .nc-bar-title {
  top: 0;
}

/* New chat and Add contact scroll under their bar like the other pushed pages (DEV TODO #176 / #177): the list fills the
   page and starts 56dp down; the shell's transient chrome is the bar (titled: its material child is frosted once
   content is under it, ShellNavBarScroll sets .nav-bar-scrolled / .nav-bar-hidden), and the title row slides away with
   it when the list is scrolled up. */
.shell-layer-compact .nc-page .nc-scroll,
.shell-layer-compact .ac-page .ac-scroll {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding-top: 56dp;
  box-sizing: border-box;
}

.shell-layer-compact .nav-bar-host .nc-bar {
  transition: transform 0.25s cubic-out;
}

.shell-layer-transient.nav-bar-host.nav-bar-hidden .nc-bar {
  transform: translateY(-64dp);
}

.shell-layer-compact .nc-page .contacts-index {
  top: 56dp;
}

/* New chat page (mockup 24-minimal-final.html screen 4, Kenneth 2026-11-07): the settings' grouped look. Two cards side
   by side (new group, add contact), then the contacts as white rounded cards under small grey letter headers; 16dp
   side margins; the A-Z strip stays on the right edge. Colours: colors.rcss.tmpl. */
.shell-layer-compact .nc-page .nc-search {
  margin: 0 16dp 12dp 16dp;
}

/* New chat's and Add contact's bar only shows the title: it sits over the shell's round back (the transient chrome,
   z-index 2, under this pane-nav's 3), so it lets taps through to it (2026-11-07: the back did nothing). */
.shell-layer-compact .nc-bar {
  pointer-events: none;
}

.shell-layer-compact .nc-page .nc-actions {
  display: flex;
  flex-direction: row;
  gap: 12dp;
  padding: 0 16dp 8dp 16dp;
}

.shell-layer-compact .nc-page .nc-action {
  flex: 1 1 0;
  min-width: 0;
  height: 56dp;
  min-height: 56dp;
  padding: 0 12dp;
  gap: 10dp;
  border-radius: 14dp;
}

.shell-layer-compact .nc-page .nc-action-icon {
  width: 36dp;
  height: 36dp;
  border-radius: 10dp;
}

.shell-layer-compact .nc-page .nc-action-label {
  font-size: 16dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-layer-compact .nc-page .nc-section-header {
  height: 24dp;
  padding: 0 32dp;
  margin-top: 8dp;
  font-size: 13dp;
  line-height: 24dp;
}

.shell-layer-compact .nc-page .nc-group {
  margin: 0 16dp;
  border-radius: 14dp;
  overflow: hidden;
}

.shell-layer-compact .nc-page .contacts-row {
  height: 56dp;
  min-height: 56dp;
  padding: 0 0 0 12dp;
}

.shell-layer-compact .nc-page .contacts-row-avatar-frame {
  width: 40dp;
  height: 40dp;
  border-radius: 20dp;
}

.shell-layer-compact .nc-page .contacts-row-avatar-image {
  width: 40dp;
  height: 40dp;
}

.shell-layer-compact .nc-page .contacts-row-title {
  font-size: 17dp;
  line-height: 55dp;
}

/* The Home root's bar is clear at rest: nothing of the fade or the frost shows as a line round the menu circle. */
.shell-layer-compact .shell-nav-page--home .pane-nav .bar-fade {
  display: none;
}

.shell-layer-compact .shell-nav-page--home .pane-nav-bg {
  border: 0;
  box-shadow: none;
}

/* Phone tab bar (round 7): the chosen word sits on a 72 x 32dp rounded light pill; the other word is plain grey. */
.shell-nav-rail--text .shell-nav-tab-text-wrap {
  width: 72dp;
  height: 32dp;
  border-radius: 16dp;
}

/* Floating plus menu (ContextMenuHost::ShowActionsPopoverLeftAligned): a 150dp card under the button, left edges
   aligned; 48dp rows of a 28dp round icon tile and a 16dp label, no separators. Its look (grey card, gradient, shadow)
   is in colors.rcss.tmpl. */
.context-menu-layer--popover-left .context-menu-panel {
  width: 150dp;
  min-width: 150dp;
  max-width: 150dp;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  overflow: hidden;
}

.context-menu-layer--popover-left .context-menu-item {
  flex-direction: row;
  align-items: center;
  gap: 10dp;
  height: 48dp;
  min-height: 48dp;
  padding: 0 12dp;
  border: 0;
  border-radius: 0;
}

.context-menu-layer--popover-left .context-menu-item-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28dp;
  height: 28dp;
  border-radius: 14dp;
}

.context-menu-layer--popover-left .context-menu-item-icon svg {
  width: 16dp;
  height: 16dp;
}

.context-menu-layer--popover-left .context-menu-item-label {
  font-size: 16dp;
  white-space: nowrap;
}

/* Add contact is a full-screen page on phones, the same bar as New chat. */
.shell-layer-compact .ac-page {
  position: relative;
}

.shell-layer-compact .ac-page .nc-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 56dp;
}

.shell-layer-compact .ac-page .nc-bar-title {
  top: 0;
  opacity: 1;
}

/* Avatar crop page (PLAN-avatar-edit item 9): a dark page, the title on top, the photo under a round viewport
   between the bars (the custom element draws the picture, the dim and the circle line), Cancel / Rotate / Done below.
   Phones show it in the shell's full-screen layer (the black reaches every screen edge, the bars stay inside the safe
   areas); the desktop panel is a 420dp-wide card with a tall enough stage. Colours (always dark, like the scanner):
   colors.rcss.tmpl. */
.avatar-crop {
  display: flex;
  flex-direction: column;
  width: 420dp;
  max-width: 100%;
  height: 100%;
  min-height: 0;
}

.shell-layer-compact .avatar-crop {
  width: 100%;
}

.avatar-crop-bg {
  display: none;
}

.shell-layer-compact .avatar-crop-bg {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.avatar-crop-bar,
.avatar-crop-stage,
.avatar-crop-actions {
  /* Positioned and above the phone's absolute black layer behind them: an in-flow block paints under a positioned
     sibling (and the sibling takes its taps), which hid the whole bottom row on the phone. */
  position: relative;
  z-index: 1;
}

.avatar-crop-bar {
  flex-shrink: 0;
  height: 52dp;
}

/* Phones: a round close at the top left, the way out that does not depend on the bottom row. */
.avatar-crop-close {
  display: none;
}

.shell-layer-compact .avatar-crop-close {
  display: flex;
  position: absolute;
  top: 0;
  left: 12dp;
  z-index: 2;
  align-items: center;
  justify-content: center;
  width: 52dp;
  height: 52dp;
  margin: 0;
  padding: 0;
  border: 0;
  cursor: pointer;
}

.avatar-crop-title {
  margin: 0;
  height: 52dp;
  line-height: 52dp;
  text-align: center;
  font-size: 17dp;
  font-weight: bold;
}

.avatar-crop-stage {
  flex: 1;
  min-height: 360dp;
  overflow: hidden;
}

.shell-layer-compact .avatar-crop-stage {
  min-height: 0;
}

.avatar-crop-surface {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-crop-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  margin: 0;
  text-align: center;
  line-height: 360dp;
  font-size: 40dp;
}

.avatar-crop-actions {
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  padding: 8dp 8dp;
}

.avatar-crop-btn {
  flex: 1;
  min-height: 50dp;
  margin: 0 4dp;
  padding: 0;
  border-width: 0;
  text-align: center;
  font-size: 19dp;
}

.avatar-crop-btn--done {
  font-weight: bold;
}

/* Phones: two fingers turn and zoom, so there is no Rotate button; Cancel sits left and Done right. */
.shell-layer-compact .avatar-crop-btn--rotate {
  display: none;
}

.shell-layer-compact .avatar-crop-actions {
  justify-content: space-between;
  padding: 8dp 16dp;
}

.shell-layer-compact .avatar-crop-btn {
  flex: none;
  min-width: 96dp;
  margin: 0;
}

.avatar-crop-btn:disabled,
.avatar-crop-btn--disabled,
.avatar-crop-close--disabled {
  opacity: 0.4;
}

/* Pressed: the same dimming the disabled look uses, a little stronger, while a finger is down (the button comes back
   at full strength on release). A disabled button stays at the disabled look. */
.avatar-crop-btn:active,
.avatar-crop-close:active {
  opacity: 0.55;
}

.avatar-crop-btn--disabled:active,
.avatar-crop-close--disabled:active {
  opacity: 0.4;
}

/* "Uploading…" over the picture: out of the flow and above the stage's picture and dim (positioned, z-index), taps pass
   through to the buttons below. Colours: colors.rcss.tmpl. */
.avatar-crop-pill-host {
  position: absolute;
  z-index: 3;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.avatar-crop-pill {
  margin: 0;
  padding: 12dp 24dp;
  border-radius: 24dp;
  font-size: 16dp;
  white-space: nowrap;
}

/* The profile photo viewer (a full-screen layer, like the scanner): the stored square centred, as wide as the screen up
   to 512dp, the close button top left inside the safe area. Colours: colors.rcss.tmpl. */
.avatar-view {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.avatar-view-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.avatar-view-close {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  align-self: flex-start;
  width: 52dp;
  height: 52dp;
  margin: 0 0 0 12dp;
  padding: 0;
  border: 0;
  cursor: pointer;
}

.avatar-view-stage {
  position: relative;
  z-index: 1; /* above the absolute black behind it, which would otherwise cover the picture */
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-view-image {
  width: 100vw;
  max-width: 512dp;
  height: 100vw;
  max-height: 512dp;
}
