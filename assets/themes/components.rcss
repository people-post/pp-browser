.btn {
  font-family: LatoLatin;
  font-size: 14dp;
  min-height: 44dp;
  padding: 0 16dp;
  line-height: 44dp;
  border-radius: 999dp;
  border: 0;
  cursor: pointer;
  margin-bottom: 0;
  width: auto;
  display: inline-block;
  box-sizing: border-box;
  text-align: center;
}

/* Low-emphasis text action (PIN “Not now”, optional dismissals). */
.btn-ghost {
  background-color: transparent;
}

/* Icon + label modifier — layout only; size/color come from .btn + .btn-*. */
.btn-icon {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6dp;
}

.btn-icon svg {
  flex-shrink: 0;
}

.field {
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  width: 100%;
  margin-bottom: 8dp;
  box-sizing: border-box;
  display: block;
}

/* RmlUi <select> internals: selectvalue, selectarrow, selectbox (see WidgetDropDown). */
select:focus {
  position: relative;
  z-index: 10;
}

select selectbox {
  border-radius: 6dp;
  padding: 4dp 0;
  box-sizing: border-box;
}

select selectbox option {
  padding: 8dp 12dp;
}

.card {
  padding: 16dp;
  border-radius: 8dp;
  margin-bottom: 12dp;
}

/* Floating Chrome — compact shell materials; theme colors in colors-*.rcss.
   Default: opaque elevated surfaces. At most one bar uses backdrop frost per frame
   (see ShellInterruption::ResolveFrostSurface). */
.surface-chrome {
  backdrop-filter: none;
}

.surface-chrome--frost {
  backdrop-filter: blur(20px);
}

.shell-bottom-chrome--frost {
  backdrop-filter: blur(20px);
}

.shell-bottom-chrome--solid {
  backdrop-filter: none;
}

.surface-chrome--solid,
.shell-bottom-chrome--frost.shell-bottom-chrome--solid,
.surface-chrome--solid.surface-chrome--frost,
.shell-chat-overlay-chrome.surface-chrome--solid,
.shell-transient-chrome.surface-chrome--solid,
.shell-sheet-compact-chrome.surface-chrome--solid,
.shell-composer-mount.surface-chrome--solid {
  backdrop-filter: none;
}

.chat-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
}

.chat-shell {
  position: absolute;
  top: 16dp;
  left: 16dp;
  right: 16dp;
  bottom: 16dp;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  max-width: 800dp;
  margin-left: auto;
  margin-right: auto;
}

.chat-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 8dp;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-bottom: 8dp;
  padding: 6dp 10dp;
  border-radius: 6dp;
}

.chat-header-secure-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  margin-bottom: 2dp;
}

.chat-header-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  min-width: 0;
}

.chat-header-type-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 16dp;
  height: 16dp;
}

.chat-header-type-icon svg {
  flex-shrink: 0;
}

.chat-header-main {
  flex: 1;
  min-width: 0;
}

/* Search inside the chat: one row in the title row's place — box, count, older / newer, Cancel. On a narrow
   screen the box gives way first (down to its minimum), then the count is cut with an ellipsis. */
.chat-search-bar {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
}

.chat-search-input {
  flex: 1 1 0;
  min-width: 72dp;
  width: auto;
  margin-bottom: 0;
}

.chat-search-count {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* A thin chevron, no background of its own. */
.chat-search-step {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28dp;
  height: 28dp;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
}

.chat-search-step:disabled {
  opacity: 0.35;
  cursor: auto;
}

.chat-search-cancel {
  flex-shrink: 0;
  padding: 6dp 8dp;
  border: 0;
  border-radius: 16dp;
  font-size: 14dp;
  white-space: nowrap;
  background-color: transparent;
  cursor: pointer;
}

/* A search match in a message (colours in colors-*.rcss); like the mention chip, it stays inline. */
.search-mark {
  padding: 0 1dp;
  border-radius: 3dp;
}

.chat-header-meta-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 6dp;
  margin-top: 1dp;
  min-width: 0;
}

.chat-peer-path {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4dp;
  flex-shrink: 0;
}

.chat-peer-path-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 12dp;
  height: 12dp;
}

.chat-peer-path-icon svg {
  flex-shrink: 0;
}

.chat-peer-link {
  margin: 0;
  opacity: 0.85;
}

.chat-gap-banner {
  flex-shrink: 0;
  margin-bottom: 8dp;
  padding: 8dp 12dp;
  border-radius: 8dp;
  gap: 8dp;
}

.chat-header-title {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 18dp;
  font-weight: normal;
}

.chat-header-subtitle {
  margin: 0;
  flex: 1;
  min-width: 0;
}

.chat-header-title-btn {
  decorator: none;
  border-width: 0;
  background-color: transparent;
  padding: 0;
  text-align: left;
  cursor: pointer;
}

.chat-header-actions {
  flex-shrink: 0;
  align-items: center;
  gap: 6dp;
}

.chat-header-call-btn,
.chat-header-more-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 18dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.chat-header-call-btn svg,
.chat-header-more-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

/* V053: a group call goes on in this chat — the call button joins it. */
.chat-header-call-btn--join {
  width: auto;
  padding: 0 14dp;
  gap: 6dp;
  font-weight: bold;
}

.messages {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  overflow-y: auto;
  overflow-x: hidden;
  margin-bottom: 12dp;
  padding-left: 8dp;
  padding-right: 8dp;
}

.chat-messages-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 0;
  /* Fill remaining chat-panel height; do not nest another flex column — that
     lets .messages grow with content and lose overflow scrolling. */
}

.chat-messages-wrap .messages {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  flex: none;
  margin-bottom: 0;
}

.chat-jump-latest {
  position: absolute;
  right: 16dp;
  bottom: 16dp;
  z-index: 5;
  width: auto;
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 8dp 14dp;
  border: 0;
  border-radius: 16dp;
  cursor: pointer;
  focus: none;
}

.message-group {
  display: block;
}

.message-row {
  display: block;
  margin-bottom: 12dp;
}

.message-row-user {
  text-align: right;
}

.message-row-assistant {
  text-align: left;
}

.bubble {
  /* Horizontal padding is mirrored by kBubbleHorizontalPaddingDp (src/gui/chat/AiImageAttach.h); change both. */
  padding: 10dp 14dp;
  border-radius: 12dp;
  text-align: left;
  box-sizing: border-box;
}

.bubble-user {
  display: inline-block;
  max-width: 680dp;
  focus: none;
}

/* An AI question waiting for another chat's answer (B112): dimmed until it is sent. */
.bubble-queued {
  opacity: 0.55;
  white-space: pre-wrap;
}

.queued-note {
  margin-top: 4dp;
  font-size: 12dp;
}

.queued-cancel {
  text-decoration: underline;
  cursor: pointer;
}

.bubble-text {
  margin-top: 0;
  margin-bottom: 0;
  white-space: pre-wrap;
  word-break: break-word;
}

/* The quoted message on top of a reply, and the question on top of an @ai answer (domain/messaging/QuoteReply.h). */
.chat-quote {
  display: block;
  margin-bottom: 6dp;
  padding: 4dp 8dp;
  border-left: 3dp #818cf8;
  border-radius: 6dp;
  background-color: rgba(128, 128, 128, 0.16);
}

/* Dimmed and at most two lines; the whole message is one tap away (jump_to_quote). */
.chat-quote-text {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  max-height: 36dp;
  overflow: hidden;
  word-break: break-word;
  font-size: 13dp;
  line-height: 18dp;
  opacity: 0.6;
}

.chat-quote--jump {
  cursor: pointer;
}

/* A peer's plain-text message: keeps its line breaks, like our own (.bubble-text also sets our colour). */
/* "This message was deleted": no bubble, a small grey note on the sender's side (InboxController). */
.bubble.bubble-deleted {
  background-color: transparent;
  border-width: 0;
  padding: 2dp 4dp;
}

/* No italic: only regular font faces are loaded, and RmlUi draws nothing for a face it does not have. */
.bubble-deleted-text {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 12dp;
}

.bubble-text-peer {
  margin-top: 0;
  margin-bottom: 0;
  white-space: pre-wrap;
  word-break: break-word;
}

.assistant-message {
  display: block;
}

.bubble-assistant {
  display: inline-block;
  max-width: 680dp;
  focus: none;
}

.suggestion-row {
  display: block;
  margin-top: 8dp;
}

.bubble-assistant ul,
.bubble-assistant ol {
  box-sizing: border-box;
  /* The engine's defaults (40dp left padding, 1em margins) pushed lists far from the bubble's edge. */
  margin-top: 4dp;
  margin-bottom: 4dp;
  padding-left: 0;
}

/* List items draw their own marker (MarkdownToRml): the number or bullet sits in the item's left padding,
   so wrapped lines align under the text. */
.bubble-assistant li {
  display: block;
  position: relative;
  padding-left: 26dp;
}

.bubble-assistant .md-marker {
  position: absolute;
  left: 0;
  top: 0;
  opacity: 0.7;
}

.bubble-assistant .md-item {
  display: block;
}

.bubble-assistant p,
.bubble-assistant li,
.bubble-assistant .code-block {
  word-break: break-word;
}

.bubble-assistant p:last-child,
.bubble-assistant .stack p:last-child {
  margin-bottom: 0;
}

/* B81: the engine gives <p> a top margin; the first paragraph must sit on the bubble padding, not a blank line below it. */
.bubble-assistant p:first-child,
.bubble-assistant .stack p:first-child {
  margin-top: 0;
}

.bubble-assistant h1,
.bubble-assistant h2,
.bubble-assistant h3 {
  margin-top: 0;
}

.bubble-assistant p,
.bubble-assistant li {
}

.thinking {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

/* The composer is a transparent holder: an optional status row, then one row of
   [mic/keyboard] [emoji] [pill: text | clip | camera] [send]. The pill carries the card look (colors-*.rcss). */
.prompt-composer {
  flex-shrink: 0;
  box-sizing: border-box;
  margin: 0 8dp 8dp 8dp;
  padding: 0;
}

.prompt-composer-status {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  margin: 0 4dp 6dp 4dp;
}

.prompt-composer-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 4dp;
}

/* Half of one line's height (40dp) for the radius; the buttons stay at the bottom while the text grows to 5 lines. */
.prompt-composer-pill {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  min-height: 40dp;
  padding: 0 4dp 0 14dp;
  border-radius: 20dp;
}

.prompt-composer-input {
  flex: 1;
  min-width: 0;
  width: auto;
  min-height: 24dp;
  margin: 0;
  padding: 8dp 0;
  border: 0;
  background-color: transparent;
  cursor: text;
}

/* Without a sized scrollbar, text past the visible rows scrolls away with no hint. */
.prompt-composer-input scrollbarvertical {
  width: 6dp;
}

.prompt-composer-input scrollbarvertical sliderbar {
  width: 6dp;
  min-height: 16dp;
  border-radius: 3dp;
}

.prompt-emoji-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  background-color: transparent;
  cursor: pointer;
}

.prompt-emoji-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

.prompt-voice-toggle-btn,
.prompt-attach-btn,
.prompt-capture-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  background-color: transparent;
  cursor: pointer;
}

.prompt-voice-toggle-btn svg,
.prompt-attach-btn svg,
.prompt-capture-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

/* The phone's microphone at the row's end (the phone rules below show it); hidden elsewhere. */
.prompt-voice-toggle-btn--end {
  display: none;
}

/* Reply / Ask AI in progress: the quoted message, one line, above the composer box. */
.prompt-quote {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8dp;
  margin: 0 12dp 6dp 12dp;
  padding: 6dp 10dp;
  border-left: 3dp #818cf8;
  border-radius: 6dp;
  background-color: rgba(128, 128, 128, 0.14);
}

.prompt-quote-text {
  flex: 1;
  min-width: 0;
  display: block;
  max-height: 36dp; /* two lines */
  overflow: hidden;
  word-break: break-word;
  font-size: 13dp;
  line-height: 18dp;
  opacity: 0.8;
}

.prompt-attachment-chip {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8dp;
  padding: 4dp 10dp;
  border-radius: 12dp;
  background-color: rgba(255, 255, 255, 0.08);
}

.prompt-attachment-chip-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  font-size: 12dp;
}

.prompt-attachment-chip-action {
  flex-shrink: 0;
  font-size: 11dp;
  padding: 2dp 8dp;
  border-radius: 8dp;
  background-color: rgba(255, 255, 255, 0.12);
}

.prompt-attachment-chip-status {
  flex-shrink: 0;
  font-size: 11dp;
  opacity: 0.72;
}

/* The AI picture in the composer: a small thumbnail with a remove badge overlapping its top-right corner
   (a dark disc with a white ring and a white cross: visible on any picture and on both themes). */
.prompt-image-thumb-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  padding-top: 8dp;
}

.prompt-image-thumb {
  display: block;
  height: 32dp;
  width: auto;
  max-width: 56dp;
  border-radius: 6dp;
}

.prompt-image-thumb-placeholder {
  width: 32dp;
  height: 32dp;
  border-radius: 6dp;
  background-color: rgba(128, 128, 128, 0.35);
}

.prompt-image-remove-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20dp;
  height: 20dp;
  margin-left: -10dp;
  margin-top: -8dp;
  border-width: 2dp;
  border-color: #ffffff;
  border-radius: 12dp; /* 20dp box + 2dp border each side: a round badge */
  background-color: #111827;
  cursor: pointer;
}

.prompt-image-remove-badge svg {
  flex-shrink: 0;
  width: 8dp;
  height: 8dp;
  image-color: #ffffff;
}

.prompt-attachment-chip-remove {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20dp;
  height: 20dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 10dp;
  background-color: transparent;
  cursor: pointer;
}

.prompt-attachment-chip-remove svg {
  flex-shrink: 0;
  width: 10dp;
  height: 10dp;
}

.prompt-send-btn,
.prompt-stop-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 16dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.prompt-send-btn svg,
.prompt-stop-btn svg {
  flex-shrink: 0;
  width: 14dp;
  height: 14dp;
}

/* A 32dp button beside the 40dp one-line pill: 4dp under it centres it on the first line, and it stays there while
   the text grows. */
.prompt-composer-row .prompt-voice-toggle-btn,
.prompt-composer-row .prompt-emoji-btn,
.prompt-composer-row .prompt-send-btn,
.prompt-composer-pill .prompt-attach-btn,
.prompt-composer-pill .prompt-capture-btn {
  margin-bottom: 4dp;
}

/* Voice mode: the "hold to talk" bar takes the text input's place; grey while a call has the microphone, red while recording. */
.prompt-voice-bar {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40dp;
  margin: 0;
  padding: 0 14dp;
  border: 0;
  border-radius: 20dp;
  font-family: LatoLatin;
  font-size: 15dp;
  cursor: pointer;
}

.prompt-voice-bar--blocked {
  opacity: 0.5;
}

.prompt-voice-cancel-btn {
  flex-shrink: 0;
  margin-right: 4dp;
  margin-bottom: 4dp;
  padding: 6dp 12dp;
  border: 0;
  border-radius: 16dp;
  font-size: 13dp;
  background-color: rgba(128, 128, 128, 0.2);
  cursor: pointer;
}

/* Inside the voice bar while recording (red bar): everything reads white on it. */
.prompt-voice-status {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8dp;
  padding: 0 6dp;
}

.prompt-voice-bar .prompt-voice-dot {
  background-color: #ffffff;
}

.prompt-voice-bar .prompt-voice-timer--countdown,
.prompt-voice-bar .prompt-voice-hint--cancel {
  color: #ffffff;
}

.prompt-voice-dot {
  flex-shrink: 0;
  width: 10dp;
  height: 10dp;
  border-radius: 5dp;
  background-color: #ef4444;
}

.prompt-voice-timer {
  flex-shrink: 0;
  font-size: 14dp;
}

.prompt-voice-timer--countdown {
  color: #ef4444;
}

.prompt-voice-hint {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  font-size: 12dp;
  opacity: 0.72;
}

.prompt-voice-hint--cancel {
  color: #ef4444;
  opacity: 1;
}

.chat-link {
  text-decoration: underline;
  cursor: pointer;
}

/* A mention / @everyone in a group message (group-chat G015): a tinted chip, bold; a member's opens them. */
.chat-mention {
  font-weight: bold;
  cursor: pointer;
  padding: 0 3dp;
  border-radius: 4dp;
}

.chat-mention--everyone {
  cursor: auto;
}

.inline-code {
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 1dp 4dp;
  border-radius: 4dp;
}

.bubble-assistant strong {
  font-weight: bold;
}

.code-block {
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  margin-top: 4dp;
  margin-bottom: 8dp;
  white-space: pre-wrap;
}

/* A link-style action at the end of a list item's text (article feed "view details").
   The text is 12dp; the vertical padding makes the tap target 44dp without changing the line (inline
   padding does not add line height). focus: none keeps the draft textarea focused, like chat buttons. */
.chat-inline-link {
  display: inline;
  width: auto;
  height: auto;
  min-height: 0;
  margin: 0 0 0 4dp;
  padding: 16dp 8dp;
  border: 0;
  background-color: transparent;
  font-family: LatoLatin;
  font-size: 12dp;
  cursor: pointer;
  focus: none;
}

.chat-suggestion {
  display: inline-block;
  width: auto;
  font-family: LatoLatin;
  font-size: 13dp;
  height: 44dp;
  min-height: 44dp;
  padding: 0 16dp;
  line-height: 44dp;
  margin-right: 8dp;
  margin-bottom: 4dp;
  border: 0;
  border-radius: 999dp;
  cursor: pointer;
  box-sizing: border-box;
  text-align: center;
  focus: none;
}

.suggestion-row .chat-suggestion {
  margin-top: 0;
}

.bubble-assistant .chat-suggestion {
  margin-top: 8dp;
}

.chat-form {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.chat-form-label {
  display: block;
  margin-bottom: 8dp;
}

.chat-form-field {
  display: block;
  width: 100%;
  margin-top: 4dp;
  margin-bottom: 0;
  box-sizing: border-box;
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
}

.chat-form-submit {
  display: inline-block;
  width: auto;
  margin-top: 8dp;
  padding: 8dp 16dp;
  border-radius: 8dp;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.chat-form-expired {
  opacity: 0.85;
}

.chat-form-expired .chat-form-field,
.chat-form-expired .chat-form-submit {
  pointer-events: none;
  opacity: 0.6;
}

.chat-form-expired .chat-form-submit {
  display: none;
}

.chat-form-expired-label {
  margin-top: 0;
  margin-bottom: 8dp;
}

.chat-card {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.chat-table {
  width: 100%;
  margin-top: 12dp;
}

.chat-table th,
.chat-table td {
  padding: 6dp 8dp;
  text-align: left;
}

.chat-key-value {
  display: block;
  margin-top: 12dp;
}

.chat-key-value-row {
  display: flex;
  justify-content: space-between;
  gap: 12dp;
  padding: 4dp 0;
}

.chat-callout {
  display: block;
  margin-top: 12dp;
  padding: 10dp 12dp;
  border-radius: 8dp;
}

.chat-quote {
  display: block;
  margin-top: 12dp;
  padding-left: 12dp;
}

.chat-action-list,
.chat-long-list,
.chat-choice,
.chat-poll {
  display: block;
  margin-top: 12dp;
}

.chat-long-list-scroll {
  max-height: 240dp;
  overflow-y: auto;
  padding: 8dp;
  margin-top: 8dp;
  border-radius: 6dp;
  box-sizing: border-box;
}

.chat-long-list-item {
  display: block;
  margin-bottom: 12dp;
  padding-bottom: 10dp;
}

.chat-long-list-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
}

.chat-long-list-item-row {
  align-items: flex-start;
  gap: 10dp;
}

.chat-long-list-avatar {
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-long-list-avatar .avatar-letter {
  font-size: 14dp;
  color: #ffffff;
}

.chat-long-list-item-body {
  display: block;
  flex-grow: 1;
  min-width: 0;
}

.chat-long-list-title {
  margin-bottom: 4dp;
}

.chat-long-list-subtitle,
.chat-long-list-meta {
  margin-bottom: 4dp;
  font-size: 13dp;
}

/* Meta row: host (one line, cut with an ellipsis when the row is narrow) · time (never cut), and the
   item's text link pinned to the right so it never moves with the text above. */
.chat-long-list-meta-row {
  align-items: baseline;
  margin-bottom: 4dp;
}

.chat-long-list-meta-row .chat-long-list-meta {
  flex: 1 1 auto;
  min-width: 0;
  margin-bottom: 0;
  font-size: 12dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-long-list-meta-row .chat-long-list-meta-end {
  flex: 0 0 auto;
  margin-bottom: 0;
  font-size: 12dp;
  white-space: nowrap;
}

.chat-long-list-meta-row .chat-inline-link {
  flex: 0 0 auto;
  margin-left: auto;
  white-space: nowrap;
}

.chat-long-list-actions,
.chat-long-list-footer {
  gap: 8dp;
  flex-wrap: wrap;
  margin-top: 6dp;
}

.chat-suggestion-secondary {
  opacity: 0.92;
}

.chat-action-list-item {
  display: block;
  margin-bottom: 10dp;
}

.chat-action-list-actions,
.chat-choice-options,
.chat-poll-options {
  gap: 8dp;
  flex-wrap: wrap;
}

.chat-calendar {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.calendar-header {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8dp;
}

.calendar-nav {
  display: inline-block;
  padding: 6dp 12dp;
  border: 0;
  border-radius: 6dp;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.calendar-weekdays {
  justify-content: space-between;
  margin-bottom: 4dp;
}

.calendar-weekdays span {
  width: 14%;
  text-align: center;
}

.calendar-grid {
  width: 100%;
}

.calendar-cell {
  width: 14%;
  text-align: center;
  padding: 2dp;
  vertical-align: middle;
}

.calendar-day {
  display: inline-block;
  width: 100%;
  min-height: 28dp;
  padding: 4dp 0;
  border-radius: 6dp;
  border: 0;
  text-align: center;
  box-sizing: border-box;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.calendar-day-muted {
  display: inline-block;
  width: 100%;
  min-height: 28dp;
  padding: 4dp 0;
  border-radius: 6dp;
  text-align: center;
  box-sizing: border-box;
  background-color: transparent;
  cursor: default;
}

.shell-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  /* Corner rounding is macOS-native (CALayer), not RCSS — see WINDOW_SHELL.md. */
}

/* Desktop borderless window: draw a 1dp frame so the OS chrome is not missed.
   Hidden while maximized (edge-to-edge). */
.shell-body--framed {
  border-width: 1dp;
}

.shell-titlebar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 120;
  height: 36dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  border-bottom-width: 1dp;
}

.shell-titlebar-drag {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-left: 12dp;
  padding-right: 8dp;
  box-sizing: border-box;
}

.shell-titlebar-title {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  font-family: LatoLatin;
  font-size: 13dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
}

.shell-titlebar-controls {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  height: 100%;
}

.shell-titlebar-controls--traffic {
  align-items: center;
  padding-left: 8dp;
  padding-right: 8dp;
  gap: 8dp;
  box-sizing: border-box;
}

.shell-titlebar-btn {
  width: 40dp;
  min-width: 40dp;
  height: 100%;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.shell-titlebar-btn svg {
  flex-shrink: 0;
  width: 12dp;
  height: 12dp;
}

.shell-titlebar-btn--traffic {
  width: 12dp;
  min-width: 12dp;
  height: 12dp;
  min-height: 12dp;
  border-radius: 0;
  padding: 0;
}

.shell-titlebar-traffic-dot {
  width: 12dp;
  height: 12dp;
  min-width: 12dp;
  min-height: 12dp;
  border-radius: 6dp;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.shell-titlebar-btn--traffic svg {
  width: 6dp;
  height: 6dp;
  opacity: 0;
}

.shell-titlebar-btn--traffic:hover svg {
  opacity: 1;
}

.shell-chrome {
  position: relative;
  z-index: 100;
  /* Banner/toasts sit above content; the chrome box itself must not steal taps. */
  pointer-events: none;
}

.shell-chrome .shell-banner,
.shell-chrome .shell-toast,
.shell-chrome .shell-banner-dismiss {
  pointer-events: auto;
}

.shell-root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

/* Phones: the band under the status bar (ShellHost sets its height to the top inset), over the chat page (25) and the
   pushed pages (30), under the AI dot (40) and everything above it: a top bar that hides on scroll slides under it. */
.shell-statusbar-strip {
  display: none;
}

.shell-body--compact .shell-statusbar-strip {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 0;
  z-index: 35;
  pointer-events: none;
}

/* Sibling of #shell-root — holds the mobile/compact emoji keyboard panel. */
.shell-emoji-keyboard-mount {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  pointer-events: none;
}

/* Phone AI dot (DESIGN-pp-ui §8.14; ShellAiDot places it with left / top). Sibling of #shell-root so a shell
   remount keeps it. The mount lets every tap through; the dot takes its own. z-index 40: over the pages (chat page 25,
   pushed page 30), under the call bar (45), the startup cover (48), sheets, panels and dialogs (50), menus (52), the
   call ring (53), the PIN gate (55) and the toasts (110, in #shell-chrome). It also hides itself for most of those. */
.shell-ai-dot-mount {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  pointer-events: none;
}

/* Me → AI assistant → Assistant size (AiDotModel::SizeDp): small 52dp, medium 64dp (default), large 76dp. The box is
   also what takes the touch, so the hit area follows the size. */
.ai-dot {
  display: none;
  position: absolute;
  left: 0dp;
  top: 0dp;
  width: 64dp;
  height: 64dp;
  pointer-events: auto;
}

.ai-dot--size-s {
  width: 52dp;
  height: 52dp;
}

.ai-dot--size-l {
  width: 76dp;
  height: 76dp;
}

.ai-dot--shown {
  display: block;
}

/* The figure is the 900-unit mascot box; it sways and leans from near its feet. Its two parts (the back and the front
   bubble, each with its own eyes and symbols) and the particles are drawn in one square viewBox with room round the
   mascot for the shadow (64 of its 900 units on each side), so they are 1028/900 of the dot wide, 64/900 of it out, at
   every size. The shadow is in the SVGs (rasterized once), not an RCSS filter: a filter renders an extra layer every
   frame the dot is drawn. */
.ai-dot-figure {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform-origin: 50% 85%;
}

.ai-dot-layer,
.ai-dot-part {
  position: absolute;
  top: -7.1111%;
  left: -7.1111%;
  width: 114.2222%;
  height: 114.2222%;
}

.ai-dot-part .ai-dot-layer {
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* Each part turns about the bottom middle of its bubble (the mockup's transform-origin 50% 100%, fill-box): the front
   bubble's at 443, 790 and the back one's at 615, 530 of the 16 -24 1028 1028 viewBox. Percent translations below are of
   the moved box, so in a part or layer 1 mockup unit is 0.0973%, in the figure 0.1111%. */
.ai-dot-front {
  transform-origin: 41.6% 79.2%;
}

.ai-dot-back {
  transform-origin: 58.3% 53.9%;
}

/* Each pair of eyes blinks, grows and moves about its own middle (front 443, 540; back 699, 296). */
.ai-dot-eyes-front {
  transform-origin: 41.5% 54.9%;
}

.ai-dot-eyes-back {
  transform-origin: 66.4% 31.1%;
}

/* Happy and shut eyes stand in for the open ones while an action asks for them (a class, no animation). */
.ai-dot-hap,
.ai-dot-shut {
  display: none;
}

/* The cheeks, mouth, the plain look's symbols and the particles show only during their action. Under its class each
   rests at opacity 0: RmlUi drops an RCSS animation's value when it ends, so the layer then falls back to invisible,
   not to a still picture, for the short while before AiDotModel takes the class off. */
.ai-dot-blush,
.ai-dot-mouth,
.ai-dot-eq,
.ai-dot-line,
.ai-dot-bar,
.ai-dot-ddot,
.ai-dot-check,
.ai-dot-dlock,
.ai-dot-arc,
.ai-dot-bubble,
.ai-dot-tdot,
.ai-dot-star,
.ai-dot-spark,
.ai-dot-heart,
.ai-dot-z,
.ai-dot-lock {
  display: none;
}

/* Where the particles grow from: B's mouth (443, 630; A's and C's within a few units), C's bars (420 / 443 / 466, 617),
   D's lines from their left end (x 340), its bars (375 + 34n, 540), its check from its left end (382, 541), its lock
   (443, 558); the star (650, 410), the sparkle (671, 355), the hearts (300, 322 and 820, 175), the lock badge (610, 700). */
.ai-dot-mouth {
  transform-origin: 41.5% 63.6%;
}

.ai-dot-eq-1 {
  transform-origin: 39.3% 62.4%;
}

.ai-dot-eq-2 {
  transform-origin: 41.5% 62.4%;
}

.ai-dot-eq-3 {
  transform-origin: 43.8% 62.4%;
}

.ai-dot-line {
  transform-origin: 31.5% 54.9%;
}

.ai-dot-bar-1 {
  transform-origin: 34.9% 54.9%;
}

.ai-dot-bar-2 {
  transform-origin: 38.2% 54.9%;
}

.ai-dot-bar-3 {
  transform-origin: 41.5% 54.9%;
}

.ai-dot-bar-4 {
  transform-origin: 44.8% 54.9%;
}

.ai-dot-bar-5 {
  transform-origin: 48.2% 54.9%;
}

.ai-dot-check {
  transform-origin: 35.6% 55%;
}

.ai-dot-dlock {
  transform-origin: 41.5% 56.6%;
}

.ai-dot-star {
  transform-origin: 61.7% 42.2%;
}

.ai-dot-spark {
  transform-origin: 63.7% 36.9%;
}

.ai-dot-heart-1 {
  transform-origin: 27.6% 33.7%;
}

.ai-dot-heart-2 {
  transform-origin: 78.2% 19.4%;
}

.ai-dot-lock {
  transform-origin: 57.8% 70.4%;
}

/* Actions (AiDotModel::IdleLengthMs; the mockups' motions, DEV/ui-mockups/mascot-v1.html, mascot-v2.html,
   mascot-compare.html): one run each, started and ended by a class; between them nothing animates, so the app draws
   nothing for the dot. The mockup loops each state; here an action plays its loop once or twice, and particles that
   loop out of step there (arcs, dots, bars, z's, hearts) start later or have their phase baked in, so each one starts
   and ends invisible within the action. C and D (calm) use the mockup's smaller, slower variants. Every keyframe list
   starts and ends at rest. */

/* Sway: rocks side to side. */
@keyframes ai-dot-sway {
  0% { transform: rotate(0deg); }
  20% { transform: rotate(-9deg); }
  45% { transform: rotate(7deg); }
  70% { transform: rotate(-4deg); }
  100% { transform: rotate(0deg); }
}

@keyframes ai-dot-sway-calm {
  0% { transform: rotate(0deg); }
  25% { transform: rotate(-3deg); }
  60% { transform: rotate(2deg); }
  100% { transform: rotate(0deg); }
}

.ai-dot--sway .ai-dot-figure {
  animation: 1.2s sine-in-out ai-dot-sway;
}

.ai-dot--calm.ai-dot--sway .ai-dot-figure {
  animation: 1.2s sine-in-out ai-dot-sway-calm;
}

/* Float: the mockup's float (translateY 0, -10, 0 units; calm floatC -5), once for 2.5 s instead of a loop, and back
   at rest (AiDotModel::kFloatMs). */
/* Two soft bobs, ~4.5dp at the medium size: the mockup's 1% drift was invisible on a phone. */
@keyframes ai-dot-float {
  0% { transform: translateY(0%); }
  25% { transform: translateY(-7%); }
  50% { transform: translateY(-1%); }
  75% { transform: translateY(-5%); }
  100% { transform: translateY(0%); }
}

@keyframes ai-dot-float-calm {
  0% { transform: translateY(0%); }
  25% { transform: translateY(-4%); }
  50% { transform: translateY(-0.5%); }
  75% { transform: translateY(-3%); }
  100% { transform: translateY(0%); }
}

.ai-dot--float .ai-dot-figure {
  animation: 2.5s sine-in-out ai-dot-float;
}

.ai-dot--calm.ai-dot--float .ai-dot-figure {
  animation: 2.5s sine-in-out ai-dot-float-calm;
}

/* Blink. */
@keyframes ai-dot-blink {
  0% { transform: scaleY(1); }
  35% { transform: scaleY(0.1); }
  70% { transform: scaleY(1); }
  100% { transform: scaleY(1); }
}

.ai-dot--blink .ai-dot-eyes-front,
.ai-dot--blink .ai-dot-eyes-back {
  animation: 0.5s quadratic-in-out ai-dot-blink;
}

/* Look: the mockup's idle glance, the two look at each other (front eyes 18, -12; back eyes -10, 8) for a moment. */
@keyframes ai-dot-look-front {
  0% { transform: translate(0%, 0%); }
  17% { transform: translate(1.75%, -1.17%); }
  82% { transform: translate(1.75%, -1.17%); }
  100% { transform: translate(0%, 0%); }
}

@keyframes ai-dot-look-back {
  0% { transform: translate(0%, 0%); }
  17% { transform: translate(-0.97%, 0.78%); }
  82% { transform: translate(-0.97%, 0.78%); }
  100% { transform: translate(0%, 0%); }
}

.ai-dot--look .ai-dot-eyes-front {
  animation: 2s sine-in-out ai-dot-look-front;
}

.ai-dot--look .ai-dot-eyes-back {
  animation: 2s sine-in-out ai-dot-look-back;
}

/* Nod: the partner's (talk, listen) and both bubbles' while listening; 3deg and 4 units up. */
@keyframes ai-dot-nod {
  0% { transform: translateY(0%) rotate(0deg); }
  50% { transform: translateY(-0.39%) rotate(3deg); }
  100% { transform: translateY(0%) rotate(0deg); }
}

/* Talk: the mouth opens and shuts four times (the mockup's 0.42 s beats), the front eyes glance up, the partner nods.
   C talks with three equalizer bars, D writes three text lines one after another. */
@keyframes ai-dot-talk-mouth {
  0% { opacity: 0; transform: scale(0.9, 0.25); }
  8% { opacity: 1; transform: scale(0.92, 0.4); }
  25% { opacity: 1; transform: scale(1, 1); }
  50% { opacity: 1; transform: scale(0.9, 0.25); }
  75% { opacity: 1; transform: scale(1, 1); }
  92% { opacity: 1; transform: scale(0.92, 0.4); }
  100% { opacity: 0; transform: scale(0.9, 0.25); }
}

@keyframes ai-dot-talk-eyes {
  0% { transform: translateY(0%); }
  15% { transform: translateY(-1.17%); }
  85% { transform: translateY(-1.17%); }
  100% { transform: translateY(0%); }
}

@keyframes ai-dot-line {
  0% { opacity: 1; transform: scaleX(0); }
  35% { opacity: 1; transform: scaleX(1); }
  85% { opacity: 1; transform: scaleX(1); }
  100% { opacity: 0; transform: scaleX(1); }
}

/* C's bars, D's bars and the typing dots move out of step: their phases are baked in, sampled over the action (the
   mockup's eqC and dot loops with their delays), each starting and ending invisible. */
@keyframes ai-dot-eq-1 {
  0% { opacity: 0.00; transform: scaleY(0.30); }
  6.25% { opacity: 1.00; transform: scaleY(0.37); }
  12.5% { opacity: 1.00; transform: scaleY(0.56); }
  18.75% { opacity: 1.00; transform: scaleY(0.79); }
  25% { opacity: 1.00; transform: scaleY(0.96); }
  31.25% { opacity: 1.00; transform: scaleY(1.00); }
  37.5% { opacity: 1.00; transform: scaleY(0.89); }
  43.75% { opacity: 1.00; transform: scaleY(0.68); }
  50% { opacity: 1.00; transform: scaleY(0.46); }
  56.25% { opacity: 1.00; transform: scaleY(0.32); }
  62.5% { opacity: 1.00; transform: scaleY(0.32); }
  68.75% { opacity: 1.00; transform: scaleY(0.45); }
  75% { opacity: 1.00; transform: scaleY(0.67); }
  81.25% { opacity: 1.00; transform: scaleY(0.88); }
  87.5% { opacity: 1.00; transform: scaleY(0.99); }
  93.75% { opacity: 1.00; transform: scaleY(0.96); }
  100% { opacity: 0.00; transform: scaleY(0.80); }
}
@keyframes ai-dot-eq-2 {
  0% { opacity: 0.00; transform: scaleY(0.48); }
  6.25% { opacity: 1.00; transform: scaleY(0.33); }
  12.5% { opacity: 1.00; transform: scaleY(0.31); }
  18.75% { opacity: 1.00; transform: scaleY(0.44); }
  25% { opacity: 1.00; transform: scaleY(0.65); }
  31.25% { opacity: 1.00; transform: scaleY(0.86); }
  37.5% { opacity: 1.00; transform: scaleY(0.99); }
  43.75% { opacity: 1.00; transform: scaleY(0.97); }
  50% { opacity: 1.00; transform: scaleY(0.82); }
  56.25% { opacity: 1.00; transform: scaleY(0.60); }
  62.5% { opacity: 1.00; transform: scaleY(0.39); }
  68.75% { opacity: 1.00; transform: scaleY(0.30); }
  75% { opacity: 1.00; transform: scaleY(0.35); }
  81.25% { opacity: 1.00; transform: scaleY(0.53); }
  87.5% { opacity: 1.00; transform: scaleY(0.76); }
  93.75% { opacity: 1.00; transform: scaleY(0.94); }
  100% { opacity: 0.00; transform: scaleY(1.00); }
}
@keyframes ai-dot-eq-3 {
  0% { opacity: 0.00; transform: scaleY(0.84); }
  6.25% { opacity: 1.00; transform: scaleY(0.62); }
  12.5% { opacity: 1.00; transform: scaleY(0.41); }
  18.75% { opacity: 1.00; transform: scaleY(0.30); }
  25% { opacity: 1.00; transform: scaleY(0.34); }
  31.25% { opacity: 1.00; transform: scaleY(0.51); }
  37.5% { opacity: 1.00; transform: scaleY(0.74); }
  43.75% { opacity: 1.00; transform: scaleY(0.93); }
  50% { opacity: 1.00; transform: scaleY(1.00); }
  56.25% { opacity: 1.00; transform: scaleY(0.93); }
  62.5% { opacity: 1.00; transform: scaleY(0.74); }
  68.75% { opacity: 1.00; transform: scaleY(0.51); }
  75% { opacity: 1.00; transform: scaleY(0.34); }
  81.25% { opacity: 1.00; transform: scaleY(0.30); }
  87.5% { opacity: 1.00; transform: scaleY(0.41); }
  93.75% { opacity: 1.00; transform: scaleY(0.62); }
  100% { opacity: 0.00; transform: scaleY(0.84); }
}
