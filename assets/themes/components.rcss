.btn {
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  border: 0;
  cursor: pointer;
  margin-bottom: 0;
  width: auto;
  display: inline-block;
}

.field {
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  width: 100%;
  margin-bottom: 8dp;
  box-sizing: border-box;
  display: block;
}

/* RmlUi <select> internals: selectvalue, selectarrow, selectbox (see WidgetDropDown). */
select:focus {
  position: relative;
  z-index: 10;
}

select selectbox {
  border-radius: 6dp;
  padding: 4dp 0;
  box-sizing: border-box;
}

select selectbox option {
  padding: 8dp 12dp;
}

.card {
  padding: 16dp;
  border-radius: 8dp;
  margin-bottom: 12dp;
}

.chat-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
}

.chat-shell {
  position: absolute;
  top: 16dp;
  left: 16dp;
  right: 16dp;
  bottom: 16dp;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  max-width: 800dp;
  margin-left: auto;
  margin-right: auto;
}

.chat-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12dp;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-bottom: 12dp;
  padding: 8dp 12dp;
  border-radius: 8dp;
}

.chat-header-secure-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  margin-bottom: 4dp;
}

.chat-header-main {
  flex: 1;
  min-width: 0;
}

.chat-header-title {
  font-size: 22dp;
  margin-bottom: 4dp;
}

.chat-preview-btn {
  flex-shrink: 0;
  margin-top: 2dp;
}

.messages {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  overflow-y: auto;
  overflow-x: hidden;
  margin-bottom: 12dp;
  padding-left: 8dp;
  padding-right: 8dp;
}

.message-group {
  display: block;
}

.message-row {
  display: block;
  margin-bottom: 12dp;
}

.message-row-user {
  text-align: right;
}

.message-row-assistant {
  text-align: left;
}

.bubble {
  padding: 10dp 14dp;
  border-radius: 12dp;
  text-align: left;
  box-sizing: border-box;
}

.bubble-user {
  display: inline-block;
  max-width: 680dp;
  focus: none;
}

.bubble-text {
  margin-top: 0;
  margin-bottom: 0;
  white-space: pre-wrap;
  word-break: break-word;
}

.assistant-message {
  display: block;
}

.bubble-assistant {
  display: inline-block;
  max-width: 680dp;
  focus: none;
}

.suggestion-row {
  display: block;
  margin-top: 8dp;
}

.bubble-assistant ul,
.bubble-assistant ol {
  box-sizing: border-box;
}

.bubble-assistant p,
.bubble-assistant li,
.bubble-assistant .code-block {
  word-break: break-word;
}

.bubble-assistant p:last-child,
.bubble-assistant .stack p:last-child {
  margin-bottom: 0;
}

.bubble-assistant h1,
.bubble-assistant h2,
.bubble-assistant h3 {
  margin-top: 0;
}

.bubble-assistant p,
.bubble-assistant li {
}

.thinking {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

.prompt-composer {
  flex-shrink: 0;
  box-sizing: border-box;
  margin: 0 12dp 12dp 12dp;
  padding: 12dp;
  border-radius: 12dp;
}

.prompt-composer-input {
  width: 100%;
  min-height: 40dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: text;
}

.prompt-composer-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8dp;
  gap: 8dp;
}

.prompt-composer-leading {
  flex: 1;
  min-width: 0;
}

.prompt-send-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.prompt-send-btn svg {
  flex-shrink: 0;
}

.code-block {
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  margin-top: 4dp;
  margin-bottom: 8dp;
  white-space: pre-wrap;
}

.chat-suggestion {
  display: inline-block;
  width: auto;
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 6dp 12dp;
  margin-right: 8dp;
  margin-bottom: 4dp;
  border: 0;
  border-radius: 16dp;
  cursor: pointer;
  focus: none;
}

.suggestion-row .chat-suggestion {
  margin-top: 0;
}

.bubble-assistant .chat-suggestion {
  margin-top: 8dp;
}

.chat-form {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.chat-form-label {
  display: block;
  margin-bottom: 8dp;
}

.chat-form-field {
  display: block;
  width: 100%;
  margin-top: 4dp;
  margin-bottom: 0;
  box-sizing: border-box;
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
}

.chat-form-submit {
  display: inline-block;
  width: auto;
  margin-top: 8dp;
  padding: 8dp 16dp;
  border-radius: 8dp;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.chat-form-expired {
  opacity: 0.85;
}

.chat-form-expired .chat-form-field,
.chat-form-expired .chat-form-submit {
  pointer-events: none;
  opacity: 0.6;
}

.chat-form-expired .chat-form-submit {
  display: none;
}

.chat-form-expired-label {
  margin-top: 0;
  margin-bottom: 8dp;
}

.chat-card {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.chat-table {
  width: 100%;
  margin-top: 12dp;
}

.chat-table th,
.chat-table td {
  padding: 6dp 8dp;
  text-align: left;
}

.chat-key-value {
  display: block;
  margin-top: 12dp;
}

.chat-key-value-row {
  display: flex;
  justify-content: space-between;
  gap: 12dp;
  padding: 4dp 0;
}

.chat-callout {
  display: block;
  margin-top: 12dp;
  padding: 10dp 12dp;
  border-radius: 8dp;
}

.chat-quote {
  display: block;
  margin-top: 12dp;
  padding-left: 12dp;
}

.chat-action-list,
.chat-long-list,
.chat-choice,
.chat-poll {
  display: block;
  margin-top: 12dp;
}

.chat-long-list-scroll {
  max-height: 240dp;
  overflow-y: auto;
  padding: 8dp;
  margin-top: 8dp;
  border-radius: 6dp;
  box-sizing: border-box;
}

.chat-long-list-item {
  display: block;
  margin-bottom: 12dp;
  padding-bottom: 10dp;
}

.chat-long-list-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
}

.chat-long-list-title {
  margin-bottom: 4dp;
}

.chat-long-list-subtitle,
.chat-long-list-meta {
  margin-bottom: 4dp;
  font-size: 13dp;
}

.chat-long-list-actions,
.chat-long-list-footer {
  gap: 8dp;
  flex-wrap: wrap;
  margin-top: 6dp;
}

.chat-action-list-item {
  display: block;
  margin-bottom: 10dp;
}

.chat-action-list-actions,
.chat-choice-options,
.chat-poll-options {
  gap: 8dp;
  flex-wrap: wrap;
}

.chat-calendar {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border-radius: 8dp;
}

.calendar-header {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8dp;
}

.calendar-nav {
  display: inline-block;
  padding: 6dp 12dp;
  border: 0;
  border-radius: 6dp;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.calendar-weekdays {
  justify-content: space-between;
  margin-bottom: 4dp;
}

.calendar-weekdays span {
  width: 14%;
  text-align: center;
}

.calendar-grid {
  width: 100%;
}

.calendar-cell {
  width: 14%;
  text-align: center;
  padding: 2dp;
  vertical-align: middle;
}

.calendar-day {
  display: inline-block;
  width: 100%;
  min-height: 28dp;
  padding: 4dp 0;
  border-radius: 6dp;
  border: 0;
  text-align: center;
  box-sizing: border-box;
  font-family: LatoLatin;
  font-size: 14dp;
  cursor: pointer;
  focus: none;
}

.calendar-day-muted {
  display: inline-block;
  width: 100%;
  min-height: 28dp;
  padding: 4dp 0;
  border-radius: 6dp;
  text-align: center;
  box-sizing: border-box;
  background-color: transparent;
  cursor: default;
}

.shell-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
  margin: 0;
}

.shell-chrome {
  position: relative;
  z-index: 100;
}

.shell-root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  padding: 8dp 12dp;
}

.shell-banner-text {
  flex: 1;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

.shell-banner-dismiss {
  width: auto;
  min-width: 32dp;
  padding: 4dp 10dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-toast-stack {
  position: absolute;
  top: 8dp;
  right: 12dp;
  z-index: 110;
}

.shell-toast {
  padding: 10dp 14dp;
  margin-bottom: 8dp;
  border-radius: 8dp;
}

.shell-toast-text {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

.shell-activity-strip {
  height: 3dp;
  opacity: 0.85;
}

.shell-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-pane-row {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.shell-nav-rail {
  flex: 0 0 56dp;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.shell-nav-rail--compact {
  flex: 0 0 auto;
  flex-direction: row;
  width: 100%;
  height: 48dp;
}

.shell-nav-rail-inner {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: flex-start;
  gap: 4dp;
  padding: 8dp 4dp;
  box-sizing: border-box;
}

.shell-nav-rail--compact .shell-nav-rail-inner {
  flex-direction: row;
  justify-content: flex-start;
  gap: 0;
  height: 48dp;
}

.shell-nav-spacer {
  flex: 0 0 auto;
  width: 100%;
  min-height: 0;
}

.shell-nav-rail--compact .shell-nav-spacer {
  flex: 1 1 auto;
  width: auto;
  height: auto;
}

.shell-nav-tab {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 10dp;
  cursor: pointer;
}

.shell-nav-tab svg {
  flex-shrink: 0;
}

.shell-nav-page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.shell-nav-page .shell-pane-body {
  height: 100%;
}

.shell-nav-page--home .shell-pane-body {
  flex: 1;
  min-height: 0;
  height: auto;
}

.shell-nav-page--home .shell-composer-mount {
  flex-shrink: 0;
}

.shell-chat-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateX(0);
  transition: transform 250ms;
}

.shell-chat-overlay--dragging {
  transition: none;
}

.shell-chat-overlay-chrome {
  flex-shrink: 0;
  align-items: center;
  padding: 4dp 4dp;
}

.shell-chat-overlay .shell-pane-body {
  flex: 1;
  min-height: 0;
}

.shell-chat-overlay .shell-composer-mount {
  flex-shrink: 0;
}

.shell-pane {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.shell-pane-secondary {
  flex: 0 0 240dp;
}

.shell-pane-primary {
  flex: 1;
}

.shell-pane-auxiliary {
  flex: 0 0 320dp;
}

.shell-layer-compact {
  display: flex;
  flex-direction: column;
}

.shell-pane-primary-compact {
  flex: 1;
  min-height: 0;
}

.shell-pane-composer {
  flex-shrink: 0;
}

.shell-bottom-chrome {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  z-index: 15;
}

.shell-composer-mount {
  flex-shrink: 0;
}

.shell-composer-mount .prompt-composer {
  margin-bottom: 8dp;
}

.shell-drawer .shell-pane,
.shell-sheet .shell-pane {
  height: 100%;
}

.shell-pane-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.shell-drawer-scrim,
.shell-sheet-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  focus: none;
}

.shell-drawer {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 280dp;
  max-width: 85%;
  z-index: 21;
}

.shell-sheet {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 320dp;
  max-width: 90%;
  z-index: 21;
}

.shell-sheet-compact {
  bottom: 48dp;
}

.shell-toolbar {
  flex-shrink: 0;
  height: 48dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 8dp;
  box-sizing: border-box;
}

.shell-toolbar-flex {
  flex: 1;
}

.shell-toolbar-title {
  font-size: 14dp;
  text-align: center;
}

.shell-toolbar-btn {
  width: auto;
  min-width: 72dp;
  min-height: 44dp;
  padding: 6dp 12dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 13dp;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-transient-chrome {
  flex-shrink: 0;
  padding: 4dp 4dp;
}

.shell-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  min-width: 32dp;
  padding: 0;
  margin-bottom: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-back-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

.shell-layer-transient {
  display: flex;
  flex-direction: column;
  z-index: 10;
}

.shell-layer-transient .shell-pane-transient {
  flex: 1;
  min-height: 0;
}

.shell-layer-overlay,
.shell-layer-dialog {
  z-index: 50;
}

.shell-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  focus: none;
}

.shell-frame {
  position: absolute;
  top: 24dp;
  left: 24dp;
  right: 24dp;
  bottom: 24dp;
  padding: 16dp;
  border-radius: 8dp;
  box-sizing: border-box;
}

.shell-close-btn {
  position: absolute;
  top: 8dp;
  right: 8dp;
  width: auto;
  min-width: 32dp;
  padding: 4dp 10dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-overlay-body {
  margin-top: 32dp;
  height: 100%;
  overflow: auto;
}

.shell-dialog {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 360dp;
  max-width: 90%;
  margin-left: -180dp;
  margin-top: -120dp;
  padding: 20dp;
  border-radius: 8dp;
  box-sizing: border-box;
  z-index: 51;
}

.shell-dialog-title {
  margin-top: 0;
  font-size: 18dp;
}

.shell-dialog-message {
  display: block;
  margin-top: 0;
  margin-bottom: 8dp;
}

.shell-dialog-actions {
  justify-content: flex-end;
  gap: 8dp;
  margin-top: 16dp;
}

.shell-dialog-cancel {
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  cursor: pointer;
}

.shell-dialog-ok {
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  cursor: pointer;
}

.chat-empty {
  padding: 24dp;
  margin-bottom: 16dp;
  border-radius: 8dp;
}

.chat-empty-title {
  margin-top: 0;
  font-size: 20dp;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
}

.chat-panel .chat-header-title {
  font-size: 22dp;
}

.chat-panel .messages {
  flex: 1;
}

.sidebar-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.sidebar-header {
  flex-shrink: 0;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8dp;
}

.sidebar-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.sidebar-new-chat {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  font-family: LatoLatin;
  cursor: pointer;
}

.sidebar-new-chat svg {
  flex-shrink: 0;
}

.sidebar-sessions {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.sidebar-session {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 44dp;
  margin-bottom: 4dp;
  padding: 0 4dp 0 8dp;
  border-radius: 6dp;
  box-sizing: border-box;
}

.sidebar-session-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  cursor: pointer;
}

.sidebar-session-title {
  flex: 1;
  min-width: 0;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar-unread {
  flex-shrink: 0;
  min-width: 20dp;
  padding: 2dp 6dp;
  border-radius: 10dp;
  font-size: 11dp;
  text-align: center;
}

.sidebar-session-close {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28dp;
  height: 28dp;
  min-width: 28dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.sidebar-session-close svg {
  flex-shrink: 0;
}

.message-row-peer {
  margin: 8dp 0;
  padding-right: 48dp;
}

.message-row-ai {
  margin: 8dp 0;
  padding-right: 24dp;
}

.message-row-user {
  margin: 8dp 0;
  padding-left: 48dp;
}

.sender-label {
  display: block;
  font-size: 11dp;
  margin-top: 0;
  margin-bottom: 4dp;
}

.preview-panel,
.working-set-panel {
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow-y: auto;
}

.preview-title,
.working-set-title {
  margin-top: 0;
  font-size: 18dp;
}

.preview-content,
.working-set-body {
  margin-top: 8dp;
}

.working-set-long-list-body {
  display: block;
}

.working-set-long-list .chat-long-list-item {
  display: block;
  margin-bottom: 12dp;
  padding-bottom: 10dp;
}

.working-set-form {
  display: block;
  margin-top: 8dp;
}

.working-set-table {
  width: 100%;
}

.working-set-code {
  white-space: pre-wrap;
}

.chat-working-set-chip {
  display: inline-block;
  margin-top: 8dp;
  margin-right: 8dp;
  padding: 6dp 12dp;
  border-radius: 16dp;
  font-size: 13dp;
  focus: none;
}

.empty-panel {
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  justify-content: center;
}

/* Settings panel */
.settings-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.settings-list-view,
.settings-detail-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.settings-header,
.settings-detail-header {
  flex-shrink: 0;
  align-items: center;
  margin-bottom: 8dp;
}

.settings-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.settings-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.settings-row {
  display: flex;
  flex-direction: column;
  min-height: 44dp;
  margin-bottom: 4dp;
  padding: 8dp;
  border-radius: 6dp;
  box-sizing: border-box;
  cursor: pointer;
}

.settings-row-title {
  margin-top: 0;
  margin-bottom: 2dp;
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.settings-row-subtitle {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 11dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.settings-row--active {
  background-color: rgba(59, 130, 246, 0.12);
}

.settings-back-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin-right: 4dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.settings-back-btn svg {
  flex-shrink: 0;
}

.settings-detail-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  gap: 8dp;
}

.settings-detail-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  overflow: hidden;
}

.settings-section {
  margin-top: 16dp;
  gap: 8dp;
}

.settings-section-title {
  font-size: 14dp;
  font-weight: bold;
  margin-bottom: 4dp;
}

.settings-field {
  display: block;
}

.settings-label {
  display: block;
  font-size: 12dp;
  margin-bottom: 4dp;
}

.settings-path {
  font-size: 12dp;
  word-break: break-all;
}

.settings-actions {
  margin-top: 24dp;
  gap: 12dp;
  justify-content: flex-end;
}

.sidebar-footer {
  margin-top: auto;
  padding: 12dp 16dp;
}

.sidebar-settings-btn {
  display: flex;
  align-items: center;
  gap: 8dp;
  width: 100%;
  text-align: left;
}

.sidebar-settings-btn svg {
  flex-shrink: 0;
}

/* Contacts panel */
.contacts-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.contacts-list-view,
.contacts-detail-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.contacts-header,
.contacts-detail-header {
  flex-shrink: 0;
  align-items: center;
  margin-bottom: 8dp;
}

.contacts-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
}

.contacts-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.contacts-row {
  display: flex;
  flex-direction: column;
  min-height: 44dp;
  margin-bottom: 4dp;
  padding: 8dp;
  border-radius: 6dp;
  box-sizing: border-box;
  cursor: pointer;
}

.contacts-row-title {
  margin-top: 0;
  margin-bottom: 2dp;
  font-size: 13dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.contacts-row-subtitle {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 11dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.contacts-back-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin-right: 4dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.contacts-back-btn svg {
  flex-shrink: 0;
}

.contacts-detail-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  gap: 8dp;
}

.contacts-actions {
  flex-shrink: 0;
  margin-top: 16dp;
}

.contact-detail-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  overflow: hidden;
}

.contacts-row--active {
  background-color: rgba(59, 130, 246, 0.12);
}

.shell-nav-page--under-overlay {
  opacity: 1;
}

.context-menu-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
}

.context-menu-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.context-menu-panel {
  position: absolute;
  min-width: 160dp;
  padding: 4dp;
  border-radius: 8dp;
  background-color: #ffffff;
  box-shadow: 0 4dp 16dp rgba(0, 0, 0, 0.18);
}

.context-menu-item {
  display: block;
  width: 100%;
  margin: 0;
  padding: 10dp 12dp;
  border: 0;
  border-radius: 6dp;
  background-color: transparent;
  text-align: left;
  cursor: pointer;
}

.context-menu-item:hover {
  background-color: rgba(0, 0, 0, 0.06);
}