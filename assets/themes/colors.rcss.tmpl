/* Template for colors-light.rcss and colors-dark.rcss (see scripts/ui/gen_theme_colors.py).
   Each token placeholder in double braces is replaced by that token's value for the theme
   being generated. A line holding only an only-light or only-dark marker comment opens a
   section kept for that theme alone; a line holding only the end marker closes it. */
@media (theme: {{theme}}) {
body {
  color: {{label}};
  background-color: {{bg}};
}

/* Monochrome icons are white sources; tint with image-color (does not inherit). */
svg {
  image-color: {{label}};
}

