@media (theme: light) {
body {
  color: #1a1a1a;
  background-color: #f8f9fb;
}

/* Monochrome icons are white sources; tint with image-color (does not inherit). */
svg {
  image-color: #374151;
}

selection {
  background-color: #b4d5fe;
}

.bubble-user selection {
  background-color: #ffffff55;
}

.bubble-assistant selection {
  background-color: #b4d5fe;
}

.prompt-composer-input selection {
  background-color: #b4d5fe;
}

.chat-form-field selection {
  background-color: #b4d5fe;
}

.text {
  color: #333333;
}

.heading-1 {
  color: #111111;
}

.heading-2 {
  color: #111111;
}

.heading-3 {
  color: #111111;
}

.btn-primary,
.prompt-send-btn,
.sidebar-new-chat,
.contacts-find-btn {
  background-color: #4a6cf7;
  color: #ffffff;
}

.btn-primary:hover,
.btn-primary:focus,
.prompt-send-btn:hover,
.sidebar-new-chat:hover,
.contacts-find-btn:hover {
  background-color: #5a7cff;
}

.btn-primary svg,
.prompt-send-btn svg,
.sidebar-new-chat svg,
.contacts-find-btn svg,
.contacts-action-secure svg {
  image-color: #ffffff;
}

.btn-secondary,
.chat-suggestion {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.btn-secondary:hover,
.btn-secondary:focus,
.chat-suggestion:hover {
  background-color: #d1d5db;
}

.btn-danger {
  background-color: #dc2626;
  color: #ffffff;
}

.btn-danger:hover,
.btn-danger:focus {
  background-color: #b91c1c;
}

.btn-danger-soft {
  background-color: #fef2f2;
  color: #b91c1c;
  border: 1dp #fecaca;
}

.btn-danger-soft:hover,
.btn-danger-soft:focus {
  background-color: #fee2e2;
  color: #991b1b;
  border: 1dp #f87171;
}

.btn-danger svg {
  image-color: #ffffff;
}

.btn-danger-soft svg {
  image-color: #b91c1c;
}

.btn-danger-soft:hover svg,
.btn-danger-soft:focus svg {
  image-color: #991b1b;
}

.btn-ghost {
  background-color: transparent;
  color: #374151;
}

.btn-ghost:hover,
.btn-ghost:focus {
  background-color: #f3f4f6;
  color: #1a1a1a;
}

.field {
  background-color: #ffffff;
  color: #1a1a1a;
  border: 1dp #d1d5db;
}

select selectbox {
  background-color: #ffffff;
  border: 1dp #d1d5db;
}

select selectbox option:hover {
  background-color: #f3f4f6;
}

.card {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
}

.error {
  color: #dc2626;
}

.muted {
  color: #6b7280;
}

.bubble-user {
  background-color: #4a6cf7;
  color: #ffffff;
}

.bubble-text {
  color: #ffffff;
}

.bubble-assistant {
  background-color: #f3f4f6;
  border: 1dp #e5e7eb;
}

.bubble-assistant h1,
.bubble-assistant h2,
.bubble-assistant h3 {
  color: #111111;
}

.bubble-assistant p,
.bubble-assistant li {
  color: #333333;
}

.prompt-composer {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
  box-shadow: 0 2dp 8dp #00000014;
}

.code-block {
  background-color: #eef0f3;
  color: #1a1a1a;
}

.chat-jump-latest {
  background-color: #1a1a1a;
  color: #f9fafb;
}

.chat-jump-latest:hover {
  background-color: #333333;
}

.chat-form {
  border: 1dp #d1d5db;
  background-color: #ffffff;
}

.chat-form-label {
  color: #333333;
}

.chat-form-field {
  background-color: #ffffff;
  color: #1a1a1a;
  border: 1dp #d1d5db;
}

.chat-form-submit {
  background-color: #4a6cf7;
  color: #ffffff;
}

.chat-form-submit:hover {
  background-color: #3f5ee0;
}

.chat-card {
  border: 1dp #d1d5db;
  background-color: #ffffff;
}

.chat-card-highlight {
  border-color: #4a6cf7;
  background-color: #f5f7ff;
}

.chat-table th,
.chat-table td {
  border: 1dp #d1d5db;
}

.chat-key-value-label {
  color: #666666;
}

.chat-callout {
  background-color: #eef2ff;
}

.chat-callout-warning {
  background-color: #fff7ed;
}

.chat-quote {
  border-left: 3dp #d1d5db;
}

.chat-long-list-scroll {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
}

.chat-long-list-item {
  border-bottom: 1dp #e5e7eb;
}

.chat-calendar {
  border: 1dp #d1d5db;
  background-color: #ffffff;
}

.calendar-nav {
  background-color: #4a6cf7;
  color: #ffffff;
}

.calendar-nav:hover {
  background-color: #3f5ee0;
}

.calendar-weekdays {
  color: #666666;
}

.calendar-day {
  background-color: #4a6cf7;
  color: #ffffff;
}

.calendar-day:hover {
  background-color: #3f5ee0;
}

.calendar-day-muted {
  color: #888888;
}

.shell-body--framed {
  border-color: #d1d5db;
}

.shell-titlebar {
  background-color: #f8f9fb;
  border-bottom-color: #e5e7eb;
}

.shell-titlebar-title {
  color: #111111;
}

.shell-titlebar-btn {
  background-color: #00000000;
}

.shell-titlebar-btn:hover {
  background-color: #e5e7eb;
}

.shell-titlebar-btn svg {
  image-color: #374151;
}

.shell-titlebar-btn--close:hover {
  background-color: #dc2626;
}

.shell-titlebar-btn--close:hover svg {
  image-color: #ffffff;
}

.shell-titlebar-btn--traffic,
.shell-titlebar-btn--traffic:hover {
  background-color: #00000000;
}

.shell-titlebar-btn--traffic-close .shell-titlebar-traffic-dot {
  background-color: #ff5f57;
}

.shell-titlebar-btn--traffic-close:hover .shell-titlebar-traffic-dot {
  background-color: #e0443e;
}

.shell-titlebar-btn--traffic-minimize .shell-titlebar-traffic-dot {
  background-color: #febc2e;
}

.shell-titlebar-btn--traffic-minimize:hover .shell-titlebar-traffic-dot {
  background-color: #dea123;
}

.shell-titlebar-btn--traffic-zoom .shell-titlebar-traffic-dot {
  background-color: #28c840;
}

.shell-titlebar-btn--traffic-zoom:hover .shell-titlebar-traffic-dot {
  background-color: #1aad2c;
}

.shell-titlebar-btn--traffic svg {
  image-color: #4d0000;
}

.shell-banner {
  background-color: #fef3c7;
  border-bottom: 1dp #fcd34d;
  color: #92400e;
}

.shell-banner-text {
  color: #92400e;
}

.shell-banner-dismiss {
  background-color: #fde68a;
  color: #92400e;
}

.shell-toast {
  background-color: #1f2937;
  color: #ffffff;
  box-shadow: 0 2dp 8dp #00000033;
}

.shell-toast-text {
  color: #ffffff;
}

.shell-activity-strip {
  background-color: #4a6cf7;
}

.shell-statusbar {
  background-color: #f1f5f9;
  border-top-color: #e5e7eb;
}

.shell-statusbar-cluster:hover {
  background-color: #e2e8f0;
}

.shell-statusbar-divider {
  background-color: #cbd5e1;
}

.shell-statusbar-brief--ok svg {
  image-color: #4d7358;
}

.shell-statusbar-brief--failed svg {
  image-color: #b86b6b;
}

.shell-statusbar-brief--unknown svg {
  image-color: #9ca3af;
}

.shell-statusbar-direct--ok svg {
  image-color: #4d7358;
}

.shell-statusbar-direct--off svg {
  image-color: #b88445;
}

.shell-statusbar-direct--error svg {
  image-color: #b86b6b;
}

.shell-statusbar-direct--checking svg {
  image-color: #9ca3af;
}

.shell-statusbar-inbound--ok svg {
  image-color: #4d7358;
}

.shell-statusbar-inbound--off svg {
  image-color: #b88445;
}

.shell-call-quality-bar {
  background-color: #d1d5db;
}

.shell-call-quality-bar--on {
  background-color: #6b7280;
}

.shell-call-quality--ok .shell-call-quality-bar--on {
  background-color: #6b7280;
}

.shell-call-quality--warn .shell-call-quality-bar--on {
  background-color: #d97706;
}

.shell-call-quality--error .shell-call-quality-bar {
  background-color: #fecaca;
}

.shell-call-quality--error .shell-call-quality-bar--on {
  background-color: #dc2626;
}

.shell-call-quality--warn .shell-call-quality-label,
.shell-call-quality-hint {
  color: #b45309;
}

.shell-call-quality--error .shell-call-quality-label {
  color: #dc2626;
}

.shell-call-debug-subtitle {
  color: #6b7280;
}

.shell-statusbar-help svg {
  image-color: #4a8f87;
}

.shell-statusbar-label--warn {
  color: #a67c3a;
}

.shell-statusbar-label--error {
  color: #b86b6b;
}

.shell-statusbar-popover {
  background-color: #ffffff;
  border-color: #e5e7eb;
  box-shadow: 0 8dp 24dp #00000022;
}

.shell-statusbar-popover-scrim {
  background-color: #00000001;
}

.shell-pane {
  background-color: #f8f9fb;
}

.shell-pane-secondary {
  border-right: 1dp #e5e7eb;
}

.shell-nav-rail {
  background-color: #f1f5f9;
  border-right: 1dp #e5e7eb;
}

.shell-nav-rail--compact {
  border-right: 0;
  border-top: 0;
  background-color: transparent;
}

.shell-nav-rail--compact .shell-nav-pill {
  background-color: #fffffff0;
  border-top: 1dp #ffffff66;
  box-shadow: 0 2dp 12dp #00000014;
}

.shell-bottom-chrome--frost .shell-nav-rail--compact .shell-nav-pill {
  background-color: #ffffffb3;
}

.shell-nav-tab {
  background-color: transparent;
  color: #6b7280;
}

.shell-nav-tab svg {
  image-color: #6b7280;
}

.shell-nav-tab:hover {
  background-color: #e5e7eb;
}

.shell-nav-tab--active {
  background-color: #ffffff;
  color: #111827;
}

.shell-nav-tab--active svg {
  image-color: #111827;
}

.shell-nav-rail--compact .shell-nav-tab:hover {
  background-color: #00000014;
}

.shell-nav-rail--compact .shell-nav-tab--active {
  background-color: #ffffff;
  color: #111827;
}

.shell-chat-overlay {
  background-color: #f8f9fb;
}

.shell-chat-overlay-chrome {
  background-color: #fffffff0;
  border-bottom: 1dp #00000014;
  border-top: 1dp #ffffff66;
  box-shadow: 0 2dp 12dp #00000014;
}

.shell-chat-overlay-chrome.surface-chrome--frost {
  background-color: #ffffffb3;
}

.shell-pane-auxiliary {
  border-left: 1dp #e5e7eb;
}

.shell-bottom-chrome {
  background-color: transparent;
}

.shell-drawer-scrim,
.shell-sheet-scrim,
.shell-account-sheet-scrim {
  background-color: #00000066;
}

.shell-drawer {
  background-color: #f8f9fb;
  box-shadow: 2dp 0 12dp #00000033;
}

.shell-sheet {
  background-color: #f8f9fb;
  box-shadow: -2dp 0 12dp #00000033;
}

.shell-sheet-compact {
  background-color: #ffffff;
  border-left: 1dp #e5e7eb;
  box-shadow: -2dp 0 8dp #00000022;
}

.shell-sheet-compact-chrome {
  background-color: #fffffff0;
  border-bottom: 1dp #00000014;
}

.shell-sheet-compact-chrome.surface-chrome--frost {
  background-color: #ffffffb3;
  border-bottom: 1dp #00000014;
  border-top: 1dp #ffffff66;
}

.shell-account-sheet {
  background-color: #ffffff;
}

.shell-account-sheet-header {
  background-color: #fffffff0;
  border-bottom: 1dp #00000014;
}

.shell-account-sheet-header.surface-chrome--frost {
  background-color: #ffffffb3;
  border-top: 1dp #ffffff66;
}

.shell-profile-btn {
  background-color: #e5e7eb;
}

.shell-account-sheet-grabber {
  background-color: #d1d5db;
}

.shell-toolbar {
  background-color: #ffffff;
  border-top: 1dp #e5e7eb;
}

.shell-toolbar-title {
  color: #374151;
}

.shell-toolbar-btn {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-toolbar-btn-preview {
  background-color: #4a6cf7;
  color: #ffffff;
}

.shell-transient-chrome {
  background-color: #fffffff0;
  border-bottom: 1dp #00000014;
  border-top: 1dp #ffffff66;
  box-shadow: 0 2dp 12dp #00000014;
}

.shell-transient-chrome.surface-chrome--frost {
  background-color: #ffffffb3;
}

.shell-composer-mount.surface-chrome {
  background-color: #fffffff0;
  border-top: 1dp #e5e7eb;
}

.shell-composer-mount.surface-chrome .prompt-composer {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
  box-shadow: none;
}

/* Floating Chrome utilities (compact shell; theme-only). */
.surface-chrome {
  background-color: #fffffff0;
  border-top: 1dp #ffffff66;
}

.surface-chrome--frost {
  background-color: #ffffffb3;
}

.surface-chrome--solid {
  background-color: #fffffff0;
}

.shell-back-btn {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-layer-transient {
  background-color: #f8f9fb;
}

.shell-scrim {
  background-color: #00000066;
}

.shell-frame {
  background-color: #ffffff;
}

.shell-close-btn {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-close-btn:hover,
.shell-close-btn:focus {
  background-color: #d1d5db;
}

.shell-close-btn svg {
  image-color: #1a1a1a;
}

.shell-dialog {
  background-color: #ffffff;
}

.shell-dialog-message {
  color: #374151;
}

.shell-call-meter-label {
  color: #6b7280;
}

.shell-call-meter-hint {
  color: #374151;
}

.shell-call-meter-seg {
  background-color: #e5e7eb;
}

.shell-call-meter-seg--on {
  background-color: #4a6cf7;
}

.shell-call-bar {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
}

.shell-call-bar-title {
  color: #111111;
}

.shell-call-bar-subtitle {
  color: #6b7280;
}

.shell-call-bar-hint {
  color: #b45309;
}

.shell-call-mute {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-call-mute svg {
  image-color: #1a1a1a;
}

.shell-call-mute--on {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-call-mute--on svg {
  image-color: #1a1a1a;
}

.shell-call-camera {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-call-camera svg {
  image-color: #1a1a1a;
}

.shell-call-camera--on {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-call-camera--on svg {
  image-color: #1a1a1a;
}

.shell-call-speaker {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-call-speaker svg {
  /* Earpiece / speaker off — lower contrast status */
  image-color: #9ca3af;
}

.shell-call-speaker--on {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-call-speaker--on svg {
  /* Speakerphone on — full contrast status */
  image-color: #1a1a1a;
}

.shell-call-leave {
  background-color: #fee2e2;
  color: #991b1b;
}

.shell-call-leave svg {
  image-color: #991b1b;
}

.shell-call-minimize,
.shell-call-immersive-btn,
.shell-call-expand {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-call-minimize svg,
.shell-call-immersive-btn svg,
.shell-call-expand svg {
  image-color: #1a1a1a;
}

.shell-call-minimized-chip {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
}

.shell-call-minimized-title {
  color: #111111;
}

.shell-call-minimized-subtitle {
  color: #6b7280;
}

.shell-call-immersive {
  background-color: #f3f4f6;
}

.shell-call-immersive-grabber {
  background-color: #d1d5db;
}

.shell-call-peer-card {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
}

.shell-call-peer-avatar {
  background-color: #e5e7eb;
}

.shell-call-peer-name {
  color: #111111;
}

.shell-call-retry {
  background-color: #dbeafe;
  color: #1e40af;
}

.shell-call-retry svg {
  image-color: #1e40af;
}

.shell-call-stage {
  background-color: #111827;
}

.shell-call-remote {
  background-color: #1f2937;
}

.shell-call-remote-placeholder {
  color: #6b7280;
}

.shell-call-pip {
  background-color: #e5e7eb;
  border: 1dp #9ca3af;
}

.shell-call-ring-eyebrow {
  color: #6b7280;
}

.shell-call-ring {
  border-color: #c7d2fe;
}

.shell-call-ring--pulse {
  border-color: #4a6cf7;
}

.shell-call-accept--pulse {
  background-color: #5a7cff;
  box-shadow: 0 0 0 4dp #4a6cf733, 0 4dp 14dp #4a6cf755;
}

.chat-empty {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
}

.sidebar-header-title {
  color: #374151;
}

.sidebar-session {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
}

.sidebar-session-active {
  background-color: #eef2ff;
  border-color: #c7d2fe;
  box-shadow: inset 3dp 0 0 #4a6cf7;
}

.sidebar-session--ai.sidebar-session-active {
  box-shadow: inset 3dp 0 0 #4a6cf7;
}

.sidebar-session--private.sidebar-session-active {
  background-color: #ecfdf5;
  border-color: #99f6e4;
  box-shadow: inset 3dp 0 0 #0d9488;
}

.sidebar-session--public.sidebar-session-active {
  background-color: #f3f4f6;
  border-color: #d1d5db;
  box-shadow: inset 3dp 0 0 #6b7280;
}

.sidebar-session--group.sidebar-session-active {
  background-color: #fffbeb;
  border-color: #fcd34d;
  box-shadow: inset 3dp 0 0 #d97706;
}

.sidebar-session-title {
  color: #333333;
}

.sidebar-unread {
  background-color: #3b82f6;
  color: #ffffff;
}

.badge-count {
  background-color: #3b82f6;
  color: #ffffff;
}

.badge-dot {
  background-color: #3b82f6;
}

.sidebar-session-close:hover {
  background-color: #f3f4f6;
}

.bubble-peer {
  background-color: #f3f4f6;
  border: 1dp #e5e7eb;
}

.working-set-long-list .chat-long-list-item {
  border-bottom: 1dp #e5e7eb;
}

.chat-working-set-chip {
  border: 1dp #d1d5db;
  background-color: #f3f4f6;
  color: #1f2937;
}

.chat-working-set-chip:hover {
  background-color: #e5e7eb;
}

.settings-section-title {
  color: #374151;
}

.settings-label {
  color: #6b7280;
}

.settings-toggle-label {
  color: #1a1a1a;
}

.settings-switch {
  background-color: #d1d5db;
}

.settings-switch--on {
  background-color: #4a6cf7;
}

.settings-switch-knob {
  background-color: #ffffff;
  box-shadow: 0 1dp 3dp #00000033;
}

.settings-choice-value-text {
  color: #6b7280;
}

.settings-danger-zone {
  border-top: 1dp #e5e7eb;
}

.me-profile-card {
  background-color: #f8fafc;
  border: 1dp #e5e7eb;
}

.settings-row {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
  color: #1a1a1a;
}

.settings-row:hover,
.settings-row:focus {
  background-color: #f9fafb;
}

.settings-back-btn:hover,
.settings-back-btn:focus {
  background-color: #f3f4f6;
}

.settings-choice-row:hover,
.settings-choice-row:focus {
  background-color: #f3f4f6;
}

.settings-row--active {
  background-color: #eef2ff;
  border-color: #c7d2fe;
}

.settings-row-title {
  color: #111111;
}

.settings-row-chevron {
  image-color: #9ca3af;
}

.contacts-row,
.contacts-thread-row {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
}

.contacts-row--active {
  background-color: #eef2ff;
  border-color: #c7d2fe;
  box-shadow: inset 3dp 0 0 #4a6cf7;
}

.contacts-row-title {
  color: #333333;
}

.contact-profile-card {
  background-color: #f8fafc;
  border: 1dp #e5e7eb;
}

.contacts-trust-badge--friendly {
  background-color: #ecfdf5;
  color: #0f766e;
}

.contacts-trust-badge--blocked {
  background-color: #fef2f2;
  color: #b91c1c;
}

.contacts-back-btn:hover {
  background-color: #f3f4f6;
}

.contacts-action-secure {
  background-color: #0d9488;
  color: #ffffff;
}

.contacts-action-secure:hover {
  background-color: #0f766e;
}

.people-picker-row:hover {
  background-color: #f3f4f6;
}

.people-picker-row--selected {
  background-color: #eef2ff;
}

.people-picker-check {
  border-color: #cbd5e1;
  background-color: #ffffff;
}

.people-picker-row--selected .people-picker-check {
  border-color: #4a6cf7;
  background-color: #4a6cf7;
  color: #ffffff;
}

.people-picker-check-mark {
  color: #ffffff;
}

.people-picker-member-chip {
  background-color: #eef2ff;
  color: #3730a3;
}

.emoji-picker-section-label {
  background-color: #ffffff;
}

.emoji-picker-section-label-text {
  color: #6b7280;
}

.emoji-picker-rail-tab--active {
  background-color: #e5e7eb;
}

.contacts-trust-btn--active {
  background-color: #eef2ff;
  color: #3730a3;
  border: 1dp #c7d2fe;
}

.contacts-trust-btn--active.contacts-trust-btn {
  box-shadow: inset 0 0 0 1dp #4a6cf7;
}

.sidebar-footer {
  border-top: 1dp #e5e7eb;
}

.chat-shell--e2e .chat-header {
  background-color: #ecfdf5;
  border-left: 4dp #0d9488;
  padding-left: 12dp;
  border-radius: 0 8dp 8dp 0;
}

.chat-shell--ai .chat-header {
  border-left: 4dp #4a6cf7;
  padding-left: 12dp;
  border-radius: 0 8dp 8dp 0;
}

.chat-shell--public .chat-header {
  border-left: 4dp #d1d5db;
  padding-left: 12dp;
  border-radius: 0 8dp 8dp 0;
}

.chat-shell--group .chat-header {
  border-left: 4dp #d97706;
  padding-left: 12dp;
  border-radius: 0 8dp 8dp 0;
}

.prompt-composer--e2e {
  border-color: #99f6e4;
}

.prompt-composer--disabled {
  opacity: 0.55;
}

.chat-secure-badge {
  color: #0d9488;
}

.chat-shell--ai .chat-type-badge {
  color: #4a6cf7;
}

.chat-shell--private .chat-type-badge {
  color: #0d9488;
}

.chat-shell--public .chat-type-badge {
  color: #6b7280;
}

.chat-shell--group .chat-type-badge {
  color: #b45309;
}

.chat-header-call-btn,
.chat-header-more-btn {
  background-color: #e5e7eb;
  color: #1a1a1a;
}

.chat-header-call-btn:hover,
.chat-header-more-btn:hover {
  background-color: #d1d5db;
}

.chat-header-call-btn svg,
.chat-header-more-btn svg {
  image-color: #1a1a1a;
}

.context-menu-panel {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
}

.context-menu-scrim {
  background-color: #00000066;
}

.context-menu-sheet-list {
  background-color: #ffffff;
  border: 1dp #e5e7eb;
}

.context-menu-sheet-cancel {
  background-color: #ffffff;
  color: #4a6cf7;
  border: 1dp #e5e7eb;
}

.context-menu-sheet-cancel:hover {
  background-color: #f3f4f6;
}

.context-menu-item {
  color: #1a1a1a;
}

.context-menu-item:hover {
  background-color: #f3f4f6;
}

.context-menu-item--danger {
  color: #dc2626;
}

.context-menu-item--danger:hover {
  background-color: #fef2f2;
}

.context-menu-item--danger svg {
  image-color: #dc2626;
}
}
