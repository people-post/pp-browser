}

.shell-call-expand svg,
.shell-call-grid svg {
  image-color: #000000;
}

.shell-call-minimized-chip {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

/* #189: the edge handle is the call green with a white phone (iOS's "call in progress" colour): visible on any page and
   read as "the live call", never as hang-up (Kenneth 2026-11-09: red would scare a tap). */
.shell-call-minimized-chip--handle {
  background-color: #34c759;
  border-color: #34c759;
}

.shell-call-minimized-icon {
  image-color: #ffffff;
}

.shell-call-minimized-title {
  color: #000000;
}

.shell-call-minimized-subtitle {
  color: #3c3c4399;
}

.shell-call-immersive {
  background-color: #f2f2f7;
}

.shell-call-immersive-grabber {
  background-color: #3c3c434c;
}

.shell-call-peer-card {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

.shell-call-peer-avatar {
  background-color: #78788033;
}

.avatar-tone-0 {
  background-color: #007aff;
}

