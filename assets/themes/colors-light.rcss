  opacity: 0.6;
}

/* Phone Today page (DESIGN-pp-ui 8.16); geometry in components.rcss. */
.shell-layer-compact .home-panel {
  background-color: #f2f2f7;
}

.shell-layer-compact .home-date {
  color: #3c3c4399;
}

.shell-layer-compact .home-w {
  background-color: #ffffff;
}

.shell-layer-compact .home-w--tap:active,
.shell-layer-compact .home-av:active .home-av-frame,
.shell-layer-compact .home-chat:active,
.shell-layer-compact .home-brief:active,
.shell-layer-compact .home-edit-toggle:active {
  opacity: 0.6;
}

.shell-layer-compact .home-wh-title,
.shell-layer-compact .home-av-name,
.shell-layer-compact .home-chat-preview,
.shell-layer-compact .home-small,
.shell-layer-compact .home-brief-meta,
.shell-layer-compact .home-w-hint,
.shell-layer-compact .home-edit-size {
  color: #3c3c4399;
}

.shell-layer-compact .home-wh-more {
  color: #007aff;
}

.shell-layer-compact .home-chat-title,
.shell-layer-compact .home-num,
.shell-layer-compact .home-brief-title {
  color: #000000;
}

.shell-layer-compact .home-av-letter,
.shell-layer-compact .home-chat-letter {
  color: #ffffff;
}

.shell-layer-compact .home-wh-icon svg,
.shell-layer-compact .home-chat-icon,
.shell-layer-compact .home-edit-sign svg {
  image-color: #ffffff;
}

/* The widgets' coloured squares (mockup 10-home-widgets). */
.shell-layer-compact .home-wh-icon--favorites {
  background-color: #007aff;
}

.shell-layer-compact .home-wh-icon--calls {
  background-color: #34c759;
}

.shell-layer-compact .home-wh-icon--mentions {
  background-color: #ff9500;
}

.shell-layer-compact .home-wh-icon--recent {
  background-color: #5856d6;
}

.shell-layer-compact .home-wh-icon--new-people {
  background-color: #af52de;
}

/* Security: green when the recovery phrase has been opened, orange while it still should be written down. */
.shell-layer-compact .home-wh-icon--security {
  background-color: #34c759;
}

.shell-layer-compact .home-num--ok {
  color: #34c759;
}

.shell-layer-compact .home-num--todo {
  color: #ff9500;
}

/* Calls with nothing to show: a faint green phone, like the other empty widgets (Kenneth 2026-11-05). */
.shell-layer-compact .home-empty-icon--calls {
  background-color: #34c7591f;
}

.shell-layer-compact .home-empty-icon--calls svg {
  image-color: #34c759;
}

/* Mentions / New people with nothing to show: a faint tinted icon over one grey line (mockup 12, option C). */
.shell-layer-compact .home-empty-icon--mentions {
  background-color: #ff95001f;
}

.shell-layer-compact .home-empty-icon--mentions svg {
  image-color: #ff9500;
}

.shell-layer-compact .home-empty-icon--new-people {
  background-color: #af52de1f;
}

.shell-layer-compact .home-empty-icon--new-people svg {
  image-color: #af52de;
}

/* A suggested person in Favorites (not starred): a lighter name after a small blue sparkle. */
.shell-layer-compact .home-av-name--suggested {
  color: #3c3c434c;
}

.shell-layer-compact .home-av-suggest {
  image-color: #007aff;
}

.shell-layer-compact .home-wh-icon--brief {
  background-color: #ff3b30;
}

/* The smaller headlines sit under a hairline. */
.shell-layer-compact .home-brief {
  border-top: 1dp #3c3c434a;
}

.shell-layer-compact .home-brief--head {
  border-top-width: 0;
}

.shell-layer-compact .home-edit-sign--remove {
  background-color: #ff3b30;
}

.shell-layer-compact .home-edit-sign--add {
  background-color: #34c759;
}

.shell-layer-compact .home-edit-handle svg {
  image-color: #8e8e93;
}

/* The row being dragged is lifted off its card: its own card colour and a soft shadow. While a row is held the press
   tint would stay on the row the finger went down on, whichever widget it shows after a move: none while dragging. */
.shell-layer-compact .home-edit-card--dragging .home-edit-row:active {
  background-color: transparent;
}

.shell-layer-compact .home-edit-row--lifted,
.shell-layer-compact .home-edit-card--dragging .home-edit-row--lifted:active {
  background-color: #ffffff;
  box-shadow: 0 6dp 18dp #00000026;
}

/* Home: the ask-AI dock and the tab bar share one opaque colour, no line between them or above the dock; the widgets
   fade into it instead (Apple's widget pages). Other tabs keep the bar as it is. */
.shell-layer-compact .home-landing {
  background-color: #ffffff;
}

.shell-layer-compact .home-dock-fade {
  decorator: linear-gradient(to bottom, #ffffff00, #ffffff);
}

/* The dock's last 10dp melt into the tab bar's shade; the bar itself is a plain fill, no line. */
.shell-layer-compact .home-dock-seam {
  decorator: linear-gradient(to bottom, #ffffff00, #f2f2f7);
}

.shell-bottom-chrome--home,
.shell-bottom-chrome--home.shell-bottom-chrome--frost {
  background-color: #f2f2f7;
  border-top-width: 0;
}

/* Phone call pages (ShellCallChromeRml): always dark, whatever the theme; the sheet over them follows the theme. */
.call-phone {
  background-color: #101214;
  color: #ffffff;
}

.call-phone svg {
  image-color: #ffffff;
}

.call-phone-sealed-text,
.call-phone-status,
.call-phone-sub,
.call-phone-who-status,
.call-phone-pair-name,
.call-phone-tile-note,
.call-phone-hint,
.call-phone-debug,
.call-phone-remote-note,
.call-phone-step--done .call-phone-step-text {
  color: #ffffffb3;
}

.call-phone-sealed svg {
  image-color: #ffffffb3;
}

.call-phone-remote {
  background-color: #101214;
}

.call-phone-video-dim {
  background-color: #0000008c;
}

.call-phone-video-top {
  background-color: #0000004d;
}

.call-phone-notice {
  background-color: #3a3a3ceb;
}

.call-phone-notice--warn {
  background-color: #784800eb;
}

.call-hold-pill {
  background-color: #784800eb;
  color: #ffffff;
}

.call-hold-pill svg {
  image-color: #ffffff;
}

.call-phone-notice-icon {
  background-color: #ffffff24;
}

/* #171: the reconnect capsule above the button bar — amber while the path is found again, green once restored;
   the timer greys meanwhile. */
.call-phone-reconnect {
  background-color: #784800eb;
}

.call-phone-reconnect--ok {
  background-color: #1f6f4aeb;
}

.call-phone-reconnect-icon {
  background-color: #ffffff24;
}

.call-phone-timer--dim {
  color: #ffffff80;
}

.call-phone-signal {
  background-color: #ffffff24;
}

.call-phone-signal-bar {
  background-color: #ffffff40;
}

.call-phone-signal-dot,
.call-phone-signal-line,
.call-phone-signal-bar--on {
  background-color: #40c8e0;
}

.call-phone-signal--sheet {
  background-color: #7878801f;
}

.call-phone-signal--sheet .call-phone-signal-bar {
  background-color: #78788033;
}

.call-phone-signal--sheet .call-phone-signal-dot,
.call-phone-signal--sheet .call-phone-signal-line,
.call-phone-signal--sheet .call-phone-signal-bar--on {
  background-color: #30b0c7;
}

.call-phone-signal--fair .call-phone-signal-dot,
.call-phone-signal--fair .call-phone-signal-line,
.call-phone-signal--fair .call-phone-signal-bar--on {
  background-color: #ff9f0a;
}

.call-phone-signal--fair .call-phone-signal-word {
  color: #ff9f0a;
}

.call-phone-signal--poor .call-phone-signal-dot,
.call-phone-signal--poor .call-phone-signal-line,
.call-phone-signal--poor .call-phone-signal-bar--on {
  background-color: #ff453a;
}

.call-phone-signal--poor .call-phone-signal-word {
  color: #ff453a;
}

.call-phone-result {
  background-color: #30d1582e;
}

.call-phone-result-check {
  background-color: #30d158;
}

.call-phone-pair-dot {
  background-color: #ffffff59;
}

.call-phone-pair-spark {
  background-color: #40c8e0;
}

.call-phone-step-text {
  color: #ffffff73;
}

.call-phone-step--current .call-phone-step-text {
  color: #ffffff;
}

.call-phone-step-dot {
  border-color: #ffffff40;
}

.call-phone-step--done .call-phone-step-dot {
  background-color: #30d158;
}

.call-phone-step--current .call-phone-step-dot {
  border-color: transparent #40c8e0 #40c8e0 #40c8e0;
}

.call-phone-card {
  background-color: #161819f7;
}

.call-phone-tile {
  background-color: #ffffff17;
}

.call-phone-tile.call-phone-tile--speaking {
  border-color: #34c759;
}

.call-phone-tile-label {
  background-color: #00000073;
}

.call-phone-controls {
  background-color: #3a3a3cd1;
}

.call-phone-control-circle {
  background-color: #ffffff33;
}

.call-phone-control--on .call-phone-control-circle {
  background-color: #ffffff;
}

.call-phone-control--on .call-phone-control-circle svg {
  image-color: #000000;
}

.call-phone-control--end .call-phone-control-circle,
.call-phone-round--decline {
  background-color: #ff3b30;
}

.call-phone-round--accept {
  background-color: #34c759;
}

.call-phone-pill-btn {
  background-color: #ffffff29;
  color: #ffffff;
}

.call-phone-pill-btn--primary {
  background-color: #0a84ff;
}

/* G022: "Make a group…" and the group banner on the phone call page. */
.call-make-group--phone,
.call-group-offer--phone .call-group-offer-btn {
  background-color: #ffffff29;
  color: #ffffff;
}

.call-make-group--phone svg {
  image-color: #ffffff;
}

.call-group-offer--phone {
  background-color: #ffffff29;
  color: #ffffff;
}

.call-group-offer--phone .call-group-offer-btn--primary {
  background-color: #0a84ff;
}

.call-phone-avatar--group {
  background-color: #ff9500;
}

/* The unknown caller: the blue of avatar-tone-0 (the class is on the element), a touch lighter at the top. */
.call-phone-avatar--unknown {
  decorator: linear-gradient(to bottom, #2b90ff, #0066d9);
}

.call-phone-sheet-lead,
.call-phone-event-time,
.call-phone-kv-value {
  color: #3c3c4399;
}

.call-phone-event-text,
.call-phone-kv-key {
  color: #000000;
}

.call-phone-event-dot {
  background-color: #34c759;
}

.call-phone-event--secure .call-phone-event-dot {
  background-color: #30b0c7;
}

.call-phone-sheet-group {
  background-color: #f2f2f7;
}

.call-phone-kv {
  border-color: #3c3c434a;
}

/* Me -> Storage and its storage manager (merged 2026-11-05 from kenneth/storage-manager; colours moved onto tokens). */
.storage-bar {
  background-color: #78788033;
}

.storage-c-picture {
  background-color: #007aff;
}

.storage-c-video {
  background-color: #af52de;
}

.storage-c-file {
  background-color: #ff9500;
}

.storage-c-chats {
  background-color: #8e8e93;
}

.storage-c-other {
  background-color: #c7c7cc;
}

.storage-row + .storage-row {
  border-top-color: #3c3c434a;
}

.settings-radio-check {
  image-color: #007aff;
}

.storage-nav-back,
.storage-nav-action {
  color: #007aff;
}

.storage-nav-back-icon {
  image-color: #007aff;
}

.storage-seg {
  background-color: #7878801f;
}

.storage-seg .storage-seg-tab {
  color: #000000;
}

.storage-seg .storage-seg-tab--on {
  background-color: #ffffff;
}

.storage-tile-frame {
  background-color: #007aff1f;
}

.storage-tile--video .storage-tile-frame {
  background-color: #af52de40;
}

.storage-tile-size {
  color: #ffffff;
  font-effect: shadow(1dp 1dp #00000099);
}

.storage-tile-play {
  image-color: #ffffff;
}

.storage-check {
  border-color: #8e8e93;
}

.storage-tile-check {
  border-color: #ffffff;
  background-color: #00000026;
}

.storage-check--on,
.storage-tile-check.storage-check--on {
  border-color: #007aff;
  background-color: #007aff;
}

.storage-check-icon {
  image-color: #ffffff;
}

.storage-file-type {
  background-color: #ff9500;
}

.storage-file-type-text {
  color: #ffffff;
}

/* Phone round button (DEV/PLAN-minimal-nav.md G): a clear 44dp target, the 34dp disc a quiet grey that darkens while
   pressed, the icon in the label colour. */
.shell-layer-compact .shell-circle-btn,
.shell-layer-compact .shell-circle-btn:hover,
.shell-layer-compact .shell-circle-btn:focus {
  background-color: transparent;
}

.shell-layer-compact .shell-circle-btn-face {
  background-color: #e2e2e9;
  decorator: linear-gradient(to bottom, #ffffff, #e2e2e9);
  box-shadow: 0 1dp 3dp #00000026;
}

.shell-layer-compact .shell-circle-btn:active .shell-circle-btn-face {
  background-color: #78788033;
  decorator: linear-gradient(to bottom, #78788033, #78788033);
}

.shell-layer-compact .shell-circle-btn .shell-circle-btn-face svg {
  image-color: #000000;
}

/* Phone AI drawer (DEV/PLAN-minimal-nav.md C): the page colour, a soft shadow fading out from its right edge, and the
   bottom "you" row pressed like a list row. */
.shell-drawer-body {
  background-color: #ffffff;
}

.shell-drawer-edge {
  decorator: linear-gradient(to right, #0000001f, #00000000);
}

.ai-drawer-title,
.ai-drawer-me-name {
  color: #000000;
}

.ai-drawer-me-link-icon--ok {
  image-color: #30b0c7;
}

.ai-drawer-me-link-icon--connecting {
  image-color: #ff9500;
}

.ai-drawer-me-link-icon--offline {
  image-color: #ff3b30;
}

.ai-drawer-me-link-text {
  color: #3c3c4399;
}

/* The ask-AI panel's input bar is clear (TODO #202): a floating pill and two round buttons over the bubbles. */
.ask-ai-composer {
  background-color: transparent;
}

/* The drawer's top bar and "you" row: the bar colour, frosted with Transparency on (like .pane-nav-bg). */
.ai-drawer-top,
.ai-drawer-me,
.ai-drawer-me:hover,
.ai-drawer-me:focus {
  background-color: #f2f2f7;
}

/* The search pill on the bar: a fill, so it shows on the bar colour. */
.ai-drawer-search {
  background-color: #7878801f;
}

.shell-drawer--frost .ai-drawer-top,
.shell-drawer--frost .ai-drawer-me,
.shell-drawer--frost .ai-drawer-me:hover,
.shell-drawer--frost .ai-drawer-me:focus {
  background-color: #f2f2f7c7;
  backdrop-filter: blur(20px);
}

.ai-drawer-me:active {
  background-color: #7878801f;
}

.ai-drawer-me-avatar .avatar-letter {
  color: #ffffff;
}

.ai-drawer-me-chevron {
  image-color: #3c3c434c;
}

/* On the camera the disc is a dark glass with a white chevron, in both themes. */
.shell-layer-compact .qr-scan-back .shell-circle-btn-face,
.shell-layer-compact .qr-scan-back:active .shell-circle-btn-face {
  background-color: #00000066;
  decorator: none;
  box-shadow: none;
}

.shell-layer-compact .qr-scan-back .shell-circle-btn-face svg {
  image-color: #ffffff;
}

.context-menu-layer--popover-left .context-menu-panel {
  background-color: #e2e2e9;
  decorator: linear-gradient(to bottom, #ffffff, #e2e2e9);
  box-shadow: 0 2dp 8dp #00000026;
}

.context-menu-layer--popover-left .context-menu-item,
.context-menu-layer--popover-left .context-menu-item:hover,
.context-menu-layer--popover-left .context-menu-item:focus {
  background-color: transparent;
  border: 0;
}

.context-menu-layer--popover-left .context-menu-item:active {
  background-color: #78788033;
}

.context-menu-layer--popover-left .context-menu-item-icon {
  background-color: #7878801f;
}
}
