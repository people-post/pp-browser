}

.shell-call-accept--pulse {
  background-color: #34c759;
  box-shadow: 0 0 0 4dp #16a34a33, 0 4dp 14dp #00000026;
}

.chat-empty {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

.sidebar-header-title {
  color: #000000;
}

.sidebar-session {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

/* Before the active rules so the open thread keeps its highlight. */
.sidebar-session--pinned {
  background-color: #f2f2f7;
}

.session-swipe-btn--more {
  background-color: #8e8e93;
}

.session-swipe-btn--archive {
  background-color: #007aff;
}

.session-swipe-btn--delete {
  background-color: #ff3b30;
}

.session-swipe-btn--pin {
  background-color: #ff9500;
}
/* The AI chat's rename swipe (home-minimal increment): it had no colour and showed as a white box. */
.session-swipe-btn--rename {
  background-color: #007aff;
}

.session-swipe-btn--read {
  background-color: #007aff;
}

.session-swipe-btn svg {
  image-color: #ffffff;
}

.session-swipe-label {
  color: #ffffff;
}

.sidebar-session-active {
  background-color: #007aff1f;
  border-color: #007aff1f;
  box-shadow: inset 3dp 0 0 #007aff;
}

.sidebar-session--ai.sidebar-session-active {
  box-shadow: inset 3dp 0 0 #5856d6;
}

.sidebar-session--private.sidebar-session-active {
  background-color: #30b0c71f;
  border-color: #30b0c71f;
  box-shadow: inset 3dp 0 0 #30b0c7;
}

.sidebar-session--public.sidebar-session-active {
  background-color: #7878801f;
  border-color: #3c3c434a;
  box-shadow: inset 3dp 0 0 #8e8e93;
}

.sidebar-session--group.sidebar-session-active {
  background-color: #007aff1f;
  border-color: #3c3c434a;
  box-shadow: inset 3dp 0 0 #ff9500;
}

.sidebar-session-date {
  color: #3c3c4399;
}

.sidebar-session-title {
  color: #000000;
}

.sidebar-session-preview {
  color: #3c3c4399;
}

/* A thread with no message yet: the placeholder is quieter than a real preview (the presenter's preview_empty). */
.sidebar-session--empty .sidebar-session-preview {
  color: #3c3c434c;
}

.sidebar-session-icon {
  background-color: #f2f2f7;
}

.sidebar-session-flag, .sidebar-archived-entry svg {
  image-color: #8e8e93;
}

.sidebar-archived-label {
  color: #3c3c4399;
}

.sidebar-archived-entry:hover {
  background-color: #7878801f;
}

.sidebar-session-mention {
  color: #5856d6;
}

.sidebar-unread-dot {
