  color: #3c3c4399;
}

.settings-label {
  color: #3c3c4399;
}

.settings-toggle-label {
  color: #000000;
}

.settings-switch {
  background-color: #8e8e93;
}

.settings-switch--on {
  background-color: #34c759;
}

.settings-switch-knob {
  background-color: #ffffff;
  box-shadow: 0 1dp 3dp #00000026;
}

.settings-choice-value-text {
  color: #3c3c4399;
}

.settings-danger-zone {
  border-top: 1dp #3c3c434a;
}

.settings-device-badge {
  background-color: #007aff1f;
  color: #007aff;
}

.me-profile-card {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

.me-identity-name {
  color: #000000;
}

.me-identity-action {
  color: #007aff;
}

.settings-row {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
  color: #000000;
}

.settings-row:hover, .settings-row:focus {
  background-color: #7878801f;
}

/* Me -> Storage lists: the group card is itself a .settings-row, so a child row's :hover / :focus would
   grey the whole group (every option at once). Keep the card steady; only the tapped row greys, via the
   .settings-choice-row rule below (Kenneth 2026-11-05, phone). */
.settings-row.storage-group:hover, .settings-row.storage-group:focus {
  background-color: #ffffff;
}

.settings-back-btn:hover, .settings-back-btn:focus {
  background-color: #7878801f;
}

.settings-choice-row:hover, .settings-choice-row:focus {
  background-color: #7878801f;
}

.settings-row--active {
  background-color: #007aff1f;
  border-color: #007aff1f;
}

.settings-row-title {
  color: #000000;
}

.settings-row-chevron {
  image-color: #3c3c434c;
}

.contacts-row, .contacts-thread-row {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

.contacts-row--active {
  background-color: #007aff1f;
  border-color: #007aff1f;
  box-shadow: inset 3dp 0 0 #007aff;
}

.contacts-row-title {
  color: #000000;
}

.contact-profile-card {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

.contacts-trust-badge--friendly {
  background-color: #30b0c71f;
  color: #30b0c7;
}

.contacts-trust-badge--blocked {
  background-color: #7878801f;
  color: #ff3b30;
}

.contacts-back-btn:hover {
  background-color: #7878801f;
}

.contacts-action-secure {
  background-color: #30b0c7;
  color: #ffffff;
}

.contacts-action-secure:hover {
  background-color: #30b0c7;
}

.people-picker-row:hover {
  background-color: #7878801f;
}

.people-picker-row--selected {
  background-color: #007aff1f;
}

.people-picker-check {
  border-color: #3c3c434a;
  background-color: #ffffff;
}

.people-picker-row--selected .people-picker-check {
  border-color: #007aff;
  background-color: #007aff;
  color: #ffffff;
}

.people-picker-check-mark {
  color: #ffffff;
}

.people-picker-member-chip {
  background-color: #007aff1f;
  color: #007aff;
}

.emoji-picker-section-label {
  background-color: #ffffff;
}

.emoji-picker-section-label-text {
  color: #3c3c4399;
}

.emoji-picker-rail-tab--active {
  background-color: #7878801f;
}

.contacts-trust-btn--active {
  background-color: #007aff1f;
  color: #007aff;
  border: 1dp #007aff1f;
}

.contacts-trust-btn--active.contacts-trust-btn {
  box-shadow: inset 0 0 0 1dp #007aff;
}

.sidebar-footer {
  border-top: 1dp #3c3c434a;
}

.chat-shell--e2e .chat-header {
  background-color: #30b0c71f;
  border-left: 3dp #30b0c7;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.chat-shell--ai .chat-header {
  border-left: 3dp #5856d6;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.chat-shell--public .chat-header {
  border-left: 3dp #8e8e93;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.chat-shell--group .chat-header {
  border-left: 3dp #ff9500;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.prompt-composer--e2e .prompt-composer-pill {
  border-color: #30b0c71f;
}

.prompt-composer--disabled {
  opacity: 0.55;
}

.chat-secure-badge {
  color: #30b0c7;
}

.chat-shell--ai .chat-header-type-icon svg {
  image-color: #5856d6;
}

.chat-shell--private .chat-header-type-icon svg, .chat-shell--e2e .chat-header-type-icon svg {
  image-color: #30b0c7;
}

.chat-shell--public .chat-header-type-icon svg {
  image-color: #8e8e93;
}

.chat-shell--group .chat-header-type-icon svg {
  image-color: #ff9500;
}

.chat-peer-path--direct svg {
  image-color: #34c759;
}

.chat-peer-path--hop svg {
  image-color: #ff9500;
}

.chat-peer-path--relay svg {
  image-color: #8e8e93;
}

.chat-peer-path--connecting svg {
  image-color: #8e8e93;
}

.chat-peer-path--degraded svg {
  image-color: #ff9500;
}

.chat-peer-path--failed svg {
  image-color: #ff3b30;
}

.chat-peer-path--ready svg {
  image-color: #8e8e93;
}

.chat-header-call-btn, .chat-header-more-btn {
  background-color: #78788033;
  color: #000000;
}

.chat-header-call-btn:hover, .chat-header-more-btn:hover {
  background-color: #7878801f;
}

.chat-header-call-btn--join {
  background-color: #34c759;
  color: #ffffff;
}

.chat-header-call-btn--join:hover {
  background-color: #34c759;
}

.chat-header-call-btn svg, .chat-header-more-btn svg {
  image-color: #000000;
}

/* After the plain call button's rule (same specificity): white on the green join button. */
.chat-header-call-btn--join svg {
  image-color: #ffffff;
}

/* Phone chat nav bar: the header row sits on the bar's material; no type bar, tint or round buttons. */
.shell-chat-overlay .chat-panel .chat-header {
  background-color: transparent;
  border-left-width: 0;
}

.shell-chat-overlay .chat-header-call-btn,
.shell-chat-overlay .chat-header-more-btn {
  background-color: transparent;
}

.shell-chat-overlay .chat-header-call-btn svg,
.shell-chat-overlay .chat-header-more-btn svg {
  image-color: #007aff;
}

.shell-chat-overlay .chat-header-call-btn--join {
  background-color: #34c759;
}

.shell-chat-overlay .chat-header-call-btn--join svg {
  image-color: #ffffff;
}

/* A group call goes on here: the bar under the header. */
.chat-call-bar {
  background-color: #f2f2f7;
}

.chat-call-bar-dot {
  background-color: #34c759;
}

.chat-call-bar-text {
  color: #000000;
}

.chat-call-bar-join,
.chat-call-bar-join:hover,
.chat-call-bar-join:focus {
  background-color: transparent;
}

.shell-chat-overlay .chat-header-title {
  color: #000000;
}

.shell-chat-overlay .chat-header-subtitle,
.shell-chat-overlay .chat-header-phone-subtitle {
  color: #3c3c4399;
}

.shell-chat-overlay-chrome .shell-back-btn,
.shell-layer-compact .shell-transient-chrome .shell-back-btn {
  background-color: transparent;
}

.shell-chat-overlay-chrome .shell-back-btn svg,
.shell-layer-compact .shell-transient-chrome .shell-back-btn svg {
  image-color: #007aff;
}

.settings-choice-check {
  image-color: #007aff;
}

.context-menu-panel {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

/* Float menus (right-click / long-press): invisible hit target only — no dim.
   Compact action sheets keep a light scrim below. */
.context-menu-scrim {
  background-color: transparent;
}

.context-menu-layer--sheet .context-menu-scrim {
  background-color: #00000066;
}

/* The phone's small sheet: the page sheets' grouped background, handle, title and grey disc; a white card of rows
   with very faint hairlines, small icons in the secondary label colour, red for a destructive row. */
.context-menu-sheet {
  background-color: #f2f2f7;
}

.context-menu-sheet-grabber {
  background-color: #3c3c434c;
}

.context-menu-sheet-title {
  color: #000000;
}

.context-menu-sheet-disc {
  background-color: #7878801f;
}

.context-menu-sheet-disc svg {
  image-color: #3c3c4399;
}

.context-menu-sheet-list,
.context-menu-sheet-quick,
.context-menu-sheet-expand {
  background-color: #ffffff;
}


.context-menu-sheet-list .context-menu-item-body {
  border-top: 1dp #7878801f;
}

.context-menu-sheet-list .context-menu-item-icon svg {
  image-color: #3c3c4399;
}

.context-menu-sheet-list .context-menu-item-check {
  color: #007aff;
}

.context-menu-sheet-list .context-menu-item:active,
.context-menu-sheet-quick .context-menu-item:active {
  background-color: #7878801f;
}

.context-menu-item {
  color: #000000;
}

/* Phone pull-down (DESIGN-pp-ui 8.15 card + shadow); a hairline between rows, none above the first. */
.context-menu-layer--popover .context-menu-panel {
  background-color: #ffffff;
  box-shadow: 0 4dp 16dp #00000026;
}

.context-menu-layer--popover .context-menu-item {
  border-top: 1dp #3c3c434a;
}

.context-menu-layer--popover .context-menu-item:first-child {
  border-top-width: 0;
}

.context-menu-layer--popover .context-menu-item:active {
  background-color: #7878801f;
}

.context-menu-layer--popover .context-menu-item-icon svg {
  image-color: #000000;
}

.context-menu-layer--popover .context-menu-item--danger .context-menu-item-icon svg {
  image-color: #ff3b30;
}

.context-menu-item:hover {
  background-color: #7878801f;
}

.context-menu-item--danger {
  color: #ff3b30;
}

.context-menu-item--danger:hover {
  background-color: #7878801f;
}

.context-menu-item--danger svg,
.context-menu-sheet-list .context-menu-item--danger .context-menu-item-icon svg {
  image-color: #ff3b30;
}
/* ---- Phone chat window (UI refresh batch 3): date strips, in-bubble time, quotes, group names, composer. ---- */
.shell-chat-overlay .chat-date-pill,
.shell-chat-overlay .chat-system-line p {
  background-color: #7878801f;
  color: #3c3c4399;
}

.bubble-time {
  color: #3c3c4399;
}

.bubble-assistant .bubble-time {
  color: #3c3c4399;
}

.bubble-user .bubble-time {
  color: #ffffffd9;
}

.shell-chat-overlay .bubble-assistant .chat-quote {
  border-left: 3dp #007aff;
  background-color: #0000000f;
}

.shell-chat-overlay .bubble-user .chat-quote {
  border-left: 3dp #ffffff;
  background-color: #ffffff33;
}

.shell-chat-overlay .chat-attachment-card {
  background-color: #ffffff;
}

.shell-chat-overlay .message-row-user .chat-attachment-card,
.shell-chat-overlay .message-row-user .chat-voice-card {
  background-color: #2e8dff;
  color: #ffffff;
}

.shell-chat-overlay .message-row-user .chat-attachment-card .muted,
.shell-chat-overlay .message-row-user .chat-attachment-card .heading-3,
.shell-chat-overlay .message-row-user .chat-voice-time {
  color: #ffffff;
}

.shell-chat-overlay .message-row-user .chat-voice-play {
  background-color: #ffffff;
}

.shell-chat-overlay .message-row-user .chat-voice-play svg {
  image-color: #2e8dff;
}

.chat-reaction-row--overlay .chat-reaction-pill {
  border-color: #ffffff;
  background-color: #ffffff;
  color: #000000;
}

.shell-chat-overlay .chat-reaction-row--overlay .chat-reaction-pill {
  border-color: #ededed;
}

.chat-reaction-row--overlay .chat-reaction-chip--mine .chat-reaction-pill {
  background-color: #f2f2f7;
}

.shell-chat-overlay .chat-attachment-card .chat-suggestion {
  background-color: transparent;
  color: #007aff;
}

.shell-chat-overlay .chat-group-invite {
  background-color: #ffffff;
  color: #000000;
}

.shell-chat-overlay .chat-group-invite .chat-suggestion {
  border-top: 1dp #7878801f;
  background-color: transparent;
  color: #007aff;
}

.shell-chat-overlay .message-row-user .chat-attachment-card .chat-suggestion {
  color: #ffffff;
}

.shell-chat-overlay .bubble-tail-in {
  image-color: #ffffff;
}

.shell-chat-overlay .bubble-tail-out {
  image-color: #2e8dff;
}

/* The voice message bubble (components.rcss): received = the accent on the received bubble, own = white on the own one. */
.chat-voice-card {
  background-color: #ffffff;
  color: #000000;
}

.chat-voice-bar {
  background-color: #c7ccd4;
}

.chat-voice-bars--played .chat-voice-bar {
  background-color: #007aff;
}

.chat-voice-knob {
  background-color: #007aff;
}

.chat-voice-card .chat-voice-play svg {
  image-color: #007aff;
}

.chat-voice-badge {
  background-color: #007aff;
  border: 1.5dp #ffffff;
}

.chat-voice-badge-mic {
  image-color: #ffffff;
}

.shell-chat-overlay .message-row-user .chat-voice-card .chat-voice-play {
  background-color: transparent;
}

.shell-chat-overlay .message-row-user .chat-voice-card .chat-voice-play svg {
  image-color: #ffffff;
}

.shell-chat-overlay .message-row-user .chat-voice-card .chat-voice-bar {
  background-color: #ffffff80;
}

.shell-chat-overlay .message-row-user .chat-voice-card .chat-voice-bars--played .chat-voice-bar {
  background-color: #ffffff;
}

.shell-chat-overlay .message-row-user .chat-voice-card .chat-voice-knob {
  background-color: #ffffff;
}

.shell-chat-overlay .message-row-user .chat-voice-card .chat-voice-badge {
  background-color: #ffffff;
  border: 1.5dp #2e8dff;
}

.shell-chat-overlay .message-row-user .chat-voice-card .chat-voice-badge-mic {
  image-color: #2e8dff;
}

.shell-chat-overlay .message-row-user .chat-voice-fill {
  background-color: #ffffff;
}

.shell-chat-overlay .message-row-user .chat-audio-knob {
  background-color: #ffffff;
  border: 1dp rgba(0, 0, 0, 0.2);
}

/* A sound file's music card: the cover's placeholder square and note; on an own (blue) card, white 20%. The
   storage page's play / pause mark over a cover sits on a scrim. */
.chat-audio-cover {
  background-color: #7878801f;
}

.chat-audio-cover-note {
  image-color: #3c3c4399;
}

.message-row-user .chat-audio-cover {
  background-color: #ffffff33;
}

.message-row-user .chat-audio-cover-note {
  image-color: #ffffff;
}

.storage-file-type--cover .storage-audio-icon {
  background-color: #00000066;
}

.chat-group-name--0 { color: #0071ed; }
.chat-group-name--1 { color: #24883d; }
.chat-group-name--2 { color: #ad6500; }
.chat-group-name--3 { color: #ec002d; }
.chat-group-name--4 { color: #aa47dc; }
.chat-group-name--5 { color: #238192; }
.chat-group-name--6 { color: #5856d6; }
.chat-group-name--7 { color: #8c7251; }


.prompt-composer-label {
  color: #3c3c434c;
}

/* Phone composer (TODO #202): the pill is a floating card with a soft shadow, the microphone / Send button beside it an
   accent disc with the same shadow, white glyph. The plus is a flat glyph. */
.shell-chat-overlay .shell-composer-mount .prompt-composer-pill,
.ask-ai .prompt-composer-pill {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
  box-shadow: 0 2dp 10dp #00000029;
}

.shell-chat-overlay .prompt-composer-pill .prompt-attach-btn,
.ask-ai .prompt-composer-pill .prompt-attach-btn {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
  box-shadow: 0 2dp 10dp #00000029;
}

.shell-chat-overlay .prompt-emoji-btn .prompt-icon-home-emoji,
.ask-ai .prompt-emoji-btn .prompt-icon-home-emoji {
  background-color: #007aff1f;
  image-color: #007aff;
}

.shell-chat-overlay .prompt-composer-row .prompt-send-btn,
.shell-chat-overlay .prompt-composer-row .prompt-mic-btn,
.ask-ai .prompt-composer-row .prompt-send-btn {
  background-color: #007aff;
  box-shadow: 0 2dp 10dp #00000029;
}

/* Empty AI field (TODO #205): the same round slot, muted and flat. */
.shell-chat-overlay .prompt-composer-row .prompt-send-btn--idle,
.ask-ai .prompt-composer-row .prompt-send-btn--idle {
  background-color: #c7c7cc;
  box-shadow: none;
}

.shell-chat-overlay .prompt-send-disc,
.ask-ai .prompt-send-disc {
  background-color: transparent;
}

.shell-chat-overlay .prompt-icon-v2,
.shell-chat-overlay .prompt-icon-plus,
.ask-ai .prompt-icon-v2,
.ask-ai .prompt-icon-plus {
  image-color: #3c3c4399;
}

.shell-chat-overlay .prompt-mic-btn .prompt-icon-v2 {
  image-color: #ffffff;
}

/* The phone Home's box is the whole composer (the picture chip sits inside it); the pill in it is clear. */
.shell-layer-compact .home-composer-mount .prompt-composer {
  background-color: #f2f2f7;
  border: 1dp #3c3c434a;
  box-shadow: 0 2dp 8dp #00000026;
}

.shell-layer-compact .home-composer-mount .prompt-composer-pill {
  background-color: transparent;
  border-width: 0;
  box-shadow: none;
}

.shell-layer-compact .home-composer-mount .prompt-icon-home {
  image-color: #3c3c4399;
}

.shell-layer-compact .home-composer-mount .prompt-emoji-btn .prompt-icon-home-emoji {
  background-color: #007aff1f;
}

.shell-layer-compact .home-composer-mount .prompt-emoji-btn svg {
  image-color: #007aff;
}

.shell-layer-compact .home-composer-mount .prompt-composer-row .prompt-send-btn {
  background-color: transparent;
}

.shell-layer-compact .home-composer-mount .prompt-send-disc {
  background-color: #007aff;
}

.shell-layer-compact .home-composer-mount .prompt-send-btn--idle .prompt-send-disc {
  background-color: #c7c7cc;
}

/* Grouped lists on phones: Me tab and settings pages (DESIGN-pp-ui 8.7 / 8.10); geometry in components.rcss. */
.shell-layer-compact .settings-panel,
.shell-layer-compact .settings-detail-view {
  background-color: #f2f2f7;
}

.shell-layer-compact .settings-back-btn,
.shell-layer-compact .settings-back-btn:hover,
.shell-layer-compact .settings-back-btn:focus {
  background-color: transparent;
}

.shell-layer-compact .settings-back-v2 {
  image-color: #007aff;
}

.shell-layer-compact .group-id-btn {
  background-color: transparent;
}

.settings-q-btn,
.settings-q-btn:hover,
.settings-q-btn:focus {
  background-color: transparent;
}

.settings-q-btn:active {
  background-color: #7878801f;
}

.settings-q-icon {
  image-color: #007aff;
}

.shell-layer-compact .group-id-label {
  color: #3c3c4399;
}

.shell-layer-compact .settings-header-title,
.shell-layer-compact .me-card-name,
.shell-layer-compact .group-card-title,
.shell-layer-compact .group-title {
  color: #000000;
}

.shell-layer-compact .group-card {
  background-color: #ffffff;
}

.shell-layer-compact .group-row,
.shell-layer-compact .me-card-main {
  background-color: transparent;
  color: #000000;
}

.shell-layer-compact .group-row:active {
  background-color: #7878801f;
}

/* Separator above each row but the first (see the 1dp overlap in components.rcss). */
.shell-layer-compact .group-row-body {
  border-top: 1dp #3c3c434a;
}

.shell-layer-compact .group-row-text,
.shell-layer-compact .group-card .field,
.shell-layer-compact .group-note {
  color: #000000;
}

.shell-layer-compact .group-card .field,
.shell-layer-compact .cd-field {
  background-color: #f2f2f7;
}

.shell-layer-compact .group-field-hint {
  color: #3c3c4399;
}

.shell-layer-compact .group-row--static:active {
  background-color: transparent;
}

.shell-layer-compact .settings-label.group-row-text {
  color: #000000;
}

/* A row that does something rather than opens a page (About > Send problem logs): accent text, like iOS. */
.shell-layer-compact .settings-improve-send .group-row-text {
  color: #007aff;
}

.shell-layer-compact .group-row-sub,
.shell-layer-compact .group-row-value,
.shell-layer-compact .group-row .settings-choice-value-text,
.shell-layer-compact .group-head,
.shell-layer-compact .group-foot,
.shell-layer-compact .me-card-meta,
.shell-layer-compact .group-card .muted {
