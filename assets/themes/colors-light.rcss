.shell-page-sheet-grabber,
.emoji-sheet-grabber {
  background-color: #3c3c434c;
}

/* The composer's emoji sheet: the panel is the composer's colour behind the sheet's rounded top. */
.shell-emoji-keyboard-panel.surface-chrome {
  background-color: #f2f2f7;
  border-width: 0;
}

.shell-emoji-keyboard-sheet {
  background-color: #ffffff;
}

.emoji-sheet-header .sheet-title {
  color: #000000;
}

.emoji-sheet-close .sheet-icon-disc {
  background-color: #7878801f;
}

.emoji-sheet-close svg {
  image-color: #3c3c4399;
}

.shell-page-sheet .shell-page-sheet-close,
.shell-page-sheet .shell-page-sheet-close:hover,
.shell-page-sheet .shell-page-sheet-close:focus {
  background-color: transparent;
}

/* The sheets' title row: the title, and its buttons as a quiet grey disc with a secondary-colour icon. */
.shell-page-sheet .sheet-header .sheet-title {
  color: #000000;
}

.shell-page-sheet .sheet-icon-disc {
  background-color: #7878801f;
}

.ask-ai-open-chat svg {
  image-color: #3c3c4399;
}

/* The ask-AI panel (DEV/PLAN-ui-batch5-ask-ai.md 5a). */
.ask-ai-intro-body {
  color: #000000;
}

.ask-ai-privacy,
.ask-ai-picture-note,
.ask-ai-reminder,
.ask-ai-section,
.ask-ai-empty,
.ask-ai-error {
  color: #3c3c4399;
}

.ask-ai-open-chat,
.ask-ai-open-chat:hover,
.ask-ai-open-chat:focus,
.ask-ai-open-chat:active {
  background-color: transparent;
}

.ask-ai-intro-ok,
.ask-ai-intro-ok:hover,
.ask-ai-intro-ok:focus,
.ask-ai-intro-ok:active {
  color: #007aff;
  background-color: transparent;
}

.ask-ai-intro,
.ask-ai .bubble-assistant {
  background-color: #f2f2f7;
}

.ask-ai-support,
.ask-ai-support:hover,
.ask-ai-support:focus,
.ask-ai-support:active {
  color: #007aff;
  background-color: #007aff1f;
}

/* Phone AI dot and the Me → AI assistant look previews: full-colour art, drawn as it is (the dot's soft shadow, the
   third one DESIGN-pp-ui §6 allows, is drawn into its body SVG). */
.ai-dot svg,
.ai-look-art svg {
  image-color: #ffffff;
}

.ai-look-art {
  background-color: #f2f2f7;
  border-color: #f2f2f7;
}

.ai-look--on .ai-look-art {
  border-color: #007aff;
}

.ai-look-name {
  color: #3c3c4399;
}

.ai-look--on .ai-look-name {
  color: #007aff;
}

.ask-ai-picture-remove,
.ask-ai-picture-remove:hover,
.ask-ai-picture-remove:focus,
.ask-ai-picture-remove:active {
  background-color: transparent;
}

.ask-ai-picture-box {
  background-color: #7878801f;
}

.ask-ai-picture-remove svg {
  image-color: #3c3c4399;
}

.shell-page-sheet .people-picker-search-field {
  background-color: #f2f2f7;
}

.shell-page-sheet .people-picker-search-hint {
  color: #3c3c434c;
}

.shell-page-sheet .people-picker-row:hover,
.shell-page-sheet .people-picker-row--selected {
  background-color: transparent;
}

.shell-dialog.shell-pin-gate--frost {
  background-color: transparent;
}

.shell-dialog {
  background-color: #ffffff;
}

/* Checkboxes (B38): the colours were lost when this file became a template (they sat outside the theme block). */
input.checkbox {
  border-color: #8e8e93;
  background-color: transparent;
}

input.checkbox:hover,
input.checkbox:focus {
  border-color: #007aff;
}

input.checkbox:checked {
  border-color: #007aff;
  background-color: #007aff;
}

.shell-dialog-message {
  color: #000000;
}

/* Phone alert buttons (DESIGN-pp-ui §9): no pills, accent text, hairlines; a destructive confirm in the danger colour. */
.shell-body--compact .shell-dialog--alert .shell-dialog-actions .btn {
  background-color: transparent;
  color: #007aff;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions .btn:hover,
.shell-body--compact .shell-dialog--alert .shell-dialog-actions .btn:focus {
  background-color: #7878801f;
}

.shell-body--compact .shell-dialog--destructive .shell-dialog-actions .shell-dialog-ok {
  color: #ff3b30;
}

.shell-body--compact .shell-dialog--alert .shell-dialog-actions,
.shell-body--compact .shell-dialog--alert .shell-dialog-ok,
.shell-body--compact .shell-dialog--alert .shell-dialog-cancel {
  border-color: #3c3c434a;
}

.shell-call-meter-label {
  color: #3c3c4399;
}

.shell-call-meter-hint {
  color: #3c3c4399;
}

.shell-call-meter-seg {
