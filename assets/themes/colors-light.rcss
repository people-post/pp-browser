}

.sidebar-footer {
  border-top: 1dp #3c3c434a;
}

.chat-shell--e2e .chat-header {
  background-color: #30b0c71f;
  border-left: 3dp #30b0c7;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.chat-shell--ai .chat-header {
  border-left: 3dp #5856d6;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.chat-shell--public .chat-header {
  border-left: 3dp #8e8e93;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.chat-shell--group .chat-header {
  border-left: 3dp #ff9500;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.prompt-composer--e2e .prompt-composer-pill {
  border-color: #30b0c71f;
}

.prompt-composer--disabled {
  opacity: 0.55;
}

.chat-secure-badge {
  color: #30b0c7;
}

.chat-shell--ai .chat-header-type-icon svg {
  image-color: #5856d6;
}

.chat-shell--private .chat-header-type-icon svg, .chat-shell--e2e .chat-header-type-icon svg {
  image-color: #30b0c7;
}

.chat-shell--public .chat-header-type-icon svg {
  image-color: #8e8e93;
}

.chat-shell--group .chat-header-type-icon svg {
  image-color: #ff9500;
}

.chat-peer-path--direct svg {
  image-color: #34c759;
}

.chat-peer-path--hop svg {
  image-color: #ff9500;
}

.chat-peer-path--relay svg {
  image-color: #8e8e93;
}

.chat-peer-path--connecting svg {
  image-color: #8e8e93;
}

.chat-peer-path--degraded svg {
  image-color: #ff9500;
}

.chat-peer-path--failed svg {
  image-color: #ff3b30;
}

.chat-peer-path--ready svg {
  image-color: #8e8e93;
}

.chat-header-call-btn, .chat-header-more-btn {
  background-color: #78788033;
  color: #000000;
}

.chat-header-call-btn:hover, .chat-header-more-btn:hover {
  background-color: #7878801f;
}

.chat-header-call-btn--join {
  background-color: #34c759;
  color: #ffffff;
}

.chat-header-call-btn--join:hover {
  background-color: #34c759;
}

.chat-header-call-btn svg, .chat-header-more-btn svg {
  image-color: #000000;
}

/* After the plain call button's rule (same specificity): white on the green join button. */
.chat-header-call-btn--join svg {
  image-color: #ffffff;
}

/* Phone chat nav bar: the header row sits on the bar's material; no type bar, tint or round buttons. */
.shell-chat-overlay .chat-panel .chat-header {
  background-color: transparent;
  border-left-width: 0;
}

.shell-chat-overlay .chat-header-call-btn,
.shell-chat-overlay .chat-header-more-btn {
  background-color: transparent;
}

.shell-chat-overlay .chat-header-call-btn svg,
.shell-chat-overlay .chat-header-more-btn svg {
  image-color: #007aff;
}

.shell-chat-overlay .chat-header-call-btn--join {
  background-color: #34c759;
}

.shell-chat-overlay .chat-header-call-btn--join svg {
  image-color: #ffffff;
}

.shell-chat-overlay .chat-header-title {
  color: #000000;
}

.shell-chat-overlay .chat-header-subtitle {
  color: #3c3c4399;
}

.shell-chat-overlay-chrome .shell-back-btn,
.shell-layer-compact .shell-transient-chrome .shell-back-btn {
  background-color: transparent;
}

.shell-chat-overlay-chrome .shell-back-btn svg,
.shell-layer-compact .shell-transient-chrome .shell-back-btn svg {
  image-color: #007aff;
}

.context-menu-panel {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

/* Float menus (right-click / long-press): invisible hit target only — no dim.
   Compact action sheets keep a light scrim below. */
.context-menu-scrim {
  background-color: transparent;
}

.context-menu-layer--sheet .context-menu-scrim {
  background-color: #00000066;
}

.context-menu-sheet-list {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

.context-menu-sheet-cancel {
  background-color: #ffffff;
  color: #007aff;
  border: 1dp #3c3c434a;
}

.context-menu-sheet-cancel:hover {
  background-color: #7878801f;
}

.context-menu-item {
  color: #000000;
}

.context-menu-item:hover {
  background-color: #7878801f;
}

.context-menu-item--danger {
  color: #ff3b30;
}

.context-menu-item--danger:hover {
  background-color: #7878801f;
}

.context-menu-item--danger svg {
  image-color: #ff3b30;
}
/* ---- Phone chat window (UI refresh batch 3): date strips, in-bubble time, quotes, group names, composer. ---- */
.shell-chat-overlay .chat-date-pill,
.shell-chat-overlay .chat-system-line p {
  background-color: #7878801f;
  color: #3c3c4399;
}

.bubble-time {
