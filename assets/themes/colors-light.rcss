}

/* No shadow (DESIGN-pp-ui §6; a shadow here also drew a grey block on the simulator): a hairline keeps the white
   pill apart from a white page. */
.shell-body--compact .shell-toast {
  background-color: #ffffff;
  border-color: #3c3c434a;
  box-shadow: none;
}

