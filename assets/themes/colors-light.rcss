}

.cd-row {
  background-color: transparent;
  color: #000000;
}

.cd-row:active {
  background-color: #7878801f;
}

/* Separator above each row but the first: a row hidden by data-if at the end of a card leaves no stray line. */
.cd-row-body {
  border-top: 1dp #3c3c434a;
}

.cd-row-text,
.cd-field {
  color: #000000;
}

.cd-row--danger .cd-row-text {
  color: #ff3b30;
}

.cd-row-text--accent {
  color: #007aff;
}

.cd-chevron {
  image-color: #3c3c434c;
}

.sidebar-session-close:hover {
  background-color: #7878801f;
}

.bubble-peer {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

.working-set-long-list .chat-long-list-item {
