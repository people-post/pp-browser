  background-color: #007aff1f;
  color: #007aff;
}

.call-make-group svg {
  image-color: #007aff;
}

.call-group-offer {
  background-color: #78788033;
  color: #000000;
}

.call-group-offer-btn {
  background-color: #ffffff;
