  border: 1dp #3c3c434a;
  box-shadow: 0 2dp 8dp #00000026;
}

.chat-link {
  color: #007aff;
}

.chat-mention {
  color: #5856d6;
  background-color: #007aff1f;
}

/* In our own (blue) bubble the text stays white; only the chip shows. */
.bubble-user .chat-mention {
  color: #ffffff;
  background-color: #ffffff33;
}

/* A peer's message that mentions this account: the whole row is tinted, with a bar on its left. */
.message-row-mentions-me {
  background-color: #fff4e0;
  border-left: 3dp #ff9500;
}

/* The row a jump landed on (tapped quote, search hit, mention): see-through amber, wins over the mention tint. */
.message-row.message-row-jump-target {
  background-color: #ffc40038;
}

/* Search inside the chat: the matching text is marked, pale yellow; the hit the search is on, deeper. */
.search-mark {
  background-color: #fff4e0;
}

.search-mark-current {
  background-color: #ff9500;
}

/* In our own (blue) bubble the text is white: dark on the mark, so it stays readable. */
.bubble-user .search-mark {
  color: #000000;
}

.chat-search-cancel {
  color: #000000;
}

.chat-search-count {
  color: #3c3c4399;
}

.chat-search-step svg {
  image-color: #8e8e93;
}

/* On the tinted row the text sits on the tint: no bubble of its own. */
.message-row-mentions-me .bubble-assistant {
  background-color: transparent;
  border-width: 0;
}

