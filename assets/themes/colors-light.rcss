}

.shell-nav-tab--active {
  background-color: #007aff1f;
  color: #007aff;
}

.shell-nav-tab--active svg {
  image-color: #007aff;
}

/* Phone tab bar: selection is a colour change only, no tint. */
.shell-nav-rail--compact .shell-nav-tab:hover,
.shell-nav-rail--compact .shell-nav-tab--active {
  background-color: transparent;
}

/* Phone two-word tab bar (DEV/PLAN-minimal-nav.md A): grey words, the chosen one in the label colour. The bar itself is
   the bottom chrome's material: 78% bar colour over a blur with Transparency on, solid with it off. */
.shell-nav-rail--text .shell-nav-tab {
  color: #8e8e93;
}

.shell-nav-rail--text .shell-nav-tab--active {
  color: #000000;
}

.shell-nav-rail--text .shell-nav-tab--active .shell-nav-tab-text-wrap {
  background-color: #7878801f;
}

.shell-chat-overlay {
  background-color: #ededed;
}

.shell-chat-overlay-chrome {
  background-color: #f2f2f7;
}

.shell-chat-overlay .shell-chat-overlay-chrome.surface-chrome,
.shell-chat-overlay .shell-chat-overlay-chrome.surface-chrome--frost {
  background-color: transparent;
  border-width: 0;
}

/* The chat header's and the composer's material: the bar colour, see-through and blurred on the frosted surface. */
.bar-material {
  background-color: #f2f2f7;
}

.bar-material--frost {
  background-color: #f2f2f7c7;
}

/* Phone bars: no hairlines; a fade from the bar colour to clear under a top bar, and over the tab bar and the
   composer. Solid bars fade from x-bar, frosted ones from x-bar-blur. */
.bar-fade {
  decorator: linear-gradient(to bottom, #f2f2f7, #f2f2f700);
}

.bar-fade--up {
  decorator: linear-gradient(to bottom, #f2f2f700, #f2f2f7);
}

.shell-nav-page--frost .pane-nav .bar-fade,
.shell-nav-page--frost .settings-detail-header .bar-fade,
.surface-chrome--frost .bar-fade {
  decorator: linear-gradient(to bottom, #f2f2f7c7, #f2f2f700);
}

.shell-bottom-chrome--frost .bar-fade--up {
  decorator: linear-gradient(to bottom, #f2f2f700, #f2f2f7c7);
}

.shell-layer-compact .settings-detail-header {
  background-color: #f2f2f7;
}

.shell-nav-page--frost .settings-detail-header {
  background-color: #f2f2f7c7;
}

/* A pushed page's bar: itself clear; its material child (.nav-bar-bg, shown once content is under the bar) is the bar
   colour, frosted with Transparency on, solid with it off. */
.shell-layer-compact .nav-bar-host .settings-detail-header,
.shell-layer-transient.shell-layer-compact.nav-bar-host .shell-transient-chrome {
  background-color: transparent;
}

.nav-bar-bg {
  background-color: #f2f2f7;
}

.shell-nav-page--frost .nav-bar-host .nav-bar-bg,
.shell-layer-transient.nav-bar-host .surface-chrome--frost .nav-bar-bg {
