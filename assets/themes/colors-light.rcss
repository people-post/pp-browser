}

.shell-nav-rail--compact {
  border-right: 0;
  border-top: 0;
  background-color: transparent;
}


.shell-nav-tab {
  background-color: transparent;
  color: #8e8e93;
}

.shell-nav-tab svg {
  image-color: #8e8e93;
}

.shell-nav-tab:hover {
