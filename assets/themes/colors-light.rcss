/* GENERATED by scripts/ui/gen_theme_colors.py from theme_tokens.tsv + colors.rcss.tmpl — do not edit by hand */
@media (theme: light) {
body {
  color: #000000;
  background-color: #ffffff;
}

/* The same as the body it covers: nothing changes until a bar slides under it. */
.shell-statusbar-strip {
  background-color: #ffffff;
}

/* Phones: the strip takes the colour of the page under it (ShellHost::ApplySafeAreaLayout picks the surface). */
.shell-statusbar-strip.shell-statusbar-strip--home {
  background-color: #ffffff;
}

.shell-statusbar-strip.shell-statusbar-strip--me,
.shell-statusbar-strip.shell-statusbar-strip--new_chat {
  background-color: #f2f2f7;
}

/* The home-indicator band under the grouped Me pages; clear elsewhere. New chat's list scrolls under the frosted bar
   and under the home indicator alike (Kenneth 2026-11-09: the opaque band there broke the frosted look). */
.shell-home-indicator-strip.shell-home-indicator-strip--me {
  background-color: #f2f2f7;
}

.shell-statusbar-strip.shell-statusbar-strip--add_contact {
  background-color: #f2f2f7;
}

/* Monochrome icons are white sources; tint with image-color (does not inherit). */
svg {
  image-color: #000000;
}

selection {
  background-color: #007aff1f;
}

.bubble-user selection {
  background-color: #ffffff33;
}

.bubble-assistant selection {
  background-color: #007aff1f;
}

.prompt-composer-input selection {
  background-color: #007aff1f;
}

.shell-dialog-prompt {
  background-color: #f2f2f7;
  border-color: #3c3c434a;
}

.shell-dialog-prompt:focus {
  border-color: #007aff;
}

.prompt-composer-input scrollbarvertical sliderbar {
  background-color: #00000040;
}

.chat-form-field selection {
  background-color: #007aff1f;
}

.text {
  color: #000000;
}

.heading-1 {
  color: #000000;
}

.heading-2 {
  color: #000000;
}

.heading-3 {
  color: #000000;
}

.btn-primary, .prompt-send-btn, .prompt-stop-btn, .sidebar-new-chat, .contacts-find-btn, .chat-suggestion-primary {
  background-color: #007aff;
  color: #ffffff;
}

.btn-primary:hover, .btn-primary:focus, .prompt-send-btn:hover, .prompt-stop-btn:hover, .sidebar-new-chat:hover, .contacts-find-btn:hover, .chat-suggestion-primary:hover {
  background-color: #007aff;
}

.btn-primary svg, .prompt-send-btn svg, .prompt-stop-btn svg, .sidebar-new-chat svg, .contacts-find-btn svg, .contacts-action-secure svg {
  image-color: #ffffff;
}

.prompt-voice-toggle-btn svg {
  image-color: #8e8e93;
}

.prompt-voice-toggle-btn:hover svg {
  image-color: #000000;
}

.prompt-voice-bar {
  background-color: #7878801f;
  color: #000000;
}

.prompt-voice-bar:hover {
  background-color: #7878801f;
}

.prompt-voice-bar--active, .prompt-voice-bar--active:hover {
  background-color: #ff3b30;
  color: #ffffff;
}

.prompt-emoji-btn svg {
  image-color: #8e8e93;
}

.prompt-emoji-btn:hover svg {
  image-color: #000000;
}

.prompt-attach-btn svg {
  image-color: #8e8e93;
}

.prompt-attach-btn:hover svg {
  image-color: #000000;
}

.prompt-capture-btn svg {
  image-color: #8e8e93;
}

.prompt-capture-btn:hover svg {
  image-color: #000000;
}

.prompt-attachment-chip-remove svg {
  image-color: #8e8e93;
}

.prompt-attachment-chip-remove:hover svg {
  image-color: #000000;
}

.btn-secondary, .chat-suggestion {
  background-color: #007aff1f;
  color: #007aff;
}

.btn-secondary:hover, .btn-secondary:focus, .chat-suggestion:hover {
  background-color: #007aff1f;
}

.btn-danger {
  background-color: #ff3b30;
  color: #ffffff;
}

.btn-danger:hover, .btn-danger:focus {
  background-color: #ff3b30;
}

.btn-danger-soft {
  background-color: #7878801f;
  color: #ff3b30;
  border: 1dp #3c3c434a;
}

.btn-danger-soft:hover, .btn-danger-soft:focus {
  background-color: #78788033;
  color: #ff3b30;
  border: 1dp #ff3b30;
}

.btn-danger svg {
  image-color: #ffffff;
}

.btn-danger-soft svg {
  image-color: #ff3b30;
}

.btn-danger-soft:hover svg, .btn-danger-soft:focus svg {
