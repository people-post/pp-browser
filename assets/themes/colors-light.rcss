}

.btn-ghost {
  background-color: transparent;
  color: #000000;
}

.btn-ghost:hover, .btn-ghost:focus {
  background-color: #7878801f;
  color: #000000;
}

.field {
  background-color: #f2f2f7;
  color: #000000;
  border: 1dp #3c3c434a;
}

select selectbox {
  background-color: #f2f2f7;
  border: 1dp #3c3c434a;
}

select selectbox option:hover {
  background-color: #7878801f;
}

.card {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

.error {
  color: #ff3b30;
}

/* "This message was deleted": a shade lighter than .muted (two classes, so it wins over .muted). */
.bubble-deleted .bubble-deleted-text {
  color: #3c3c434c;
}

.muted {
  color: #3c3c4399;
}

.bubble-user {
  background-color: #2e8dff;
  color: #ffffff;
}

/* Call rows: ours like our bubbles, theirs like theirs. Icons are white sources tinted with image-color. */
.message-row-user .chat-call-row {
  background-color: #2e8dff;
  color: #ffffff;
}

.message-row-user .chat-call-row svg {
  image-color: #ffffff;
}

.message-row-user .chat-call-row.muted {
  background-color: #a3b3f9;
}

.message-row-peer .chat-call-row {
  background-color: #ffffff;
}

.message-row-peer .chat-call-row svg {
  image-color: #000000;
}

.bubble-text {
  color: #ffffff;
}

.bubble-assistant {
  background-color: #ffffff;
  border: 1dp #3c3c434a;
}

.bubble-assistant h1, .bubble-assistant h2, .bubble-assistant h3 {
  color: #000000;
}

.bubble-assistant p, .bubble-assistant li {
  color: #000000;
}

.prompt-composer-pill {
  background-color: #f2f2f7;
  border: 1dp #3c3c434a;
  box-shadow: 0 2dp 8dp #00000026;
}

.chat-link {
  color: #007aff;
}

.chat-mention {
  color: #5856d6;
  background-color: #007aff1f;
}

/* In our own (blue) bubble the text stays white; only the chip shows. */
.bubble-user .chat-mention {
  color: #ffffff;
  background-color: #ffffff33;
}

/* A peer's message that mentions this account: the whole row is tinted, with a bar on its left. */
.message-row-mentions-me {
  background-color: #fff4e0;
  border-left: 3dp #ff9500;
}

/* The row a jump landed on (tapped quote, search hit, mention): see-through amber, wins over the mention tint. */
.message-row.message-row-jump-target {
  background-color: #ffc40038;
}

/* Search inside the chat: the matching text is marked, pale yellow; the hit the search is on, deeper. */
.search-mark {
  background-color: #fff4e0;
}

.search-mark-current {
  background-color: #ff9500;
}

/* In our own (blue) bubble the text is white: dark on the mark, so it stays readable. */
.bubble-user .search-mark {
  color: #000000;
}

.chat-search-cancel {
  color: #000000;
}

.chat-search-count {
  color: #3c3c4399;
}

.chat-search-step svg {
  image-color: #8e8e93;
}

/* On the tinted row the text sits on the tint: no bubble of its own. */
.message-row-mentions-me .bubble-assistant {
  background-color: transparent;
  border-width: 0;
}

.chat-inline-link {
  color: #007aff;
}

.inline-code {
  background-color: #7878801f;
}

.code-block {
  background-color: #f2f2f7;
