}

.shell-layer-compact .group-icon--accent { background-color: #007aff; }
.shell-layer-compact .group-icon--success { background-color: #34c759; }
.shell-layer-compact .group-icon--orange { background-color: #ff9500; }
.shell-layer-compact .group-icon--purple { background-color: #af52de; }
.shell-layer-compact .group-icon--teal { background-color: #30b0c7; }
.shell-layer-compact .group-icon--indigo { background-color: #5856d6; }
.shell-layer-compact .group-icon--gray { background-color: #8e8e93; }

.shell-layer-compact .me-card-avatar .avatar-letter {
