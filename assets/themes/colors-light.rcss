}

.shell-layer-compact .contacts-row-body {
  border-bottom: 1dp #3c3c434a;
}

.shell-layer-compact .contacts-row:last-of-type .contacts-row-body {
  border-bottom-color: transparent;
}

.shell-layer-compact .contacts-row-title {
  color: #000000;
}

.shell-layer-compact .contact-detail-panel {
  background-color: #f2f2f7;
}

.cd-account,
.contacts-row-subtitle--phone,
.cd-footnote,
.cd-row-value {
