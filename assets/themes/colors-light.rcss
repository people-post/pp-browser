}

.chat-group-name--0 { color: #007aff; }
.chat-group-name--1 { color: #34c759; }
.chat-group-name--2 { color: #ff9500; }
.chat-group-name--3 { color: #ff2d55; }
.chat-group-name--4 { color: #af52de; }
.chat-group-name--5 { color: #30b0c7; }
.chat-group-name--6 { color: #5856d6; }
.chat-group-name--7 { color: #a2845e; }

