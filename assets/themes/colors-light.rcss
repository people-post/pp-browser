  color: #000000;
}

.cd-row:active {
  background-color: #7878801f;
}

.cd-row--static:active {
  background-color: transparent;
}

/* Separator above each row but the first: a row hidden by data-if at the end of a card leaves no stray line. */
.cd-row-body {
  border-top: 1dp #3c3c434a;
}

.cd-row-text,
.cd-field {
