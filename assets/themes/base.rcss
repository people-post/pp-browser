body {
  font-family: LatoLatin;
  font-size: 16dp;
  color: #e8e8e8;
  background-color: #1a1a2e;
  padding: 24dp;
}

h1 {
  font-size: 28dp;
  margin-bottom: 12dp;
  color: #ffffff;
}

p {
  margin-bottom: 8dp;
  color: #c8c8d8;
}

button, input, textarea, select {
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  background-color: #2d2d44;
  color: #e8e8e8;
  border: 1dp #4a4a6a;
}

button {
  cursor: pointer;
  background-color: #4a6cf7;
  border: 0;
  color: #ffffff;
}

button:hover {
  background-color: #5a7cff;
}

input, textarea, select {
  width: 100%;
  margin-bottom: 8dp;
}

.stack {
  display: block;
}

.row {
  display: flex;
  flex-direction: row;
  gap: 8dp;
}

.gap-sm {
  margin-bottom: 8dp;
}

.card {
  padding: 16dp;
  background-color: #252538;
  border-radius: 8dp;
  border: 1dp #3a3a55;
  margin-bottom: 12dp;
}

.error {
  color: #ff6b6b;
}

.muted {
  color: #8888a0;
}

.chat-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
}

.chat-shell {
  position: absolute;
  top: 16dp;
  left: 16dp;
  right: 16dp;
  bottom: 16dp;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  max-width: 800dp;
  margin-left: auto;
  margin-right: auto;
}

.chat-header {
  flex-shrink: 0;
  box-sizing: border-box;
  margin-bottom: 12dp;
}

.chat-header h1 {
  margin-bottom: 4dp;
}

.messages {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  overflow-y: auto;
  margin-bottom: 12dp;
  padding-left: 8dp;
  padding-right: 8dp;
}

.message-group {
  display: block;
}

.message-row {
  display: block;
  margin-bottom: 12dp;
}

.message-row-user {
  text-align: right;
}

.message-row-assistant {
  text-align: left;
}

.bubble {
  padding: 12dp 16dp;
  border-radius: 12dp;
  text-align: left;
  box-sizing: border-box;
}

.bubble-user {
  display: inline-block;
  max-width: 680dp;
  background-color: #4a6cf7;
  color: #ffffff;
  focus: none;
}

.bubble-user p {
  margin-bottom: 0;
  color: #ffffff;
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble-assistant {
  display: inline-block;
  max-width: 680dp;
  background-color: #252538;
  border: 1dp #3a3a55;
  focus: none;
}

.bubble-assistant ul,
.bubble-assistant ol {
  box-sizing: border-box;
}

.bubble-assistant p,
.bubble-assistant li,
.bubble-assistant .code-block {
  word-break: break-word;
}

.bubble-assistant p:last-child,
.bubble-assistant .stack p:last-child {
  margin-bottom: 0;
}

.bubble-assistant h1,
.bubble-assistant h2,
.bubble-assistant h3 {
  margin-top: 0;
  color: #ffffff;
}

.bubble-assistant p,
.bubble-assistant li {
  color: #c8c8d8;
}

.thinking {
  margin-bottom: 0;
}

.input-row {
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 8dp;
}

.input-row textarea {
  flex: 1;
  margin-bottom: 0;
  min-height: 56dp;
}

.input-row button {
  flex-shrink: 0;
  width: auto;
  margin-bottom: 0;
}

.code-block {
  font-family: LatoLatin;
  font-size: 13dp;
  background-color: #1a1a2e;
  padding: 8dp 12dp;
  border-radius: 6dp;
  margin-top: 4dp;
  margin-bottom: 8dp;
  white-space: pre-wrap;
}

.bubble-assistant .chat-suggestion {
  display: inline-block;
  width: auto;
  font-size: 13dp;
  padding: 6dp 12dp;
  margin-top: 4dp;
  margin-right: 8dp;
  margin-bottom: 4dp;
  border-radius: 16dp;
  background-color: #3a3a55;
  color: #e8e8e8;
  cursor: pointer;
  focus: none;
}

.bubble-assistant .chat-suggestion:hover {
  background-color: #4a4a6a;
}
