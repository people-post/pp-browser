body {
  font-family: LatoLatin;
  font-size: 16dp;
  color: #1a1a1a;
  background-color: #f8f9fb;
  padding: 24dp;
}

selection {
  background-color: #b4d5fe;
}

.bubble-user selection {
  background-color: #ffffff55;
}

.bubble-assistant selection {
  background-color: #b4d5fe;
}

.prompt-composer-input selection {
  background-color: #b4d5fe;
}

.chat-form-field selection {
  background-color: #b4d5fe;
}

.text {
  display: block;
  margin-top: 0;
  margin-bottom: 8dp;
  color: #333333;
}

.heading-1 {
  display: block;
  font-size: 28dp;
  margin-top: 0;
  margin-bottom: 12dp;
  color: #111111;
}

.heading-2 {
  display: block;
  font-size: 20dp;
  margin-top: 0;
  margin-bottom: 8dp;
  color: #111111;
}

.heading-3 {
  display: block;
  font-size: 16dp;
  margin-top: 0;
  margin-bottom: 8dp;
  color: #111111;
}

.btn {
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  border: 0;
  cursor: pointer;
  margin-bottom: 0;
  width: auto;
  display: inline-block;
}

.btn-primary {
  background-color: #4a6cf7;
  color: #ffffff;
}

.btn-primary:hover {
  background-color: #5a7cff;
}

.btn-secondary {
  background-color: #e8eaed;
  color: #1a1a1a;
}

.field {
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  background-color: #ffffff;
  color: #1a1a1a;
  border: 1dp #d1d5db;
  width: 100%;
  margin-bottom: 8dp;
  box-sizing: border-box;
  display: block;
}

.stack {
  display: block;
}

.row {
  display: flex;
  flex-direction: row;
  gap: 8dp;
}

.gap-sm {
  margin-bottom: 8dp;
}

.card {
  padding: 16dp;
  background-color: #ffffff;
  border-radius: 8dp;
  border: 1dp #e5e7eb;
  margin-bottom: 12dp;
}

.error {
  display: block;
  margin-top: 0;
  margin-bottom: 8dp;
  color: #dc2626;
}

.muted {
  color: #6b7280;
}

.chat-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
}

.chat-shell {
  position: absolute;
  top: 16dp;
  left: 16dp;
  right: 16dp;
  bottom: 16dp;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  max-width: 800dp;
  margin-left: auto;
  margin-right: auto;
}

.chat-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12dp;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-bottom: 12dp;
}

.chat-header-main {
  flex: 1;
  min-width: 0;
}

.chat-header-title {
  font-size: 22dp;
  margin-bottom: 4dp;
}

.chat-preview-btn {
  flex-shrink: 0;
  margin-top: 2dp;
}

.messages {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  overflow-y: auto;
  overflow-x: hidden;
  margin-bottom: 12dp;
  padding-left: 8dp;
  padding-right: 8dp;
}

.message-group {
  display: block;
}

.message-row {
  display: block;
  margin-bottom: 12dp;
}

.message-row-user {
  text-align: right;
}

.message-row-assistant {
  text-align: left;
}

.bubble {
  padding: 10dp 14dp;
  border-radius: 12dp;
  text-align: left;
  box-sizing: border-box;
}

.bubble-user {
  display: inline-block;
  max-width: 680dp;
  background-color: #4a6cf7;
  color: #ffffff;
  focus: none;
}

.bubble-text {
  margin-top: 0;
  margin-bottom: 0;
  color: #ffffff;
  white-space: pre-wrap;
  word-break: break-word;
}

.assistant-message {
  display: block;
}

.bubble-assistant {
  display: inline-block;
  max-width: 680dp;
  background-color: #f3f4f6;
  border: 1dp #e5e7eb;
  focus: none;
}

.suggestion-row {
  display: block;
  margin-top: 8dp;
}

.bubble-assistant ul,
.bubble-assistant ol {
  box-sizing: border-box;
}

.bubble-assistant p,
.bubble-assistant li,
.bubble-assistant .code-block {
  word-break: break-word;
}

.bubble-assistant p:last-child,
.bubble-assistant .stack p:last-child {
  margin-bottom: 0;
}

.bubble-assistant h1,
.bubble-assistant h2,
.bubble-assistant h3 {
  margin-top: 0;
  color: #111111;
}

.bubble-assistant p,
.bubble-assistant li {
  color: #333333;
}

.thinking {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
}

.prompt-composer {
  flex-shrink: 0;
  box-sizing: border-box;
  margin: 0 12dp 12dp 12dp;
  padding: 12dp;
  background-color: #ffffff;
  border-radius: 12dp;
  border: 1dp #e5e7eb;
  box-shadow: 0 2dp 8dp #00000014;
}

.prompt-composer-input {
  width: 100%;
  min-height: 40dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
}

.prompt-composer-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8dp;
  gap: 8dp;
}

.prompt-composer-leading {
  flex: 1;
  min-width: 0;
}

.prompt-send-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 18dp;
  font-family: LatoLatin;
  background-color: #4a6cf7;
  color: #ffffff;
  cursor: pointer;
}

.prompt-send-btn:hover {
  background-color: #5a7cff;
}

.prompt-send-btn svg {
  flex-shrink: 0;
}

.code-block {
  font-family: LatoLatin;
  font-size: 13dp;
  background-color: #eef0f3;
  color: #1a1a1a;
  padding: 8dp 12dp;
  border-radius: 6dp;
  margin-top: 4dp;
  margin-bottom: 8dp;
  white-space: pre-wrap;
}

.chat-suggestion {
  display: inline-block;
  width: auto;
  font-family: LatoLatin;
  font-size: 13dp;
  padding: 6dp 12dp;
  margin-right: 8dp;
  margin-bottom: 4dp;
  border: 0;
  border-radius: 16dp;
  background-color: #e8eaed;
  color: #1a1a1a;
  cursor: pointer;
  focus: none;
}

.chat-suggestion:hover {
  background-color: #d8dce2;
}

.suggestion-row .chat-suggestion {
  margin-top: 0;
}

.bubble-assistant .chat-suggestion {
  margin-top: 8dp;
}

.chat-form {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border: 1dp #d1d5db;
  border-radius: 8dp;
  background-color: #ffffff;
}

.chat-form-label {
  display: block;
  margin-bottom: 8dp;
  color: #333333;
}

.chat-form-field {
  display: block;
  width: 100%;
  margin-top: 4dp;
  margin-bottom: 0;
  box-sizing: border-box;
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  background-color: #ffffff;
  color: #1a1a1a;
  border: 1dp #d1d5db;
}

.chat-form-submit {
  display: inline-block;
  width: auto;
  margin-top: 8dp;
  padding: 8dp 16dp;
  border-radius: 8dp;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  background-color: #4a6cf7;
  color: #ffffff;
  cursor: pointer;
  focus: none;
}

.chat-form-submit:hover {
  background-color: #3f5ee0;
}

.chat-form-expired {
  opacity: 0.85;
}

.chat-form-expired .chat-form-field,
.chat-form-expired .chat-form-submit {
  pointer-events: none;
  opacity: 0.6;
}

.chat-form-expired .chat-form-submit {
  display: none;
}

.chat-form-expired-label {
  margin-top: 0;
  margin-bottom: 8dp;
}

.chat-card {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border: 1dp #d1d5db;
  border-radius: 8dp;
  background-color: #ffffff;
}

.chat-card-highlight {
  border-color: #4a6cf7;
  background-color: #f5f7ff;
}

.chat-table {
  width: 100%;
  margin-top: 12dp;
  border-collapse: collapse;
}

.chat-table th,
.chat-table td {
  padding: 6dp 8dp;
  border: 1dp #d1d5db;
  text-align: left;
}

.chat-key-value {
  display: block;
  margin-top: 12dp;
}

.chat-key-value-row {
  display: flex;
  justify-content: space-between;
  gap: 12dp;
  padding: 4dp 0;
}

.chat-key-value-label {
  color: #666666;
}

.chat-callout {
  display: block;
  margin-top: 12dp;
  padding: 10dp 12dp;
  border-radius: 8dp;
  background-color: #eef2ff;
}

.chat-callout-warning {
  background-color: #fff7ed;
}

.chat-quote {
  display: block;
  margin-top: 12dp;
  padding-left: 12dp;
  border-left: 3dp #d1d5db;
}

.chat-action-list,
.chat-long-list,
.chat-choice,
.chat-poll {
  display: block;
  margin-top: 12dp;
}

.chat-long-list-scroll {
  max-height: 240dp;
  overflow-y: auto;
  padding: 8dp;
  margin-top: 8dp;
  background-color: #ffffff;
  border-radius: 6dp;
  border: 1dp #e5e7eb;
  box-sizing: border-box;
}

.chat-long-list-item {
  display: block;
  margin-bottom: 12dp;
  padding-bottom: 10dp;
  border-bottom: 1dp #e5e7eb;
}

.chat-long-list-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
}

.chat-long-list-title {
  margin-bottom: 4dp;
}

.chat-long-list-subtitle,
.chat-long-list-meta {
  margin-bottom: 4dp;
  font-size: 13dp;
}

.chat-long-list-actions,
.chat-long-list-footer {
  gap: 8dp;
  flex-wrap: wrap;
  margin-top: 6dp;
}

.chat-action-list-item {
  display: block;
  margin-bottom: 10dp;
}

.chat-action-list-actions,
.chat-choice-options,
.chat-poll-options {
  gap: 8dp;
  flex-wrap: wrap;
}

.chat-calendar {
  display: block;
  margin-top: 12dp;
  padding: 12dp;
  border: 1dp #d1d5db;
  border-radius: 8dp;
  background-color: #ffffff;
}

.calendar-header {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8dp;
}

.calendar-nav {
  display: inline-block;
  padding: 6dp 12dp;
  border: 0;
  border-radius: 6dp;
  font-family: LatoLatin;
  font-size: 14dp;
  background-color: #4a6cf7;
  color: #ffffff;
  cursor: pointer;
  focus: none;
}

.calendar-nav:hover {
  background-color: #3f5ee0;
}

.calendar-weekdays {
  justify-content: space-between;
  margin-bottom: 4dp;
  color: #666666;
}

.calendar-weekdays span {
  width: 14%;
  text-align: center;
}

.calendar-grid {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}

.calendar-cell {
  text-align: center;
  padding: 2dp;
  vertical-align: middle;
}

.calendar-day {
  display: inline-block;
  width: 100%;
  min-height: 28dp;
  padding: 4dp 0;
  border-radius: 6dp;
  border: 0;
  text-align: center;
  box-sizing: border-box;
  font-family: LatoLatin;
  font-size: 14dp;
  background-color: #4a6cf7;
  color: #ffffff;
  cursor: pointer;
  focus: none;
}

.calendar-day:hover {
  background-color: #3f5ee0;
}

.calendar-day-muted {
  display: inline-block;
  width: 100%;
  min-height: 28dp;
  padding: 4dp 0;
  border-radius: 6dp;
  text-align: center;
  box-sizing: border-box;
  background-color: transparent;
  color: #888888;
  cursor: default;
}

.dynamic-demo-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
}

.dynamic-demo-shell {
  position: absolute;
  top: 16dp;
  left: 16dp;
  right: 16dp;
  bottom: 16dp;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fb;
  padding: 16dp;
  border-radius: 8dp;
  box-sizing: border-box;
}

.dynamic-demo-header {
  flex-shrink: 0;
  margin-bottom: 12dp;
}

.dynamic-toolbar {
  flex-shrink: 0;
  margin-bottom: 12dp;
}

.dynamic-toolbar .btn {
  margin-bottom: 0;
}

.dynamic-status {
  flex-shrink: 0;
  margin-bottom: 8dp;
  color: #15803d;
}

.dynamic-mount-target {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.dynamic-panel {
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.dynamic-panel-title {
  margin-top: 0;
}

.scroll-list {
  flex: 1;
  min-height: 120dp;
  max-height: 220dp;
  overflow-y: auto;
  padding: 8dp;
  background-color: #ffffff;
  border-radius: 6dp;
  border: 1dp #e5e7eb;
  box-sizing: border-box;
}

.dynamic-panel-b .scroll-list {
  background-color: #f3f4f6;
}

.shell-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
  margin: 0;
}

.shell-chrome {
  position: relative;
  z-index: 100;
}

.shell-root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8dp;
  padding: 8dp 12dp;
  background-color: #fef3c7;
  border-bottom: 1dp #fcd34d;
  color: #92400e;
}

.shell-banner-text {
  flex: 1;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  color: #92400e;
}

.shell-banner-dismiss {
  width: auto;
  min-width: 32dp;
  padding: 4dp 10dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  border-radius: 6dp;
  cursor: pointer;
  background-color: #fde68a;
  color: #92400e;
}

.shell-toast-stack {
  position: absolute;
  top: 8dp;
  right: 12dp;
  z-index: 110;
}

.shell-toast {
  padding: 10dp 14dp;
  margin-bottom: 8dp;
  border-radius: 8dp;
  background-color: #1f2937;
  color: #ffffff;
  box-shadow: 0 2dp 8dp #00000033;
}

.shell-toast-text {
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  color: #ffffff;
}

.shell-activity-strip {
  height: 3dp;
  background-color: #4a6cf7;
  opacity: 0.85;
}

.shell-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-pane-row {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.shell-pane {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
  background-color: #f8f9fb;
}

.shell-pane-secondary {
  flex: 0 0 240dp;
  border-right: 1dp #e5e7eb;
}

.shell-pane-primary {
  flex: 1;
}

.shell-pane-auxiliary {
  flex: 0 0 320dp;
  border-left: 1dp #e5e7eb;
}

.shell-layer-compact {
  display: flex;
  flex-direction: column;
}

.shell-pane-primary-compact {
  flex: 1;
  min-height: 0;
}

.shell-pane-composer {
  flex-shrink: 0;
}

.shell-bottom-chrome {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fb;
  z-index: 15;
}

.shell-composer-mount {
  flex-shrink: 0;
}

.shell-composer-mount .prompt-composer {
  margin-bottom: 8dp;
}

.shell-drawer .shell-pane,
.shell-sheet .shell-pane {
  height: 100%;
}

.shell-pane-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.shell-drawer-scrim,
.shell-sheet-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #00000066;
  z-index: 20;
  focus: none;
}

.shell-drawer {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 280dp;
  max-width: 85%;
  background-color: #f8f9fb;
  z-index: 21;
  box-shadow: 2dp 0 12dp #00000033;
}

.shell-sheet {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 320dp;
  max-width: 90%;
  background-color: #f8f9fb;
  z-index: 21;
  box-shadow: -2dp 0 12dp #00000033;
}

.shell-sheet-compact {
  bottom: 132dp;
}

.shell-toolbar {
  flex-shrink: 0;
  height: 48dp;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 8dp;
  background-color: #ffffff;
  border-top: 1dp #e5e7eb;
  box-sizing: border-box;
}

.shell-toolbar-flex {
  flex: 1;
}

.shell-toolbar-title {
  font-size: 14dp;
  color: #374151;
  text-align: center;
}

.shell-toolbar-btn {
  width: auto;
  min-width: 72dp;
  padding: 6dp 12dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 13dp;
  border-radius: 6dp;
  cursor: pointer;
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-toolbar-btn-preview {
  background-color: #4a6cf7;
  color: #ffffff;
}

.shell-transient-chrome {
  flex-shrink: 0;
  padding: 8dp 12dp;
  background-color: #ffffff;
  border-bottom: 1dp #e5e7eb;
}

.shell-back-btn {
  width: auto;
  padding: 6dp 12dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  border-radius: 6dp;
  cursor: pointer;
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-layer-transient {
  display: flex;
  flex-direction: column;
  z-index: 10;
  background-color: #f8f9fb;
}

.shell-layer-overlay,
.shell-layer-dialog {
  z-index: 50;
}

.shell-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #00000066;
  focus: none;
}

.shell-frame {
  position: absolute;
  top: 24dp;
  left: 24dp;
  right: 24dp;
  bottom: 24dp;
  padding: 16dp;
  background-color: #ffffff;
  border-radius: 8dp;
  box-sizing: border-box;
}

.shell-close-btn {
  position: absolute;
  top: 8dp;
  right: 8dp;
  width: auto;
  min-width: 32dp;
  padding: 4dp 10dp;
  margin-bottom: 0;
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  border-radius: 6dp;
  cursor: pointer;
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-overlay-body {
  margin-top: 32dp;
  height: 100%;
  overflow: auto;
}

.shell-dialog {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 360dp;
  max-width: 90%;
  margin-left: -180dp;
  margin-top: -120dp;
  padding: 20dp;
  background-color: #ffffff;
  border-radius: 8dp;
  box-sizing: border-box;
  z-index: 51;
}

.shell-dialog-title {
  margin-top: 0;
  font-size: 18dp;
}

.shell-dialog-message {
  display: block;
  margin-top: 0;
  margin-bottom: 8dp;
  color: #374151;
}

.shell-dialog-actions {
  justify-content: flex-end;
  gap: 8dp;
  margin-top: 16dp;
}

.shell-dialog-cancel {
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  cursor: pointer;
  background-color: #e8eaed;
  color: #1a1a1a;
}

.shell-dialog-ok {
  border: 0;
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  cursor: pointer;
  background-color: #4a6cf7;
  color: #ffffff;
}

.shell-dialog-ok:hover {
  background-color: #5a7cff;
}

.chat-empty {
  padding: 24dp;
  margin-bottom: 16dp;
  border-radius: 8dp;
  background-color: #ffffff;
  border: 1dp #e5e7eb;
}

.chat-empty-title {
  margin-top: 0;
  font-size: 20dp;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
}

.chat-panel .chat-header-title {
  font-size: 22dp;
}

.chat-panel .messages {
  flex: 1;
}

.sidebar-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow: hidden;
}

.sidebar-header {
  flex-shrink: 0;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8dp;
}

.sidebar-header-title {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 14dp;
  font-weight: bold;
  color: #374151;
}

.sidebar-new-chat {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 18dp;
  font-family: LatoLatin;
  cursor: pointer;
  background-color: #4a6cf7;
  color: #ffffff;
}

.sidebar-new-chat:hover {
  background-color: #5a7cff;
}

.sidebar-new-chat svg {
  flex-shrink: 0;
}

.sidebar-sessions {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.sidebar-session {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 36dp;
  margin-bottom: 4dp;
  padding: 0 4dp 0 8dp;
  border-radius: 6dp;
  background-color: #ffffff;
  border: 1dp #e5e7eb;
  box-sizing: border-box;
}

.sidebar-session-active {
  background-color: #f8fafc;
  box-shadow: inset 3dp 0 0 #3b82f6;
}

.sidebar-session-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  cursor: pointer;
}

.sidebar-session-title {
  flex: 1;
  min-width: 0;
  display: block;
  margin-top: 0;
  margin-bottom: 0;
  font-size: 13dp;
  color: #333333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar-unread {
  flex-shrink: 0;
  min-width: 20dp;
  padding: 2dp 6dp;
  border-radius: 10dp;
  background-color: #3b82f6;
  color: #ffffff;
  font-size: 11dp;
  text-align: center;
}

.sidebar-session-close {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28dp;
  height: 28dp;
  min-width: 28dp;
  margin-bottom: 0;
  padding: 0;
  border: 0;
  border-radius: 6dp;
  cursor: pointer;
  background-color: transparent;
}

.sidebar-session-close svg {
  flex-shrink: 0;
}

.sidebar-session-close:hover {
  background-color: #f3f4f6;
}

.message-row-peer {
  margin: 8dp 0;
  padding-right: 48dp;
}

.message-row-ai {
  margin: 8dp 0;
  padding-right: 24dp;
}

.message-row-user {
  margin: 8dp 0;
  padding-left: 48dp;
}

.sender-label {
  display: block;
  font-size: 11dp;
  margin-top: 0;
  margin-bottom: 4dp;
}

.bubble-peer {
  background-color: #f3f4f6;
  border: 1dp #e5e7eb;
}

.preview-panel,
.working-set-panel {
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow-y: auto;
}

.preview-title,
.working-set-title {
  margin-top: 0;
  font-size: 18dp;
}

.preview-content,
.working-set-body {
  margin-top: 8dp;
}

.working-set-long-list-body {
  display: block;
}

.working-set-long-list .chat-long-list-item {
  display: block;
  margin-bottom: 12dp;
  padding-bottom: 10dp;
  border-bottom: 1dp #e5e7eb;
}

.working-set-form {
  display: block;
  margin-top: 8dp;
}

.working-set-table {
  width: 100%;
}

.working-set-code {
  white-space: pre-wrap;
}

.chat-working-set-chip {
  display: inline-block;
  margin-top: 8dp;
  margin-right: 8dp;
  padding: 6dp 12dp;
  border: 1dp #d1d5db;
  border-radius: 16dp;
  background-color: #f3f4f6;
  color: #1f2937;
  font-size: 13dp;
  focus: none;
}

.chat-working-set-chip:hover {
  background-color: #e5e7eb;
}

.empty-panel {
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  justify-content: center;
}
