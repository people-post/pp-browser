body {
  font-family: LatoLatin;
  font-size: 16dp;
  color: #e8e8e8;
  background-color: #1a1a2e;
  padding: 24dp;
}

h1 {
  font-size: 28dp;
  margin-bottom: 12dp;
  color: #ffffff;
}

p {
  margin-bottom: 8dp;
  color: #c8c8d8;
}

button, input, textarea, select {
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  background-color: #2d2d44;
  color: #e8e8e8;
  border: 1dp #4a4a6a;
}

button {
  cursor: pointer;
  background-color: #4a6cf7;
  border: 0;
  color: #ffffff;
}

button:hover {
  background-color: #5a7cff;
}

input, textarea, select {
  width: 100%;
  margin-bottom: 8dp;
}

.stack {
  display: block;
}

.row {
  display: flex;
  flex-direction: row;
  gap: 8dp;
}

.gap-sm {
  margin-bottom: 8dp;
}

.card {
  padding: 16dp;
  background-color: #252538;
  border-radius: 8dp;
  border: 1dp #3a3a55;
  margin-bottom: 12dp;
}

.error {
  color: #ff6b6b;
}

.muted {
  color: #8888a0;
}

.chat-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
}

.chat-shell {
  position: absolute;
  top: 16dp;
  left: 16dp;
  right: 16dp;
  bottom: 16dp;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  max-width: 800dp;
  margin-left: auto;
  margin-right: auto;
}

.chat-header {
  flex-shrink: 0;
  box-sizing: border-box;
  margin-bottom: 12dp;
}

.chat-header h1 {
  margin-bottom: 4dp;
}

.messages {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  overflow-y: auto;
  overflow-x: hidden;
  margin-bottom: 12dp;
  padding-left: 8dp;
  padding-right: 8dp;
}

.message-group {
  display: block;
}

.message-row {
  display: block;
  margin-bottom: 12dp;
}

.message-row-user {
  text-align: right;
}

.message-row-assistant {
  text-align: left;
}

.bubble {
  padding: 12dp 16dp;
  border-radius: 12dp;
  text-align: left;
  box-sizing: border-box;
}

.bubble-user {
  display: inline-block;
  max-width: 680dp;
  background-color: #4a6cf7;
  color: #ffffff;
  focus: none;
}

.bubble-user p {
  margin-bottom: 0;
  color: #ffffff;
  white-space: pre-wrap;
  word-break: break-word;
}

.assistant-message {
  display: block;
}

.bubble-assistant {
  display: inline-block;
  max-width: 680dp;
  background-color: #252538;
  border: 1dp #3a3a55;
  focus: none;
}

.suggestion-row {
  display: block;
  margin-top: 8dp;
}

.bubble-assistant ul,
.bubble-assistant ol {
  box-sizing: border-box;
}

.bubble-assistant p,
.bubble-assistant li,
.bubble-assistant .code-block {
  word-break: break-word;
}

.bubble-assistant p:last-child,
.bubble-assistant .stack p:last-child {
  margin-bottom: 0;
}

.bubble-assistant h1,
.bubble-assistant h2,
.bubble-assistant h3 {
  margin-top: 0;
  color: #ffffff;
}

.bubble-assistant p,
.bubble-assistant li {
  color: #c8c8d8;
}

.thinking {
  margin-bottom: 0;
}

.input-row {
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 8dp;
}

.input-row textarea {
  flex: 1;
  margin-bottom: 0;
  min-height: 56dp;
}

.input-row button {
  flex-shrink: 0;
  width: auto;
  margin-bottom: 0;
}

.code-block {
  font-family: LatoLatin;
  font-size: 13dp;
  background-color: #1a1a2e;
  padding: 8dp 12dp;
  border-radius: 6dp;
  margin-top: 4dp;
  margin-bottom: 8dp;
  white-space: pre-wrap;
}

.suggestion-row .chat-suggestion {
  display: inline-block;
  width: auto;
  font-size: 13dp;
  padding: 6dp 12dp;
  margin-top: 0;
  margin-right: 8dp;
  margin-bottom: 4dp;
  border-radius: 16dp;
  background-color: #3a3a55;
  color: #e8e8e8;
  cursor: pointer;
  focus: none;
}

.suggestion-row .chat-suggestion:hover {
  background-color: #4a4a6a;
}

.dynamic-demo-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
}

.dynamic-demo-shell {
  position: absolute;
  top: 16dp;
  left: 16dp;
  right: 16dp;
  bottom: 16dp;
  display: flex;
  flex-direction: column;
  background-color: #1a1a2e;
  padding: 16dp;
  border-radius: 8dp;
  box-sizing: border-box;
}

.dynamic-demo-header {
  flex-shrink: 0;
  margin-bottom: 12dp;
}

.dynamic-toolbar {
  flex-shrink: 0;
  margin-bottom: 12dp;
}

.dynamic-toolbar button {
  width: auto;
  margin-bottom: 0;
}

.dynamic-status {
  flex-shrink: 0;
  margin-bottom: 8dp;
  color: #a8d8a8;
}

.dynamic-mount-target {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.dynamic-panel {
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.dynamic-panel h2 {
  margin-top: 0;
}

.scroll-list {
  flex: 1;
  min-height: 120dp;
  max-height: 220dp;
  overflow-y: auto;
  padding: 8dp;
  background-color: #252538;
  border-radius: 6dp;
  border: 1dp #3a3a55;
  box-sizing: border-box;
}

.dynamic-panel-b .scroll-list {
  background-color: #2a2538;
}

.chat-shell-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
}

.split-root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.split-branch {
  display: flex;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.split-branch.split-h {
  flex-direction: row;
}

.split-branch.split-v {
  flex-direction: column;
}

.split-pane {
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.split-gutter {
  flex-shrink: 0;
  background-color: #3a3a55;
  focus: none;
}

.split-gutter-v {
  width: 5dp;
  cursor: ew-resize;
}

.split-gutter-h {
  height: 5dp;
  cursor: ns-resize;
}

.panel-leaf {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background-color: #1a1a2e;
}

.panel-header {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  padding: 6dp 8dp;
  background-color: #252538;
  border-bottom: 1dp #3a3a55;
  box-sizing: border-box;
}

.panel-title {
  flex: 1;
  font-size: 13dp;
  color: #c8c8d8;
}

.panel-btn {
  width: auto;
  min-width: 28dp;
  padding: 4dp 8dp;
  margin-bottom: 0;
  font-size: 12dp;
  background-color: #3a3a55;
  focus: none;
}

.panel-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
}

.chat-panel .chat-header h1 {
  font-size: 22dp;
}

.chat-panel .messages {
  flex: 1;
}

.sidebar-panel {
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow-y: auto;
}

.sidebar-new-chat {
  width: 100%;
  margin-bottom: 12dp;
}

.sidebar-session {
  padding: 10dp;
  margin-bottom: 8dp;
  border-radius: 6dp;
  background-color: #252538;
  border: 1dp #3a3a55;
}

.sidebar-session-preview {
  margin-bottom: 0;
  font-size: 12dp;
}

.preview-panel {
  height: 100%;
  padding: 12dp;
  box-sizing: border-box;
  overflow-y: auto;
}

.preview-panel h2 {
  margin-top: 0;
  font-size: 18dp;
}

.preview-content {
  margin-top: 8dp;
}

.empty-panel {
  height: 100%;
  padding: 24dp;
  box-sizing: border-box;
  justify-content: center;
}
