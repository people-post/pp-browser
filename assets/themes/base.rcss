body {
  font-family: LatoLatin;
  font-size: 16dp;
  color: #e8e8e8;
  background-color: #1a1a2e;
  padding: 24dp;
}

h1 {
  font-size: 28dp;
  margin-bottom: 12dp;
  color: #ffffff;
}

p {
  margin-bottom: 8dp;
  color: #c8c8d8;
}

button, input, textarea, select {
  font-family: LatoLatin;
  font-size: 14dp;
  padding: 8dp 12dp;
  border-radius: 6dp;
  background-color: #2d2d44;
  color: #e8e8e8;
  border: 1dp #4a4a6a;
}

button {
  cursor: pointer;
  background-color: #4a6cf7;
  border: 0;
  color: #ffffff;
}

button:hover {
  background-color: #5a7cff;
}

input, textarea, select {
  width: 100%;
  margin-bottom: 8dp;
}

.stack {
  display: block;
}

.row {
  display: flex;
  flex-direction: row;
  gap: 8dp;
}

.gap-sm {
  margin-bottom: 8dp;
}

.card {
  padding: 16dp;
  background-color: #252538;
  border-radius: 8dp;
  border: 1dp #3a3a55;
  margin-bottom: 12dp;
}

.error {
  color: #ff6b6b;
}

.muted {
  color: #8888a0;
}

.chat-body {
  padding: 16dp;
  height: 100%;
}

.chat-shell {
  display: flex;
  flex-direction: column;
  height: 100%;
  max-width: 800dp;
  margin-left: auto;
  margin-right: auto;
}

.chat-header {
  margin-bottom: 16dp;
}

.chat-header h1 {
  margin-bottom: 4dp;
}

.messages {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 16dp;
  padding-right: 8dp;
}

.message-row {
  margin-bottom: 12dp;
}

.bubble {
  padding: 12dp 16dp;
  border-radius: 12dp;
  max-width: 85%;
}

.bubble-user {
  background-color: #4a6cf7;
  color: #ffffff;
  margin-left: auto;
}

.bubble-user p {
  color: #ffffff;
  margin-bottom: 0;
}

.bubble-assistant {
  background-color: #252538;
  border: 1dp #3a3a55;
  margin-right: auto;
}

.input-row {
  display: flex;
  flex-direction: column;
  gap: 8dp;
}

.input-row textarea {
  margin-bottom: 0;
  resize: none;
}

.code-block {
  font-family: LatoLatin;
  font-size: 13dp;
  background-color: #1a1a2e;
  padding: 8dp 12dp;
  border-radius: 6dp;
  margin-top: 4dp;
  margin-bottom: 8dp;
  white-space: pre-wrap;
}
