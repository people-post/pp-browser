/* Wide-screen (desktop and wide iPad) structure and sizes — DEV/DESIGN-desktop-ui.md step 1.
 *
 * RULES (checked by src/gui/tests/wide_stylesheet_test.cpp):
 *   1. Every selector starts with `.shell-body--wide`, which window_shell.rml sets while layout_mode == 'expanded'
 *      (RCSS has no :not(), so "wide only" needs a wide root of its own). Nothing here can match under the phone's
 *      `.shell-body--compact`.
 *   2. No colours. Colours of wide-only things live in colors.rcss.tmpl / theme_tokens.tsv (generated into
 *      colors-light.rcss / colors-dark.rcss), under the same `.shell-body--wide` root.
 *   3. Page layouts that differ get their own `<page>_wide.rml`; this file only holds the sizes, the scale and the
 *      shared wide components (floating menu, result pill) and the base look (soft surfaces).
 *
 * Loaded after components.rcss (equal specificity: this file wins) and before the colour files.
 */

/* ---- Scale (the mockup's style page, sections 1-3). RCSS has no variables, so the scale is a set of classes. ---- */

/* Spacing: 4 / 8 / 12 / 16 / 24 / 32. Gap between flex children, and padding. */
.shell-body--wide .w-gap-4 { gap: 4dp; }
.shell-body--wide .w-gap-8 { gap: 8dp; }
.shell-body--wide .w-gap-12 { gap: 12dp; }
.shell-body--wide .w-gap-16 { gap: 16dp; }
.shell-body--wide .w-gap-24 { gap: 24dp; }
.shell-body--wide .w-gap-32 { gap: 32dp; }
.shell-body--wide .w-pad-4 { padding: 4dp; }
.shell-body--wide .w-pad-8 { padding: 8dp; }
.shell-body--wide .w-pad-12 { padding: 12dp; }
.shell-body--wide .w-pad-16 { padding: 16dp; }
.shell-body--wide .w-pad-24 { padding: 24dp; }
.shell-body--wide .w-pad-32 { padding: 32dp; }

/* Type: six sizes only. */
.shell-body--wide .w-type-title { font-size: 24dp; font-weight: bold; }
.shell-body--wide .w-type-heading { font-size: 17dp; font-weight: bold; }
.shell-body--wide .w-type-row { font-size: 16dp; }
.shell-body--wide .w-type-body { font-size: 15dp; }
.shell-body--wide .w-type-secondary { font-size: 14dp; }
.shell-body--wide .w-type-small { font-size: 12dp; }

/* Nothing clickable is lower than 32dp. */
.shell-body--wide .w-target { min-height: 32dp; box-sizing: border-box; }

/* ---- Columns: icon rail 64 | list 280..480 (default 320) | conversation >= 420 ----
   64 + 280 + 420 = 764, so the 768 window keeps two columns. The list column gives way first (flex-shrink), the
   conversation never goes below its floor. With the auxiliary (Ask-AI) pane open the three-column arithmetic does not
   fit below ~1100; until step 3 turns that pane into an overlay drawer, such a row keeps the old floors (200 / 240). */
.shell-body--wide .shell-nav-rail {
  flex: 0 0 64dp;
}

.shell-body--wide .shell-pane-secondary {
  min-width: 280dp;
}

.shell-body--wide .shell-pane-primary {
  min-width: 420dp;
}

.shell-body--wide .shell-pane-row--aux .shell-pane-secondary {
  min-width: 200dp;
}

.shell-body--wide .shell-pane-row--aux .shell-pane-primary {
  min-width: 240dp;
}

/* ---- Floating menu (right-click / header "more" / pick lists): one style, contents unchanged ---- */
.shell-body--wide #context-menu-panel {
  min-width: 190dp;
  padding: 6dp;
  border-radius: 16dp;
}

/* The status bar's pop-over (desktop): the same card. */
.shell-body--wide .shell-statusbar-popover {
  border-radius: 16dp;
}

/* The reaction row above a message: the same card, a pill. */
.shell-body--wide .context-menu-quick {
  padding: 4dp;
  border-radius: 26dp;
}

/* The destructive row (Delete, Clear chat, Leave) is the one group the phone sheet also sets apart: a thin line and a
   little air above it. */
.shell-body--wide #context-menu-panel .context-menu-item--danger {
  margin-top: 5dp;
  border-top-width: 0.5dp;
  border-radius: 0 0 8dp 8dp;
}

/* Only one line for the group: none above a second destructive row, none when it is the first row. */
.shell-body--wide #context-menu-panel .context-menu-item--danger + .context-menu-item--danger,
.shell-body--wide #context-menu-panel .context-menu-item--danger:first-child {
  margin-top: 0;
  border-top-width: 0;
  border-radius: 8dp;
}

.shell-body--wide #context-menu-panel .context-menu-item {
  min-height: 34dp;
  gap: 10dp;
  padding: 0 12dp;
  border-radius: 8dp;
}

.shell-body--wide #context-menu-panel .context-menu-item-label {
  font-size: 15dp;
  white-space: nowrap;
}

/* The touch text bar of an input field keeps its own shape. */
.shell-body--wide .context-menu-layer--bar #context-menu-panel {
  min-width: 0;
  padding: 4dp;
  border-radius: 8dp;
}

.shell-body--wide .context-menu-layer--bar #context-menu-panel .context-menu-item {
  min-height: 36dp;
  padding: 6dp 12dp;
  border-radius: 6dp;
}

/* ---- Result pill: a white pill at the bottom of the content area, centred, up to 480dp wide, one at a time.
   ShellHost sets the stack's left (the columns to its left) and bottom (over the status bar and composer). ---- */
.shell-body--wide .shell-chrome {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-body--wide .shell-toast-stack {
  left: 0;
  right: 0;
  top: auto;
  display: block;
  text-align: center;
  pointer-events: none;
}

.shell-body--wide .shell-chrome .shell-toast {
  display: inline-block;
  max-width: 480dp;
  border-width: 1dp;
  padding: 8dp 16dp;
  margin: 0;
  border-radius: 20dp;
  box-sizing: border-box;
  pointer-events: none;
}

.shell-body--wide .shell-toast-text {
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

/* ---- Base look (the mockup's style page): soft surfaces, large corners, hairlines instead of outlines ----
   Radius scale from the mockup: 6 menu row, 9-10 buttons / fields / list rows, 12 menus and tabs, 14 cards, 18
   bubbles, 20-21 the input pill. A line is a 0.5dp hairline; a box is a filled surface, not an outline. Colours: the
   end of colors.rcss.tmpl (same wide root). Shared rules that draw the heavy outlines (components.rcss, colors) are
   not edited: these override them under the wide root. */

/* Column frame and dividers: a hairline, not a 1dp line. */
.shell-body--wide .shell-nav-rail {
  border-right-width: 0.5dp;
}

.shell-body--wide .shell-pane-secondary {
  border-right-width: 0.5dp;
}

.shell-body--wide .shell-pane-auxiliary {
  border-left-width: 0.5dp;
}

.shell-body--wide .shell-statusbar,
.shell-body--wide .shell-toolbar,
.shell-body--wide .sidebar-footer,
.shell-body--wide .surface-chrome {
  border-top-width: 0.5dp;
}

.shell-body--wide .shell-nav-tab {
  border-radius: 12dp;
}

/* List rows (chats, settings, contacts): no outline; the hover and the selected row are rounded fills. */
.shell-body--wide .sidebar-session,
.shell-body--wide .settings-row,
.shell-body--wide .contacts-row,
.shell-body--wide .contacts-thread-row {
  border-width: 0;
  border-radius: 10dp;
}

/* Cards and group boxes: a filled surface with a large corner, no outline. */
.shell-body--wide .card,
.shell-body--wide .me-profile-card,
.shell-body--wide .contact-profile-card,
.shell-body--wide .chat-form,
.shell-body--wide .chat-empty {
  border-width: 0;
  border-radius: 14dp;
}

/* Fields and search: filled and rounded; the border is kept (transparent, a colour) so focus does not move anything. */
.shell-body--wide .field,
.shell-body--wide .chat-form-field {
  border-radius: 10dp;
}

.shell-body--wide .chat-search {
  border-radius: 10dp;
}

/* The input pill keeps its large corner and gets a hairline. */
.shell-body--wide .prompt-composer-pill {
  border-width: 0.5dp;
  border-radius: 21dp;
}

/* Chat header: no coloured side bar and tint; a hairline under it. */
.shell-body--wide .chat-shell--e2e .chat-header,
.shell-body--wide .chat-shell--ai .chat-header,
.shell-body--wide .chat-shell--public .chat-header,
.shell-body--wide .chat-shell--group .chat-header {
  border-left-width: 0;
  padding-left: 16dp;
  border-radius: 0;
}

/* Menus and the result pill: the same hairline. */
.shell-body--wide #context-menu-panel,
.shell-body--wide .shell-chrome .shell-toast {
  border-width: 0.5dp;
}

/* ================= The Chat section (design step 2, mockup page 2) ================= */

/* ---- List column: header, search, rows with avatars ---- */
.shell-body--wide .sidebar-panel {
  padding: 0;
}

.shell-body--wide .sidebar-header {
  margin-bottom: 0;
  padding: 16dp 16dp 8dp 16dp;
}

.shell-body--wide .sidebar-header-title {
  font-size: 24dp;
  line-height: 30dp;
}

.shell-body--wide .sidebar-new-chat {
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  border-radius: 18dp;
}

.shell-body--wide .chat-search {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  height: 36dp;
  margin: 4dp 16dp 8dp 16dp;
  padding: 0 12dp;
  box-sizing: border-box;
  border-radius: 10dp;
}

.shell-body--wide .chat-search-input {
  height: 36dp;
  padding: 8dp 0 8dp 8dp;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-body--wide .chat-search-label {
  left: 36dp;
  height: 36dp;
  font-size: 15dp;
  line-height: 36dp;
}

.shell-body--wide .sidebar-sessions {
  overflow-x: hidden;
  padding: 0 8dp;
  box-sizing: border-box;
}

.shell-body--wide .sidebar-tip,
.shell-body--wide .sidebar-reconnect-entry,
.shell-body--wide .sidebar-archived-entry {
  margin-left: 8dp;
  margin-right: 8dp;
}

.shell-body--wide .sidebar-session {
  min-height: 68dp;
  margin-bottom: 2dp;
  padding: 0 12dp;
  gap: 12dp;
}

.shell-body--wide .chat-row-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 48dp;
  height: 48dp;
  border-radius: 24dp;
  overflow: hidden;
}

.shell-body--wide .chat-row-avatar .avatar-photo {
  width: 48dp;
  height: 48dp;
}

.shell-body--wide .sidebar-session-icon,
.shell-body--wide .sidebar-session-flag--muted {
  display: none;
}

.shell-body--wide .chat-row-type,
.shell-body--wide .chat-row-mute,
.shell-body--wide .chat-row-blocked {
  display: block;
  flex-shrink: 0;
}

.shell-body--wide .chat-row-type,
.shell-body--wide .chat-row-blocked {
  width: 14dp;
  height: 14dp;
}

.shell-body--wide .chat-row-mute {
  width: 16dp;
  height: 16dp;
}

.shell-body--wide .sidebar-session-body {
  min-height: 48dp;
  justify-content: center;
  gap: 2dp;
}

.shell-body--wide .sidebar-session-line {
  min-height: 22dp;
}

.shell-body--wide .sidebar-session-line + .sidebar-session-line {
  min-height: 20dp;
}

.shell-body--wide .sidebar-session-title {
  font-size: 16dp;
  line-height: 22dp;
  font-weight: bold;
}

.shell-body--wide .sidebar-session-preview,
.shell-body--wide .sidebar-session-mention {
  font-size: 14dp;
  line-height: 20dp;
}

.shell-body--wide .sidebar-session-date {
  font-size: 12dp;
  line-height: 22dp;
}

.shell-body--wide .sidebar-unread {
  min-width: 20dp;
  height: 20dp;
  padding: 0 6dp;
  box-sizing: border-box;
  border-radius: 10dp;
  font-size: 12dp;
  font-weight: bold;
  line-height: 20dp;
}

/* ---- Conversation: header ---- */
.shell-body--wide .chat-panel {
  padding: 0;
}

.shell-body--wide .chat-header {
  position: relative;
  z-index: 3;
  height: 64dp;
  margin: 0;
  padding: 0 16dp;
  border-radius: 0;
  border-bottom-width: 0.5dp;
}

/* The header strip floats over the transcript like the phone chat's bar (the transcript's scroller reaches up under
   it, see .messages below). The strip itself is clear: the engine draws no backdrop blur on an element with a z-index
   and children, so its first child (.bar-material, childless) carries the bar colour and, while the shell row is
   frosted (Transparency on, ShellInterruption::ResolveFrost), the phone bars' blur. Its rows are positioned so they
   paint above that child. At most two blurs in the wide frame: this strip and the composer strip. */
.shell-body--wide .chat-header > .chat-search-bar,
.shell-body--wide .chat-header > .chat-header-main,
.shell-body--wide .chat-header > .chat-header-actions {
  position: relative;
}

.shell-body--wide .shell-pane-row--frost .chat-header > .bar-material {
  backdrop-filter: blur(20px);
}

/* A call bar or a banner between the header and the transcript covers what runs under it (colors.rcss.tmpl). */
.shell-body--wide .chat-call-bar,
.shell-body--wide .chat-gap-banner {
  position: relative;
  z-index: 1;
}

.shell-body--wide .chat-header-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
}

.shell-body--wide .chat-header-text {
  flex: 1;
  min-width: 0;
}

.shell-body--wide .chat-header-avatar-hit {
  display: block;
  flex-shrink: 0;
  padding: 2dp;
  margin: 0 -2dp;
}

.shell-body--wide .chat-header-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 40dp;
  height: 40dp;
  border-radius: 20dp;
  overflow: hidden;
}

.shell-body--wide .chat-header-avatar .avatar-photo {
  width: 40dp;
  height: 40dp;
}

.shell-body--wide .chat-header-avatar .chat-row-avatar-letter {
  font-size: 17dp;
  line-height: 22dp;
}

.shell-body--wide .chat-header-avatar .chat-row-avatar-icon {
  width: 22dp;
  height: 22dp;
}

.shell-body--wide .chat-header-type-icon {
  display: none;
}

.shell-body--wide .chat-header-title {
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-body--wide .chat-header-meta-row {
  margin-top: 0;
}

.shell-body--wide .chat-header-subtitle {
  font-size: 12dp;
  line-height: 16dp;
}

.shell-body--wide .chat-header-actions {
  gap: 4dp;
}

.shell-body--wide .chat-header-call-btn,
.shell-body--wide .chat-header-more-btn,
.shell-body--wide .chat-header-search-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 9dp;
  cursor: pointer;
}

.shell-body--wide .chat-header-call-btn--join {
  width: auto;
  padding: 0 14dp;
  border-radius: 18dp;
}

.shell-body--wide .chat-header-call-btn svg,
.shell-body--wide .chat-header-more-btn svg,
.shell-body--wide .chat-header-search-btn svg {
  flex-shrink: 0;
  width: 20dp;
  height: 20dp;
}

/* ---- Conversation: messages ---- */
.shell-body--wide .messages {
  margin-bottom: 0;
  padding: 16dp 24dp 12dp 24dp;
}

/* The transcript runs up under the 64dp header strip (its top padding keeps the first bubble clear at rest) and down
   under the composer strip: the end spacer (.composer-clear) follows the strip's height (ChatController::
   KeepClearOfComposer), since the engine leaves a scroller's own bottom padding out of its scroll height. */
.shell-body--wide .chat-messages-wrap .messages {
  top: -64dp;
  padding-top: 80dp;
}

.shell-body--wide .composer-clear {
  display: block;
  height: 96dp;
}

.shell-body--wide .message-row {
  position: relative;
  margin: 2dp 0 0 0;
}

.shell-body--wide .message-row-run-start {
  margin-top: 10dp;
}

.shell-body--wide .message-row-peer,
.shell-body--wide .message-row-ai {
  padding-right: 0;
}

.shell-body--wide .message-row-user {
  padding-left: 0;
}

/* The message BUBBLE under the pointer: a small row at its top (the used reactions, +, reply, more). The hover target is
   .msg-hover (chat_wide.rml): it holds the message's content and the bar, and is hovered only while the pointer is over a
   bubble or the bar. The empty row space beside a bubble, the avatar and the name are not under it: the wrapper and the
   content's own full-width block take no pointer events (a hover still counts for them while a bubble below is under the
   pointer), everything inside the content takes them again, so a bubble keeps its clicks, selection and right click. */
.shell-body--wide .msg-hover {
  position: relative;
  display: block;
  pointer-events: none;
}

.shell-body--wide .msg-hover * {
  pointer-events: auto;
}

.shell-body--wide .msg-hover > div {
  pointer-events: none;
}

.shell-body--wide .msg-hover .msg-bar {
  pointer-events: auto;
}

.shell-body--wide .msg-bar {
  display: none;
  position: absolute;
  top: -14dp;
  z-index: 6;
  flex-direction: row;
  align-items: center;
  gap: 2dp;
  padding: 3dp;
  border-radius: 14dp;
}

.shell-body--wide .message-row-user .msg-bar {
  right: 12dp;
}

.shell-body--wide .message-row-peer .msg-bar,
.shell-body--wide .message-row-ai .msg-bar {
  left: 8dp;
}

.shell-body--wide .msg-hover:hover > .msg-bar {
  display: flex;
}

/* While the transcript is scrolled (and for 200 ms after; ChatTranscriptScroller) no bar is drawn: one class on the
   transcript, nothing per row per scroll event. */
.shell-body--wide .messages--scrolling .msg-hover:hover > .msg-bar {
  display: none;
}

.shell-body--wide .msg-bar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34dp;
  height: 28dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 7dp;
  cursor: pointer;
}

.shell-body--wide .msg-bar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30dp;
  height: 28dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 7dp;
  cursor: pointer;
}

/* The emoji sits in a span of its own, as the message menu's quick row (.context-menu-item-label) does: text straight
   in the flex button was not drawn. */
.shell-body--wide .msg-bar-emoji-glyph {
  flex: 0 0 auto;
  font-size: 18dp;
  line-height: 24dp;
  white-space: nowrap;
}

.shell-body--wide .msg-bar-sep {
  width: 1dp;
  height: 18dp;
  margin: 0 3dp;
}

.shell-body--wide .msg-bar-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

/* ---- Composer ---- */
/* The composer strip (ShellLayoutRml::PaneSlot) floats over the conversation column's bottom edge, the transcript
   running under it; its first child is the phone bars' material (.bar-material, frosted with Transparency on), the
   mount paints above it. */
.shell-body--wide .shell-pane-chat {
  position: relative;
}

.shell-body--wide .shell-pane-composer-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
}

/* The composer floats: one compact rounded panel 12dp in from the column's left, right and bottom edges (about 64dp:
   the 44dp input pill with 10dp above and below), the messages scrolling under it and showing round it; the bar behind
   it is clear. The mount (what ChatController::KeepClearOfComposer measures) is the panel plus its 12dp margin; its
   padding is the panel's 12dp side / 10dp inner space plus that margin. The material is the panel's own surface: inset
   by the margin, 22dp corners, a hairline, a faint blur-free stacked shadow (a blurred shadow on a repositioned panel
   draws displaced). The reply / edit strip, the status row (attachments, stop), the row and the recording pill all sit
   inside the mount's padding, so inside the panel; the "Enter to send" hint is the input's placeholder. */
.shell-body--wide .shell-pane-composer-bar > .bar-material {
  top: 0;
  left: 12dp;
  right: 12dp;
  bottom: 12dp;
  border-radius: 22dp;
}

.shell-body--wide .shell-pane-composer {
  position: relative;
  padding: 10dp 24dp 22dp 24dp;
  box-sizing: border-box;
}

.shell-body--wide .shell-pane-composer .prompt-composer-pill {
  min-height: 44dp;
}

.shell-body--wide .shell-pane-composer .prompt-composer--wide {
  margin: 0;
}

.shell-body--wide .shell-pane-composer .prompt-quote {
  margin: 0 0 8dp 0;
}

.shell-body--wide .shell-composer-mount {
  padding: 10dp 16dp 12dp 16dp;
  box-sizing: border-box;
}

.shell-body--wide .prompt-composer-row {
  align-items: center;
  gap: 6dp;
}

/* Wide row (composer_wide.rml): the paperclip, emoji, microphone and Send sit on the row's centre line; the microphone
   (the phone's end key, hidden by default) shows here. */
.shell-body--wide .prompt-composer--wide .prompt-composer-row .prompt-voice-toggle-btn,
.shell-body--wide .prompt-composer--wide .prompt-composer-row .prompt-emoji-btn,
.shell-body--wide .prompt-composer--wide .prompt-composer-row .prompt-attach-btn,
.shell-body--wide .prompt-composer--wide .prompt-composer-row .prompt-send-btn {
  margin-bottom: 0;
}

.shell-body--wide .prompt-composer--wide .prompt-composer-row .prompt-voice-toggle-btn--end {
  display: flex;
  width: 40dp;
  min-width: 40dp;
  height: 40dp;
  border-radius: 20dp;
}

.shell-body--wide .prompt-composer--wide .prompt-composer-row > .prompt-attach-btn,
.shell-body--wide .prompt-composer--wide .prompt-composer-row > .prompt-emoji-btn {
  width: 40dp;
  min-width: 40dp;
  height: 40dp;
  border-radius: 20dp;
}

.shell-body--wide .prompt-composer--wide .prompt-composer-pill .prompt-capture-btn {
  margin-bottom: 0;
  align-self: center;
}

.shell-body--wide .prompt-composer--wide .prompt-composer-row {
  margin-right: 0;
}

.shell-body--wide .prompt-composer-input {
  font-size: 15dp;
}

/* The hint over the empty field (the engine draws no placeholder): the input's own text line, one line, ellipsized before
   the camera key; clicks fall through to the field. Hidden while an IME composes. */
.shell-body--wide .prompt-composer--wide .prompt-composer-label--wide {
  display: block;
  position: absolute;
  top: 3dp;
  left: 14dp;
  right: 44dp;
  height: 40dp;
  margin: 0;
  font-size: 15dp;
  line-height: 40dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  pointer-events: none;
}

.shell-body--wide .prompt-composer--wide textarea:composing ~ .prompt-composer-label--wide {
  display: none;
}

