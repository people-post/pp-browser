.shell-body--wide .group-row--field .group-row-body {
  position: relative;
  display: block;
  min-height: 0;
  padding: 10dp 16dp 0 0;
}

.shell-body--wide .group-row--field .group-row-text {
  display: block;
  flex: none;
  width: auto;
  margin: 0 0 2dp 0;
  font-size: 13dp;
  line-height: 18dp;
  text-align: left;
}

.shell-body--wide .group-card .field {
  display: block;
  flex: none;
  width: 100%;
  min-width: 0;
  height: 44dp;
  min-height: 44dp;
  max-height: 44dp;
  margin: 0 0 10dp 0;
  /* A 22dp line between 11dp paddings: text and a line-tall caret in the middle (a 44dp line drew a full-height caret). */
  padding: 11dp 12dp;
  border: 0;
  border-radius: 10dp;
  box-sizing: border-box;
  font-size: 17dp;
  line-height: 22dp;
  text-align: left;
}

.shell-body--wide .group-field-hint {
  position: absolute;
  left: 12dp;
  bottom: 10dp;
  display: block;
  height: 44dp;
  margin: 0;
  font-size: 17dp;
  line-height: 44dp;
  white-space: nowrap;
  pointer-events: none;
}

.shell-body--wide .group-row--static {
  cursor: default;
}

.shell-body--wide .group-id-row {
  cursor: default;
}

.shell-body--wide .group-id-text {
  flex: 1;
  min-width: 0;
  display: block;
  padding: 8dp 0;
}

.shell-body--wide .group-id-label {
  display: block;
  font-size: 13dp;
  line-height: 18dp;
}

.shell-body--wide .group-id-value {
  display: block;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-body--wide .group-id-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22dp;
  background-color: transparent;
  cursor: pointer;
}

.shell-body--wide .group-row .settings-switch {
  width: 51dp;
  height: 31dp;
  min-width: 51dp;
}

.shell-body--wide .group-row .settings-switch-knob {
  width: 27dp;
  height: 27dp;
}

.shell-body--wide .group-row .settings-switch--on .settings-switch-knob {
  transform: translateX(20dp);
}

.shell-body--wide .me-card-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-right: 8dp;
}

.shell-body--wide .me-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
  margin: 0;
  padding: 12dp;
  border: 0;
  box-sizing: border-box;
  text-align: left;
  cursor: pointer;
}

.shell-body--wide .me-card-avatar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60dp;
  height: 60dp;
  border-radius: 30dp;
  overflow: hidden;
}

.shell-body--wide .me-card-avatar .avatar-letter {
  font-size: 24dp;
}

.shell-body--wide .me-card-avatar-image {
  width: 60dp;
  height: 60dp;
}

.shell-body--wide .me-card-text {
  flex: 1;
  min-width: 0;
}

.shell-body--wide .me-card-name {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-body--wide .me-card-meta {
  margin: 1dp 0 0 0;
  font-size: 15dp;
  line-height: 20dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-body--wide .me-home .group-card,
.shell-body--wide .settings-mock .group-card {
  margin: 24dp 16dp 0 16dp;
  border-radius: 12dp;
}

.shell-body--wide .settings-mock .group-card:first-child {
  margin-top: 16dp;
}

.shell-body--wide .settings-mock .group-row-sub {
  white-space: normal;
  overflow: visible;
  margin-top: 2dp;
}

.shell-body--wide .settings-mock .group-row--dim {
  opacity: 0.4;
  pointer-events: none;
}

.shell-body--wide .settings-mock .group-row--q {
  position: relative;
}

.shell-body--wide .settings-mock .group-row--q .group-row-tap {
  justify-content: space-between;
  padding-right: 12dp;
}

.shell-body--wide .settings-mock .group-row--off {
  cursor: default;
}

.shell-body--wide .settings-mock .settings-device-row {
  padding: 0;
  gap: 0;
}

.shell-body--wide .settings-mock .group-row-tap {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 52dp;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  text-align: left;
  cursor: pointer;
}

.shell-body--wide .settings-mock .group-row--indent {
  padding-left: 36dp;
}

.shell-body--wide .settings-mock .me-profile-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 8dp 16dp 0 16dp;
}

.shell-body--wide .settings-mock .group-row--field .group-row-body--field {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 52dp;
  padding: 0 16dp 0 0;
}

.shell-body--wide .settings-mock .group-row--field .group-row-text {
  flex: 0 0 auto;
  margin: 0 12dp 0 0;
  font-size: 17dp;
  line-height: 22dp;
}

.shell-body--wide .settings-mock .group-row--field .field {
  flex: 1;
  width: auto;
  height: 52dp;
  min-height: 52dp;
  max-height: 52dp;
  margin: 0;
  padding: 15dp 0;
  background-color: transparent;
  text-align: right;
}

.shell-body--wide .settings-mock .group-row--field .group-field-hint {
  left: auto;
  right: 0;
  top: 0;
  bottom: auto;
  height: 52dp;
  line-height: 52dp;
}

.shell-body--wide .settings-mock .group-foot {
  margin: 8dp 32dp 0 32dp;
}

.shell-body--wide .settings-copied-box {
  margin: 16dp 16dp 0 16dp;
  padding: 16dp 18dp 8dp 18dp;
  border-width: 2dp;
  border-radius: 14dp;
  box-sizing: border-box;
}

.shell-body--wide .settings-copied-title {
  margin: 0;
  font-size: 19dp;
  line-height: 26dp;
  font-weight: bold;
}

.shell-body--wide .settings-copied-sub {
  margin: 4dp 0 0 0;
  font-size: 13dp;
  line-height: 18dp;
}

.shell-body--wide .settings-copied-again {
  display: block;
  margin: 4dp -8dp 0 -8dp;
  text-align: left;
}

.shell-body--wide .settings-transfer-hint {
  margin: 20dp 32dp 0 32dp;
}

.shell-body--wide .settings-transfer-steps {
  margin: 12dp 32dp 0 32dp;
}

.shell-body--wide .settings-note-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.shell-body--wide .settings-note-row .text {
  flex: 0 1 auto;
  min-width: 0;
}

.shell-body--wide .settings-dev-hero {
  padding: 28dp 0 0 0;
  text-align: center;
}

.shell-body--wide .settings-dev-ill {
  display: block;
  width: 44dp;
  height: 44dp;
  margin: 0 auto;
}

.shell-body--wide .settings-dev-sentence-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin: 10dp 20dp 0 32dp;
}

.shell-body--wide .settings-dev-sentence {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 20dp;
  line-height: 26dp;
  font-weight: bold;
}

.shell-body--wide .settings-dev-sub {
  margin: 2dp 32dp 0 32dp;
  font-size: 15dp;
  line-height: 21dp;
  text-align: center;
}

.shell-body--wide .settings-dev-note {
  padding: 14dp 16dp 16dp 16dp;
}

.shell-body--wide .settings-dev-note-title {
  margin: 0;
  font-size: 17dp;
  line-height: 23dp;
}

.shell-body--wide .settings-dev-note-row {
  margin: 6dp 0 0 0;
}

.shell-body--wide .settings-dev-note-line {
  margin: 0;
  font-size: 14dp;
  line-height: 20dp;
}

.shell-body--wide .settings-section--grouped .group-card .btn.settings-action-row {
  display: block;
  flex: none;
  width: 100%;
  height: 50dp;
  min-height: 50dp;
  margin: -1dp 0 0 0;
  padding: 0 16dp;
  border-radius: 0;
  box-sizing: border-box;
  font-size: 17dp;
  line-height: 50dp;
  font-weight: normal;
  text-align: left;
}

.shell-body--wide .settings-section--grouped .group-head {
  display: none;
}

.shell-body--wide .settings-section--grouped .group-head + .group-card {
  margin-top: 20dp;
}

.shell-body--wide .settings-section--grouped .group-head + .group-foot,
.shell-body--wide .settings-section--grouped .group-head + .stack > .group-foot:first-child {
  margin-top: 20dp;
}

.shell-body--wide .settings-section--grouped .group-head.group-head--field {
  display: block;
  margin: 20dp 32dp 4dp 32dp;
  font-size: 17dp;
  line-height: 22dp;
}

.shell-body--wide .me-home .group-row,
.shell-body--wide .me-home .group-row-body,
.shell-body--wide .settings-mock .group-row,
.shell-body--wide .settings-mock .group-row-body {
  min-height: 52dp;
}

.shell-body--wide .me-home .me-card-row {
  min-height: 88dp;
  padding-right: 0;
}

.shell-body--wide .me-home .me-card-main {
  padding: 12dp 4dp 12dp 16dp;
}

.shell-body--wide .me-home .me-card-avatar,
.shell-body--wide .me-home .me-card-avatar-image {
  width: 64dp;
  height: 64dp;
  border-radius: 32dp;
}

.shell-body--wide .me-home .me-card-avatar .avatar-letter {
  font-size: 26dp;
}

.shell-body--wide .me-home .me-card-name {
  font-size: 20dp;
  line-height: 26dp;
}

.shell-body--wide .me-home .me-card-acts {
  flex-shrink: 0;
  align-items: center;
  margin-right: 4dp;
}

.shell-body--wide .me-home .me-card-act {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 48dp;
  height: 50dp;
  margin: 0;
  padding: 0;
  border: 0;
  box-sizing: border-box;
  cursor: pointer;
}

.shell-body--wide .me-home .me-card-meta {
  font-size: 13dp;
  line-height: 18dp;
}

.shell-body--wide .me-home .me-card-act:active {
  opacity: 0.6;
}

.shell-body--wide .settings-section--grouped .btn {
  display: block;
  width: auto;
  height: 50dp;
  min-height: 50dp;
  margin: 16dp 16dp 0 16dp;
  padding: 0 16dp;
  font-size: 17dp;
  line-height: 50dp;
  font-weight: bold;
  text-align: center;
}

.shell-body--wide .settings-section--grouped .btn-icon {
  display: flex;
}

.shell-body--wide .settings-pill-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  cursor: pointer;
}

.shell-body--wide .settings-pill {
  height: 32dp;
  padding: 0 16dp;
  border-radius: 16dp;
  font-family: LatoLatin;
  font-size: 15dp;
  line-height: 32dp;
  font-weight: bold;
  white-space: nowrap;
}

.shell-body--wide .settings-improve-send:disabled {
  opacity: 0.5;
}

.shell-body--wide .settings-section--grouped .settings-action-bar {
  width: auto;
}

.shell-body--wide .settings-section--grouped .settings-actions {
  display: block;
  margin-top: 0;
}

.shell-body--wide .settings-section--grouped .me-profile-actions {
  display: block;
  margin-top: 0;
}

.shell-body--wide .settings-section--grouped .group-actions {
  display: flex;
  flex-direction: row;
  /* Not .settings-toggle-row's 100%: with the 16dp margins the row ran 32dp past the screen and cut off its "?". */
  width: auto;
  margin: 16dp 16dp 0 16dp;
  gap: 8dp;
}

.shell-body--wide .settings-section--grouped .group-card .btn,
.shell-body--wide .settings-section--grouped .group-actions .btn {
  flex: 1;
  height: 36dp;
  min-height: 36dp;
  margin: 8dp 8dp 0 0;
  font-size: 15dp;
  line-height: 36dp;
}

.shell-body--wide .settings-section--grouped .group-actions .btn {
  margin: 0;
}

.shell-body--wide .me-profile-avatar-row {
  margin-bottom: 0;
}

.shell-body--wide .settings-device-actions {
  gap: 0;
}

.shell-body--wide .settings-device-title {
  gap: 8dp;
}

.shell-body--wide .group-row-body .home-edit-handle {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 50dp;
  margin: 0 -12dp 0 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  drag: drag;
  cursor: pointer;
}

.shell-body--wide .home-composer-mount {
  display: block;
  padding: 0 40dp;
}

.shell-body--wide .home-composer-mount .prompt-composer {
  flex: none;
  margin: 0 0 8dp 0;
  border-radius: 20dp;
}

.shell-body--wide .home-composer-mount .prompt-composer-status {
  margin: 12dp 16dp 0 16dp;
}

.shell-body--wide .home-composer-mount .prompt-composer-pill {
  min-height: 106dp; /* + the box's 1dp border each side = the 108dp card */
  padding: 0 16dp 48dp 16dp;
  border-radius: 20dp;
}

.shell-body--wide .home-composer-mount .prompt-composer-input {
  align-self: stretch;
  min-height: 36dp;
  padding: 12dp 0 0 0;
}

.shell-body--wide .home-composer-mount .prompt-composer-row {
  position: relative;
}

.shell-body--wide .home-composer-mount .prompt-icon-classic,
.shell-body--wide .home-composer-mount .prompt-icon-v2,
.shell-body--wide .home-composer-mount .prompt-capture-btn,
.shell-body--wide .home-composer-mount .prompt-voice-toggle-btn {
  display: none;
}

.shell-body--wide .home-composer-mount .prompt-icon-home {
  display: block;
  flex-shrink: 0;
  width: 24dp;
  height: 24dp;
}

.shell-body--wide .home-composer-mount .prompt-attach-btn {
  display: none;
}

.shell-body--wide .home-composer-mount .prompt-composer-pill .prompt-home-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  left: 4dp;
  bottom: 6dp;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  cursor: pointer;
}

.shell-body--wide .home-composer-mount .prompt-composer-row .prompt-emoji-btn {
  position: absolute;
  right: 50dp; /* the tinted circle 10dp before the Send disc (Kenneth 2026-11-10: emoji moved right, next to Send) */
  bottom: 6dp;
  z-index: 1;
  width: 44dp;
  height: 44dp;
  min-width: 44dp;
  margin: 0;
  padding: 6dp;
  box-sizing: border-box;
  border-radius: 22dp;
  background-color: transparent;
}

.shell-body--wide .home-composer-mount .prompt-emoji-btn .prompt-icon-home-emoji {
  display: block;
  width: 32dp;
  height: 32dp;
  padding: 4dp;
  box-sizing: border-box;
  border-radius: 16dp;
}

.shell-body--wide .home-composer-mount .prompt-composer-row .prompt-send-btn {
  display: flex;
  position: absolute;
  right: 10dp;
  bottom: 10dp;
  z-index: 1;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin: 0;
  border-radius: 18dp;
}

.shell-body--wide .home-composer-mount .prompt-send-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  border-radius: 18dp;
}

.shell-body--wide .home-composer-mount .prompt-composer-label--thread {
  display: none;
}

.shell-body--wide .home-composer-mount .prompt-composer-label--home {
  display: block;
  position: absolute;
  top: 12dp;
  left: 16dp;
  margin: 0;
  font-size: 17dp;
  line-height: 24dp;
  pointer-events: none;
}

.shell-body--wide .storage-section .settings-danger-zone .settings-action-bar {
  width: auto;
  margin: 12dp 16dp 0 16dp;
}

.shell-body--wide .contacts-index {
  top: 56dp;
}
/* END phone page rules */

/* ================= Contacts (design step 3, page A; contacts_wide.rml, contact_detail_wide.rml) =================
   Hand rules that follow the generated phone page rules above: the list column's layout, the rounded row, the detail
   column's width. The look of the avatar, name, star, A-Z strip and the contact page's cards is the phone's (generated). */
.shell-body--wide .contacts-panel--wide {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0;
}

.shell-body--wide .contacts-wide-scroll {
  flex: 1 1 0;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 0 8dp;
  box-sizing: border-box;
}

.shell-body--wide .contacts-panel--wide .contacts-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 60dp;
  min-height: 60dp;
  margin: 0 0 2dp 0;
  padding: 0 12dp;
  gap: 12dp;
  border-width: 0;
  border-radius: 10dp;
}

.shell-body--wide .contacts-panel--wide .contacts-row-body {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.shell-body--wide .contacts-panel--wide .contacts-section-header {
  padding: 8dp 12dp 4dp 12dp;
}

.shell-body--wide .contacts-panel--wide .contacts-empty {
  padding: 8dp 12dp;
}

/* The A-Z strip rides the list's right edge, between the search field and the bottom of the column. */
.shell-body--wide .contacts-panel--wide .contacts-index {
  top: 112dp;
  bottom: 12dp;
}

/* The selected contact: the phone's page in a centred column, not stretched across the window. */
.shell-body--wide .contact-detail-panel {
  box-sizing: border-box;
  width: 100%;
  max-width: 640dp;
  margin: 0 auto;
  padding: 24dp 16dp 32dp 16dp;
  overflow-y: auto;
}

/* The New chat tiles (New group, Add contact) at the top of the list, as on the phone's New chat page. */
.shell-body--wide .contacts-panel--wide .nc-actions {
  display: flex;
  flex-direction: row;
  gap: 8dp;
  padding: 4dp 0 8dp 0;
}

.shell-body--wide .contacts-panel--wide .nc-action {
  flex: 1 1 0;
  min-width: 0;
  height: 56dp;
  min-height: 56dp;
  padding: 0 10dp;
  gap: 8dp;
  border-radius: 14dp;
}

.shell-body--wide .contacts-panel--wide .nc-action-icon {
  width: 36dp;
  height: 36dp;
  border-radius: 10dp;
}

.shell-body--wide .contacts-panel--wide .nc-action-label {
  font-size: 15dp;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* The scan button beside the plus: the phone's Chats bar has it; round, 36dp like the plus. */
.shell-body--wide .contacts-wide-scan-wrap {
  display: block;
  margin-right: 8dp;
}

.shell-body--wide .contacts-wide-scan {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  padding: 0;
  border: 0;
  border-radius: 18dp;
}

/* Hover buttons (the phone's swipe: Voice, Video, More; Info is the click). Out of the way until the pointer is over
   the row; 44dp targets that take the width from the name, which clips. */
.shell-body--wide .contacts-row-actions {
  display: none;
  flex: none;
  flex-direction: row;
  align-items: center;
}

.shell-body--wide .contacts-row:hover .contacts-row-actions {
  display: flex;
}

.shell-body--wide .contacts-row-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44dp;
  height: 44dp;
  padding: 0;
  border: 0;
  border-radius: 22dp;
}

.shell-body--wide .contacts-panel--wide .contacts-row-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ================= Settings (design step 3, page B; settings_wide.rml) =================
   The list column is the phone's Settings page (card, three groups) under a title like the other lists; the page of the
   picked row is settings_detail.rml in the right column, as wide as the phone's page, centred. */
.shell-body--wide .settings-panel--wide {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0;
}

.shell-body--wide .settings-wide-scroll {
  flex: 1 1 0;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 0 0 24dp 0;
  box-sizing: border-box;
}

.shell-body--wide .settings-panel--wide .group-row {
  border-radius: 10dp;
}

/* The phone's card puts the name and Copy / Share / QR code on one row (390dp); the list column is narrower, so the
   three buttons go on a row of their own under the name. */
.shell-body--wide .settings-panel--wide .me-home .me-card-row {
  flex-direction: column;
  align-items: stretch;
  padding-bottom: 8dp;
}

.shell-body--wide .settings-panel--wide .me-home .me-card-main {
  flex: none;
}

.shell-body--wide .settings-panel--wide .me-home .me-card-acts {
  justify-content: space-around;
  margin: 0 8dp;
}

.shell-body--wide .settings-detail-panel {
  align-items: center;
  padding: 0;
}

.shell-body--wide .settings-detail-panel .settings-detail-header {
  flex: none;
  width: 100%;
  max-width: 640dp;
  height: 64dp;
  margin: 0;
  padding: 0 16dp;
  box-sizing: border-box;
}

.shell-body--wide .settings-detail-panel .settings-header-title {
  font-size: 22dp;
  line-height: 28dp;
}

.shell-body--wide .settings-detail-panel .settings-detail-body {
  flex: 1 1 0;
  width: 100%;
  max-width: 640dp;
  padding: 0 16dp 32dp 16dp;
  box-sizing: border-box;
  gap: 0;
}

/* Phone-only pieces of a settings page. The phone's pushed pages and pickers (a PIN row that opens a page, ...) need its
   compact page stack, so the wide layout keeps showing the desktop's inline version of those and hides the phone's:
   `.group-row`'s own display (above) would otherwise show them. Pieces marked `settings-wide-too` have nothing page-like
   in them (Appearance: the little assistant's switches, look and size) and show here as on the phone. */
.shell-body--wide .settings-phone-only {
  display: none;
}

.shell-body--wide .settings-wide-too.settings-phone-only {
  display: block;
}

.shell-body--wide .ai-look-picker.settings-wide-too.settings-phone-only {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 12dp 4dp;
  box-sizing: border-box;
}

/* The heading of a settings block that has a "?" beside it (Recovery phrase): the phone shows no headings, but without it
   the "?" would stand alone. */
.shell-body--wide .settings-q-head {
  justify-content: flex-start;
  gap: 4dp;
}

.shell-body--wide .settings-q-head .group-head {
  display: block;
  margin: 20dp 0 6dp 16dp;
}

.shell-body--wide .settings-section--grouped .group-head.settings-wide-too {
  display: none;
}

/* My profile: the phone's rows (nickname that opens its prompt, the account id, the status and Update / Set up) in place
   of the desktop's field, note and buttons; the card at the top of the list already has Copy / Share / QR code. */
.shell-body--wide .settings-detail--profile .settings-phone-only {
  display: block;
}

.shell-body--wide .settings-detail--profile .group-head.settings-phone-only {
  display: none;
}

.shell-body--wide .settings-detail--profile .settings-desktop-only,
.shell-body--wide .settings-detail--profile .btn.settings-desktop-only {
  display: none;
}

/* ================= AI (design step 3, page C; ai_list_wide.rml, the AI home in home.rml) =================
   The list column is the phone's "Conversation history" drawer; the right column is the AI home (the mascot over the
   phone's two-line ask-AI card, then the chips) or the picked conversation. The composer card itself is the phone's
   (generated above). */
.shell-body--wide .ai-list-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0;
}

.shell-body--wide .ai-list-sessions {
  flex: 1 1 0;
  min-height: 0;
  overflow-y: auto;
}

.shell-body--wide .ai-list-count {
  flex: none;
  padding: 8dp 16dp 12dp 16dp;
  text-align: center;
}

.shell-body--wide .ai-list-count .ai-drawer-count-text {
  margin: 0;
  font-size: 13dp;
  line-height: 18dp;
}

/* The AI home: no "PP" heading (the phone has none); the mascot, the card, the chips, as a centred column. */
.shell-body--wide .home-header {
  display: none;
}

.shell-body--wide .home-landing--minimal .home-logo {
  display: block;
  flex: none;
  height: 116dp;
  margin: 0 0 4dp 0;
  text-align: center;
}

.shell-body--wide .home-landing--minimal .home-logo img {
  width: 100dp;
  height: 100dp;
  border-radius: 22dp;
}

.shell-body--wide .home-landing--minimal .home-logo--mascot .home-mascot.ai-dot {
  position: relative;
  display: block;
  width: 96dp;
  height: 96dp;
  margin: 10dp auto 0 auto;
}

.shell-body--wide .home-landing-inner {
  max-width: 560dp;
}

.shell-body--wide .home-composer-mount {
  padding: 0;
}

/* The AI list's own header is "Conversation history": a little smaller than the other columns' one-word titles. */
.shell-body--wide .ai-list-header .sidebar-header-title {
  font-size: 22dp;
}

/* The tail of a picture card (the last picture of a run): the phone draws it behind the card (z-index -1) so its inner
   half does not cover the picture's corner; in the wide transcript that put it behind the pane's surface too and no hook
   showed. The corner it sits on is the card's footer strip (the time under the picture), so the tail is drawn in front. */
.shell-body--wide .chat-attachment-card--image .bubble-tail {
  z-index: 0;
}

/* The full emoji picker (opened by the plus in the reaction row or the hover bar): a raised card centred over the
   conversation, like the floating menus, in the shell's frame (key emoji_picker). */
.shell-body--wide .shell-frame--emoji_picker {
  top: 8%;
  bottom: 8%;
  left: 20%;
  right: 20%;
  border-radius: 16dp;
}

/* ---- The send-preview page (picture_send_wide.rml): a tray rising from the composer's place at the bottom of the
   conversation column. The shell's frame (key picture_send) is the column's own box, left and right set by ShellHost
   (ApplySafeAreaLayout) from the pane, top and bottom the layer's; it carries the light dim and takes no click itself
   (they fall through to the scrim under it, as a click beside the page always did). Its overlay body is the tray:
   content-sized, bottom-anchored, 70% of the column's height at most, rounded on top, frosted while Transparency is on
   (shell-frame--frost, ShellLayoutRml) and solid otherwise. The frame's own close button is not used: the tray has its
   x. The stage has a height of its own (a share of the window's) so the picture's fit does not depend on the tray's. ---- */
.shell-body--wide .shell-frame--picture_send {
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  justify-content: flex-end;
  padding: 0;
  border-radius: 0;
  pointer-events: none;
}

.shell-body--wide .shell-frame--picture_send .shell-close-btn {
  display: none;
}

.shell-body--wide .shell-frame--picture_send .shell-overlay-body {
  flex: 0 1 auto;
  min-height: 0;
  max-height: 70%;
  border-width: 1dp 1dp 0 1dp;
  border-radius: 20dp 20dp 0 0;
  overflow: hidden;
  pointer-events: auto;
}

.shell-body--wide .picture-send--wide {
  flex: none;
  height: auto;
  padding: 16dp 24dp 18dp 24dp;
}

.shell-body--wide .picture-send--wide .ps-top {
  flex-shrink: 0;
  height: 32dp;
  padding: 0;
}

.shell-body--wide .picture-send--wide .ps-recipient {
  margin: 0;
}

.shell-body--wide .picture-send--wide .ps-title {
  flex: none;
  margin: 0 0 0 10dp;
  font-size: 13dp;
  font-weight: normal;
  text-align: left;
}

.shell-body--wide .picture-send--wide .ps-top-fill {
  flex: 1;
  min-width: 0;
}

.shell-body--wide .picture-send--wide .ps-x {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28dp;
  height: 28dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 14dp;
  cursor: pointer;
}

.shell-body--wide .picture-send--wide .ps-stage {
  flex: none;
  height: 28vh;
  max-height: 300dp;
  margin: 14dp 0 0 0;
  border-radius: 14dp;
}

/* One file alone: no picture to make room for, the tray is as tall as the tile. */
.shell-body--wide .picture-send--wide .ps-stage--tile {
  height: auto;
  max-height: none;
}

.shell-body--wide .picture-send--wide .ps-image-clip {
  flex-shrink: 0;
  border-radius: 14dp;
  overflow: hidden;
}

.shell-body--wide .picture-send--wide .ps-file {
  width: 360dp;
  max-width: 100%;
}

.shell-body--wide .picture-send--wide .ps-strip {
  flex-shrink: 0;
  height: 76dp;
  gap: 10dp;
  padding: 12dp 12dp 4dp 4dp;
  margin-top: 2dp;
}

.shell-body--wide .picture-send--wide .ps-cell,
.shell-body--wide .picture-send--wide .ps-cell-clip {
  width: 56dp;
  height: 56dp;
}

.shell-body--wide .picture-send--wide .ps-cell:first-child {
  margin-left: auto;
}

.shell-body--wide .picture-send--wide .ps-cell:last-child {
  margin-right: auto;
}

.shell-body--wide .picture-send--wide .ps-cell-clip {
  border-radius: 12dp;
}

/* The thumbnail's offsets are worked out for a 64dp box: shift it so the 52dp window inside the 2dp ring shows its middle. */
.shell-body--wide .picture-send--wide .ps-cell-image {
  position: relative;
  left: -6dp;
  top: -6dp;
}

.shell-body--wide .picture-send--wide .ps-badge-dot {
  width: 18dp;
  height: 18dp;
  border-radius: 9dp;
}

/* The bottom row, where the composer sits: the "original" chip, then the pill field taking the rest. */
.shell-body--wide .picture-send--wide .ps-bottom {
  flex-shrink: 0;
  flex-direction: row;
  align-items: flex-end;
  gap: 10dp;
  padding: 14dp 0 0 0;
}

.shell-body--wide .picture-send--wide .ps-field {
  flex: 1;
  min-width: 0;
}

.shell-body--wide .picture-send--wide .ps-original {
  flex-shrink: 0;
  align-self: flex-end;
  margin: 0 0 4dp 0;
}

/* Cancel is quiet: small grey words under the row (the x at the top does the same). */
.shell-body--wide .picture-send--wide .ps-cancel {
  flex-shrink: 0;
  align-self: center;
  height: auto;
  margin: 8dp 0 0 0;
  padding: 6dp 14dp;
  border: 0;
  border-radius: 16dp;
  line-height: 20dp;
  font-size: 14dp;
  text-align: center;
  cursor: pointer;
}

/* ---- Modal panels on the desktop (PaneSpec::modal; ShellLayoutRml::Overlays): the scrim is fixed to the whole window,
   over the rail, the lists, the transcript and the status bar (which drops under it, .shell-body--modal), and swallows
   clicks, the wheel and hover; the stage centres the frame in the window, 48dp clear of every edge (the frame takes the
   stage's full height: the engine does not shrink nested flex boxes under a content-sized parent, so a definite height
   keeps the header and the bar fixed and the body scrolling). The engine's
   `fixed` is relative to the nearest positioned ancestor (#shell-root, inset by the title bar and the status bar), so
   ShellHost sets the scrim's and the stage's top / bottom to minus those insets. The frame is the
   shell's own (radius 16, the stacked shadow, the close button at the top right), as the send-preview page's. ---- */
.shell-body--wide .shell-layer-modal .shell-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-body--wide.shell-body--modal .shell-statusbar {
  z-index: 40;
}

.shell-body--wide .shell-modal-stage {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 48dp;
  box-sizing: border-box;
  pointer-events: none;
}

.shell-body--wide .shell-modal-stage .shell-frame {
  position: relative;
  top: auto;
  left: auto;
  right: auto;
  bottom: auto;
  flex: 0 1 720dp;
  min-width: 0;
  max-width: 720dp;
  height: 100%;
  padding: 0;
  border-radius: 16dp;
  pointer-events: auto;
}

/* ---- The news reader (news_reader_wide.rml): the modal frame above, 720dp wide at most and the window less 96dp (the
   wide window is 768dp or more). The header (the title, three lines at most) and the bar stay; the digest scrolls. ---- */
.shell-body--wide .news-reader--wide {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

/* The title keeps clear of the frame's close button. */
.shell-body--wide .news-reader-head--wide {
  flex-shrink: 0;
  padding: 24dp 64dp 4dp 32dp;
  box-sizing: border-box;
}

.shell-body--wide .news-reader--wide .news-reader-title {
  max-height: 78dp;
  margin: 0 0 12dp 0;
  overflow: hidden;
}

.shell-body--wide .news-reader--wide .news-reader-translated {
  margin: -4dp 0 8dp 0;
}

.shell-body--wide .news-reader-scroll--wide {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 4dp 32dp 16dp 32dp;
  box-sizing: border-box;
}

.shell-body--wide .news-reader-bar--wide {
  flex-shrink: 0;
  padding: 12dp 32dp 24dp 32dp;
}

.shell-body--wide .news-reader--wide .news-reader-open,
.shell-body--wide .news-reader--wide .news-reader-step {
  height: 44dp;
  border-radius: 22dp;
  line-height: 44dp;
  cursor: pointer;
}

/* "Try again" under the failure line: the same secondary pill, 44dp on the desktop. */
.shell-body--wide .news-reader--wide .news-reader-retry {
  height: 44dp;
  border-radius: 22dp;
  line-height: 44dp;
  cursor: pointer;
}

/* ---- The Groups list (group_list_wide.rml): the phone's page in a centred column, like the contact page ---- */
.shell-body--wide .group-list-wide {
  box-sizing: border-box;
  padding-bottom: 32dp;
}

.shell-body--wide .group-list-column {
  box-sizing: border-box;
  width: 100%;
  max-width: 640dp;
  margin: 0 auto;
  padding: 0 16dp;
}

.shell-body--wide .group-list-wide-title {
  margin: 8dp 0 12dp 0;
  font-size: 28dp;
  line-height: 34dp;
  font-weight: bold;
}

.shell-body--wide .group-list-row {
  cursor: pointer;
}

/* ---- Choosing messages to forward (chat_wide.rml, composer_wide.rml): the phone's bars, in the conversation column.
   The top bar takes the header's place (the strip's material stays under it); the Forward button takes the composer's
   place, one 160dp pill on the strip's centre line; a row makes room for its tick, and its cover (above the
   hover bar and the content, whose own clicks it takes) turns every click on the row into a tick. ---- */
.shell-body--wide .chat-header > .chat-forward-top {
  position: relative;
  padding: 0 8dp 0 8dp;
}

.shell-body--wide .shell-pane-composer .chat-forward-bar {
  margin: 0;
  padding: 0 0 0 0;
}

.shell-body--wide .shell-pane-composer .chat-forward-next {
  width: 160dp;
  margin: 0 auto;
}

/* A row in the mode is its own stacking context (components.rcss), under the composer strip (z-index 2); repeated here
   so the wide rule keeps it. */
.shell-body--wide .message-row-forward-mode {
  padding-left: 40dp;
  z-index: 1;
}

.shell-body--wide .message-forward-check {
  z-index: 8;
  pointer-events: none;
}

.shell-body--wide .message-forward-cover {
  z-index: 7;
}

/* ---- Forward to (people_picker_wide.rml): a centred card in the modal frame, 480dp wide and 640dp high at most, the
   window less 96dp when that is less. The title (clear of the frame's close button) and the search stay on top, the
   chats scroll, Cancel and Send stay at the bottom. ---- */
.shell-body--wide .shell-modal-stage .shell-frame--people_picker {
  flex: 0 1 480dp;
  max-width: 480dp;
  max-height: 640dp;
}

.shell-body--wide .people-picker--wide {
  gap: 0;
  padding: 0;
}

.shell-body--wide .people-picker-wide-head {
  flex-shrink: 0;
  padding: 20dp 64dp 8dp 24dp;
}

.shell-body--wide .people-picker-wide-search {
  flex-shrink: 0;
  padding: 4dp 24dp 8dp 24dp;
}

.shell-body--wide .people-picker-wide-preview {
  flex-shrink: 0;
  margin: 0 24dp 8dp 24dp;
}

.shell-body--wide .people-picker-wide-refusal {
  flex-shrink: 0;
  margin: 0 24dp 8dp 24dp;
}

.shell-body--wide .people-picker-wide-preview {
  max-height: 188dp;
  overflow-y: auto;
}

.shell-body--wide .people-picker-wide-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 0 16dp 0 16dp;
}

.shell-body--wide .people-picker--wide .people-picker-row {
  min-height: 48dp;
  box-sizing: border-box;
}

.shell-body--wide .people-picker-wide-foot {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 12dp;
  padding: 12dp 24dp 20dp 24dp;
}

.shell-body--wide .people-picker-wide-foot .btn {
  height: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0 24dp;
  border-radius: 22dp;
  line-height: 44dp;
  white-space: nowrap;
}

/* The "Forwarding 2/7" page (forward_progress_wide.rml): a small centred card (340dp wide, as tall as its content) in the
   modal frame (PaneSpec::modal, as "Forward to"), over the window-wide dimmed scrim, so the chat stays visible behind it.
   The frame is the card (colour, radius and shadow in colors.rcss.tmpl, the close button at its corner); the phone's
   full-screen layer (components.rcss) is turned into an ordinary block inside it. The surface is translucent (the chat
   shows through) but not blurred: the wide frame's blur budget (two) is the chat's own header and composer bars, and a
   blur of the window behind the card is not worth the cost. */
.shell-body--wide .shell-modal-stage .shell-frame--forward_progress {
  flex: 0 1 340dp;
  width: 340dp;
  max-width: 340dp;
  height: auto;
  max-height: 100%;
}

/* The stage takes the clicks beside the card (the scrim under it would close the layer, which stops the forward). */
.shell-body--wide .shell-modal-stage--forward_progress {
  pointer-events: auto;
}

.shell-body--wide .shell-frame--forward_progress .shell-overlay-body {
  flex: 0 1 auto;
  min-height: 0;
  padding: 0;
}

.shell-body--wide .forward-progress--wide {
  position: relative;
  top: auto;
  left: auto;
  right: auto;
  bottom: auto;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.shell-body--wide .forward-progress-card {
  width: 100%;
  max-height: 100%;
  overflow-y: auto;
  padding: 40dp 28dp 28dp 28dp;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.shell-body--wide .forward-progress-card .forward-progress-title {
  margin-bottom: 20dp;
}

.shell-body--wide .forward-progress-card .forward-progress-stay {
  margin-top: 16dp;
}

.shell-body--wide .forward-progress-card .forward-progress-actions {
  margin-top: 20dp;
}

.shell-body--wide .forward-progress-card .forward-progress-btn {
  min-height: 44dp;
}
