/* Wide-screen (desktop and wide iPad) structure and sizes — DEV/DESIGN-desktop-ui.md step 1.
 *
 * RULES (checked by src/gui/tests/wide_stylesheet_test.cpp):
 *   1. Every selector starts with `.shell-body--wide`, which window_shell.rml sets while layout_mode == 'expanded'
 *      (RCSS has no :not(), so "wide only" needs a wide root of its own). Nothing here can match under the phone's
 *      `.shell-body--compact`.
 *   2. No colours. Colours of wide-only things live in colors.rcss.tmpl / theme_tokens.tsv (generated into
 *      colors-light.rcss / colors-dark.rcss), under the same `.shell-body--wide` root.
 *   3. Page layouts that differ get their own `<page>_wide.rml`; this file only holds the sizes, the scale and the
 *      shared wide components (floating menu, result pill) and the base look (soft surfaces).
 *
 * Loaded after components.rcss (equal specificity: this file wins) and before the colour files.
 */

/* ---- Scale (the mockup's style page, sections 1-3). RCSS has no variables, so the scale is a set of classes. ---- */

/* Spacing: 4 / 8 / 12 / 16 / 24 / 32. Gap between flex children, and padding. */
.shell-body--wide .w-gap-4 { gap: 4dp; }
.shell-body--wide .w-gap-8 { gap: 8dp; }
.shell-body--wide .w-gap-12 { gap: 12dp; }
.shell-body--wide .w-gap-16 { gap: 16dp; }
.shell-body--wide .w-gap-24 { gap: 24dp; }
.shell-body--wide .w-gap-32 { gap: 32dp; }
.shell-body--wide .w-pad-4 { padding: 4dp; }
.shell-body--wide .w-pad-8 { padding: 8dp; }
.shell-body--wide .w-pad-12 { padding: 12dp; }
.shell-body--wide .w-pad-16 { padding: 16dp; }
.shell-body--wide .w-pad-24 { padding: 24dp; }
.shell-body--wide .w-pad-32 { padding: 32dp; }

/* Type: six sizes only. */
.shell-body--wide .w-type-title { font-size: 24dp; font-weight: bold; }
.shell-body--wide .w-type-heading { font-size: 17dp; font-weight: bold; }
.shell-body--wide .w-type-row { font-size: 16dp; }
.shell-body--wide .w-type-body { font-size: 15dp; }
.shell-body--wide .w-type-secondary { font-size: 14dp; }
.shell-body--wide .w-type-small { font-size: 12dp; }

/* Nothing clickable is lower than 32dp. */
.shell-body--wide .w-target { min-height: 32dp; box-sizing: border-box; }

/* ---- Columns: icon rail 64 | list 280..480 (default 320) | conversation >= 420 ----
   64 + 280 + 420 = 764, so the 768 window keeps two columns. The list column gives way first (flex-shrink), the
   conversation never goes below its floor. With the auxiliary (Ask-AI) pane open the three-column arithmetic does not
   fit below ~1100; until step 3 turns that pane into an overlay drawer, such a row keeps the old floors (200 / 240). */
.shell-body--wide .shell-nav-rail {
  flex: 0 0 64dp;
}

.shell-body--wide .shell-pane-secondary {
  min-width: 280dp;
}

.shell-body--wide .shell-pane-primary {
  min-width: 420dp;
}

.shell-body--wide .shell-pane-row--aux .shell-pane-secondary {
  min-width: 200dp;
}

.shell-body--wide .shell-pane-row--aux .shell-pane-primary {
  min-width: 240dp;
}

/* ---- Floating menu (right-click / header "more" / pick lists): one style, contents unchanged ---- */
.shell-body--wide #context-menu-panel {
  min-width: 190dp;
  padding: 6dp;
  border-radius: 12dp;
}

.shell-body--wide #context-menu-panel .context-menu-item {
  min-height: 34dp;
  gap: 10dp;
  padding: 0 12dp;
  border-radius: 6dp;
}

.shell-body--wide #context-menu-panel .context-menu-item-label {
  font-size: 15dp;
  white-space: nowrap;
}

/* The touch text bar of an input field keeps its own shape. */
.shell-body--wide .context-menu-layer--bar #context-menu-panel {
  min-width: 0;
  padding: 4dp;
  border-radius: 8dp;
}

.shell-body--wide .context-menu-layer--bar #context-menu-panel .context-menu-item {
  min-height: 36dp;
  padding: 6dp 12dp;
  border-radius: 6dp;
}

/* ---- Result pill: a white pill at the bottom of the content area, centred, up to 480dp wide, one at a time.
   ShellHost sets the stack's left (the columns to its left) and bottom (over the status bar and composer). ---- */
.shell-body--wide .shell-chrome {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.shell-body--wide .shell-toast-stack {
  left: 0;
  right: 0;
  top: auto;
  display: block;
  text-align: center;
  pointer-events: none;
}

.shell-body--wide .shell-chrome .shell-toast {
  display: inline-block;
  max-width: 480dp;
  border-width: 1dp;
  padding: 8dp 16dp;
  margin: 0;
  border-radius: 20dp;
  box-sizing: border-box;
  pointer-events: none;
}

.shell-body--wide .shell-toast-text {
  font-size: 15dp;
  line-height: 20dp;
  text-align: center;
}

/* ---- Base look (the mockup's style page): soft surfaces, large corners, hairlines instead of outlines ----
   Radius scale from the mockup: 6 menu row, 9-10 buttons / fields / list rows, 12 menus and tabs, 14 cards, 18
   bubbles, 20-21 the input pill. A line is a 0.5dp hairline; a box is a filled surface, not an outline. Colours: the
   end of colors.rcss.tmpl (same wide root). Shared rules that draw the heavy outlines (components.rcss, colors) are
   not edited: these override them under the wide root. */

/* Column frame and dividers: a hairline, not a 1dp line. */
.shell-body--wide .shell-nav-rail {
  border-right-width: 0.5dp;
}

.shell-body--wide .shell-pane-secondary {
  border-right-width: 0.5dp;
}

.shell-body--wide .shell-pane-auxiliary {
  border-left-width: 0.5dp;
}

.shell-body--wide .shell-statusbar,
.shell-body--wide .shell-toolbar,
.shell-body--wide .sidebar-footer,
.shell-body--wide .surface-chrome {
  border-top-width: 0.5dp;
}

.shell-body--wide .shell-nav-tab {
  border-radius: 12dp;
}

/* List rows (chats, settings, contacts): no outline; the hover and the selected row are rounded fills. */
.shell-body--wide .sidebar-session,
.shell-body--wide .settings-row,
.shell-body--wide .contacts-row,
.shell-body--wide .contacts-thread-row {
  border-width: 0;
  border-radius: 10dp;
}

/* Cards and group boxes: a filled surface with a large corner, no outline. */
.shell-body--wide .card,
.shell-body--wide .me-profile-card,
.shell-body--wide .contact-profile-card,
.shell-body--wide .chat-form,
.shell-body--wide .chat-empty {
  border-width: 0;
  border-radius: 14dp;
}

/* Fields and search: filled and rounded; the border is kept (transparent, a colour) so focus does not move anything. */
.shell-body--wide .field,
.shell-body--wide .chat-form-field {
  border-radius: 10dp;
}

.shell-body--wide .chat-search {
  border-radius: 10dp;
}

/* The input pill keeps its large corner and gets a hairline. */
.shell-body--wide .prompt-composer-pill {
  border-width: 0.5dp;
  border-radius: 21dp;
}

/* Chat header: no coloured side bar and tint; a hairline under it. */
.shell-body--wide .chat-shell--e2e .chat-header,
.shell-body--wide .chat-shell--ai .chat-header,
.shell-body--wide .chat-shell--public .chat-header,
.shell-body--wide .chat-shell--group .chat-header {
  border-left-width: 0;
  padding-left: 16dp;
  border-radius: 0;
}

/* Menus and the result pill: the same hairline. */
.shell-body--wide #context-menu-panel,
.shell-body--wide .shell-chrome .shell-toast {
  border-width: 0.5dp;
}

/* ================= The Chat section (design step 2, mockup page 2) ================= */

/* ---- List column: header, search, rows with avatars ---- */
.shell-body--wide .sidebar-panel {
  padding: 0;
}

.shell-body--wide .sidebar-header {
  margin-bottom: 0;
  padding: 16dp 16dp 8dp 16dp;
}

.shell-body--wide .sidebar-header-title {
  font-size: 24dp;
  line-height: 30dp;
}

.shell-body--wide .sidebar-new-chat {
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  border-radius: 18dp;
}

.shell-body--wide .chat-search {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  height: 36dp;
  margin: 4dp 16dp 8dp 16dp;
  padding: 0 12dp;
  box-sizing: border-box;
  border-radius: 10dp;
}

.shell-body--wide .chat-search-input {
  height: 36dp;
  padding: 8dp 0 8dp 8dp;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-body--wide .chat-search-label {
  left: 36dp;
  height: 36dp;
  font-size: 15dp;
  line-height: 36dp;
}

.shell-body--wide .sidebar-sessions {
  overflow-x: hidden;
  padding: 0 8dp;
  box-sizing: border-box;
}

.shell-body--wide .sidebar-tip,
.shell-body--wide .sidebar-reconnect-entry,
.shell-body--wide .sidebar-archived-entry {
  margin-left: 8dp;
  margin-right: 8dp;
}

.shell-body--wide .sidebar-session {
  min-height: 68dp;
  margin-bottom: 2dp;
  padding: 0 12dp;
  gap: 12dp;
}

.shell-body--wide .chat-row-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 48dp;
  height: 48dp;
  border-radius: 24dp;
  overflow: hidden;
}

.shell-body--wide .chat-row-avatar .avatar-photo {
  width: 48dp;
  height: 48dp;
}

.shell-body--wide .sidebar-session-icon,
.shell-body--wide .sidebar-session-flag--muted {
  display: none;
}

.shell-body--wide .chat-row-type,
.shell-body--wide .chat-row-mute,
.shell-body--wide .chat-row-blocked {
  display: block;
  flex-shrink: 0;
}

.shell-body--wide .chat-row-type,
.shell-body--wide .chat-row-blocked {
  width: 14dp;
  height: 14dp;
}

.shell-body--wide .chat-row-mute {
  width: 16dp;
  height: 16dp;
}

.shell-body--wide .sidebar-session-body {
  min-height: 48dp;
  justify-content: center;
  gap: 2dp;
}

.shell-body--wide .sidebar-session-line {
  min-height: 22dp;
}

.shell-body--wide .sidebar-session-line + .sidebar-session-line {
  min-height: 20dp;
}

.shell-body--wide .sidebar-session-title {
  font-size: 16dp;
  line-height: 22dp;
  font-weight: bold;
}

.shell-body--wide .sidebar-session-preview,
.shell-body--wide .sidebar-session-mention {
  font-size: 14dp;
  line-height: 20dp;
}

.shell-body--wide .sidebar-session-date {
  font-size: 12dp;
  line-height: 22dp;
}

.shell-body--wide .sidebar-unread {
  min-width: 20dp;
  height: 20dp;
  padding: 0 6dp;
  box-sizing: border-box;
  border-radius: 10dp;
  font-size: 12dp;
  font-weight: bold;
  line-height: 20dp;
}

/* ---- Conversation: header ---- */
.shell-body--wide .chat-panel {
  padding: 0;
}

.shell-body--wide .chat-header {
  height: 64dp;
  margin: 0;
  padding: 0 16dp;
  border-radius: 0;
  border-bottom-width: 0.5dp;
}

.shell-body--wide .chat-header-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12dp;
}

.shell-body--wide .chat-header-text {
  flex: 1;
  min-width: 0;
}

.shell-body--wide .chat-header-avatar-hit {
  display: block;
  flex-shrink: 0;
  padding: 2dp;
  margin: 0 -2dp;
}

.shell-body--wide .chat-header-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 40dp;
  height: 40dp;
  border-radius: 20dp;
  overflow: hidden;
}

.shell-body--wide .chat-header-avatar .avatar-photo {
  width: 40dp;
  height: 40dp;
}

.shell-body--wide .chat-header-avatar .chat-row-avatar-letter {
  font-size: 17dp;
  line-height: 22dp;
}

.shell-body--wide .chat-header-avatar .chat-row-avatar-icon {
  width: 22dp;
  height: 22dp;
}

.shell-body--wide .chat-header-type-icon {
  display: none;
}

.shell-body--wide .chat-header-title {
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shell-body--wide .chat-header-meta-row {
  margin-top: 0;
}

.shell-body--wide .chat-header-subtitle {
  font-size: 12dp;
  line-height: 16dp;
}

.shell-body--wide .chat-header-actions {
  gap: 4dp;
}

.shell-body--wide .chat-header-call-btn,
.shell-body--wide .chat-header-more-btn,
.shell-body--wide .chat-header-search-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36dp;
  height: 36dp;
  min-width: 36dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 9dp;
  cursor: pointer;
}

.shell-body--wide .chat-header-call-btn--join {
  width: auto;
  padding: 0 14dp;
  border-radius: 18dp;
}

.shell-body--wide .chat-header-call-btn svg,
.shell-body--wide .chat-header-more-btn svg,
.shell-body--wide .chat-header-search-btn svg {
  flex-shrink: 0;
  width: 20dp;
  height: 20dp;
}

/* ---- Conversation: messages ---- */
.shell-body--wide .messages {
  margin-bottom: 0;
  padding: 16dp 24dp 12dp 24dp;
}

.shell-body--wide .message-row {
  position: relative;
  margin: 2dp 0 0 0;
}

.shell-body--wide .message-row-run-start {
  margin-top: 10dp;
}

.shell-body--wide .message-row-peer,
.shell-body--wide .message-row-ai {
  padding-right: 0;
}

.shell-body--wide .message-row-user {
  padding-left: 0;
}

/* The message under the pointer: a small row at its top (the used reactions, +, reply, more). */
.shell-body--wide .msg-bar {
  display: none;
  position: absolute;
  top: -14dp;
  z-index: 6;
  flex-direction: row;
  align-items: center;
  gap: 2dp;
  padding: 3dp;
  border-radius: 12dp;
}

.shell-body--wide .message-row-user .msg-bar {
  right: 12dp;
}

.shell-body--wide .message-row-peer .msg-bar,
.shell-body--wide .message-row-ai .msg-bar {
  left: 44dp;
}

.shell-body--wide .message-row:hover > .msg-bar {
  display: flex;
}

.shell-body--wide .msg-bar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34dp;
  height: 28dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 7dp;
  cursor: pointer;
}

.shell-body--wide .msg-bar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30dp;
  height: 28dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 7dp;
  cursor: pointer;
}

/* The emoji sits in a span of its own, as the message menu's quick row (.context-menu-item-label) does: text straight
   in the flex button was not drawn. */
.shell-body--wide .msg-bar-emoji-glyph {
  flex: 0 0 auto;
  font-size: 18dp;
  line-height: 24dp;
  white-space: nowrap;
}

.shell-body--wide .msg-bar-sep {
  width: 1dp;
  height: 18dp;
  margin: 0 3dp;
}

.shell-body--wide .msg-bar-btn svg {
  flex-shrink: 0;
  width: 18dp;
  height: 18dp;
}

/* ---- Composer ---- */
.shell-body--wide .shell-composer-mount {
  padding: 10dp 16dp 12dp 16dp;
  box-sizing: border-box;
}

.shell-body--wide .prompt-composer-row {
  align-items: center;
  gap: 6dp;
}

/* Wide row (composer_wide.rml): the paperclip, emoji, microphone and Send sit on the row's centre line; the microphone
   (the phone's end key, hidden by default) shows here. */
.shell-body--wide .prompt-composer--wide .prompt-composer-row .prompt-voice-toggle-btn,
.shell-body--wide .prompt-composer--wide .prompt-composer-row .prompt-emoji-btn,
.shell-body--wide .prompt-composer--wide .prompt-composer-row .prompt-attach-btn,
.shell-body--wide .prompt-composer--wide .prompt-composer-row .prompt-send-btn {
  margin-bottom: 0;
}

.shell-body--wide .prompt-composer--wide .prompt-composer-row .prompt-voice-toggle-btn--end {
  display: flex;
  width: 40dp;
  min-width: 40dp;
  height: 40dp;
  border-radius: 20dp;
}

.shell-body--wide .prompt-composer--wide .prompt-composer-row > .prompt-attach-btn,
.shell-body--wide .prompt-composer--wide .prompt-composer-row > .prompt-emoji-btn {
  width: 40dp;
  min-width: 40dp;
  height: 40dp;
  border-radius: 20dp;
}

.shell-body--wide .prompt-composer--wide .prompt-composer-pill .prompt-capture-btn {
  margin-bottom: 0;
  align-self: center;
}

.shell-body--wide .prompt-composer--wide .prompt-composer-row {
  margin-right: 16dp;
}

.shell-body--wide .prompt-composer--wide .prompt-composer-hint {
  margin: 6dp 0 0 0;
  font-size: 12dp;
  line-height: 16dp;
  text-align: center;
}

.shell-body--wide .prompt-composer-input {
  font-size: 15dp;
}

/* Send: the mockup's round 40dp accent button. (The voice branch's Send in click mode shares the class.) */
.shell-body--wide .prompt-send-btn,
.shell-body--wide .prompt-stop-btn {
  width: 40dp;
  min-width: 40dp;
  height: 40dp;
  border-radius: 20dp;
}

.shell-body--wide .prompt-send-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40dp;
  height: 40dp;
}

.shell-body--wide .prompt-send-btn svg {
  width: 18dp;
  height: 18dp;
}

/* ---- No chat open ---- */
.shell-body--wide .shell-empty-state {
  align-items: center;
  justify-content: center;
  padding: 0 32dp;
  text-align: center;
}

.shell-body--wide .shell-empty-title {
  margin: 0 0 8dp 0;
  font-size: 24dp;
  line-height: 30dp;
  font-weight: bold;
}

.shell-body--wide .shell-empty-body {
  max-width: 420dp;
  margin: 0;
  font-size: 15dp;
  line-height: 22dp;
}

/* A message that mentions you: a tinted row with a soft corner, no side bar. */
.shell-body--wide .message-row-mentions-me {
  border-left-width: 0;
  border-radius: 12dp;
}

/* ---- Voice recording in the wide composer: click the microphone (lit while it records), click again to send ---- */
.shell-body--wide .prompt-composer--wide .prompt-voice-live-pill {
  align-items: center;
  gap: 10dp;
  padding: 0 16dp;
}

.shell-body--wide .prompt-composer--wide .prompt-voice-live-pill .prompt-voice-timer {
  min-width: 36dp;
  font-size: 15dp;
}

.shell-body--wide .prompt-composer--wide .prompt-voice-level {
  flex: 1;
  min-width: 40dp;
  height: 6dp;
  border-radius: 3dp;
  overflow: hidden;
}

.shell-body--wide .prompt-composer--wide .prompt-voice-level-fill {
  width: 0%;
  height: 6dp;
  border-radius: 3dp;
}

.shell-body--wide .prompt-composer--wide .prompt-voice-live-pill .prompt-voice-bar-sending {
  font-size: 15dp;
}

.shell-body--wide .prompt-composer--wide .prompt-voice-cancel-x {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40dp;
  min-width: 40dp;
  height: 40dp;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 20dp;
  cursor: pointer;
}

/* BEGIN phone message rules (generated by scripts/ui/gen_wide_phone_rules.py, do not edit) */
.shell-body--wide .chat-call-row {
  padding: 9dp 14dp;
  font-size: 17dp;
  line-height: 22dp;
}

.shell-body--wide .chat-call-row-icon {
  width: 24dp;
  height: 24dp;
  margin: -1dp 8dp -1dp 0;
}

.shell-body--wide .chat-call-row-time {
  font-size: 13dp;
}

.shell-body--wide .bubble.bubble-user--picture {
  max-width: none;
  padding: 3dp;
  box-sizing: border-box;
  text-align: left;
}

.shell-body--wide .chat-attachment-video {
  display: block;
}

.shell-body--wide .chat-attachment-video-badge {
  padding: 0;
}

.shell-body--wide .sender-label {
  display: none;
}

.shell-body--wide .chat-date-strip {
  display: block;
  margin: 8dp 0;
  text-align: center;
}

.shell-body--wide .chat-date-pill,
.shell-body--wide .chat-system-line p {
  display: inline-block;
  margin: 0;
  padding: 4dp 10dp;
  max-width: 80%;
  border-radius: 999dp;
  font-size: 13dp;
  line-height: 18dp;
}

.shell-body--wide .chat-group-invite {
  display: inline-block;
  width: 72%;
  max-width: 280dp;
  margin: 0;
  padding: 10dp 12dp 0 12dp;
  border-width: 0;
  border-radius: 18dp;
  box-sizing: border-box;
  text-align: left;
}

.shell-body--wide .chat-group-invite .heading-3 {
  margin: 0;
  font-size: 17dp;
  line-height: 22dp;
  font-weight: bold;
}

.shell-body--wide .chat-group-invite .text {
  margin: 2dp 0 4dp 0;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-body--wide .chat-group-invite .chat-suggestion {
  display: block;
  width: 100%;
  height: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0;
  border-radius: 0;
  font-size: 17dp;
  line-height: 44dp;
  text-align: left;
}

.shell-body--wide .chat-group-name {
  display: block;
  margin: 0 0 2dp 12dp;
  max-width: 72%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 13dp;
  font-weight: bold;
  text-align: left;
}

.shell-body--wide .bubble .chat-group-name {
  margin: -16dp -14dp -13dp -14dp;
  padding: 16dp 14dp 15dp 14dp;
  max-width: none;
}

.shell-body--wide .chat-row-body--group {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.shell-body--wide .chat-row-avatar-col {
  display: block;
  flex-shrink: 0;
  width: 32dp;
  margin-right: 6dp;
  align-self: flex-end;
}

.shell-body--wide .chat-row-avatar-hit {
  display: block;
  margin: -12dp -6dp 0 -6dp;
  padding: 12dp 6dp 0 6dp;
}

.shell-body--wide .chat-row-avatar-col-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32dp;
  height: 32dp;
  border-radius: 16dp;
  overflow: hidden;
}

.shell-body--wide .chat-row-avatar-col-avatar .avatar-photo {
  width: 32dp;
  height: 32dp;
}

.shell-body--wide .chat-row-avatar-col-avatar .chat-row-avatar-letter {
  font-size: 15dp;
  line-height: 20dp;
}

.shell-body--wide .chat-row-body--group .chat-row-content {
  flex: 1;
  min-width: 0;
}

.shell-body--wide .bubble {
  padding: 10dp 14dp;
  border-radius: 18dp;
}

.shell-body--wide .bubble-text,
.shell-body--wide .bubble-text-peer {
  font-size: 17dp;
  line-height: 22dp;
}

.shell-body--wide .bubble.bubble-emoji {
  padding: 0 2dp;
  border-width: 0;
  background-color: transparent;
}

.shell-body--wide .bubble-emoji .bubble-text,
.shell-body--wide .bubble-emoji .bubble-text-peer {
  font-size: 28dp;
  line-height: 36dp;
}

.shell-body--wide .bubble-emoji--xl .bubble-text,
.shell-body--wide .bubble-emoji--xl .bubble-text-peer {
  font-size: 36dp;
  line-height: 44dp;
}

.shell-body--wide .bubble-emoji .bubble-time,
.shell-body--wide .bubble-emoji .bubble-tail {
  display: none;
}

.shell-body--wide .bubble-user,
.shell-body--wide .bubble-assistant {
  max-width: 72%;
}

.shell-body--wide .bubble-assistant {
  border-width: 0;
}

.shell-body--wide .bubble-time {
  display: block;
  margin-top: 2dp;
  font-size: 12dp;
  line-height: 14dp;
  text-align: right;
}

.shell-body--wide .bubble-deleted .bubble-time {
  display: none;
}

.shell-body--wide .chat-quote {
  margin-top: 0;
  padding: 5dp 8dp;
  border-radius: 6dp;
}

.shell-body--wide .chat-attachment-card {
  display: inline-block;
  min-width: 160dp;
  max-width: 240dp;
  padding: 8dp 12dp 0 12dp;
  border-width: 0;
  border-radius: 18dp;
  box-sizing: border-box;
  text-align: left;
}

.shell-body--wide .chat-attachment-card .heading-3,
.shell-body--wide .chat-attachment-card .text {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
}

.shell-body--wide .chat-attachment-card .muted {
  margin: 2dp 0 0 0;
  font-size: 12dp;
  line-height: 16dp;
}

.shell-body--wide .chat-attachment-card .muted:last-child {
  margin-bottom: 8dp;
}

.shell-body--wide .chat-attachment-card.chat-reaction-host .muted:last-child {
  margin-bottom: 24dp;
}

.shell-body--wide .chat-attachment-video-frame {
  max-width: 292dp;
}

.shell-body--wide .chat-attachment-card--video {
  min-width: 0;
  max-width: 298dp;
  padding: 3dp;
  border-radius: 12dp;
}

.shell-body--wide .chat-attachment-card--video .chat-attachment-video-frame {
  border-radius: 9dp;
}

.shell-body--wide .chat-audio-card {
  width: 240dp;
  min-width: 0;
  padding-bottom: 10dp;
}

.shell-body--wide .chat-audio-card .chat-audio-meta .chat-audio-sub,
.shell-body--wide .chat-audio-card.chat-reaction-host .chat-audio-meta .chat-audio-sub {
  margin-bottom: 0;
}

.shell-body--wide .chat-audio-card.chat-reaction-host {
  padding-bottom: 24dp;
}

.shell-body--wide .chat-attachment-card .chat-suggestion {
  display: block;
  width: 100%;
  height: 44dp;
  min-height: 44dp;
  margin: 0;
  padding: 0;
  border-radius: 0;
  font-size: 15dp;
  line-height: 44dp;
  text-align: left;
}

.shell-body--wide .chat-attachment-card--image {
  min-width: 0;
  max-width: none;
  padding: 3dp;
  border-radius: 12dp;
}

.shell-body--wide .chat-attachment-card--image .chat-attachment-clip {
  display: inline-block;
  vertical-align: top;
  max-width: 292dp;
  max-height: 360dp;
  overflow: hidden;
  border-radius: 9dp;
}

.shell-body--wide .chat-attachment-card--image .chat-attachment-image {
  display: block;
  max-width: 292dp;
  max-height: none;  /* the base .chat-attachment-image caps at 240dp */
  margin: 0;
  border-radius: 9dp;
}

.shell-body--wide .chat-attachment-card--image .chat-attachment-clip--auto {
  width: 292dp;
}

.shell-body--wide .chat-attachment-card--image .chat-attachment-clip--auto .chat-attachment-image {
  width: 292dp;
}

.shell-body--wide .chat-attachment-card--image .bubble-tail {
  z-index: -1;
}

.shell-body--wide .chat-file-card {
  min-width: 220dp;
  max-width: 292dp;
  padding: 0;
}

.shell-body--wide .chat-file-card.chat-reaction-host .chat-file-row {
  padding-bottom: 24dp;
}

.shell-body--wide .chat-file-card .chat-file-name {
  margin: 0;
  font-size: 15dp;
  line-height: 20dp;
  max-height: 40dp;
  overflow: hidden;
  word-break: break-word;
}

.shell-body--wide .chat-file-card .chat-file-size {
  margin: 2dp 0 0 0;
  font-size: 12dp;
  line-height: 16dp;
  opacity: 0.8;
}

.shell-body--wide .bubble-tail-host {
  position: relative;
}

.shell-body--wide .bubble-tail-host--in {
  border-bottom-left-radius: 4dp;
}

.shell-body--wide .bubble-tail-host--out {
  border-bottom-right-radius: 4dp;
}

.shell-body--wide .bubble-tail {
  position: absolute;
  bottom: 0;
  width: 16dp;
  height: 20dp;
}

.shell-body--wide .bubble-tail-in {
  left: -8dp;
}

.shell-body--wide .bubble-tail-out {
  right: -8dp;
}

.shell-body--wide .chat-attachment-clock {
  display: block;
  min-height: 14dp;
  margin-top: 2dp;
  font-size: 12dp;
  line-height: 14dp;
  text-align: right;
}

.shell-body--wide .chat-file-card .chat-attachment-clock {
  padding: 0 14dp 6dp 14dp;
  margin-top: -2dp;
}

.shell-body--wide .chat-audio-card .chat-attachment-clock {
  margin-top: 4dp;
}

.shell-body--wide .chat-file-card.chat-reaction-host .chat-file-row {
  padding-bottom: 8dp;
}

.shell-body--wide .chat-attachment-foot {
  min-height: 14dp;
  padding: 3dp 6dp 3dp 6dp;
}

.shell-body--wide .chat-foot-time {
  display: inline;
}
/* END phone message rules */
