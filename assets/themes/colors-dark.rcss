.shell-call-ring-voice svg {
  image-color: #ffffff;
}

.shell-call-accept {
  background-color: #30d158;
}

.shell-call-accept svg {
  image-color: #ffffff;
}

.shell-call-accept--pulse {
  background-color: #30d158;
  box-shadow: 0 0 0 4dp #22c55e33, 0 4dp 14dp #00000026;
}

.chat-empty {
  background-color: #1c1c1e;
  border: 1dp #54545899;
}

.sidebar-header-title {
  color: #ffffff;
}

.sidebar-session {
  background-color: #1c1c1e;
  border: 1dp #54545899;
}

/* Before the active rules so the open thread keeps its highlight. */
.sidebar-session--pinned {
  background-color: #2c2c2e;
}

.sidebar-session-active {
  background-color: #0a84ff2e;
  border-color: #0a84ff2e;
  box-shadow: inset 3dp 0 0 #0a84ff;
}

.sidebar-session--ai.sidebar-session-active {
  box-shadow: inset 3dp 0 0 #5e5ce6;
}

.sidebar-session--private.sidebar-session-active {
  background-color: #40c8e02e;
  border-color: #40c8e02e;
  box-shadow: inset 3dp 0 0 #40c8e0;
}

.sidebar-session--public.sidebar-session-active {
  background-color: #7878803d;
  border-color: #54545899;
  box-shadow: inset 3dp 0 0 #8e8e93;
}

.sidebar-session--group.sidebar-session-active {
  background-color: #0a84ff2e;
  border-color: #54545899;
  box-shadow: inset 3dp 0 0 #ff9f0a;
}

.sidebar-session-date {
  color: #ebebf599;
}

.sidebar-session-title {
  color: #ffffff;
}

.sidebar-session-preview {
  color: #ebebf599;
}

.sidebar-session-icon {
  background-color: #2c2c2e;
}

.sidebar-session-flag, .sidebar-archived-entry svg {
  image-color: #8e8e93;
}

.sidebar-archived-label {
  color: #ebebf599;
}

.sidebar-archived-entry:hover {
  background-color: #7878803d;
}

.sidebar-session-mention {
  color: #5e5ce6;
}

.sidebar-unread-dot {
  background-color: #0a84ff;
}

.sidebar-unread {
  background-color: #0a84ff;
  color: #ffffff;
}

.badge-count {
  background-color: #ff453a;
  color: #ffffff;
}

.badge-dot {
  background-color: #ff453a;
}

.shell-layer-compact .sidebar-session {
  background-color: #000000;
}

.shell-layer-compact .sidebar-session--pinned {
  background-color: #2c2c2e;
}

.shell-layer-compact .sidebar-session.sidebar-session-active {
  background-color: #000000;
  box-shadow: none;
}

.shell-layer-compact .sidebar-session--pinned.sidebar-session-active {
  background-color: #2c2c2e;
}

.shell-layer-compact .sidebar-session:active {
  background-color: #7878803d;
}

.shell-layer-compact .sidebar-session-body {
  border-bottom: 1dp #54545899;
}

.shell-layer-compact .sidebar-session:last-of-type .sidebar-session-body {
  border-bottom-color: transparent;
}

.chat-row-avatar--group {
  background-color: #ff9f0a;
}

.chat-row-avatar--ai {
  background-color: #5e5ce6;
}

.chat-row-avatar-letter {
  color: #ffffff;
}

.chat-row-avatar-icon {
  image-color: #ffffff;
}

.chat-row-type--ai {
  image-color: #5e5ce6;
}

.chat-row-type--private {
  image-color: #40c8e0;
}

.chat-row-type--group {
  image-color: #ff9f0a;
}

.chat-row-type--public {
  image-color: #8e8e93;
}

.chat-row-mute {
  image-color: #ebebf54c;
}

.chat-search {
  background-color: #2c2c2e;
}

.chat-search-icon {
  image-color: #ebebf54c;
}

.chat-search-input {
  color: #ffffff;
}

.chat-search-label {
  color: #ebebf599;
}

.sidebar-session-close:hover {
  background-color: #7878803d;
}

.bubble-peer {
  background-color: #2c2c2e;
  border: 1dp #54545899;
}

.working-set-long-list .chat-long-list-item {
  border-bottom: 1dp #54545899;
}

.chat-working-set-chip {
  border: 1dp #54545899;
  background-color: #2c2c2e;
  color: #ffffff;
}

.chat-working-set-chip:hover {
  background-color: #7878803d;
}

.chat-working-set-chip-disabled, .chat-working-set-chip-disabled:hover {
  background-color: #2c2c2e;
  color: #ebebf54c;
  border: 1dp #54545899;
  cursor: default;
  opacity: 0.85;
}

.settings-section-title {
  color: #ebebf599;
}

.settings-label {
  color: #ebebf599;
}

.settings-toggle-label {
  color: #ffffff;
}

.settings-switch {
  background-color: #8e8e93;
}

.settings-switch--on {
  background-color: #30d158;
}

.settings-switch-knob {
  background-color: #ffffff;
  box-shadow: 0 1dp 3dp #00000026;
}

.settings-choice-value-text {
  color: #ebebf599;
}

.settings-danger-zone {
  border-top: 1dp #54545899;
}

.settings-device-badge {
  background-color: #0a84ff2e;
  color: #0a84ff;
}

.me-profile-card {
  background-color: #1c1c1e;
  border: 1dp #54545899;
}

.me-identity-name {
  color: #ffffff;
}

.me-identity-action {
  color: #0a84ff;
}

.settings-row {
  background-color: #1c1c1e;
  border: 1dp #54545899;
  color: #ffffff;
}

.settings-row:hover, .settings-row:focus {
  background-color: #7878803d;
}

.settings-back-btn:hover, .settings-back-btn:focus {
  background-color: #7878803d;
}

.settings-choice-row:hover, .settings-choice-row:focus {
  background-color: #7878803d;
}

.settings-row--active {
  background-color: #0a84ff2e;
  border-color: #0a84ff2e;
}

.settings-row-title {
  color: #ffffff;
}

.settings-row-chevron {
  image-color: #ebebf54c;
}

.contacts-row, .contacts-thread-row {
  background-color: #1c1c1e;
  border: 1dp #54545899;
}

.contacts-row--active {
  background-color: #0a84ff2e;
  border-color: #0a84ff2e;
  box-shadow: inset 3dp 0 0 #0a84ff;
}

.contacts-row-title {
  color: #ffffff;
}

.contact-profile-card {
  background-color: #1c1c1e;
  border: 1dp #54545899;
}

.contacts-trust-badge--friendly {
  background-color: #40c8e02e;
  color: #40c8e0;
}

.contacts-trust-badge--blocked {
  background-color: #7878803d;
  color: #ff453a;
}

.contacts-back-btn:hover {
  background-color: #7878803d;
}

.contacts-action-secure {
  background-color: #40c8e0;
  color: #ffffff;
}

.contacts-action-secure:hover {
  background-color: #40c8e0;
}

.people-picker-row:hover {
  background-color: #7878803d;
}

.people-picker-row--selected {
  background-color: #0a84ff2e;
}

.people-picker-check {
  border-color: #54545899;
  background-color: #1c1c1e;
}

.people-picker-row--selected .people-picker-check {
  border-color: #0a84ff;
  background-color: #0a84ff;
  color: #ffffff;
}

.people-picker-check-mark {
  color: #ffffff;
}

.people-picker-member-chip {
  background-color: #0a84ff2e;
  color: #0a84ff;
}

.emoji-picker-section-label {
  background-color: #1c1c1e;
}

.emoji-picker-section-label-text {
  color: #ebebf599;
}

.emoji-picker-rail-tab--active {
  background-color: #7878803d;
}

.contacts-trust-btn--active {
  background-color: #0a84ff2e;
  color: #0a84ff;
  border: 1dp #0a84ff2e;
}

.contacts-trust-btn--active.contacts-trust-btn {
  box-shadow: inset 0 0 0 1dp #0a84ff;
}

.sidebar-footer {
  border-top: 1dp #54545899;
}

.chat-shell--e2e .chat-header {
  background-color: #40c8e02e;
  border-left: 3dp #40c8e0;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.chat-shell--ai .chat-header {
  border-left: 3dp #5e5ce6;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.chat-shell--public .chat-header {
  border-left: 3dp #8e8e93;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.chat-shell--group .chat-header {
  border-left: 3dp #ff9f0a;
  padding-left: 10dp;
  border-radius: 0 6dp 6dp 0;
}

.prompt-composer--e2e .prompt-composer-pill {
  border-color: #40c8e02e;
}

.prompt-composer--disabled {
  opacity: 0.55;
}

.chat-secure-badge {
  color: #40c8e0;
}

.chat-shell--ai .chat-header-type-icon svg {
  image-color: #5e5ce6;
}

.chat-shell--private .chat-header-type-icon svg, .chat-shell--e2e .chat-header-type-icon svg {
  image-color: #40c8e0;
}

.chat-shell--public .chat-header-type-icon svg {
  image-color: #8e8e93;
}

.chat-shell--group .chat-header-type-icon svg {
  image-color: #ff9f0a;
}

.chat-peer-path--direct svg {
  image-color: #30d158;
}

.chat-peer-path--hop svg {
  image-color: #ff9f0a;
}

.chat-peer-path--relay svg {
  image-color: #8e8e93;
}

.chat-peer-path--connecting svg {
  image-color: #8e8e93;
}

.chat-peer-path--degraded svg {
  image-color: #ff9f0a;
}

.chat-peer-path--failed svg {
  image-color: #ff453a;
}

.chat-peer-path--ready svg {
  image-color: #8e8e93;
}

.chat-header-call-btn, .chat-header-more-btn {
  background-color: #7878805c;
  color: #ffffff;
}

.chat-header-call-btn:hover, .chat-header-more-btn:hover {
  background-color: #7878803d;
}

.chat-header-call-btn--join {
  background-color: #30d158;
  color: #ffffff;
}

.chat-header-call-btn--join:hover {
  background-color: #30d158;
}

.chat-header-call-btn svg, .chat-header-more-btn svg {
  image-color: #ffffff;
}

/* After the plain call button's rule (same specificity): white on the green join button. */
.chat-header-call-btn--join svg {
  image-color: #ffffff;
}

/* Phone chat nav bar: the header row sits on the bar's material; no type bar, tint or round buttons. */
.shell-chat-overlay .chat-panel .chat-header {
  background-color: transparent;
}

.shell-chat-overlay .chat-header-call-btn,
.shell-chat-overlay .chat-header-more-btn {
  background-color: transparent;
}

.shell-chat-overlay .chat-header-call-btn svg,
.shell-chat-overlay .chat-header-more-btn svg {
  image-color: #0a84ff;
}

.shell-chat-overlay .chat-header-call-btn--join {
  background-color: #30d158;
}

.shell-chat-overlay .chat-header-call-btn--join svg {
  image-color: #ffffff;
}

.shell-chat-overlay .chat-header-title {
  color: #ffffff;
}

.shell-chat-overlay .chat-header-subtitle {
  color: #ebebf599;
}

.shell-chat-overlay-chrome .shell-back-btn {
  background-color: transparent;
}

.shell-chat-overlay-chrome .shell-back-btn svg {
  image-color: #0a84ff;
}

.context-menu-panel {
  background-color: #1c1c1e;
  border: 1dp #54545899;
}

/* Float menus (right-click / long-press): invisible hit target only — no dim.
   Compact action sheets keep a light scrim below. */
.context-menu-scrim {
  background-color: transparent;
}

.context-menu-layer--sheet .context-menu-scrim {
  background-color: #00000099;
}

.context-menu-sheet-list {
  background-color: #1c1c1e;
  border: 1dp #54545899;
}

.context-menu-sheet-cancel {
  background-color: #1c1c1e;
  color: #0a84ff;
  border: 1dp #54545899;
}

.context-menu-sheet-cancel:hover {
  background-color: #7878803d;
}

.context-menu-item {
  color: #ffffff;
}

.context-menu-item:hover {
  background-color: #7878803d;
}

.context-menu-item--danger {
  color: #ff453a;
}

.context-menu-item--danger:hover {
  background-color: #7878803d;
}

.context-menu-item--danger svg {
  image-color: #ff453a;
}
}
