@media (theme: dark) {
body {
  color: #f9fafb;
  background-color: #111827;
}

/* Monochrome icons are white sources; tint with image-color (does not inherit). */
svg {
  image-color: #9ca3af;
}

selection {
  background-color: #3b5998;
}

.bubble-user selection {
  background-color: #ffffff33;
}

.bubble-assistant selection {
  background-color: #3b5998;
}

.prompt-composer-input selection {
  background-color: #3b5998;
}

.chat-form-field selection {
  background-color: #3b5998;
}

.text {
  color: #e5e7eb;
}

.heading-1 {
  color: #ffffff;
}

.heading-2 {
  color: #ffffff;
}

.heading-3 {
  color: #ffffff;
}

.btn-primary,
.prompt-send-btn,
.sidebar-new-chat,
.contacts-find-btn {
  background-color: #6366f1;
  color: #ffffff;
}

.btn-primary:hover,
.btn-primary:focus,
.prompt-send-btn:hover,
.sidebar-new-chat:hover,
.contacts-find-btn:hover {
  background-color: #818cf8;
}

.btn-primary svg,
.prompt-send-btn svg,
.sidebar-new-chat svg,
.contacts-find-btn svg,
.contacts-action-secure svg {
  image-color: #ffffff;
}

.btn-secondary,
.chat-suggestion {
  background-color: #374151;
  color: #f9fafb;
}

.btn-secondary:hover,
.btn-secondary:focus,
.chat-suggestion:hover {
  background-color: #4b5563;
}

.btn-danger {
  background-color: #dc2626;
  color: #ffffff;
}

.btn-danger:hover,
.btn-danger:focus {
  background-color: #ef4444;
}

.btn-danger-soft {
  background-color: #450a0a;
  color: #fca5a5;
  border: 1dp #7f1d1d;
}

.btn-danger-soft:hover,
.btn-danger-soft:focus {
  background-color: #7f1d1d;
  color: #fecaca;
  border: 1dp #f87171;
}

.btn-danger svg {
  image-color: #ffffff;
}

.btn-danger-soft svg {
  image-color: #fca5a5;
}

.btn-danger-soft:hover svg,
.btn-danger-soft:focus svg {
  image-color: #fecaca;
}

.btn-ghost {
  background-color: transparent;
  color: #d1d5db;
}

.btn-ghost:hover,
.btn-ghost:focus {
  background-color: #374151;
  color: #f9fafb;
}

.field {
  background-color: #1f2937;
  color: #f9fafb;
  border: 1dp #4b5563;
}

select selectbox {
  background-color: #1f2937;
  border: 1dp #4b5563;
}

select selectbox option:hover {
  background-color: #374151;
}

.card {
  background-color: #1f2937;
  border: 1dp #374151;
}

.error {
  color: #f87171;
}

.muted {
  color: #9ca3af;
}

.bubble-user {
  background-color: #6366f1;
  color: #ffffff;
}

.bubble-text {
  color: #ffffff;
}

.bubble-assistant {
  background-color: #374151;
  border: 1dp #4b5563;
}

.bubble-assistant h1,
.bubble-assistant h2,
.bubble-assistant h3 {
  color: #ffffff;
}

.bubble-assistant p,
.bubble-assistant li {
  color: #e5e7eb;
}

.prompt-composer {
  background-color: #1f2937;
  border: 1dp #374151;
  box-shadow: 0 2dp 8dp #00000044;
}

.code-block {
  background-color: #374151;
  color: #f9fafb;
}

.chat-jump-latest {
  background-color: #e5e7eb;
  color: #111827;
}

.chat-jump-latest:hover {
  background-color: #f3f4f6;
}

.chat-form {
  border: 1dp #4b5563;
  background-color: #1f2937;
}

.chat-form-label {
  color: #e5e7eb;
}

.chat-form-field {
  background-color: #111827;
  color: #f9fafb;
  border: 1dp #4b5563;
}

.chat-form-submit {
  background-color: #6366f1;
  color: #ffffff;
}

.chat-form-submit:hover {
  background-color: #4f46e5;
}

.chat-card {
  border: 1dp #4b5563;
  background-color: #1f2937;
}

.chat-card-highlight {
  border-color: #6366f1;
  background-color: #312e81;
}

.chat-table th,
.chat-table td {
  border: 1dp #4b5563;
}

.chat-key-value-label {
  color: #9ca3af;
}

.chat-callout {
  background-color: #1e1b4b;
}

.chat-callout-warning {
  background-color: #422006;
}

.chat-quote {
  border-left: 3dp #4b5563;
}

.chat-long-list-scroll {
  background-color: #1f2937;
  border: 1dp #374151;
}

.chat-long-list-item {
  border-bottom: 1dp #374151;
}

.chat-calendar {
  border: 1dp #4b5563;
  background-color: #1f2937;
}

.calendar-nav {
  background-color: #6366f1;
  color: #ffffff;
}

.calendar-nav:hover {
  background-color: #4f46e5;
}

.calendar-weekdays {
  color: #9ca3af;
}

.calendar-day {
  background-color: #6366f1;
  color: #ffffff;
}

.calendar-day:hover {
  background-color: #4f46e5;
}

.calendar-day-muted {
  color: #6b7280;
}

.shell-body--framed {
  border-color: #4b5563;
}

.shell-titlebar {
  background-color: #111827;
  border-bottom-color: #374151;
}

.shell-titlebar-title {
  color: #ffffff;
}

.shell-titlebar-btn {
  background-color: #00000000;
}

.shell-titlebar-btn:hover {
  background-color: #374151;
}

.shell-titlebar-btn svg {
  image-color: #e5e7eb;
}

.shell-titlebar-btn--close:hover {
  background-color: #dc2626;
}

.shell-titlebar-btn--close:hover svg {
  image-color: #ffffff;
}

.shell-titlebar-btn--traffic,
.shell-titlebar-btn--traffic:hover {
  background-color: #00000000;
}

.shell-titlebar-btn--traffic-close .shell-titlebar-traffic-dot {
  background-color: #ff5f57;
}

.shell-titlebar-btn--traffic-close:hover .shell-titlebar-traffic-dot {
  background-color: #e0443e;
}

.shell-titlebar-btn--traffic-minimize .shell-titlebar-traffic-dot {
  background-color: #febc2e;
}

.shell-titlebar-btn--traffic-minimize:hover .shell-titlebar-traffic-dot {
  background-color: #dea123;
}

.shell-titlebar-btn--traffic-zoom .shell-titlebar-traffic-dot {
  background-color: #28c840;
}

.shell-titlebar-btn--traffic-zoom:hover .shell-titlebar-traffic-dot {
  background-color: #1aad2c;
}

.shell-titlebar-btn--traffic svg {
  image-color: #4d0000;
}

.shell-banner {
  background-color: #422006;
  border-bottom: 1dp #854d0e;
  color: #fde68a;
}

.shell-banner-text {
  color: #fde68a;
}

.shell-banner-dismiss {
  background-color: #854d0e;
  color: #fde68a;
}

.shell-toast {
  background-color: #374151;
  color: #ffffff;
  box-shadow: 0 2dp 8dp #00000066;
}

.shell-toast-text {
  color: #ffffff;
}

.shell-activity-strip {
  background-color: #6366f1;
}

.shell-statusbar {
  background-color: #0f172a;
  border-top-color: #374151;
}

.shell-statusbar-cluster:hover {
  background-color: #1f2937;
}

.shell-statusbar-divider {
  background-color: #4b5563;
}

.shell-statusbar-brief--ok svg {
  image-color: #4ade80;
}

.shell-statusbar-brief--failed svg {
  image-color: #f87171;
}

.shell-statusbar-brief--unknown svg {
  image-color: #6b7280;
}

.shell-statusbar-direct--ok svg {
  image-color: #4ade80;
}

.shell-statusbar-direct--off svg {
  image-color: #fbbf24;
}

.shell-statusbar-direct--error svg {
  image-color: #f87171;
}

.shell-statusbar-direct--checking svg {
  image-color: #6b7280;
}

.shell-statusbar-inbound--ok svg {
  image-color: #4ade80;
}

.shell-statusbar-inbound--off svg {
  image-color: #fbbf24;
}

.shell-call-quality-bar {
  background-color: #374151;
}

.shell-call-quality-bar--on {
  background-color: #9ca3af;
}

.shell-call-quality--ok .shell-call-quality-bar--on {
  background-color: #9ca3af;
}

.shell-call-quality--warn .shell-call-quality-bar--on {
  background-color: #fbbf24;
}

.shell-call-quality--error .shell-call-quality-bar {
  background-color: #7f1d1d;
}

.shell-call-quality--error .shell-call-quality-bar--on {
  background-color: #f87171;
}

.shell-call-quality--warn .shell-call-quality-label,
.shell-call-quality-hint {
  color: #fbbf24;
}

.shell-call-quality--error .shell-call-quality-label {
  color: #f87171;
}

.shell-call-debug-subtitle {
  color: #9ca3af;
}

.shell-statusbar-help svg {
  image-color: #2dd4bf;
}

.shell-statusbar-label--warn {
  color: #fbbf24;
}

.shell-statusbar-label--error {
  color: #f87171;
}

.shell-statusbar-popover {
  background-color: #1f2937;
  border-color: #374151;
  box-shadow: 0 8dp 24dp #00000066;
}

.shell-statusbar-popover-scrim {
  background-color: #00000001;
}

.shell-pane {
  background-color: #111827;
}

.shell-pane-secondary {
  border-right: 1dp #374151;
}

.shell-nav-rail {
  background-color: #0f172a;
  border-right: 1dp #374151;
}

.shell-nav-rail--compact {
  border-right: 0;
  border-top: 0;
  background-color: transparent;
}

.shell-nav-rail--compact .shell-nav-pill {
  background-color: #1f2937f0;
  border-top: 1dp #ffffff0f;
  box-shadow: 0 2dp 12dp #00000040;
}

.shell-bottom-chrome--frost .shell-nav-rail--compact .shell-nav-pill {
  background-color: #1f2937b3;
}

.shell-nav-tab {
  background-color: transparent;
  color: #9ca3af;
}

.shell-nav-tab svg {
  image-color: #9ca3af;
}

.shell-nav-tab:hover {
  background-color: #1f2937;
}

.shell-nav-tab--active {
  background-color: #374151;
  color: #f9fafb;
}

.shell-nav-tab--active svg {
  image-color: #f9fafb;
}

.shell-nav-rail--compact .shell-nav-tab:hover {
  background-color: #ffffff14;
}

.shell-nav-rail--compact .shell-nav-tab--active {
  background-color: #374151;
  color: #f9fafb;
}

.shell-chat-overlay {
  background-color: #111827;
}

.shell-chat-overlay-chrome {
  background-color: #1f2937f0;
  border-bottom: 1dp #ffffff0f;
  border-top: 1dp #ffffff1a;
  box-shadow: 0 2dp 12dp #00000040;
}

.shell-chat-overlay-chrome.surface-chrome--frost {
  background-color: #1f2937b3;
}

.shell-pane-auxiliary {
  border-left: 1dp #374151;
}

.shell-bottom-chrome {
  background-color: transparent;
}

.shell-drawer-scrim,
.shell-sheet-scrim,
.shell-account-sheet-scrim {
  background-color: #00000066;
}

.shell-drawer {
  background-color: #111827;
  box-shadow: 2dp 0 12dp #00000066;
}

.shell-sheet {
  background-color: #111827;
  box-shadow: -2dp 0 12dp #00000066;
}

.shell-sheet-compact {
  background-color: #1f2937;
  border-left: 1dp #374151;
  box-shadow: -2dp 0 8dp #00000066;
}

.shell-sheet-compact-chrome {
  background-color: #1f2937f0;
  border-bottom: 1dp #ffffff0f;
}

.shell-sheet-compact-chrome.surface-chrome--frost {
  background-color: #1f2937b3;
  border-bottom: 1dp #ffffff0f;
  border-top: 1dp #ffffff1a;
}

.shell-account-sheet {
  background-color: #1f2937;
}

.shell-account-sheet-header {
  background-color: #1f2937f0;
  border-bottom: 1dp #ffffff0f;
}

.shell-account-sheet-header.surface-chrome--frost {
  background-color: #1f2937b3;
  border-top: 1dp #ffffff1a;
}

.shell-profile-btn {
  background-color: #374151;
}

.shell-account-sheet-grabber {
  background-color: #4b5563;
}

.shell-toolbar {
  background-color: #1f2937;
  border-top: 1dp #374151;
}

.shell-toolbar-title {
  color: #e5e7eb;
}

.shell-toolbar-btn {
  background-color: #374151;
  color: #f9fafb;
}

.shell-toolbar-btn-preview {
  background-color: #6366f1;
  color: #ffffff;
}

.shell-transient-chrome {
  background-color: #1f2937f0;
  border-bottom: 1dp #ffffff0f;
  border-top: 1dp #ffffff1a;
  box-shadow: 0 2dp 12dp #00000040;
}

.shell-transient-chrome.surface-chrome--frost {
  background-color: #1f2937b3;
}

.shell-composer-mount.surface-chrome {
  background-color: #1f2937f0;
  border-top: 1dp #374151;
}

.shell-composer-mount.surface-chrome .prompt-composer {
  background-color: #1f2937;
  border: 1dp #374151;
  box-shadow: none;
}

/* Floating Chrome utilities (compact shell; theme-only). */
.surface-chrome {
  background-color: #1f2937f0;
  border-top: 1dp #ffffff1a;
}

.surface-chrome--frost {
  background-color: #1f2937b3;
}

.surface-chrome--solid {
  background-color: #1f2937f0;
}

.shell-back-btn {
  background-color: #374151;
  color: #f9fafb;
}

.shell-layer-transient {
  background-color: #111827;
}

.shell-scrim {
  background-color: #00000099;
}

.shell-frame {
  background-color: #1f2937;
}

.shell-close-btn {
  background-color: #374151;
  color: #f9fafb;
}

.shell-dialog {
  background-color: #1f2937;
}

.shell-dialog-message {
  color: #e5e7eb;
}

.shell-call-meter-label {
  color: #9ca3af;
}

.shell-call-meter-hint {
  color: #e5e7eb;
}

.shell-call-meter-seg {
  background-color: #374151;
}

.shell-call-meter-seg--on {
  background-color: #6366f1;
}

.shell-call-bar {
  background-color: #1f2937;
  border: 1dp #374151;
}

.shell-call-bar-title {
  color: #f9fafb;
}

.shell-call-bar-subtitle {
  color: #9ca3af;
}

.shell-call-bar-hint {
  color: #fbbf24;
}

.shell-call-mute {
  background-color: #374151;
  color: #f9fafb;
}

.shell-call-mute svg {
  image-color: #f9fafb;
}

.shell-call-mute--on {
  background-color: #374151;
  color: #f9fafb;
}

.shell-call-mute--on svg {
  image-color: #f9fafb;
}

.shell-call-camera {
  background-color: #374151;
  color: #f9fafb;
}

.shell-call-camera svg {
  image-color: #f9fafb;
}

.shell-call-camera--on {
  background-color: #374151;
  color: #f9fafb;
}

.shell-call-camera--on svg {
  image-color: #f9fafb;
}

.shell-call-speaker {
  background-color: #374151;
  color: #f9fafb;
}

.shell-call-speaker svg {
  /* Earpiece / speaker off — lower contrast status */
  image-color: #6b7280;
}

.shell-call-speaker--on {
  background-color: #374151;
  color: #f9fafb;
}

.shell-call-speaker--on svg {
  /* Speakerphone on — full contrast status */
  image-color: #f9fafb;
}

.shell-call-leave {
  background-color: #7f1d1d;
  color: #fecaca;
}

.shell-call-leave svg {
  image-color: #fecaca;
}

.shell-call-minimize,
.shell-call-immersive-btn,
.shell-call-expand {
  background-color: #374151;
  color: #f9fafb;
}

.shell-call-minimize svg,
.shell-call-immersive-btn svg,
.shell-call-expand svg {
  image-color: #f9fafb;
}

.shell-call-minimized-chip {
  background-color: #1f2937;
  border: 1dp #374151;
}

.shell-call-minimized-title {
  color: #f9fafb;
}

.shell-call-minimized-subtitle {
  color: #9ca3af;
}

.shell-call-immersive {
  background-color: #111827;
}

.shell-call-immersive-grabber {
  background-color: #4b5563;
}

.shell-call-peer-card {
  background-color: #1f2937;
  border: 1dp #374151;
}

.shell-call-peer-avatar {
  background-color: #374151;
}

.shell-call-peer-name {
  color: #f9fafb;
}

.shell-call-retry {
  background-color: #1e3a5f;
  color: #93c5fd;
}

.shell-call-retry svg {
  image-color: #93c5fd;
}

.shell-call-stage {
  background-color: #111827;
}

.shell-call-remote {
  background-color: #1f2937;
}

.shell-call-remote-placeholder {
  color: #9ca3af;
}

.shell-call-pip {
  background-color: #374151;
  border: 1dp #6b7280;
}

.shell-call-ring-eyebrow {
  color: #9ca3af;
}

.shell-call-ring {
  border-color: #3730a3;
}

.shell-call-ring--pulse {
  border-color: #818cf8;
}

.shell-call-accept--pulse {
  background-color: #818cf8;
  box-shadow: 0 0 0 4dp #6366f144, 0 4dp 14dp #6366f166;
}

.chat-empty {
  background-color: #1f2937;
  border: 1dp #374151;
}

.sidebar-header-title {
  color: #e5e7eb;
}

.sidebar-session {
  background-color: #1f2937;
  border: 1dp #374151;
}

.sidebar-session-active {
  background-color: #312e81;
  border-color: #4338ca;
  box-shadow: inset 3dp 0 0 #818cf8;
}

.sidebar-session--ai.sidebar-session-active {
  box-shadow: inset 3dp 0 0 #818cf8;
}

.sidebar-session--private.sidebar-session-active {
  background-color: #134e4a;
  border-color: #0f766e;
  box-shadow: inset 3dp 0 0 #2dd4bf;
}

.sidebar-session--public.sidebar-session-active {
  background-color: #374151;
  border-color: #4b5563;
  box-shadow: inset 3dp 0 0 #9ca3af;
}

.sidebar-session--group.sidebar-session-active {
  background-color: #422006;
  border-color: #854d0e;
  box-shadow: inset 3dp 0 0 #fbbf24;
}

.sidebar-session-title {
  color: #e5e7eb;
}

.sidebar-unread {
  background-color: #6366f1;
  color: #ffffff;
}

.badge-count {
  background-color: #6366f1;
  color: #ffffff;
}

.badge-dot {
  background-color: #6366f1;
}

.sidebar-session-close:hover {
  background-color: #374151;
}

.bubble-peer {
  background-color: #374151;
  border: 1dp #4b5563;
}

.working-set-long-list .chat-long-list-item {
  border-bottom: 1dp #374151;
}

.chat-working-set-chip {
  border: 1dp #4b5563;
  background-color: #374151;
  color: #f9fafb;
}

.chat-working-set-chip:hover {
  background-color: #4b5563;
}

.settings-section-title {
  color: #e5e7eb;
}

.settings-label {
  color: #9ca3af;
}

.settings-toggle-label {
  color: #f9fafb;
}

.settings-switch {
  background-color: #4b5563;
}

.settings-switch--on {
  background-color: #6366f1;
}

.settings-switch-knob {
  background-color: #ffffff;
  box-shadow: 0 1dp 3dp #00000066;
}

.settings-choice-value-text {
  color: #9ca3af;
}

.settings-danger-zone {
  border-top: 1dp #374151;
}

.me-profile-card {
  background-color: #1f2937;
  border: 1dp #374151;
}

.settings-row {
  background-color: #1f2937;
  border: 1dp #374151;
  color: #f9fafb;
}

.settings-row:hover,
.settings-row:focus {
  background-color: #273549;
}

.settings-back-btn:hover,
.settings-back-btn:focus {
  background-color: #374151;
}

.settings-choice-row:hover,
.settings-choice-row:focus {
  background-color: #374151;
}

.settings-row--active {
  background-color: #312e81;
  border-color: #4338ca;
}

.settings-row-title {
  color: #ffffff;
}

.settings-row-chevron {
  image-color: #6b7280;
}

.contacts-row,
.contacts-thread-row {
  background-color: #1f2937;
  border: 1dp #374151;
}

.contacts-row--active {
  background-color: #312e81;
  border-color: #4338ca;
  box-shadow: inset 3dp 0 0 #818cf8;
}

.contacts-row-title {
  color: #e5e7eb;
}

.contact-profile-card {
  background-color: #1f2937;
  border: 1dp #374151;
}

.contacts-trust-badge--friendly {
  background-color: #134e4a;
  color: #5eead4;
}

.contacts-trust-badge--blocked {
  background-color: #450a0a;
  color: #fca5a5;
}

.contacts-back-btn:hover {
  background-color: #374151;
}

.contacts-action-secure {
  background-color: #0f766e;
  color: #ffffff;
}

.contacts-action-secure:hover {
  background-color: #0d9488;
}

.people-picker-row:hover {
  background-color: #374151;
}

.people-picker-row--selected {
  background-color: #312e81;
}

.people-picker-check {
  border-color: #4b5563;
  background-color: #111827;
}

.people-picker-row--selected .people-picker-check {
  border-color: #818cf8;
  background-color: #6366f1;
  color: #ffffff;
}

.people-picker-check-mark {
  color: #ffffff;
}

.people-picker-member-chip {
  background-color: #1e293b;
  color: #c7d2fe;
}

.contacts-trust-btn--active {
  background-color: #312e81;
  color: #e0e7ff;
  border: 1dp #4338ca;
}

.contacts-trust-btn--active.contacts-trust-btn {
  box-shadow: inset 0 0 0 1dp #818cf8;
}

.sidebar-footer {
  border-top: 1dp #374151;
}

.chat-shell--e2e .chat-header {
  background-color: #134e4a;
  border-left: 4dp #2dd4bf;
  padding-left: 12dp;
  border-radius: 0 8dp 8dp 0;
}

.chat-shell--ai .chat-header {
  border-left: 4dp #6366f1;
  padding-left: 12dp;
  border-radius: 0 8dp 8dp 0;
}

.chat-shell--public .chat-header {
  border-left: 4dp #4b5563;
  padding-left: 12dp;
  border-radius: 0 8dp 8dp 0;
}

.chat-shell--group .chat-header {
  border-left: 4dp #f59e0b;
  padding-left: 12dp;
  border-radius: 0 8dp 8dp 0;
}

.prompt-composer--e2e {
  border-color: #0f766e;
}

.prompt-composer--disabled {
  opacity: 0.55;
}

.chat-secure-badge {
  color: #2dd4bf;
}

.chat-shell--ai .chat-type-badge {
  color: #818cf8;
}

.chat-shell--private .chat-type-badge {
  color: #2dd4bf;
}

.chat-shell--public .chat-type-badge {
  color: #9ca3af;
}

.chat-shell--group .chat-type-badge {
  color: #fbbf24;
}

.chat-header-call-btn,
.chat-header-more-btn {
  background-color: #374151;
  color: #f9fafb;
}

.chat-header-call-btn:hover,
.chat-header-more-btn:hover {
  background-color: #4b5563;
}

.chat-header-call-btn svg,
.chat-header-more-btn svg {
  image-color: #f9fafb;
}

.context-menu-panel {
  background-color: #1f2937;
  border: 1dp #374151;
}

.context-menu-scrim {
  background-color: #00000099;
}

.context-menu-sheet-list {
  background-color: #1f2937;
  border: 1dp #374151;
}

.context-menu-sheet-cancel {
  background-color: #1f2937;
  color: #818cf8;
  border: 1dp #374151;
}

.context-menu-sheet-cancel:hover {
  background-color: #374151;
}

.context-menu-item {
  color: #f9fafb;
}

.context-menu-item:hover {
  background-color: #374151;
}

.context-menu-item--danger {
  color: #f87171;
}

.context-menu-item--danger:hover {
  background-color: #450a0a;
}

.context-menu-item--danger svg {
  image-color: #f87171;
}
}
