.bubble-user .chat-mention {
  color: #ffffff;
  background-color: #ffffff33;
}

/* A peer's message that mentions this account: the whole row is tinted, with a bar on its left. */
.message-row-mentions-me {
  background-color: #3a2e14;
  border-left: 3dp #ff9f0a;
}

/* The row a jump landed on (tapped quote, search hit, mention): see-through amber, wins over the mention tint. */
.message-row.message-row-jump-target {
  background-color: #ffc40038;
}

/* Search inside the chat: the matching text is marked, pale yellow; the hit the search is on, deeper. */
.search-mark {
