<rml>
<head>
  <title>Search demo</title>
  <link type="text/rcss" href="../themes/foundation.rcss"/>
  <link type="text/rcss" href="../themes/components.rcss"/>
  <link type="text/rcss" href="../themes/colors-light.rcss"/>
  <link type="text/rcss" href="../themes/colors-dark.rcss"/>
</head>
<body data-model="main">
  <h1 class="heading-1">User search</h1>
  <div class="card stack">
    <input class="field" type="text" placeholder="Name or email" data-value="query"/>
    <button class="btn btn-primary" data-event-click="search_users()">Search</button>
    <p class="error" data-if="error != ''" data-rml="error"></p>
    <p class="text muted" data-if="loading">Searching...</p>
    <div data-for="row : results" class="card gap-sm">
      <p class="text" data-rml="row.name"></p>
      <p class="text muted" data-rml="row.email"></p>
    </div>
  </div>
</body>
</rml>
