<rml>
<head>
  <title>Chat</title>
  <link type="text/rcss" href="../themes/base.rcss"/>
</head>
<body data-model="chat" class="chat-body">
  <div class="chat-shell">
    <div class="chat-header">
      <h1>pp-browser</h1>
      <p class="muted">Ask anything. Assistant replies use structured text.</p>
    </div>
    <div class="messages">
      <div data-for="msg : messages" class="message-row">
        <div class="bubble bubble-user" data-if="msg.role == 'user'">
          <div data-rml="msg.content_rml"></div>
        </div>
        <div class="bubble bubble-assistant" data-if="msg.role == 'assistant'">
          <div data-rml="msg.content_rml"></div>
        </div>
      </div>
      <p class="muted" data-if="loading">Thinking...</p>
    </div>
    <div class="input-row">
      <textarea placeholder="Type a message..." rows="3" data-value="draft"></textarea>
      <button data-event-click="send_message()">Send</button>
    </div>
  </div>
</body>
</rml>
