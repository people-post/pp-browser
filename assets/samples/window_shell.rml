<rml>
<head>
  <title>Frame</title>
  <link type="text/rcss" href="../themes/foundation.rcss"/>
  <link type="text/rcss" href="../themes/components.rcss"/>
  <link type="text/rcss" href="../themes/colors-light.rcss"/>
  <link type="text/rcss" href="../themes/colors-dark.rcss"/>
</head>
<body data-model="window" class="shell-body" data-class-shell-body--framed="titlebar_visible && !window_maximized">
  <div id="shell-titlebar" class="shell-titlebar" data-if="titlebar_visible">
    <div id="shell-titlebar-controls" class="shell-titlebar-controls shell-titlebar-controls--traffic" data-if="titlebar_traffic_lights">
      <button class="shell-titlebar-btn shell-titlebar-btn--traffic shell-titlebar-btn--traffic-close" type="button" data-event-click="titlebar_close()">
        <div class="shell-titlebar-traffic-dot">
          <svg src="../icons/close.svg" width="6" height="6" crop-to-content="true"></svg>
        </div>
      </button>
      <button class="shell-titlebar-btn shell-titlebar-btn--traffic shell-titlebar-btn--traffic-minimize" type="button" data-event-click="titlebar_minimize()">
        <div class="shell-titlebar-traffic-dot">
          <svg src="../icons/window-minimize.svg" width="6" height="6" crop-to-content="true"></svg>
        </div>
      </button>
      <button class="shell-titlebar-btn shell-titlebar-btn--traffic shell-titlebar-btn--traffic-zoom" type="button" data-event-click="titlebar_toggle_maximize()">
        <div class="shell-titlebar-traffic-dot">
          <svg src="../icons/plus.svg" width="6" height="6" crop-to-content="true"></svg>
        </div>
      </button>
    </div>
    <div class="shell-titlebar-drag" data-event-dblclick="titlebar_toggle_maximize()">
      <p class="shell-titlebar-title">{{i18n:app.name}}</p>
    </div>
    <div class="shell-titlebar-controls shell-titlebar-controls--icons" data-if="!titlebar_traffic_lights">
      <button class="shell-titlebar-btn" type="button" data-event-click="titlebar_minimize()">
        <svg src="../icons/window-minimize.svg" width="12" height="12" crop-to-content="true"></svg>
      </button>
      <button class="shell-titlebar-btn" type="button" data-event-click="titlebar_toggle_maximize()">
        <svg data-if="!window_maximized" src="../icons/window-maximize.svg" width="12" height="12" crop-to-content="true"></svg>
        <svg data-if="window_maximized" src="../icons/window-restore.svg" width="12" height="12" crop-to-content="true"></svg>
      </button>
      <button class="shell-titlebar-btn shell-titlebar-btn--close" type="button" data-event-click="titlebar_close()">
        <svg src="../icons/close.svg" width="12" height="12" crop-to-content="true"></svg>
      </button>
    </div>
  </div>
  <div id="shell-chrome" class="shell-chrome">
    <div class="shell-banner" data-if="banner_message != ''">
      <p class="shell-banner-text" data-rml="banner_message"></p>
      <button class="shell-banner-dismiss" data-event-click="dismiss_banner()">×</button>
    </div>
    <div id="shell-toast-stack" class="shell-toast-stack">
      <div data-for="toast : toasts" class="shell-toast">
        <p class="shell-toast-text" data-rml="toast.message"></p>
      </div>
    </div>
    <div class="shell-activity-strip" data-if="activity_visible && !statusbar_visible"></div>
  </div>
  <div id="shell-root" class="shell-root"></div>
  <div id="shell-statusbar" class="shell-statusbar" data-if="statusbar_visible">
    <p class="shell-statusbar-connection text-xs muted" data-rml="statusbar_connection"></p>
    <p class="shell-statusbar-activity text-xs muted" data-rml="statusbar_activity"></p>
  </div>
</body>
</rml>
