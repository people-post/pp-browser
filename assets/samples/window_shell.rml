<rml>
<head>
  <title>PP</title>
  <link type="text/rcss" href="../themes/foundation.rcss"/>
  <link type="text/rcss" href="../themes/components.rcss"/>
  <link type="text/rcss" href="../themes/colors-light.rcss"/>
  <link type="text/rcss" href="../themes/colors-dark.rcss"/>
</head>
<body data-model="window" class="shell-body" data-class-shell-body--framed="titlebar_visible && !window_maximized"
      data-class-shell-body--compact="layout_mode == 'compact'">
  <div id="shell-titlebar" class="shell-titlebar" data-if="titlebar_visible">
    <div id="shell-titlebar-controls" class="shell-titlebar-controls shell-titlebar-controls--traffic" data-if="titlebar_traffic_lights">
      <button class="shell-titlebar-btn shell-titlebar-btn--traffic shell-titlebar-btn--traffic-close" type="button" data-event-click="titlebar_close()">
        <div class="shell-titlebar-traffic-dot">
          <svg src="../icons/close.svg" width="6" height="6" crop-to-content="true"></svg>
        </div>
      </button>
      <button class="shell-titlebar-btn shell-titlebar-btn--traffic shell-titlebar-btn--traffic-minimize" type="button" data-event-click="titlebar_minimize()">
        <div class="shell-titlebar-traffic-dot">
          <svg src="../icons/window-minimize.svg" width="6" height="6" crop-to-content="true"></svg>
        </div>
      </button>
      <button class="shell-titlebar-btn shell-titlebar-btn--traffic shell-titlebar-btn--traffic-zoom" type="button" data-event-click="titlebar_toggle_maximize()">
        <div class="shell-titlebar-traffic-dot">
          <svg src="../icons/plus.svg" width="6" height="6" crop-to-content="true"></svg>
        </div>
      </button>
    </div>
    <div class="shell-titlebar-drag" data-event-dblclick="titlebar_toggle_maximize()">
      <p class="shell-titlebar-title">{{i18n:app.name}}</p>
    </div>
    <div class="shell-titlebar-controls shell-titlebar-controls--icons" data-if="!titlebar_traffic_lights">
      <button class="shell-titlebar-btn" type="button" data-event-click="titlebar_minimize()">
        <svg src="../icons/window-minimize.svg" width="12" height="12" crop-to-content="true"></svg>
      </button>
      <button class="shell-titlebar-btn" type="button" data-event-click="titlebar_toggle_maximize()">
        <svg data-if="!window_maximized" src="../icons/window-maximize.svg" width="12" height="12" crop-to-content="true"></svg>
        <svg data-if="window_maximized" src="../icons/window-restore.svg" width="12" height="12" crop-to-content="true"></svg>
      </button>
      <button class="shell-titlebar-btn shell-titlebar-btn--close" type="button" data-event-click="titlebar_close()">
        <svg src="../icons/close.svg" width="12" height="12" crop-to-content="true"></svg>
      </button>
    </div>
  </div>
  <div id="shell-chrome" class="shell-chrome">
    <div class="shell-banner" data-if="banner_message != ''">
      <p class="shell-banner-text">{{banner_message}}</p>
      <button class="shell-banner-dismiss" data-event-click="dismiss_banner()">×</button>
    </div>
    <div id="shell-toast-stack" class="shell-toast-stack">
      <div data-for="toast : toasts" class="shell-toast">
        <p class="shell-toast-text">{{toast.message}}</p>
      </div>
    </div>
    <div class="shell-activity-strip" data-if="activity_visible && !statusbar_visible"></div>
  </div>
  <div id="shell-root" class="shell-root"></div>
  <!-- Phones: the band under the status bar, over the pages, so a top bar that hides on scroll slides under it, not
       over the clock (ShellHost sizes it to the top inset). -->
  <div id="shell-statusbar-strip" class="shell-statusbar-strip"></div>
  <!-- Phones: the band over the home indicator under a page with no bar there (a hidden tab, a pushed page): that page
       ends above it (ShellHost sizes it to the bottom inset), so it takes the page's colour like the top band. -->
  <div id="shell-home-indicator-strip" class="shell-home-indicator-strip"></div>
  <!-- Bottom chrome / IME-replacement mount: sibling of shell-root so content can be
       lifted (shell-root bottom) while the panel paints in the freed bottom band. -->
  <div id="shell-emoji-keyboard-mount" class="shell-emoji-keyboard-mount"></div>
  <!-- Phone AI dot (DESIGN-pp-ui §8.14): ShellAiDot shows, places and drags it; one look's layers at a time. The two
       bubbles are parts that move apart (wave, high five, happy...); each part's eyes come open, happy (^ ^) and shut;
       the cheeks, mouth, the plain look's symbols and the particles (arcs, typing dots, star, hearts, z's, lock) show
       only during their action (components.rcss, .ai-dot-*). Stacking order: components.rcss (.shell-ai-dot-mount). -->
  <div id="shell-ai-dot-mount" class="shell-ai-dot-mount">
    <div id="shell-ai-dot" class="ai-dot" data-class-ai-dot--shown="ai_dot_shown && nav_tab != 'home'"
         data-class-ai-dot--sway="ai_dot_idle == 'sway'" data-class-ai-dot--blink="ai_dot_idle == 'blink'"
         data-class-ai-dot--look="ai_dot_idle == 'look'" data-class-ai-dot--talk="ai_dot_idle == 'talk'"
         data-class-ai-dot--shy="ai_dot_idle == 'shy'" data-class-ai-dot--wave="ai_dot_idle == 'wave'"
         data-class-ai-dot--listen="ai_dot_idle == 'listen'" data-class-ai-dot--think="ai_dot_idle == 'think'"
         data-class-ai-dot--five="ai_dot_idle == 'five'" data-class-ai-dot--happy="ai_dot_idle == 'happy'"
         data-class-ai-dot--private="ai_dot_idle == 'private'" data-class-ai-dot--sleep="ai_dot_idle == 'sleep'"
         data-class-ai-dot--poke="ai_dot_idle == 'poke'" data-class-ai-dot--pop="ai_dot_idle == 'pop'"
         data-class-ai-dot--float="ai_dot_idle == 'float'"
         data-class-ai-dot--asleep="ai_dot_asleep"
         data-class-ai-dot--calm="ai_dot_look == 'c' || ai_dot_look == 'd'" data-class-ai-dot--plain="ai_dot_look == 'd'"
         data-class-ai-dot--size-s="ai_dot_size == 's'" data-class-ai-dot--size-l="ai_dot_size == 'l'">
      <div class="ai-dot-figure">
        <div class="ai-dot-part ai-dot-back">
          <svg class="ai-dot-layer" data-if="ai_dot_look != 'c'" src="../icons/mascot/body-back.svg"></svg>
          <svg class="ai-dot-layer" data-if="ai_dot_look == 'c'" src="../icons/mascot/body-back-c.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-back ai-dot-open" data-if="ai_dot_look == 'a'" src="../icons/mascot/a-eyes-back.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-back ai-dot-hap" data-if="ai_dot_look == 'a'" src="../icons/mascot/a-hap-back.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-back ai-dot-shut" data-if="ai_dot_look == 'a'" src="../icons/mascot/a-shut-back.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-back ai-dot-open" data-if="ai_dot_look == 'b'" src="../icons/mascot/b-eyes-back.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-back ai-dot-hap" data-if="ai_dot_look == 'b'" src="../icons/mascot/b-hap-back.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-back ai-dot-shut" data-if="ai_dot_look == 'b'" src="../icons/mascot/b-shut-back.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-back ai-dot-open" data-if="ai_dot_look == 'c'" src="../icons/mascot/c-eyes-back.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-back ai-dot-hap" data-if="ai_dot_look == 'c'" src="../icons/mascot/c-hap-back.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-back ai-dot-shut" data-if="ai_dot_look == 'c'" src="../icons/mascot/c-shut-back.svg"></svg>
          <svg class="ai-dot-layer ai-dot-arc ai-dot-arc-1" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/arc-1.svg"></svg>
          <svg class="ai-dot-layer ai-dot-arc ai-dot-arc-2" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/arc-2.svg"></svg>
          <svg class="ai-dot-layer ai-dot-arc ai-dot-arc-3" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/arc-3.svg"></svg>
          <svg class="ai-dot-layer ai-dot-arc ai-dot-arc-1" data-if="ai_dot_look == 'c'" src="../icons/mascot/arc-c-1.svg"></svg>
          <svg class="ai-dot-layer ai-dot-arc ai-dot-arc-2" data-if="ai_dot_look == 'c'" src="../icons/mascot/arc-c-2.svg"></svg>
          <svg class="ai-dot-layer ai-dot-arc ai-dot-arc-3" data-if="ai_dot_look == 'c'" src="../icons/mascot/arc-c-3.svg"></svg>
        </div>
        <div class="ai-dot-part ai-dot-front">
          <svg class="ai-dot-layer" data-if="ai_dot_look != 'c'" src="../icons/mascot/body-front.svg"></svg>
          <svg class="ai-dot-layer" data-if="ai_dot_look == 'c'" src="../icons/mascot/body-front-c.svg"></svg>
          <svg class="ai-dot-layer ai-dot-blush" data-if="ai_dot_look == 'a'" src="../icons/mascot/a-blush.svg"></svg>
          <svg class="ai-dot-layer ai-dot-blush" data-if="ai_dot_look == 'b'" src="../icons/mascot/b-blush.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-front ai-dot-open" data-if="ai_dot_look == 'a'" src="../icons/mascot/a-eyes-front.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-front ai-dot-hap" data-if="ai_dot_look == 'a'" src="../icons/mascot/a-hap-front.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-front ai-dot-shut" data-if="ai_dot_look == 'a'" src="../icons/mascot/a-shut-front.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-front ai-dot-open" data-if="ai_dot_look == 'b'" src="../icons/mascot/b-eyes-front.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-front ai-dot-hap" data-if="ai_dot_look == 'b'" src="../icons/mascot/b-hap-front.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-front ai-dot-shut" data-if="ai_dot_look == 'b'" src="../icons/mascot/b-shut-front.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-front ai-dot-open" data-if="ai_dot_look == 'c'" src="../icons/mascot/c-eyes-front.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-front ai-dot-hap" data-if="ai_dot_look == 'c'" src="../icons/mascot/c-hap-front.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eyes-front ai-dot-shut" data-if="ai_dot_look == 'c'" src="../icons/mascot/c-shut-front.svg"></svg>
          <svg class="ai-dot-layer ai-dot-mouth" data-if="ai_dot_look == 'a'" src="../icons/mascot/a-mouth.svg"></svg>
          <svg class="ai-dot-layer ai-dot-mouth" data-if="ai_dot_look == 'b'" src="../icons/mascot/b-mouth.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eq ai-dot-eq-1" data-if="ai_dot_look == 'c'" src="../icons/mascot/c-eq-1.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eq ai-dot-eq-2" data-if="ai_dot_look == 'c'" src="../icons/mascot/c-eq-2.svg"></svg>
          <svg class="ai-dot-layer ai-dot-eq ai-dot-eq-3" data-if="ai_dot_look == 'c'" src="../icons/mascot/c-eq-3.svg"></svg>
          <svg class="ai-dot-layer ai-dot-line ai-dot-line-1" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-line-1.svg"></svg>
          <svg class="ai-dot-layer ai-dot-line ai-dot-line-2" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-line-2.svg"></svg>
          <svg class="ai-dot-layer ai-dot-line ai-dot-line-3" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-line-3.svg"></svg>
          <svg class="ai-dot-layer ai-dot-bar ai-dot-bar-1" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-bar-1.svg"></svg>
          <svg class="ai-dot-layer ai-dot-bar ai-dot-bar-2" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-bar-2.svg"></svg>
          <svg class="ai-dot-layer ai-dot-bar ai-dot-bar-3" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-bar-3.svg"></svg>
          <svg class="ai-dot-layer ai-dot-bar ai-dot-bar-4" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-bar-4.svg"></svg>
          <svg class="ai-dot-layer ai-dot-bar ai-dot-bar-5" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-bar-5.svg"></svg>
          <svg class="ai-dot-layer ai-dot-ddot ai-dot-ddot-1" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-dot-1.svg"></svg>
          <svg class="ai-dot-layer ai-dot-ddot ai-dot-ddot-2" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-dot-2.svg"></svg>
          <svg class="ai-dot-layer ai-dot-ddot ai-dot-ddot-3" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-dot-3.svg"></svg>
          <svg class="ai-dot-layer ai-dot-check" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-check.svg"></svg>
          <svg class="ai-dot-layer ai-dot-dlock" data-if="ai_dot_look == 'd'" src="../icons/mascot/d-lock.svg"></svg>
        </div>
        <svg class="ai-dot-layer ai-dot-bubble" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/bubble.svg"></svg>
        <svg class="ai-dot-layer ai-dot-bubble" data-if="ai_dot_look == 'c'" src="../icons/mascot/bubble-c.svg"></svg>
        <svg class="ai-dot-layer ai-dot-tdot ai-dot-tdot-1" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/dot-1.svg"></svg>
        <svg class="ai-dot-layer ai-dot-tdot ai-dot-tdot-2" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/dot-2.svg"></svg>
        <svg class="ai-dot-layer ai-dot-tdot ai-dot-tdot-3" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/dot-3.svg"></svg>
        <svg class="ai-dot-layer ai-dot-tdot ai-dot-tdot-1" data-if="ai_dot_look == 'c'" src="../icons/mascot/dot-c-1.svg"></svg>
        <svg class="ai-dot-layer ai-dot-tdot ai-dot-tdot-2" data-if="ai_dot_look == 'c'" src="../icons/mascot/dot-c-2.svg"></svg>
        <svg class="ai-dot-layer ai-dot-tdot ai-dot-tdot-3" data-if="ai_dot_look == 'c'" src="../icons/mascot/dot-c-3.svg"></svg>
        <svg class="ai-dot-layer ai-dot-star" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/star.svg"></svg>
        <svg class="ai-dot-layer ai-dot-spark" data-if="ai_dot_look == 'c'" src="../icons/mascot/spark-c.svg"></svg>
        <svg class="ai-dot-layer ai-dot-spark" data-if="ai_dot_look == 'd'" src="../icons/mascot/spark-d.svg"></svg>
        <svg class="ai-dot-layer ai-dot-heart ai-dot-heart-1" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/heart-1.svg"></svg>
        <svg class="ai-dot-layer ai-dot-heart ai-dot-heart-2" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/heart-2.svg"></svg>
        <svg class="ai-dot-layer ai-dot-z ai-dot-z-1" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/z-1.svg"></svg>
        <svg class="ai-dot-layer ai-dot-z ai-dot-z-2" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/z-2.svg"></svg>
        <svg class="ai-dot-layer ai-dot-z ai-dot-z-3" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/z-3.svg"></svg>
        <svg class="ai-dot-layer ai-dot-lock" data-if="ai_dot_look == 'a' || ai_dot_look == 'b'" src="../icons/mascot/lock.svg"></svg>
        <svg class="ai-dot-layer ai-dot-lock" data-if="ai_dot_look == 'c'" src="../icons/mascot/lock-c.svg"></svg>
      </div>
    </div>
  </div>
  <div id="shell-statusbar" class="shell-statusbar" data-if="statusbar_visible">
    <div id="shell-statusbar-cluster" class="shell-statusbar-cluster"
         data-attr-title="statusbar_cluster_title"
         data-event-click="toggle_statusbar_popover()">
      <div class="shell-statusbar-group">
        <div class="shell-statusbar-slot shell-statusbar-brief"
             data-if="statusbar_brief_visible"
             data-attr-title="statusbar_brief_title"
             data-class-shell-statusbar-brief--ok="statusbar_brief_ok"
             data-class-shell-statusbar-brief--failed="statusbar_brief_failed"
             data-class-shell-statusbar-brief--unknown="statusbar_brief_unknown">
          <svg src="../icons/status-brief.svg" width="12" height="12" crop-to-content="true"></svg>
        </div>
        <div class="shell-statusbar-slot shell-statusbar-direct"
             data-if="statusbar_direct_visible"
             data-attr-title="statusbar_direct_title"
             data-class-shell-statusbar-direct--ok="statusbar_direct_ok"
             data-class-shell-statusbar-direct--off="statusbar_direct_off"
             data-class-shell-statusbar-direct--error="statusbar_direct_error"
             data-class-shell-statusbar-direct--checking="statusbar_direct_checking">
          <svg src="../icons/status-direct.svg" width="12" height="12" crop-to-content="true"></svg>
        </div>
      </div>
      <div class="shell-statusbar-divider"
           data-if="statusbar_help_visible || statusbar_inbound_visible || statusbar_load_circuit_visible || statusbar_load_media_visible || statusbar_label != ''"></div>
      <div class="shell-statusbar-group"
           data-if="statusbar_help_visible || statusbar_inbound_visible || statusbar_load_circuit_visible || statusbar_load_media_visible || statusbar_label != ''">
        <div class="shell-statusbar-slot shell-statusbar-help" data-if="statusbar_help_visible"
             data-attr-title="statusbar_help_title">
          <svg src="../icons/status-help.svg" width="12" height="12" crop-to-content="true"></svg>
        </div>
        <div class="shell-statusbar-slot shell-statusbar-inbound"
             data-if="statusbar_inbound_visible"
             data-attr-title="statusbar_inbound_title"
             data-class-shell-statusbar-inbound--ok="statusbar_inbound_ok"
             data-class-shell-statusbar-inbound--off="statusbar_inbound_off">
          <svg src="../icons/status-inbound.svg" width="12" height="12" crop-to-content="true"></svg>
        </div>
        <p class="shell-statusbar-load text-xs muted"
           data-if="statusbar_load_circuit_visible"
           data-attr-title="statusbar_load_circuit_title">{{statusbar_load_circuit_label}}</p>
        <p class="shell-statusbar-load text-xs muted"
           data-if="statusbar_load_media_visible"
           data-attr-title="statusbar_load_media_title">{{statusbar_load_media_label}}</p>
        <p class="shell-statusbar-label text-xs muted"
           data-if="statusbar_label != ''"
           data-class-shell-statusbar-label--warn="statusbar_label_warn"
           data-class-shell-statusbar-label--error="statusbar_label_error">{{statusbar_label}}</p>
      </div>
    </div>
    <!-- Right side left empty on purpose (Kenneth 2026-10-28): what the AI is doing shows above the composer. -->
  </div>
  <div id="shell-statusbar-popover-scrim" class="shell-statusbar-popover-scrim"
       data-if="statusbar_popover_open"
       data-event-click="dismiss_statusbar_popover()"></div>
  <div id="shell-statusbar-popover" class="shell-statusbar-popover stack"
       data-if="statusbar_popover_open">
    <p class="text shell-statusbar-popover-title">{{i18n:shell.statusbar.popover.title}}</p>
    <div class="shell-statusbar-popover-row">
      <div class="shell-statusbar-popover-key">
        <div class="shell-statusbar-slot shell-statusbar-brief"
             data-class-shell-statusbar-brief--ok="statusbar_brief_ok"
             data-class-shell-statusbar-brief--failed="statusbar_brief_failed"
             data-class-shell-statusbar-brief--unknown="statusbar_brief_unknown">
          <svg src="../icons/status-brief.svg" width="12" height="12" crop-to-content="true"></svg>
        </div>
        <p class="text-xs muted">{{i18n:shell.statusbar.popover.brief}}</p>
      </div>
      <p class="text-xs">{{statusbar_popover_brief_label}}</p>
    </div>
    <div class="shell-statusbar-popover-row">
      <div class="shell-statusbar-popover-key">
        <div class="shell-statusbar-slot shell-statusbar-direct"
             data-class-shell-statusbar-direct--ok="statusbar_direct_ok"
             data-class-shell-statusbar-direct--off="statusbar_direct_off"
             data-class-shell-statusbar-direct--error="statusbar_direct_error"
             data-class-shell-statusbar-direct--checking="statusbar_direct_checking">
          <svg src="../icons/status-direct.svg" width="12" height="12" crop-to-content="true"></svg>
        </div>
        <p class="text-xs muted">{{i18n:shell.statusbar.popover.direct}}</p>
      </div>
      <p class="text-xs">{{statusbar_popover_direct_label}}</p>
    </div>
    <div class="shell-statusbar-popover-row">
      <div class="shell-statusbar-popover-key">
        <div class="shell-statusbar-slot shell-statusbar-inbound"
             data-if="statusbar_inbound_visible"
             data-class-shell-statusbar-inbound--ok="statusbar_inbound_ok"
             data-class-shell-statusbar-inbound--off="statusbar_inbound_off">
          <svg src="../icons/status-inbound.svg" width="12" height="12" crop-to-content="true"></svg>
        </div>
        <p class="text-xs muted">{{i18n:shell.statusbar.popover.reachability}}</p>
      </div>
      <p class="text-xs">{{statusbar_popover_reach_label}}</p>
    </div>
    <p class="text-xs muted">{{statusbar_popover_reach_summary}}</p>
    <div class="shell-statusbar-popover-row" data-if="statusbar_popover_help_visible">
      <div class="shell-statusbar-popover-key">
        <div class="shell-statusbar-slot shell-statusbar-help">
          <svg src="../icons/status-help.svg" width="12" height="12" crop-to-content="true"></svg>
        </div>
        <p class="text-xs">{{statusbar_popover_help_label}}</p>
      </div>
    </div>
    <p class="text-xs muted" data-if="statusbar_popover_upnp_visible">{{statusbar_popover_upnp_label}}</p>
    <div class="stack" data-if="statusbar_popover_network_visible">
      <p class="text-xs muted">{{i18n:shell.statusbar.popover.network}}</p>
      <p class="text-xs">{{statusbar_popover_network_links}}</p>
      <p class="text-xs" data-if="statusbar_popover_network_parked != ''">{{statusbar_popover_network_parked}}</p>
      <p class="text-xs" data-if="statusbar_popover_network_rate != ''">{{statusbar_popover_network_rate}}</p>
      <p class="text-xs" data-if="statusbar_popover_network_rtt != ''">{{statusbar_popover_network_rtt}}</p>
      <p class="text-xs" data-if="statusbar_popover_network_resend != ''">{{statusbar_popover_network_resend}}</p>
    </div>
    <div class="stack" data-if="statusbar_popover_load_visible">
      <p class="text-xs muted">{{i18n:shell.statusbar.popover.load}}</p>
      <p class="text-xs" data-if="statusbar_popover_circuit_load != ''">{{statusbar_popover_circuit_load}}</p>
      <p class="text-xs" data-if="statusbar_popover_media_sessions != ''">{{statusbar_popover_media_sessions}}</p>
      <p class="text-xs" data-if="statusbar_popover_media_participants != ''">{{statusbar_popover_media_participants}}</p>
      <p class="text-xs" data-if="statusbar_popover_relay_rate != ''">{{statusbar_popover_relay_rate}}</p>
    </div>
    <p class="text-xs error" data-if="statusbar_popover_error_visible" selectable="text">{{statusbar_popover_error}}</p>
    <div class="shell-statusbar-popover-actions row">
      <button class="btn btn-secondary" type="button"
              data-event-click="retest_statusbar_reachability()">
        {{i18n:settings.network.connection.retest}}
      </button>
      <button class="btn btn-secondary" type="button"
              data-event-click="open_network_settings()">
        {{i18n:shell.statusbar.open_network_settings}}
      </button>
    </div>
  </div>
  <!-- Brand cover until interactive-ready; below titlebar (z 120), below PIN (z 55). -->
  <div id="shell-startup-cover" class="shell-startup-cover" data-if="startup_cover_visible" focus="none">
    <div class="shell-startup-cover-inner stack">
      <img class="shell-startup-cover-icon" src="../branding/app-icon.png" width="96" height="96"/>
      <h1 class="shell-startup-cover-name">{{i18n:app.name}}</h1>
      <p class="text-sm muted shell-startup-cover-status">{{i18n:startup.preparing}}</p>
    </div>
  </div>
</body>
</rml>
