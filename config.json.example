{
  "config_version": 1,
  "llm": {
    "preset": "brief",
    "base_url": "https://www.brief.global/api/llm/v1",
    "model": "xai",
    "require_api_key": false
  },
  "_llm_cloud_example": {
    "preset": "cloud",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "require_api_key": true
  },
  "_llm_ollama_dev_example": {
    "preset": "ollama",
    "base_url": "http://localhost:11434/v1",
    "model": "llama3.2",
    "require_api_key": false
  },
  "_llm_xai_example": {
    "preset": "custom",
    "base_url": "https://api.x.ai/v1",
    "model": "grok-4.20-non-reasoning",
    "api_key_env": "XAI_API_KEY",
    "require_api_key": true
  },
  "promoted_mcp": {
    "url": "https://www.brief.global/mcp"
  },
  "relay": {
    "base_url": "https://www.brief.global/api/relay"
  },
  "directory": {
    "base_url": "https://www.brief.global/api/relay"
  },
  "registration": {
    "base_url": "https://www.brief.global/api/relay"
  },
  "libp2p": {
    "node_enabled": true,
    "listen_multiaddr": "/ip4/0.0.0.0/tcp/18517",
    "bootstrap_peers": [
      "/ip4/3.208.41.58/tcp/443/p2p/12D3KooWCmqCKgBL47m25WzUgiAPayf3GqKiRosmPvAqp2MQUFYR"
    ],
    "max_connections": 32,
    "max_concurrent_dials": 4,
    "dial_timeout_ms": 15000,
    "idle_ttl_ms": 120000,
    "dial_failure_backoff_ms": 30000
  },
  "search": {
    "provider": "duckduckgo"
  }
}
