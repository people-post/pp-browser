# Copy to signing.env (gitignored) and fill in after Apple Developer setup.
# Used for local sign + notarize smoke tests via scripts/macos_sign_and_notarize.sh.
#
#   cp packaging/macos/signing.env.example packaging/macos/signing.env
#   # edit signing.env, then:
#   source packaging/macos/signing.env
#   ./scripts/macos_sign_and_notarize.sh sign-app install/PP.app

# --- Certificate (Developer ID Application) ---
# Path to a .p12 export from Keychain Access (local dev).
APPLE_CERTIFICATE_PATH=/path/to/DeveloperIDApplication.p12
APPLE_CERTIFICATE_PASSWORD=YOUR_P12_PASSWORD

# Exact codesign identity (Keychain Access → certificate → Common Name).
# Example: Developer ID Application: Your Org Name (XXXXXXXXXX)
APPLE_SIGNING_IDENTITY="Developer ID Application: YOUR_ORG_NAME (YOUR_TEAM_ID)"

# 10-character Team ID from Apple Developer → Membership details.
APPLE_TEAM_ID=YOUR_TEAM_ID

# --- Notarization (App Store Connect API key — recommended) ---
APPLE_NOTARY_KEY_ID=YOUR_NOTARY_KEY_ID
APPLE_NOTARY_ISSUER_ID=YOUR_NOTARY_ISSUER_ID
# Path to the downloaded AuthKey_XXXX.p8 file.
APPLE_NOTARY_P8_PATH=/path/to/AuthKey_YOUR_NOTARY_KEY_ID.p8

# --- Optional overrides ---
# MACOS_ENTITLEMENTS=packaging/macos/pp-browser.entitlements
