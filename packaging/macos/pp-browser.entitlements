<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened-runtime networking (Brief API, libp2p, curl). -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- No JIT / unsigned executable memory: nothing in the app or its libraries needs it (PB-045);
       verified by running a hardened-runtime signed build with only the keys above. -->
</dict>
</plist>
