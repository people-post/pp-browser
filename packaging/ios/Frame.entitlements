<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Optional: shared container for extensions / push service (register group in Developer Portal). -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.YOUR_TEAM_ID.dev.frame.ios</string>
  </array>
  <!-- Keychain access for future secure API-key storage (placeholder). -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)dev.frame.ios</string>
  </array>
</dict>
</plist>
