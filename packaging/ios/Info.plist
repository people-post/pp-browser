<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CFBundle* display strings: sync with pbr::kProductName in ProductBranding.h -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>PP</string>
  <key>CFBundleExecutable</key>
  <string>PP</string>
  <key>CFBundleIdentifier</key>
  <string>dev.pp-browser.ios</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>PP</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@MACOSX_BUNDLE_SHORT_VERSION_STRING@</string>
  <key>CFBundleVersion</key>
  <string>@MACOSX_BUNDLE_BUNDLE_VERSION@</string>
  <!-- Uses industry-standard crypto (libsodium / NIST PQ), open source — not proprietary.
       No US CCATS. Docs only if France is a store territory (French declaration).
       false = exempt from ASC encryption *documentation* (see APP_STORE_EXPORT_COMPLIANCE.md).
       If you later enable France or get an ASC compliance code, flip to true + set
       ITSEncryptionExportComplianceCode (or IOS_EXPORT_COMPLIANCE_CODE in signing.env). -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <!-- Xcode normally injects this; Ninja builds must set it for ASC (error 90562). -->
  <key>CFBundleSupportedPlatforms</key>
  <array>
    <string>iPhoneOS</string>
  </array>
  <!-- 1 = iPhone, 2 = iPad (matches XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY). -->
  <key>UIDeviceFamily</key>
  <array>
    <integer>1</integer>
    <integer>2</integer>
  </array>
  <!-- Asset catalog AppIcon (compiled to Assets.car by ios_prepare_app_icons.sh). -->
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <!-- Portrait-only: opt out of iPad multitasking (avoids requiring all orientations). -->
  <key>UIRequiresFullScreen</key>
  <true/>
  <!-- Must match PP_BROWSER_IOS_DEPLOYMENT_TARGET / CMAKE_OSX_DEPLOYMENT_TARGET. -->
  <key>MinimumOSVersion</key>
  <string>15.0</string>
  <!-- Shown: SDL prefersStatusBarHidden follows non-fullscreen window flags. -->
  <key>UIStatusBarHidden</key>
  <false/>
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <true/>
  <!-- SDL 3.4+ UIScene lifecycle (B11). Matches SDLUIKitSceneDelegate. -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
          <key>UISceneConfigurationName</key>
          <string>SDLSceneConfiguration</string>
          <key>UISceneDelegateClassName</key>
          <string>SDLUIKitSceneDelegate</string>
        </dict>
      </array>
    </dict>
  </dict>
  <key>UILaunchScreen</key>
  <dict/>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
    <string>opengles-3</string>
  </array>
  <!-- Portrait only — avoid rotation EGL/shell churn (same policy as Android). -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <!-- Allow HTTPS to Brief API, relay, and custom LLM endpoints. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
  </dict>
  <!-- Placeholder for future push (APNs) — enable when APNs is implemented. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>PP uses the microphone for voice and video calls.</string>
  <key>NSCameraUsageDescription</key>
  <string>PP uses the camera for video calls.</string>
  <key>UIBackgroundModes</key>
  <array>
    <string>fetch</string>
    <string>remote-notification</string>
    <string>audio</string>
  </array>
</dict>
</plist>
