<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CFBundle* display strings: sync with pbr::kProductName in ProductBranding.h -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>PP</string>
  <key>CFBundleExecutable</key>
  <string>PP</string>
  <key>CFBundleIdentifier</key>
  <string>dev.pp-browser.ios</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>PP</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>0.1.0</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <!-- Must match PP_BROWSER_IOS_DEPLOYMENT_TARGET / CMAKE_OSX_DEPLOYMENT_TARGET. -->
  <key>MinimumOSVersion</key>
  <string>15.0</string>
  <!-- Shown: SDL prefersStatusBarHidden follows non-fullscreen window flags. -->
  <key>UIStatusBarHidden</key>
  <false/>
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <true/>
  <key>UILaunchScreen</key>
  <dict/>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
    <string>opengles-3</string>
  </array>
  <!-- Portrait only — avoid rotation EGL/shell churn (same policy as Android). -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <!-- Allow HTTPS to Brief API, relay, and custom LLM endpoints. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
  </dict>
  <!-- Placeholder for future push (APNs) — enable when APNs is implemented. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>PP uses the microphone for voice and video calls.</string>
  <key>NSCameraUsageDescription</key>
  <string>PP uses the camera for video calls.</string>
  <key>UIBackgroundModes</key>
  <array>
    <string>fetch</string>
    <string>remote-notification</string>
    <string>audio</string>
  </array>
</dict>
</plist>
