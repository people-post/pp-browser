# Copy to signing.env (gitignored) and fill in after Apple Developer setup.
# Used for local device signing and TestFlight IPA via scripts/ios_sign.sh.
#
#   cp packaging/ios/signing.env.example packaging/ios/signing.env
#   # edit signing.env, then:
#   source packaging/ios/signing.env
#   ./scripts/ios_build.sh device
#   ./scripts/ios_sign.sh sign-app install-ios/PP.app

# --- App identity (Apple Developer → Identifiers → App IDs) ---
IOS_BUNDLE_IDENTIFIER=dev.pp-browser.ios
# Note: macOS uses dev.pp-browser.app — register a separate iOS App ID (dev.pp-browser.ios).
IOS_DEVELOPMENT_TEAM=YOUR_TEAM_ID
IOS_PRODUCT_NAME=PP

# --- Development / USB device (run-device) ---
# Keychain → "Apple Development: …"
# List with: security find-identity -v -p codesigning
IOS_SIGNING_IDENTITY="Apple Development: YOUR_NAME (YOUR_CERT_ID)"

# Provisioning profile from developer.apple.com (download .mobileprovision).
# Profile must include this Mac's development cert + the test device UDID.
# Keep the file under packaging/ios/ (gitignored via *.mobileprovision).
IOS_PROVISIONING_PROFILE_PATH=packaging/ios/pp-browser_iOS_Development.mobileprovision
# Optional: name shown in Xcode (overrides embedded profile when using manual signing).
IOS_PROVISIONING_PROFILE_SPECIFIER=pp-browser iOS Development

# Optional: prefer a specific phone for run-device
# IOS_DEVICE_UDID=

# --- Distribution / TestFlight / App Store ---
# Create: Certificates → Apple Distribution, Profiles → App Store (same App ID).
# Then:
#   IOS_EXPORT_METHOD=app-store
#   ./scripts/ios_build.sh ipa
#   ./scripts/ios_build.sh upload-ipa
#
# IOS_EXPORT_METHOD=development
#   development | ad-hoc | app-store | enterprise
IOS_EXPORT_METHOD=development

# Uncomment after creating the Distribution cert + App Store profile:
# IOS_DISTRIBUTION_SIGNING_IDENTITY="Apple Distribution: YOUR_ORG (YOUR_TEAM_ID)"
# IOS_DISTRIBUTION_PROVISIONING_PROFILE_PATH=packaging/ios/pp-browser_iOS_App_Store.mobileprovision
# IOS_EXPORT_METHOD=app-store
#
# Portal profile Name (ExportOptions provisioningProfiles value), e.g. pp-browser-ios-dist:
# cp packaging/ios/ExportOptions.plist.example packaging/ios/ExportOptions.plist
# # set teamID + provisioningProfiles name to match the App Store profile
# IOS_EXPORT_OPTIONS_PLIST=packaging/ios/ExportOptions.plist

# Version stamps applied at sign/export (App Store Connect requires a new build each upload):
# PP_BROWSER_VERSION=0.1.0
# PP_BROWSER_BUILD_NUMBER=1

# --- App Store Connect upload (optional; else use Transporter.app) ---
# Users and Access → Integrations → App Store Connect API → Keys
# IOS_ASC_KEY_ID=XXXXXXXXXX
# IOS_ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# IOS_ASC_P8_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# --- CI / GitHub Actions (optional; base64 .p12 + profile) ---
# IOS_CERTIFICATE_BASE64=
# IOS_CERTIFICATE_PASSWORD=YOUR_P12_PASSWORD
# IOS_PROVISIONING_PROFILE_BASE64=

# --- Entitlements ---
# IOS_ENTITLEMENTS=packaging/ios/pp-browser.entitlements

# --- APNs (deferred — fill when push is implemented) ---
# IOS_APNS_KEY_ID=YOUR_APNS_KEY_ID
# IOS_APNS_TEAM_ID=YOUR_TEAM_ID
# IOS_APNS_KEY_PATH=/path/to/AuthKey_XXXX.p8
