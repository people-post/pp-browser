    {
      "type": "timeseries",
      "title": "Reliable packets: retransmitted / lost",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
