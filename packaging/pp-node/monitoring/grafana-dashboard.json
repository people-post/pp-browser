        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (host_name, protocol) (pp_amp_channels_open{deployment_environment=~\"$env\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} {{protocol}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Link connects / drops",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
